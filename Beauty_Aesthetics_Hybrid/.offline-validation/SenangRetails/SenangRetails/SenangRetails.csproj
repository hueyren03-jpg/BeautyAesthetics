<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>SenangRetails</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>Senang Retails</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.ebi.senangretails</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" ForegroundScale="0.75" Condition="Exists('Resources\AppIcon\appicon.svg')" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="256,256" Condition="Exists('Resources\Splash\splash.svg')" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" Condition="Exists('Resources\Images')" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" Condition="Exists('Resources\Fonts')" />

    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('Resources\Raw')" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Platforms\Android\imin_printer_sdk.jar" />
  </ItemGroup>

  <ItemGroup>
    <AndroidLibrary Include="Platforms\Android\imin_printer_sdk.jar" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.3" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SenangRetails.Shared\SenangRetails.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EBIDM">
      <HintPath>..\SenangRetails.Shared\EBIDM.dll</HintPath>
    </Reference>
    <Reference Include="EBIEF">
      <HintPath>..\SenangRetails.Shared\EBIEF.dll</HintPath>
    </Reference>
    <Reference Include="EBIEnum">
      <HintPath>..\SenangRetails.Shared\EBIEnum.dll</HintPath>
    </Reference>
    <Reference Include="EBIUC">
      <HintPath>..\SenangRetails.Shared\EBIUC.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Automatically ensure Android intermediate directories exist before AAPT2 and signing tasks -->
  <Target Name="EnsureAndroidIntermediateDirs" BeforeTargets="_ConvertResourcesCases;_GenerateAndroidResourceDir;GenerateJavaStubs;_CompileToDalvikWithR8;_Sign" Condition="$(TargetFramework.Contains('-android'))">
    <MakeDir Directories="$(IntermediateOutputPath)res" />
    <MakeDir Directories="$(IntermediateOutputPath)android" />
    <MakeDir Directories="$(IntermediateOutputPath)android\bin" />
  </Target>

</Project>
