<div class="download-button-container">
    <button class="download-button" @onclick="ToggleDropdown">
        <i class="bi bi-file-earmark-arrow-down-fill"></i>
    </button>
    @if (showDropdown)
    {
        <div class="download-dropdown-backdrop" @onclick="CloseDropdown"></div>
        <div class="download-dropdown" @onclick:stopPropagation="true">
            <button class="download-dropdown-item" @onclick="@(() => OnFormatSelected("CSV"))">
                <span>CSV</span>
            </button>
            <button class="download-dropdown-item" @onclick="@(() => OnFormatSelected("PDF"))">
                <span>PDF</span>
            </button>
        </div>
    }
</div>

@code {
    private bool showDropdown = false;

    [Parameter] public EventCallback<string> OnDownload { get; set; }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void CloseDropdown()
    {
        showDropdown = false;
    }

    private async Task OnFormatSelected(string format)
    {
        showDropdown = false;
        await OnDownload.InvokeAsync(format);
    }
}

