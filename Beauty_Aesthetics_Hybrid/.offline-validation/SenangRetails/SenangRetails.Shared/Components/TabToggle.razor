@using SenangRetails.Shared.Models

<div class="tab-toggle">
    @foreach (var option in Options)
    {
        <button class="tab-toggle-button @(option.Value == SelectedValue ? "active" : "")"
                @onclick="() => OnTabClick(option.Value)">
            @option.Label
        </button>
    }
</div>

@code {
    [Parameter] public List<TabOption> Options { get; set; } = new();
    [Parameter] public string SelectedValue { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnChange { get; set; }

    private async Task OnTabClick(string value)
    {
        if (value != SelectedValue)
        {
            await OnChange.InvokeAsync(value);
        }
    }
}