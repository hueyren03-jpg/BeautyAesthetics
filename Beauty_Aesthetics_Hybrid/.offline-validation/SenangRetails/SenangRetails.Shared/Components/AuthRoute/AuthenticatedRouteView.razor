@using Microsoft.AspNetCore.Components.Routing
@using SenangRetails.Shared.Services.AuthService
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IStoreTokenService StoreTokenService

@if (_canRender)
{
    <RouteView RouteData="RouteData" DefaultLayout="DefaultLayout" />
}

@code {
    [Parameter] public RouteData? RouteData { get; set; }
    [Parameter] public Type? DefaultLayout { get; set; }

    private bool _canRender;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        var path = NormalizePath(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        _canRender = IsPublicRoute(path);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await EvaluateAuthAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await EvaluateAuthAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task EvaluateAuthAsync()
    {
        var path = NormalizePath(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

        if (IsPublicRoute(path))
        {
            _canRender = true;
            return;
        }

        var token = await StoreTokenService.GetTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            _canRender = true;
            return;
        }

        _canRender = false;
        NavigationManager.NavigateTo("/", forceLoad: false, replace: true);
    }

    private static string NormalizePath(string relativePath)
    {
        if (string.IsNullOrEmpty(relativePath))
            return string.Empty;

        var p = relativePath.TrimEnd('/').ToLowerInvariant();
        if (p.StartsWith('/'))
            p = p[1..];

        var q = p.IndexOf('?', StringComparison.Ordinal);
        if (q >= 0)
            p = p[..q];

        return p;
    }

    private static bool IsPublicRoute(string path)
        => path is "" or "404" or "error" or "select-branch";
}
