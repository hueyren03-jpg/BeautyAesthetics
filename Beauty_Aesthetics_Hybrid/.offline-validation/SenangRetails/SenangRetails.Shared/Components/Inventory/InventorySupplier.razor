@inherits SenangRetails.Shared.Pages.BasePage
@using SenangRetails.Shared.Components.Inventory

<div class="view-body">
    <div class="header">
        <div class="mobile-menu-btn" @onclick="ToggleNav">
            <i class="bi bi-list"></i>
        </div>
        <div class="header-title">Supplier</div>
        <div class="top-right-button"><i class="fa-solid fa-plus" @onclick="OpenAddSupplierModal" style="cursor: pointer;"></i></div>
    </div>
    <div class="tool-bar" style="margin-bottom: 15px;">
        <div class="search-bar">
            <i class="bi bi-search"></i>
            <input class="search-stock-balance" type="text" placeholder="Search suppliers..." @bind="searchQuery" @bind:event="oninput" />
        </div>
    </div>

    <!-- SUPPLIERS TABLE LIST (CONSISTENT WITH BALANCE/MOVEMENT TABLES) -->
    <div class="stock-movement-table custom-shadow-sm">
        <div class="supplier-grid-header">
            <span>Supplier Name</span>
            <span>Contact Person</span>
            <span>Phone</span>
            <span>Email</span>
            <span>Description</span>
        </div>

        @foreach (var supplier in FilteredSuppliers)
        {
            <div class="supplier-grid-row cursor-pointer" @onclick="() => OpenSupplierDetails(supplier)">
                <span style="font-weight: 700; color: #1A1A1A;">@supplier.Name</span>
                <span>@supplier.ContactPerson</span>
                <span>@supplier.Phone</span>
                <span>@supplier.Email</span>
                <span style="color: #666; font-size: 0.95em;">@supplier.Description</span>
            </div>
        }
    </div>
</div>

<!-- ============================================================
MODALS
============================================================ -->

<div class="supplier-modal-root">
    <!-- ADD SUPPLIER MODAL -->
    <SlideModal IsOpen="@addSupplierModalIsOpen" CssClass="supplier-details-modal" ZIndexBackdrop="3000" ZIndexModal="3001" OnClose="CloseAddSupplierModal">
        <div class="header">
            <div @onclick="CloseAddSupplierModal" style="cursor: pointer;">
                <i class="bi bi-x-lg"></i>
            </div>
            <div class="header-title">Add Supplier</div>
            <div style="width: 24px;"></div>
        </div>
        <div class="details-form-container" style="max-height: 70vh; overflow-y: auto;">
            <div class="form-group">
                <label>Supplier Name</label>
                <input type="text" class="custom-input" placeholder="Enter supplier name" @bind="newSupplierName" />
            </div>
            <div class="form-group">
                <label>Contact Person</label>
                <input type="text" class="custom-input" placeholder="Enter contact person" @bind="newSupplierContact" />
            </div>
            <div class="form-group">
                <label>Phone Number</label>
                <input type="text" class="custom-input" placeholder="Enter phone number" @bind="newSupplierPhone" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="text" class="custom-input" placeholder="Enter email" @bind="newSupplierEmail" />
            </div>
            <div class="form-group">
                <label>Address</label>
                <input type="text" class="custom-input" placeholder="Enter address" @bind="newSupplierAddress" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea class="custom-input" style="height: 60px; resize: none;" placeholder="Enter description" @bind="newSupplierDescription"></textarea>
            </div>
            <button class="confirm-btn" style="margin-top: 15px;" @onclick="SaveNewSupplier">
                Save Supplier
            </button>
        </div>
    </SlideModal>

    <!-- SUPPLIER DETAILS / EDIT MODAL -->
    <SlideModal IsOpen="@supplierDetailsModalIsOpen" CssClass="supplier-details-modal" ZIndexBackdrop="3000" ZIndexModal="3001" OnClose="CloseSupplierDetailsModal">
        <div class="header">
            <div @onclick="CloseSupplierDetailsModal" style="cursor: pointer;">
                <i class="bi bi-x-lg"></i>
            </div>
            <div class="header-title">Supplier Details</div>
            <div class="top-right-button" style="cursor: pointer; color: var(--bs-danger);" @onclick="() => DeleteSupplier(selectedSupplierModel)">
                <i class="bi bi-trash-fill" style="font-size: 20px;"></i>
            </div>
        </div>
        <div class="details-form-container" style="max-height: 70vh; overflow-y: auto;">
            <div class="form-group">
                <label>Supplier Name</label>
                <input type="text" class="custom-input" @bind="selectedSupplierModel.Name" />
            </div>
            <div class="form-group">
                <label>Contact Person</label>
                <input type="text" class="custom-input" @bind="selectedSupplierModel.ContactPerson" />
            </div>
            <div class="form-group">
                <label>Phone Number</label>
                <input type="text" class="custom-input" @bind="selectedSupplierModel.Phone" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="text" class="custom-input" @bind="selectedSupplierModel.Email" />
            </div>
            <div class="form-group">
                <label>Address</label>
                <input type="text" class="custom-input" @bind="selectedSupplierModel.Address" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea class="custom-input" style="height: 60px; resize: none;" @bind="selectedSupplierModel.Description"></textarea>
            </div>
            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <label style="margin-bottom: 0; font-weight: 600;">Supplied Products</label>
                    <button type="button" class="btn-add-product" style="background: none; border: none; color: var(--primary); font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px; padding: 0;" @onclick="OpenAddProductModal">
                        <i class="bi bi-plus-circle"></i> Add Product
                    </button>
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    @if (selectedSupplierModel.SuppliedProducts != null && selectedSupplierModel.SuppliedProducts.Any())
                    {
                        @foreach (var prod in selectedSupplierModel.SuppliedProducts)
                        {
                            <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px; background: #F8F9FA; border-radius: 8px; border: 1px solid #EEE;">
                                <span style="font-weight: 600; color: #333;">@prod.Name</span>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <button type="button" class="number-button" style="background: var(--primary); color: white; border: none; padding: 6px 12px; border-radius: 6px; font-weight: bold; cursor: pointer;" @onclick="() => OpenProductPriceModal(prod)">
                                        RM @prod.Price.ToString("F2")
                                    </button>
                                    <i class="bi bi-trash3-fill" style="color: var(--bs-danger); cursor: pointer; font-size: 16px;" @onclick="() => RemoveProduct(prod)"></i>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align: center; color: #888; padding: 15px; background: #F8F9FA; border-radius: 8px; border: 1px dashed #DDD; font-size: 0.9em;">
                            No products assigned. Click "Add Product" to assign one.
                        </div>
                    }
                </div>
            </div>
            <button class="confirm-btn" style="margin-top: 15px;" @onclick="CloseSupplierDetailsModal">
                Save &amp; Close
            </button>
        </div>
    </SlideModal>

    <!-- CHOOSE PRODUCT MODAL -->
    <InventoryAddProductModal IsOpen="@addProductModalIsOpen"
                              OnClose="CloseAddProductModal"
                              OnProductSelected="HandleProductSelected" />
</div>

<!-- ============================================================
CALCULATORS
============================================================ -->

<Calculator IsOpen="@priceModalIsOpen"
            Title="Product Price"
            AllowDecimal="true"
            InitialValue="@selectedPrice"
            OnSave="HandlePriceSave"
            OnClose="ClosePriceModal" />

@code {
    [Parameter] public EventCallback OnToggleNav { get; set; }

    public class SupplierProductModel
    {
        public string Name { get; set; } = "";
        public double Price { get; set; } = 0.0;
    }

    public class SupplierModel
    {
        public string Name { get; set; } = "";
        public string ContactPerson { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
        public string Address { get; set; } = "";
        public string Description { get; set; } = "";
        public List<SupplierProductModel> SuppliedProducts { get; set; } = new();
    }

    private List<SupplierModel> Suppliers = new()
    {
        new SupplierModel
        {
            Name = "rtty",
            ContactPerson = "John Doe",
            Phone = "6012-7312313",
            Email = "john@rtty.com",
            Address = "123 Main St, Suite 4B, Kuala Lumpur",
            Description = "Primary supplier of medical grade masks and shields.",
            SuppliedProducts = new List<SupplierProductModel>
            {
                new SupplierProductModel { Name = "Mask", Price = 5.00 }
            }
        },
        new SupplierModel
        {
            Name = "Acme Corp",
            ContactPerson = "Jane Smith",
            Phone = "6019-8765432",
            Email = "jane@acme.com",
            Address = "456 Industrial Park, Penang",
            Description = "Gloves and protective gear manufacturer.",
            SuppliedProducts = new List<SupplierProductModel>
            {
                new SupplierProductModel { Name = "Gloves", Price = 10.00 }
            }
        }
    };

    private string searchQuery = "";

    private IEnumerable<SupplierModel> FilteredSuppliers =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? Suppliers
            : Suppliers.Where(s => s.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                  s.ContactPerson.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                  s.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    // Modals
    private bool addSupplierModalIsOpen = false;
    private bool supplierDetailsModalIsOpen = false;
    private SupplierModel selectedSupplierModel = new();

    // Add supplier form fields
    private string newSupplierName = "";
    private string newSupplierContact = "";
    private string newSupplierPhone = "";
    private string newSupplierEmail = "";
    private string newSupplierAddress = "";
    private string newSupplierDescription = "";

    // Price calculator state
    private bool priceModalIsOpen = false;
    private double selectedPrice = 5;
    private SupplierProductModel? editingProduct = null;

    // Add product modal state
    private bool addProductModalIsOpen = false;

    private void ToggleNav()
    {
        OnToggleNav.InvokeAsync();
    }

    private void OpenAddSupplierModal()
    {
        newSupplierName = "";
        newSupplierContact = "";
        newSupplierPhone = "";
        newSupplierEmail = "";
        newSupplierAddress = "";
        newSupplierDescription = "";
        addSupplierModalIsOpen = true;
    }

    private void CloseAddSupplierModal()
    {
        addSupplierModalIsOpen = false;
    }

    private void SaveNewSupplier()
    {
        if (!string.IsNullOrWhiteSpace(newSupplierName))
        {
            Suppliers.Add(new SupplierModel
            {
                Name = newSupplierName,
                ContactPerson = newSupplierContact,
                Phone = newSupplierPhone,
                Email = newSupplierEmail,
                Address = newSupplierAddress,
                Description = newSupplierDescription,
                SuppliedProducts = new List<SupplierProductModel>()
            });
        }
        addSupplierModalIsOpen = false;
    }

    private void OpenSupplierDetails(SupplierModel supplier)
    {
        selectedSupplierModel = supplier;
        supplierDetailsModalIsOpen = true;
    }

    private void CloseSupplierDetailsModal()
    {
        supplierDetailsModalIsOpen = false;
    }

    private void DeleteSupplier(SupplierModel supplier)
    {
        Suppliers.Remove(supplier);
        supplierDetailsModalIsOpen = false;
    }

    private void OpenProductPriceModal(SupplierProductModel product)
    {
        editingProduct = product;
        selectedPrice = product.Price;
        priceModalIsOpen = true;
    }

    private void ClosePriceModal()
    {
        priceModalIsOpen = false;
    }

    private void HandlePriceSave(double value)
    {
        selectedPrice = value;
        if (editingProduct != null)
        {
            editingProduct.Price = value;
        }
        priceModalIsOpen = false;
    }

    private void OpenAddProductModal()
    {
        addProductModalIsOpen = true;
    }

    private void CloseAddProductModal()
    {
        addProductModalIsOpen = false;
    }

    private void HandleProductSelected(string productName)
    {
        if (selectedSupplierModel.SuppliedProducts == null)
        {
            selectedSupplierModel.SuppliedProducts = new List<SupplierProductModel>();
        }

        // Avoid duplicates
        if (!selectedSupplierModel.SuppliedProducts.Any(p => p.Name.Equals(productName, StringComparison.OrdinalIgnoreCase)))
        {
            var newProd = new SupplierProductModel { Name = productName, Price = 5.00 };
            selectedSupplierModel.SuppliedProducts.Add(newProd);
            
            // Open price calculator immediately for the newly added product
            OpenProductPriceModal(newProd);
        }
        
        addProductModalIsOpen = false;
    }

    private void RemoveProduct(SupplierProductModel product)
    {
        selectedSupplierModel.SuppliedProducts?.Remove(product);
    }
}
