@using SenangRetails.Shared.Components.Common
@using SenangRetails.Shared.Services
@using SenangRetails.Shared.Services.InventoryService
@using SenangRetails.Shared.Models.DTOs
@using EBI.DM
@inject IInventoryService InventoryService
@inject AppState AppState
@inject LocalImageCacheService LocalImageCache

<div class="add-product-modal-root">
    <SlideModal IsOpen="@IsOpen" CssClass="stock-in-add-product-modal" ZIndexBackdrop="5000" ZIndexModal="5001" OnClose="OnClose">
        <div class="header modal-header">
            <div @onclick="OnClose" style="cursor: pointer;">
                <i class="bi bi-x"></i>
            </div>
            <div class="header-title">@Title</div>
            <div class="top-right-button"></div>
        </div>
        
        <div class="tool-bar">
            <div class="search-bar">
                <i class="bi bi-search"></i>
                <input class="search-stock-balance" type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Search..." />
            </div>
            <div class="date-picker">
                <div @onclick="ToggleFilter" class="date-range-button">
                    <span><i class="bi bi-box"></i> @selectedFilter</span>
                    @if (filterIsOpen)
                    {
                        <div @onclick="ToggleFilter" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color" style="z-index: 2002;"></div>
                        <div class="right-order-option-wrapper" style="z-index: 2003;">
                            <span @onclick='() => SelectFilter("All")' @onclick:stopPropagation="true">All</span>
                            <span @onclick='() => SelectFilter("Low Stock")' @onclick:stopPropagation="true">Low Stock</span>
                            <span @onclick='() => SelectFilter("Insufficient Stock")' @onclick:stopPropagation="true">Insufficient Stock</span>
                        </div>
                    }
                </div>
            </div>
            <div @onclick="ToggleSort" class="order-button">
                <i class="bi bi-sort-down"></i> Sort: @selectedSort
                @if (sortIsOpen)
                {
                    <div @onclick="ToggleSort" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color" style="z-index: 2002;"></div>
                    <div class="order-option-wrapper" style="z-index: 2003;">
                        <span @onclick='() => SelectSort("Name")' @onclick:stopPropagation="true">Name</span>
                        <span @onclick='() => SelectSort("Low Price")' @onclick:stopPropagation="true">Low Price</span>
                        <span @onclick='() => SelectSort("High Price")' @onclick:stopPropagation="true">High Price</span>
                    </div>
                }
            </div>
        </div>

        <div class="category-filter-bar" style="display: flex; gap: 8px; overflow-x: auto; white-space: nowrap; padding-bottom: 5px; max-width: 100%; width: 100%; min-width: 0; flex-shrink: 0;">
            <button class="category-pill @(selectedCategory == "All" ? "active" : "")" @onclick='() => SelectCategory("All")'>
                All
            </button>
            @foreach (var cat in categories)
            {
                <button class="category-pill @(selectedCategory == cat ? "active" : "")" @onclick='() => SelectCategory(cat)'>
                    @cat
                </button>
            }
        </div>

        <div class="addProductModalList" style="flex: 1; overflow-y: auto; max-height: 400px; margin-top: 10px;">
            @if (isLoading)
            {
                <div style="display: flex; align-items: center; justify-content: center; padding: 20px;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="item-grid" style="display: flex; flex-direction: column; gap: 8px;">
                    @foreach (var item in DisplayItems)
                    {
                        <div @onclick='() => SelectProduct(item)' class="addProductCard" style="cursor: pointer; display: grid; grid-template-columns: 50px 1fr auto; align-items: center; padding: 10px; border-radius: 8px; border: 1px solid #eee; background: white;">
                            <img class="table-item-image" src="@GetImageUrl(item)" alt="@item.Item.AccountName" style="width: 40px; height: 40px; object-fit: cover; border-radius: 6px;" />
                            <div class="table-card-content-row stock-movement-product-name" style="padding-left: 10px; display: flex; flex-direction: column;">
                                <span style="font-weight: 700; color: #1a1a1a;">@item.Item.AccountName</span>
                                <span style="color: #666; font-size: 0.8em;">RM @item.Item.SalesPrice.ToString("N2") | Stock: @item.CurrentStock.ToString("N0")</span>
                            </div>
                            <div class="table-card-content-row text-align-right" style="display: flex; flex-direction: column; align-items: flex-end; font-size: 0.85em; color: #888;">
                                <span>@item.Item.UnitOfMeasureName</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </SlideModal>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Add Product";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnProductSelected { get; set; }

    public class ModalItemDisplay
    {
        public InventoryDM Item { get; set; } = new();
        public decimal CurrentStock { get; set; }
        public string Section { get; set; } = "Section 1";
    }

    private List<ModalItemDisplay> modalItems = new();
    private List<string> categories = new();

    private string searchQuery = "";
    private string selectedFilter = "All";
    private string selectedSort = "Name";
    private string selectedCategory = "All";

    private bool filterIsOpen = false;
    private bool sortIsOpen = false;
    private bool isLoading = true;

    private IEnumerable<ModalItemDisplay> DisplayItems
    {
        get
        {
            var query = modalItems.AsEnumerable();

            // Search
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(i => i.Item.AccountName != null && i.Item.AccountName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            // Filter (Low Stock, Insufficient Stock)
            if (selectedFilter == "Low Stock")
            {
                query = query.Where(i => i.CurrentStock > 0 && i.CurrentStock <= i.Item.StockReorderLevel);
            }
            else if (selectedFilter == "Insufficient Stock")
            {
                query = query.Where(i => i.CurrentStock <= 0);
            }

            // Category
            if (selectedCategory != "All")
            {
                query = query.Where(i => i.Section == selectedCategory);
            }

            // Sort
            query = selectedSort switch
            {
                "Low Price" => query.OrderBy(i => i.Item.SalesPrice),
                "High Price" => query.OrderByDescending(i => i.Item.SalesPrice),
                _ => query.OrderBy(i => i.Item.AccountName)
            };

            return query.ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Load data when modal opens
        if (IsOpen && !modalItems.Any() && isLoading)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var branchId = AppState.SelectedBranchID;
            var allItemsList = await InventoryService.LoadItemsAsync(branchId) ?? new List<InventoryDM>();
            var productItems = allItemsList.Where(i => i.InventoryTypeID == 1).ToList();

            if (productItems.Any())
            {
                var req = new StockBalanceRequest
                {
                    BranchID = branchId,
                    InventoryIDs = string.Join(",", productItems.Select(p => p.MasterAccountID)),
                    FinancialDate = DateTime.Today,
                    EndDate = DateTime.Today,
                    RedemptionEndDate = DateTime.Today,
                    NewExpiryDate = DateTime.Today
                };

                var balances = await InventoryService.GetStockBalanceByBranchAndByItemAsync(req)
                              ?? new Dictionary<string, StockBalanceItem>();

                modalItems.Clear();
                foreach (var pi in productItems)
                {
                    decimal stock = 0;
                    if (balances.TryGetValue(pi.MasterAccountID ?? string.Empty, out var balItem))
                    {
                        stock = balItem.ExistingQuantity;
                    }

                    modalItems.Add(new ModalItemDisplay
                    {
                        Item = pi,
                        CurrentStock = stock,
                        Section = pi.ItemGroupName ?? "Section 1"
                    });
                }

                categories = modalItems.Select(i => i.Section).Distinct().Where(s => !string.IsNullOrEmpty(s)).ToList();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[InventoryAddProductModal] Error loading: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetImageUrl(ModalItemDisplay display)
    {
        var cached = LocalImageCache.GetImage(display.Item.MasterAccountID ?? string.Empty);
        if (!string.IsNullOrEmpty(cached)) return cached;
        if (!string.IsNullOrEmpty(display.Item.ImagePath))
        {
            return display.Item.ImagePath;
        }
        return "https://placehold.co/400";
    }

    private void ToggleFilter() => filterIsOpen = !filterIsOpen;
    private void SelectFilter(string filter)
    {
        selectedFilter = filter;
        filterIsOpen = false;
    }

    private void ToggleSort() => sortIsOpen = !sortIsOpen;
    private void SelectSort(string sort)
    {
        selectedSort = sort;
        sortIsOpen = false;
    }

    private void SelectCategory(string cat)
    {
        selectedCategory = cat;
    }

    private async Task SelectProduct(ModalItemDisplay display)
    {
        await OnProductSelected.InvokeAsync(display.Item.MasterAccountID ?? string.Empty);
    }
}
