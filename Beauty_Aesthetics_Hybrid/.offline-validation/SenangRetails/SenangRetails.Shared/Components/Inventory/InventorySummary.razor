@inherits SenangRetails.Shared.Pages.BasePage
@using EBI.DM
@using EBI.Enum
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Services
@using SenangRetails.Shared.Services.InventoryService
@inject IInventoryService InventoryService
@inject AppState AppState
@inject LocalImageCacheService LocalImageCache
@inject NavigationManager Navigation

<div class="view-body">
    <div class="header">
        <div class="left-section">
            <!-- Mobile Menu Button (visible on mobile) -->
            <button class="mobile-menu-btn" @onclick="ToggleNav">
                <i class="fa-solid fa-bars"></i>
            </button>
            <!-- Back Button -->
            <div class="back-button" @onclick="GoBack">
                <i class="bi bi-chevron-left"></i>
                <span>Back</span>
            </div>
        </div>
        <div class="header-title">Stock Summary</div>
        <div class="top-right-button">
            <div @onclick="OpenStockIn" class="top-right-relative">
                <button class="stock-action-btn">
                    <i class="bi bi-plus-lg"></i>
                    Add
                </button>
                @if (openStockInIsOpen)
                {
                    <div @onclick="CloseStockIn" @onclick:stopPropagation="true" class="all-modal-backdrop"></div>
                    <div class="left-order-option-wrapper text-align-left">
                        <span @onclick='() => NavigateTo("stockin")' @onclick:stopPropagation="true"><i class="bi bi-bag-plus"></i> Stock In</span>
                        <span @onclick='() => NavigateTo("stockout")' @onclick:stopPropagation="true"><i class="bi bi-calendar-minus"></i> Stock Out</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 300px; gap: 15px; color: #666;">
            <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="quick-summary-card">
            <div class="card">
                <span class="card-title">Stock On Hand</span>
                <span class="card-value">@stockOnHand.ToString("N0")</span>
            </div>
            <div class="card">
                <span class="card-title">Inventory Selling Price</span>
                <span class="card-value">RM @inventorySellingPrice.ToString("N2")</span>
            </div>
        </div>
        <div class="summary-info">
            <!-- LEFT COLUMN: STOCK BALANCE (SPANS 2 ROWS) -->
            <div class="summary-info-card stock-balance-summary-card">
                <div class="info-card-header">
                    <span class="info-card-title"><i class="bi bi-box-seam-fill primary-icon"></i> Stock Balance</span>
                    <span class="view-all-link" @onclick='() => NavigateTo("balance")'>View Balance &gt;</span>
                </div>
                <div class="items-list-container">
                    @if (topBalanceItems.Count == 0)
                    {
                        <div style="padding: 20px; font-size: 13px; color: #777; text-align: center;">No items found</div>
                    }
                    else
                    {
                        @foreach (var item in topBalanceItems)
                        {
                            <div class="item-card custom-shadow-sm">
                                <img class="item-image" src="@GetImageUrl(item)" alt="@item.Name Image" />
                                <div class="card-content-wrapper">
                                    <div class="card-content-row">
                                        <span class="item-name">@item.Name</span>
                                        <span class="item-qty">@item.ExistingQuantity.ToString("N0")</span>
                                    </div>
                                    <div class="card-content-row">
                                        <span class="item-details">
                                            @item.Unit | Cost: RM @item.PurchasePrice.ToString("N2")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- RIGHT COLUMN ROW 1: LOW STOCK -->
            <div class="summary-info-card low-stock-summary-card">
                <div class="info-card-header" style="cursor: pointer;" @onclick='() => NavigateTo("stockin")'>
                    <span class="low-stock-warning"><i class="bi bi-exclamation-triangle-fill text-warning"></i> Low Stock</span>
                    <span class="badge-count orange">@lowStockList.Count &gt;</span>
                </div>
                <div class="items-list-container">
                    @if (lowStockList.Count == 0)
                    {
                        <div style="padding: 20px; font-size: 13px; color: #777; text-align: center;">No low stock items</div>
                    }
                    else
                    {
                        @foreach (var item in lowStockList)
                        {
                            <div class="item-card custom-shadow-sm">
                                <img class="item-image" src="@GetImageUrl(item)" alt="@item.Name Image" />
                                <div class="card-content-wrapper">
                                    <div class="card-content-row">
                                        <span class="item-name">@item.Name</span>
                                        <span class="item-qty warning-text">@item.ExistingQuantity.ToString("N0")</span>
                                    </div>
                                    <div class="card-content-row">
                                        <span class="item-details">Min Stock: @item.StockReorderLevel.ToString("N0")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- RIGHT COLUMN ROW 2: INSUFFICIENT STOCK -->
            <div class="summary-info-card insufficient-stock-summary-card">
                <div class="info-card-header" style="cursor: pointer;" @onclick='() => NavigateTo("stockin")'>
                    <span class="insufficient-stock-danger"><i class="bi bi-x-circle-fill text-danger"></i> Insufficient Stock</span>
                    <span class="badge-count red">@insufficientStockList.Count &gt;</span>
                </div>
                <div class="items-list-container">
                    @if (insufficientStockList.Count == 0)
                    {
                        <div style="padding: 20px; font-size: 13px; color: #777; text-align: center;">No insufficient stock items</div>
                    }
                    else
                    {
                        @foreach (var item in insufficientStockList)
                        {
                            <div class="item-card custom-shadow-sm">
                                <img class="item-image" src="@GetImageUrl(item)" alt="@item.Name Image" />
                                <div class="card-content-wrapper">
                                    <div class="card-content-row">
                                        <span class="item-name">@item.Name</span>
                                        <span class="item-qty danger-text">@item.ExistingQuantity.ToString("N0")</span>
                                    </div>
                                    <div class="card-content-row">
                                        <span class="item-details">Out of Stock</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnToggleNav { get; set; }
    [Parameter] public EventCallback<string> OnNavSelected { get; set; }

    public class SummaryItem
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public decimal ExistingQuantity { get; set; }
        public decimal StockReorderLevel { get; set; }
        public decimal SalesPrice { get; set; }
        public decimal PurchasePrice { get; set; }
        public string Unit { get; set; } = "Unit";
        public string? ImagePath { get; set; }
        public string? ImageFileName { get; set; }
    }

    private List<SummaryItem> summaryItems = new();
    private List<SummaryItem> topBalanceItems = new();
    private List<SummaryItem> lowStockList = new();
    private List<SummaryItem> insufficientStockList = new();
    
    private decimal stockOnHand;
    private decimal inventorySellingPrice;
    private bool isLoading = true;

    private bool openStockInIsOpen = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var branchId = AppState.SelectedBranchID;

            var allItemsList = await InventoryService.LoadItemsAsync(branchId) ?? new List<InventoryDM>();
            var productItems = allItemsList.Where(i => i.InventoryTypeID == 1).ToList();

            summaryItems.Clear();
            if (productItems.Any())
            {
                var req = new StockBalanceRequest
                {
                    BranchID = branchId,
                    InventoryIDs = string.Join(",", productItems.Select(i => i.MasterAccountID)),
                    FinancialDate = DateTime.Today,
                    EndDate = DateTime.Today,
                    RedemptionEndDate = DateTime.Today,
                    NewExpiryDate = DateTime.Today
                };

                var balances = await InventoryService.GetStockBalanceByBranchAndByItemAsync(req)
                              ?? new Dictionary<string, StockBalanceItem>();

                foreach (var pi in productItems)
                {
                    decimal existingQty = 0;
                    if (balances.TryGetValue(pi.MasterAccountID ?? string.Empty, out var balItem))
                    {
                        existingQty = balItem.ExistingQuantity;
                    }

                    summaryItems.Add(new SummaryItem
                    {
                        Id = pi.MasterAccountID ?? string.Empty,
                        Name = pi.AccountName ?? string.Empty,
                        ExistingQuantity = existingQty,
                        StockReorderLevel = pi.StockReorderLevel,
                        SalesPrice = pi.SalesPrice,
                        PurchasePrice = pi.PurchasePrice,
                        Unit = pi.UnitOfMeasureName ?? pi.UnitOfMeasureID ?? "Unit",
                        ImagePath = pi.ImagePath,
                        ImageFileName = pi.ImageFileName
                    });
                }
            }

            stockOnHand = summaryItems.Sum(i => i.ExistingQuantity);
            inventorySellingPrice = summaryItems.Sum(i => i.ExistingQuantity * i.SalesPrice);

            topBalanceItems = summaryItems.OrderByDescending(i => i.ExistingQuantity).Take(5).ToList();

            lowStockList = summaryItems.Where(i => i.ExistingQuantity > 0 && i.ExistingQuantity <= i.StockReorderLevel).ToList();
            insufficientStockList = summaryItems.Where(i => i.ExistingQuantity <= 0).ToList();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[InventorySummary] Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetImageUrl(SummaryItem item)
    {
        var cached = LocalImageCache.GetImage(item.Id);
        if (!string.IsNullOrEmpty(cached)) return cached;
        if (!string.IsNullOrEmpty(item.ImagePath))
        {
            return item.ImagePath;
        }
        return "https://placehold.co/400";
    }

    private void ToggleNav()
    {
        OnToggleNav.InvokeAsync();
    }

    private void OpenStockIn()
    {
        openStockInIsOpen = true;
    }

    private void CloseStockIn()
    {
        openStockInIsOpen = false;
    }

    private void NavigateTo(string target)
    {
        openStockInIsOpen = false;
        OnNavSelected.InvokeAsync(target);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/home");
    }
}
