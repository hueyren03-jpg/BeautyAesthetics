@inherits SenangRetails.Shared.Pages.BasePage
@using SenangRetails.Shared.Services
@using SenangRetails.Shared.Services.InventoryService
@using SenangRetails.Shared.Models.DTOs
@using EBI.DM
@inject IInventoryService InventoryService
@inject AppState AppState
@inject LocalImageCacheService LocalImageCache

<div class="view-body">
    <div class="header">
        <div class="@(IsInModal ? "modal-close-btn" : "mobile-menu-btn")" @onclick="ToggleNav">
            @if (IsInModal)
            {
                <i class="bi bi-x-lg"></i>
            }
            else
            {
                <i class="bi bi-list"></i>
            }
        </div>
        <div class="header-title">Stock In</div>
        <div class="top-right-button"><i class="bi bi-truck"></i></div>
    </div>
    
    <div class="stock-in-dropdown-card custom-shadow-sm">
        <span>
            <i class="bi bi-arrows-move"></i> Action
        </span>
        <div @onclick="OpenOrderMain" class="order-button" style="position: relative; z-index: 51;">
            @selectedAction <i class="bi bi-chevron-down"></i>
            @if (orderIsOpenMain)
            {
                <div @onclick="CloseOrderMain" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color"></div>
                <div class="order-option-wrapper-summary">
                    <span @onclick='() => SelectAction("Adjustment")' @onclick:stopPropagation="true">Adjustment</span>
                    <span @onclick='() => SelectAction("Internal Transfer In")' @onclick:stopPropagation="true">Internal Transfer In</span>
                    <span @onclick='() => SelectAction("Stock In")' @onclick:stopPropagation="true">Stock In</span>
                    <span @onclick='() => SelectAction("Recover")' @onclick:stopPropagation="true">Recover</span>
                </div>
            }
        </div>
    </div>
    
    <div class="stock-in-dropdown-card custom-shadow-sm">
        <textarea placeholder="Remarks" @bind="remarks" />
    </div>

    <div @onclick="OpenAddProductModal" class="stock-in-dropdown-card custom-shadow-sm cursor-pointer mb-15">
        <span><i class="bi bi-box-seam"></i> Add Product</span>
    </div>

    @if (isLoading)
    {
        <div style="display: flex; align-items: center; justify-content: center; padding: 40px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="stock-movement-table custom-shadow-sm">
            <div class="stock-movement-table-row border-bottom">
                <span>Image</span>
                <span>Product</span>
                <span class="text-align-center">Qty</span>
                <span class="text-align-right">Cost</span>
            </div>

            @if (!stockInItems.Any())
            {
                <div style="text-align: center; padding: 40px; color: #888;">
                    <i class="bi bi-box-seam" style="font-size: 2rem; display: block; margin-bottom: 8px; color: #bbb;"></i>
                    No products added yet. Click "Add Product" above to select products.
                </div>
            }
            else
            {
                @foreach (var item in stockInItems)
                {
                    <div class="stock-movement-table-row">
                        <img src="@GetImageUrl(item)" class="stock-in-image" alt="@item.Name" />

                        <div class="stock-in-details">
                            <span class="stock-in-title">@item.Name</span>
                            <span class="stock-in-subtitle">RM @item.PurchasePrice.ToString("N2") | Stock: @item.CurrentStock.ToString("N0")</span>
                        </div>

                        <div class="text-align-center" style="display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                            <button class="btn btn-sm btn-light" style="padding: 2px 8px; border-radius: 4px; border: 1px solid #ccc;" @onclick="() => DecrementQty(item)">-</button>
                            <span class="number-button compact-number-btn" style="min-width: 36px; text-align: center; display: inline-block;" @onclick='() => OpenCalculator(item, "Quantity")'>@item.StockInQuantity</span>
                            <button class="btn btn-sm btn-light" style="padding: 2px 8px; border-radius: 4px; border: 1px solid #ccc;" @onclick="() => IncrementQty(item)">+</button>
                        </div>

                        <div class="text-align-right">
                            <span class="number-button compact-number-btn" @onclick='() => OpenCalculator(item, "Price")'>@item.StockInCost.ToString("N2")</span>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="delivery-order-total custom-shadow-sm summary-card-container">
            <div class="side-by-side summary-line">
                <span class="summary-text">Total SKU</span>
                <span class="summary-value">@TotalSku</span>
            </div>
            <div class="side-by-side summary-line">
                <span class="summary-text">Total Quantity</span>
                <span class="summary-value">@TotalQuantity</span>
            </div>
            <div class="side-by-side summary-total-line">
                <span class="summary-total-text">Total Cost</span>
                <span class="summary-total-value">RM @TotalCost.ToString("N2")</span>
            </div>

            <button class="confirm-btn w-100" @onclick="ConfirmStockIn">
                Confirm Stock In
            </button>
        </div>
    }
    <Calculator IsOpen="@isLocalCalculatorOpen"
                Title="@calculatorType"
                AllowDecimal="@(calculatorType == "Price")"
                InitialValue="@calculatorInitialValue"
                OnSave="HandleCalculatorSave"
                OnClose="CloseLocalCalculator" />
</div>

@code {
    [Parameter] public EventCallback OnToggleNav { get; set; }
    [Parameter] public bool IsInModal { get; set; } = false;

    // Remaining parameters kept for backwards-compatibility or integration
    [Parameter] public int Quantity { get; set; } = 10;
    [Parameter] public double Price { get; set; } = 5;

    [Parameter] public EventCallback OnOpenAddProduct { get; set; }
    [Parameter] public EventCallback OnEditQuantity { get; set; }
    [Parameter] public EventCallback OnEditPrice { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    public class StockInItemDisplay
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public decimal CurrentStock { get; set; }
        public string Unit { get; set; } = "Unit";
        public decimal PurchasePrice { get; set; }
        public string? ImagePath { get; set; }
        public string? ImageFileName { get; set; }

        public int StockInQuantity { get; set; }
        public decimal StockInCost { get; set; }
    }

    private List<StockInItemDisplay> allAvailableItems = new();
    private List<StockInItemDisplay> stockInItems = new();
    private string selectedAction = "Stock In";
    private bool orderIsOpenMain = false;
    private bool isLoading = true;
    private string remarks = "";
    private List<InventoryDM> allItemsList;
    private bool IsSuccessCreating;

    private StockInItemDisplay? editingItem;
    private string calculatorType = "";
    private bool isLocalCalculatorOpen = false;
    private double calculatorInitialValue = 0;

    // Dynamic calculations
    private int TotalSku => stockInItems.Count(i => i.StockInQuantity > 0);
    private int TotalQuantity => stockInItems.Sum(i => i.StockInQuantity);
    private decimal TotalCost => stockInItems.Where(i => i.StockInQuantity > 0).Sum(i => (decimal)i.StockInQuantity * i.StockInCost);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    public void AddProductToStockIn(string masterAccountId)
    {
        var existing = stockInItems.FirstOrDefault(i => i.Id == masterAccountId);
        if (existing != null)
        {
            existing.StockInQuantity++;
        }
        else
        {
            var matched = allAvailableItems.FirstOrDefault(i => i.Id == masterAccountId);
            if (matched != null)
            {
                stockInItems.Add(new StockInItemDisplay
                {
                    Id = matched.Id,
                    Name = matched.Name,
                    CurrentStock = matched.CurrentStock,
                    Unit = matched.Unit,
                    PurchasePrice = matched.PurchasePrice,
                    ImagePath = matched.ImagePath,
                    ImageFileName = matched.ImageFileName,
                    StockInQuantity = 1,
                    StockInCost = matched.PurchasePrice
                });
            }
        }
        StateHasChanged();
    }

    private async Task OpenAddProductModal()
    {
        await OnOpenAddProduct.InvokeAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var branchId = AppState.SelectedBranchID;

            // Load master items
            allItemsList = await InventoryService.LoadItemsAsync(branchId) ?? new List<InventoryDM>();
            var productItems = allItemsList.Where(i => i.InventoryTypeID == 1).ToList();

            if (productItems.Any())
            {
                // Load stock balances
                var req = new StockBalanceRequest
                {
                    BranchID = branchId,
                    InventoryIDs = string.Join(",", productItems.Select(p => p.MasterAccountID)),
                    FinancialDate = DateTime.Today,
                    EndDate = DateTime.Today,
                    RedemptionEndDate = DateTime.Today,
                    NewExpiryDate = DateTime.Today
                };

                var balances = await InventoryService.GetStockBalanceByBranchAndByItemAsync(req)
                              ?? new Dictionary<string, StockBalanceItem>();

                allAvailableItems.Clear();
                foreach (var pi in productItems)
                {
                    decimal currentQty = 0;
                    if (balances.TryGetValue(pi.MasterAccountID ?? string.Empty, out var balItem))
                    {
                        currentQty = balItem.ExistingQuantity;
                    }

                    allAvailableItems.Add(new StockInItemDisplay
                    {
                        Id = pi.MasterAccountID ?? string.Empty,
                        Name = pi.AccountName ?? string.Empty,
                        CurrentStock = currentQty,
                        Unit = pi.UnitOfMeasureName ?? pi.UnitOfMeasureID ?? "Unit",
                        PurchasePrice = pi.PurchasePrice,
                        ImagePath = pi.ImagePath,
                        ImageFileName = pi.ImageFileName,
                        StockInQuantity = 0,
                        StockInCost = pi.PurchasePrice
                    });
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[InventoryStockIn] Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetImageUrl(StockInItemDisplay item)
    {
        var cached = LocalImageCache.GetImage(item.Id);
        if (!string.IsNullOrEmpty(cached)) return cached;
        if (!string.IsNullOrEmpty(item.ImagePath))
        {
            return item.ImagePath;
        }
        return "https://placehold.co/400";
    }

    private void IncrementQty(StockInItemDisplay item)
    {
        item.StockInQuantity++;
    }

    private void DecrementQty(StockInItemDisplay item)
    {
        if (item.StockInQuantity > 1)
        {
            item.StockInQuantity--;
        }
        else
        {
            stockInItems.Remove(item);
        }
    }

    private void OpenCalculator(StockInItemDisplay item, string type)
    {
        editingItem = item;
        calculatorType = type;
        calculatorInitialValue = type == "Quantity" ? item.StockInQuantity : (double)item.StockInCost;
        isLocalCalculatorOpen = true;
    }

    private void CloseLocalCalculator()
    {
        isLocalCalculatorOpen = false;
        editingItem = null;
    }

    private void HandleCalculatorSave(double value)
    {
        if (editingItem != null)
        {
            if (calculatorType == "Quantity")
            {
                editingItem.StockInQuantity = (int)value;
                if (editingItem.StockInQuantity < 1)
                {
                    stockInItems.Remove(editingItem);
                }
            }
            else if (calculatorType == "Price")
            {
                editingItem.StockInCost = (decimal)value;
            }
        }
        isLocalCalculatorOpen = false;
        editingItem = null;
    }

    private void ToggleNav()
    {
        OnToggleNav.InvokeAsync();
    }

    private void OpenOrderMain()
    {
        orderIsOpenMain = true;
    }

    private void CloseOrderMain()
    {
        orderIsOpenMain = false;
    }

    private void SelectAction(string action)
    {
        selectedAction = action;
        orderIsOpenMain = false;
    }

    private async Task ConfirmStockIn()
    {
        // var activeItems = stockInItems.Where(i => i.StockInQuantity > 0).ToList();
        // System.Text.StringBuilder sb = new();
        // sb.AppendLine($"Confirmed Stock In ({selectedAction}) - Remarks: {remarks}");
        // foreach (var item in activeItems)
        // {
        //     sb.AppendLine($"- {item.Name} (ID: {item.Id}): Qty: {item.StockInQuantity}, Cost: {item.StockInCost.ToString("N2")}");
        // }
        // Console.WriteLine(sb.ToString());
        // System.Diagnostics.Debug.WriteLine(sb.ToString());

        // if (OnConfirm.HasDelegate)
        // {
        //     await OnConfirm.InvokeAsync();
        // }

        var request = new EBI.UC.Doc_Stock_GRN();

        request.mobjDoc_Stock_GRN.DocumentTypeID = 51; // Stock In
        request.mobjDoc_Stock_GRN.BranchID = AppState.SelectedBranchID;
        request.mobjDoc_Stock_GRN.FinancialDate = DateTime.Now;
        request.mobjDoc_Stock_GRN.AccountName = "";
        request.mobjDoc_Stock_GRN.Remarks = remarks;
        request.mobjDoc_Stock_GRN.StockActivityType = "Purchase";

        foreach (var item in stockInItems.Where(i => i.StockInQuantity > 0))
        {
            InventoryDM masterInventoryItem = allItemsList.FirstOrDefault(i => i.MasterAccountID == item.Id);

            var lineItem = new EBI.DM.DocumentLineTableDM();
            lineItem.Description = masterInventoryItem.AccountName;
            lineItem.InventoryTypeID = masterInventoryItem.InventoryTypeID;
            lineItem.InventoryItemAccountID = masterInventoryItem.MasterAccountID;
            lineItem.LineItemID = masterInventoryItem.MasterAccountID;
            lineItem.Quantity = item.StockInQuantity;
            lineItem.UnitPrice = item.StockInCost;

            request.lstDocumentLine.Add(lineItem);
        }

        try
        {
            var jsonOptions = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };
            var requestJson = System.Text.Json.JsonSerializer.Serialize(request, jsonOptions);
            System.Diagnostics.Debug.WriteLine($"[ConfirmStockIn] GRN Stock In Request Body:\n{requestJson}");
            Console.WriteLine($"[ConfirmStockIn] GRN Stock In Request Body:\n{requestJson}");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[ConfirmStockIn] Error serializing GRN request: {ex.Message}");
            Console.WriteLine($"[ConfirmStockIn] Error serializing GRN request: {ex.Message}");
        }

        IsSuccessCreating = await InventoryService.CreateStockInGRN(request);
        if (IsSuccessCreating)
        {
            await OnConfirm.InvokeAsync();
        }
    }
}
