@if (IsVisible)
{
    <div class="inventory-notification custom-shadow-md @Type.ToLowerInvariant()">
        <div class="notification-content">
            @if (Type.Equals("success", StringComparison.OrdinalIgnoreCase))
            {
                <i class="bi bi-check-circle-fill success-icon"></i>
            }
            else if (Type.Equals("error", StringComparison.OrdinalIgnoreCase))
            {
                <i class="bi bi-x-circle-fill error-icon"></i>
            }
            else
            {
                <i class="bi bi-info-circle-fill info-icon"></i>
            }
            <span class="notification-message">@Message</span>
        </div>
        <button class="notification-close-btn" @onclick="Close">
            <i class="bi bi-x"></i>
        </button>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public string Message { get; set; } = "Success!";
    [Parameter] public string Type { get; set; } = "success"; // success, error, info
    [Parameter] public int AutoCloseDelayMs { get; set; } = 3000;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && AutoCloseDelayMs > 0)
        {
            await Task.Delay(AutoCloseDelayMs);
            if (IsVisible)
            {
                await Close();
            }
        }
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }
}
