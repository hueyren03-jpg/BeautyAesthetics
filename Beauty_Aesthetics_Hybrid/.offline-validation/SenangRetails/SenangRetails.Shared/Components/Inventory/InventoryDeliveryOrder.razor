@inherits SenangRetails.Shared.Pages.BasePage

@if (deliveryOrderDetailsModalIsOpen)
{
    /* ============================================================
    VIEW 2: DELIVERY ORDER DETAILS (FULL SCREEN)
    ============================================================ */
    <div class="view-body" style="background-color: var(--color-background); height: 100%;">
        <div class="header">
            <button class="header-close-btn" @onclick="CloseDeliveryOrderDetailsModal">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="header-title">Delivery Order Details</div>

            <div class="top-right-button" style="width: auto; cursor: pointer; color: var(--bs-primary); font-weight: bold;" @onclick="ToggleEditDeliveryOrder">
                @if (isEditingDeliveryOrder)
                {
                    <span>Cancel</span>
                }
                else
                {
                    <span>Edit</span>
                }
            </div>
        </div>

        <div style="flex: 1; overflow-y: auto; padding-bottom: 20px;">
            <div class="summary-card-container custom-shadow-sm" style="margin-bottom: 15px; display: flex; flex-direction: column; gap: 12px;">
                <div class="summary-line" style="margin-bottom: 0;">
                    <span class="summary-text">Date</span>
                    <span class="summary-value">10/02/2026 5:11 PM</span>
                </div>
                <div class="summary-line" style="margin-bottom: 0;">
                    <span class="summary-text">Supplier</span>
                    <span class="summary-value">rtty</span>
                </div>

                <hr style="border: 0; border-top: 1px solid #eee; margin: 0;" />

                @if (isEditingDeliveryOrder)
                {
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="summary-text" style="margin-bottom: 5px; display: block;">Staff</label>
                        <select class="custom-input" style="width: 100%;">
                            <option value="YJ" selected>YJ</option>
                            <option value="John">John Doe</option>
                            <option value="Jane">Jane Smith</option>
                        </select>
                    </div>
                }
                else
                {
                    <div class="summary-line" style="margin-bottom: 0;">
                        <span class="summary-text">Staff</span>
                        <span class="summary-value">YJ</span>
                    </div>
                }

                @if (isEditingDeliveryOrder)
                {
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="summary-text" style="margin-bottom: 5px; display: block;">D.O Number</label>
                        <input type="text" class="custom-input" value="DO-2026-001" style="width: 100%;" />
                    </div>
                }
                else
                {
                    <div class="summary-line" style="margin-bottom: 0;">
                        <span class="summary-text">D.O Number</span>
                        <span class="summary-value">DO-2026-001</span>
                    </div>
                }

                @if (isEditingDeliveryOrder)
                {
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="summary-text" style="margin-bottom: 5px; display: block;">Remarks</label>
                        <textarea class="custom-input" style="width: 100%; height: 80px; resize: none;">Items delivered to the main branch. Check completed.</textarea>
                    </div>
                }
                else
                {
                    <div class="summary-line" style="flex-direction: column; align-items: flex-start; margin-bottom: 0;">
                        <span class="summary-text" style="margin-bottom: 5px;">Remarks</span>
                        <span class="summary-value" style="font-weight: normal; color: #333;">Items delivered to the main branch. Check completed.</span>
                    </div>
                }

                @if (isEditingDeliveryOrder)
                {
                    <button class="confirm-btn w-100" style="margin-top: 5px;" @onclick="SaveDeliveryOrderChanges">
                        Save Changes
                    </button>
                }
            </div>

            <div class="tool-bar" style="padding: 0; justify-content: flex-end; margin-bottom: 15px;">
                <div class="download-wrapper" style="margin: 0;">
                    <div class="filter-button cursor-pointer">
                        <span><i class="bi bi-file-earmark-arrow-down"></i> Download</span>
                    </div>
                </div>
            </div>

            <div class="stock-movement-table custom-shadow-sm">
                <div class="do-details-table-row border-bottom">
                    <span>Product</span>
                    <span class="text-align-center">Quantity</span>
                    <span class="text-align-right">Total Cost</span>
                </div>

                <div class="do-details-table-row">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <img src="https://placehold.co/400" class="stock-in-image" alt="Mask" />
                        <div class="stock-in-details">
                            <span class="stock-in-title">Mask</span>
                            <span class="stock-in-subtitle">RM 5.00</span>
                        </div>
                    </div>
                    <div class="text-align-center">
                        <span style="font-weight: bold;">10</span>
                    </div>
                    <div class="text-align-right">
                        <span style="font-weight: bold;">50.00</span>
                    </div>
                </div>

                <div class="do-details-table-row" style="border-bottom: none;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <img src="https://placehold.co/400" class="stock-in-image" alt="Gloves" />
                        <div class="stock-in-details">
                            <span class="stock-in-title">Gloves</span>
                            <span class="stock-in-subtitle">RM 10.00</span>
                        </div>
                    </div>
                    <div class="text-align-center">
                        <span style="font-weight: bold;">5</span>
                    </div>
                    <div class="text-align-right">
                        <span style="font-weight: bold;">50.00</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    /* ============================================================
    VIEW 1: DELIVERY ORDER LIST (DEFAULT)
    ============================================================ */
    <div class="view-body">
        <div class="header">
            <div class="mobile-menu-btn" @onclick="ToggleNav">
                <i class="bi bi-list"></i>
            </div>
            <div class="header-title">Delivery Order</div>
            <div class="top-right-button"><i class="fa-solid fa-plus" @onclick="OpenAddDeliveryOrder" style="cursor: pointer;"></i></div>
        </div>
        <div class="quick-summary-card">
            <div class="card">
                <span class="card-title">Total Orders</span>
                <span class="card-value">2 Orders</span>
            </div>
            <div class="card">
                <span class="card-title">Total SKU</span>
                <span class="card-value">4</span>
            </div>
            <div class="card">
                <span class="card-title">Total Cost</span>
                <span class="card-value">4</span>
            </div>
        </div>
        <div class="tool-bar">
            <div class="search-bar">
                <i class="bi bi-search"></i>
                <input class="search-stock-balance" type="text" placeholder="Search..." />
            </div>
            <div @onclick="OpenDateRange" class="date-range-button">
                <span><i class="bi bi-calendar3"></i> @selectedDateRange</span>
                @if (dateRangeIsOpen)
                {
                    <div @onclick="CloseDateRange" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color"></div>
                    <div class="dropdown-menu-simple">
                        <span @onclick='() => SelectDateRange("Today")' @onclick:stopPropagation="true">Today</span>
                        <span @onclick='() => SelectDateRange("Last 7 Days")' @onclick:stopPropagation="true">Last 7 Days</span>
                        <span @onclick='() => SelectDateRange("This Month")' @onclick:stopPropagation="true">This Month</span>
                        <span @onclick='() => SelectDateRange("Last Month")' @onclick:stopPropagation="true">Last Month</span>
                        <span @onclick='() => SelectDateRange("Custom")' @onclick:stopPropagation="true">Custom</span>
                    </div>
                }
            </div>
            <div @onclick="OpenFilter" class="filter-button">
                <span><i class="bi bi-funnel"></i> Filter</span>
                @if (filterIsOpen)
                {
                    <div @onclick="CloseFilter" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color"></div>
                    <div class="filter-dropdown-simple">
                        <label @onclick:stopPropagation="true">
                            <input type="checkbox" @bind="filterShowDisplayOnly" /> Display Only
                        </label>
                        <label @onclick:stopPropagation="true">
                            <input type="checkbox" @bind="filterOnlyMovement" /> Active Movement
                        </label>
                    </div>
                }
            </div>
            <div @onclick="OpenOrder" class="order-button">
                <span><i class="bi bi-sort-down"></i> Sort: @selectedSort</span>
                @if (orderIsOpen)
                {
                    <div @onclick="CloseOrder" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color"></div>
                    <div class="dropdown-menu-simple">
                        <span @onclick='() => SelectSort("Default")' @onclick:stopPropagation="true">Default</span>
                        <span @onclick='() => SelectSort("Name")' @onclick:stopPropagation="true">Name</span>
                        <span @onclick='() => SelectSort("Low Balance")' @onclick:stopPropagation="true">Low Balance</span>
                        <span @onclick='() => SelectSort("High Balance")' @onclick:stopPropagation="true">High Balance</span>
                        <span @onclick='() => SelectSort("Low Cost")' @onclick:stopPropagation="true">Low Cost</span>
                        <span @onclick='() => SelectSort("High Cost")' @onclick:stopPropagation="true">High Cost</span>
                    </div>
                }
            </div>
            <div class="order-button">
                <span><i class="bi bi-file-earmark-arrow-down"></i> Export</span>
            </div>
        </div>
        <div class="category-filter-bar">
            <button class="category-pill active">
                All
            </button>
            @foreach (var cat in categories)
            {
                <button class="category-pill">
                    @cat
                </button>
            }
        </div>
        <div class="stock-movement-table custom-shadow-sm border-bottom">
            <div class="stock-movement-table-row border-bottom">
                <span class="text-align-left">Date</span>
                <span class="text-align-left">Supplier</span>
                <span class="text-align-left">Info</span>
                <span class="text-align-left">Staff</span>
                <span class="text-align-right">Quantity</span>
            </div>

            <div class="stock-movement-table-row" @onclick="OpenDeliveryOrderDetailsModal" style="cursor: pointer;">
                <div class="table-card-content-row">
                    <span class="table-item-name text-align-left">10/02/2026</span>
                    <span class="text-align-left">5:11PM</span>
                </div>
                <div class="table-card-content-row">
                    <span class="table-item-name text-align-left">rtty</span>
                    <span class="text-align-left">Weerer</span>
                </div>
                <div class="table-card-content-single-row">
                    <span class="item-name text-align-left">2</span>
                </div>
                <div class="table-card-content-row">
                    <span class="table-item-name text-align-left">YJ</span>
                    <span class="text-align-left">(6019) 731-2313</span>
                </div>
                <div class="table-card-content-row">
                    <span class="table-item-name text-align-right">+2</span>
                    <span class="text-align-right">2.0</span>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================
ADD DELIVERY ORDER FULL SCREEN MODAL
============================================================ -->

@if (addDeliveryOrderIsOpen)
{
    <div class="full-screen-modal">
        <div class="screen-menu">
            @if (!isDeliveryOrderConfirmStep)
            {
                <div class="left-content">
                    <div class="header">
                        <div>
                            <i class="fa-solid fa-x" style="cursor: pointer;" @onclick="CloseAddDeliveryOrder"></i>
                        </div>
                        <div class="header-title">Delivery Order</div>
                        <div class="top-right-button"></div>
                    </div>
                    <div class="tool-bar">
                        <div class="search-bar">
                            <i class="bi bi-search"></i>
                            <input class="search-stock-balance" type="text" />
                        </div>
                        <div class="date-picker">
                            <div @onclick="OpenProductFilter" class="date-range-button">
                                <span><i class="bi bi-box"></i> All</span>
                                @if (productFilterIsOpen)
                                {
                                    <div @onclick="CloseProductFilter" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color" style="z-index: 2002;"></div>
                                    <div class="right-order-option-wrapper" style="z-index: 2003;">
                                        <span @onclick="CloseProductFilter" @onclick:stopPropagation="true">All</span>
                                        <span>Low Stock</span>
                                        <span>Insufficient Stock</span>
                                        <span>Stock Expiry</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div @onclick="OpenSortAddProduct" class="order-button">
                            <i class="bi bi-sort-down"></i>
                            @if (sortAddProductIsOpen)
                            {
                                <div @onclick="CloseSortAddProduct" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color" style="z-index: 2002;"></div>
                                <div class="order-option-wrapper" style="z-index: 2003;">
                                    <span @onclick="CloseSortAddProduct" @onclick:stopPropagation="true">Name</span>
                                    <span>Low Price</span>
                                    <span>High Price</span>
                                </div>
                            }
                        </div>
                        <div @onclick="OpenSupplierAddProduct" class="order-button">
                            Select Supplier
                            @if (supplierAddProductIsOpen)
                            {
                                <div @onclick="CloseSupplierAddProduct" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color" style="z-index: 2002;"></div>
                                <div class="order-option-wrapper" style="z-index: 2003;">
                                    <span @onclick="CloseSupplierAddProduct" @onclick:stopPropagation="true">None</span>
                                    <span>example supplier</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="category-filter-bar">
                        <button class="category-pill active">All</button>
                        @foreach (var cat in categories)
                        {
                            <button class="category-pill">@cat</button>
                        }
                    </div>
                    <div class="item-grid">
                        <div @onclick="OpenDeliveryOrderModal" class="addProductCard" style="cursor: pointer;">
                            <img class="table-item-image" src="https://placehold.co/400" alt="Mask" />
                            <div class="table-card-content-row stock-movement-product-name">
                                <span>Mask</span>
                                <span>5.00</span>
                            </div>
                            <div class="table-card-content-row text-align-right">
                                <span>18</span>
                                <span>Unit</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="right-content" style="display: flex; flex-direction: column;">
                    <div style="flex-grow: 1; overflow-y: auto;">
                        <div class="delibery-product-card padding">
                            <img class="table-item-image" src="https://placehold.co/400" alt="Mask" />
                            <div class="table-card-content-row stock-movement-product-name">
                                <span>Mask</span>
                                <span>5.00</span>
                            </div>
                            <div class="text-align-center">
                                <span class="number-button" @onclick="OpenPriceModal">18</span>
                            </div>
                        </div>
                    </div>
                    <div class="delivery-order-total" style="margin-bottom: 15px;">
                        <div class="side-by-side">
                            <span>Items</span>
                            <span>1</span>
                        </div>
                        <div class="side-by-side">
                            <span>Quantity</span>
                            <span>1</span>
                        </div>
                        <div class="side-by-side">
                            <span>Total Cost</span>
                            <span class="number-button" @onclick="OpenPriceModal">200</span>
                        </div>
                    </div>
                    <div style="padding: 0 15px 15px 15px;">
                        <button class="confirm-btn w-100" @onclick="GoToDeliveryOrderConfirmStep">
                            Next
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="left-content" style="display: flex; flex-direction: column;">
                    <div class="header">
                        <div>
                            <i class="fa-solid fa-arrow-left" style="cursor: pointer;" @onclick="GoBackToDeliveryOrderSelectStep"></i>
                        </div>
                        <div class="header-title">Confirm Delivery Order</div>
                        <div class="top-right-button"></div>
                    </div>

                    <div class="details-form-container" style="padding: 20px; flex-grow: 1; overflow-y: auto;">
                        <div class="form-group">
                            <label>Staff</label>
                            <select class="custom-input">
                                <option value="" disabled selected>Select Staff</option>
                                <option value="1">John Doe</option>
                                <option value="2">Jane Smith</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Supplier</label>
                            <select class="custom-input">
                                <option value="" disabled selected>Select Supplier</option>
                                <option value="1">Supplier A</option>
                                <option value="2">Supplier B</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>D.O Number</label>
                            <input type="text" class="custom-input" placeholder="Enter D.O Number" />
                        </div>

                        <div class="form-group">
                            <label>Remarks</label>
                            <textarea class="custom-input" placeholder="Enter any remarks..." style="height: 100px; resize: none;"></textarea>
                        </div>

                        <button class="confirm-btn w-100" style="margin-top: 20px;" @onclick="SubmitDeliveryOrder">
                            Submit Delivery Order
                        </button>
                    </div>
                </div>

                <div class="right-content" style="display: flex; flex-direction: column;">
                    <div style="flex-grow: 1; overflow-y: auto;">
                        <div class="delibery-product-card padding">
                            <img class="table-item-image" src="https://placehold.co/400" alt="Mask" />
                            <div class="table-card-content-row stock-movement-product-name">
                                <span>Mask</span>
                                <span>5.00</span>
                            </div>
                            <div class="text-align-center">
                                <span class="number-button" @onclick="OpenPriceModal">18</span>
                            </div>
                        </div>
                    </div>
                    <div class="delivery-order-total" style="margin-bottom: 15px;">
                        <div class="side-by-side">
                            <span>Items</span>
                            <span>1</span>
                        </div>
                        <div class="side-by-side">
                            <span>Quantity</span>
                            <span>1</span>
                        </div>
                        <div class="side-by-side">
                            <span>Total Cost</span>
                            <span class="number-button" @onclick="OpenPriceModal">200</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="delivery-order-modal-root">
    <SlideModal IsOpen="@deliveryOrderItemDetailsModalIsOpen" CssClass="delivery-order-item-details-modal" ZIndexBackdrop="6000" ZIndexModal="6001" OnClose="CloseDeliveryOrderItemDetailsModal">
        <div class="header">
            <div @onclick="CloseDeliveryOrderItemDetailsModal" style="cursor: pointer;">
                <i class="bi bi-x-lg"></i>
            </div>
            <div class="header-title">Item Details</div>
            <div style="width: 24px;"></div>
        </div>
        <div class="details-form-container">
            <div class="form-group">
                <label>Cost Per Unit</label>
                <div class="input-wrapper">
                    <span>RM</span>
                    <input type="number" step="0.01" class="custom-input" placeholder="0.00" />
                </div>
            </div>
            <div class="form-group">
                <label>Quantity</label>
                <input type="number" @bind="selectedDeliveryOrderQuantity" class="custom-input" />
            </div>
            <div class="form-group">
                <label>Cost</label>
                <input type="number" class="custom-input" />
            </div>
        </div>
        <button class="confirm-btn" @onclick="ConfirmDeliveryOrderAddItem">
            Confirm &amp; Add
        </button>
    </SlideModal>
</div>

<!-- ============================================================
CALCULATORS
============================================================ -->

<Calculator IsOpen="@quantityDeliveryOrderModalIsOpen"
            InitialValue="@selectedDeliveryOrderQuantity"
            OnSave="HandleDeliveryOrderSave"
            OnClose="CloseDeliveryOrderModal" />

<Calculator IsOpen="@priceModalIsOpen"
            Title="Price"
            AllowDecimal="true"
            InitialValue="@selectedprice"
            OnSave="HandlePriceSave"
            OnClose="ClosePriceModal" />

@code {
    [Parameter] public EventCallback OnToggleNav { get; set; }

    private bool dateRangeIsOpen = false;
    private bool filterIsOpen = false;
    private bool orderIsOpen = false;

    private string selectedSort = "Default";
    private string selectedDateRange = "This Month";
    private bool filterShowDisplayOnly = false;
    private bool filterOnlyMovement = false;

    private List<string> categories = new() { "Section 1", "Section 2" };

    // Modals
    private bool addDeliveryOrderIsOpen = false;
    private bool deliveryOrderDetailsModalIsOpen = false;
    private bool isEditingDeliveryOrder = false;

    private bool isDeliveryOrderConfirmStep = false;
    private bool productFilterIsOpen = false;
    private bool sortAddProductIsOpen = false;
    private bool supplierAddProductIsOpen = false;

    private bool deliveryOrderItemDetailsModalIsOpen = false;

    // Calculators
    private bool quantityDeliveryOrderModalIsOpen = false;
    private int selectedDeliveryOrderQuantity = 1;

    private bool priceModalIsOpen = false;
    private double selectedprice = 200;

    private void ToggleNav()
    {
        OnToggleNav.InvokeAsync();
    }

    private void OpenDateRange()
    {
        dateRangeIsOpen = true;
    }

    private void CloseDateRange()
    {
        dateRangeIsOpen = false;
    }

    private void SelectDateRange(string val)
    {
        selectedDateRange = val;
        dateRangeIsOpen = false;
    }

    private void OpenFilter()
    {
        filterIsOpen = true;
    }

    private void CloseFilter()
    {
        filterIsOpen = false;
    }

    private void OpenOrder()
    {
        orderIsOpen = true;
    }

    private void CloseOrder()
    {
        orderIsOpen = false;
    }

    private void SelectSort(string val)
    {
        selectedSort = val;
        orderIsOpen = false;
    }

    private void OpenAddDeliveryOrder()
    {
        addDeliveryOrderIsOpen = true;
    }

    private void CloseAddDeliveryOrder()
    {
        addDeliveryOrderIsOpen = false;
        isDeliveryOrderConfirmStep = false;
    }

    private void OpenDeliveryOrderDetailsModal()
    {
        deliveryOrderDetailsModalIsOpen = true;
        isEditingDeliveryOrder = false;
    }

    private void CloseDeliveryOrderDetailsModal()
    {
        deliveryOrderDetailsModalIsOpen = false;
    }

    private void ToggleEditDeliveryOrder()
    {
        isEditingDeliveryOrder = !isEditingDeliveryOrder;
    }

    private void SaveDeliveryOrderChanges()
    {
        isEditingDeliveryOrder = false;
    }

    private void OpenProductFilter() { productFilterIsOpen = true; }
    private void CloseProductFilter() { productFilterIsOpen = false; }

    private void OpenSortAddProduct() { sortAddProductIsOpen = true; }
    private void CloseSortAddProduct() { sortAddProductIsOpen = false; }

    private void OpenSupplierAddProduct() { supplierAddProductIsOpen = true; }
    private void CloseSupplierAddProduct() { supplierAddProductIsOpen = false; }

    private void OpenDeliveryOrderModal()
    {
        quantityDeliveryOrderModalIsOpen = true;
    }

    private void CloseDeliveryOrderModal()
    {
        quantityDeliveryOrderModalIsOpen = false;
    }

    private void HandleDeliveryOrderSave(double value)
    {
        selectedDeliveryOrderQuantity = (int)value;
        quantityDeliveryOrderModalIsOpen = false;
        deliveryOrderItemDetailsModalIsOpen = true;
    }

    private void CloseDeliveryOrderItemDetailsModal()
    {
        deliveryOrderItemDetailsModalIsOpen = false;
    }

    private void ConfirmDeliveryOrderAddItem()
    {
        deliveryOrderItemDetailsModalIsOpen = false;
    }

    private void OpenPriceModal()
    {
        priceModalIsOpen = true;
    }

    private void ClosePriceModal()
    {
        priceModalIsOpen = false;
    }

    private void HandlePriceSave(double value)
    {
        selectedprice = value;
        priceModalIsOpen = false;
    }

    private void GoToDeliveryOrderConfirmStep()
    {
        isDeliveryOrderConfirmStep = true;
    }

    private void GoBackToDeliveryOrderSelectStep()
    {
        isDeliveryOrderConfirmStep = false;
    }

    private void SubmitDeliveryOrder()
    {
        isDeliveryOrderConfirmStep = false;
        addDeliveryOrderIsOpen = false;
    }
}
