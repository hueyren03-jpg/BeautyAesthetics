@using SenangRetails.Shared.Components.Common

<div class="item-details-modal-root">
    <SlideModal IsOpen="@IsOpen" CssClass="stock-in-main-item-details-modal" ZIndexBackdrop="6000" ZIndexModal="6001" OnClose="OnClose">
        <div class="header">
            <div @onclick="OnClose" style="cursor: pointer;">
                <i class="bi bi-x-lg"></i>
            </div>
            <div class="header-title">@Title</div>
            <div style="width: 24px;"></div>
        </div>
        <div class="details-form-container">
            <div class="form-group">
                <label>Cost Per Unit</label>
                <div class="input-wrapper">
                    <span>RM</span>
                    <input type="number" step="0.01" class="custom-input" placeholder="0.00" value="@Cost" @onchange="OnCostChange" />
                </div>
            </div>
            <div class="form-group">
                <label>Quantity</label>
                <input type="number" class="custom-input" value="@Quantity" @onchange="OnQuantityChange" />
            </div>
            <div class="form-group">
                <label>Expiry Date</label>
                <input type="date" class="custom-input" value="@ExpiryDate" @onchange="OnExpiryDateChange" />
            </div>
        </div>
        <button class="confirm-btn" @onclick="OnConfirm">
            Confirm &amp; Add
        </button>
    </SlideModal>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Item Details";
    [Parameter] public EventCallback OnClose { get; set; }
    
    [Parameter] public int Quantity { get; set; }
    [Parameter] public EventCallback<int> QuantityChanged { get; set; }

    [Parameter] public double Cost { get; set; }
    [Parameter] public EventCallback<double> CostChanged { get; set; }

    [Parameter] public string ExpiryDate { get; set; } = "";
    [Parameter] public EventCallback<string> ExpiryDateChanged { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }

    private async Task OnQuantityChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var qty))
        {
            Quantity = qty;
            await QuantityChanged.InvokeAsync(qty);
        }
    }

    private async Task OnCostChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var cost))
        {
            Cost = cost;
            await CostChanged.InvokeAsync(cost);
        }
    }

    private async Task OnExpiryDateChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        ExpiryDate = val;
        await ExpiryDateChanged.InvokeAsync(val);
    }
}
