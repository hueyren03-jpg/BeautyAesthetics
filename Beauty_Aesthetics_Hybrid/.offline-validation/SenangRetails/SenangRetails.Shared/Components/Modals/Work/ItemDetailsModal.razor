@using SenangRetails.Shared.Components.Common
@using SenangRetails.Shared.Models

<BaseModal Visible="Visible" OnClose="OnClose" Size="BaseModal.ModalSize.Medium">
    <div class="details-modal">
        <div class="details-header">
            <button type="button" class="custom-close-btn" @onclick="OnClose">
                <i class="oi oi-x"></i>
            </button>
            <h3 class="title">Details</h3>
        </div>

        <div class="details-content">
            <div class="item-card" style="cursor:default">
                <div class="item-icon">
                    <img src="/images/icon.png" class="icon-img" />
                </div>

                <div class="item-info">
                    <div class="item-main">
                        <span class="item-name">@ItemModel.ItemName</span>
                        <span class="item-count">@ItemModel.Quantity</span>
                    </div>
                    <div class="item-sub">
                        <span class="item-price-unit">@ItemModel.Price</span>
                        <span class="item-price-total">@ItemModel.Subtotal</span>
                    </div>
                </div>
            </div>

            <div class="section-label">Orders</div>

            <div class="item-card" @onclick="HandleReceiptClick">
                <div class="item-info no-icon">
                    <div class="item-main">
                        <span class="order-id">#@ReceiptModel.ReceiptNo</span>
                        <span class="item-count">@(ReceiptModel.Items?.Count ?? 0)</span>
                    </div>
                    <div class="item-sub">
                        <span class="order-tag">@(ReceiptModel.Member is MemberDetailsDM m ? m.Name : ReceiptModel.Member?.ToString())</span>
                        <span class="item-price-total">@ReceiptModel.Items?.Sum(i => i.Price * i.Quantity).ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseModal>




