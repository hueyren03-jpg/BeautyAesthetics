<div class="clock-panel-content">
    <h2 class="qr-title">Scan to clock @Mode</h2>

    <div class="qr-container">
        <div class="qr-code">
            <!-- QR Code Placeholder -->
            <img src="_content/SenangRetails.Shared/qr_code.png" alt="QR Code" />
        </div>
    </div>

    <div class="qr-timer">
        <span class="timer-icon"><i class="bi bi-stopwatch"></i></span>
        <span>Code expires in @(TimeRemaining)s</span>
    </div>
</div>

@code {
    [Parameter] public string Mode { get; set; } = "in";
    [Parameter] public int TimeRemaining { get; set; } = 60;
}