@inject LanguageService LangSvc

@if (IsOpen)
{
    <div class="modal-overlay" style="z-index: @ZIndexBackdrop;" @onclick="Close">
        <div class="modal-content keypad-modal" style="max-width: 350px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Edit @Title</h3>
                <button class="close-btn" @onclick="Close">&times;</button>
            </div>
            <div class="modal-body">
                <div class="keypad-display">
                    @(Title == "Price" || Title == "Discount Amount" ? "RM " : "")@GetFormattedDisplay()
                </div>
                @if (Title == "Quantity" && (decimal.TryParse(GetFormattedDisplay(), out var val) && val <= 0))
                {
                    <div style="color: var(--color-red); text-align: center; font-size: 14px; font-weight: bold; margin-top: -10px; margin-bottom: 10px;">
                        Min Value: 0.01
                    </div>
                }
                <div class="keypad-grid">
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("1")'>1</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("2")'>2</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("3")'>3</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("4")'>4</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("5")'>5</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("6")'>6</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("7")'>7</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("8")'>8</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("9")'>9</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit(".")'>.</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("0")'>0</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("⌫")'>⌫</button>
                </div>
                <div style="margin-top: 1rem; display: flex; gap: 10px; padding: 1rem;">
                    <button class="orders-btn-secondary" style="flex: 1;" @onclick="ClearNumber">@LangSvc.GetText("OrdersClear")</button>
                    <button class="orders-btn-primary" style="flex: 1;" @onclick="Save">@LangSvc.GetText("OrdersSave")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {

    // ===== PARAMETERS =====

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string Title { get; set; } = "Quantity";

    [Parameter]
    public double InitialValue { get; set; }

    [Parameter]
    public EventCallback<double> OnSave { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public bool AllowDecimal { get; set; } = false;

    [Parameter]
    public int ZIndexBackdrop { get; set; } = 7000;

    [Parameter]
    public int ZIndexModal { get; set; } = 7001;


    // ===== INTERNAL STATE =====

    private string currentQuantityInput = string.Empty;
    private bool isOpenPrev;
    private bool isFirstInput = true;

    protected override void OnParametersSet()
    {
        if (IsOpen && !isOpenPrev)
        {
            isFirstInput = true;
            if (AllowDecimal)
            {
                long cents = (long)Math.Round(InitialValue * 100.0);
                currentQuantityInput = cents > 0 ? cents.ToString() : string.Empty;
            }
            else
            {
                currentQuantityInput = InitialValue > 0
                    ? ((int)InitialValue).ToString()
                    : string.Empty;
            }
        }
        isOpenPrev = IsOpen;
    }

    private string GetFormattedDisplay()
    {
        if (AllowDecimal)
        {
            if (string.IsNullOrEmpty(currentQuantityInput))
            {
                return "0.00";
            }
            if (double.TryParse(currentQuantityInput, out var cents))
            {
                return (cents / 100.0).ToString("F2");
            }
            return "0.00";
        }
        else
        {
            return string.IsNullOrEmpty(currentQuantityInput) ? "0" : currentQuantityInput;
        }
    }

    private void HandleNumpadEdit(string input)
    {
        if (isFirstInput)
        {
            isFirstInput = false;
            if (input != "⌫" && input != ".")
            {
                currentQuantityInput = string.Empty;
            }
        }

        if (input == "⌫")
        {
            DeleteNumber();
        }
        else if (input == ".")
        {
            // Ignored as it is cents-based or integer input
        }
        else
        {
            AppendNumber(input);
        }
    }

    private void AppendNumber(string number)
    {
        if (isFirstInput)
        {
            currentQuantityInput = string.Empty;
            isFirstInput = false;
        }

        if (currentQuantityInput.Length >= 9)
        {
            return;
        }

        if (AllowDecimal)
        {
            if (number == "0" && string.IsNullOrEmpty(currentQuantityInput))
            {
                return;
            }
            currentQuantityInput += number;
        }
        else
        {
            currentQuantityInput += number;
        }
    }

    private void ClearNumber()
    {
        currentQuantityInput = string.Empty;
        isFirstInput = false;
    }

    private void DeleteNumber()
    {
        isFirstInput = false;
        if (!string.IsNullOrEmpty(currentQuantityInput))
        {
            currentQuantityInput =
                currentQuantityInput[..^1];
        }
    }

    private async Task Save()
    {
        double result = 0;
        if (AllowDecimal)
        {
            if (double.TryParse(currentQuantityInput, out var cents))
            {
                result = cents / 100.0;
            }
        }
        else
        {
            double.TryParse(currentQuantityInput, out result);
        }

        await OnSave.InvokeAsync(result);
        await Close();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}