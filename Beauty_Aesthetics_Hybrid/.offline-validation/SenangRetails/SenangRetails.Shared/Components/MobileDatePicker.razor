@typeparam TValue

<div class="mobile-date-picker">
    <div class="date-display" @onclick="TogglePicker">
        <span class="date-text">@GetDisplayText()</span>
    </div>
    
    @if (showPicker)
    {
        <div class="date-picker-overlay" @onclick="ClosePicker">
            <div class="date-picker-modal" @onclick:stopPropagation>
                <div class="picker-header">
    <button class="picker-cancel-btn" @onclick="ClosePicker">Cancel</button>
    <span class="picker-title">Select Date</span>
    <button class="picker-confirm-btn" @onclick="ConfirmDate">OK</button>
</div>
                
                <div class="picker-body">
                    <!-- Month and Year Selection Dropdowns -->
                    <div class="picker-month-year-select">
                        <div class="select-group">
                            <label class="select-label">Month</label>
                            <select class="month-select"
                                    value="@selectedMonth"
                                    @onchange="(ChangeEventArgs e) => { selectedMonth = int.Parse(e.Value.ToString()); OnMonthYearChanged(); }">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i);
                                    <option value="@i">@monthName</option>
                                }
                            </select>
                        </div>
                        <div class="select-group">
                            <label class="select-label">Year</label>
                           <select class="year-select" 
                                    value="@selectedYear" 
                                    @onchange="(ChangeEventArgs e) => { selectedYear = int.Parse(e.Value.ToString()); OnMonthYearChanged(); }">
                                @for (int i = DateTime.Now.Year + 10; i >= 1900; i--)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                    </div>
                    
                    <!-- Navigation Arrows (still available) -->
                    <div class="picker-month-year-nav">
                        <button class="nav-btn" @onclick="() => ChangeMonth(-1)">‹</button>
                        <span class="month-year-text">@GetMonthYearText()</span>
                        <button class="nav-btn" @onclick="() => ChangeMonth(1)">›</button>
                    </div>
                    
                    <!-- Weekdays -->
                    <div class="picker-weekdays">
                        <span class="weekday-label">Mo</span>
                        <span class="weekday-label">Tu</span>
                        <span class="weekday-label">We</span>
                        <span class="weekday-label">Th</span>
                        <span class="weekday-label">Fr</span>
                        <span class="weekday-label">Sa</span>
                        <span class="weekday-label">Su</span>
                    </div>
                    
                    <!-- Days Grid -->
                    <div class="picker-days-grid">
                        @foreach (var day in GetDaysInMonth())
                        {
                            <div class="picker-day @(day.IsCurrentMonth ? "current-month" : "other-month") @(day.IsSelected ? "selected" : "") @(day.IsToday ? "today" : "")"
                                 @onclick="() => SelectDay(day)">
                                @day.DayNumber
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select Date";
    [Parameter] public string DateFormat { get; set; } = "dd/MM/yyyy";
    
    private bool showPicker = false;
    private DateTime viewDate = DateTime.Today;
    private int selectedMonth = DateTime.Today.Month;
    private int selectedYear = DateTime.Today.Year;
    private int? tempDay = null;
    private int? tempMonth = null;
    private int? tempYear = null;
    
    private DateTime SelectedDate
    {
        get
        {
            if (Value != null && Value is DateTime dt)
                return dt;
            return DateTime.MinValue;
        }
        set
        {
            Value = (TValue)(object)value;
            ValueChanged.InvokeAsync(Value);
        }
    }
    
    protected override void OnParametersSet()
    {
        if (SelectedDate != DateTime.MinValue)
        {
            viewDate = SelectedDate;
            selectedMonth = SelectedDate.Month;
            selectedYear = SelectedDate.Year;
            tempDay = SelectedDate.Day;
            tempMonth = SelectedDate.Month;
            tempYear = SelectedDate.Year;
        }
        else
        {
            tempDay = null;
            tempMonth = null;
            tempYear = null;
        }
    }
    
    private void TogglePicker()
    {
        showPicker = !showPicker;
        if (showPicker)
        {
            if (SelectedDate != DateTime.MinValue)
            {
                viewDate = SelectedDate;
                selectedMonth = SelectedDate.Month;
                selectedYear = SelectedDate.Year;
                tempDay = SelectedDate.Day;
                tempMonth = SelectedDate.Month;
                tempYear = SelectedDate.Year;
            }
            else
            {
                viewDate = DateTime.Today;
                selectedMonth = DateTime.Today.Month;
                selectedYear = DateTime.Today.Year;
                tempDay = DateTime.Today.Day;
                tempMonth = DateTime.Today.Month;
                tempYear = DateTime.Today.Year;
            }
        }
    }
    
    private void ClosePicker()
    {
        showPicker = false;
        if (SelectedDate != DateTime.MinValue)
        {
            tempDay = SelectedDate.Day;
            tempMonth = SelectedDate.Month;
            tempYear = SelectedDate.Year;
        }
    }
    
    private void ChangeMonth(int delta)
    {
        viewDate = viewDate.AddMonths(delta);
        selectedMonth = viewDate.Month;
        selectedYear = viewDate.Year;
        StateHasChanged();
    }
    
    private void OnMonthYearChanged()
    {
        try
        {
            // Ensure the date is valid (handle February 31st, etc.)
            var daysInMonth = DateTime.DaysInMonth(selectedYear, selectedMonth);
            var day = tempDay.HasValue && tempDay.Value <= daysInMonth ? tempDay.Value : 1;
            
            viewDate = new DateTime(selectedYear, selectedMonth, day);
            
            // Update temp values
            tempMonth = selectedMonth;
            tempYear = selectedYear;
            tempDay = day;
            
            StateHasChanged();
        }
        catch
        {
            // Invalid date - reset to first of month
            try
            {
                viewDate = new DateTime(selectedYear, selectedMonth, 1);
                tempDay = 1;
                tempMonth = selectedMonth;
                tempYear = selectedYear;
                StateHasChanged();
            }
            catch
            {
                // Still invalid - use current date
                viewDate = DateTime.Today;
                selectedMonth = DateTime.Today.Month;
                selectedYear = DateTime.Today.Year;
                tempDay = DateTime.Today.Day;
                tempMonth = DateTime.Today.Month;
                tempYear = DateTime.Today.Year;
                StateHasChanged();
            }
        }
    }
    
    private void SelectDay(DayData day)
    {
        if (day.IsCurrentMonth)
        {
            tempDay = day.DayNumber;
            tempMonth = viewDate.Month;
            tempYear = viewDate.Year;
        }
        else if (day.DayNumber > 15)
        {
            viewDate = viewDate.AddMonths(-1);
            selectedMonth = viewDate.Month;
            selectedYear = viewDate.Year;
            tempDay = day.DayNumber;
            tempMonth = viewDate.Month;
            tempYear = viewDate.Year;
        }
        else
        {
            viewDate = viewDate.AddMonths(1);
            selectedMonth = viewDate.Month;
            selectedYear = viewDate.Year;
            tempDay = day.DayNumber;
            tempMonth = viewDate.Month;
            tempYear = viewDate.Year;
        }
        StateHasChanged();
    }
    
    private async Task ConfirmDate()
    {
        if (tempDay.HasValue && tempMonth.HasValue && tempYear.HasValue)
        {
            try
            {
                var selectedDate = new DateTime(tempYear.Value, tempMonth.Value, tempDay.Value);
                SelectedDate = selectedDate;
                await ValueChanged.InvokeAsync(Value);
                showPicker = false;
            }
            catch
            {
                // Invalid date combination - show error or ignore
            }
        }
    }
    
    private string GetDisplayText()
    {
        if (SelectedDate != DateTime.MinValue)
        {
            return SelectedDate.ToString(DateFormat);
        }
        return Placeholder;
    }
    
    private string GetMonthYearText()
    {
        return viewDate.ToString("MMMM yyyy");
    }
    
    private List<DayData> GetDaysInMonth()
    {
        var days = new List<DayData>();
        var firstDayOfMonth = new DateTime(viewDate.Year, viewDate.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(viewDate.Year, viewDate.Month);
        
        int firstDayOfWeek = (int)firstDayOfMonth.DayOfWeek;
        if (firstDayOfWeek == 0) firstDayOfWeek = 7;
        int leadingDays = firstDayOfWeek - 1;
        
        var prevMonth = viewDate.AddMonths(-1);
        var daysInPrevMonth = DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        for (int i = daysInPrevMonth - leadingDays + 1; i <= daysInPrevMonth; i++)
        {
            days.Add(new DayData
            {
                DayNumber = i,
                IsCurrentMonth = false,
                IsSelected = false,
                IsToday = false,
                Date = new DateTime(prevMonth.Year, prevMonth.Month, i)
            });
        }
        
        for (int i = 1; i <= daysInMonth; i++)
        {
            var date = new DateTime(viewDate.Year, viewDate.Month, i);
            bool isSelected = tempDay.HasValue && tempMonth.HasValue && tempYear.HasValue &&
                             i == tempDay.Value && viewDate.Month == tempMonth.Value && viewDate.Year == tempYear.Value;
            bool isToday = date.Date == DateTime.Today;
            
            days.Add(new DayData
            {
                DayNumber = i,
                IsCurrentMonth = true,
                IsSelected = isSelected,
                IsToday = isToday,
                Date = date
            });
        }
        
        int remainingDays = 42 - days.Count;
        var nextMonth = viewDate.AddMonths(1);
        for (int i = 1; i <= remainingDays; i++)
        {
            days.Add(new DayData
            {
                DayNumber = i,
                IsCurrentMonth = false,
                IsSelected = false,
                IsToday = false,
                Date = new DateTime(nextMonth.Year, nextMonth.Month, i)
            });
        }
        
        return days;
    }
    
    private class DayData
    {
        public int DayNumber { get; set; }
        public bool IsCurrentMonth { get; set; }
        public bool IsSelected { get; set; }
        public bool IsToday { get; set; }
        public DateTime Date { get; set; }
    }
}