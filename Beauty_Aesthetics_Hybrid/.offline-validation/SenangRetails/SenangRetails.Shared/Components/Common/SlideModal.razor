@if (IsOpen)
{
    <div class="all-modal-backdrop" style="z-index: @ZIndexBackdrop;" @onclick="CloseModal"></div>
    <div class="@CssClass" style="z-index: @ZIndexModal;" @onclick:stopPropagation>
        @ChildContent
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public int ZIndexModal { get; set; } = 4001;
    [Parameter] public int ZIndexBackdrop { get; set; } = 4000;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }
}
