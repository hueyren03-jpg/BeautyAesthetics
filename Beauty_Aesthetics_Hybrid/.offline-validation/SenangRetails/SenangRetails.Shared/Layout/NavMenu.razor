@* @using System.Diagnostics
@using SenangRetails.Shared.Services
@inject EInvoiceSetupGuideService EInvoiceSetupGuideService
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="sidebar-overlay @(IsExpanded ? "expanded" : "")"></div>
<div class="sidebar-wrapper @(IsExpanded ? "expanded" : "collapsed")"
>

    <div class="menu-trigger" @onclick="ToggleMenu">
        <div class="hamburger-icon"></div>
    </div>

    <div class="nav-container">
        <nav class="nav flex-column">
            <div class="nav-item">
                <NavLink class="nav-link" href="einvoice" Match="NavLinkMatch.All" @onclick="CollapseMenu">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                    <span class="link-text">E-Invoice Profile</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="EInvoices" @onclick="CollapseMenu">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>
                    <span class="link-text">E-Invoices</span>
                </NavLink>
            </div>

            <div class="nav-item nav-footer">
                <a class="nav-link" style="cursor:pointer" @onclick="HandleSetupGuideClick">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>
                    <span class="link-text">Setup Guide</span>
                </a>
            </div>
        </nav>
    </div>
</div>

@code {
    private System.Threading.Timer? _hoverTimer;

    [Parameter] public EventCallback OnStatusChanged { get; set; }

    public bool IsExpanded { get; private set; } = false;

    private void ToggleMenu()
    {
        IsExpanded = !IsExpanded;
        OnStatusChanged.InvokeAsync();
    }

    private async Task HandleMouseEnter()
    {
        _hoverTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                IsExpanded = true;
                StateHasChanged();
                await OnStatusChanged.InvokeAsync();
            });
        }, null, 300, System.Threading.Timeout.Infinite);
    }

    private async Task HandleMouseLeave()
    {
        _hoverTimer?.Dispose();
        IsExpanded = false;
        await OnStatusChanged.InvokeAsync();
    }


    private async Task CollapseMenu()
    {
        if (IsExpanded)
        {
            IsExpanded = false;
            await OnStatusChanged.InvokeAsync();
        }
    }

    private async Task HandleSetupGuideClick()
    {
        EInvoiceSetupGuideService.Open();
        await CollapseMenu();
    }
} *@