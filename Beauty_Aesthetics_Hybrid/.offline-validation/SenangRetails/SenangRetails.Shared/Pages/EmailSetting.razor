@page "/emailsetting"
@inherits SenangRetails.Shared.Pages.BasePage
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Services
@inject SenangRetails.Shared.Services.EmailSettingService.IEmailSettingService EmailSettingService
@inject AppState AppState

<div class="email-container">

    <!-- Page Header -->
    <div class="email-header">
        <h2 class="email-title">Email Settings</h2>
        <p class="email-subtitle">Set up email settings and preferences</p>
    </div>

    <!-- Form Card -->
    <div class="email-card">
        <div class="card-section-label">Email Account</div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert-success">@successMessage</div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-error">@errorMessage</div>
        }

        <!-- Email Address + Enable SSL -->
        <div class="form-row-header">
            <label class="form-label">Email Address <span class="required">*</span></label>
            <div class="ssl-toggle">
                <input type="checkbox" id="enableSsl" class="email-checkbox" @bind="model.EnableSsl" />
                <label for="enableSsl" class="ssl-label">Enable SSL</label>
            </div>
        </div>
        <div class="form-group">
            <input type="email" class="form-control" placeholder="Email Address" @bind="model.EmailAddress" />
        </div>

        <!-- Display Name -->
        <div class="form-group">
            <label class="form-label">Display Name</label>
            <input type="text" class="form-control" placeholder="Display Name" @bind="model.DisplayName" />
        </div>

        <!-- Username -->
        <div class="form-group">
            <label class="form-label">Username</label>
            <input type="text" class="form-control" placeholder="Username" @bind="model.Username" />
        </div>

        <!-- Password -->
        <div class="form-group">
            <label class="form-label">Password</label>
            <div class="input-icon-wrap">
                <input type="@(showPassword ? "text" : "password")" class="form-control"
                       placeholder="Password" @bind="model.Password" />
                <button type="button" class="icon-btn" @onclick="TogglePasswordVisibility">
                    @if (showPassword)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    }
                </button>
            </div>
        </div>

        <!-- SMTP Server -->
        <div class="form-group">
            <label class="form-label">SMTP Server</label>
            <input type="text" class="form-control" placeholder="SMTP" @bind="model.SmtpServer" />
        </div>

        <!-- Port No -->
        <div class="form-group">
            <label class="form-label">Port No</label>
            <div class="input-icon-wrap">
                <input type="number" class="form-control" placeholder="Port No" @bind="model.Port" min="1" max="65535" />
            </div>
        </div>

        <!-- Save Button -->
        <div class="form-footer">
            <button class="btn-save-full" @onclick="SaveChanges" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save Changes")
            </button>
        </div>
    </div>
</div>

@code {
    private EmailSettingModel model = new();
    private bool showPassword = false;
    private bool isSaving = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    private class EmailSettingModel
    {
        public string EmailAddress { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string SmtpServer { get; set; } = string.Empty;
        public int? Port { get; set; }
        public bool EnableSsl { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEmailSettingsAsync();
    }

    private async Task LoadEmailSettingsAsync()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        var branchId = string.IsNullOrEmpty(AppState.SelectedBranchID) ? "HQ" : AppState.SelectedBranchID;

        try
        {
            var (dto, msg) = await EmailSettingService.GetEmailSettingAsync(branchId);
            if (dto != null)
            {
                model.EmailAddress = dto.emailAddress ?? string.Empty;
                model.DisplayName = dto.emailDisplayName ?? string.Empty;
                model.Username = dto.emailUsername ?? string.Empty;
                model.Password = dto.emailPassword ?? string.Empty;
                model.SmtpServer = dto.emailSmtp ?? string.Empty;
                model.Port = dto.emailPort > 0 ? dto.emailPort : (int?)null;
                model.EnableSsl = dto.emailEnableSSL;
            }
            else if (!string.IsNullOrEmpty(msg))
            {
                errorMessage = $"Failed to load settings: {msg}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading email settings: {ex.Message}";
        }
    }

    private void TogglePasswordVisibility() => showPassword = !showPassword;

    private async Task SaveChanges()
    {
        successMessage = string.Empty;
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(model.EmailAddress))
        {
            errorMessage = "Email Address is required.";
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            var requestDto = new EmailSettingDto
            {
                branchID = AppState.SelectedBranchID,
                emailAddress = model.EmailAddress,
                emailDisplayName = model.DisplayName,
                emailUsername = model.Username,
                emailPassword = model.Password,
                emailSmtp = model.SmtpServer,
                emailPort = model.Port ?? 0,
                emailEnableSSL = model.EnableSsl
            };

            var (success, msg) = await EmailSettingService.UpdateEmailSettingAsync(requestDto);
            if (success)
            {
                successMessage = "Email settings saved successfully.";
            }
            else
            {
                errorMessage = $"Failed to save settings: {msg}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save settings: {ex.Message}";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}

<style>
    .email-container {
        padding: 30px;
        font-family: var(--font-family, 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif);
        font-size: 0.875rem; /* 14px base */
        padding: clamp(0px, 4vw, 18px) clamp(16px, 4vw, 34px);
    }

    /* --- Header --- */
    .email-header {
        margin-bottom: 24px;
    }

    .email-title {
        font-size: 1.25rem; /* 20px */
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .email-subtitle {
        color: #666;
        font-size: 0.875rem; /* 14px */
    }

    /* --- Card --- */
    .email-card {
        background: white;
        border: 1px solid #e8e8e8;
        border-radius: 14px;
        padding: 28px 30px 24px;
    }

    .card-section-label {
        font-size: 0.875rem; /* 14px */
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 20px;
    }

    /* --- Form layout --- */
    .form-row-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 0.875rem; /* 14px */
        font-weight: 600;
        color: #222;
        margin-bottom: 8px;
    }

    .required {
        color: var(--color-primary);
    }

    /* --- Inputs --- */
    .form-control {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid #d8d8d8;
        border-radius: 9px;
        font-size: 0.875rem; /* 14px */
        font-family: inherit;
        box-sizing: border-box;
        color: #222;
        background: white;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .form-control::placeholder {
            color: #b0b0b0;
            font-size: 0.875rem; /* 14px */
        }

        .form-control:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 12%, transparent);
        }

    /* --- Input with icon --- */
    .input-icon-wrap {
        position: relative;
    }

    .icon-btn {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        color: #999;
        display: flex;
        align-items: center;
        transition: color 0.2s;
    }

        .icon-btn:hover {
            color: var(--color-primary);
        }

    /* --- SSL Toggle --- */
    .ssl-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .email-checkbox {
        appearance: none;
        -webkit-appearance: none;
        width: 17px;
        height: 17px;
        border: 1.5px solid #ccc;
        border-radius: 4px;
        background-color: white;
        cursor: pointer;
        position: relative;
        flex-shrink: 0;
        transition: border-color 0.2s;
    }

        .email-checkbox:checked {
            background-color: var(--color-primary);
            border-color: var(--color-primary);
        }

        .email-checkbox:checked::after {
            content: '';
            position: absolute;
            left: 5px;
            top: 1px;
            width: 5px;
            height: 10px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

    .ssl-label {
        font-size: 0.875rem; /* 14px */
        font-weight: 500;
        color: #444;
        cursor: pointer;
        margin: 0;
        white-space: nowrap;
    }

    /* --- Footer / Save button --- */
    .form-footer {
        margin-top: 28px;
    }

    .btn-save-full {
        width: 100%;
        padding: 14px;
        background-color: var(--color-primary);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 0.875rem; /* 14px */
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: opacity 0.2s;
        letter-spacing: 0.01em;
    }

        .btn-save-full:hover {
            opacity: 0.88;
        }

        .btn-save-full:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

    /* --- Alerts --- */
    .alert-success {
        background: #e8f5e9;
        border: 1px solid #c8e6c9;
        color: #2e7d32;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.75rem; /* 12px */
        margin-bottom: 18px;
    }

    .alert-error {
        background: #fff0f0;
        border: 1px solid #ffcdd2;
        color: #c62828;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.75rem; /* 12px */
        margin-bottom: 18px;
    }

    /* Number input — hide default spinners */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        opacity: 1;
        cursor: pointer;
    }

    /* ======================================== */
    /* RESPONSIVE DESIGN */
    /* ======================================== */

    @@media (max-width: 768px) {
        .email-container {
            padding: 20px;
        }

        .email-title {
            font-size: 1.125rem; /* 18px */
        }

        .email-subtitle {
            font-size: 0.8125rem; /* 13px */
        }

        .email-card {
            padding: 20px;
        }

        .card-section-label {
            font-size: 0.8125rem; /* 13px */
        }

        .form-label {
            font-size: 0.8125rem; /* 13px */
        }

        .form-control {
            font-size: 0.8125rem; /* 13px */
            padding: 10px 12px;
        }

            .form-control::placeholder {
                font-size: 0.8125rem; /* 13px */
            }

        .ssl-label {
            font-size: 0.8125rem; /* 13px */
        }

        .btn-save-full {
            font-size: 0.8125rem; /* 13px */
            padding: 12px;
        }

        .alert-success,
        .alert-error {
            font-size: 0.6875rem; /* 11px */
        }
        /* Make SSL toggle wrap on smaller screens */
        .form-row-header {
            flex-wrap: wrap;
            gap: 10px;
        }
    }

    @@media (max-width: 480px) {
        .email-container {
            padding: 15px;
        }

        .email-title {
            font-size: 1rem; /* 16px */
        }

        .email-subtitle {
            font-size: 0.75rem; /* 12px */
        }

        .email-card {
            padding: 16px;
        }

        .card-section-label {
            font-size: 0.75rem; /* 12px */
            margin-bottom: 16px;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-label {
            font-size: 0.75rem; /* 12px */
            margin-bottom: 6px;
        }

        .form-control {
            font-size: 0.75rem; /* 12px */
            padding: 8px 10px;
        }

            .form-control::placeholder {
                font-size: 0.75rem; /* 12px */
            }

        .ssl-label {
            font-size: 0.75rem; /* 12px */
        }

        .email-checkbox {
            width: 15px;
            height: 15px;
        }

            .email-checkbox:checked::after {
                left: 4px;
                top: 1px;
                width: 4px;
                height: 8px;
            }

        .btn-save-full {
            font-size: 0.75rem; /* 12px */
            padding: 10px;
        }

        .alert-success,
        .alert-error {
            font-size: 0.625rem; /* 10px */
            padding: 8px 12px;
        }

        .icon-btn svg {
            width: 16px;
            height: 16px;
        }
        /* Ensure SSL toggle doesn't overflow */
        .form-row-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }

        .ssl-toggle {
            width: 100%;
            justify-content: flex-start;
        }
    }

    /* Small landscape devices */
    @@media (max-height: 500px) and (orientation: landscape) {
        .email-container {
            padding: 15px;
        }

        .email-card {
            padding: 16px;
        }

        .form-group {
            margin-bottom: 12px;
        }

        .form-footer {
            margin-top: 20px;
        }

        .btn-save-full {
            padding: 10px;
        }
    }
</style>
