@page "/cartpayment"
@using EBI.DM
@using EBI.UC
@using EBI.Enum
@using static SenangRetails.Shared.Pages.Orders
@inherits SenangRetails.Shared.Pages.BasePage

<PageTitle>Cart and Payment</PageTitle>

<div class="app-container">
    <div class="main-content-area">
        <div class="top-bar">
            <button class="back-btn" title="Back" @onclick="GoBack">
                <i class="bi bi-chevron-left"></i>
                <span class="back-btn-back-text">Back</span>
            </button>
            <div class="page-title">
                Cart & Payment
            </div>
        </div>
        <div class="below-top-bar">
            <div class="summary-panel">
                <div class="summary-title-row">
                    <span class="summary-title-text">
                        <i class="bi bi-cart3"></i>
                        Order Summary
                    </span>
                </div>
                <div class="summary-row-list">
                    @foreach (var item in currentOrder?.lstDocumentLine.Where(x => x.SaveAction != EntityState.Deleted) ?? new List<DocumentLineTableDM>())
                    {
                        <div class="summary-row">
                            <div class="summary-item-body">
                                <div class="summary-row-bottom">
                                    <div class="summary-name">@item.Description</div>
                                </div>
                                <div class="summary-row-bottom">
                                    <div class="summary-item-type">@(GetItemTypeName((int)item.InventoryTypeID))</div>
                                </div>
                                <div class="summary-staff-row">
                                    @if (item.lstSalesCommissionByDocumentLine != null && item.lstSalesCommissionByDocumentLine.Any())
                                    {
                                        @foreach (var comm in item.lstSalesCommissionByDocumentLine)
                                        {
                                            <span class="summary-staff">
                                                Staff: @comm.EmployeeCode
                                            </span>
                                        }
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(item.TaxCodeID) || item.TaxAmount > 0)
                                {
                                    <div class="summary-discount-line" style="color: var(--text-primary)">
                                        @if (!string.IsNullOrEmpty(item.TaxCodeID))
                                        {
                                            <span style="flex: 1;">@item.TaxCodeID</span>
                                        }
                                        @if (item.TaxAmount > 0)
                                        {
                                            <span>RM @item.TaxAmount.ToString("F2")</span>
                                        }
                                    </div>
                                }
                                 @if (item.Discount > 0)
                                {
                                    <div class="summary-discount-line" style="color: #777; margin-bottom: 2px;">
                                        <span style="flex: 1;">Original Price</span>
                                        <span style="text-decoration: line-through;">RM @((item.UnitPrice * item.Quantity).ToString("F2"))</span>
                                    </div>
                                    <div class="summary-discount-line" style="color: #16A34A; font-weight: 600;">
                                        <span style="flex: 1;"><i class="fa-solid fa-tag"></i> @(!string.IsNullOrEmpty(item.Memo) ? item.Memo : "Discount") &nbsp;</span>
                                        <span>- RM @item.Discount.ToString("F2")</span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(item.RefCompanyName) || !string.IsNullOrEmpty(item.Memo))
                                {
                                    <div class="summary-row-bottom">
                                        <span class="summary-item-type">Remarks: @(!string.IsNullOrEmpty(item.RefCompanyName) ? item.RefCompanyName : item.Memo)</span>
                                    </div>
                                }
                                <div class="summary-row-bottom" @onclick:stopPropagation>
                                    <span class="summary-price">RM @item.UnitPrice.ToString("N0") &times; @item.Quantity.ToString("G29")</span>
                                    <span class="summary-price">RM @((Math.Max(0, item.UnitPrice * item.Quantity - item.Discount)).ToString("F2"))</span>
                                </div>

                                
                            </div>
                        </div>
                    }
                </div>
                <div class="summary-footer">
                    <div class="quantity-line">
                        <span>@LangSvc.GetText("OrdersQuantity")</span>
                        <span>@(currentOrder?.lstDocumentLine.Where(x => x.SaveAction != EntityState.Deleted).Sum(i => i.Quantity) ?? 0)</span>
                    </div>
                    @if (!isRedemptionMode)
                    {
                        @if ((currentOrder?.lstDocumentLine.Where(x => x.SaveAction != EntityState.Deleted).Sum(i => i.Discount) ?? 0) > 0)
                        {
                            <div class="subtotal-line">
                                <span>Subtotal (Before Discount)</span>
                                <span>RM @((currentOrder?.lstDocumentLine.Where(x => x.SaveAction != EntityState.Deleted).Sum(i => i.UnitPrice * i.Quantity) ?? 0m).ToString("F2"))</span>
                            </div>
                            <div class="subtotal-line" style="color: #16A34A; font-weight: 600;">
                                <span>Promotion Discount</span>
                                <span>- RM @((currentOrder?.lstDocumentLine.Where(x => x.SaveAction != EntityState.Deleted).Sum(i => i.Discount) ?? 0m).ToString("F2"))</span>
                            </div>
                        }
                        <div class="subtotal-line">
                            <span>@LangSvc.GetText("OrdersSubtotalBeforeTax")</span>
                            <span>RM @((currentOrder?.objDoc_CashSales?.TotalBeforeTax ?? 0m).ToString("F2"))</span>
                        </div>
                        @if ((currentOrder?.objDoc_CashSales?.TaxAmount ?? 0m) > 0)
                        {
                            <div class="subtotal-line">
                                <span>Tax Amount</span>
                                <span>RM @((currentOrder?.objDoc_CashSales?.TaxAmount ?? 0m).ToString("F2"))</span>
                            </div>
                        }
                        <div class="subtotal-line">
                            <span>@LangSvc.GetText("OrdersRoundingAdj")</span>
                            <span>@GetRoundingDisplay(currentOrder)</span>
                        </div>
                        <div class="subtotal-line grand-total-line">
                            <span>@LangSvc.GetText("OrdersGrandTotal")</span>
                            <span>RM @((currentOrder?.objDoc_CashSales?.TotalAfterTax ?? 0m).ToString("F2"))</span>
                        </div>
                    }
                    else
                    {
                        <div class="subtotal-line">
                            <span>Subtotal (Before Tax)</span>
                            <span>RM @((currentOrder?.objDoc_CashSales?.TotalBeforeTax ?? 0m).ToString("F2"))</span>
                        </div>
                        <div class="subtotal-line grand-total-line">
                            <span>Grand Total</span>
                            <span>RM @((currentOrder?.objDoc_CashSales?.TotalAfterTax ?? 0m).ToString("F2"))</span>
                        </div>
                    }
                </div>
            </div>
            <div class="payment-panel">
                @if (!isRedemptionMode)
                {
                    <div class="payment-method-section">
                        <div class="summary-title-row">
                            <span class="summary-title-text">Payment Method</span>
                        </div>
                        <div class="payment-method-list">
                            @foreach (var method in availableMethods)
                            {
                                bool isSelected = appliedPayments.Any(p => p.PaymentTypeId == method.POSPaymentTypeID);
                                <button class="method-card @(isSelected ? "selected-method" : "")"
                                        @onclick="() => TogglePaymentMethod(method)">
                                    <span class="method-name">@method.POSPaymentTypeName</span>
                                    <i class="bi bi-check-lg method-check"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="amount-received-section">
                        <div class="summary-title-row">
                            <span class="summary-title-text">Amount Received</span>
                        </div>
                        <div class="payment-method-list">
                            @foreach (var pay in appliedPayments)
                            {
                                bool isCash = pay.PaymentName.Equals("Cash", StringComparison.OrdinalIgnoreCase);
                                bool isLineInvalid = !isCash && currentOrder?.objDoc_CashSales != null && pay.Amount > currentOrder.objDoc_CashSales.TotalAfterTax;
                                <div class="payment-label-wrap">
                                    <div class="payment-input-row @(isLineInvalid || string.IsNullOrWhiteSpace(pay.InputAmount) ? "input-invalid" : "")">
                                        <span class="payment-label">@pay.PaymentName</span>
                                        <div class="input-group-wrapper">
                                            <span class="currency-prefix">RM</span>
                                            <input type="number" step="0.01" class="amount-received-input"
                                                   @bind="pay.InputAmount" @bind:event="oninput" />
                                        </div>
                                        <button class="line-delete-btn" @onclick="() => RemovePaymentLine(pay)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    @if (isCash)
                                    {
                                        <div class="quick-cash-row">
                                            <button type="button" class="quick-cash-btn exact-btn" @onclick="() => ApplyQuickCash(pay, currentOrder?.objDoc_CashSales?.TotalAfterTax ?? 0m)">
                                                Exact (RM @((currentOrder?.objDoc_CashSales?.TotalAfterTax ?? 0m).ToString("F2")))
                                            </button>
                                            @foreach (var denom in GetQuickCashDenominations(currentOrder?.objDoc_CashSales?.TotalAfterTax ?? 0m))
                                            {
                                                <button type="button" class="quick-cash-btn" @onclick="() => ApplyQuickCash(pay, denom)">
                                                    RM @denom.ToString("N0")
                                                </button>
                                            }
                                        </div>
                                    }
                                    @if (isLineInvalid)
                                    {
                                        <span class="line-error-msg">Cannot exceed Grand Total</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="payment-method-section">
                        <div class="summary-title-row">
                            <span class="summary-title-text">NA (FOR FUTURE)</span>
                        </div>
                        <div class="payment-method-list">
                            <button class="method-card"><span class="method-name"><i class="bi bi-currency-dollar" style="margin-right: 8px;"></i>NA</span></button>
                            <button class="method-card"><span class="method-name"><i class="bi bi-credit-card" style="margin-right: 8px;"></i>NA</span></button>
                            <button class="method-card"><span class="method-name"><i class="bi bi-wallet2" style="margin-right: 8px;"></i>NA</span></button>
                        </div>
                    </div>

                    <div class="amount-received-section">
                        <div class="summary-title-row mb-3">
                            <span class="summary-title-text">Series Redemption</span>
                        </div>
                        <div class="payment-method-list">
                            <div class="payment-input-row">
                                <span class="payment-label">Bill Amount</span>
                                <div class="input-group-wrapper">RM @((currentOrder?.objDoc_CashSales?.TotalAfterTax ?? 0m).ToString("F2"))</div>
                            </div>
                            <div class="payment-input-row">
                                <span class="payment-label">Payment</span>
                                <div class="input-group-wrapper">RM @((currentOrder?.objDoc_CashSales?.TotalAfterTax ?? 0m).ToString("F2"))</div>
                            </div>
                        </div>
                    </div>
                }

                <div class="payment-panel-footer">
                    @if (!isRedemptionMode)
                    {
                        <div class="balance-row @(IsChangeDue() ? "change-due-highlight" : "")">
                            <span>@(IsChangeDue() ? "Change Due" : "Balance Due"): </span>
                            <span class="balance-val">
                                RM @((IsChangeDue() ? GetChangeAmount() : GetRemainingBalance()).ToString("F2"))
                            </span>
                        </div>
                    }
                    <button class="payment-btn"
                            disabled="@(!isRedemptionMode && GetRemainingBalance() > 0 ||
                                                                    (!appliedPayments.Any(p => p.PaymentName.Equals("Cash", StringComparison.OrdinalIgnoreCase)) && IsChangeDue()) ||
                                                                    appliedPayments.Any(p => !p.PaymentName.Equals("Cash", StringComparison.OrdinalIgnoreCase) && currentOrder?.objDoc_CashSales != null && p.Amount > currentOrder.objDoc_CashSales.TotalAfterTax) ||
                                                                    isProcessing)"
                            @onclick="HandleCompletePayment">
                        Complete Payment
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CHANGE DUE MODAL -->
@if (showChangeModal)
{
    <div class="modal-overlay">
        <div class="change-modal-card" @onclick:stopPropagation>
            <div class="change-modal-header">
                <i class="bi bi-check-circle-fill" style="font-size: 3rem; color: #16A34A;"></i>
                <h2 style="margin: 0.5rem 0 0 0; color: #1E293B;">Payment Successful!</h2>
            </div>
            <div class="change-modal-body">
                <span class="change-subtitle">Change Due to Customer</span>
                <div class="change-due-box">
                    <span class="change-currency">RM</span>
                    <span class="change-amount-display">@changeDueAmount.ToString("F2")</span>
                </div>
                <div class="change-details-grid">
                    <div class="change-detail-item">
                        <span class="cd-label">Total Bill</span>
                        <span class="cd-val">RM @totalBillAmount.ToString("F2")</span>
                    </div>
                    <div class="change-detail-item">
                        <span class="cd-label">Amount Tendered</span>
                        <span class="cd-val">RM @totalTenderedAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>
            <div class="change-modal-footer">
                <button type="button" class="btn-new-sale" @onclick="CloseChangeModalAndFinish">
                    <i class="fa-solid fa-plus"></i> Next Customer / New Sale
                </button>
            </div>
        </div>
    </div>
}

@if (showAlertDialogModal)
{
    <div class="modal-overlay" @onclick="() => showAlertDialogModal = false">
        <div class="modal-content" @onclick:stopPropagation style="max-width: 400px; height: auto;">
            <h4 style="margin: 0 0 1rem 0;">@alertDialogTitle</h4>
            <p style="color: var(--text-primary); margin-bottom: 2rem; font-size: 18px; line-height: 1.5;">
                @((MarkupString)alertDialogMessage)
            </p>

            <div class="modal-footer">
                <button class="orders-btn-primary" style="flex: 1;" @onclick="() => showAlertDialogModal = false">
                    OK
                </button>
            </div>
        </div>
    </div>
}