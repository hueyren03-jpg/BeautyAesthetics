@page "/EInvoices"
@inherits SenangRetails.Shared.Pages.BasePage
@inject NavigationManager Navigation

<div class="einvoice-page">
    <div class="top-bar">
        <div class="top-bar-content">
            <button class="back-button" @onclick="GoBack">
                <i class="bi bi-chevron-left"></i>
                <span>Back</span>
            </button>
            <h2>E-Invoice</h2>
        </div>
    </div>

    <!-- Top Date Range Picker -->
    <div class="top-date-range-wrapper">
        <div class="top-date-range">
            <span>Start Date</span>
            <MobileDatePicker @bind-Value="SummaryDateFrom"
                              DateFormat="dd/MM/yyyy"
                              Placeholder="Select Date" />
            <span class="dash">-</span>
            <span>End Date</span>
            <MobileDatePicker @bind-Value="SummaryDateTo"
                              DateFormat="dd/MM/yyyy"
                              Placeholder="Select Date" />
            <button class="refresh-btn" @onclick="LoadSummaryData">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- Status Cards -->
    <div class="status-cards">
        <div class="status-card pending">
            <div class="card-icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="card-content">
                <div class="status-label">Pending</div>
                <div class="count">@PendingBill</div>
                <div class="amount">RM @PendingAmount.ToString("N2")</div>
            </div>
        </div>

        <div class="status-card valid-ind" style="cursor: pointer;" @onclick="() => OpenValidIndModal()">
            <div class="card-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="card-content">
                <div class="status-label">Valid (Ind)</div>
                <div class="count">@ValidIndividualBill</div>
                <div class="amount">RM @ValidIndividualAmount.ToString("N2")</div>
            </div>
        </div>

        <div class="status-card valid-conso" style="cursor: pointer;" @onclick="() => OpenValidConsoModal()">
            <div class="card-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="card-content">
                <div class="status-label">Valid (Conso)</div>
                <div class="count">@ValidConsoBill</div>
                <div class="amount">RM @ValidConsoAmount.ToString("N2")</div>
            </div>
        </div>

        <div class="status-card invalid">
            <div class="card-icon">
                <i class="bi bi-x-circle-fill"></i>
            </div>
            <div class="card-content">
                <div class="status-label">Invalid</div>
                <div class="count">@InvalidBill</div>
                <div class="amount">RM @InvalidAmount.ToString("N2")</div>
            </div>
        </div>

        <div class="status-card cancelled">
            <div class="card-icon">
                <i class="bi bi-ban-fill"></i>
            </div>
            <div class="card-content">
                <div class="status-label">Cancelled</div>
                <div class="count">@CancelledBill</div>
                <div class="amount">RM @CancelledAmount.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Consolidated E-Invoice Submission -->
    <div class="consolidated-section">
        <h3>Consolidated E-Invoice Submission</h3>

        <div class="submission-row">
            <div class="submission-dates">
                <div class="date-group">
                    <label>Start Date</label>
                    <MobileDatePicker @bind-Value="SubmissionDateFrom"
                                      DateFormat="dd/MM/yyyy"
                                      Placeholder="Select Date" />
                </div>
                <div class="date-group">
                    <label>End Date</label>
                    <MobileDatePicker @bind-Value="SubmissionDateTo"
                                      DateFormat="dd/MM/yyyy"
                                      Placeholder="Select Date" />
                </div>
            </div>

            @if (SubmissionDateFrom.HasValue && SubmissionDateTo.HasValue)
            {
                <div class="selected-period-wrapper">
                    <div class="selected-period">
                        Selected Period: @((SubmissionDateTo.Value - SubmissionDateFrom.Value).Days + 1) days
                    </div>
                </div>
            }
        </div>

        <button class="submit-btn"
                disabled="@(!CanSubmitConsolidated)"
                @onclick="SubmitConsolidated">
            Submit Consolidated E-Invoice
        </button>
    </div>

    <!-- Loading Modal -->
    @if (ShowLoadingModal)
    {
        <div class="modal-overlay">
            <div class="modal-container loading-modal">
                <div class="modal-body-loading">
                    <div class="loading-spinner"></div>
                    <div class="loading-text">Submitting Consolidated E-Invoice...</div>
                    <div class="loading-subtext">Please wait while we process your request</div>
                </div>
            </div>
        </div>
    }

    <!-- Success/Error/Info Modal -->
    @if (ShowModal)
    {
        <div class="modal-overlay">
            <div class="modal-container @(ModalType)">
                <div class="modal-header-einvoice">
                    <h3>
                        @if (ModalType == "success")
                        {
                            <span>@LangSvc.GetText("EInvoicesModalSuccessTitle")</span>
                        }
                        else if (ModalType == "no-records")
                        {
                            <span>@LangSvc.GetText("EInvoicesModalInfoTitle")</span>
                        }
                        else
                        {
                            <span>@LangSvc.GetText("EInvoicesModalErrorTitle")</span>
                        }
                    </h3>
                    <button class="modal-close" @onclick="CloseModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    @if (ModalType == "success" && SubmissionResult != null)
                    {
                        <div class="success-content">
                            <div class="status-badge success">
                                <i class="bi bi-check-circle-fill"></i>
                                @SubmissionResult.DocumentStatus
                            </div>

                            <div class="uuid-container">
                                <div class="uuid-label">
                                    <i class="bi bi-upc-scan"></i>
                                    UUID
                                </div>
                                <div class="uuid-value">@SubmissionResult.UUID</div>
                            </div>

                            @if (SubmissionResult.lstConsolidatedInvoice != null && SubmissionResult.lstConsolidatedInvoice.Any())
                            {
                                <div class="invoices-table-container">
                                    <h4>@LangSvc.GetText("EInvoicesConsolidatedDetails")</h4>
                                    <table class="invoices-table">
                                        <thead>
                                            <tr>
                                                <th>@LangSvc.GetText("EInvoicesBillNo")</th>
                                                <th class="text-right">@LangSvc.GetText("EInvoicesAmountRM")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var invoice in SubmissionResult.lstConsolidatedInvoice)
                                            {
                                                <tr>
                                                    <td>@invoice.DisplayCode</td>
                                                    <td class="text-right">@invoice.TotalAfterTax.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                    else if (ModalType == "no-records")
                    {
                        <div class="no-records-content">
                            <div class="modal-icon">
                                <i class="bi bi-inbox"></i>
                            </div>
                            <div class="modal-message">@LangSvc.GetText("EInvoicesNoPending")</div>
                            <div class="modal-submessage">@LangSvc.GetText("EInvoicesChooseDifferentDates")</div>
                        </div>
                    }
                    else if (ModalType == "error")
                    {
                        <div class="error-content">
                            <div class="modal-icon">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            </div>
                            <div class="modal-message">@ModalTitle</div>
                            @if (!string.IsNullOrEmpty(ModalMessage))
                            {
                                <div class="modal-submessage">@ModalMessage</div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="modal-btn" @onclick="CloseModal">
                        @LangSvc.GetText("EInvoicesClose")
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Confirmation Modal -->
    @if (ShowConfirmModal)
    {
        <div class="modal-overlay">
            <div class="modal-container confirmation-modal">
                <div class="modal-header-confirmation">
                    <h3>Confirm Submission</h3>
                    <button class="modal-close" @onclick="CloseConfirmModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <div class="modal-body-confirmation">
                    <div class="confirm-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <p class="confirm-question">Submit Consolidated e-Invoice?</p>

                    <div class="info-box">
                        <table class="info-table">
                            <tr>
                                <td class="info-label">Branch:</td>
                            </tr>
                            <tr>
                                <td class="info-value">@(string.IsNullOrEmpty(AppState.SelectedBranchID) ? "HQ" : AppState.SelectedBranchID)</td>
                            </tr>
                            <tr>
                                <td class="info-label">Period:</td>
                            </tr>
                            <tr>
                                <td class="info-value">@ConfirmFromDate - @ConfirmToDate</td>
                            </tr>
                        </table>
                    </div>

                    <div class="warning-box">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>Ensure period complies with LHDN rules (e.g. within 7 days after month-end for monthly consolidation).</span>
                    </div>
                </div>

                <div class="modal-footer-confirmation">
                    <button class="btn-cancel" @onclick="CloseConfirmModal">Cancel</button>
                    <button class="btn-confirm" @onclick="ConfirmAndSubmit">Confirm</button>
                </div>
            </div>
        </div>
    }

    <!-- Validated E-Invoice Modal -->
    @if (ShowValidIndModal)
    {
        <div class="modal-overlay" @onclick="CloseValidIndModal">
            <div class="modal-container validated-modal" @onclick:stopPropagation="true">

                <!-- Header -->
                <div class="modal-header-validated">
                    <h2>Validated E-Invoice</h2>
                    <span class="valid-ind-pill">Valid (Ind)</span>
                    <button class="modal-close" @onclick="CloseValidIndModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- Loading Indicator -->
                @if (IsLoadingValidInd)
                {
                    <div class="loading-container">
                        <div class="loading-spinner-small"></div>
                        <span>Loading invoices...</span>
                    </div>
                }

                <!-- Search Bar -->
                <div class="modal-search-bar">
                    <div class="search-wrapper">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               placeholder="Search by Invoice ID or Customer Name..."
                               @bind="SearchTerm"
                               @bind:event="oninput"
                               class="search-input" />
                    </div>
                </div>

                <!-- Table -->
                <div class="table-container">
                    <table class="validated-table">
                        <thead>
                            <tr>
                                <th>Invoice No</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th class="text-right">Amount</th>
                                <th class="text-center action-header">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredInvoices.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center no-data">
                                        @(IsLoadingValidInd ? "Loading..." : "No validated individual e-invoices found")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var inv in FilteredInvoices)
                                {
                                    <tr>
                                        <td>@inv.DisplayCode</td>
                                        <td>@(string.IsNullOrWhiteSpace(inv.AccountName) ? "Cash Customer" : inv.AccountName)</td>
                                        <td>@inv.FinancialDate.ToString("MM/dd/yyyy")</td>
                                        <td class="text-right">RM @inv.TotalAfterTax.ToString("N2")</td>
                                        <td class="text-center action-col">
                                            @if (IsDownloading && DownloadingId == inv.DocumentID)
                                            {
                                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <i class="bi bi-download action-icon download-icon"
                                                   title="Download"
                                                   @onclick="() => DownloadInvoice(inv)"></i>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer -->
                <div class="modal-footer-validated">
                    <button class="close-btn" @onclick="CloseValidIndModal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Validated Consolidated E-Invoice Modal -->
    @if (ShowValidConsoModal)
    {
        <div class="modal-overlay" @onclick="CloseValidConsoModal">
            <div class="modal-container validated-modal" @onclick:stopPropagation="true">

                <!-- Header -->
                <div class="modal-header-validated">
                    <h2>Validated E-Invoice</h2>
                    <span class="valid-conso-pill">Valid (Conso)</span>
                    <button class="modal-close" @onclick="CloseValidConsoModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- Loading Indicator -->
                @if (IsLoadingValidConso)
                {
                    <div class="loading-container">
                        <div class="loading-spinner-small"></div>
                        <span>Loading invoices...</span>
                    </div>
                }

                <!-- Search Bar -->
                <div class="modal-search-bar">
                    <div class="search-wrapper">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               placeholder="Search by Invoice ID or Customer Name..."
                               @bind="ConsoSearchTerm"
                               @bind:event="oninput"
                               class="search-input" />
                    </div>
                </div>

                <!-- Table -->
                <div class="table-container">
                    <table class="validated-table">
                        <thead>
                            <tr>
                                <th>Invoice No</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th class="text-right">Amount</th>
                                <th class="text-center action-header">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredConsoInvoices.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center no-data">
                                        @(IsLoadingValidConso ? "Loading..." : "No validated consolidated e-invoices found")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var inv in FilteredConsoInvoices)
                                {
                                    <tr>
                                        <td>@inv.DisplayCode</td>
                                        <td>@(string.IsNullOrWhiteSpace(inv.AccountName) ? "Cash Customer" : inv.AccountName)</td>
                                        <td>@inv.FinancialDate.ToString("MM/dd/yyyy")</td>
                                        <td class="text-right">RM @inv.TotalAfterTax.ToString("N2")</td>
                                        <td class="text-center action-col">
                                            @if (IsDownloading && DownloadingId == inv.DocumentID)
                                            {
                                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <i class="bi bi-download action-icon download-icon"
                                                   title="Download"
                                                   @onclick="() => DownloadInvoice(inv)"></i>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer -->
                <div class="modal-footer-validated">
                    <button class="close-btn" @onclick="CloseValidConsoModal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    }
</div>