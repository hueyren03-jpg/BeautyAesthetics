@namespace SenangRetails.Shared.Pages
@inherits SenangRetails.Shared.Pages.BasePage
@using BlazorBootstrap
@using SenangRetails.Shared.Services
@using SenangRetails.Shared.Services.DashboardService
@using System.Text

<div class="last-visit-report-container">
    <div class="last-visit-report-list-container">
        <!-- Date Filter Section - Match Member List Report Style -->
        <div class="report-date-filter">
            <div class="date-filter-controls">
                <!-- Quick Date Range Buttons -->
                <div class="quick-date-buttons">
                    <button class="quick-date-btn @(selectedVisitRange == "LessThan1Month" ? "active" : "")" @onclick='() => SelectVisitRange("LessThan1Month")'>
                        @LangSvc.GetText("Today")
                    </button>
                    <button class="quick-date-btn @(selectedVisitRange == "Between1-2Months" ? "active" : "")" @onclick='() => SelectVisitRange("Between1-2Months")'>
                        @LangSvc.GetText("This Week")
                    </button>
                    <button class="quick-date-btn @(selectedVisitRange == "Between2-6Months" ? "active" : "")" @onclick='() => SelectVisitRange("Between2-6Months")'>
                        @LangSvc.GetText("This Month")
                    </button>
                    <button class="quick-date-btn @(selectedVisitRange == "Between6-12Months" ? "active" : "")" @onclick='() => SelectVisitRange("Between6-12Months")'>
                        @LangSvc.GetText("This Year")
                    </button>
                </div>

                <!-- Custom Range Inputs - Only show when Custom mode is selected -->
                @if (selectedVisitRange == "Custom")
                {
                    <div class="date-picker-group">
                        <div class="date-picker-item">
                            <label class="date-picker-label">@LangSvc.GetText("From Days")</label>
                            <input type="number" @bind="customFromDays" @bind:event="oninput" class="date-input" min="0" placeholder="0" />
                        </div>
                        <div class="date-picker-item">
                            <label class="date-picker-label">@LangSvc.GetText("To Days")</label>
                            <input type="number" @bind="customToDays" @bind:event="oninput" class="date-input" min="0" placeholder="30" />
                        </div>
                        <button class="refresh-btn" @onclick="RefreshData" title="Refresh">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                }
                else
                {
                    <!-- Show only refresh button when in preset mode -->
                    <div class="date-picker-group">
                        <button class="refresh-btn" @onclick="RefreshData" title="Refresh">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                }

                <!-- Export Dropdown Button -->
                <div class="export-dropdown">
                    <button class="export-btn" @onclick="ToggleExportDropdown" @onclick:preventDefault="true">
                        <i class="bi bi-download"></i>
                        <span class="action-btn-text">@LangSvc.GetText("Export")</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    @if (showExportDropdown)
                    {
                        <div class="export-dropdown-menu">
                            <button class="export-dropdown-item" @onclick="ExportToCSV">
                                <i class="bi bi-file-spreadsheet"></i>
                                @LangSvc.GetText("Export CSV")
                            </button>
                            <button class="export-dropdown-item" @onclick="ExportToPDF">
                                <i class="bi bi-file-pdf"></i>
                                @LangSvc.GetText("Export PDF")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Visit Range Tabs - Styled like Gender Tabs -->
        <div class="report-type-tabs">
            <button class="type-tab @(selectedVisitRange == "LessThan1Month" ? "active" : "")" @onclick='() => SelectVisitRange("LessThan1Month")'>
                <i class="bi bi-calendar-day"></i>
                &lt; 1 Month
            </button>
            <button class="type-tab @(selectedVisitRange == "Between1-2Months" ? "active" : "")" @onclick='() => SelectVisitRange("Between1-2Months")'>
                <i class="bi bi-calendar-week"></i>
                1 - 2 Months
            </button>
            <button class="type-tab @(selectedVisitRange == "Between2-6Months" ? "active" : "")" @onclick='() => SelectVisitRange("Between2-6Months")'>
                <i class="bi bi-calendar-month"></i>
                2 - 6 Months
            </button>
            <button class="type-tab @(selectedVisitRange == "Between6-12Months" ? "active" : "")" @onclick='() => SelectVisitRange("Between6-12Months")'>
                <i class="bi bi-calendar-month"></i>
                6 - 12 Months
            </button>
            <button class="type-tab @(selectedVisitRange == "MoreThan1Year" ? "active" : "")" @onclick='() => SelectVisitRange("MoreThan1Year")'>
                <i class="bi bi-calendar-year"></i>
                &gt; 1 Year
            </button>
            <button class="type-tab @(selectedVisitRange == "Custom" ? "active" : "")" @onclick='() => SelectVisitRange("Custom")'>
                <i class="bi bi-sliders"></i>
                Custom
            </button>
        </div>

        <!-- KPI Summary Cards - Match Member List Report Style -->
        <div class="kpi-cards">
            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-calendar-day"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@lessThanOneMonthCount.ToString("N0")</div>
                    }
                    <div class="kpi-label">&lt; 1 Month</div>
                    <div class="kpi-subvalue">RM @lessThanOneMonthTotal.ToString("N2")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-calendar-week"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@oneToTwoMonthsCount.ToString("N0")</div>
                    }
                    <div class="kpi-label">1 - 2 Months</div>
                    <div class="kpi-subvalue">RM @oneToTwoMonthsTotal.ToString("N2")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-calendar-month"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@twoToSixMonthsCount.ToString("N0")</div>
                    }
                    <div class="kpi-label">2 - 6 Months</div>
                    <div class="kpi-subvalue">RM @twoToSixMonthsTotal.ToString("N2")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-calendar-month"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@sixToTwelveMonthsCount.ToString("N0")</div>
                    }
                    <div class="kpi-label">6 - 12 Months</div>
                    <div class="kpi-subvalue">RM @sixToTwelveMonthsTotal.ToString("N2")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-calendar-year"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@moreThanOneYearCount.ToString("N0")</div>
                    }
                    <div class="kpi-label">&gt; 1 Year</div>
                    <div class="kpi-subvalue">RM @moreThanOneYearTotal.ToString("N2")</div>
                </div>
            </div>
        </div>

        <!-- Pagination Controls - Same as MemberListReport -->
        <div class="pagination-controls">
            <div class="page-size-selector">
                <label>@LangSvc.GetText("Show Records")</label>
                <select class="page-size-select" value="@pageSize" @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="page-navigation">
                <button class="page-btn" @onclick="GoToFirstPage" disabled="@(currentPage == 1)">
                    <i class="bi bi-chevron-double-left"></i>
                </button>
                <button class="page-btn" @onclick="GoToPreviousPage" disabled="@(currentPage == 1)">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span class="page-info">Page @currentPage of @totalPages</span>
                <button class="page-btn" @onclick="GoToNextPage" disabled="@(!hasMoreData)">
                    <i class="bi bi-chevron-right"></i>
                </button>
                <button class="page-btn" @onclick="GoToLastPage" disabled="@(currentPage == totalPages || totalPages == 0)">
                    <i class="bi bi-chevron-double-right"></i>
                </button>
            </div>
            <div class="total-records-info">
                <span>@LangSvc.GetText("Showing") @displayData.Count @LangSvc.GetText("of") @totalFilteredCount @LangSvc.GetText("records")</span>
            </div>
        </div>

        <!-- Last Visit Report Table with Filter Inputs -->
        <div class="member-list-table-wrapper">
            <div class="member-list-table">
                <div class="member-list-table-header">
                    <div class="member-list-table-header-cell filter-header">
                        <span>@LangSvc.GetText("ReportLastVisit")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="lastVisitFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="member-list-table-header-cell filter-header">
                        <span>@LangSvc.GetText("ReportMemberLabel2")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="memberFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="member-list-table-header-cell filter-header">
                        <span>@LangSvc.GetText("ReportLastPurchase")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="amountFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                </div>
                <div class="filter-badge-container">
                    @if (HasActiveFilters())
                    {
                        <button class="clear-filters-btn" @onclick="ClearFilters">
                            <i class="bi bi-x-circle"></i> Clear All Filters
                        </button>
                    }
                </div>
                <div class="member-list-table-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
                            <p>Loading data...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(exportMessage))
                    {
                        <div class="alert alert-@alertType">@exportMessage</div>
                    }
                    else if (displayData.Any())
                    {
                        @foreach (var item in displayData)
                        {
                            <div class="member-list-table-row">
                                <div class="member-list-table-cell" data-label="@LangSvc.GetText("ReportLastVisit")">
                                    <div class="last-visit-info">
                                        <div class="last-visit-days">@GetDaysAgoText(item.TotalDaysAgo)</div>
                                        <div class="last-visit-date">@item.LastVisitDate.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </div>
                                <div class="member-list-table-cell" data-label="@LangSvc.GetText("ReportMemberLabel2")">
                                    <div class="member-info-cell">
                                        <div class="member-icon">
                                            <i class="bi bi-person-circle"></i>
                                        </div>
                                        <div class="member-details">
                                            <div class="member-name">@item.CustomerName</div>
                                            <div class="member-id">@item.AccountID / @(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="member-list-table-cell" data-label="@LangSvc.GetText("ReportLastPurchase")">
                                    <div class="amount-value">RM @item.LastSpend.ToString("N2")</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>
    </div>
    @if (showAlertDialogModal)
    {
        <div class="modal-overlay" @onclick="CloseAlertDialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="appointment-modal-header">
                    <div class="appt-title">@alertDialogTitle</div>
                </div>
                <div class="modal-body">
                    <p>@alertDialogMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="appt-btn-primary" style="flex: 1;" @onclick="CloseAlertDialog">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }
</div>