@page "/whatsappnotifiaction"
@inherits SenangRetails.Shared.Pages.BasePage

@inject HttpClient Http
@using System.Text.Json
@using System.Net.Http.Json

<div class="whatsapp-page-wrapper">
    <!-- Page Header - Matching Appointment Setup -->
    <div class="whatsapp-page-header">
        <h2 class="whatsapp-title">@LangSvc.GetText("WhatsAppSettingsTitle")</h2>
        <p class="whatsapp-subtitle">Notify customers instantly via WhatsApp</p>
    </div>

    <!-- Container Card - Matching Appointment Setup -->
    <div class="whatsapp-container">
        @if (string.IsNullOrEmpty(selectedCategory))
        {
            <div class="whatsapp-content">
                <div class="category-label-row category-main-label">@LangSvc.GetText("WhatsAppCategory")</div>
                <button class="category-item-btn" @onclick='() => SelectCategory(LangSvc.GetText("WhatsAppCategoryAppointment"))'>
                    <div class="btn-left">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>@LangSvc.GetText("WhatsAppCategoryAppointment")</span>
                    </div>
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        }
        else
        {
            <div class="whatsapp-header">
                <button class="back-btn" @onclick="GoBack">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <h2 class="whatsapp-title">@selectedCategory</h2>
            </div>

            <div class="whatsapp-content">
                <div class="category-label-row">@LangSvc.GetText("WhatsAppNotifTypes")</div>
                <div class="notification-list">
                    <div class="notification-text-row">
                        <span>@LangSvc.GetText("WhatsAppApptConfirm")</span>
                        <button class="chevron-only-btn" @onclick='() => OpenModal(LangSvc.GetText("WhatsAppApptConfirm"))'>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                    <div class="notification-text-row">
                        <span>@LangSvc.GetText("Appointment - Update")</span>
                        <button class="chevron-only-btn" @onclick='() => OpenModal(LangSvc.GetText("Appointment - Update"))'>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                    <div class="notification-text-row">
                        <span>@LangSvc.GetText("WhatsAppApptCancel")</span>
                        <button class="chevron-only-btn" @onclick='() => OpenModal(LangSvc.GetText("WhatsAppApptCancel"))'>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                    <div class="notification-text-row">
                        <span>@LangSvc.GetText("WhatsAppApptReminder")</span>
                        <button class="chevron-only-btn" @onclick='() => OpenModal(LangSvc.GetText("WhatsAppApptReminder"))'>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (isModalVisible)
{
    <div class="modal-overlay">
        <div class="modal-container-large">
            <div class="modal-header">
                <h3 class="modal-title-text">@currentNotificationTitle</h3>
            </div>

            <div class="modal-body-content">

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert-error">@errorMessage</div>
                }

                <div class="enable-banner">
                    <span class="enable-text">@LangSvc.GetText("WhatsAppEnable")</span>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="isNotificationEnabled" />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="template-selection-grid">
                    <div class="template-option-card @(selectedTemplate == 1 ? "is-selected" : "")" @onclick="() => SelectTemplate(1)">
                        <div class="card-status-bar">
                            <span class="tpl-tag">@LangSvc.GetText("WhatsAppTemplate1")</span>
                            <div class="indicator-dot @(selectedTemplate == 1 ? "is-active" : "")"></div>
                        </div>
                        <div class="preview-footer-text">
                            @if (isLoadingTemplates)
                            {
                                <p class="whatsapp-message-text" style="color: #999;">Loading template...</p>
                            }
                            else
                            {
                                <p class="whatsapp-message-text">@GetFormattedTemplateText(1)</p>
                            }
                        </div>
                    </div>

                    <div class="template-option-card @(selectedTemplate == 2 ? "is-selected" : "")" @onclick="() => SelectTemplate(2)">
                        <div class="card-status-bar">
                            <span class="tpl-tag">@LangSvc.GetText("WhatsAppTemplate2")</span>
                            <div class="indicator-dot @(selectedTemplate == 2 ? "is-active" : "")"></div>
                        </div>
                        <div class="preview-footer-text">
                            @if (isLoadingTemplates)
                            {
                                <p class="whatsapp-message-text" style="color: #999;">Loading template...</p>
                            }
                            else
                            {
                                <p class="whatsapp-message-text">@GetFormattedTemplateText(2)</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Action Buttons - Matching Appointment Setup -->
                <div class="modal-action-row">
                    <button class="btn-cancel" @onclick="CloseModal">
                        Cancel
                    </button>
                    <button class="btn-save" @onclick="SaveTemplate" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string selectedCategory = "";
    private bool isModalVisible = false;
    private string currentNotificationTitle = "";
    private bool isNotificationEnabled = true;
    private int selectedTemplate = 1;
    private bool isSaving = false;
    private string errorMessage = "";
    private bool depositRequestEnabled = false;

    // Test specific variables - kept for backend functionality but hidden from UI
    private string testPhoneNumber = "";
    private bool isTesting = false;
    private string testMessageResult = "";

    private Dictionary<string, NotificationSetting> savedSettings = new();
    private Dictionary<int, string> currentTemplates = new();
    private bool isLoadingTemplates = false;

    public class NotificationSetting
    {
        public bool IsEnabled { get; set; } = true;
        public int SelectedTemplate { get; set; } = 1;
    }

    public class TemplateDto
    {
        public int TemplateNumber { get; set; }
        public string Content { get; set; } = "";
    }

    // --- FETCH SETTINGS FROM DATABASE ON LOAD ---
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var apiSettings = await Http.GetFromJsonAsync<Dictionary<string, NotificationSetting>>("https://60.49.248.21:43250/api/WhatsappSettings/get-settings");
            if (apiSettings != null)
            {
                savedSettings = apiSettings;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching settings from database: {ex.Message}");
        }
    }

    private string GetApiNotificationType(string title)
    {
        if (title == LangSvc.GetText("WhatsAppApptConfirm")) return "Confirm";
        if (title == LangSvc.GetText("WhatsAppApptCancel")) return "Cancel";
        if (title == LangSvc.GetText("WhatsAppApptReminder")) return "Reminder";
        if (title == LangSvc.GetText("WhatsAppApptUpdate")) return "Update";
        return "";
    }

    private void SelectCategory(string category) => selectedCategory = category;
    private void GoBack() => selectedCategory = "";

    // Handles opening the modal and loading templates dynamically based on the current language
    private async Task OpenModal(string title)
    {
        currentNotificationTitle = title;
        errorMessage = "";
        testMessageResult = "";

        string apiType = GetApiNotificationType(title);

        if (!string.IsNullOrEmpty(apiType) && savedSettings.TryGetValue(apiType, out var setting))
        {
            isNotificationEnabled = setting.IsEnabled;
            selectedTemplate = setting.SelectedTemplate;
        }
        else
        {
            isNotificationEnabled = true;
            selectedTemplate = 1;
        }

        isModalVisible = true;

        // Fetch Template content from Database based on LanguageService
        currentTemplates.Clear();
        isLoadingTemplates = true;
        StateHasChanged();

        try
        {
            string currentLang = LangSvc.CurrentLanguage;
            var fetchedTemplates = await Http.GetFromJsonAsync<List<TemplateDto>>($"https://60.49.248.21:43250/api/WhatsappSettings/get-templates/{apiType}?lang={currentLang}");

            if (fetchedTemplates != null)
            {
                foreach (var t in fetchedTemplates)
                {
                    currentTemplates[t.TemplateNumber] = t.Content;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load templates: {ex.Message}";
        }
        finally
        {
            isLoadingTemplates = false;
            StateHasChanged();
        }
    }

    private void CloseModal() => isModalVisible = false;
    private void SelectTemplate(int num) => selectedTemplate = num;

    private MarkupString GetFormattedTemplateText(int templateNumber)
    {
        if (currentTemplates.TryGetValue(templateNumber, out string rawText))
        {
            string formattedText = System.Text.RegularExpressions.Regex.Replace(rawText, @"(\\\\r\\\\n|\\\\n|\\r\\n|\\n|\r\n|\n)", "<br />");
            formattedText = System.Text.RegularExpressions.Regex.Replace(formattedText, @"\*(.*?)\*", "<strong>$1</strong>");
            return (MarkupString)formattedText;
        }

        return (MarkupString)"Template not found.";
    }

    private async Task SaveTemplate()
    {
        isSaving = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            string apiNotificationType = GetApiNotificationType(currentNotificationTitle);
            bool apiSuccess = true;

            if (!string.IsNullOrEmpty(apiNotificationType))
            {
                var requestPayload = new
                {
                    NotificationType = apiNotificationType,
                    TemplateId = selectedTemplate,
                    IsEnabled = isNotificationEnabled
                };

                var response = await Http.PostAsJsonAsync("https://60.49.248.21:43250/api/WhatsappSettings/update-template", requestPayload);

                if (!response.IsSuccessStatusCode)
                {
                    apiSuccess = false;
                    string errorText = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Could not sync to Database. API ({response.StatusCode}): {errorText}";
                }
                else
                {
                    if (!savedSettings.ContainsKey(apiNotificationType))
                    {
                        savedSettings[apiNotificationType] = new NotificationSetting();
                    }

                    savedSettings[apiNotificationType].IsEnabled = isNotificationEnabled;
                    savedSettings[apiNotificationType].SelectedTemplate = selectedTemplate;
                }
            }

            if (apiSuccess)
            {
                CloseModal();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}

<style>
    /* ==========================================================================
           BASE & CONTAINERS - Matching Appointment Setup
           ========================================================================== */
    .whatsapp-page-wrapper {
        font-family: var(--font-family, 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif);
        font-size: 0.875rem;
        padding: clamp(0px, 4vw, 18px) clamp(16px, 4vw, 34px);
        background-color: #FAFAFA;
        min-height: 100vh;
    }

    /* --- Header - Matching Appointment Setup --- */
    .whatsapp-page-header {
        margin-bottom: 24px;
    }

    .whatsapp-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .whatsapp-subtitle {
        color: #666;
        font-size: 0.875rem;
    }

    /* --- Container Card - Matching Appointment Setup --- */
    .whatsapp-container {
        background: white;
        border: 1px solid #e8e8e8;
        border-radius: 14px;
        padding: 28px 30px 24px;
        width: 100%;
        max-width: 100%;
        box-shadow: none;
    }

    /* --- Category Label - Matching card-section-label --- */
    .category-label-row {
        font-size: 0.875rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 20px;
    }

    .category-main-label {
        color: #1a1a1a;
    }

    /* --- Category Item Button --- */
    .category-item-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px;
        background: white;
        border: 1px solid #e8e8e8;
        border-radius: 14px;
        margin-bottom: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
        font-size: 0.875rem;
    }

        .category-item-btn:hover {
            border-color: var(--color-primary, var(--primary));
            background: var(--bg-surface);
        }

    .btn-left {
        display: flex;
        align-items: center;
        gap: 15px;
        font-weight: 600;
        font-size: 0.875rem;
        color: #333;
    }

        .btn-left i {
            color: #666;
            font-size: 1rem;
        }

    .category-item-btn .fa-chevron-right {
        color: #bbb;
        font-size: 0.875rem;
    }

    /* --- WhatsApp Header (Back button + title) --- */
    .whatsapp-header {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 35px;
    }

        .whatsapp-header .whatsapp-title {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 600;
            color: #333;
        }

    .back-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px 8px 8px 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease;
        font-size: 1rem;
        color: #666;
    }

        .back-btn:hover {
            transform: translateX(-2px);
            color: #333;
        }

    /* --- Notification List --- */
    .notification-list {
        border-top: 1px solid #e8e8e8;
    }

    .notification-text-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
        border-bottom: 1px solid #e8e8e8;
        font-size: 0.875rem;
        color: #333;
    }

    .chevron-only-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease;
        font-size: 0.875rem;
        color: #bbb;
    }

        .chevron-only-btn:hover {
            transform: translateX(2px);
            color: #666;
        }

    /* ==========================================================================
           MODAL - Matching Appointment Setup styling
           ========================================================================== */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        backdrop-filter: blur(2px);
    }

    .modal-container-large {
        background: white;
        width: 90%;
        max-width: 750px;
        border-radius: 24px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 25px 50px rgba(0,0,0,0.15);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 30px;
        background-color: white;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
    }

    .modal-title-text {
        font-size: 1.125rem;
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    .modal-body-content {
        padding: 15px 30px 30px;
        max-height: 80vh;
        overflow-y: auto;
    }

    /* --- Alerts - Matching Appointment Setup --- */
    .alert-error {
        background: #fff0f0;
        border: 1px solid #ffcdd2;
        color: #c62828;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.75rem;
        margin-bottom: 18px;
    }

    /* --- Enable Banner --- */
    .enable-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        padding: 18px 24px;
        border-radius: 15px;
        margin-bottom: 30px;
        border: 1px solid #e8e8e8;
    }

    .enable-text {
        font-size: 0.875rem;
        font-weight: 600;
        color: #333;
    }

    /* --- Toggle Switch --- */
    .toggle-switch {
        position: relative;
        width: 48px;
        height: 24px;
        flex-shrink: 0;
    }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #e0e0e0;
        transition: .4s;
        border-radius: 24px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: var(--bg-surface);
    }

        input:checked + .slider:before {
            transform: translateX(24px);
            background-color: var(--primary);
        }

    /* --- Template Selection Grid --- */
    .template-selection-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    .template-option-card {
        border: 2px solid #e8e8e8;
        border-radius: 14px;
        padding: 15px;
        cursor: pointer;
        transition: 0.3s;
        background: white;
    }

        .template-option-card.is-selected {
            border-color: var(--primary);
            background: var(--bg-surface);
        }

    .card-status-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .tpl-tag {
        font-size: 0.75rem;
        font-weight: 600;
        color: #666;
    }

    .indicator-dot {
        width: 22px;
        height: 22px;
        border: 2px solid #e8e8e8;
        border-radius: 50%;
        position: relative;
        flex-shrink: 0;
    }

        .indicator-dot.is-active {
            border-color: var(--primary);
            background: var(--primary);
        }

            .indicator-dot.is-active::after {
                content: "";
                position: absolute;
                width: 8px;
                height: 8px;
                background: white;
                border-radius: 50%;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }

    .whatsapp-message-text {
        white-space: pre-wrap;
        word-wrap: break-word;
        margin-top: 8px;
        font-size: 0.8125rem;
        color: #555;
        line-height: 1.5;
    }

    /* --- Modal Action Buttons - Matching Appointment Setup --- */
    .modal-action-row {
        display: flex;
        gap: 16px;
        width: 100%;
        margin-top: 10px;
    }

    .btn-save, .btn-cancel {
        flex: 1;
        padding: 14px;
        border-radius: 10px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        border: none;
        letter-spacing: 0.01em;
    }

    .btn-save {
        background-color: var(--color-primary, var(--primary));
        color: white;
    }

        .btn-save:hover:not(:disabled) {
            opacity: 0.88;
        }

        .btn-save:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

    .btn-cancel {
        background-color: #FAFAFA;
        color: #666;
        border: 1px solid #e8e8e8;
    }

        .btn-cancel:hover {
            background-color: #F0F0F0;
            color: #333;
        }

    /* ==========================================================================
           RESPONSIVE - Matching Appointment Setup
           ========================================================================== */
    @@media (max-width: 768px) {
        .whatsapp-page-wrapper {
            padding: 20px;
        }

        .whatsapp-title {
            font-size: 1.125rem;
        }

        .whatsapp-subtitle {
            font-size: 0.8125rem;
        }

        .whatsapp-container {
            padding: 20px;
        }

        .category-label-row {
            font-size: 0.8125rem;
        }

        .category-item-btn {
            padding: 16px;
            font-size: 0.8125rem;
        }

        .btn-left {
            font-size: 0.8125rem;
        }

        .modal-container-large {
            width: 95%;
        }

        .modal-title-text {
            font-size: 1rem;
        }

        .modal-body-content {
            padding: 15px 20px 20px;
        }

        .enable-banner {
            padding: 15px 16px;
        }

        .enable-text {
            font-size: 0.8125rem;
        }

        .btn-save, .btn-cancel {
            font-size: 0.8125rem;
            padding: 12px;
        }
    }

    @@media (max-width: 480px) {
        .whatsapp-page-wrapper {
            padding: 15px;
        }

        .whatsapp-title {
            font-size: 1rem;
        }

        .whatsapp-subtitle {
            font-size: 0.75rem;
        }

        .whatsapp-container {
            padding: 16px;
        }

        .category-label-row {
            font-size: 0.75rem;
            margin-bottom: 14px;
        }

        .category-item-btn {
            padding: 14px;
            font-size: 0.75rem;
        }

        .btn-left {
            font-size: 0.75rem;
            gap: 12px;
        }

            .btn-left i {
                font-size: 0.875rem;
            }

        .whatsapp-header .whatsapp-title {
            font-size: 1rem;
        }

        .notification-text-row {
            font-size: 0.75rem;
            padding: 12px 0;
        }

        .template-selection-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .modal-title-text {
            font-size: 0.9375rem;
        }

        .modal-body-content {
            padding: 10px 16px 16px;
        }

        .enable-banner {
            padding: 12px 14px;
            margin-bottom: 20px;
        }

        .enable-text {
            font-size: 0.75rem;
        }

        .modal-action-row {
            flex-direction: column-reverse;
            gap: 12px;
        }

        .btn-save, .btn-cancel {
            font-size: 0.75rem;
            padding: 12px;
            width: 100%;
            flex: none;
        }

        .alert-error {
            font-size: 0.625rem;
            padding: 8px 12px;
        }

        .whatsapp-message-text {
            font-size: 0.6875rem;
        }
    }

    /* Small landscape devices */
    @@media (max-height: 500px) and (orientation: landscape) {
        .whatsapp-page-wrapper {
            padding: 15px;
        }

        .whatsapp-container {
            padding: 16px;
        }

        .modal-body-content {
            max-height: 70vh;
        }

        .modal-action-row {
            margin-top: 6px;
        }

        .btn-save, .btn-cancel {
            padding: 10px;
        }
    }
</style>