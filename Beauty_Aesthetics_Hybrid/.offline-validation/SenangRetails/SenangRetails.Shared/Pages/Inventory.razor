@page "/inventory"
@inherits SenangRetails.Shared.Pages.BasePage
@inject NavigationManager NavigationManager
@using SenangRetails.Shared.Components.Inventory

<div class="inventory-page-wrapper @(isNavOpen ? "" : "nav-collapsed")">
    <!-- MOBILE SIDEBAR OVERLAY -->
    @if (isNavOpen)
    {
        <div class="sidebar-overlay" @onclick="CloseNav"></div>
    }

    <div class="sidebar-custom @(isNavOpen ? "open" : "")">

        <div class="sidebar-header-row" style="display: flex; align-items: center; justify-content: space-between; padding: 14px 12px; border-bottom: 1px solid #F2F2F2;">
            <div class="sidebar-back-row" style="padding: 0;">
                <button class="sidebar-back-btn" @onclick="GoBack">
                    <i class="fa-solid fa-chevron-left"></i>
                    <span>Back</span>
                </button>
            </div>
            <button class="sidebar-menu-btn" @onclick="ToggleNav">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>

        <div class="sidebar-title-row">
            <span class="sidebar-page-title">Inventory</span>
        </div>

        <div class="search-container">
            <input type="text"
                   class="search-input"
                   placeholder="Search menu..."
                   @bind="searchQuery"
                   @bind:event="oninput"
                   @onkeyup="FilterSettings" />
            <span class="search-icon"><i class="bi bi-search"></i></span>
        </div>

        <div class="settings-nav">
            <!-- Overview Group -->
            <div class="nav-group @(IsVisible("Summary") || IsVisible("Balance") || IsVisible("Movement") || IsVisible("Transaction") ? "" : "hidden")">
                <div class="sidebar-section-header" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center;" @onclick="() => IsOverviewOpen = !IsOverviewOpen">
                    <span>Overview</span>
                    <i class="fa-solid fa-chevron-@(IsOverviewOpen ? "down" : "right")" style="font-size: 10px; opacity: 0.6;"></i>
                </div>
                @if (IsOverviewOpen)
                {
                    <button class="category-item @(selectedNav == "summary" ? "active" : "") @(IsVisible("Summary") ? "" : "hidden")"
                            @onclick='() => SelectSection("summary")'>
                        <span class="nav-icon-fa"><i class="bi bi-bar-chart-line-fill"></i></span>
                        <span>Stock Summary</span>
                    </button>
                    <button class="category-item @(selectedNav == "balance" ? "active" : "") @(IsVisible("Balance") ? "" : "hidden")"
                            @onclick='() => SelectSection("balance")'>
                        <span class="nav-icon-fa"><i class="bi bi-box-seam-fill"></i></span>
                        <span>Stock Balance</span>
                    </button>
                    <button class="category-item @(selectedNav == "movement" ? "active" : "") @(IsVisible("Movement") ? "" : "hidden")"
                            @onclick='() => SelectSection("movement")'>
                        <span class="nav-icon-fa"><i class="bi bi-arrows-move"></i></span>
                        <span>Stock Movement</span>
                    </button>
                    <button class="category-item @(selectedNav == "transaction" ? "active" : "") @(IsVisible("Transaction") ? "" : "hidden")"
                            @onclick='() => SelectSection("transaction")'>
                        <span class="nav-icon-fa"><i class="bi bi-plus-slash-minus"></i></span>
                        <span>Stock Transaction</span>
                    </button>
                }
            </div>

            <!-- Operations Group -->
            <div class="nav-group @(IsVisible("Stock in") || IsVisible("Stock out") || IsVisible("Receive Note") ? "" : "hidden")">
                <div class="sidebar-section-header" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center;" @onclick="() => IsOperationsOpen = !IsOperationsOpen">
                    <span>Stock Operations</span>
                    <i class="fa-solid fa-chevron-@(IsOperationsOpen ? "down" : "right")" style="font-size: 10px; opacity: 0.6;"></i>
                </div>
                @if (IsOperationsOpen)
                {
                    <button class="category-item @(selectedNav == "stockin" ? "active" : "") @(IsVisible("Stock in") ? "" : "hidden")"
                            @onclick='() => SelectSection("stockin")'>
                        <span class="nav-icon-fa"><i class="bi bi-bag-plus-fill"></i></span>
                        <span>Stock In</span>
                    </button>
                    <button class="category-item @(selectedNav == "stockout" ? "active" : "") @(IsVisible("Stock out") ? "" : "hidden")"
                            @onclick='() => SelectSection("stockout")'>
                        <span class="nav-icon-fa"><i class="bi bi-calendar-minus-fill"></i></span>
                        <span>Stock Out</span>
                    </button>
                    <button class="category-item @(selectedNav == "purchaseorder" ? "active" : "")"
                            @onclick='() => SelectSection("purchaseorder")'>
                        <span class="nav-icon-fa"><i class="bi bi-file-earmark-text-fill"></i></span>
                        <span>Purchase Order</span>
                    </button>
                    <button class="category-item @(selectedNav == "receivenote" ? "active" : "") @(IsVisible("Receive Note") ? "" : "hidden")"
                            @onclick='() => SelectSection("receivenote")'>
                        <span class="nav-icon-fa"><i class="bi bi-file-earmark-check-fill"></i></span>
                        <span>Receive Note</span>
                    </button>
                    <button class="category-item @(selectedNav == "incomingstocktransfer" ? "active" : "") @(IsVisible("Stock Transfer") ? "" : "hidden")"
                            @onclick='() => SelectSection("incomingstocktransfer")'>
                        <span class="nav-icon-fa"><i class="bi bi-arrow-left-right"></i></span>
                        <span>Stock Transfer</span>
                    </button>
                }
            </div>

            <!-- Partners Group -->
            @* <div class="nav-group @(IsVisible("Supplier") ? "" : "hidden")">
                <div class="sidebar-section-header" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center;" @onclick="() => IsPartnersOpen = !IsPartnersOpen">
                    <span>Partners</span>
                    <i class="fa-solid fa-chevron-@(IsPartnersOpen ? "down" : "right")" style="font-size: 10px; opacity: 0.6;"></i>
                </div>
                @if (IsPartnersOpen)
                {
                    <button class="category-item @(selectedNav == "supplier" ? "active" : "") @(IsVisible("Supplier") ? "" : "hidden")"
                            @onclick='() => SelectSection("supplier")'>
                        <span class="nav-icon-fa"><i class="bi bi-files"></i></span>
                        <span>Supplier</span>
                    </button>
                }
            </div> *@
        </div>
    </div>

    <div class="content-wrapper">
        @switch (selectedNav)
        {
            case "summary":
                <InventorySummary OnToggleNav="ToggleNav" OnNavSelected="OpenModalSection" />
                break;
            case "balance":
                <InventoryBalance OnToggleNav="ToggleNav" OnNavSelected="OpenModalSection" />
                break;
            case "movement":
                <InventoryMovement OnToggleNav="ToggleNav" OnNavSelected="OpenModalSection" />
                break;
            case "transaction":
                <InventoryTransaction OnToggleNav="ToggleNav" OnNavSelected="OpenModalSection" />
                break;
            case "stockin":
                <InventoryStockIn @ref="stockInComponent" OnToggleNav="ToggleNav"
                                  OnOpenAddProduct='() => OpenAddProductFlow("stockin")'
                                  OnConfirm="HandleStockInConfirm" />
                break;
            case "stockout":
                <InventoryStockOut @ref="stockOutComponent" OnToggleNav="ToggleNav"
                                   OnOpenAddProduct='() => OpenAddProductFlow("stockout")'
                                   OnConfirm="HandleStockOutConfirm" />
                break;
            case "deliveryorder":
                <InventoryDeliveryOrder OnToggleNav="ToggleNav" />
                break;
            case "supplier":
                <InventorySupplier OnToggleNav="ToggleNav" />
                break;
            case "purchaseorder":
                <PurchaseOrder OnToggleNav="ToggleNav" />
                break;
            case "receivenote":
                <ReceiveNote OnToggleNav="ToggleNav" />
                break;
            case "incomingstocktransfer":
                <IncomingStockTransfer OnToggleNav="ToggleNav" />
                break;
            default:
                <div class="header">
                    <div></div>
                    <div class="header-title">Inventory</div>
                    <div></div>
                </div>
                break;
        }
    </div>

    <!-- MODAL SHORTCUTS FOR STOCK IN & STOCK OUT -->
    <SlideModal IsOpen="@isStockInModalOpen" CssClass="stock-in-modal" OnClose="CloseStockInModal">
        <InventoryStockIn @ref="stockInModalComponent" OnToggleNav="CloseStockInModal"
                          IsInModal="true"
                          OnOpenAddProduct='() => OpenAddProductFlow("stockin")'
                          OnConfirm="HandleStockInConfirm" />
    </SlideModal>
    <SlideModal IsOpen="@isStockOutModalOpen" CssClass="stock-out-modal" OnClose="CloseStockOutModal">
        <InventoryStockOut @ref="stockOutModalComponent" OnToggleNav="CloseStockOutModal"
                           IsInModal="true"
                           OnOpenAddProduct='() => OpenAddProductFlow("stockout")'
                           OnConfirm="HandleStockOutConfirm" />
    </SlideModal>

    <!-- SHARED OVERLAYS (ELEVATED TO PARENT VIEWPORT) -->
    <InventoryAddProductModal IsOpen="@isAddProductModalOpen"
                              Title="@addProductTitle"
                              OnClose="CloseAddProductModal"
                              OnProductSelected="HandleProductSelected" />

    <InventoryItemDetailsModal IsOpen="@isItemDetailsModalOpen"
                               Title="@itemDetailsTitle"
                               OnClose="CloseItemDetailsModal"
                               @bind-Quantity="selectedQuantity"
                               @bind-Cost="selectedCost"
                               @bind-ExpiryDate="selectedExpiryDate"
                               OnConfirm="HandleItemDetailsConfirm" />

    <Calculator IsOpen="@isQuantityCalculatorOpen"
                Title="Quantity"
                InitialValue="@selectedQuantity"
                OnSave="HandleQuantitySave"
                OnClose="CloseQuantityCalculator" />

    <Calculator IsOpen="@isPriceCalculatorOpen"
                Title="Price"
                AllowDecimal="true"
                InitialValue="@selectedPrice"
                OnSave="HandlePriceSave"
                OnClose="ClosePriceCalculator" />

    <InventoryNotification @bind-IsVisible="isNotificationVisible"
                           Message="@notificationMessage"
                           Type="@notificationType" />
</div>