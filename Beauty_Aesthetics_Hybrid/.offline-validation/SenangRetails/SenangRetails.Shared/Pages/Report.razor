@page "/report"
@inherits SenangRetails.Shared.Pages.BasePage
@using SenangRetails.Shared.Components.Reports
@using SenangRetails.Shared.Models
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="report-page-container">
    <!-- MOBILE SIDEBAR OVERLAY -->
    @if (isLeftPanelExpanded && !isLeftPanelHidden)
    {
        <div class="report-left-panel-backdrop" @onclick="HideLeftPanel"></div>
    }

    <!-- Left Panel -->
    <div class="report-left-panel @(isLeftPanelExpanded ? "expanded" : "collapsed")">
        <div class="report-left-panel-header">
            <div class="sidebar-back-row">
                <button class="sidebar-back-btn" @onclick="GoBack">
                    <i class="fa-solid fa-chevron-left"></i>
                    <span>Back</span>
                </button>
            </div>
            <button class="report-menu-btn" @onclick="HideLeftPanel">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
        <div class="left-panel-container">
            <div class="sidebar-title-row">
                <span class="sidebar-page-title">@LangSvc.GetText("Report")</span>
            </div>

            <!-- Sales Section (Collapsible) -->
            <div class="tab-group">
                <div class="tab-grp-header" @onclick='() => ToggleGroup("sales")'>
                    <span class="tab-grp-label">@LangSvc.GetText("ReportSalesLabel")</span>
                    <i class="fa-solid fa-chevron-down group-chevron @(expandedGroups.Contains("sales") ? "rotated" : "")"></i>
                </div>
                <div class="tab-group-content @(expandedGroups.Contains("sales") ? "expanded" : "collapsed")">
                    <div class="report-left-panel-tabs">
                        <button class="report-left-tab @(selectedLeftTab == "Sales By Type" ? "active" : "")"
                                @onclick='() => SelectLeftTab("Sales By Type")'>
                            <i class="fa-solid fa-chart-simple"></i>
                            <span class="report-tab-label">@LangSvc.GetText("ReportSalesByType")</span>
                        </button>
                        <button class="report-left-tab @(selectedLeftTab == "Sales By Item" ? "active" : "")"
                                @onclick='() => SelectLeftTab("Sales By Item")'>
                            <i class="fa-solid fa-tag"></i>
                            <span class="report-tab-label">@LangSvc.GetText("ReportSalesByItem")</span>
                        </button>
                        <button class="report-left-tab @(selectedLeftTab == "Sales By Item Group" ? "active" : "")"
                                @onclick='() => SelectLeftTab("Sales By Item Group")'>
                            <i class="fa-solid fa-layer-group"></i>
                            <span class="report-tab-label">@LangSvc.GetText("ReportSalesByItemGroup")</span>
                        </button>
