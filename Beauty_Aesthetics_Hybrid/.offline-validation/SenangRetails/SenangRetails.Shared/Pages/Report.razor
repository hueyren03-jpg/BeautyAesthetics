                                @onclick='() => SelectLeftTab("Tax Summary")'>
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                            <span class="report-tab-label">@LangSvc.GetText("ReportTaxSummary")</span>
                        </button>
                        <button class="report-left-tab @(selectedLeftTab == "Transaction" ? "active" : "")"
                                @onclick='() => SelectLeftTab("Transaction")'>
                            <i class="fa-solid fa-receipt"></i>
                            <span class="report-tab-label">@LangSvc.GetText("ReportTransaction")</span>
                        </button>
                    </div>
                </div>
            </div>

