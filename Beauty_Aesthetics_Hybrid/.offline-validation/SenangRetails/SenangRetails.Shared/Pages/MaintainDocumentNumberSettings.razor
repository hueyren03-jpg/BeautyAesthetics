@code {
    private List<MaintainDocumentNumberModel> documentRules = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string activeCategory = "Document";
    private string subFilter = "ALL";
    private string searchQuery = "";
    private string alertMessage = "";
    private bool isSuccess = true;
    private MaintainDocumentNumberModel? expandedMobileRule;

    // Detailed Modal State
    private bool showConfigureModal = false;
    private MaintainDocumentNumberModel? selectedRuleForModal;

    // Keypad State
    private bool showKeypad = false;
    private string keypadTitle = "";
    private string keypadField = "";
    private string keypadValueString = "0";
    private MaintainDocumentNumberModel? activeRuleForKeypad;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocumentNumbers();
    }

    private async Task LoadDocumentNumbers()
    {
        isLoading = true;
        try
        {
            documentRules = await DocNumberService.GetDocumentNumbersAsync();
            expandedMobileRule = documentRules.FirstOrDefault(r => r.Category == activeCategory);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SwitchCategory(string category)
    {
        activeCategory = category;
        subFilter = "ALL";
        expandedMobileRule = documentRules.FirstOrDefault(r => r.Category == category);
    }

    private void ToggleMobileRule(MaintainDocumentNumberModel rule)
    {
        expandedMobileRule = expandedMobileRule == rule ? null : rule;
    }

    private IEnumerable<MaintainDocumentNumberModel> FilteredRules
    {
        get
        {
            var result = documentRules.Where(r => r.Category == activeCategory);

            if (activeCategory == "Document" && subFilter != "ALL")
            {
                result = subFilter switch
                {
                    "SALES" => result.Where(r => r.Name.Contains("Sale", StringComparison.OrdinalIgnoreCase) ||
                                                 r.Name.Contains("Quotation", StringComparison.OrdinalIgnoreCase) ||
                                                 r.Name.Contains("Invoice", StringComparison.OrdinalIgnoreCase) ||
                                                 r.Name.Contains("Order", StringComparison.OrdinalIgnoreCase) ||
                                                 r.Name.Contains("POS", StringComparison.OrdinalIgnoreCase) ||
                                                 r.Name.Contains("Credit Note", StringComparison.OrdinalIgnoreCase) ||
                                                 r.Name.Contains("Debit Note", StringComparison.OrdinalIgnoreCase)),
                    "INVENTORY" => result.Where(r => r.Name.Contains("Inventory", StringComparison.OrdinalIgnoreCase) ||
                                                     r.Name.Contains("Stock", StringComparison.OrdinalIgnoreCase) ||
                                                     r.Name.Contains("Transfer", StringComparison.OrdinalIgnoreCase) ||
                                                     r.Name.Contains("GRN", StringComparison.OrdinalIgnoreCase) ||
                                                     r.Name.Contains("GIN", StringComparison.OrdinalIgnoreCase) ||
                                                     r.Name.Contains("Adjustment", StringComparison.OrdinalIgnoreCase)),
                    "PURCHASE" => result.Where(r => r.Name.Contains("Purchase", StringComparison.OrdinalIgnoreCase) ||
                                                    r.Name.Contains("PO", StringComparison.OrdinalIgnoreCase) ||
                                                    r.Name.Contains("Supplier", StringComparison.OrdinalIgnoreCase)),
                    "FINANCE" => result.Where(r => r.Name.Contains("Cash", StringComparison.OrdinalIgnoreCase) ||
                                                   r.Name.Contains("Bank", StringComparison.OrdinalIgnoreCase) ||
                                                   r.Name.Contains("Deposit", StringComparison.OrdinalIgnoreCase) ||
                                                   r.Name.Contains("Transfer", StringComparison.OrdinalIgnoreCase) ||
                                                   r.Name.Contains("Journal", StringComparison.OrdinalIgnoreCase) ||
                                                   r.Name.Contains("Instalment", StringComparison.OrdinalIgnoreCase) ||
                                                   r.Name.Contains("Point", StringComparison.OrdinalIgnoreCase)),
                    _ => result
                };
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(r => (r.Name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (r.Prefix?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           r.DocType.ToString().Contains(searchQuery));
            }

            return result;
        }
    }

    private string FormatDisplayName(string rawName)
    {
        if (string.IsNullOrWhiteSpace(rawName)) return "Document";

        // Insert spaces before capital letters if CamelCase without spaces
        if (!rawName.Contains(' '))
        {
            var spaced = System.Text.RegularExpressions.Regex.Replace(rawName, "([a-z])([A-Z])", "$1 $2");
            return spaced;
        }

        return rawName;
    }

    private string GetDocumentIcon(string name, string category)
    {
        if (category == "Account")
        {
            if (name.Contains("Customer", StringComparison.OrdinalIgnoreCase)) return "fa-user-tag";
            if (name.Contains("Employee", StringComparison.OrdinalIgnoreCase) || name.Contains("HR", StringComparison.OrdinalIgnoreCase)) return "fa-id-card-clip";
            if (name.Contains("Creditor", StringComparison.OrdinalIgnoreCase) || name.Contains("Supplier", StringComparison.OrdinalIgnoreCase)) return "fa-truck-field";
            if (name.Contains("Bank", StringComparison.OrdinalIgnoreCase)) return "fa-building-columns";
            if (name.Contains("Inventory", StringComparison.OrdinalIgnoreCase) || name.Contains("Stock", StringComparison.OrdinalIgnoreCase)) return "fa-boxes-stacked";
            if (name.Contains("Student", StringComparison.OrdinalIgnoreCase)) return "fa-graduation-cap";
            return "fa-address-book";
        }

        // Document Categories
        if (name.Contains("Quotation", StringComparison.OrdinalIgnoreCase)) return "fa-file-signature";
        if (name.Contains("POS", StringComparison.OrdinalIgnoreCase) || name.Contains("Receipt", StringComparison.OrdinalIgnoreCase)) return "fa-receipt";
        if (name.Contains("Invoice", StringComparison.OrdinalIgnoreCase)) return "fa-file-invoice-dollar";
        if (name.Contains("SalesOrder", StringComparison.OrdinalIgnoreCase) || name.Contains("Sales Order", StringComparison.OrdinalIgnoreCase)) return "fa-cart-shopping";
        if (name.Contains("Purchase", StringComparison.OrdinalIgnoreCase) || name.Contains("PO", StringComparison.OrdinalIgnoreCase)) return "fa-bag-shopping";
        if (name.Contains("Credit Note", StringComparison.OrdinalIgnoreCase) || name.Contains("CN", StringComparison.OrdinalIgnoreCase)) return "fa-hand-holding-dollar";
        if (name.Contains("Debit Note", StringComparison.OrdinalIgnoreCase) || name.Contains("DN", StringComparison.OrdinalIgnoreCase)) return "fa-money-bill-transfer";
        if (name.Contains("Inventory", StringComparison.OrdinalIgnoreCase) || name.Contains("Adjustment", StringComparison.OrdinalIgnoreCase)) return "fa-box-archive";
        if (name.Contains("Transfer", StringComparison.OrdinalIgnoreCase)) return "fa-dolly";
        if (name.Contains("Point", StringComparison.OrdinalIgnoreCase) || name.Contains("Redemption", StringComparison.OrdinalIgnoreCase)) return "fa-coins";
        if (name.Contains("Delivery", StringComparison.OrdinalIgnoreCase) || name.Contains("DO", StringComparison.OrdinalIgnoreCase)) return "fa-truck-fast";
        if (name.Contains("Bank", StringComparison.OrdinalIgnoreCase) || name.Contains("Deposit", StringComparison.OrdinalIgnoreCase) || name.Contains("Fund", StringComparison.OrdinalIgnoreCase)) return "fa-vault";

        return "fa-file-lines";
    }

    private string GetDocumentTheme(string name, string category)
    {
        if (category == "Account")
        {
            if (name.Contains("Customer", StringComparison.OrdinalIgnoreCase)) return "theme-purple";
            if (name.Contains("Bank", StringComparison.OrdinalIgnoreCase)) return "theme-blue";
            if (name.Contains("Inventory", StringComparison.OrdinalIgnoreCase)) return "theme-green";
            return "theme-slate";
        }

        if (name.Contains("Invoice", StringComparison.OrdinalIgnoreCase) || name.Contains("POS", StringComparison.OrdinalIgnoreCase)) return "theme-orange";
        if (name.Contains("Quotation", StringComparison.OrdinalIgnoreCase) || name.Contains("Order", StringComparison.OrdinalIgnoreCase)) return "theme-blue";
        if (name.Contains("Credit Note", StringComparison.OrdinalIgnoreCase) || name.Contains("Deposit", StringComparison.OrdinalIgnoreCase)) return "theme-green";
        if (name.Contains("Transfer", StringComparison.OrdinalIgnoreCase) || name.Contains("Adjustment", StringComparison.OrdinalIgnoreCase)) return "theme-purple";

        return "theme-slate";
    }

    private string GetPaddedRunningNumber(MaintainDocumentNumberModel rule)
    {
        int padLength = Math.Max(1, rule.CharacterCount - rule.Prefix.Length);
        return rule.LastNumberUsed.ToString().PadLeft(padLength, '0');
    }

    private string GetNextSequencePreview(MaintainDocumentNumberModel rule)
    {
        long nextNum = rule.LastNumberUsed + 1;
        int padLength = Math.Max(1, rule.CharacterCount - rule.Prefix.Length);
        string formattedNum = nextNum.ToString().PadLeft(padLength, '0');
        return string.IsNullOrEmpty(rule.Prefix) ? formattedNum : $"{rule.Prefix}-{formattedNum}";
    }

    private string GetSampleFormatted(MaintainDocumentNumberModel rule, long num)
    {
        int padLength = Math.Max(1, rule.CharacterCount - rule.Prefix.Length);
        string formattedNum = num.ToString().PadLeft(padLength, '0');
        return string.IsNullOrEmpty(rule.Prefix) ? formattedNum : $"{rule.Prefix}-{formattedNum}";
    }

    private void StepDigits(MaintainDocumentNumberModel rule, int delta)
    {
        rule.CharacterCount = Math.Clamp(rule.CharacterCount + delta, 2, 30);
    }

    private void StepRunningNumber(MaintainDocumentNumberModel rule, int delta)
    {
        rule.LastNumberUsed = Math.Max(0, rule.LastNumberUsed + delta);
    }

    private void OpenConfigureModal(MaintainDocumentNumberModel rule)
    {
        selectedRuleForModal = rule;
        showConfigureModal = true;
    }

    private void CloseConfigureModal()
    {
        showConfigureModal = false;
        selectedRuleForModal = null;
    }

    private async Task SaveDocumentNumbers()
    {
        isSaving = true;
        alertMessage = "";
        try
        {
            var success = await DocNumberService.SaveDocumentNumbersAsync(documentRules);
            if (success)
            {
                isSuccess = true;
                alertMessage = "Maintain Document Numbers saved successfully!";
            }
            else
            {
                isSuccess = false;
                alertMessage = "Failed to save document numbers.";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            alertMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    // Touch Keypad Methods
    private void OpenKeypad(MaintainDocumentNumberModel rule, string field, long currentVal)
    {
        activeRuleForKeypad = rule;
        keypadField = field;
        keypadTitle = field switch
        {
            "CharacterCount" => "Total Digits Length",
            "LastNumberUsed" => "Running Number Counter",
            _ => field
        };
        keypadValueString = currentVal.ToString();
        showKeypad = true;
    }

    private void KeypadAppend(string val)
    {
        if (keypadValueString == "0")
            keypadValueString = val;
        else
            keypadValueString += val;
    }

    private void KeypadClear() => keypadValueString = "0";

    private void KeypadBackspace()
    {
        if (keypadValueString.Length > 1)
            keypadValueString = keypadValueString.Substring(0, keypadValueString.Length - 1);
        else
            keypadValueString = "0";
    }

    private void KeypadSave()
    {
        if (activeRuleForKeypad != null && long.TryParse(keypadValueString, out var num))
        {
            if (keypadField == "CharacterCount") activeRuleForKeypad.CharacterCount = (int)Math.Clamp(num, 2, 30);
            else if (keypadField == "LastNumberUsed") activeRuleForKeypad.LastNumberUsed = Math.Max(0, num);
        }
        showKeypad = false;
    }

    private void CloseKeypad() => showKeypad = false;
}
