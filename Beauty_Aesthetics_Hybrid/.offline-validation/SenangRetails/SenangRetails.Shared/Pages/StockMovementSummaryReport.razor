@namespace SenangRetails.Shared.Components.Reports
@inherits SenangRetails.Shared.Pages.BasePage
@using Microsoft.AspNetCore.Components
@using BlazorBootstrap
@using Microsoft.JSInterop
@using SenangRetails.Shared.Models
@using System.Text

<div class="stock-movement-summary-report-container">
    <div class="stock-movement-summary-report-list-container">
        <!-- Date Filter Section -->
        <div class="report-date-filter">
            <div class="date-filter-controls">
                <!-- Quick Date Range Buttons -->
                <div class="quick-date-buttons">
                    <button class="quick-date-btn @(selectedDateRange == "Today" ? "active" : "")" @onclick='() => SetDateRange("Today")'>
                        @LangSvc.GetText("Today")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Week" ? "active" : "")" @onclick='() => SetDateRange("Week")'>
                        @LangSvc.GetText("This Week")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Month" ? "active" : "")" @onclick='() => SetDateRange("Month")'>
                        @LangSvc.GetText("This Month")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Year" ? "active" : "")" @onclick='() => SetDateRange("Year")'>
                        @LangSvc.GetText("This Year")
                    </button>
                </div>

                <!-- Date Picker & Branch Selection -->
                <div class="date-picker-group">
                    @if (CanSelectBranch())
                    {
                        <div class="date-picker-item">
                            <label class="date-picker-label">@LangSvc.GetText("Branch ID")</label>
                            <button class="branch-select-btn" @onclick="OpenBranchSelectionModal">
                                <span>@(selectedBranchDisplay ?? LangSvc.GetText("Select Branch"))</span>
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                       
                    }
                    <div class="date-picker-item">
                        <label class="date-picker-label">@LangSvc.GetText("Start Date")</label>
                        <MobileDatePicker @bind-Value="startDate"
                                          DateFormat="dd/MM/yyyy"
                                          Placeholder="Select Start Date" />
                    </div>
                    <div class="date-picker-item">
                        <label class="date-picker-label">@LangSvc.GetText("End Date")</label>
                        <MobileDatePicker @bind-Value="endDate"
                                          DateFormat="dd/MM/yyyy"
                                          Placeholder="Select End Date" />
                    </div>
                    <button class="refresh-btn" @onclick="RefreshDataAsync" title="Refresh">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>

                <!-- Export Dropdown Button -->
                <div class="export-dropdown">
                    <button class="export-btn" @onclick="ToggleExportDropdown" @onclick:preventDefault="true">
                        <i class="bi bi-download"></i>
                        <span class="action-btn-text">@LangSvc.GetText("Export")</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    @if (showExportDropdown)
                    {
                        <div class="export-dropdown-menu">
                            <button class="export-dropdown-item" @onclick="ExportToCSV">
                                <i class="bi bi-file-spreadsheet"></i>
                                @LangSvc.GetText("Export CSV")
                            </button>
                            <button class="export-dropdown-item" @onclick="ExportToPDF">
                                <i class="bi bi-file-pdf"></i>
                                @LangSvc.GetText("Export PDF")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- KPI Summary Cards -->
        <div class="kpi-cards">
            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-box"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@totalItems.ToString("N0")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Items")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@totalOpeningQty.ToString("N2")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Opening Qty")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-cart-plus"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@totalPurchasesQty.ToString("N2")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Purchases Qty")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-cart-x"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@totalSalesQty.ToString("N2")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Sales Qty")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@totalClosingQty.ToString("N2")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Closing Qty")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@totalClosingValue.ToString("N2")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Closing Value")</div>
                </div>
            </div>
        </div>

        <!-- Stock Movement Table with Filter Inputs -->
        <div class="stock-movement-table-wrapper">
            <div class="stock-movement-table">
                <div class="stock-movement-table-header">
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Branch ID")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="branchIdFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Item Name")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="itemNameFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Item Group")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="groupNameFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Display Code")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="itemCodeFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("UOM")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="uomFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Opening Qty")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="openingQtyFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Purchase Qty")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="purchaseQtyFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Purchase Return")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="purchaseReturnFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Sales Qty")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="salesQtyFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Sales Return")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="salesReturnFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Conversion In")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="conversionInFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Conversion Out")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="conversionOutFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Transferred In")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="transferredInFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Transferred Out")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="transferredOutFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Adjustment Qty")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="adjustmentFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Closing Qty")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="closingQtyFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Unit Cost")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="unitCostFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="stock-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Closing Value")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="closingValueFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                </div>
                <div class="filter-badge-container">
                    @if (HasActiveFilters())
                    {
                        <button class="clear-filters-btn" @onclick="ClearFilters">
                            <i class="bi bi-x-circle"></i> Clear All Filters
                        </button>
                    }
                </div>
                <div class="stock-movement-table-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
                            <p>Loading data...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(exportMessage))
                    {
                        <div class="alert alert-@alertType">@exportMessage</div>
                    }
                    else if (filteredMovementData.Any())
                    {
                        @foreach (var item in filteredMovementData)
                        {
                            <div class="stock-movement-table-row">
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Branch ID")">
                                    @item.BranchID
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Item Name")">
                                    <div class="item-info-cell">
                                        <div class="item-icon">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                        <div class="item-details">
                                            <span class="item-name">@item.ItemName</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Item Group")">
                                    @item.GroupName
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Display Code")">
                                    @item.ItemCode
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("UOM")">
                                    @item.UOM
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Opening Qty")">
                                    @item.QtyOpening.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Purchase Qty")">
                                    @item.QtyPurchase.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Purchase Return")">
                                    @item.QtyPurchaseReturn.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Sales Qty")">
                                    @item.QtySales.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Sales Return")">
                                    @item.QtySalesReturn.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Conversion In")">
                                    @item.QtyConversionIn.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Conversion Out")">
                                    @item.QtyConversionOut.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Transferred In")">
                                    @item.QtyTransferredIn.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Transferred Out")">
                                    @item.QtyTransferredOut.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Adjustment Qty")">
                                    @item.QtyAdjustment.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Closing Qty")">
                                    <span class="amount">@item.QtyClosing.ToString("N2")</span>
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Unit Cost")">
                                    @item.UnitCost.ToString("N2")
                                </div>
                                <div class="stock-movement-table-cell" data-label="@LangSvc.GetText("Closing Value")">
                                    @item.ClosingCostValue.ToString("N2")
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Branch Selection Modal -->
    @if (showBranchModal)
    {
        <div class="modal-overlay" @onclick="CloseBranchModal">
            <div class="modal-content" @onclick:stopPropagation="true" style="height: 650px; max-width: 590px;">
                <div class="modal-header">
                    <div class="appt-title">@LangSvc.GetText("Select Branch")</div>
                </div>

                <div class="search-bar">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text"
                           class="search-input"
                           placeholder="Search Branch..."
                           @bind="BranchSearchTerm"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(BranchSearchTerm))
                    {
                        <button class="search-clear" @onclick='() => BranchSearchTerm = ""'>
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>

                <!-- Select All Option -->
                <div class="select-all-container">
                    <div class="staff-list-item @(selectAllBranches ? "selected" : "")"
                         @onclick="ToggleSelectAllBranches">
                        <span class="staff-list-item-name">
                            <i class="bi bi-check-all"></i> @LangSvc.GetText("Select All Branches")
                        </span>
                        @if (selectAllBranches)
                        {
                            <i class="bi bi-check2 selected-check-icon"></i>
                        }
                    </div>
                    <div class="selection-count">
                        @(stagedBranchIDs.Count) of @(masterBranchList.Count) selected
                    </div>
                </div>

                <div class="branch-list-container">
                    @if (filteredBranchList.Any())
                    {
                        @foreach (var branchName in filteredBranchList)
                        {
                            bool isSelected = IsBranchSelected(branchName);
                            <div class="staff-list-item @(isSelected ? "selected" : "")"
                                 @onclick="() => ToggleBranchSelection(branchName)">
                                <span class="staff-list-item-name">
                                    <i class="bi bi-building"></i> @branchName
                                </span>
                                @if (isSelected)
                                {
                                    <i class="bi bi-check2 selected-check-icon"></i>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <p>@LangSvc.GetText("No branches found.")</p>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="appt-btn-secondary" style="flex: 1;" @onclick="CloseBranchModal">
                        @LangSvc.GetText("Cancel")
                    </button>
                    <button class="appt-btn-primary" style="flex: 1;"
                            disabled="@(stagedBranchIDs.Count == 0 && !selectAllBranches)"
                            @onclick="ConfirmBranchSelection">
                        @LangSvc.GetText("Apply")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (showAlertDialogModal)
    {
        <div class="modal-overlay" @onclick="CloseAlertDialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="appointment-modal-header">
                    <div class="appt-title">@alertDialogTitle</div>
                </div>
                <div class="modal-body">
                    <p>@alertDialogMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="appt-btn-primary" style="flex: 1;" @onclick="CloseAlertDialog">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }
</div>