@namespace SenangRetails.Shared.Components.Reports
@inherits SenangRetails.Shared.Pages.BasePage
@using Microsoft.AspNetCore.Components
@using BlazorBootstrap
@using System.Text
@using QuestPDF.Fluent
@using QuestPDF.Helpers
@using QuestPDF.Infrastructure

<div class="staff-sales-report-container">
    <div class="staff-sales-report-list-container">
        <!-- Date Filter Section -->
        <div class="report-date-filter">
            <div class="date-filter-controls">
                <!-- Quick Date Range Buttons -->
                <div class="quick-date-buttons">
                    <button class="quick-date-btn @(selectedDateRange == "Today" ? "active" : "")" @onclick='() => SetDateRange("Today")'>
                        @LangSvc.GetText("Today")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Week" ? "active" : "")" @onclick='() => SetDateRange("Week")'>
                        @LangSvc.GetText("This Week")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Month" ? "active" : "")" @onclick='() => SetDateRange("Month")'>
                        @LangSvc.GetText("This Month")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Year" ? "active" : "")" @onclick='() => SetDateRange("Year")'>
                        @LangSvc.GetText("This Year")
                    </button>
                </div>

                <!-- Date Pickers with Labels and Refresh Button -->
                <div class="date-picker-group">
                    <div class="date-picker-item">
                        <label class="date-picker-label">@LangSvc.GetText("Start Date")</label>
                        <MobileDatePicker @bind-Value="startDate"
                                          DateFormat="dd/MM/yyyy"
                                          Placeholder="Select Date" />
                    </div>
                    <div class="date-picker-item">
                        <label class="date-picker-label">@LangSvc.GetText("End Date")</label>
                        <MobileDatePicker @bind-Value="endDate"
                                          DateFormat="dd/MM/yyyy"
                                          Placeholder="Select Date" />
                    </div>
                    <button class="refresh-btn" @onclick="RefreshData" title="Refresh">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>

                <!-- Export Dropdown Button -->
                <div class="export-dropdown">
                    <button class="export-btn" @onclick="ToggleExportDropdown" @onclick:preventDefault="true">
                        <i class="bi bi-download"></i>
                        <span class="action-btn-text">@LangSvc.GetText("Export")</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    @if (showExportDropdown)
                    {
                        <div class="export-dropdown-menu">
                            <button class="export-dropdown-item" @onclick="ExportToCSV">
                                <i class="bi bi-file-spreadsheet"></i>
                                @LangSvc.GetText("Export CSV")
                            </button>
                            <button class="export-dropdown-item" @onclick="ExportToPDF">
                                <i class="bi bi-file-pdf"></i>
                                @LangSvc.GetText("Export PDF")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- KPI Summary Cards -->
        <div class="kpi-cards">
            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">RM @totalAllSales.ToString("N2")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Sales")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@totalBillCount.ToString("N0")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Bills")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@staffCount.ToString("N0")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Active Staff")</div>
                </div>
            </div>
        </div>

        <!-- Staff Sales Table with Filter Inputs -->
        <div class="staff-sales-table-wrapper">
            <div class="staff-sales-table">
                <div class="staff-sales-table-header">
                    <div class="staff-sales-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Staff Name")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="staffNameFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="staff-sales-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Bill Count")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="billCountFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="staff-sales-table-header-cell filter-header">
                        <span>@LangSvc.GetText("All Sales")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="allSalesFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="staff-sales-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Service Sales")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="serviceSalesFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="staff-sales-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Product Sales")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="productSalesFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="staff-sales-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Package Sales")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="packageSalesFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="staff-sales-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Top Up Sales")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="topUpSalesFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                </div>
                <div class="filter-badge-container">
                    @if (HasActiveFilters())
                    {
                        <button class="clear-filters-btn" @onclick="ClearFilters">
                            <i class="bi bi-x-circle"></i> Clear All Filters
                        </button>
                    }
                </div>
                <div class="staff-sales-table-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
                            <p>Loading data...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(exportMessage))
                    {
                        <div class="alert alert-@alertType">@exportMessage</div>
                    }
                    else if (filteredEmployeeSales.Any())
                    {
                        @foreach (var staff in filteredEmployeeSales)
                        {
                            <div class="staff-sales-table-row">
                                <div class="staff-sales-table-cell" data-label="@LangSvc.GetText("Staff Name")" title="@staff.EmployeeName">
                                    @staff.EmployeeName
                                </div>
                                <div class="staff-sales-table-cell" data-label="@LangSvc.GetText("Bill Count")">
                                    @staff.BillCount.ToString("N0")
                                </div>
                                <div class="staff-sales-table-cell" data-label="@LangSvc.GetText("All Sales")">
                                    @staff.AllSales.ToString("N2")
                                </div>
                                <div class="staff-sales-table-cell" data-label="@LangSvc.GetText("Service Sales")">
                                    @staff.ServiceSales.ToString("N2")
                                </div>
                                <div class="staff-sales-table-cell" data-label="@LangSvc.GetText("Product Sales")">
                                    @staff.ProductSales.ToString("N2")
                                </div>
                                <div class="staff-sales-table-cell" data-label="@LangSvc.GetText("Package Sales")">
                                    @staff.PackageSales.ToString("N2")
                                </div>
                                <div class="staff-sales-table-cell" data-label="@LangSvc.GetText("Top Up Sales")">
                                    @staff.CreditSales.ToString("N2")
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>
    </div>
    @if (showAlertDialogModal)
    {
        <div class="modal-overlay" @onclick="CloseAlertDialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="appointment-modal-header">
                    <div class="appt-title">@alertDialogTitle</div>
                </div>
                <div class="modal-body">
                    <p>@alertDialogMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="appt-btn-primary" style="flex: 1;" @onclick="CloseAlertDialog">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }
</div>