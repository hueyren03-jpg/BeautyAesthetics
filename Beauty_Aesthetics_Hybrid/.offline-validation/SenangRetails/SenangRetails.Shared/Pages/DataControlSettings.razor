@if (showUploadMemberModal)
{
    <div class="modal-overlay">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@LangSvc.GetText("DataControlUploadModalTitle")</h3>
            </div>

            <div class="modal-body">
                <div class="processing-container @(IsProcessing ? "" : "hidden")">
                    <div class="spinner"></div>
                    <p class="status-text">@UploadStatus</p>
                </div>
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="error-alert-container">
                        <div class="error-alert-header">
                            <span>Upload Error</span>
                            <button class="close-icon-btn" @onclick="() => ErrorMessage = null">&times;</button>
                        </div>
                        <div class="error-alert-body">
                            @ErrorMessage
                        </div>
                    </div>
                }
                <div class="@(IsProcessing ? "hidden" : "")">
                    <div class="template-download-section">
                        <button class="btn-download-template" @onclick="DownloadTemplate">
                            <i class="fa-solid fa-file-csv"></i> Download CSV Template
                        </button>
                    </div>

                    <div class="upload-section">
                        <div class="file-upload-area">
                            <div class="upload-icon"><i class="bi bi-cloud-upload"></i></div>
                            @if (FormFactor.GetFormFactor() == "Web")
                            {
                                <InputFile OnChange="HandleFileSelected"
                                           id="memberUploadInput"
                                           accept=".csv"
                                           hidden />
                                <label for="memberUploadInput" class="select-file-btn" style="cursor:pointer;">
                                    @LangSvc.GetText("DataControlSelectFile")
                                </label>
                            }
                            else
                            {
                                <button class="select-file-btn" @onclick="PickFileNativeAsync">
                                    @LangSvc.GetText("DataControlSelectFile")
                                </button>
                            }
                            <p class="upload-hint">@(selectedFileName ?? "Choose a CSV file to upload")</p>
                        </div>
                    </div>

                    <div class="import-instructions">
                        <div class="instruction-header">
                            Import Instructions
                        </div>
                        
                        <ol class="instruction-list">
                            <li><strong>File format:</strong> CSV</li>
                            <li>Header row is required</li>
                            <li><strong>Columns (in order):</strong> Name, Contact, Birthday Year, Birthday Month, Birthday Day, Gender, Email, NRIC, Ethnicity,
                                Marital Status, Source, Member Tier, Remarks, Address 1, Address 2, Postal Code, City, State, Country</li>
                            <li><strong>Name</strong> and <strong>Contact</strong> are required</li>
                            <li><strong>Birthday Year</strong>, <strong>Birthday Month</strong> and <strong>Birthday Day</strong> must be numbers</li>
                            <li>Birthday Year, Birthday Month, Birthday Day, Gender, Email, NRIC, Ethnicity,
                                Marital Status, Source, Member Tier, Remarks, Address 1, Address 2, Postal Code, City, State and Country are optional</li>
                            <li>If any row has missing/invalid data, import will be cancelled</li>
                        </ol>
                    </div>
                </div>
                
                
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseUploadMemberModal">@LangSvc.GetText("Cancel")</button>
                <button class="btn btn-primary" @onclick="ConfirmUpload">@LangSvc.GetText("DataControlUploadModalTitle")</button>
            </div>
        </div>
    </div>    
}


@if (showUploadMenuModal)
{
    <div class="modal-overlay">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@LangSvc.GetText("DataControlUploadMenu")</h3>
            </div>

            <div class="modal-body">
                @if (menuUploadSuccess)
                {
                    <div class="menu-upload-success">
                        <div class="success-icon"><i class="bi bi-check-circle-fill" style="color: #2e7d32;"></i></div>
                        <h4 class="success-title">Import Successful!</h4>
                        <p class="success-message">@menuSuccessMessage</p>
                    </div>
                }
                else
                {
                    <div class="processing-container @(IsMenuProcessing ? "" : "hidden")">
                        <div class="spinner"></div>
                        <p class="status-text">@MenuUploadStatus</p>
                    </div>
                    @if (!string.IsNullOrEmpty(MenuErrorMessage))
                    {
                        <div class="error-alert-container">
                            <div class="error-alert-header">
                                <span>Upload Error</span>
                                <button class="close-icon-btn" @onclick="() => MenuErrorMessage = null">&times;</button>
                            </div>
                            <div class="error-alert-body">@MenuErrorMessage</div>
                        </div>
                    }
                    <div class="@(IsMenuProcessing ? "hidden" : "")">
                        <div class="template-download-section">
                            <button class="btn-download-template" @onclick="DownloadMenuTemplate">
                                <i class="fa-solid fa-file-csv"></i> Download CSV Template
                            </button>
                        </div>

                        <div class="upload-section">
                            <div class="file-upload-area">
                                <div class="upload-icon"><i class="bi bi-cloud-upload"></i></div>
                                @if (FormFactor.GetFormFactor() == "Web")
                                {
                                    <InputFile OnChange="HandleMenuFileSelected"
                                               id="menuUploadInput"
                                               accept=".csv"
                                               hidden />
                                    <label for="menuUploadInput" class="select-file-btn" style="cursor:pointer;">
                                        @LangSvc.GetText("DataControlSelectFile")
                                    </label>
                                }
                                else
                                {
                                    <button class="select-file-btn" @onclick="PickMenuFileNativeAsync">
                                        @LangSvc.GetText("DataControlSelectFile")
                                    </button>
                                }
                                @if (menuSelectedFileName != null)
                                {
                                    <p class="upload-hint file-selected">✓ @menuSelectedFileName ready to import</p>
                                }
                                else
                                {
                                    <p class="upload-hint">Choose a CSV file to upload</p>
                                }
                            </div>
                        </div>

                        <div class="import-instructions">
                            <div class="instruction-header">
                                Import Instructions
                            </div>
                            <ol class="instruction-list">
                                <li><strong>File format:</strong> CSV</li>
                                <li>Header row is required</li>
                                <li><strong>Columns (in order):</strong> Name, Section, Tax Code, Price Inclusive Tax, Price, Cost, Barcode, UOM, Item Code</li>
                                <li><strong>Name</strong>, <strong>Section</strong> and <strong>Price Inclusive Tax</strong> are required</li>
                                <li><strong>Price Inclusive Tax</strong> must be <strong>Yes</strong> or <strong>No</strong></li>
                                <li><strong>Price</strong> and <strong>Cost</strong> must be numbers (no RM or any currency symbol)</li>
                                <li>Tax Code, Barcode, Item Code and UOM are optional</li>
                                <li>If any row has missing/invalid data, import will be cancelled</li>
                                <li>New Section will be auto-created if it does not exist</li>
                            </ol>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                @if (menuUploadSuccess)
                {
                    <button class="btn btn-primary" @onclick="CloseUploadMenuModal">Done</button>
                }
                else
                {
                    <button class="btn btn-outline" @onclick="CloseUploadMenuModal">@LangSvc.GetText("Cancel")</button>
                    <button class="btn btn-primary" @onclick="ConfirmMenuUpload" disabled="@IsMenuProcessing">@LangSvc.GetText("DataControlUploadMenu")</button>
                }
            </div>
        </div>
    </div>
}

