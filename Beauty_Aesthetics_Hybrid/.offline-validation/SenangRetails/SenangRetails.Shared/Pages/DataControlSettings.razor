@code {
    // ── Staff Upload Variables ──────────────────────────────────────────────────
    private bool showUploadStaffModal = false;
    private string? staffSelectedFileName;
    private MemoryStream? staffSelectedFileStream;
    private bool IsStaffProcessing = false;
    private string StaffUploadStatus = "";
    private List<string> staffImportErrors = new();
    private bool showUploadAppointmentModal = false;
    private string? appointmentSelectedFileName;
    private MemoryStream? appointmentSelectedFileStream;
    private bool IsAppointmentProcessing = false;
    private string AppointmentUploadStatus = "";
    private List<string> appointmentImportErrors = new();

    private void OpenUploadStaffModal()
    {
        staffSelectedFileName = null;
        staffSelectedFileStream = null;
        staffImportErrors.Clear();
        StaffUploadStatus = "";
        showUploadStaffModal = true;
    }

    private void CloseUploadStaffModal()
    {
        showUploadStaffModal = false;
        staffSelectedFileStream?.Dispose();
        staffSelectedFileStream = null;
    }

    private async Task DownloadStaffTemplate()
    {
        var headers = new[] {
            "MasterAccountID", "AccountStatus", "AccountName", "SalesPersonCode",
            "IsSalesPerson", "IsNotSalesPerson", "JobTitle", "Phone", "Gender",
            "BirthdayYear", "BirthdayMonth", "BirthdayDay", "DateHired", "DateResigned"
        };
        await FileDownloadService.DownloadCsvTemplateAsync("staff_import_template.csv", headers);
    }

    private async Task HandleStaffFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase)) return;

        staffSelectedFileName = file.Name;
        staffSelectedFileStream = new MemoryStream();
        await file.OpenReadStream(1024 * 1024 * 5).CopyToAsync(staffSelectedFileStream);
        staffSelectedFileStream.Position = 0;
    }

    private async Task PickStaffFileNativeAsync()
    {
        var result = await FilePickerService.PickFileAsync(new[] { ".csv" });
        if (result == null) return;
        staffSelectedFileName = result.FileName;
        staffSelectedFileStream = result.Stream;
        StateHasChanged();
    }
    private string CleanLine(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";

        return input
            .Replace("\u200B", "") // zero-width space
            .Replace("\u00A0", " ") // non-breaking space
            .Trim();
    }
    // ── Staff Upload Logic (One-by-One Upload with Aggressive Ghost Row Skipping) ──
    private async Task ConfirmStaffUpload()
    {
        if (staffSelectedFileStream == null)
        {
            staffImportErrors.Add("Please select a CSV file first.");
            return;
        }

        IsStaffProcessing = true;
        StaffUploadStatus = "Reading and validating staff file...";
        staffImportErrors.Clear();
        StateHasChanged();
        await Task.Yield();

        try
        {
            staffSelectedFileStream.Position = 0;
            using var reader = new StreamReader(staffSelectedFileStream, System.Text.Encoding.UTF8, leaveOpen: true);

            // 1. Read Header
            var headerLine = await reader.ReadLineAsync();
            if (string.IsNullOrWhiteSpace(headerLine))
            {
                staffImportErrors.Add("The CSV file is empty or missing the header row.");
                return;
            }

            // 2. Parse and Validate Rows
            var staffToImport = new List<StaffRequestDTO>();
            int lineNumber = 1;
            string? line;
            DateTime sqlMinDate = new DateTime(1753, 1, 1);
            var now = DateTime.Now;

            while ((line = await reader.ReadLineAsync()) != null)
            {
                lineNumber++;

                // --- AGGRESSIVE GHOST ROW CHECK ---
                // If we remove all commas and spaces and NOTHING is left, skip this line entirely.
                // This prevents "Row 2: Name and Phone cannot be empty" on empty Excel rows.
                Console.WriteLine($"[RAW] Line {lineNumber}: '{line}'");

                line = CleanLine(line);

                Console.WriteLine($"[CLEAN] Line {lineNumber}: '{line}'");
                // Skip if line is effectively empty
                if (string.IsNullOrWhiteSpace(line)) continue;

                // Parse first
                var fields = ParseCsvLine(line);

                // Skip if ALL fields are empty or whitespace
                if (fields == null || fields.All(f => string.IsNullOrWhiteSpace(f))) continue;

                // Expect at least Name and Phone
                if (fields.Length < 2)
                {
                    staffImportErrors.Add($"Row {lineNumber}: Invalid format. Missing columns.");
                    continue;
                }

                var name = fields.Length > 2 ? fields[2].Trim() : "";
                var phone = fields.Length > 7 ? fields[7].Trim() : "";

                if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(phone))
                {
                    staffImportErrors.Add($"Row {lineNumber}: Name (Col 3) and Phone (Col 8) cannot be empty.");
                    continue;
                }

                // 2. Parse Numbers & Booleans
                // IsSalesPerson (Index 4), IsNotSalesPerson (Index 5)
                bool isSales = fields.Length > 4 && fields[4].Trim().Equals("Yes", StringComparison.OrdinalIgnoreCase);
                bool isNotSales = fields.Length > 5 && fields[5].Trim().Equals("Yes", StringComparison.OrdinalIgnoreCase);

                // Birthdays (Indexes 9, 10, 11)
                int.TryParse(fields.Length > 9 ? fields[9] : "0", out int bYear);
                int.TryParse(fields.Length > 10 ? fields[10] : "0", out int bMonth);
                int.TryParse(fields.Length > 11 ? fields[11] : "0", out int bDay);

                // 3. Parse Dates
                DateTime hireDate = now;
                if (fields.Length > 12 && DateTime.TryParse(fields[12], out var parsedHire))
                {
                    hireDate = parsedHire < sqlMinDate ? sqlMinDate : parsedHire;
                }

                DateTime resignedDate = hireDate; // Default to hire date to prevent SQL error
                if (fields.Length > 13 && DateTime.TryParse(fields[13], out var parsedResigned))
                {
                    resignedDate = parsedResigned < sqlMinDate ? sqlMinDate : parsedResigned;
                }

                // 4. Map to DTO
                staffToImport.Add(new StaffRequestDTO
                {
                    // Identity/State
                    MasterAccountId = fields.Length > 0 ? fields[0].Trim() : "",
                    AccountStatus = fields.Length > 1 ? fields[1].Trim() : "Active",
                    AccountName = name,
                    SalesPersonCode = fields.Length > 3 ? fields[3].Trim() : "",
                    IsSalesPerson = isSales,
                    IsNotSalesPerson = isNotSales,
                    JobTitle = fields.Length > 6 ? fields[6].Trim() : "",
                    Phone = phone,
                    Gender = fields.Length > 8 ? fields[8].Trim() : "",

                    // Numbers
                    BirthdayYear = bYear,
                    BirthdayMonth = bMonth,
                    BirthdayDay = bDay,

                    // Dates
                    DateHired = hireDate,
                    DateResigned = resignedDate,

                    // Required Backend Defaults (Fixes 500 Error)
                    IsSelected = true,
                    IsLoading = false,
                    IsDirty = true,
                    SaveAction = "Added",
                    AlphaCode = "",
                    DisplayCode = "",
                    BranchId = "HQ",
                    Createdby = "",
                    Modifiedby = "",
                    Nric = "",
                    ImagePath = "",
                    EmployeeTypeId = "",
                    CreatedDateTime = now,
                    ModifiedDateTime = now,
                    UpdateTimeStamp = now,
                    AppFirstLoginDate = now,
                    Remarks = "",
                    FingerPrint = ""
                });
            }

            // Only proceed to upload if NO errors were found in any row
            if (staffImportErrors.Any())
            {
                StaffUploadStatus = "Import cancelled. Please fix the errors listed above.";
                return;
            }

            if (staffToImport.Count == 0)
            {
                staffImportErrors.Add("No valid data rows were found in the file.");
                return;
            }

            // 3. One-by-One Upload via for loop
            StaffUploadStatus = $"Validated {staffToImport.Count} staff. Importing...";
            StateHasChanged();

            int successCount = 0;
            for (int i = 0; i < staffToImport.Count; i++)
            {
                // Upload current item
                var result = await StaffService.CreateStaffAsync(staffToImport[i]);

                if (result != null && result.statusCode == 200)
                {
                    successCount++;
                }
                else
                {
                    // Optional: log individual API failures if needed
                    Console.WriteLine($"Failed to upload: {staffToImport[i].AccountName}");
                }

                // UI Progress update
                if (i % 5 == 0 || i == staffToImport.Count - 1)
                {
                    StaffUploadStatus = $"Importing {i + 1} of {staffToImport.Count}...";
                    StateHasChanged();
                }
            }

            StaffUploadStatus = $"Successfully imported {successCount} staff members!";
            await Task.Yield();
            await Task.Delay(2000);
            CloseUploadStaffModal();
        }
        catch (Exception ex)
        {
            staffImportErrors.Add($"Critical Error: {ex.Message}");
        }
        finally
        {
            IsStaffProcessing = false;
            StateHasChanged();
        }
    }

