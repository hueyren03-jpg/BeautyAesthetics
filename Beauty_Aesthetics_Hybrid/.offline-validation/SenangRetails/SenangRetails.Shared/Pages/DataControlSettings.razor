            }
            finally
            {
                IsProcessing = false;
                StateHasChanged();
            }
        }
    }

    private string GenerateMemberCsv(List<CustomerDM> customers)
    {
        var sb = new System.Text.StringBuilder();

        var headers = new[] {
            "Name", "Contact", "Birthday Year", "Birthday Month", "Birthday Day",
            "Gender", "Email", "NRIC", "Ethnicity", "Marital Status",
            "Source", "Member Tier", "Remarks", "Address 1", "Address 2",
            "Postal Code", "City", "State", "Country"
        };
        sb.AppendLine(string.Join(",", headers));

        foreach (var c in customers)
        {
            var row = new List<string>
            {
                EscapeCsvField(c.AccountName),
                EscapeCsvField(c.Phone),
                c.BirthdayYear.ToString(),
                c.BirthdayMonth.ToString(),
                c.BirthdayDay.ToString(),
                EscapeCsvField(c.Gender),
                EscapeCsvField(c.Email),
                EscapeCsvField(c.NRIC),
                EscapeCsvField(c.RaceName),
                EscapeCsvField(c.MaritalStatus),
                EscapeCsvField(c.CustomerSourceName),
                EscapeCsvField(c.MembershipTypeName),
                EscapeCsvField(c.Comment),
                EscapeCsvField(c.Address1),
                EscapeCsvField(c.Address2),
                EscapeCsvField(c.ZipCode),
                EscapeCsvField(c.City),
                EscapeCsvField(c.CountryState),
                EscapeCsvField(c.Country)
            };
            sb.AppendLine(string.Join(",", row));
        }

        return sb.ToString();
    }

    private string EscapeCsvField(string? field)
    {
        if (string.IsNullOrEmpty(field)) return "";
        if (field.Contains(",") || field.Contains("\"") || field.Contains("\n"))
        {
            return $"\"{field.Replace("\"", "\"\"")}\"";
        }
        return field;
    }

    private async Task ExportMenuCsvAsync()
    {
        try
        {
            // Load items — prefer cache, fall back to live fetch
            var items = ProductCacheService.Items;
            if (items == null || !items.Any())
                items = await InventoryService.LoadItemsAsync("") ?? new List<InventoryDM>();

            if (!items.Any())
            {
                // Re-use the member modal's error field as a quick notification
                ErrorMessage = "No product data found to export.";
                return;
            }

            // Build category lookup (ID → Name) for resolving section names
            var categories = ProductCacheService.Categories;
            if (categories == null || !categories.Any())
                categories = await SupportingTableSvc.LoadListByTypeAsync(4) ?? new List<SenangRetails.Shared.Models.DTOs.SupportingTableItem>();

            var catLookup = categories
                .Where(c => !string.IsNullOrEmpty(c.SupportingTableID))
                .GroupBy(c => c.SupportingTableID!)
                .ToDictionary(g => g.Key, g => g.First().SupportingTableName ?? "", StringComparer.OrdinalIgnoreCase);

            // Build CSV matching the upload template column order:
            // Name, Section, Tax Code, Price Inclusive Tax, Price, Cost, Barcode, UOM, Item Code
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("Name,Section,Tax Code,Price Inclusive Tax,Price,Cost,Barcode,UOM,Item Code");

            foreach (var item in items)
            {
                var sectionName = !string.IsNullOrWhiteSpace(item.ItemGroupName)
                    ? item.ItemGroupName
                    : (catLookup.TryGetValue(item.ItemGroupID ?? "", out var n) ? n : "");

                sb.AppendLine(string.Join(",", new[]
                {
                    EscapeCsvField(item.AccountName ?? ""),
                    EscapeCsvField(sectionName),
                    EscapeCsvField(item.TaxCodeID ?? ""),
                    item.IsTaxInclusive ? "Yes" : "No",
                    item.SalesPrice.ToString("0.##"),
                    item.PurchasePrice.ToString("0.##"),         // purchasePrice = Cost in POS
                    EscapeCsvField(item.VendorItemCode ?? ""),   // vendorItemCode = Barcode in POS
                    EscapeCsvField(item.UnitOfMeasureName ?? item.UnitOfMeasureID ?? ""),
                    EscapeCsvField(item.DisplayCode ?? "")       // displayCode = Item Code in POS
                }));
            }

            var fileName = $"MenuExport_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await FileDownloadService.DownloadCsvTemplateAsync(fileName, Array.Empty<string>(), sb.ToString());
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Export failed: {ex.Message}";
        }
    }

