    private async Task ConfirmAppointmentUpload()
    {
        if (appointmentSelectedFileStream == null)
        {
            appointmentImportErrors.Add("Please select an Appointment CSV file first.");
            return;
        }

        IsAppointmentProcessing = true;
        AppointmentUploadStatus = "Reading and verifying data file records...";
        appointmentImportErrors.Clear();
        StateHasChanged();
        await Task.Yield();

        try
        {
            appointmentSelectedFileStream.Position = 0;
            using var reader = new StreamReader(appointmentSelectedFileStream, System.Text.Encoding.UTF8, leaveOpen: true);

            var headerLine = await reader.ReadLineAsync();
            if (string.IsNullOrWhiteSpace(headerLine))
            {
                appointmentImportErrors.Add("The CSV file is empty or missing the header row.");
                return;
            }

            var apptsToImport = new List<AppointmentDM>();
            int lineNumber = 1;
            string? line;

            while ((line = await reader.ReadLineAsync()) != null)
            {
                lineNumber++;
                line = CleanLine(line);
                if (string.IsNullOrWhiteSpace(line)) continue;

                var fields = ParseCsvLine(line);
                if (fields == null || fields.All(f => string.IsNullOrWhiteSpace(f))) continue;

                // Enforce 7 primary required parameters boundary rule
                if (fields.Length < 7)
                {
                    appointmentImportErrors.Add($"Row {lineNumber}: Invalid matrix format block. Row has incomplete fields.");
                    continue;
                }

                var customerName = fields[0].Trim();
                var serviceItem = fields[1].Trim();
                var location = fields[2].Trim();
                var requestedBy = fields[3].Trim();
                var staffId = fields[4].Trim();
                var startTimeRaw = fields[5].Trim();
                var endTimeRaw = fields[6].Trim();
                var remarks = fields.Length > 7 ? fields[7].Trim() : "";

                // Essential validation checks
                if (string.IsNullOrWhiteSpace(customerName))
                    appointmentImportErrors.Add($"Row {lineNumber}: 'Customer Name' parameter is missing.");
                if (string.IsNullOrWhiteSpace(serviceItem))
                    appointmentImportErrors.Add($"Row {lineNumber}: 'Service Item' parameter is missing.");
                if (string.IsNullOrWhiteSpace(location))
                    appointmentImportErrors.Add($"Row {lineNumber}: 'Branch / Location' parameter is missing.");
                if (string.IsNullOrWhiteSpace(requestedBy))
                    appointmentImportErrors.Add($"Row {lineNumber}: 'Requested By' parameter is missing.");
                if (string.IsNullOrWhiteSpace(staffId))
                    appointmentImportErrors.Add($"Row {lineNumber}: 'Service Staff ID' parameter is missing.");

                if (!DateTime.TryParse(startTimeRaw, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime start))
                    appointmentImportErrors.Add($"Row {lineNumber}: Start Time '{startTimeRaw}' is not an accessible timestamp format (Use YYYY-MM-DD HH:MM).");

                if (!DateTime.TryParse(endTimeRaw, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime end))
                    appointmentImportErrors.Add($"Row {lineNumber}: End Time '{endTimeRaw}' is not an accessible timestamp format.");

                if (start >= end)
                    appointmentImportErrors.Add($"Row {lineNumber}: Appointment Start Time must fall chronologically earlier than End Time context.");

                if (appointmentImportErrors.Any()) continue;

                apptsToImport.Add(new AppointmentDM
                {
                    AppointmentID = "",
                    CustomerName = customerName,
                    SalesDescriptions = serviceItem,
                    AppointmentLocation = location,
                    BranchID = AppState.SelectedBranchID, 
                    RequestedBy = requestedBy,
                    EmployeeID = staffId,
                    StartTime = start,
                    EndTime = end,
                    Memo = remarks,
                    IsDirty = true,
                    SaveAction = EBI.Enum.EntityState.Added,
                });
            }

            if (appointmentImportErrors.Any())
            {
                AppointmentUploadStatus = "Import execution stopped. Clean transactional exceptions first.";
                return;
            }

            AppointmentUploadStatus = "Appointment module disabled in SenangRetails.";
            await Task.Delay(1000);
            CloseUploadAppointmentModal();
        }
        catch (Exception ex)
        {
            appointmentImportErrors.Add($"Execution Interrupted: {ex.Message}");
        }
        finally
        {
            IsAppointmentProcessing = false;
            StateHasChanged();
        }
    }

