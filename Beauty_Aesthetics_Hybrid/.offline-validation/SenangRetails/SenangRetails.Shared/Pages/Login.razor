@page "/"
@inherits SenangRetails.Shared.Pages.BasePage
@using SenangRetails.Shared.Services.AuthService
@inject NavigationManager NavigationManager
@inject IAuthService authService
@inject Microsoft.JSInterop.IJSRuntime JS
@inject SenangRetails.Shared.Services.ThemeService.IThemeService ThemeService

<div class="login-page">
    <div class="login-center">
        <div class="login-card">
            <div class="card-logo">
                <img src="/_content/SenangRetails.Shared/images/senang_logo.png" alt="Senang by EBI" class="logo-img" />
            </div>

            <h1 class="card-title">Senang Retails</h1>
            <p class="card-subtitle">Sign in to your account</p>

            <form class="login-form" @onsubmit="HandleLogin">
                <div class="form-field">
                    <label for="identifier">@LangSvc.GetText("EmailOrPhone")</label>
                    <input type="text"
                           id="identifier"
                           class="form-input"
                           placeholder="@LangSvc.GetText("EmailOrPhonePlaceholder")"
                           @bind="LoginIdentifier"
                           required />
                </div>

                <div class="form-field">
                    <label for="password">@LangSvc.GetText("PasswordLabel")</label>
                    <div class="input-wrapper">
                        <input type="@(ShowPassword ? "text" : "password")"
                               id="password"
                               class="form-input"
                               placeholder="@LangSvc.GetText("PasswordPlaceholder")"
                               @bind="Password"
                               required />
                        <button type="button" class="toggle-password" @onclick="TogglePasswordVisibility">
                            <i class="fa-solid @(ShowPassword ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                </div>

                <div class="form-options">
                    <label class="remember-me">
                        <input type="checkbox" @bind="RememberDevice" />
                        <span>Remember this device</span>
                    </label>
                    @* <a href="#" class="forgot-link">Forgot password?</a> *@
                </div>

                <button type="submit" class="sign-in-btn" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>@LangSvc.GetText("SigningIn")</span>
                    }
                    else
                    {
                        <span>@LangSvc.GetText("SignIn")</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    }
                </button>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="error-alert">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@ErrorMessage</span>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@code {
    private string LoginIdentifier { get; set; } = "";
    private string Password { get; set; } = "";
    private bool ShowPassword { get; set; } = false;
    private bool IsLoading { get; set; } = false;
    private string ErrorMessage { get; set; } = "";
    private bool RememberDevice { get; set; } = false;

    private const string RememberKey = "remember_me_identifier";
    private const string RememberPwKey = "remember_me_password";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await ThemeService.InitializeThemeAsync();
            }
            catch { }

            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", RememberKey);
            if (!string.IsNullOrEmpty(saved))
            {
                LoginIdentifier = saved;
                Password = await JS.InvokeAsync<string?>("localStorage.getItem", RememberPwKey) ?? "";
                RememberDevice = true;
                StateHasChanged();
            }
        }
    }

    private async System.Threading.Tasks.Task HandleLogin()
    {
        ErrorMessage = "";
        IsLoading = true;

        if (string.IsNullOrWhiteSpace(LoginIdentifier) || string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage = LangSvc.GetText("CredentialsRequired");
            IsLoading = false;
            return;
        }

        if (RememberDevice)
        {
            await JS.InvokeVoidAsync("localStorage.setItem", RememberKey, LoginIdentifier);
            await JS.InvokeVoidAsync("localStorage.setItem", RememberPwKey, Password);
        }
        else
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", RememberKey);
            await JS.InvokeVoidAsync("localStorage.removeItem", RememberPwKey);
        }

        if (await authService.AuthenticateAsync(LoginIdentifier, Password) == true)
        {
            NavigationManager.NavigateTo("/select-branch");
        }
        else
        {
            ErrorMessage = LangSvc.GetText("InvalidCredentials");
            IsLoading = false;
        }
    }

    private void TogglePasswordVisibility() => ShowPassword = !ShowPassword;
}