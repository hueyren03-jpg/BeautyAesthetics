        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 0.875rem; /* 14px */
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
        min-width: 164px;
    }

    .loading-state {
        font-size: 0.75rem; /* 12px */
        color: #aaa;
        padding: 10px 0;
    }

    .empty-state {
        font-size: 0.75rem; /* 12px */
        color: #bbb;
        padding: 20px 0;
        text-align: center;
    }

    .list-container {
        display: flex;
        flex-direction: column;
        width: 100%;
