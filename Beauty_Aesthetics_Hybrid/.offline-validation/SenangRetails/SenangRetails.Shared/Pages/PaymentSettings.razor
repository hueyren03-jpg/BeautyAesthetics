@page "/paymentsetting"
@inherits SenangRetails.Shared.Pages.BasePage
@using Microsoft.AspNetCore.Components.Forms
@inject AppState AppState
@inject SenangRetails.Shared.Services.PaymentService.IPaymentService PaymentService
@inject SenangRetails.Shared.ApiClient.POSPaymentLineTypeAC PaymentLineTypeAC

<div class="section-container">
    <div class="section-header">
        <div class="header-left">
            <h2>@LangSvc.GetText("PaymentSettingsTitle")</h2>
            <p>@LangSvc.GetText("PaymentSettingsDesc")</p>
        </div>
        <button class="add-payment-btn" @onclick="OpenAddModal"><i class="fa-solid fa-plus"></i> Add Payment Method</button>
    </div>

    <div class="">
        <div class="point-section">
            <div class="section-title-row-with-action">
                <h3>@LangSvc.GetText("PaymentMethodTitle")</h3>
            </div>

            @if (isLoadingMethods)
            {
                <div class="loading-state">@LangSvc.GetText("PaymentLoading")</div>
            }
            else if (!string.IsNullOrEmpty(loadError))
            {
                <div class="error-banner">@loadError</div>
            }
            else if (additionalPayments.Count == 0)
            {
                <div class="empty-state">@LangSvc.GetText("PaymentEmpty")</div>
            }
            else
            {
                <div class="list-container">
                    @foreach (var method in additionalPayments)
                    {
                        <div class="list-item @(!method.Active ? "item-inactive" : "")">
                            <div class="list-item-left">
                                <span class="payment-name">@method.POSPaymentTypeName</span>
                                @if (method.PaymentIntegrationType == 3)
                                {
                                    <span class="payment-sub">IPay Wallet Scan</span>
                                }
                            </div>
                            <div class="list-item-right">
                                @if (!string.IsNullOrWhiteSpace(method.Grouping))
                                {
                                    <span class="payment-type-badge">@method.Grouping</span>
                                }
                                <span class="status-badge @(method.Active ? "badge-active" : "badge-inactive")">
                                    @(method.Active ? LangSvc.GetText("Active") : LangSvc.GetText("Inactive"))
                                </span>
                                <div class="payment-action-buttons">
                                    <button class="pt-action-btn" @onclick:stopPropagation="true" @onclick="() => OpenEditModal(method)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                    <button class="pt-action-btn pt-delete-btn" @onclick:stopPropagation="true" @onclick="() => RequestDelete(method)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (showPaymentModal)
{
    <div class="modal-overlay" @onclick="ClosePaymentModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                
                <h3>@(isEditing ? LangSvc.GetText("PaymentEditModalTitle") : LangSvc.GetText("PaymentAddModalTitle"))</h3>
                
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(saveError))
                {
                    <div class="error-banner">@saveError</div>
                }

                <div class="form-group">
                    <div class="name-label-row">
                        <label class="form-label">@LangSvc.GetText("PaymentMethodName") <span class="required">*</span></label>
                        <div style="display: flex; align-items: center; gap: 0.5rem; padding-bottom: 0.8rem; flex-shrink: 0;">
                            <input type="checkbox" id="paymentIsActive" class="custom-checkbox" @bind="currentForm.Active" />
                            <label for="paymentIsActive" style="margin: 0; font-weight: 600; color: #555; white-space: nowrap; cursor: pointer; font-size: 0.9rem;">@LangSvc.GetText("ProductFilterisActive")</label>
                        </div>
                    </div>
                    <input type="text" class="form-control" @bind="currentForm.Name" placeholder="@LangSvc.GetText("PaymentPlaceholderName")" />
                </div>

                <div class="form-group">
                    <label class="form-label">@LangSvc.GetText("PaymentMethodType") <span class="required">*</span></label>
                    <select class="form-control" @bind="currentForm.Grouping">
                        <option value="">@LangSvc.GetText("PaymentSelectType")</option>
                        <option value="Cash">@LangSvc.GetText("PaymentTypeCash")</option>
                        <option value="Card">@LangSvc.GetText("PaymentTypeCard")</option>
                        <option value="Voucher">@LangSvc.GetText("PaymentTypeVoucher")</option>
                        <option value="Others">Others</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Payment Integration Type</label>
                    <select class="form-control" @bind="currentForm.PaymentIntegrationType">
                        <option value="0">None</option>
                        <option value="3">IPay Wallet Scan</option>
                    </select>
                </div>

                @if (currentForm.PaymentIntegrationType == 3)
                {
                    <div class="form-group">
                        <label class="form-label">@LangSvc.GetText("PaymentMerchantCode")</label>
                        <input type="text" class="form-control" @bind="currentForm.MerchantCode" placeholder="@LangSvc.GetText("PaymentPlaceholderMerchantCode")" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">@LangSvc.GetText("PaymentMerchantKey")</label>
                        <input type="text" class="form-control" @bind="currentForm.MerchantKey" placeholder="@LangSvc.GetText("PaymentPlaceholderMerchantKey")" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">@LangSvc.GetText("PaymentTerminalID")</label>
                        <input type="text" class="form-control" @bind="currentForm.TerminalID" placeholder="@LangSvc.GetText("PaymentPlaceholderTerminalID")" />
                    </div>
                }
                <div class="modal-footer">
                    <button class="close-icon-btn" @onclick="ClosePaymentModal">Cancel</button>
                    <button class="save-btn" @onclick="SavePayment" disabled="@isSaving">
                        @(isSaving ? "..." : LangSvc.GetText("Save"))
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- DELETE CONFIRMATION POPUP -->
@if (showDeleteModal)
{
    <div class="modal-overlay" style="z-index: 3200;" @onclick="() => showDeleteModal = false">
        <div class="modal-container" style="text-align: center; max-width: 400px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Confirm Delete</h3>
            </div>
            <div class="modal-body" style="padding: 1.5rem 2rem; display: flex; flex-direction: column; align-items: center; gap: 0.75rem;">
                @if (!string.IsNullOrEmpty(saveError))
                {
                    <div class="error-banner">@saveError</div>
                }
                <div style="width: 56px; height: 56px; border-radius: 50%; background: #FFF0F0; display: flex; align-items: center; justify-content: center; margin-bottom: 10px;">
                    <i class="fa-solid fa-trash" style="font-size: 1.4rem; color: var(--primary);"></i>
                </div>
                <p style="color: #555; margin: 0; font-size: 14px; line-height: 1.5;">Are you sure you want to delete payment method <strong>@methodToDelete?.POSPaymentTypeName</strong>?</p>
            </div>
            <div class="modal-footer" style="justify-content: center; gap: 10px; padding: 0 1rem 1rem 1rem;">
                <button class="close-icon-btn" @onclick="() => { showDeleteModal = false; saveError = string.Empty; }">Cancel</button>
                <button class="save-btn" style="background-color: var(--primary); border-color: var(--primary);" @onclick="ConfirmDelete" disabled="@isSaving">
                    @(isSaving ? "..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool showPaymentModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private bool isLoadingMethods = false;
    private string saveError = "";
    private string loadError = "";
    private bool showDeleteModal = false;
    private PaymentMethodDisplay? methodToDelete;

    private class PaymentForm
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Grouping { get; set; } = "";
        public int PaymentIntegrationType { get; set; } = 0;
        public string MerchantCode { get; set; } = "";
        public string MerchantKey { get; set; } = "";
        public string TerminalID { get; set; } = "";
        public bool Active { get; set; } = true;
        public string VisibleInBranch { get; set; } = "";
        public string VisibleInGroup { get; set; } = "";
    }

    private class PaymentMethodDisplay
    {
        public int POSPaymentTypeID { get; set; }
        public string POSPaymentTypeName { get; set; } = "";
        public string? Grouping { get; set; }
        public int PaymentIntegrationType { get; set; }
        public string? MerchantCode { get; set; }
        public string? MerchantKey { get; set; }
        public string? TerminalID { get; set; }
        public string? VisibleInBranch { get; set; }
        public string? VisibleInGroup { get; set; }
        public bool Active { get; set; }
    }

    private List<PaymentMethodDisplay> additionalPayments = new();
    private PaymentForm currentForm = new();

    private bool IsIPay => currentForm.PaymentIntegrationType == 3;

    protected override async Task OnInitializedAsync()
    {
        await LoadPaymentMethods();
    }

    private async Task LoadPaymentMethods()
    {
        isLoadingMethods = true;
        loadError = "";

        try
        {
            var branchId = !string.IsNullOrEmpty(AppState.SelectedBranchID)
                ? AppState.SelectedBranchID
                : AppState.CurrentBranch?.BranchID ?? string.Empty;

            var groupId = !string.IsNullOrEmpty(AppState.SelectedBranchGroupID)
                ? AppState.SelectedBranchGroupID
                : AppState.CurrentBranch?.BranchGroupID ?? string.Empty;

            var methods = await PaymentService.GetPaymentMethodsAsync(branchId, groupId, "", includeInactive: true);

            additionalPayments = methods
                .Select(m => new PaymentMethodDisplay
                {
                    POSPaymentTypeID = m.POSPaymentTypeID,
                    POSPaymentTypeName = m.POSPaymentTypeName ?? "",
                    Grouping = m.Grouping,
                    PaymentIntegrationType = m.PaymentIntegrationType,
                    MerchantCode = m.MerchantCode,
                    MerchantKey = m.MerchantKey,
                    TerminalID = m.TerminalID,
                    VisibleInBranch = m.VisibleInBranch,
                    VisibleInGroup = m.VisibleInGroup,
                    Active = m.Active
                })
                .ToList();
        }
        catch (Exception ex)
        {
            loadError = LangSvc.GetText("PaymentErrorLoadFailed");
            Console.WriteLine($"[PaymentSettings] Load error: {ex.Message}");
        }
        finally
        {
            isLoadingMethods = false;
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        currentForm = new PaymentForm { Active = true };
        saveError = "";
        showPaymentModal = true;
    }

    private void OpenEditModal(PaymentMethodDisplay method)
    {
        isEditing = true;
        currentForm = new PaymentForm
        {
            Id = method.POSPaymentTypeID,
            Name = method.POSPaymentTypeName,
            Grouping = method.Grouping ?? "",
            PaymentIntegrationType = method.PaymentIntegrationType,
            MerchantCode = method.MerchantCode ?? "",
            MerchantKey = method.MerchantKey ?? "",
            TerminalID = method.TerminalID ?? "",
            Active = method.Active,
            VisibleInBranch = method.VisibleInBranch ?? "",
            VisibleInGroup = method.VisibleInGroup ?? ""
        };
        saveError = "";
        showPaymentModal = true;
    }

    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        saveError = "";
    }

    private async Task SavePayment()
    {
        if (string.IsNullOrWhiteSpace(currentForm.Name))
        {
            saveError = LangSvc.GetText("PaymentErrorNameRequired");
            return;
        }

        if (string.IsNullOrWhiteSpace(currentForm.Grouping))
        {
            saveError = LangSvc.GetText("PaymentErrorTypeRequired");
            return;
        }

        isSaving = true;
        saveError = "";

        // For new records, use selected branch/group. For edits, preserve the original.
        var branchId = isEditing && !string.IsNullOrEmpty(currentForm.VisibleInBranch)
            ? currentForm.VisibleInBranch
            : (!string.IsNullOrEmpty(AppState.SelectedBranchID)
                ? AppState.SelectedBranchID
                : AppState.CurrentBranch?.BranchID ?? string.Empty);

        var groupId = isEditing && !string.IsNullOrEmpty(currentForm.VisibleInGroup)
            ? currentForm.VisibleInGroup
            : (!string.IsNullOrEmpty(AppState.SelectedBranchGroupID)
                ? AppState.SelectedBranchGroupID
                : AppState.CurrentBranch?.BranchGroupID ?? string.Empty);

        // Clear merchant fields when integration type is None so stale values aren't saved.
        if (currentForm.PaymentIntegrationType != 3)
        {
            currentForm.MerchantCode = "";
            currentForm.MerchantKey = "";
            currentForm.TerminalID = "";
        }

        var result = await PaymentLineTypeAC.SaveRecordAsync(
            posPaymentTypeID: currentForm.Id,
            posPaymentTypeName: currentForm.Name,
            grouping: currentForm.Grouping,
            visibleInBranch: branchId,
            visibleInGroup: groupId,
            merchantCode: currentForm.MerchantCode,
            merchantKey: currentForm.MerchantKey,
            terminalID: currentForm.TerminalID,
            active: currentForm.Active,
            paymentIntegrationType: currentForm.PaymentIntegrationType
        );

        isSaving = false;

        if (result == null || result.statusCode != 200)
        {
            saveError = result?.message is { Length: > 0 } msg ? msg : LangSvc.GetText("PaymentErrorSaveFailed");
            return;
        }

        ClosePaymentModal();
        await LoadPaymentMethods();
    }

    private void RequestDelete(PaymentMethodDisplay method)
    {
        methodToDelete = method;
        saveError = "";
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (methodToDelete == null) return;

        isSaving = true;
        saveError = "";
        StateHasChanged();

        try
        {
            var response = await PaymentLineTypeAC.DeleteRecordAsync(methodToDelete.POSPaymentTypeID);
            if (response != null && response.statusCode == 200)
            {
                showDeleteModal = false;
                methodToDelete = null;
                await LoadPaymentMethods();
            }
            else
            {
                saveError = response?.message ?? "Delete failed";
            }
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}

<style>
