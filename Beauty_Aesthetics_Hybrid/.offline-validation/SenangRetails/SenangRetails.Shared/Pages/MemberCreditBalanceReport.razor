@namespace SenangRetails.Shared.Components.Reports
@inherits SenangRetails.Shared.Pages.BasePage
@using Microsoft.AspNetCore.Components
@using BlazorBootstrap
@using Microsoft.JSInterop
@using SenangRetails.Shared.Models
@using System.Text

<div class="member-credit-balance-report-container">
    <div class="member-credit-balance-report-list-container">
        <!-- Date Filter Section -->
        <div class="report-date-filter">
            <div class="date-filter-controls">
                <!-- Quick Date Range Buttons -->
                <div class="quick-date-buttons">
                    <button class="quick-date-btn @(selectedDateRange == "Today" ? "active" : "")" @onclick='() => SetDateRange("Today")'>
                        @LangSvc.GetText("Today")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Week" ? "active" : "")" @onclick='() => SetDateRange("Week")'>
                        @LangSvc.GetText("This Week")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Month" ? "active" : "")" @onclick='() => SetDateRange("Month")'>
                        @LangSvc.GetText("This Month")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Year" ? "active" : "")" @onclick='() => SetDateRange("Year")'>
                        @LangSvc.GetText("This Year")
                    </button>
                </div>

                <!-- Date Picker -->
                <div class="date-picker-group">
                    <div class="date-picker-item">
                        <label class="date-picker-label">@LangSvc.GetText("Date")</label>
                        <MobileDatePicker @bind-Value="selectedDate"
                                          DateFormat="dd/MM/yyyy"
                                          Placeholder="Select Date" />
                    </div>
                    <button class="refresh-btn" @onclick="RefreshDataAsync" title="Refresh">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>

                <!-- Export Dropdown Button -->
                <div class="export-dropdown">
                    <button class="export-btn" @onclick="ToggleExportDropdown" @onclick:preventDefault="true">
                        <i class="bi bi-download"></i>
                        <span class="action-btn-text">@LangSvc.GetText("Export")</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    @if (showExportDropdown)
                    {
                        <div class="export-dropdown-menu">
                            <button class="export-dropdown-item" @onclick="ExportToCSV">
                                <i class="bi bi-file-spreadsheet"></i>
                                @LangSvc.GetText("Export CSV")
                            </button>
                            <button class="export-dropdown-item" @onclick="ExportToPDF">
                                <i class="bi bi-file-pdf"></i>
                                @LangSvc.GetText("Export PDF")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Filter Tabs for Credit Status -->
        <div class="report-type-tabs">
            <button class="type-tab @(selectedStatusTab == "ActiveCredits" ? "active" : "")"
                    @onclick="@(() => SelectStatusTab("ActiveCredits"))">
                <i class="bi bi-check-circle"></i>
                @LangSvc.GetText("Active Credits")
            </button>
            <button class="type-tab @(selectedStatusTab == "ExpiredCredits" ? "active" : "")"
                    @onclick="@(() => SelectStatusTab("ExpiredCredits"))">
                <i class="bi bi-clock-history"></i>
                @LangSvc.GetText("Expired Credits")
            </button>
            <button class="type-tab @(selectedStatusTab == "FullyRedeemedCredits" ? "active" : "")"
                    @onclick="@(() => SelectStatusTab("FullyRedeemedCredits"))">
                <i class="bi bi-check2-all"></i>
                @LangSvc.GetText("Fully Redeemed Credits")
            </button>
        </div>

        <!-- KPI Summary Cards -->
        <div class="kpi-cards">
            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-credit-card"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@totalCredits.ToString("N0")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Credits")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-calculator"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@currentSummaryValue</div>
                    }
                    <div class="kpi-label">@GetCurrentSummaryLabel()</div>
                </div>
            </div>
        </div>

        <!-- Member Credit Balance Table with Filter Inputs -->
        <div class="member-credit-balance-table-wrapper">
            <div class="member-credit-balance-table">
                <div class="member-credit-balance-table-header">
                    <div class="member-credit-balance-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Mem Credit A/C")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="creditAcFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="member-credit-balance-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Member Type")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="memberTypeFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="member-credit-balance-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Purchase Date")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="purchaseDateFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="member-credit-balance-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Invoice No")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="invoiceFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="member-credit-balance-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Customer Name")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="customerFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="member-credit-balance-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Item Name")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="itemNameFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="member-credit-balance-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Expiry Date")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="expiryDateFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="member-credit-balance-table-header-cell filter-header">
                        <span>@LangSvc.GetText("PV Balance")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="pvFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                </div>
                <div class="filter-badge-container">
                    @if (HasActiveFilters())
                    {
                        <button class="clear-filters-btn" @onclick="ClearFilters">
                            <i class="bi bi-x-circle"></i> Clear All Filters
                        </button>
                    }
                </div>
                <div class="member-credit-balance-table-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
                            <p>Loading data...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(exportMessage))
                    {
                        <div class="alert alert-@alertType">@exportMessage</div>
                    }
                    else if (filteredCreditData.Any())
                    {
                        @foreach (var credit in filteredCreditData)
                        {
                            <div class="member-credit-balance-table-row">
                                <div class="member-credit-balance-table-cell" data-label="@LangSvc.GetText("Mem Credit A/C")">
                                    @credit.ARAPOutstandingID
                                </div>
                                <div class="member-credit-balance-table-cell" data-label="@LangSvc.GetText("Member Type")">
                                    @credit.MemberTypeID
                                </div>
                                <div class="member-credit-balance-table-cell" data-label="@LangSvc.GetText("Purchase Date")">
                                    @credit.PurchaseDate.ToString("dd/MM/yyyy")
                                </div>
                                <div class="member-credit-balance-table-cell" data-label="@LangSvc.GetText("Invoice No")">
                                    @credit.PurchaseInvoiceNo
                                </div>
                                <div class="member-credit-balance-table-cell" data-label="@LangSvc.GetText("Customer Name")">
                                    <div class="member-info">
                                        <span class="member-name">@credit.CustomerName</span>
                                    </div>
                                </div>
                                <div class="member-credit-balance-table-cell" data-label="@LangSvc.GetText("Item Name")">
                                    <div class="credit-info-cell">
                                        <div class="credit-icon">
                                            <i class="bi bi-credit-card"></i>
                                        </div>
                                        <div class="credit-details">
                                            <span class="credit-name">@credit.Description</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="member-credit-balance-table-cell" data-label="@LangSvc.GetText("Expiry Date")">
                                    <span class="expiry-date @GetExpiryDateClass(credit.ExpiryDate)">
                                        @credit.ExpiryDate.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                                <div class="member-credit-balance-table-cell" data-label="@LangSvc.GetText("PV Balance")">
                                    @credit.CreditPurchased.ToString("N0")
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>
    </div>
    @if (showAlertDialogModal)
    {
        <div class="modal-overlay" @onclick="CloseAlertDialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="appointment-modal-header">
                    <div class="appt-title">@alertDialogTitle</div>
                </div>
                <div class="modal-body">
                    <p>@alertDialogMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="appt-btn-primary" style="flex: 1;" @onclick="CloseAlertDialog">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }
</div>