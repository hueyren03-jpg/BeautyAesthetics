@page "/dashboard"
@inherits SenangRetails.Shared.Pages.BasePage
@using BlazorBootstrap
@using SenangRetails.Shared.Models
@using System.Net.Http.Json
@inject NavigationManager Navigation

<div class="dashboard-page">
    <!-- Top Bar -->
    <div class="top-bar">
        <div class="top-bar-content">
            <button class="back-button" @onclick="GoBack">
                <i class="bi bi-chevron-left"></i>
                <span>Back</span>
            </button>
            <h2>@LangSvc.GetText("Dashboard")</h2>
        </div>
    </div>

    <!-- Date Range and Quick Buttons Container - NEW -->
    <div class="date-controls-wrapper">
        <!-- Top Date Range Picker -->
        <div class="top-date-range-wrapper">
            <div class="top-date-range">
                <span>@LangSvc.GetText("Start Date")</span>
                <MobileDatePicker @bind-Value="startDate"
                                  DateFormat="dd/MM/yyyy"
                                  Placeholder="Select Date" />
                <span class="dash">-</span>
                <span>@LangSvc.GetText("End Date")</span>
                <MobileDatePicker @bind-Value="endDate"
                                  DateFormat="dd/MM/yyyy"
                                  Placeholder="Select Date" />
                <button class="refresh-btn" @onclick="RefreshData">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>

        <!-- Quick Date Range Buttons -->
        <div class="quick-date-buttons">
            <button class="quick-date-btn @(selectedDateRange == "Today" ? "active" : "")" @onclick='() => SetDateRange("Today")'>
                @LangSvc.GetText("Today")
            </button>
            <button class="quick-date-btn @(selectedDateRange == "Week" ? "active" : "")" @onclick='() => SetDateRange("Week")'>
                @LangSvc.GetText("This Week")
            </button>
            <button class="quick-date-btn @(selectedDateRange == "Month" ? "active" : "")" @onclick='() => SetDateRange("Month")'>
                @LangSvc.GetText("This Month")
            </button>
            <button class="quick-date-btn @(selectedDateRange == "Year" ? "active" : "")" @onclick='() => SetDateRange("Year")'>
                @LangSvc.GetText("This Year")
            </button>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="kpi-cards">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-graph-up"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">RM @totalSales.ToString("N2")</div>
                <div class="kpi-label">@LangSvc.GetText("TotalSales")</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-people"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">@totalVisitors</div>
                <div class="kpi-label">@LangSvc.GetText("Total Customer")</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-star"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">@topSellingItemName</div>
                <div class="kpi-sub">RM @topSellingItemSales.ToString("N2")</div>
                <div class="kpi-label">@LangSvc.GetText("Top Selling Item")</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-trophy"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">@topSellingCategory</div>
                <div class="kpi-label">@LangSvc.GetText("Top Selling Category")</div>
            </div>
        </div>
    </div>

    <!-- Main Two Column Layout -->
    <div class="dashboard-main-grid">
        <!-- Left Column -->
        <div class="dashboard-left">
            <!-- Sales Chart Card -->
            <div class="dashboard-card">
                <div class="card-header">
                    <h3>@LangSvc.GetText("Total Sales By Hour")</h3>
                </div>
                <div class="card-body">
                    <div class="sales-chart-wrapper">
                        @if (isLoadingChart)
                        {
                            <div class="loading-placeholder">
                                <div class="loading-spinner-small"></div>
                                <span>Loading hourly sales...</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="error-placeholder">@errorMessage</div>
                        }
                        else if (chartData != null)
                        {
                            <div class="chart-container" style="height: auto; width: auto;">
                                <BarChart @ref="barChart" />
                            </div>
                        }
                        else
                        {
                            <div class="empty-placeholder">No data available</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Top Selling Section -->
            <div class="dashboard-card">
                <div class="card-header">
                    <h3>@LangSvc.GetText("ReportTopSelling")</h3>
                    <div class="tab-buttons">
                        <button class="tab-btn @(selectedFormTab == "Service" ? "active" : "")"
                                @onclick="@(() => SelectFormTab("Service"))">
                            @LangSvc.GetText("ReportService")
                        </button>
                        <button class="tab-btn @(selectedFormTab == "Product" ? "active" : "")"
                                @onclick="@(() => SelectFormTab("Product"))">
                            @LangSvc.GetText("ReportProduct")
                        </button>
                        <button class="tab-btn @(selectedFormTab == "Package" ? "active" : "")"
                                @onclick="@(() => SelectFormTab("Package"))">
                            @LangSvc.GetText("ReportPackage")
                        </button>
                        <button class="tab-btn @(selectedFormTab == "Top Up" ? "active" : "")"
                                @onclick="@(() => SelectFormTab("Top Up"))">
                            @LangSvc.GetText("ReportTopUp")
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (isLoadingTopSelling)
                    {
                        <div class="loading-placeholder">
                            <div class="loading-spinner-small"></div>
                            <span>Loading top selling items...</span>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(topSellingError))
                    {
                        <div class="error-placeholder">@topSellingError</div>
                    }
                    else
                    {
                        <div class="top-selling-table">
                            <div class="table-header">
                                <div class="header-cell">@LangSvc.GetText("ReportItemName")</div>
                                <div class="header-cell text-right">@LangSvc.GetText("ReportQuantity")</div>
                                <div class="header-cell text-right">@LangSvc.GetText("ReportAmount")</div>
                            </div>
                            <div class="table-body">
                                @if (selectedFormTab == "Service")
                                {
                                    @if (serviceItems.Any())
                                    {
                                        @foreach (var item in serviceItems)
                                        {
                                            <div class="table-row">
                                                <div class="row-cell sku-cell">
                                                    <i class="bi bi-star-fill sku-icon"></i>
                                                    <span>@item.AccountName</span>
                                                </div>
                                                <div class="row-cell text-right">@item.Quantity.ToString("N0")</div>
                                                <div class="row-cell text-right amount-cell">RM @item.Sales.ToString("N2")</div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="empty-placeholder">No service sales data available</div>
                                    }
                                }
                                else if (selectedFormTab == "Product")
                                {
                                    @if (productItems.Any())
                                    {
                                        @foreach (var item in productItems)
                                        {
                                            <div class="table-row">
                                                <div class="row-cell sku-cell">
                                                    <i class="bi bi-box sku-icon"></i>
                                                    <span>@item.AccountName</span>
                                                </div>
                                                <div class="row-cell text-right">@item.Quantity.ToString("N0")</div>
                                                <div class="row-cell text-right amount-cell">RM @item.Sales.ToString("N2")</div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="empty-placeholder">No product sales data available</div>
                                    }
                                }
                                else if (selectedFormTab == "Package")
                                {
                                    @if (packageItems.Any())
                                    {
                                        @foreach (var item in packageItems)
                                        {
                                            <div class="table-row">
                                                <div class="row-cell sku-cell">
                                                    <i class="bi bi-gift sku-icon"></i>
                                                    <span>@item.AccountName</span>
                                                </div>
                                                <div class="row-cell text-right">@item.Quantity.ToString("N0")</div>
                                                <div class="row-cell text-right amount-cell">RM @item.Sales.ToString("N2")</div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="empty-placeholder">No package sales data available</div>
                                    }
                                }
                                else if (selectedFormTab == "Top Up")
                                {
                                    @if (topUpItems.Any())
                                    {
                                        @foreach (var item in topUpItems)
                                        {
                                            <div class="table-row">
                                                <div class="row-cell sku-cell">
                                                    <i class="bi bi-plus-circle sku-icon"></i>
                                                    <span>@item.AccountName</span>
                                                </div>
                                                <div class="row-cell text-right">@item.Quantity.ToString("N0")</div>
                                                <div class="row-cell text-right amount-cell">RM @item.Sales.ToString("N2")</div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="empty-placeholder">No top-up sales data available</div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="dashboard-right">
            <!-- Visitor Card -->
            <div class="dashboard-card">
                <div class="card-header">
                    <h3>@LangSvc.GetText("ReportVisitor")</h3>
                    <span class="visitor-count">@totalVisitors</span>
                </div>
                <div class="card-body p-0">
                    <div class="visitor-table">
                        <div class="visitor-header">
                            <div class="header-cell">@LangSvc.GetText("ReportName")</div>
                            <div class="header-cell text-right">@LangSvc.GetText("ReportSpent")</div>
                        </div>
                        <div class="visitor-body">
                            @if (isLoadingVisitors)
                            {
                                <div class="loading-placeholder">
                                    <div class="loading-spinner-small"></div>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(visitorsError))
                            {
                                <div class="error-placeholder">@visitorsError</div>
                            }
                            else if (visitorsList.Any())
                            {
                                @foreach (var visitor in visitorsList.Take(5))
                                {
                                    <div class="visitor-row">
                                        <div class="visitor-info">
                                            <div class="visitor-avatar">
                                                <i class="bi bi-person"></i>
                                            </div>
                                            <div class="visitor-details">
                                                <div class="visitor-name">@visitor.AccountName</div>
                                                <div class="visitor-type">@visitor.MemberType</div>
                                            </div>
                                        </div>
                                        <div class="visitor-spent">RM @visitor.TotalAfterTax.ToString("N2")</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-placeholder">No visitor data available</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Card -->
            <div class="dashboard-card">
                <div class="card-header">
                    <h3>@LangSvc.GetText("Collection")</h3>
                </div>
                <div class="card-body p-0">
                    <div class="payment-table">
                        @if (isLoadingPayment)
                        {
                            <div class="loading-placeholder">
                                <div class="loading-spinner-small"></div>
                                <span>Loading payment data...</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(paymentError))
                        {
                            <div class="error-placeholder">@paymentError</div>
                        }
                        else if (paymentSummary.Any())
                        {
                            @foreach (var item in paymentSummary)
                            {
                                <div class="payment-row">
                                    <div class="payment-method">
                                        <i class="bi bi-currency-dollar"></i>
                                        <span>@item.ReportGroup</span>
                                    </div>
                                    <div class="payment-amount">RM @item.TotalAmount.ToString("N2")</div>
                                </div>
                            }
                            <div class="payment-row total-row">
                                <div class="payment-method">
                                    <strong>Total</strong>
                                </div>
                                <div class="payment-amount">
                                    <strong>RM @paymentSummary.Sum(x => x.TotalAmount).ToString("N2")</strong>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-placeholder">No payment data available</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (showAlertDialogModal)
    {
        <div class="modal-overlay" @onclick="CloseAlertDialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="appointment-modal-header">
                    <div class="appt-title">@alertDialogTitle</div>
                </div>
                <div class="modal-body">
                    <p>@alertDialogMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="appt-btn-primary" style="flex: 1;" @onclick="CloseAlertDialog">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }
</div>