@page "/incoming-stock-transfer"
@inherits SenangRetails.Shared.Pages.BasePage
@inject NavigationManager NavigationManager
@inject AppState AppState
@using SenangRetails.Shared.Services.InventoryService
@inject IInventoryService InventoryService
@using SenangRetails.Shared.Components.Common
@using SenangRetails.Shared.Components.Inventory
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Services.BranchService
@inject IBranchService BranchService

<div class="view-body">
    <div class="header">
        <div class="mobile-menu-btn" @onclick="ToggleNav">
            <i class="bi bi-list"></i>
        </div>
        <div class="header-title">Incoming Stock Transfer</div>
        <div class="top-right-button">
            <i class="fa-solid fa-plus" @onclick="OpenAddTransfer" style="cursor: pointer; color: var(--primary-darker); font-size: 18px;"></i>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="quick-summary-card">
        <div class="card">
            <span class="card-title">Total Transfers</span>
            <span class="card-value">@TotalTransfers</span>
        </div>
        <div class="card">
            <span class="card-title">Total Distinct Items</span>
            <span class="card-value">@TotalItems Count</span>
        </div>
        <div class="card">
            <span class="card-title">Total Quantity</span>
            <span class="card-value">@TotalQuantity Units</span>
        </div>
    </div>

    <!-- Action Toolbar -->
    <div class="tool-bar">
        <div class="search-bar">
            <i class="bi bi-search"></i>
            <input class="search-stock-balance" type="text" placeholder="Search Transfers..." @bind="searchQuery" @bind:event="oninput" />
        </div>

        <div @onclick="OpenDateRange" class="date-range-button">
            <span><i class="bi bi-calendar3"></i> @SelectedDateRange</span>
            @if (dateRangeIsOpen)
            {
                <div @onclick="CloseDateRange" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color"></div>
                <div class="dropdown-menu-simple">
                    <span @onclick='() => SelectDateRange("Today")' @onclick:stopPropagation="true">Today</span>
                    <span @onclick='() => SelectDateRange("Yesterday")' @onclick:stopPropagation="true">Yesterday</span>
                    <span @onclick='() => SelectDateRange("This Month")' @onclick:stopPropagation="true">This Month</span>
                    <span @onclick='() => SelectDateRange("Last Month")' @onclick:stopPropagation="true">Last Month</span>
                    <span @onclick='() => SelectDateRange("All Time")' @onclick:stopPropagation="true">All Time</span>
                </div>
            }
        </div>

        <div class="download-wrapper">
            <div class="filter-button cursor-pointer" @onclick="ExportData">
                <span><i class="bi bi-file-earmark-arrow-down"></i></span>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="stock-movement-table custom-shadow-sm">
        <div class="Transfer-table-row border-bottom">
            <span class="text-align-left sortable" @onclick="ToggleSort">
                Doc No. <i class="bi bi-arrow-@(isSortAscending ? "up" : "down")"></i>
            </span>
            <span class="text-align-left">To Branch</span>
            <span class="text-align-left">From Branch</span>
            <span class="text-align-right">Qty / Items</span>
        </div>

        @foreach (var transfer in FilteredTransfers)
        {
            <div class="Transfer-table-row cursor-pointer" @onclick="() => OpenTransferDetails(transfer)">
                <div class="table-card-content-row">
                    <span class="table-item-name text-align-left">@transfer.DocNo</span>
                    <span class="text-align-left muted-text">@transfer.Date.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="table-card-content-row">
                    <span class="table-item-name text-align-left">@transfer.Branch</span>
                    <span class="text-align-left muted-text">Destination</span>
                </div>
                <div class="table-card-content-row">
                    <span class="table-item-name text-align-left">@transfer.FromBranch</span>
                    <span class="text-align-left muted-text">Origin</span>
                </div>
                <div class="table-card-content-row text-align-right">
                    <span class="table-item-name text-align-right">@transfer.TotalQty Units</span>
                    <span class="text-align-right muted-text">@transfer.DistinctItemsCount Items</span>
                </div>
            </div>
        }
    </div>
</div>

<!-- CREATE/EDIT TRANSFER OVERLAY -->
@if (addTransferIsOpen)
{
    <div class="full-screen-modal">
        <div class="header">
            <div @onclick="CloseAddTransfer" style="cursor: pointer;">
                <i class="bi bi-x-lg" style="font-size: 24px;"></i>
            </div>
            <div class="header-title">@(isEditing ? "Edit" : "Create") Stock Transfer</div>
            <div style="width: 24px;"></div>
        </div>

        <div style="flex: 1; min-height: 0; overflow-y: auto; padding: 20px 0; display: flex; flex-direction: column; gap: 20px;">
            <div class="form-card custom-shadow-sm">
                <!-- Target Branch Selection -->
                <div class="form-row border-bottom" @onclick='() => OpenBranchSelectModal("to")'>
                    <div class="left-icon-label">
                        <i class="bi bi-building-down purple-icon"></i>
                        <span>To Branch</span>
                    </div>
                    <div class="right-selection">
                        <span class="@(string.IsNullOrEmpty(selectedToBranch) ? "placeholder-text" : "")">
                            @(string.IsNullOrEmpty(selectedToBranch) ? "Select Destination Branch" : selectedToBranch)
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>

                <!-- From Branch Selection -->
                <div class="form-row border-bottom" @onclick='() => OpenBranchSelectModal("from")'>
                    <div class="left-icon-label">
                        <i class="bi bi-building-up purple-icon"></i>
                        <span>From Branch</span>
                    </div>
                    <div class="right-selection">
                        <span class="@(string.IsNullOrEmpty(selectedFromBranch) ? "placeholder-text" : "")">
                            @(string.IsNullOrEmpty(selectedFromBranch) ? "Select Origin Branch" : selectedFromBranch)
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>

                <!-- Doc No Input -->
                <div class="form-row border-bottom">
                    <div class="left-icon-label">
                        <i class="bi bi-file-earmark-text purple-icon"></i>
                        <span>Doc No</span>
                    </div>
                    <div class="right-selection" style="width: 50%;">
                        <input type="text" class="custom-input" placeholder="Doc No" @bind="selectedDocNo" style="border: none; text-align: right; outline: none; width: 100%; font-size: 14px; font-weight: 500;" />
                    </div>
                </div>

                <!-- Date Selection -->
                <div class="form-row border-bottom" @onclick="OpenDateModal">
                    <div class="left-icon-label">
                        <i class="bi bi-calendar3 purple-icon"></i>
                        <span>Date</span>
                    </div>
                    <div class="right-selection">
                        <span class="@(transferDate == null ? "placeholder-text" : "")">
                            @(transferDate == null ? "Not Set" : transferDate.Value.ToString("dd/MM/yyyy"))
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>

                <!-- Remarks -->
                <div class="form-row">
                    <div class="left-icon-label">
                        <i class="bi bi-chat-text purple-icon"></i>
                        <span>Remarks</span>
                    </div>
                    <div class="right-selection" style="width: 60%;">
                        <input type="text" class="custom-input" placeholder="Enter remarks..." @bind="selectedRemarks" style="border: none; text-align: right; outline: none; width: 100%; font-size: 14px; font-weight: 500;" />
                    </div>
                </div>
            </div>

            <!-- Product Section -->
            <div class="product-section-card custom-shadow-sm">
                <div class="add-product-row" @onclick="OpenAddProductModal">
                    <div class="left-icon-label">
                        <i class="bi bi-box-seam purple-icon"></i>
                        <span class="text-blue font-bold">Add Product</span>
                    </div>
                    <i class="bi bi-chevron-right"></i>
                </div>
            </div>

            @if (addedProducts.Any())
            {
                <div class="stock-balance-table custom-shadow-sm">
                    <div class="added-product-grid-header">
                        <span>Product</span>
                        <span class="text-align-center">Matrix</span>
                        <span class="text-align-center">Quantity</span>
                        <span class="text-align-center">Action</span>
                    </div>
                    @foreach (var prod in addedProducts)
                    {
                        <div class="added-product-grid-row">
                            <div class="stock-in-details">
                                <span class="stock-in-title">@prod.ItemName</span>
                                <span class="stock-in-subtitle">Code: @prod.ItemCode</span>
                            </div>
                            <div class="text-align-center">
                                <span class="number-button compact-number-btn" @onclick="() => EditProductDetails(prod)">
                                    @(string.IsNullOrEmpty(prod.Matrix) ? "Specify Matrix" : prod.Matrix)
                                </span>
                            </div>
                            <div class="text-align-center">
                                <span class="number-button compact-number-btn" @onclick="() => EditProductQty(prod)">@prod.Qty</span>
                            </div>
                            <div class="text-align-center">
                                <button class="btn-delete" @onclick="() => RemoveProduct(prod)"><i class="bi bi-trash-fill"></i></button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="bottom-action-bar">
            <button class="confirm-btn @(IsSaveDisabled ? "disabled" : "")" disabled="@IsSaveDisabled" @onclick="SaveTransfer">
                Save
            </button>
        </div>
    </div>
}

<div class="transaction-modal-root">
    <!-- SELECT BRANCH MODAL (TO/FROM) -->
    <SlideModal IsOpen="@branchModalIsOpen" CssClass="supplier-details-modal" ZIndexBackdrop="4000" ZIndexModal="4001" OnClose="CloseBranchSelectModal">
        <div class="header">
            <div @onclick="CloseBranchSelectModal" style="cursor: pointer;">
                <i class="bi bi-x-lg"></i>
            </div>
            <div class="header-title">Select @(branchSelectContext == "to" ? "Destination" : "Origin") Branch</div>
            <div style="width: 24px;"></div>
        </div>
        <div class="tool-bar" style="padding: 10px 0;">
            <div class="search-bar" style="width: 100%;">
                <i class="bi bi-search"></i>
                <input class="search-stock-balance" style="width: 100%;" type="text" placeholder="Search branches..." @bind="branchSearchQuery" @bind:event="oninput" />
            </div>
        </div>
        <div style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 10px;">
            @foreach (var branchName in FilteredBranches)
            {
                <div class="option-card custom-shadow-sm cursor-pointer" @onclick="() => SelectBranch(branchName)" style="padding: 15px; background: white; border-radius: 8px; border: 1px solid var(--border); display: flex; flex-direction: column;">
                    <span style="font-weight: bold; color: #333;">@branchName</span>
                    <span style="color: #888; font-size: 0.8em;">Available Branch</span>
                </div>
            }
        </div>
    </SlideModal>

    <!-- TRANSFER DATE MODAL -->
    <SlideModal IsOpen="@dateModalIsOpen" CssClass="supplier-details-modal" ZIndexBackdrop="4000" ZIndexModal="4001" OnClose="CloseDateModal">
        <div class="header">
            <div @onclick="CloseDateModal" style="cursor: pointer;">
                <i class="bi bi-x-lg"></i>
            </div>
            <div class="header-title">Transfer Date</div>
            <div style="width: 24px;"></div>
        </div>
        <div class="details-form-container">
            <div class="form-group">
                <label>Select Date</label>
                <MobileDatePicker @bind-Value="tempTransferDate"
                                  DateFormat="dd/MM/yyyy"
                                  Placeholder="Select Date" />
            </div>
        </div>
        <button class="confirm-btn" @onclick="SaveDate" style="margin-top: 15px;">
            Save
        </button>
    </SlideModal>

    <!-- ADD PRODUCT FULL SCREEN MODAL -->
    <InventoryAddProductModal IsOpen="@addProductModalIsOpen"
                               Title="Add Product"
                               OnClose="CloseAddProductModal"
                               OnProductSelected="HandleProductSelected" />

    <!-- ADDED PRODUCT DETAILS ENTRY MODAL -->
    <SlideModal IsOpen="@productDetailsModalIsOpen" CssClass="supplier-details-modal" ZIndexBackdrop="6000" ZIndexModal="6001" OnClose="CloseProductDetailsModal">
        <div class="header">
            <div @onclick="CloseProductDetailsModal" style="cursor: pointer;">
                <i class="bi bi-x-lg"></i>
            </div>
            <div class="header-title">Item Details</div>
            <div style="width: 24px;"></div>
        </div>
        <div class="details-form-container">
            <div class="form-group">
                <label>Product</label>
                <input type="text" class="custom-input" value="@editingProductName" readonly />
            </div>
            <div class="form-group">
                <label>Item Code</label>
                <input type="text" class="custom-input" value="@editingProductCode" readonly />
            </div>
            <div class="form-group">
                <label>Matrix (Batch/Size/Color)</label>
                <input type="text" class="custom-input" placeholder="e.g. Size: L, Color: White" @bind="editingProductMatrix" style="padding-left: 10px;" />
            </div>
            <div class="form-group">
                <label>Quantity</label>
                <div class="input-wrapper" @onclick="OpenQuantityCalculator" style="cursor: pointer;">
                    <input type="number" class="custom-input" value="@editingProductQuantity" readonly style="padding-left: 10px;" />
                </div>
            </div>
        </div>
        <button class="confirm-btn" @onclick="ConfirmProductDetails" style="margin-top: 15px;">
            Confirm &amp; Add
        </button>
    </SlideModal>

    <!-- QUANTITY CALCULATOR -->
    <Calculator IsOpen="@quantityCalculatorIsOpen"
                Title="Quantity"
                InitialValue="@editingProductQuantity"
                OnSave="HandleQuantitySave"
                OnClose="CloseQuantityCalculator" />
</div>

@code {
    [Parameter]
    public EventCallback OnToggleNav { get; set; }

    private bool isNavOpen = true;
    private string searchQuery = "";
    private bool dateRangeIsOpen = false;
    private string SelectedDateRange = "All Time";
    private bool isSortAscending = false;

    // Overlay form states
    private bool addTransferIsOpen = false;
    private bool isEditing = false;
    private string selectedToBranch = "";
    private string selectedFromBranch = "";
    private string selectedDocNo = "";
    private DateTime? transferDate = null;
    private string selectedRemarks = "";
    private List<StockTransferDetailModel> addedProducts = new();
    private StockTransferModel? editingTransferRef = null;

    // Branch Select modals
    private bool branchModalIsOpen = false;
    private string branchSelectContext = ""; // "to" or "from"
    private string branchSearchQuery = "";

    // Date Modal
    private bool dateModalIsOpen = false;
    private DateTime tempTransferDate = DateTime.Today;

    // Product Modals
    private bool addProductModalIsOpen = false;
    private bool productDetailsModalIsOpen = false;
    private string editingProductName = "";
    private string editingProductCode = "";
    private string editingProductMatrix = "";
    private int editingProductQuantity = 1;
    private bool quantityCalculatorIsOpen = false;
    private bool isEditingProductItem = false;
    private StockTransferDetailModel? editingProductItemRef = null;

    // Static branches list (populated with actual branches if loaded, or defaults)
    private List<string> Branches = new()
    {
        "Headquarters", "Cheras Branch", "Puchong Branch", "Kuching Branch", "Miri Branch"
    };

    // Static Transfers mock storage so they persist while using the app
    public static List<StockTransferModel> StockTransfers = new()
    {
        new StockTransferModel
        {
            DocNo = "TRF-00000001",
            Branch = "Cheras Branch",
            FromBranch = "Headquarters",
            Date = new DateTime(2026, 6, 25),
            Remarks = "Weekly replenishment of items",
            Items = new List<StockTransferDetailModel>
            {
                new StockTransferDetailModel { DocNo = "TRF-00000001", ItemCode = "PROD-001", ItemName = "Eco Water Bottle", Matrix = "Color: Blue, Size: 500ml", Qty = 15 },
                new StockTransferDetailModel { DocNo = "TRF-00000001", ItemCode = "PROD-002", ItemName = "Wireless Mouse", Matrix = "Color: Black", Qty = 10 }
            }
        },
        new StockTransferModel
        {
            DocNo = "TRF-00000002",
            Branch = "Puchong Branch",
            FromBranch = "Cheras Branch",
            Date = new DateTime(2026, 6, 28),
            Remarks = "Urgent stock redistribution",
            Items = new List<StockTransferDetailModel>
            {
                new StockTransferDetailModel { DocNo = "TRF-00000002", ItemCode = "PROD-003", ItemName = "Ceramic Mug", Matrix = "Design: Floral", Qty = 25 }
            }
        }
    };

    private int TotalTransfers => FilteredTransfers.Count;
    private int TotalItems => FilteredTransfers.Sum(t => t.DistinctItemsCount);
    private int TotalQuantity => FilteredTransfers.Sum(t => t.TotalQty);

    private List<string> FilteredBranches => string.IsNullOrWhiteSpace(branchSearchQuery)
        ? Branches
        : Branches.Where(b => b.Contains(branchSearchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<StockTransferModel> FilteredTransfers
    {
        get
        {
            var list = StockTransfers;

            // Search Filter
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                list = list.Where(t => t.DocNo.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                       t.Branch.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                       t.FromBranch.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                       t.Remarks.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            // Date Range Filter
            if (SelectedDateRange == "Today")
            {
                list = list.Where(t => t.Date.Date == DateTime.Today).ToList();
            }
            else if (SelectedDateRange == "Yesterday")
            {
                list = list.Where(t => t.Date.Date == DateTime.Today.AddDays(-1)).ToList();
            }
            else if (SelectedDateRange == "This Month")
            {
                list = list.Where(t => t.Date.Month == DateTime.Today.Month && t.Date.Year == DateTime.Today.Year).ToList();
            }
            else if (SelectedDateRange == "Last Month")
            {
                var lm = DateTime.Today.AddMonths(-1);
                list = list.Where(t => t.Date.Month == lm.Month && t.Date.Year == lm.Year).ToList();
            }

            // Sort
            if (isSortAscending)
            {
                list = list.OrderBy(t => t.DocNo).ToList();
            }
            else
            {
                list = list.OrderByDescending(t => t.DocNo).ToList();
            }

            return list;
        }
    }

    private bool IsSaveDisabled => string.IsNullOrWhiteSpace(selectedToBranch) ||
                                   string.IsNullOrWhiteSpace(selectedFromBranch) ||
                                   string.IsNullOrWhiteSpace(selectedDocNo) ||
                                   transferDate == null ||
                                   !addedProducts.Any() ||
                                   selectedToBranch == selectedFromBranch;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Load branches dynamically from application state
        if (AppState.AvailableBranches != null && AppState.AvailableBranches.Any())
        {
            var branchList = new List<string>();
            foreach (var bId in AppState.AvailableBranches)
            {
                var (details, _) = await BranchService.GetBranchDetailsAsync(bId);
                if (details != null && !string.IsNullOrWhiteSpace(details.Branch))
                {
                    branchList.Add(details.Branch);
                }
            }
            if (branchList.Any())
            {
                Branches = branchList;
            }
        }
    }

    private async Task ToggleNav()
    {
        if (OnToggleNav.HasDelegate)
            await OnToggleNav.InvokeAsync();
        else
            isNavOpen = !isNavOpen;
    }

    private void OpenDateRange() => dateRangeIsOpen = true;
    private void CloseDateRange() => dateRangeIsOpen = false;
    private void SelectDateRange(string range)
    {
        SelectedDateRange = range;
        dateRangeIsOpen = false;
    }

    private void ToggleSort() => isSortAscending = !isSortAscending;

    private void OpenAddTransfer()
    {
        isEditing = false;
        selectedToBranch = AppState.CurrentBranch?.Branch ?? "";
        selectedFromBranch = "";
        selectedDocNo = "TRF-" + DateTime.Now.ToString("yyyyMMdd") + "-" + (StockTransfers.Count + 1).ToString("D3");
        transferDate = DateTime.Today;
        selectedRemarks = "";
        addedProducts.Clear();
        editingTransferRef = null;
        addTransferIsOpen = true;
    }

    private void CloseAddTransfer() => addTransferIsOpen = false;

    private void OpenBranchSelectModal(string context)
    {
        branchSelectContext = context;
        branchSearchQuery = "";
        branchModalIsOpen = true;
    }

    private void CloseBranchSelectModal() => branchModalIsOpen = false;

    private void SelectBranch(string branchName)
    {
        if (branchSelectContext == "to")
            selectedToBranch = branchName;
        else if (branchSelectContext == "from")
            selectedFromBranch = branchName;

        branchModalIsOpen = false;
    }

    private void OpenDateModal()
    {
        tempTransferDate = transferDate ?? DateTime.Today;
        dateModalIsOpen = true;
    }

    private void CloseDateModal() => dateModalIsOpen = false;
    private void SaveDate()
    {
        transferDate = tempTransferDate;
        dateModalIsOpen = false;
    }

    private void OpenAddProductModal() => addProductModalIsOpen = true;
    private void CloseAddProductModal() => addProductModalIsOpen = false;

    private async Task HandleProductSelected(string masterAccountId)
    {
        addProductModalIsOpen = false;
        isEditingProductItem = false;

        var product = await InventoryService.LoadItemAsync(masterAccountId);
        if (product != null)
        {
            editingProductName = product.AccountName ?? "Unknown Product";
            editingProductCode = product.DisplayCode ?? product.ProductCode ?? product.AlphaCode ?? "N/A";
            editingProductMatrix = "";
            editingProductQuantity = 1;
            productDetailsModalIsOpen = true;
        }
    }

    private void CloseProductDetailsModal() => productDetailsModalIsOpen = false;

    private void ConfirmProductDetails()
    {
        if (isEditingProductItem && editingProductItemRef != null)
        {
            editingProductItemRef.Matrix = editingProductMatrix;
            editingProductItemRef.Qty = editingProductQuantity;
        }
        else
        {
            addedProducts.Add(new StockTransferDetailModel
            {
                DocNo = selectedDocNo,
                ItemCode = editingProductCode,
                ItemName = editingProductName,
                Matrix = editingProductMatrix,
                Qty = editingProductQuantity
            });
        }
        productDetailsModalIsOpen = false;
    }

    private void OpenQuantityCalculator() => quantityCalculatorIsOpen = true;
    private void CloseQuantityCalculator() => quantityCalculatorIsOpen = false;
    private void HandleQuantitySave(double value)
    {
        editingProductQuantity = (int)value;
        quantityCalculatorIsOpen = false;
    }

    private void EditProductQty(StockTransferDetailModel prod)
    {
        isEditingProductItem = true;
        editingProductItemRef = prod;
        editingProductName = prod.ItemName;
        editingProductCode = prod.ItemCode;
        editingProductMatrix = prod.Matrix;
        editingProductQuantity = prod.Qty;
        quantityCalculatorIsOpen = true;
    }

    private void EditProductDetails(StockTransferDetailModel prod)
    {
        isEditingProductItem = true;
        editingProductItemRef = prod;
        editingProductName = prod.ItemName;
        editingProductCode = prod.ItemCode;
        editingProductMatrix = prod.Matrix;
        editingProductQuantity = prod.Qty;
        productDetailsModalIsOpen = true;
    }

    private void RemoveProduct(StockTransferDetailModel prod)
    {
        addedProducts.Remove(prod);
    }

    private void SaveTransfer()
    {
        if (IsSaveDisabled) return;

        if (isEditing && editingTransferRef != null)
        {
            editingTransferRef.Branch = selectedToBranch;
            editingTransferRef.FromBranch = selectedFromBranch;
            editingTransferRef.DocNo = selectedDocNo;
            editingTransferRef.Date = transferDate ?? DateTime.Today;
            editingTransferRef.Remarks = selectedRemarks;
            editingTransferRef.Items = addedProducts;
        }
        else
        {
            StockTransfers.Add(new StockTransferModel
            {
                DocNo = selectedDocNo,
                Branch = selectedToBranch,
                FromBranch = selectedFromBranch,
                Date = transferDate ?? DateTime.Today,
                Remarks = selectedRemarks,
                Items = addedProducts.Select(p => new StockTransferDetailModel
                {
                    DocNo = selectedDocNo,
                    ItemCode = p.ItemCode,
                    ItemName = p.ItemName,
                    Matrix = p.Matrix,
                    Qty = p.Qty
                }).ToList()
            });
        }

        addTransferIsOpen = false;
    }

    private void OpenTransferDetails(StockTransferModel transfer)
    {
        NavigationManager.NavigateTo($"/incoming-stock-details/{transfer.DocNo}");
    }

    private void ExportData()
    {
        Console.WriteLine("Exporting transfer data...");
    }
}
