@page "/passwordsetting"
@inherits SenangRetails.Shared.Pages.BasePage
@using Microsoft.AspNetCore.Components.Forms
@using SenangRetails.Shared.Services.AccountService
@using SenangRetails.Shared.Services.NotificationService
@using SenangRetails.Shared.Models
@inject IAccountService AccountService
@inject INotificationService NotificationSvc
@inject IJSRuntime JS

<div class="section-container">
    <div class="section-header">
        @if (showUpdatePassword == false)
        {
            <h2>Password</h2>
        }
        else if (showUpdatePassword)
        {
            <h2>Update Password</h2>
        }
    </div>
    @if (showUpdatePassword)
    {
        <p class="description">Change your account password for security</p>
    }
    @if (!showUpdatePassword)
    {
        <div class="password-actions">
            <button class="action-card" @onclick="ShowUpdatePasswordForm">
                <div class="action-icon"><i class="bi bi-key"></i></div>
                <div class="action-content">
                    <h3>Update Password</h3>
                    <p>@LangSvc.GetText("PasswordUpdateDesc")</p>
                </div>
                <div class="action-arrow"><i class="bi bi-chevron-right"></i></div>
            </button>

            @*  <button class="action-card logout-card" @onclick="LogoutAllDevices">faction-content
                <div class="action-icon">🚪</div>
                <div class="action-content">
                    <h3>Log Out All Devices</h3>
                    <p>Sign out from all active sessions</p>
                </div>
                <div class="action-arrow">→</div>
            </button> *@
        </div>
    }
    else
    {
        <div class="update-password-form">
            @* <div class="form-header">
                <button class="back-btn" @onclick="BackToActions">
                    ←
                </button>
                <h3>@LangSvc.GetText("PasswordUpdateTitle")</h3>
                
                
                
            </div> *@

            <div class="form-content">
                <!-- Current Password -->
                <div class="form-group">
                    <label class="form-label">@LangSvc.GetText("PasswordCurrentLabel")</label>
                    <div class="password-input-wrapper">
                        <input type="@(showCurrentPassword ? "text" : "password")"
                               class="form-control"
                               @bind="currentPassword"
                               placeholder="@LangSvc.GetText("PasswordCurrentPlaceholder")" />
                        <button class="toggle-password" @onclick="() => showCurrentPassword = !showCurrentPassword">
                            <i class="bi @(showCurrentPassword ? "bi-eye" : "bi-eye-slash")"></i>
                        </button>
                    </div>
                </div>

                <!-- New Password -->
                <div class="form-group">
                    <label class="form-label">@LangSvc.GetText("PasswordNewLabel")</label>
                    <div class="password-input-wrapper">
                        <input type="@(showNewPassword ? "text" : "password")"
                               class="form-control"
                               value="@newPassword"
                               @oninput="@(e => { newPassword = e.Value?.ToString() ?? ""; ValidatePassword(); })"
                               placeholder="@LangSvc.GetText("PasswordNewPlaceholder")" />
                        <button class="toggle-password" @onclick="() => showNewPassword = !showNewPassword">
                            <i class="bi @(showNewPassword ? "bi-eye" : "bi-eye-slash")"></i>
                        </button>
                    </div>

                    <!-- Password Requirements -->
                    <div class="password-requirements">
                        <p class="requirements-title">@LangSvc.GetText("PasswordRequirementsTitle")</p>
                        <ul class="requirements-list">
                            <li class="@(GetRequirementClass("length"))">
                                <span class="requirement-icon">✓</span>
                                @LangSvc.GetText("PasswordReqMin8")
                            </li>
                            <li class="@(GetRequirementClass("uppercase"))">
                                <span class="requirement-icon">✓</span>
                                @LangSvc.GetText("PasswordReqUppercase")
                            </li>
                            <li class="@(GetRequirementClass("lowercase"))">
                                <span class="requirement-icon">✓</span>
                                @LangSvc.GetText("PasswordReqLowercase")
                            </li>
                            <li class="@(GetRequirementClass("number"))">
                                <span class="requirement-icon">✓</span>
                                @LangSvc.GetText("PasswordReqNumber")
                            </li>
                            <li class="@(GetRequirementClass("special"))">
                                <span class="requirement-icon">✓</span>
                                @LangSvc.GetText("PasswordReqSpecial")
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="form-group">
                    <label class="form-label">@LangSvc.GetText("PasswordConfirmLabel")</label>
                    <div class="password-input-wrapper">
                        <input type="@(showConfirmPassword ? "text" : "password")"
                               class="form-control @(GetConfirmPasswordClass())"
                               value="@confirmPassword"
                               @oninput="@(e => { confirmPassword = e.Value?.ToString() ?? ""; CheckPasswordMatch(); })"
                               placeholder="@LangSvc.GetText("PasswordConfirmPlaceholder")" />
                        <button class="toggle-password" @onclick="() => showConfirmPassword = !showConfirmPassword">
                            <i class="bi @(showConfirmPassword ? "bi-eye" : "bi-eye-slash")"></i>
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(confirmPassword) && !passwordsMatch)
                    {
                        <p class="error-message">@LangSvc.GetText("PasswordNoMatch")</p>
                    }
                    @if (!string.IsNullOrEmpty(confirmPassword) && passwordsMatch)
                    {
                        <p class="success-message">@LangSvc.GetText("PasswordMatch")</p>
                    }
                </div>
                <div class="save-button-group">
                    <button class="save-btn" @onclick="SavePassword" disabled="@isSaving">
                        @(isSaving ? "..." : LangSvc.GetText("Save"))
                    </button>
                </div>

                
                @if (!string.IsNullOrEmpty(saveMessage) && !saveSuccess)
                {
                    <p class="error-message">@saveMessage</p>
                }
            </div>
        </div>
    }
</div>

<!-- Password Change Success Modal -->
@if (showSuccessModal)
{
    <div class="modal-overlay">
        <div class="modal-container success-modal">
            <div class="success-modal-icon">✅</div>
            <h3>@LangSvc.GetText("PasswordChangeSuccessTitle")</h3>
            <p>@LangSvc.GetText("PasswordChangeSuccess")</p>
            <button class="save-btn success-ok-btn" @onclick="CloseSuccessModal">
                @LangSvc.GetText("ProductOK")
            </button>
        </div>
    </div>
}

<!-- Logout Confirmation Modal -->
@if (showLogoutModal)
{
    <div class="modal-overlay" @onclick="CloseLogoutModal">
        <div class="modal-container logout-modal" @onclick:stopPropagation>
            <div class="modal-icon">⚠️</div>
            <h3>Log Out All Devices?</h3>
            <p>This will sign you out from all active sessions. You'll need to log in again on all devices.</p>

            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="CloseLogoutModal">
                    Cancel
                </button>
                <button class="btn btn-danger" @onclick="ConfirmLogout">
                    Log Out All Devices
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool showUpdatePassword = false;
    private bool showLogoutModal = false;
    private bool showSuccessModal = false;

    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";

    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;

    private bool hasMinLength = false;
    private bool hasUppercase = false;
    private bool hasLowercase = false;
    private bool hasNumber = false;
    private bool hasSpecial = false;
    private bool passwordsMatch = false;

    private bool isSaving = false;
    private string saveMessage = "";
    private bool saveSuccess = false;

    private void ShowUpdatePasswordForm()
    {
        showUpdatePassword = true;
    }

    private void BackToActions()
    {
        showUpdatePassword = false;
        ResetForm();
    }

    private void ResetForm()
    {
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
        showCurrentPassword = false;
        showNewPassword = false;
        showConfirmPassword = false;
        hasMinLength = false;
        hasUppercase = false;
        hasLowercase = false;
        hasNumber = false;
        hasSpecial = false;
        passwordsMatch = false;
        saveMessage = "";
        saveSuccess = false;
    }

    private void ValidatePassword()
    {
        hasMinLength = newPassword.Length >= 8;
        hasUppercase = newPassword.Any(char.IsUpper);
        hasLowercase = newPassword.Any(char.IsLower);
        hasNumber = newPassword.Any(char.IsDigit);
        hasSpecial = newPassword.Any(c => "!@#$%^&*()_+-=[]{}|;:,.<>?".Contains(c));

        CheckPasswordMatch();
    }

    private void CheckPasswordMatch()
    {
        passwordsMatch = !string.IsNullOrEmpty(confirmPassword) && newPassword == confirmPassword;
    }

    private string GetRequirementClass(string requirement)
    {
        bool isValid = requirement switch
        {
            "length" => hasMinLength,
            "uppercase" => hasUppercase,
            "lowercase" => hasLowercase,
            "number" => hasNumber,
            "special" => hasSpecial,
            _ => false
        };

        return isValid ? "valid" : "";
    }



    private string GetConfirmPasswordClass()
    {
        if (string.IsNullOrEmpty(confirmPassword)) return "";
        return passwordsMatch ? "valid" : "invalid";
    }

    private bool IsPasswordValid()
    {
        return hasMinLength && hasUppercase && hasLowercase && hasNumber && hasSpecial && passwordsMatch;
    }

    private async Task SavePassword()
    {
        saveMessage = "";
        saveSuccess = false;

        if (string.IsNullOrEmpty(currentPassword))
        {
            saveMessage = LangSvc.GetText("PasswordCurrentRequired");
            return;
        }

        if (string.IsNullOrEmpty(newPassword))
        {
            saveMessage = LangSvc.GetText("PasswordNewRequired");
            return;
        }

        if (!hasMinLength)
        {
            saveMessage = LangSvc.GetText("PasswordReqMin8");
            return;
        }

        if (!hasUppercase)
        {
            saveMessage = LangSvc.GetText("PasswordReqUppercase");
            return;
        }

        if (!hasLowercase)
        {
            saveMessage = LangSvc.GetText("PasswordReqLowercase");
            return;
        }

        if (!hasNumber)
        {
            saveMessage = LangSvc.GetText("PasswordReqNumber");
            return;
        }

        if (!hasSpecial)
        {
            saveMessage = LangSvc.GetText("PasswordReqSpecial");
            return;
        }

        if (!passwordsMatch)
        {
            saveMessage = LangSvc.GetText("PasswordNoMatch");
            return;
        }

        isSaving = true;
        StateHasChanged();

        var (success, message) = await AccountService.ChangePasswordAsync(currentPassword, newPassword, confirmPassword);

        isSaving = false;
        saveSuccess = success;
        if (!success)
        {
            // All requirements are validated client-side before this call, so a failure means wrong current password.
            saveMessage = LangSvc.GetText("PasswordCurrentIncorrect");
        }

        if (success)
        {
            NotificationSvc.Add(new AppNotification
            {
                Icon = "🔑",
                TitleKey = "NotifPasswordChangedTitle",
                MessageKey = "NotifPasswordChangedMsg"
            });
            await JS.InvokeVoidAsync("localStorage.setItem", "app_notifications", NotificationSvc.ToJson());

            showSuccessModal = true;
        }
    }

    private void CloseSuccessModal()
    {
        showSuccessModal = false;
        showUpdatePassword = false;
        ResetForm();
    }

    private void LogoutAllDevices()
    {
        showLogoutModal = true;
    }

    private void CloseLogoutModal()
    {
        showLogoutModal = false;
    }

    private void ConfirmLogout()
    {
        CloseLogoutModal();
    }
}

