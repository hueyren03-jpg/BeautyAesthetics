@page "/home"
@using SenangRetails.Shared.Services
@using SenangRetails.Shared.Services.AuthService
@using SenangRetails.Shared.Services.DashboardService
@using SenangRetails.Shared.Services.NotificationService
@using SenangRetails.Shared.Services.BluetoothPrinterService
@using SenangRetails.Shared.Models
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Entities
@using static SenangRetails.Shared.Components.Reports.PackageBalanceReport
@using static SenangRetails.Shared.Components.Reports.MemberCreditBalanceReport
@inherits SenangRetails.Shared.Pages.BasePage
@inject NavigationManager NavigationManager
@inject WorkspaceService WorkspaceSvc
@inject IStoreTokenService StoreTokenService
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IDashboardService DashboardSvc
@inject INotificationService NotificationSvc
@inject AppState AppState
@inject IBluetoothPrinterService BluetoothSvc
@inject IReportService ReportService
@inject StaffService StaffService
@implements IDisposable

<div class="home-content">

    <!-- TOP BAR -->
    <div class="topbar">
        <div class="brand" @onclick="ShowOperation">
            <div class="brand-logo">
                @if (!string.IsNullOrEmpty(AppState.CurrentBranch?.LogoPath))
                {
                    <img src="@AppState.CurrentBranch.LogoPath" alt="Logo" style="width:100%;height:100%;object-fit:contain;" />
                }
                else
                {
                    <i class="fa-regular fa-image"></i>
                }
            </div>
            <div class="brand-text">
                <div class="brand-name">@CompanyName</div>
                <div class="brand-sub">@GetText("Branch"): @BranchName</div>
            </div>
        </div>

        <div class="top-actions">
            <button class="op-btn" @onclick="ShowOperation">
                <i class="fa-solid fa-sliders"></i>
                @GetText("Operation")
                <i class="fa-solid fa-chevron-down"></i>
            </button>

            @* <button class="workspace-btn" @onclick="ToggleWorkspace">
                <i class="fa-solid fa-th-large"></i>
                @GetText("CustomizeWorkspace")
            </button> *@

            <div class="notif" @onclick="ToggleNotifications">
                <i class="fa-solid fa-bell"></i>
                @if (UnreadNotificationCount > 0)
                {
                    <span class="badge">@UnreadNotificationCount</span>
                }
            </div>
        </div>
    </div>

    <!-- NOTIFICATION DROPDOWN -->
    <div class="notif-dropdown @(IsNotificationVisible ? "show" : "")" id="notifDropdown">
        <div class="notif-header">
            <div class="notif-title">@GetText("Notifications")</div>
            <div class="notif-count">@(UnreadNotificationCount > 0 ? $"{UnreadNotificationCount} {GetText("New")}" : GetText("AllRead"))</div>
        </div>
        <div class="notif-body">
            @if (NotificationSvc.Notifications.Any())
            {
                @foreach (var notif in NotificationSvc.Notifications)
                {
                    <div class="notif-item @(!notif.IsRead ? "unread" : "")" @onclick="() => MarkAsRead(notif)">
                        <div class="notif-item-content">
                            <div class="notif-item-title">@notif.Icon @GetText(notif.TitleKey)</div>
                            <div class="notif-item-message">@FormatNotifMessage(notif)</div>
                            <div class="notif-item-time">@notif.TimeAgo</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="notif-empty">
                    <div class="notif-empty-icon">🔔</div>
                    <div class="notif-empty-text">@GetText("NoNotifications")</div>
                </div>
            }
        </div>
        @if (NotificationSvc.Notifications.Any())
        {
            <div class="notif-footer">
                @if (NotificationSvc.Notifications.Any(n => !n.IsRead))
                {
                    <button class="read-all-btn" @onclick="ReadAllNotifications">@GetText("MarkAllRead")</button>
                }
                else
                {
                    <div style="flex:1"></div>
                }
                <button class="read-all-btn" @onclick="ClearAllNotifications">@GetText("ClearAll")</button>
            </div>
        }
    </div>

    <!-- KPI ROW -->
    <div class="kpi-row">
        <button class="kpi-start-sale" @onclick="@(() => NavigationManager.NavigateTo("/orders"))">
            <div class="kpi-sale-icon-wrap">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <span class="kpi-sale-label">+ Add New Bill</span>
        </button>

        <div class="kpi-stat" @onclick="@(() => NavigationManager.NavigateTo("/sales-history"))">
            <div class="kpi-stat-icon"><i class="fa-solid fa-chart-line"></i></div>
            <div class="kpi-stat-num">@(IsLoadingDashboard ? "..." : $"RM {SalesToday:N2}")</div>
            <div class="kpi-stat-lbl">Sales Today</div>
        </div>

        <div class="kpi-stat" @onclick="@(() => NavigationManager.NavigateTo("/sales-history"))">
            <div class="kpi-stat-icon"><i class="fa-solid fa-receipt"></i></div>
            <div class="kpi-stat-num">@(IsLoadingDashboard ? "..." : BillsCountToday.ToString("N0"))</div>
            <div class="kpi-stat-lbl">Number of Bills Today</div>
        </div>

        <div class="kpi-stat" @onclick="@(() => NavigationManager.NavigateTo("/sales-history"))">
            <div class="kpi-stat-icon"><i class="fa-solid fa-wallet"></i></div>
            <div class="kpi-stat-num">@(IsLoadingDashboard ? "..." : $"RM {BillsAvgSpendingToday:N2}")</div>
            <div class="kpi-stat-lbl">Bills Avg Spending Today</div>
        </div>
    </div>

    <div class="operations-heading">
        <div>
            <h2>Operations</h2>
            <p>Inventory and document queues</p>
        </div>
        <span class="operations-total">
            @(lowStockCount + incomingTransfers.Count + pendingSalesOrders.Count + pendingDeliveryOrders.Count + pendingInvoices.Count + pendingGrns.Count) requiring attention
        </span>
    </div>

    <!-- 6 RETAIL OPERATIONAL SECTION CARDS GRID -->
    <div class="home-sections-grid-6">

        <!-- 1. Low Stock Items -->
        <div class="home-section-card queue-low-stock">
            <div class="section-hdr">
                <div class="section-heading">
                    <span class="section-icon"><i class="fa-solid fa-boxes-stacked"></i></span>
                    <div>
                    <div class="section-title">Low Stock Items</div>
                    <div class="section-sub">@lowStockCount items need reordering</div>
                    </div>
                </div>
                <span class="section-count">@lowStockCount</span>
            </div>
            <div class="section-divider"></div>
            <div class="queue-list">
                @if (isLoadingLowStock)
                {
                    <div class="empty-state">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p>Loading inventory data...</p>
                    </div>
                }
                else if (!lowStockItems.Any())
                {
                    <div class="section-empty-state"><i class="bi bi-check-circle"></i><span>Stock levels are healthy</span></div>
                }
                else
                {
                    @foreach (var item in lowStockItems)
                    {
                        <div class="queue-list-item">
                            <div class="cust-name">
                                <span>@item.AccountName</span>
                            </div>
                            <div class="pkg-quantity">
                                <span class="badge-reorder">Stock: @item.ExistingQuantity</span>
                            </div>
                        </div>
                    }
                }
            </div>
            <button class="section-footer-btn" @onclick="@(() => NavigationManager.NavigateTo("/inventory"))"><span>View inventory</span><i class="bi bi-arrow-right"></i></button>
        </div>

        <!-- 2. Incoming Stock Transfer -->
        <div class="home-section-card queue-transfer">
            <div class="section-hdr">
                <div class="section-heading">
                    <span class="section-icon"><i class="fa-solid fa-truck-ramp-box"></i></span>
                    <div>
                    <div class="section-title">Incoming Stock Transfer</div>
                    <div class="section-sub">@incomingTransfers.Count transfer(s) in transit</div>
                    </div>
                </div>
                <span class="section-count">@incomingTransfers.Count</span>
            </div>
            <div class="section-divider"></div>
            <div class="queue-list">
                @if (!incomingTransfers.Any())
                {
                    <div class="section-empty-state"><i class="bi bi-check-circle"></i><span>No transfers in transit</span></div>
                }
                else
                {
                    @foreach (var tr in incomingTransfers)
                    {
                        <div class="queue-list-item">
                            <div class="cust-name">
                                <span>@tr.TransferNo (@tr.FromBranch)</span>
                            </div>
                            <div class="pkg-quantity">
                                <span>@tr.TotalItems items</span>
                            </div>
                        </div>
                    }
                }
            </div>
            <button class="section-footer-btn" @onclick="@(() => NavigationManager.NavigateTo("/inventory"))"><span>View stock transfers</span><i class="bi bi-arrow-right"></i></button>
        </div>

        <!-- 3. Pending Sales Order -->
        <div class="home-section-card queue-sales-order">
            <div class="section-hdr">
                <div class="section-heading">
                    <span class="section-icon"><i class="fa-solid fa-file-invoice-dollar"></i></span>
                    <div>
                    <div class="section-title">Pending Sales Order</div>
                    <div class="section-sub">@pendingSalesOrders.Count sales order(s) pending</div>
                    </div>
                </div>
                <span class="section-count">@pendingSalesOrders.Count</span>
            </div>
            <div class="section-divider"></div>
            <div class="queue-list">
                @if (!pendingSalesOrders.Any())
                {
                    <div class="section-empty-state"><i class="bi bi-check-circle"></i><span>All sales orders are clear</span></div>
                }
                else
                {
                    @foreach (var so in pendingSalesOrders)
                    {
                        <div class="queue-list-item">
                            <div class="cust-name">
                                <span>@so.OrderNo - @so.CustomerName</span>
                            </div>
                            <div class="pkg-quantity">
                                <span>RM @so.Amount.ToString("N2")</span>
                            </div>
                        </div>
                    }
                }
            </div>
            <button class="section-footer-btn" @onclick="@(() => NavigationManager.NavigateTo("/sales-history"))"><span>View sales orders</span><i class="bi bi-arrow-right"></i></button>
        </div>

        <!-- 4. Pending DO -->
        <div class="home-section-card queue-delivery">
            <div class="section-hdr">
                <div class="section-heading">
                    <span class="section-icon"><i class="fa-solid fa-truck-fast"></i></span>
                    <div>
                    <div class="section-title">Pending DO</div>
                    <div class="section-sub">@pendingDeliveryOrders.Count delivery order(s) pending dispatch</div>
                    </div>
                </div>
                <span class="section-count">@pendingDeliveryOrders.Count</span>
            </div>
            <div class="section-divider"></div>
            <div class="queue-list">
                @if (!pendingDeliveryOrders.Any())
                {
                    <div class="section-empty-state"><i class="bi bi-check-circle"></i><span>No deliveries awaiting dispatch</span></div>
                }
                else
                {
                    @foreach (var doItem in pendingDeliveryOrders)
                    {
                        <div class="queue-list-item">
                            <div class="cust-name">
                                <span>@doItem.DoNo - @doItem.CustomerName</span>
                            </div>
                            <div class="pkg-quantity">
                                <span>@doItem.Status</span>
                            </div>
                        </div>
                    }
                }
            </div>
            <button class="section-footer-btn" @onclick="@(() => NavigationManager.NavigateTo("/sales-history"))"><span>View delivery orders</span><i class="bi bi-arrow-right"></i></button>
        </div>

        <!-- 5. Pending Invoice -->
        <div class="home-section-card queue-invoice">
            <div class="section-hdr">
                <div class="section-heading">
                    <span class="section-icon"><i class="fa-solid fa-file-waveform"></i></span>
                    <div>
                    <div class="section-title">Pending Invoice</div>
                    <div class="section-sub">@pendingInvoices.Count open invoice(s)</div>
                    </div>
                </div>
                <span class="section-count">@pendingInvoices.Count</span>
            </div>
            <div class="section-divider"></div>
            <div class="queue-list">
                @if (!pendingInvoices.Any())
                {
                    <div class="section-empty-state"><i class="bi bi-check-circle"></i><span>No open invoices</span></div>
                }
                else
                {
                    @foreach (var inv in pendingInvoices)
                    {
                        <div class="queue-list-item">
                            <div class="cust-name">
                                <span>@inv.InvoiceNo - @inv.CustomerName</span>
                            </div>
                            <div class="pkg-quantity">
                                <span>RM @inv.TotalAmount.ToString("N2")</span>
                            </div>
                        </div>
                    }
                }
            </div>
            <button class="section-footer-btn" @onclick="@(() => NavigationManager.NavigateTo("/sales-history"))"><span>View invoices</span><i class="bi bi-arrow-right"></i></button>
        </div>

        <!-- 6. Pending GRN -->
        <div class="home-section-card queue-grn">
            <div class="section-hdr">
                <div class="section-heading">
                    <span class="section-icon"><i class="fa-solid fa-clipboard-check"></i></span>
                    <div>
                    <div class="section-title">Pending GRN</div>
                    <div class="section-sub">Issued PO but no delivery yet (@pendingGrns.Count)</div>
                    </div>
                </div>
                <span class="section-count">@pendingGrns.Count</span>
            </div>
            <div class="section-divider"></div>
            <div class="queue-list">
                @if (!pendingGrns.Any())
                {
                    <div class="section-empty-state"><i class="bi bi-check-circle"></i><span>No purchase orders awaiting receipt</span></div>
                }
                else
                {
                    @foreach (var grn in pendingGrns)
                    {
                        <div class="queue-list-item">
                            <div class="cust-name">
                                <span>@grn.PoNo - @grn.SupplierName</span>
                            </div>
                            <div class="pkg-quantity">
                                <span>@grn.ExpectedItems items</span>
                            </div>
                        </div>
                    }
                }
            </div>
            <button class="section-footer-btn" @onclick="@(() => NavigationManager.NavigateTo("/inventory"))"><span>View purchase orders</span><i class="bi bi-arrow-right"></i></button>
        </div>

    </div>

</div>

<!-- ═══ SOS MODAL ═══ -->
@if (IsSOSVisible)
{
    <div class="modal-overlay" @onclick="HideSOS">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-title"><strong>@GetText("SendSOS")</strong></div>
            <div class="modal-text">@GetText("SOSMessage")</div>
            <div class="modal-actions">
                <button class="modal-btn cancel" @onclick="HideSOS">@GetText("Cancel")</button>
                <a class="modal-btn confirm" href="@WhatsAppSOSLink" target="_blank" @onclick="HideSOS">@GetText("SendSOS")</a>
            </div>
        </div>
    </div>
}

<!-- ═══ OPERATION MODAL ═══ -->
@if (IsOperationVisible)
{
    <div class="modal-overlay" @onclick="HideOperation">
        <div class="modal-box operation-box" @onclick:stopPropagation="true">
            <div class="operation-content">
                <div class="operation-left">
                    <div class="operation-item">
                        <div class="op-label">@GetText("Company")</div>
                        <div class="op-value">@CompanyName</div>
                    </div>
                    <div class="operation-item">
                        <div class="op-label">@GetText("Branch")</div>
                        <div class="op-value">@BranchName</div>
                    </div>
                   @*  <div class="operation-item">
                        <div class="op-label">@GetText("Subscription")</div>
                        <div class="op-value">@GetText("Monthly")</div>
                    </div>
                    <div class="operation-item">
                        <div class="op-label">@GetText("AdminLog")</div>
                        <div class="op-value">@GetText("View")</div>
                    </div> *@
                    <div class="operation-item">
                        <div class="op-label">@GetText("Printer")</div>
                        <div class="op-value @(BluetoothSvc.GetSelectedPrinter() != null ? "printer-paired" : "printer-unpaired")">
                            @(BluetoothSvc.GetSelectedPrinter()?.Name ?? GetText("PrinterNotSelected"))
                        </div>
                    </div>
                    <div class="operation-item">
                        <div class="op-label">@GetText("Language")</div>
                        <div class="op-value">@LangSvc.CurrentLanguage</div>
                    </div>
                    <div class="operation-item">
                        <div class="op-label">@GetText("Version")</div>
                        <div class="op-value">@AppVersion</div>
                    </div>
                </div>
                <div class="operation-right">
                    <button class="op-action-btn" @onclick="OpenLanguagePicker">@GetText("SwitchLanguage")</button>
                    <button class="op-action-btn" @onclick="OpenPrinter">@GetText("BluetoothPrinter")</button>
                    @* <button class="op-action-btn" @onclick="OpenAdminLog">@GetText("AdminLog")</button> *@
                </div>
            </div>
            <div class="modal-actions">
                <button class="modal-btn cancel" @onclick="HideOperation">@GetText("Close")</button>
            </div>
        </div>
    </div>
}

<!-- ═══ LANGUAGE PICKER MODAL ═══ -->
@if (IsLanguagePickerVisible)
{
    <div class="modal-overlay" @onclick="CloseLanguagePicker">
        <div class="modal-box language-picker-box" @onclick:stopPropagation="true">
            <div class="modal-title">@GetText("SelectLanguage")</div>
            <div class="language-options">
                <button class="lang-option-btn @(LangSvc.CurrentLanguage == "English" ? "active" : "")" @onclick='() => SelectLanguage("English")'>
                    <span class="lang-flag">🇪🇳</span>
                    <span>@GetText("LanguageEnglish")</span>
                </button>
                <button class="lang-option-btn @(LangSvc.CurrentLanguage == "Chinese" ? "active" : "")" @onclick='() => SelectLanguage("Chinese")'>
                    <span class="lang-flag">🇨🇳</span>
                    <span>@GetText("LanguageChinese")</span>
                </button>
                <button class="lang-option-btn @(LangSvc.CurrentLanguage == "Malay" ? "active" : "")" @onclick='() => SelectLanguage("Malay")'>
                    <span class="lang-flag">🇧🇲</span>
                    <span>@GetText("LanguageMalay")</span>
                </button>
            </div>
            <div class="modal-actions">
                <button class="modal-btn cancel" @onclick="CloseLanguagePicker">@GetText("Close")</button>
            </div>
        </div>
    </div>
}

<!-- ═══ PRINTER MODAL ═══ -->
@if (IsPrinterModalVisible)
{
    <div class="modal-overlay" @onclick="ClosePrinterModal">
        <div class="modal-box printer-picker-box" @onclick:stopPropagation="true">
            <div class="modal-title">@GetText("PrinterSelect")</div>
            <div class="printer-options">
                @foreach (var printer in printerOptions)
                {
                    <div class="printer-option-btn @(printer.IsSelected ? "active" : "")" @onclick="() => SelectPrinterDevice(printer)">
                        <span class="printer-icon">@GetPrinterIcon(printer)</span>
                        <div class="printer-info">
                            <span class="printer-name">@printer.Name</span>
                            @if (printer.IsWifiPrinter)
                            {
                                <span class="printer-address">IP: @printer.IpAddress</span>
                            }
                        </div>
                        <div class="printer-option-right">
                            @if (printer.IsSelected)
                            {
                                <span class="printer-check">✓</span>
                            }
                            @if (printer.IsWifiPrinter)
                            {
                                <button class="printer-edit-ip-btn" @onclick:stopPropagation @onclick="() => StartEditIp(printer)">✏️</button>
                            }
                        </div>
                    </div>
                    @if (editingNetworkPrinter?.Key == printer.Key)
                    {
                        <div class="printer-ip-editor">
                            <input class="printer-ip-input" value="@editingIpValue"
                                   @oninput="e => editingIpValue = e.Value?.ToString() ?? string.Empty"
                                   placeholder="e.g. 192.168.1.200" />
                            <div class="printer-ip-actions">
                                <button class="printer-ip-save" @onclick="() => SaveIpAddress(printer)">@GetText("Save")</button>
                                <button class="printer-ip-cancel" @onclick="CancelEditIp">@GetText("Cancel")</button>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="modal-actions">
                <button class="modal-btn cancel" @onclick="ClosePrinterModal">@GetText("Close")</button>
            </div>
        </div>
    </div>
}

<!-- ═══ CUSTOM VIEW MODAL ═══ -->
@if (IsWorkspaceVisible)
{
    <div class="modal-overlay" @onclick="ToggleWorkspace">
        <div class="modal-box workspace-modal-box" @onclick:stopPropagation="true">
            <div class="workspace-modal-hdr">
                <span class="workspace-modal-title">Custom View</span>
                <button class="workspace-modal-close" @onclick="ToggleWorkspace">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="workspace-modal-body">
                @foreach (var category in WorkspaceSvc.ModuleCategories)
                {
                    <div class="workspace-category">
                        <div class="workspace-category-title">@GetText(category.Name)</div>
                        @foreach (var module in category.Modules)
                        {
                            <div class="workspace-module-item">
                                <div class="workspace-module-info">
                                    <i class="@module.Icon"></i>
                                    <span>@GetText(module.Name)</span>
                                </div>
                                <div class="workspace-module-actions">
                                    <button class="workspace-toggle-btn @(module.Location == "Home" ? "active" : "")"
                                            @onclick="@(() => SetModuleLocation(module, "Home"))">
                                        @GetText("Home")
                                    </button>
                                    <button class="workspace-toggle-btn @(module.Location == "Admin" ? "active" : "")"
                                            @onclick="@(() => SetModuleLocation(module, "Admin"))">
                                        @GetText("Admin")
                                    </button>
                                    <button class="workspace-toggle-btn @(module.Location == "Disabled" ? "active" : "")"
                                            @onclick="@(() => SetModuleLocation(module, "Disabled"))">
                                        @GetText("Disabled")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (IsPackageModalVisible)
{
    <div class="modal-overlay" @onclick="ClosePackageModal">
        <div class="modal-box viewall-modal-box" @onclick:stopPropagation="true">
            <div class="viewall-modal-hdr">
                <div>
                    <div class="viewall-modal-title">Package Expiring in One Month</div>
                    <div class="viewall-modal-sub">@ExpiringPackageCount packages expiring soon</div>
                </div>
                <button class="workspace-modal-close" @onclick="ClosePackageModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="viewall-modal-body">
                @if (!packageData.Any())
                {
                    <div class="section-empty-state">No package data available</div>
                }
                else
                {
                    <div class="viewall-table-header">
                        <span class="viewall-col-cust">Customer</span>
                        <span class="viewall-col-desc">Package</span>
                        <span class="viewall-col-qty">Balance</span>
                    </div>
                    @foreach (var pkg in packageData)
                    {
                        <div class="viewall-row">
                            <span class="viewall-col-cust">@pkg.CustomerName</span>
                            <span class="viewall-col-desc">@pkg.Description</span>
                            <span class="viewall-col-qty viewall-qty-badge">@pkg.QuantityBalance</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@if (IsCreditModalVisible)
{
    <div class="modal-overlay" @onclick="CloseCreditModal">
        <div class="modal-box viewall-modal-box" @onclick:stopPropagation="true">
            <div class="viewall-modal-hdr">
                <div>
                    <div class="viewall-modal-title">Credit Expiring in One Month</div>
                    <div class="viewall-modal-sub">@ExpiringCreditCount credits expiring soon</div>
                </div>
                <button class="workspace-modal-close" @onclick="CloseCreditModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="viewall-modal-body">
                @if (!creditData.Any())
                {
                    <div class="section-empty-state">No credit data available</div>
                }
                else
                {
                    <div class="viewall-table-header">
                        <span class="viewall-col-cust">Customer</span>
                        <span class="viewall-col-desc">Credit</span>
                        <span class="viewall-col-qty">Balance</span>
                    </div>
                    @foreach (var crd in creditData)
                    {
                        <div class="viewall-row">
                            <span class="viewall-col-cust">@crd.CustomerName</span>
                            <span class="viewall-col-desc">@crd.Description</span>
                            <span class="viewall-col-qty viewall-qty-badge">@crd.CreditBalance</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}
