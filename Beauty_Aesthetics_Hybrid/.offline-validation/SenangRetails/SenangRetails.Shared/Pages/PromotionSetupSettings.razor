@using EBI.DM
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Services
@using SenangRetails.Shared.Services.InventoryService
@using SenangRetails.Shared.Services.PromotionSetupService
@inject IPromotionSetupService PromoService
@inject ProductCacheService CacheService
@inject LocalImageCacheService LocalImageCache
@inject IInventoryService InventorySvc
@inject IJSRuntime JS

<div class="ps-settings-wrapper">
    <!-- HEADER BAR -->
    <div class="ps-header-bar">
        <div class="ps-title-group">
            <div class="ps-header-icon-wrap">
                <i class="fa-solid fa-percent"></i>
            </div>
            <div>
                <div class="ps-title-with-badge">
                    <h2 class="ps-title">Promotion Setup</h2>
                    <span class="ps-count-badge">@promotions.Count rules</span>
                </div>
                <p class="ps-subtitle">Configure promotional discounts, special pricing rules, and validity dates.</p>
            </div>
        </div>
        <button class="add-btn touch-target" title="Add promotion" aria-label="Add promotion" @onclick="OpenAddModal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Add Promotion</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(saveMessage))
    {
        <div class="ps-save-notice" role="status">
            <i class="fa-solid fa-circle-check"></i>
            <span>@saveMessage</span>
            <button type="button" aria-label="Dismiss message" @onclick='() => saveMessage = ""'>
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <!-- SEARCH & FILTER TOOLBAR -->
    <div class="ps-toolbar-row">
        <div class="ps-search-box">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text"
                   placeholder="Search promotion by name or code..."
                   @bind="searchQuery"
                   @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <button class="ps-search-clear" @onclick='() => searchQuery = ""'>✕</button>
            }
        </div>
        <select class="ps-filter-select" @bind="selectedTypeFilter">
            <option value="">All Promo Methods</option>
            <option value="Discount %">Discount %</option>
            <option value="Fixed Unit Price">Fixed Unit Price</option>
            <option value="Discount Amt">Discount Amt</option>
            <option value="Bundled Discount Amt">Bundled Discount Amt</option>
            <option value="Lumpsum Disc Amt">Lumpsum Disc Amt</option>
            <option value="Fixed Lumpsum Price">Fixed Lumpsum Price</option>
            <option value="No Effect">No Effect</option>
        </select>
    </div>

    <!-- CONTENT SECTION -->
    @if (isLoading)
    {
        <div class="ps-loading">
            <i class="fa-solid fa-spinner fa-spin ps-spinner-icon"></i>
            <p>Loading promotion rules...</p>
        </div>
    }
    else if (!FilteredPromotions.Any())
    {
        <div class="ps-empty">
            <div class="ps-empty-icon-wrap">
                <i class="fa-solid fa-tags"></i>
            </div>
            @if (!string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(selectedTypeFilter))
            {
                <h4>No matching promotions</h4>
                <p>No promotion rules matched your current search filters.</p>
                <button class="ps-btn-subtle" @onclick='() => { searchQuery = ""; selectedTypeFilter = ""; }'>Clear Filters</button>
            }
            else
            {
                <h4>No promotion rules configured yet</h4>
                <p>Create your first promotion rule to set discounts, bundled prices, and special offers.</p>
                <button class="add-btn touch-target ps-empty-add-btn" @onclick="OpenAddModal">
                    <i class="fa-solid fa-plus"></i>
                    <span>Add First Promotion</span>
                </button>
            }
        </div>
    }
    else
    {
        <!-- MOBILE CARDS VIEW (Displayed on mobile & small tablets) -->
        <div class="ps-mobile-cards-list">
            @foreach (var promo in FilteredPromotions)
            {
                <article class="ps-card-item" @onclick="() => OpenEditModal(promo)">
                    <div class="ps-mobile-card-head">
                        <div class="ps-mobile-card-icon"><i class="fa-solid fa-tags"></i></div>
                        <div class="ps-mobile-card-title">
                            <h4 class="ps-card-name">@promo.Name</h4>
                            <div class="ps-mobile-code-line">
                                <span class="ps-code-badge">@promo.Code</span>
                                <span>@(string.IsNullOrEmpty(promo.PromoMethod) ? promo.PromoType : promo.PromoMethod)</span>
                            </div>
                        </div>
                        <span class="ps-status-pill @(promo.IsActive ? "active" : "inactive")">
                            @(promo.IsActive ? "Active" : "Paused")
                        </span>
                    </div>

                    <div class="ps-mobile-offer-row">
                        <div>
                            <span class="ps-mobile-eyebrow">Offer value</span>
                            <strong class="ps-hero-val">@GetPromoRateDisplay(promo)</strong>
                        </div>
                        <div class="ps-mobile-condition">
                            <span class="ps-mobile-eyebrow">Trigger</span>
                            <strong>@(string.IsNullOrEmpty(promo.PromoCondition) ? "No condition" : promo.PromoCondition)</strong>
                        </div>
                    </div>

                    <div class="ps-mobile-metrics">
                        <div><i class="fa-solid fa-box"></i><strong>@(promo.AppliedProductIds?.Count ?? 0)</strong><span>Items</span></div>
                        <div><i class="fa-solid fa-layer-group"></i><strong>@promo.MinQuantity</strong><span>Min qty</span></div>
                        <div><i class="fa-solid fa-bullseye"></i><strong>@(promo.MaxLimitPerOrder > 0 ? promo.MaxLimitPerOrder.ToString() : "-")</strong><span>Order max</span></div>
                    </div>

                    <div class="ps-mobile-card-foot">
                        <div class="ps-card-dates">
                            <i class="fa-regular fa-calendar-days"></i>
                            <span>@(promo.StartDate?.ToString("dd MMM yyyy") ?? "Anytime") - @(promo.EndDate?.ToString("dd MMM yyyy") ?? "No expiry")</span>
                        </div>
                        <div class="ps-card-actions" @onclick:stopPropagation>
                            <button class="ps-icon-btn ps-edit-btn" title="Edit promotion" aria-label="Edit @promo.Name" @onclick="() => OpenEditModal(promo)">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button class="ps-icon-btn ps-del-btn" title="Delete promotion" aria-label="Delete @promo.Name" @onclick="() => ConfirmDelete(promo)">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>

        <!-- DESKTOP TABLE VIEW (Displayed on wide screens) -->
        <div class="ps-desktop-table-card">
            <div class="ps-table-scroll">
                <table class="ps-table">
                    <thead>
                        <tr>
                            <th>Promo Code</th>
                            <th>Promotion Name</th>
                            <th>Promo Method</th>
                            <th>Rate / Discount</th>
                            <th>Condition</th>
                            <th>Rounding</th>
                            <th>Applied Products</th>
                            <th>Valid Period</th>
                            <th class="align-center">Min Qty</th>
                            <th class="align-center">Status</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var promo in FilteredPromotions)
                        {
                            <tr class="ps-touch-row" @onclick="() => OpenEditModal(promo)">
                                <td><span class="ps-code-badge">@promo.Code</span></td>
                                <td>
                                    <strong class="cell-main">@promo.Name</strong>
                                    @if (!string.IsNullOrEmpty(promo.Remarks))
                                    {
                                        <div class="sub-text">@promo.Remarks</div>
                                    }
                                </td>
                                <td>
                                    <span class="method-badge">@(string.IsNullOrEmpty(promo.PromoMethod) ? promo.PromoType : promo.PromoMethod)</span>
                                </td>
                                <td>
                                    <span class="ps-rate-text">@GetPromoRateDisplay(promo)</span>
                                </td>
                                <td>
                                    <span class="cell-sub">@(string.IsNullOrEmpty(promo.PromoCondition) ? "No Condition" : promo.PromoCondition)</span>
                                </td>
                                <td>
                                    <span class="cell-sub">@(string.IsNullOrEmpty(promo.Rounding) ? "No Rounding" : promo.Rounding)</span>
                                </td>
                                <td>
                                    <span class="prod-badge">@GetAppliedProductsSummary(promo)</span>
                                </td>
                                <td>
                                    <span class="cell-date">@(promo.StartDate?.ToString("dd/MM/yyyy") ?? "Start") – @(promo.EndDate?.ToString("dd/MM/yyyy") ?? "End")</span>
                                </td>
                                <td class="align-center">@promo.MinQuantity</td>
                                <td class="align-center">
                                    <span class="ps-status-pill @(promo.IsActive ? "active" : "inactive")">
                                        @(promo.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td style="text-align: right;">
                                    <button class="ps-icon-btn ps-edit-btn" title="Edit" @onclick="() => OpenEditModal(promo)" @onclick:stopPropagation>
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button class="ps-icon-btn ps-del-btn" title="Delete" @onclick="() => ConfirmDelete(promo)" @onclick:stopPropagation>
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- TOUCH ADD / EDIT MODAL -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-container ps-modal ps-large-modal" @onclick:stopPropagation>
            <!-- STICKY MODAL HEADER -->
            <div class="modal-header">
                <div class="ps-modal-header-left">
                    <div class="ps-modal-icon-badge">
                        <i class="fa-solid fa-percent"></i>
                    </div>
                    <div>
                        <h3 class="ps-modal-title">@(isEditMode ? "Edit Promotion Rule" : "Add Promotion Rule")</h3>
                        <span class="ps-modal-sub">@(isEditMode ? $"Updating {currentPromo.Code}" : "Configure discount calculation, triggers, and assigned items")</span>
                    </div>
                </div>
                <button class="close-btn" @onclick="CloseModal" aria-label="Close">✕</button>
            </div>

            <!-- MODAL BODY (SCROLLABLE & BOUNDED) -->
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-banner">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@errorMessage</span>
                    </div>
                }

                <div class="ps-modal-grid">
                    <!-- LEFT COLUMN: PROMO DETAILS & CALCULATION -->
                    <div class="ps-modal-col">
                        <!-- 1. General Information -->
                        <div class="ps-section-card">
                            <div class="ps-section-card-header">
                                <i class="fa-solid fa-circle-info"></i>
                                <span>General Information</span>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Promo Code <span class="required">*</span></label>
                                <input type="text"
                                       class="form-control text-uppercase text-mono @(isEditMode ? "readonly" : "")"
                                       placeholder="e.g. PROMO-20OFF"
                                       @bind="currentPromo.Code"
                                       aria-invalid="@(validationAttempted && string.IsNullOrWhiteSpace(currentPromo.Code))"
                                       disabled="@isEditMode" />
                                @if (validationAttempted && string.IsNullOrWhiteSpace(currentPromo.Code))
                                {
                                    <span class="ps-field-error"><i class="fa-solid fa-circle-exclamation"></i> Promotion code is required.</span>
                                }
                                @if (isEditMode)
                                {
                                    <span class="ps-field-hint">Promo code is unique and locked after creation.</span>
                                }
                            </div>

                            <div class="form-group">
                                <label class="form-label">Promotion Name <span class="required">*</span></label>
                                <input type="text"
                                       class="form-control"
                                       placeholder="e.g. Happy Hour 20% OFF"
                                       @bind="currentPromo.Name"
                                       aria-invalid="@(validationAttempted && string.IsNullOrWhiteSpace(currentPromo.Name))" />
                                @if (validationAttempted && string.IsNullOrWhiteSpace(currentPromo.Name))
                                {
                                    <span class="ps-field-error"><i class="fa-solid fa-circle-exclamation"></i> Promotion name is required.</span>
                                }
                            </div>

                            <div class="form-group">
                                <label class="form-label">Remarks / Description</label>
                                <textarea class="form-control"
                                          rows="2"
                                          placeholder="Optional promotion notes or terms..."
                                          @bind="currentPromo.Remarks"></textarea>
                            </div>
                        </div>

                        <!-- 2. Discount Method & Calculation -->
                        <div class="ps-section-card">
                            <div class="ps-section-card-header">
                                <i class="fa-solid fa-calculator"></i>
                                <span>Discount &amp; Calculation</span>
                            </div>

                            <!-- Promo Method -->
                            <div class="form-group">
                                <label class="form-label">Promo Method <span class="required">*</span></label>
                                <select class="form-control" @bind="currentPromo.PromoMethod">
                                    <option value="Discount %">Discount % (Percentage)</option>
                                    <option value="Fixed Unit Price">Fixed Unit Price (RM)</option>
                                    <option value="Discount Amt">Discount Amount (RM)</option>
                                    <option value="Bundled Discount Amt">Bundled Discount Amount (RM)</option>
                                    <option value="Lumpsum Disc Amt">Lumpsum Discount Amount (RM)</option>
                                    <option value="Fixed Lumpsum Price">Fixed Lumpsum Price (RM)</option>
                                    <option value="No Effect">No Effect</option>
                                </select>
                            </div>

                            <!-- Interactive Value Tap Card (Keypad Trigger) -->
                            <div class="form-group">
                                <label class="form-label">@GetPromoValueLabel() <span class="required">*</span></label>
                                <div class="ps-value-tap-card" @onclick='() => OpenKeypad("DiscountValue", currentPromo.DiscountValue, GetPromoValueLabel())'>
                                    <div class="ps-value-tap-left">
                                        <span class="ps-value-tap-number">@GetPromoValueDisplay()</span>
                                    </div>
                                    <div class="ps-value-tap-btn">
                                        <i class="fa-solid fa-calculator"></i>
                                        <span>Tap to edit</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Promo Condition -->
                            <div class="form-group">
                                <label class="form-label">Promo Condition <span class="required">*</span></label>
                                <select class="form-control" @bind="currentPromo.PromoCondition">
                                    <option value="No Condition">No Condition</option>
                                    <option value="Total Price After Discount, Disc To All Items">Total Price After Discount (Disc To All)</option>
                                    <option value="Total Price After Discount">Total Price After Discount</option>
                                    <option value="Total Quantity Bought, Disc To All Items">Total Quantity Bought (Disc To All)</option>
                                    <option value="Total Quantity Bought">Total Quantity Bought</option>
                                    <option value="Total Price Before Discount, Disc To All Items">Total Price Before Discount (Disc To All)</option>
                                    <option value="Total Price Before Discount">Total Price Before Discount</option>
                                </select>
                            </div>

                            <!-- Rounding -->
                            <div class="form-group">
                                <label class="form-label">Rounding Rule</label>
                                <select class="form-control" @bind="currentPromo.Rounding">
                                    <option value="No Rounding">No Rounding</option>
                                    <option value="Round To5Cent">Round To 5 Cents</option>
                                    <option value="Round Up To10Cent">Round Up To 10 Cents</option>
                                    <option value="Round Up To Dollar">Round Up To Dollar</option>
                                    <option value="Round Down To10Cent">Round Down To 10 Cents</option>
                                    <option value="Round Down To Dollar">Round Down To Dollar</option>
                                </select>
                            </div>
                        </div>

                        <!-- 3. Limits & Validity -->
                        <div class="ps-section-card">
                            <div class="ps-section-card-header">
                                <i class="fa-solid fa-clock"></i>
                                <span>Rules, Limits &amp; Validity</span>
                            </div>

                            <!-- Min Qty & Max Limit Grid -->
                            <div class="ps-grid-2col">
                                <div class="form-group">
                                    <label class="form-label">Min Quantity Trigger</label>
                                    <div class="picker-field" @onclick='() => OpenKeypad("MinQuantity", currentPromo.MinQuantity, "Min Quantity Trigger")'>
                                        <span class="picker-value">@currentPromo.MinQuantity unit(s)</span>
                                        <i class="fa-solid fa-calculator picker-icon"></i>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Max Limit / Order</label>
                                    <div class="picker-field" @onclick='() => OpenKeypad("MaxLimitPerOrder", currentPromo.MaxLimitPerOrder, "Max Limit Per Order")'>
                                        <span class="picker-value">@(currentPromo.MaxLimitPerOrder == 0 ? "Unlimited (0)" : $"{currentPromo.MaxLimitPerOrder} item(s)")</span>
                                        <i class="fa-solid fa-calculator picker-icon"></i>
                                    </div>
                                </div>
                            </div>

                            <!-- Valid Date Range -->
                            <div class="form-group">
                                <label class="form-label">Valid Date Range</label>
                                <div class="ps-date-range-row">
                                    <div class="ps-date-col">
                                        <span class="ps-date-sub">Start Date</span>
                                        <input type="date" class="form-control" @bind="currentPromo.StartDate" />
                                    </div>
                                    <div class="ps-date-col">
                                        <span class="ps-date-sub">End Date</span>
                                        <input type="date" class="form-control" @bind="currentPromo.EndDate" />
                                    </div>
                                </div>
                            </div>

                            <!-- Active Status Toggle -->
                            <div class="ps-toggle-card @(currentPromo.IsActive ? "checked" : "")"
                                 @onclick="() => currentPromo.IsActive = !currentPromo.IsActive">
                                <div class="ps-toggle-left">
                                    <i class="fa-solid fa-power-off"></i>
                                    <div>
                                        <span class="ps-toggle-title">Active Promotion Rule</span>
                                        <span class="ps-toggle-desc">Enable this promotion for cashier orders.</span>
                                    </div>
                                </div>
                                <input type="checkbox"
                                       class="custom-checkbox"
                                       checked="@currentPromo.IsActive"
                                       @onclick:stopPropagation />
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: APPLICABLE PRODUCTS PICKER -->
                    <div class="ps-modal-col">
                        <div class="ps-section-card ps-picker-section">
                            <div class="ps-picker-header-bar">
                                <div>
                                    <div class="ps-section-card-header" style="margin-bottom: 2px;">
                                        <i class="fa-solid fa-boxes-stacked"></i>
                                        <span>Applied Products</span>
                                    </div>
                                    <span class="ps-picker-counter">
                                        <strong>@(currentPromo.AppliedProductIds?.Count ?? 0)</strong> items assigned
                                    </span>
                                </div>
                                <div class="ps-picker-quick-actions">
                                    <button type="button" class="ps-picker-quick-btn" @onclick="SelectAllFilteredProducts">
                                        Select All (@FilteredProductsForPicker.Count())
                                    </button>
                                    @if (currentPromo.AppliedProductIds != null && currentPromo.AppliedProductIds.Any())
                                    {
                                        <button type="button" class="ps-picker-quick-btn danger" @onclick="ClearAllProducts">
                                            Clear All
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Search & Category Filters -->
                            <div class="ps-picker-filter-row">
                                <div class="ps-picker-search-wrap">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                    <input type="text"
                                           class="ps-picker-search"
                                           placeholder="Search items..."
                                           @bind="prodSearchQuery"
                                           @bind:event="oninput" />
                                </div>
                                <select class="ps-picker-cat" @bind="prodCategoryFilter">
                                    <option value="">All Categories</option>
                                    @foreach (var cat in availableCategories)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                            </div>

                            <!-- Scrollable Product List -->
                            <div class="ps-picker-list">
                                @if (!FilteredProductsForPicker.Any())
                                {
                                    <div class="ps-empty-picker">
                                        <i class="fa-solid fa-box-open" style="font-size: 2rem; color: #CBD5E1; margin-bottom: 0.5rem;"></i>
                                        <p>No products found matching filter.</p>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var prod in FilteredProductsForPicker)
                                    {
                                        var isChecked = !string.IsNullOrEmpty(prod.MasterAccountID) && currentPromo.AppliedProductIds.Any(id => string.Equals(id?.Trim(), prod.MasterAccountID.Trim(), StringComparison.OrdinalIgnoreCase));
                                        var imgUrl = GetDisplayImageUrl(prod);

                                        <div class="ps-prod-card @(isChecked ? "selected" : "")"
                                             @onclick="() => ToggleProductSelection(prod.MasterAccountID)">
                                            <!-- Checkbox Badge -->
                                            <div class="ps-prod-check-badge">
                                                <i class="fa-solid @(isChecked ? "fa-circle-check" : "fa-circle")"></i>
                                            </div>

                                            <!-- Thumbnail -->
                                            @if (!string.IsNullOrEmpty(imgUrl))
                                            {
                                                <img src="@imgUrl" alt="@prod.AccountName" class="ps-prod-thumb" />
                                            }
                                            else
                                            {
                                                <div class="ps-prod-thumb-icon">
                                                    <i class="fa-solid fa-box"></i>
                                                </div>
                                            }

                                            <!-- Details -->
                                            <div class="ps-prod-details">
                                                <span class="ps-prod-title">@prod.AccountName</span>
                                                <div class="ps-prod-meta-row">
                                                    @if (!string.IsNullOrEmpty(prod.ItemGroupName))
                                                    {
                                                        <span class="ps-cat-tag">@prod.ItemGroupName</span>
                                                    }
                                                    <span class="ps-orig-price">RM @prod.SalesPrice.ToString("N2")</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STICKY MODAL FOOTER -->
            <div class="prod-modal-footer">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="ps-footer-error" role="alert">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@errorMessage</span>
                    </div>
                }
                @if (isEditMode)
                {
                    <button class="prod-modal-cancel-btn text-danger touch-target" @onclick="() => ConfirmDelete(currentPromo)">
                        <i class="fa-solid fa-trash-can"></i> Delete
                    </button>
                }
                <button class="prod-modal-cancel-btn touch-target" @onclick="CloseModal">Cancel</button>
                <button type="button" class="prod-modal-save-btn touch-target" @onclick="SavePromo" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Save Promotion</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- TOUCH CALCULATOR KEYPAD MODAL -->
@if (showKeypad)
{
    <div class="modal-overlay" @onclick="CloseKeypad">
        <div class="touch-keypad-modal" @onclick:stopPropagation>
            <div class="keypad-header">
                <span class="keypad-title">Enter @keypadTitle</span>
                <span class="keypad-display">@keypadValueString</span>
            </div>
            <div class="keypad-grid">
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("7")'>7</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("8")'>8</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("9")'>9</button>
                <button type="button" class="kp-btn kp-action" @onclick="KeypadClear">CE</button>

                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("4")'>4</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("5")'>5</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("6")'>6</button>
                <button type="button" class="kp-btn kp-action" @onclick="KeypadBackspace">⌫</button>

                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("1")'>1</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("2")'>2</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("3")'>3</button>
                <button type="button" class="kp-btn kp-cancel" @onclick="CloseKeypad">Cancel</button>

                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("0")'>0</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("00")'>00</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend(".")'>.</button>
                <button type="button" class="kp-btn kp-submit" @onclick="KeypadSave">OK</button>
            </div>
        </div>
    </div>
}

<!-- DELETE CONFIRMATION MODAL -->
@if (showDeleteModal && promoToDelete != null)
{
    <div class="modal-overlay" @onclick="() => showDeleteModal = false">
        <div class="modal-container ps-del-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="ps-del-header-left">
                    <div class="ps-del-icon-badge">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <h3 class="ps-modal-title" style="color: #DC2626;">Confirm Deletion</h3>
                        <span class="ps-modal-sub">This action cannot be undone.</span>
                    </div>
                </div>
            </div>
            <div class="modal-body" style="padding: 1.25rem;">
                <p style="margin: 0; font-size: 0.95rem; color: #334155; line-height: 1.5;">
                    Are you sure you want to delete promotion
                    <strong style="color: #0F172A; font-weight: 700;">@promoToDelete.Name</strong> (<span style="font-family: monospace;">@promoToDelete.Code</span>)?
                </p>
            </div>
            <div class="prod-modal-footer">
                <button class="prod-modal-cancel-btn touch-target" @onclick="() => showDeleteModal = false">Cancel</button>
                <button class="prod-modal-save-btn touch-target" style="background: #DC2626;" @onclick="ExecuteDelete">Delete Promotion</button>
            </div>
        </div>
    </div>
}

