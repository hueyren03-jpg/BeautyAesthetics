    private IEnumerable<string> availableCategories =>
        availableProducts
            .Select(p => p.ItemGroupName ?? "")
            .Where(c => !string.IsNullOrEmpty(c))
            .Distinct()
            .OrderBy(c => c);

    protected override async Task OnInitializedAsync()
    {
        await LoadPromotions();
    }

    private async Task LoadPromotions()
    {
        isLoading = true;
        try
        {
            promotions = await PromoService.GetPromotionsAsync();
            if (CacheService.HasCache && CacheService.Items != null)
            {
                availableProducts = CacheService.Items;
            }
            else
            {
                var liveItems = await InventorySvc.LoadItemsAsync("");
                availableProducts = liveItems ?? new List<InventoryDM>();
            }
        }
        catch
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetDisplayImageUrl(InventoryDM item)
    {
        var cached = CacheService.GetImage(item.MasterAccountID ?? "") ?? LocalImageCache.GetImage(item.MasterAccountID ?? "");
        if (!string.IsNullOrEmpty(cached)) return cached;

        string rawUrl = string.Empty;
        if (!string.IsNullOrEmpty(item.ImagePath) && !string.IsNullOrEmpty(item.ImageFileName))
        {
            string separator = item.ImagePath.EndsWith("/") ? "" : "/";
            rawUrl = $"{item.ImagePath}{separator}{item.ImageFileName}";
        }
        else if (!string.IsNullOrEmpty(item.ImagePath))
        {
            rawUrl = item.ImagePath;
        }
        else if (!string.IsNullOrEmpty(item.ImageFileName))
        {
            rawUrl = item.ImageFileName;
        }

        if (string.IsNullOrWhiteSpace(rawUrl)) return string.Empty;

        if (rawUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            rawUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            rawUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return rawUrl;
        }

        string apiBase = "https://ebisoftware.com.my:5000/";
        string cleanRelative = rawUrl.StartsWith("/") ? rawUrl.Substring(1) : rawUrl;
        return $"{apiBase}{cleanRelative}";
    }

    private IEnumerable<PromotionSetupModel> FilteredPromotions
    {
        get
        {
            var result = promotions.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(p => (p.Name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (p.Code?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (p.PromoMethod?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (p.PromoCondition?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(selectedTypeFilter))
            {
                result = result.Where(p => p.PromoMethod == selectedTypeFilter || p.PromoType == selectedTypeFilter);
            }

            return result;
        }
    }

    private IEnumerable<InventoryDM> FilteredProductsForPicker
    {
        get
        {
            var result = availableProducts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(prodSearchQuery))
            {
                result = result.Where(p => (p.AccountName?.Contains(prodSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (p.MasterAccountID?.Contains(prodSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(prodCategoryFilter))
            {
                result = result.Where(p => p.ItemGroupName == prodCategoryFilter);
            }

            return result;
        }
    }

    private string GetAppliedProductsSummary(PromotionSetupModel promo)
    {
        if (promo.AppliedProductIds == null || !promo.AppliedProductIds.Any())
        {
            return "None (0 Products)";
        }
        return $"{promo.AppliedProductIds.Count} Product(s)";
    }

    private string GetPromoValueLabel()
    {
        return currentPromo.PromoMethod switch
        {
            "Fixed Unit Price" => "Fixed Unit Price (RM)",
            "Discount Amt" => "Discount Amount (RM)",
            "Bundled Discount Amt" => "Bundled Discount Amount (RM)",
            "Lumpsum Disc Amt" => "Lumpsum Discount Amount (RM)",
            "Fixed Lumpsum Price" => "Fixed Lumpsum Price (RM)",
            "No Effect" => "Discount Value",
            _ => "Discount Rate (%)"
        };
    }

    private string GetPromoValueDisplay()
    {
        if (currentPromo.PromoMethod == "No Effect")
            return "RM 0.00 (No Effect)";

        if (currentPromo.PromoMethod == "Discount %" || (string.IsNullOrEmpty(currentPromo.PromoMethod) && currentPromo.PromoType == "Percentage"))
            return $"{currentPromo.DiscountValue:N2}%";

        return $"RM {currentPromo.DiscountValue:N2}";
    }

    private string GetPromoRateDisplay(PromotionSetupModel promo)
    {
        var method = string.IsNullOrEmpty(promo.PromoMethod) ? promo.PromoType : promo.PromoMethod;
        if (method == "No Effect")
            return "No Effect";

        if (method == "Discount %" || method == "Percentage")
            return $"{promo.DiscountValue:N2}% OFF";

        return $"RM {promo.DiscountValue:N2}";
    }

    private void ToggleProductSelection(string? masterAccountId)
    {
        if (string.IsNullOrWhiteSpace(masterAccountId)) return;
        var trimmedId = masterAccountId.Trim();
        var existing = currentPromo.AppliedProductIds.FirstOrDefault(id => string.Equals(id?.Trim(), trimmedId, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
        {
            currentPromo.AppliedProductIds.Remove(existing);
        }
        else
        {
            currentPromo.AppliedProductIds.Add(trimmedId);
        }
    }

    private void SelectAllFilteredProducts()
    {
        foreach (var p in FilteredProductsForPicker)
        {
            if (!string.IsNullOrWhiteSpace(p.MasterAccountID))
            {
                var trimmed = p.MasterAccountID.Trim();
                if (!currentPromo.AppliedProductIds.Any(id => string.Equals(id?.Trim(), trimmed, StringComparison.OrdinalIgnoreCase)))
                {
                    currentPromo.AppliedProductIds.Add(trimmed);
                }
            }
        }
    }

    private void ClearAllProducts()
    {
        currentPromo.AppliedProductIds.Clear();
    }

    private void OpenAddModal()
    {
        isEditMode = false;
        errorMessage = "";
        validationAttempted = false;
        prodSearchQuery = "";
        prodCategoryFilter = "";
        currentPromo = new PromotionSetupModel
        {
            Code = GeneratePromoCode(),
            PromoType = "Percentage",
            PromoMethod = "Discount %",
            Rounding = "No Rounding",
            PromoCondition = "Total Price After Discount, Disc To All Items",
            AppliedProductIds = new List<string>()
        };
        showModal = true;
    }

    private void OpenEditModal(PromotionSetupModel promo)
    {
        isEditMode = true;
        errorMessage = "";
        validationAttempted = false;
        prodSearchQuery = "";
        prodCategoryFilter = "";
        currentPromo = new PromotionSetupModel
        {
            Code = promo.Code,
            Name = promo.Name,
            PromoType = promo.PromoType,
            PromoMethod = string.IsNullOrEmpty(promo.PromoMethod) ? (promo.PromoType == "Fixed Price" ? "Fixed Unit Price" : "Discount %") : promo.PromoMethod,
            Rounding = string.IsNullOrEmpty(promo.Rounding) ? "No Rounding" : promo.Rounding,
            PromoCondition = string.IsNullOrEmpty(promo.PromoCondition) ? "Total Price After Discount, Disc To All Items" : promo.PromoCondition,
            DiscountValue = promo.DiscountValue,
            StartDate = promo.StartDate,
            EndDate = promo.EndDate,
            MinQuantity = promo.MinQuantity,
            MaxLimitPerOrder = promo.MaxLimitPerOrder,
            IsActive = promo.IsActive,
            Remarks = promo.Remarks,
            AppliedProductIds = promo.AppliedProductIds != null ? promo.AppliedProductIds.ToList() : new List<string>()
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        errorMessage = "";
        validationAttempted = false;
    }

    private string GeneratePromoCode()
    {
        var nextNumber = 101;
        while (promotions.Any(p => string.Equals(p.Code, $"PROMO-{nextNumber}", StringComparison.OrdinalIgnoreCase)))
        {
            nextNumber++;
        }

        return $"PROMO-{nextNumber}";
    }

    private async Task SavePromo()
    {
        validationAttempted = true;
        errorMessage = "";
        currentPromo.Code = currentPromo.Code?.Trim().ToUpperInvariant() ?? "";
        currentPromo.Name = currentPromo.Name?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(currentPromo.Code) || string.IsNullOrWhiteSpace(currentPromo.Name))
        {
            errorMessage = string.IsNullOrWhiteSpace(currentPromo.Name)
                ? "Enter a promotion name before saving."
                : "Enter a promotion code before saving.";
            return;
        }

        if (!isEditMode && promotions.Any(p => string.Equals(p.Code, currentPromo.Code, StringComparison.OrdinalIgnoreCase)))
        {
            errorMessage = $"Promotion code {currentPromo.Code} already exists.";
            return;
        }

        if (currentPromo.StartDate.HasValue && currentPromo.EndDate.HasValue && currentPromo.StartDate > currentPromo.EndDate)
        {
            errorMessage = "The end date must be on or after the start date.";
            return;
        }

        // Sync PromoType for backward compatibility
        if (currentPromo.PromoMethod == "Discount %" || currentPromo.PromoMethod == "Percentage")
        {
            currentPromo.PromoType = "Percentage";
        }
        else if (currentPromo.PromoMethod == "Discount Amt" || currentPromo.PromoMethod == "Discount Amount")
        {
            currentPromo.PromoType = "Discount Amount";
        }
        else if (currentPromo.PromoMethod == "Fixed Unit Price" || currentPromo.PromoMethod == "Fixed Price")
        {
            currentPromo.PromoType = "Fixed Price";
        }
        else
        {
            currentPromo.PromoType = currentPromo.PromoMethod;
        }

        isSaving = true;
        try
        {
            var success = await PromoService.SavePromotionAsync(currentPromo, !isEditMode);
            if (success)
            {
                showModal = false;
                await LoadPromotions();
                saveMessage = $"{currentPromo.Name} was saved successfully.";
                validationAttempted = false;
            }
            else
            {
                errorMessage = string.IsNullOrWhiteSpace(PromoService.LastError)
                    ? "The promotion could not be saved. Please try again."
                    : $"The promotion could not be saved: {PromoService.LastError}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDelete(PromotionSetupModel promo)
    {
        promoToDelete = promo;
        showDeleteModal = true;
    }

    private async Task ExecuteDelete()
    {
        if (promoToDelete != null)
        {
            await PromoService.DeletePromotionAsync(promoToDelete.Code);
            showDeleteModal = false;
            showModal = false;
            promoToDelete = null;
            await LoadPromotions();
        }
    }

    // Touch Keypad Methods
    private void OpenKeypad(string field, object? currentVal, string title)
    {
        keypadField = field;
        keypadTitle = title;
        keypadValueString = currentVal switch
        {
            decimal d => d == 0 ? "0" : d.ToString("0.##"),
            int i => i.ToString(),
            _ => "0"
        };
        showKeypad = true;
    }

    private void KeypadAppend(string val)
    {
        if (keypadValueString == "0" && val != ".")
            keypadValueString = val;
        else if (!(val == "." && keypadValueString.Contains(".")))
            keypadValueString += val;
    }

    private void KeypadClear() => keypadValueString = "0";

    private void KeypadBackspace()
    {
        if (keypadValueString.Length > 1)
            keypadValueString = keypadValueString.Substring(0, keypadValueString.Length - 1);
        else
            keypadValueString = "0";
    }

    private void KeypadSave()
    {
        if (keypadField == "DiscountValue" && decimal.TryParse(keypadValueString, out var dVal))
        {
            currentPromo.DiscountValue = dVal;
        }
        else if (keypadField == "MinQuantity" && int.TryParse(keypadValueString, out var mQty))
        {
            currentPromo.MinQuantity = Math.Max(1, mQty);
        }
        else if (keypadField == "MaxLimitPerOrder" && int.TryParse(keypadValueString, out var mLim))
        {
            currentPromo.MaxLimitPerOrder = Math.Max(0, mLim);
        }
        showKeypad = false;
    }

    private void CloseKeypad() => showKeypad = false;
}
