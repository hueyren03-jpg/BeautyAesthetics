@inherits SenangRetails.Shared.Pages.BasePage
@using SenangRetails.Shared.Model
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Pages
@using SenangRetails.Shared.Services
@using EBI.DM
@inject AppState AppState
@inject SenangRetails.Shared.Services.InventoryService.IInventoryService InventoryService
@inject SenangRetails.Shared.Services.MembershipTypeService.IMembershipTypeService MembershipTypeService

<!-- MAIN CONTAINER SWITCH: SECTION SETTINGS VS NORMAL PACKAGE VIEW -->
@if (IsSectionSettingsMode)
{
    <!-- SECTION SETTINGS MODE -->
    <div class="top-bar">
        <div class="top-bar-left">
            @if (IsAddSectionMode)
            {
                <div class="page-title">
                    <h2>@(IsEditSectionMode ? "Edit Section" : "Add Section")</h2>
                    <span>Management</span>
                </div>
            }
            else
            {
                <button class="back-btn" @onclick="GoBackToMain">
                    ←
                </button>
                <div class="page-title">
                    <h2>Package - Section</h2>
                    <span>Management</span>
                </div>
            }
        </div>

        @if (!IsAddSectionMode)
        {
            <button class="add-btn" @onclick="OpenAddSectionMode" title="Add New Section">+</button>
        }
        else
        {
            <div style="display: flex; gap: 8px;">
                <button class="btn btn-secondary" style="border-radius: 20px; padding: 0.5rem 1rem;" @onclick="CloseAddSectionMode">Cancel</button>
                <button class="btn btn-primary" style="border-radius: 20px; padding: 0.5rem 1.5rem;" @onclick="SaveSection">Save</button>
            </div>
        }
    </div>

    <div class="content-area">
        @if (IsAddSectionMode)
        {
            <!-- ADD SECTION FORM -->
            <div class="add-mode-container" style="background: white; border-radius: 12px; padding: 2rem;">
                <div class="form-section">
                    <div class="form-group">
                        <label>Section Name</label>
                        <input type="text" class="form-control" @bind="NewSection.Name" placeholder="e.g. Bundles" />
                    </div>
                    <div class="form-group">
                        <label>Additional Title</label>
                        <input type="text" class="form-control" @bind="NewSection.AdditionalTitle" placeholder="e.g. Family Sets" />
                    </div>

                    <!-- Reward Toggle -->
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <label style="margin-bottom: 0;">Collection Reward</label>
                            <label class="switch">
                                <input type="checkbox" checked="@NewSection.IsCollectionRewardEnabled" @onchange="ToggleCollectionReward">
                                    <span class="slider round"></span>
                                </label>
                            </div>
                            <span class="input-description">Set how much Credit/Point reward toward your customer upon Payment</span>
                        </div>

                        @if (NewSection.IsCollectionRewardEnabled)
                        {
                            <div style="margin-top: 1rem; display: flex; flex-direction: column; gap: 1rem;">
                                <!-- Credit Reward Input -->
                                <div class="form-group" style="display: flex; align-items: center; justify-content: space-between;">
                                    <label style="margin: 0; flex: 1;">@(NewSection.IsReverseRate ? "Collection per 1.00 Credit" : "Credit per 1.00 Collection")</label>
                                    <div style="position: relative; width: 150px;">
                                        <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("CreditReward"))" style="padding-right: 2.5rem; text-align: right;">
                                            <span style="color: var(--primary-rose); font-weight: bold;">@NewSection.CreditPerCollection.ToString("N2")</span>
                                        </div>
                                        <button class="icon-btn-square" @onclick="ToggleReverseRate" style="border: none; background: transparent; position: absolute; right: 2px; top: 50%; transform: translateY(-50%); width: 30px; height: 30px;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-rose)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
                                        </button>
                                    </div>
                                </div>

                                <!-- Point Reward Input -->
                                <div class="form-group" style="display: flex; align-items: center; justify-content: space-between;">
                                    <label style="margin: 0; flex: 1;">@(NewSection.IsReverseRate ? "Collection per 1 Point" : "Point per 1.00 Collection")</label>
                                    <div style="position: relative; width: 150px;">
                                        <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("PointReward"))" style="padding-right: 2.5rem; text-align: right;">
                                            <span style="color: var(--primary-rose); font-weight: bold;">@NewSection.PointPerCollection.ToString("N2")</span>
                                        </div>
                                        <button class="icon-btn-square" @onclick="ToggleReverseRate" style="border: none; background: transparent; position: absolute; right: 2px; top: 50%; transform: translateY(-50%); width: 30px; height: 30px;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-rose)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        else
            {
                <!-- SECTION LIST -->
                <div style="padding: 1rem 1rem 0 1rem; margin-bottom: 1rem; color: #666; font-size: 0.9rem;">
                    Organize SKUs by Section and Folder for better tracking. Sections or Folders with no SKUs will be hidden
                </div>
                <div class="product-list" style="padding: 0 1rem 1rem 1rem;">
                    @foreach (var sec in SectionsDb)
                    {
                        <div class="product-card" @onclick="() => OpenEditSectionMode(sec)" style="cursor: pointer;">
                            <div class="product-card-icon" style="background: #eef2ff; color: #6366f1;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                            </div>
                            <div class="product-details">
                                <div class="product-title">@sec.Name</div>
                                <div class="product-meta">
                                    <span>@sec.FolderCount Folders</span>
                                    <span>• @sec.SkuCount SKUs</span>
                                    <span>• @sec.Code</span>
                                </div>
                            </div>
                            <button class="card-card-action-btn" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEditSectionMode(sec)">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
else
    {
        <!-- NORMAL PACKAGE VIEW -->
        <div class="top-bar">
            <div class="top-bar-left">
                <button class="mobile-menu-btn" @onclick="TriggerToggleSidebar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>

                <div class="page-title">
                    <h2>@(IsAddMode ? $"Add {ViewType}" : ViewType)</h2>
                    <span>Management</span>
                </div>
            </div>

            @if (!IsAddMode)
            {
                <div style="display: flex; gap: 8px;">
                    <button class="add-btn" @onclick="OpenAddPackageMode" title="Add New Item">
                        +
                    </button>
                </div>
            }
            else
            {
                <div style="display: flex; gap: 8px;">
                    <button class="btn btn-secondary" style="border-radius: 20px; padding: 0.5rem 1rem;" @onclick="CloseAddMode">Cancel</button>
                    <button class="btn btn-primary" style="border-radius: 20px; padding: 0.5rem 1.5rem;" @onclick="SaveItem" disabled="@IsSaving">@(IsSaving ? "Saving..." : "Save")</button>
                </div>
            }
        </div>

        @if (!IsAddMode)
        {
            <!-- LIST VIEW -->
            <div class="action-bar-container">
                <div class="filters-bar">
                    <div style="position: relative; flex: 1; min-width: 200px;">
                        <input type="text" class="search-filter-control" style="width: 100%; padding-left: 2.2rem;" placeholder="Search @ViewType..." @bind="FilterSearchQuery" @bind:event="oninput" />
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0.8rem; top: 50%; transform: translateY(-50%);">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </div>

                    <button class="icon-btn-square @(IsFilterVisible ? "active" : "")" title="Filter" @onclick="ToggleFilterVisibility">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                    </button>

                    <button class="icon-btn-square" title="Download PDF" @onclick='() => DownloadReport("pdf")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                    </button>
                    <button class="icon-btn-square" title="Settings" @onclick="OpenSectionSettings">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    </button>
                </div>

                <div class="secs-scroll-area">
                    <button class="sec-btn @(SelectedSec == "All" ? "active" : "")" @onclick='() => SelectSec("All")'>All</button>
                    @foreach (var sec in AvailableSecs)
                    {
                        <button class="sec-btn @(SelectedSec == sec ? "active" : "")" @onclick='() => SelectSec(sec)'>@sec</button>
                    }
                </div>
            </div>

            <div class="content-area">
                <div class="product-list" style="padding: 1rem;">
                    @foreach (var item in FilteredItems)
                    {
                        <div class="product-card">
                            @if (!string.IsNullOrEmpty(item.DisplayImageUrl))
                            {
                                <img src="@item.DisplayImageUrl" alt="@item.ItemName" class="product-card-icon" style="object-fit: fill; border: 1px solid #eee; background: #fff;" />
                            }
                            else
                            {
                                <div class="product-card-icon">@((MarkupString)GetIconForCategory(item.PackageSection))</div>
                            }

                            <div class="product-details">
                                <div class="product-title">@item.ItemName</div>
                                <div class="product-meta" style="display: block;">
                                    <div>
                                        <span>@item.PackageSection</span>
                                        @if (item.Duration.HasValue)
                                        {
                                            <span> • @item.Duration min</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="product-amount-display">
                                <span>MYR @item.Price.ToString("N2")</span>
                                <button class="card-card-action-btn info-btn" title="View Details" @onclick="() => ShowItemDetailsAsync(item)">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                                </button>
                                <button class="card-card-action-btn delete-btn" @onclick="() => RequestDelete(item)" title="Delete Item">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                </button>
                            </div>
                        </div>
                    }
                    @if (!FilteredItems.Any())
                    {
                        <div class="empty-state">No items found for @ViewType.</div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- ADD PACKAGE INTERFACE -->
            <div class="add-mode-container">
                <!-- Top Image Adder -->
                <div class="add-image-section">
                    <!-- Using double quotes for the attribute to prevent parser confusion with inner quotes -->
                    <div class="image-placeholder" @onclick="OpenImageUploadPopup" style="@GetPlaceholderStyle()">
                        @if (!string.IsNullOrEmpty(_tempImagePreview))
                        {
                            <img src="@_tempImagePreview" alt="Package Image" style="width: 100%; height: 100%; object-fit: fill; border-radius: 12px;" />
                        }
                        else if (!string.IsNullOrEmpty(NewItem.DisplayImageUrl))
                        {
                            <img src="@NewItem.DisplayImageUrl" alt="Package Image" style="width: 100%; height: 100%; object-fit: fill; border-radius: 12px;" />
                        }
                        else if (string.IsNullOrEmpty(NewItem.ImageName))
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                            <span>Add Image</span>
                        }
                        else
                        {
                            <div style="font-weight: bold; color: var(--primary-rose);">@NewItem.ImageName</div>
                            <span style="font-size: 0.8rem;">Click to change</span>
                        }
                    </div>
                </div>

                <!-- Tabs -->
                <div class="add-tabs">
                    <button class="tab-btn @(ActiveAddTab == "Info" ? "active" : "")" @onclick='() => ActiveAddTab = "Info"'>Info</button>
                    <button class="tab-btn @(ActiveAddTab == "Items" ? "active" : "")" @onclick='() => ActiveAddTab = "Items"'>
                        Items
                        @if (PackageItems.Any())
                        {
                            <span class="pkg-item-badge">@PackageItems.Count</span>
                        }
                    </button>
                    <button class="tab-btn @(ActiveAddTab == "Advance" ? "active" : "")" @onclick='() => ActiveAddTab = "Advance"'>Advance</button>
                    <button class="tab-btn @(ActiveAddTab == "TC" ? "active" : "")" @onclick='() => ActiveAddTab = "TC"'>T&amp;C</button>
                    <button class="tab-btn @(ActiveAddTab == "Membership" ? "active" : "")" @onclick='() => ActiveAddTab = "Membership"'>
                        Membership
                        @if (MembershipCreditEntries.Any())
                        {
                            <span class="pkg-item-badge">@MembershipCreditEntries.Count</span>
                        }
                    </button>
                </div>

                <!-- Tab Content -->
                <div class="tab-content-area">
                    @if (ActiveAddTab == "Info")
                    {
                        <div class="form-section">
                            <div class="form-group">
                                <label>Name</label>
                                <input type="text" class="form-control" @bind="NewItem.ItemName" placeholder="Package Name" />
                            </div>
                            <div class="form-group">
                                <label>Section</label>
                                <div class="form-control clickable" @onclick="() => IsCategoryPopupOpen = true">
                                    <span>@(string.IsNullOrEmpty(NewItem.PackageSection) ? "Select Section" : NewItem.PackageSection)</span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Image URL (Folder)</label>
                                <input type="text" class="form-control" @bind="NewItem.PackageFolder" placeholder="Image Path/URL" readonly />
                            </div>

                            <!-- Credits and Points Row -->
                            <div class="row-group">
                                <div class="form-group" style="flex: 1;">
                                    <label>Credits</label>
                                    <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("Credits"))">
                                        <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.Credits.ToString("N2")</span>
                                    </div>
                                </div>
                                <div class="form-group" style="flex: 1;">
                                    <label>Points</label>
                                    <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("Points"))">
                                        <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.Points.ToString("N0")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Add Service and Add Product Buttons Row -->
                            <div class="row-group">
                                <button class="btn btn-secondary" style="flex: 1; border-color: var(--primary-rose); color: var(--primary-rose);" @onclick='() => OpenVoucherSelection("Service")'>
                                    + Add Service
                                </button>
                                <button class="btn btn-secondary" style="flex: 1; border-color: var(--primary-rose); color: var(--primary-rose);" @onclick='() => OpenVoucherSelection("Product")'>
                                    + Add Product
                                </button>
                            </div>

                            <!-- List of Added Vouchers -->
                            @if (NewItem.VoucherList.Any())
                            {
                                <div style="margin-top: 0.5rem; background: #f9f9f9; padding: 0.8rem; border-radius: 8px;">
                                    <div style="font-size: 0.85rem; color: #888; margin-bottom: 0.5rem;">Added Vouchers (@NewItem.VoucherList.Count/10):</div>
                                    @foreach (var v in NewItem.VoucherList)
                                    {
                                        <div style="display: flex; justify-content: space-between; font-size: 0.9rem; padding: 0.2rem 0;">
                                            <span>@v</span>
                                            <span style="color: red; cursor: pointer;" @onclick="() => RemoveVoucher(v)">&times;</span>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Package Value -->
                            <div class="form-group">
                                <label>Package Value</label>
                                <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("PackageValue"))">
                                    <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.PackageValue.ToString("N2")</span>
                                </div>
                                <span class="input-description">maximum 10 vouchers allowed per package</span>
                            </div>

                            <div class="form-group">
                                <label>Price (MYR)</label>
                                <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("Price"))">
                                    <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.Price.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    }
                    else if (ActiveAddTab == "Items")
                    {
                        <!-- PACKAGE ITEMS TAB -->
                        <div class="form-section">
                            <div style="display: flex; gap: 8px; margin-bottom: 1rem;">
                                <button class="pkg-add-type-btn" @onclick='() => OpenPackageItemPicker("Service")'>+ Add Service</button>
                                <button class="pkg-add-type-btn" @onclick='() => OpenPackageItemPicker("Product")'>+ Add Product</button>
                            </div>

                            @if (!PackageItems.Any())
                            {
                                <div class="empty-state" style="padding: 2rem 0;">No items added yet. Add services or products to build this package.</div>
                            }
                            else
                            {
                                <!-- Header Row -->
                                <div class="pkg-items-header">
                                    <span style="flex: 2;">Item</span>
                                    <span style="flex: 1; text-align: center;">Deferred</span>
                                    <span style="flex: 1; text-align: right;">Unit PV</span>
                                    <span style="flex: 1; text-align: center;">UOM</span>
                                    <span style="flex: 0.7; text-align: center;">Qty</span>
                                    <span style="flex: 0.3;"></span>
                                </div>
                                @foreach (var entry in PackageItems)
                                {
                                    <div class="pkg-item-row">
                                        <div class="pkg-item-name">@entry.ItemName</div>
                                        <div style="flex: 1; display: flex; justify-content: center;">
                                            <input type="checkbox" @bind="entry.IsDeferred" class="pkg-item-checkbox" title="Deferred" />
                                        </div>
                                        <div style="flex: 1;">
                                            <input type="number" class="form-control pkg-item-input" @bind="entry.UnitPV" min="0" step="0.01" />
                                        </div>
                                        <div style="flex: 1;">
                                            <select class="form-control pkg-item-input" @bind="entry.UOM">
                                                <option value="unit">unit</option>
                                                <option value="session">session</option>
                                                <option value="piece">piece</option>
                                                <option value="set">set</option>
                                                <option value="bottle">bottle</option>
                                                <option value="box">box</option>
                                                <option value="gram">gram</option>
                                                <option value="ml">ml</option>
                                            </select>
                                        </div>
                                        <div style="flex: 0.7;">
                                            <input type="number" class="form-control pkg-item-input" @bind="entry.Qty" min="1" step="1" />
                                        </div>
                                        <div style="flex: 0.3; display: flex; justify-content: center;">
                                            <button class="pkg-item-remove-btn" @onclick="() => RemovePackageItem(entry)" title="Remove">&times;</button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else if (ActiveAddTab == "Advance")
                    {
                        <div class="form-section">
                            <div class="form-group">
                                <label>Barcode</label>
                                <div class="form-control clickable" @onclick="() => IsBarcodePopupOpen = true">
                                    <span>@(string.IsNullOrEmpty(NewItem.Barcode) ? "Scan or Type Barcode" : NewItem.Barcode)</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:auto; color: #888;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="8" y1="7" x2="8" y2="17"></line><line x1="12" y1="7" x2="12" y2="17"></line><line x1="16" y1="7" x2="16" y2="17"></line></svg>
                                </div>
                            </div>

                            <div class="form-group">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                                    <label style="margin-bottom: 0;">Price Range (Min - Max)</label>
                                    <label class="switch">
                                        <input type="checkbox" checked="@IsMinMaxPriceEnabled" @onchange="ToggleMinMaxPrice">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                    <div class="row-group">
                                        <div class="form-group" style="flex: 1;">
                                            @if (IsMinMaxPriceEnabled)
                                            {
                                                <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("MinPrice"))" style="display: flex; align-items: center; justify-content: space-between;">
                                                    <span style="color: #888; font-weight: 500;">Min</span>
                                                    <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.MinPrice.ToString("N2")</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="form-control disabled" style="display: flex; align-items: center; justify-content: space-between;">
                                                    <span style="color: #aaa; font-weight: 500;">Min</span>
                                                    <span>N/A</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="form-group" style="flex: 1;">
                                            @if (IsMinMaxPriceEnabled)
                                            {
                                                <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("MaxPrice"))" style="display: flex; align-items: center; justify-content: space-between;">
                                                    <span style="color: #888; font-weight: 500;">Max</span>
                                                    <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.MaxPrice.ToString("N2")</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="form-control disabled" style="display: flex; align-items: center; justify-content: space-between;">
                                                    <span style="color: #aaa; font-weight: 500;">Max</span>
                                                    <span>N/A</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Outlet Availability</label>
                                    <div class="form-control clickable" @onclick="() => IsOutletPopupOpen = true">
                                        <span>@(SelectedOutletCodes.Any() ? $"{SelectedOutletCodes.Count} Selected" : "Select Outlets")</span>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:auto;"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                    </div>
                                </div>
                            </div>
                        }
                else if (ActiveAddTab == "TC")
                        {
                            <div class="form-section">
                                <div class="form-group">
                                    <label>Policy</label>
                                    <textarea class="form-control" @bind="NewItem.Policy" rows="3" placeholder="Policy details..."></textarea>
                                </div>
                                <div class="form-group">
                                    <label>Term & Conditions 1</label>
                                    <input type="text" class="form-control" @bind="NewItem.TermCondition1" />
                                </div>
                                <div class="form-group">
                                    <label>Term & Conditions 2</label>
                                    <input type="text" class="form-control" @bind="NewItem.TermCondition2" />
                                </div>
                                <div class="form-group">
                                    <label>Term & Conditions 3</label>
                                    <input type="text" class="form-control" @bind="NewItem.TermCondition3" />
                                </div>
                            </div>
                        }
                    else if (ActiveAddTab == "Membership")
                        {
                            <!-- MEMBERSHIP CREDIT TAB -->
                            <div class="form-section">
                                <div class="form-group">
                                    <label>Credit Expiry (Days)</label>
                                    <input type="number" class="form-control" @bind="MemberExpiryDays" min="1" placeholder="365" />
                                    <span class="input-description">Number of days before the credited amount expires after purchase.</span>
                                </div>

                                @if (MembershipCreditEntries.Any())
                                {
                                    <div class="pkg-items-header" style="margin-top: 1rem;">
                                        <span style="flex: 2;">Member Type</span>
                                        <span style="flex: 1; text-align: right;">Credit Amount</span>
                                        <span style="flex: 0.3;"></span>
                                    </div>
                                    @foreach (var (entry, idx) in MembershipCreditEntries.Select((e, i) => (e, i)))
                                    {
                                        <div class="pkg-item-row">
                                            <div class="pkg-item-name" style="flex: 2;">@GetMemberTypeName(entry.memberTypeID)</div>
                                            <div style="flex: 1; display: flex; justify-content: flex-end;">
                                                <div class="form-control clickable" style="text-align: right; max-width: 120px;"
                                                     @onclick="() => OpenCreditAmountEditor(idx)">
                                                    <span style="color: var(--primary-rose); font-weight: bold;">@entry.memberCredit.ToString("N2")</span>
                                                </div>
                                            </div>
                                            <div style="flex: 0.3; display: flex; justify-content: center;">
                                                <button class="pkg-item-remove-btn" @onclick="() => RemoveMemberType(entry)" title="Remove">&times;</button>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="empty-state" style="padding: 1.5rem 0;">No membership types configured. Add one below.</div>
                                }

                                @if (!MembershipCreditEntries.Any())
                                {
                                    <div style="margin-top: 1rem;">
                                        <button class="pkg-add-type-btn" @onclick="() => { MemberTypeSearchQuery = string.Empty; IsMemberTypePickerOpen = true; }">+ Add Member Type</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }

        <!-- NEW: DELETE CONFIRMATION POPUP -->
        @if (IsDeleteConfirmOpen)
        {
            <div class="modal-overlay" style="z-index: 3500;" @onclick="() => IsDeleteConfirmOpen = false">
                <div class="modal-content" style="max-width: 400px; padding: 2rem; text-align: center;" @onclick:stopPropagation>
                    <div style="margin-bottom: 1rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            <line x1="10" y1="11" x2="10" y2="17"></line>
                            <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                    </div>
                    <h3 style="margin-bottom: 0.5rem;">Delete Item?</h3>
                    <p style="color: #666; margin-bottom: 2rem;">
                        Are you sure you want to delete <strong>@(_itemToDelete?.ItemName)</strong>?<br />
                        This action cannot be undone.
                    </p>
                    <div style="display: flex; gap: 1rem;">
                        <button class="btn btn-secondary" style="flex: 1;" @onclick="() => IsDeleteConfirmOpen = false">Cancel</button>
                        <button class="btn btn-primary" style="flex: 1; background-color: #dc3545; border-color: #dc3545;" @onclick="ConfirmDelete" disabled="@IsSaving">Delete</button>
                    </div>
                </div>
            </div>
        }

        <!-- PACKAGE ITEM PICKER POPUP -->
        @if (IsPackageItemPickerOpen)
        {
            <div class="modal-overlay" style="z-index: 2600;" @onclick="() => IsPackageItemPickerOpen = false">
                <div class="modal-content" style="max-width: 500px; max-height: 85vh; display: flex; flex-direction: column;" @onclick:stopPropagation>
                    <div class="modal-header" style="padding: 1rem;">
                        <button class="close-btn" style="position: static;" @onclick="() => IsPackageItemPickerOpen = false">&times;</button>
                        <h3 style="flex: 1; text-align: center; margin: 0;">Select @PackageItemPickerType</h3>
                        <div style="width: 24px;"></div>
                    </div>
                    <div style="padding: 0 1rem 0.5rem 1rem; border-bottom: 1px solid #eee;">
                        <input type="text" class="search-filter-control" placeholder="Search @PackageItemPickerType..." @bind="PackageItemSearchQuery" @bind:event="oninput" style="width: 100%; margin-top: 0.5rem;" />
                    </div>
                    <div class="content-area" style="flex: 1; overflow-y: auto; padding: 1rem;">
                        <div class="product-list">
                            @foreach (var item in PackageItemPickerFiltered)
                            {
                                <div class="product-card" style="padding: 0.8rem; cursor: pointer;" @onclick="() => AddPackageItem(item)">
                                    <div class="product-details">
                                        <div class="product-title" style="font-size: 1rem;">@item.AccountName</div>
                                        <div class="product-meta" style="font-size: 0.8rem;">
                                            <span>@item.ItemGroupName</span>
                                        </div>
                                    </div>
                                    <div class="product-amount-display">
                                        <span>MYR @item.SalesPrice.ToString("N2")</span>
                                        <button class="card-card-action-btn" style="background: var(--primary-rose); color: white; border-radius: 50%; width: 28px; height: 28px; padding: 0; margin-left: 8px;">+</button>
                                    </div>
                                </div>
                            }
                            @if (!PackageItemPickerFiltered.Any())
                            {
                                <div class="empty-state">No @PackageItemPickerType found.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- MEMBER TYPE PICKER POPUP -->
        @if (IsMemberTypePickerOpen)
        {
            <div class="modal-overlay" style="z-index: 2600;" @onclick="() => IsMemberTypePickerOpen = false">
                <div class="modal-content" style="max-width: 500px; max-height: 85vh; display: flex; flex-direction: column;" @onclick:stopPropagation>
                    <div class="modal-header" style="padding: 1rem;">
                        <button class="close-btn" style="position: static;" @onclick="() => IsMemberTypePickerOpen = false">&times;</button>
                        <h3 style="flex: 1; text-align: center; margin: 0;">Select Member Type</h3>
                        <div style="width: 24px;"></div>
                    </div>
                    <div style="padding: 0 1rem 0.5rem 1rem; border-bottom: 1px solid #eee;">
                        <input type="text" class="search-filter-control" placeholder="Search member type..." @bind="MemberTypeSearchQuery" @bind:event="oninput" style="width: 100%; margin-top: 0.5rem;" />
                    </div>
                    <div class="content-area" style="flex: 1; overflow-y: auto; padding: 1rem;">
                        <div class="product-list">
                            @foreach (var mt in FilteredMemberTypes)
                            {
                                <div class="product-card" style="padding: 0.8rem; cursor: pointer;" @onclick="() => AddMemberType(mt)">
                                    <div class="product-details">
                                        <div class="product-title" style="font-size: 1rem;">@mt.MemberTypeName</div>
                                    </div>
                                    <button class="card-card-action-btn" style="background: var(--primary-rose); color: white; border-radius: 50%; width: 28px; height: 28px; padding: 0; margin-left: 8px;">+</button>
                                </div>
                            }
                            @if (!FilteredMemberTypes.Any())
                            {
                                <div class="empty-state">No member types available.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- VOUCHER SELECTION POPUP -->
        @if (IsVoucherPopupOpen)
        {
            <div class="modal-overlay" style="z-index: 2600;" @onclick="() => IsVoucherPopupOpen = false">
                <div class="modal-content" style="max-width: 500px; max-height: 85vh; display: flex; flex-direction: column;" @onclick:stopPropagation>

                    <div class="modal-header" style="padding: 1rem;">
                        <button class="close-btn" style="position: static;" @onclick="() => IsVoucherPopupOpen = false">&times;</button>
                        <h3 style="flex: 1; text-align: center; margin: 0;">Select @VoucherSelectionType</h3>
                        <div style="width: 24px;"></div>
                    </div>

                    <div style="padding: 0 1rem 0.5rem 1rem; border-bottom: 1px solid #eee;">
                        <input type="text" class="search-filter-control" placeholder="Search @VoucherSelectionType..." @bind="VoucherSearchQuery" @bind:event="oninput" style="width: 100%; margin-top: 0.5rem;" />
                    </div>

                    <div class="content-area" style="flex: 1; overflow-y: auto; padding: 1rem;">
                        <div class="product-list">
                            @foreach (var item in VoucherFilteredItems)
                            {
                                <div class="product-card" style="padding: 0.8rem; cursor: pointer;" @onclick="() => AddVoucherToPackage(item)">
                                    <div class="product-details">
                                        <div class="product-title" style="font-size: 1rem;">@item.ItemName</div>
                                        <div class="product-meta" style="font-size: 0.8rem;">
                                            <span>@item.PackageSection</span>
                                        </div>
                                    </div>
                                    <div class="product-amount-display">
                                        <span>MYR @item.Price.ToString("N2")</span>
                                        <button class="card-card-action-btn" style="background: var(--primary-rose); color: white; border-radius: 50%; width: 28px; height: 28px; padding: 0; margin-left: 8px;">+</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ERROR POPUP -->
        @if (IsErrorPopupOpen)
        {
            <div class="modal-overlay" style="z-index: 3100;" @onclick="CloseErrorPopup">
                <div class="modal-content" style="max-width: 350px; text-align: center; padding: 2rem;" @onclick:stopPropagation>
                    <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
                    <h4 style="margin: 0 0 1rem 0; color: #333;">@LangSvc.GetText("Missing Information")</h4>
                    <p style="color: #666; margin-bottom: 2rem;">@LangSvc.GetText(ErrorMessage)</p>
                    <button class="btn btn-primary" style="width: 100%;" @onclick="CloseErrorPopup">@LangSvc.GetText("ProductOK")</button>
                </div>
            </div>
        }

        <!-- CALCULATOR POPUP -->
        @if (IsAmountPopupOpen)
        {
            <div class="modal-overlay" style="z-index: 3000;" @onclick="() => IsAmountPopupOpen = false">
                <div class="modal-content" style="max-width: 350px;" @onclick:stopPropagation>
                    <div class="modal-header"><h3>Enter @(_calculatorTarget == "Points" || _calculatorTarget == "LowStockAlert" ? "Number" : "Amount")</h3><button class="close-btn" @onclick="() => IsAmountPopupOpen = false">&times;</button></div>
                    <div class="modal-body">
                        <div class="keypad-display">@_tempAmountString</div>
                        <div class="keypad-grid">
                            <button class="keypad-btn" @onclick='() => AppendToAmount("1")'>1</button><button class="keypad-btn" @onclick='() => AppendToAmount("2")'>2</button><button class="keypad-btn" @onclick='() => AppendToAmount("3")'>3</button>
                            <button class="keypad-btn" @onclick='() => AppendToAmount("4")'>4</button><button class="keypad-btn" @onclick='() => AppendToAmount("5")'>5</button><button class="keypad-btn" @onclick='() => AppendToAmount("6")'>6</button>
                            <button class="keypad-btn" @onclick='() => AppendToAmount("7")'>7</button><button class="keypad-btn" @onclick='() => AppendToAmount("8")'>8</button><button class="keypad-btn" @onclick='() => AppendToAmount("9")'>9</button>
                            <!-- Hide decimal for Integer fields -->
                            @if (_calculatorTarget == "Points" || _calculatorTarget == "LowStockAlert")
                            {
                                <button class="keypad-btn" style="visibility: hidden;">.</button>
                            }
                            else
                            {
                                <button class="keypad-btn" @onclick='() => AppendToAmount(".")'>.</button>
                            }
                            <button class="keypad-btn" @onclick='() => AppendToAmount("0")'>0</button><button class="keypad-btn" @onclick="BackspaceAmount">⌫</button>
                        </div>
                        <div style="margin-top: 1rem; display: flex; gap: 10px;">
                            <button class="btn btn-secondary" style="flex: 1;" @onclick="ClearAmount">Clear</button>
                            <button class="btn btn-primary" style="flex: 1;" @onclick="SaveAmount">Done</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- DURATION POPUP -->
        @if (IsDurationPopupOpen)
        {
            <div class="modal-overlay" style="z-index: 2000;" @onclick="() => IsDurationPopupOpen = false">
                <div class="modal-content" style="max-width: 400px;" @onclick:stopPropagation>
                    <div class="modal-header"><h3>Duration</h3><button class="close-btn" @onclick="() => IsDurationPopupOpen = false">&times;</button></div>
                    <div class="modal-body">
                        <div class="duration-grid">
                            <button class="duration-btn @(NewItem.Duration == null ? "active" : "")" @onclick='() => SelectDuration(null)'><span>Off</span></button>
                            <button class="duration-btn @(NewItem.Duration == 15 ? "active" : "")" @onclick='() => SelectDuration(15)'><span>15 min</span></button>
                            <button class="duration-btn @(NewItem.Duration == 30 ? "active" : "")" @onclick='() => SelectDuration(30)'><span>30 min</span></button>
                            <button class="duration-btn @(NewItem.Duration == 45 ? "active" : "")" @onclick='() => SelectDuration(45)'><span>45 min</span></button>
                            <button class="duration-btn @(NewItem.Duration == 60 ? "active" : "")" @onclick='() => SelectDuration(60)'><span>1 hour</span></button>
                            <button class="duration-btn @(NewItem.Duration == 75 ? "active" : "")" @onclick='() => SelectDuration(75)'><span>1 hour</span><span>15 min</span></button>
                            <button class="duration-btn @(NewItem.Duration == 90 ? "active" : "")" @onclick='() => SelectDuration(90)'><span>1 hour</span><span>30 min</span></button>
                            <button class="duration-btn @(NewItem.Duration == 105 ? "active" : "")" @onclick='() => SelectDuration(105)'><span>1 hour</span><span>45 min</span></button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- BARCODE POPUP -->
        @if (IsBarcodePopupOpen)
        {
            <div class="modal-overlay" style="z-index: 2000;" @onclick="() => IsBarcodePopupOpen = false">
                <div class="modal-content" style="max-width: 350px; padding: 1.5rem;" @onclick:stopPropagation>
                    <div class="modal-header" style="background: none; border: none; padding: 0 0 1rem 0;"><h3>Scan Barcode</h3><button class="close-btn" @onclick="() => IsBarcodePopupOpen = false">&times;</button></div>

                    <div style="display: flex; flex-direction: column; gap: 1.5rem; text-align: center;">
                        <div class="scan-btn-placeholder" style="border: 2px dashed #ccc; padding: 2rem; border-radius: 12px; cursor: pointer;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="8" y1="7" x2="8" y2="17"></line><line x1="12" y1="7" x2="12" y2="17"></line><line x1="16" y1="7" x2="16" y2="17"></line></svg>
                            <div style="margin-top: 0.5rem; color: #888; font-weight: 600;">Tap to Scan</div>
                        </div>

                        <div style="position: relative; display: flex; align-items: center; justify-content: center;">
                            <span style="background: #fff; padding: 0 10px; color: #888; z-index: 1;">OR</span>
                            <div style="position: absolute; height: 1px; background: #eee; width: 100%; top: 50%;"></div>
                        </div>

                        <div class="form-group" style="text-align: left;">
                            <label>Type Manually</label>
                            <textarea class="form-control" @bind="NewItem.Barcode" rows="2" placeholder="Enter barcode number..."></textarea>
                        </div>

                        <button class="btn btn-primary" style="width: 100%;" @onclick="() => IsBarcodePopupOpen = false">Done</button>
                    </div>
                </div>
            </div>
        }

        <!-- OUTLET POPUP -->
        @if (IsOutletPopupOpen)
        {
            <div class="modal-overlay" style="z-index: 2000;" @onclick="() => IsOutletPopupOpen = false">
                <div class="modal-content" style="max-width: 400px; max-height: 70vh; display: flex; flex-direction: column;" @onclick:stopPropagation>
                    <div class="modal-header"><h3>Select Outlet</h3><button class="close-btn" @onclick="() => IsOutletPopupOpen = false">&times;</button></div>
                    <div class="selection-list" style="flex: 1; overflow-y: auto;">
                        @foreach (var outlet in OutletList)
                        {
                            <div class="outlet-row" @onclick="() => ToggleOutletSelection(outlet.Code)">
                                <div class="custom-checkbox @(SelectedOutletCodes.Contains(outlet.Code) ? "checked" : "")">
                                    @if (SelectedOutletCodes.Contains(outlet.Code))
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    }
                                </div>
                                <div style="flex: 1;">
                                    <div style="font-weight: 600;">@outlet.Name</div>
                                    <div style="font-size: 0.85rem; color: #888;">@outlet.Code</div>
                                </div>
                            </div>
                        }
                    </div>
                    <div style="padding: 1rem; border-top: 1px solid #eee;">
                        <button class="btn btn-primary" style="width: 100%;" @onclick="() => IsOutletPopupOpen = false">Confirm</button>
                    </div>
                </div>
            </div>
        }

        <!-- MAIN FILTER POPUP -->
        @if (IsFilterPopupOpen)
        {
            <div class="modal-overlay" style="z-index: 2000;" @onclick="() => IsFilterPopupOpen = false">
                <div class="modal-content" style="max-width: 400px;" @onclick:stopPropagation>
                    <div class="modal-header" style="justify-content: flex-start; padding: 1rem 1rem;">
                        <button class="close-btn header-card-card-action-btn" style="margin-right: auto;" @onclick="() => IsFilterPopupOpen = false">X</button>
                        <h3 style="flex: 1; text-align: center;">Filters</h3>
                        <button class="close-btn header-card-card-action-btn" style="margin-left: auto; color: #666; font-size: 0.9rem;" @onclick="ResetFilters">Reset</button>
                    </div>

                    <div class="modal-body" style="padding: 1.5rem;">
                        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                            <div class="filter-row" style="display: flex; justify-content: space-between; align-items: center;">
                                <label style="font-weight: 600; color: #333;">Show Disabled Only</label>
                                <label class="switch">
                                    <input type="checkbox" @bind="FilterShowDisabledOnly">
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="form-group">
                                    <label style="font-weight: 600; color: #333; margin-bottom: 0.5rem; display: block;">Redeem Status</label>
                                    <div class="select-wrapper">
                                        <select class="form-control" @bind="FilterRedeemStatus" style="appearance: none;">
                                            <option value="All">All</option>
                                            <option value="Redeemable">Redeemable</option>
                                            <option value="Not Redeemable">Not Redeemable</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <button class="btn btn-primary" style="width: 100%; margin-top: 2rem;" @onclick="() => IsFilterPopupOpen = false">Apply Filters</button>
                        </div>
                    </div>
                </div>
            }

            <!-- CATEGORY POPUP -->
            @if (IsCategoryPopupOpen)
            {
                <div class="modal-overlay" style="z-index: 2000;" @onclick="() => IsCategoryPopupOpen = false">
                    <div class="modal-content" style="max-width: 400px;" @onclick:stopPropagation>
                        <div class="modal-header"><h3>Select Section</h3><button class="close-btn" @onclick="() => IsCategoryPopupOpen = false">&times;</button></div>
                        <div class="modal-body">
                            <div class="duration-grid" style="grid-template-columns: repeat(3, 1fr);">
                                @foreach (var cat in Categories)
                                {
                                    <button class="duration-btn @(NewItem.PackageSection == cat ? "active" : "")" @onclick="() => SelectCategoryFromPopup(cat)">
                                        <span>@cat</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- IMAGE UPLOAD POPUP -->
            @if (IsUploadPopupOpen)
            {
                <div class="modal-overlay" style="z-index: 2000;" @onclick="() => IsUploadPopupOpen = false">
                    <div class="modal-content" style="max-width: 320px; text-align: center; padding: 1.5rem;" @onclick:stopPropagation>
                        <h4 style="margin-top: 0; margin-bottom: 1.5rem;">Select Image Source</h4>
                        <div style="display: flex; gap: 1rem; justify-content: center; margin-bottom: 1.5rem;">
                            <label for="photoInput" class="upload-option-btn"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg><span>Gallery</span></label>
                            <label for="fileInput" class="upload-option-btn"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg><span>File</span></label>
                        </div>
                        <button class="btn btn-secondary" style="width: 100%; border-color: #ddd;" @onclick="() => IsUploadPopupOpen = false">Cancel</button>
                    </div>
                </div>
            }

<InputFile id="photoInput" OnChange="HandleFileSelected" style="display:none;" accept="image/*" />
<InputFile id="fileInput" OnChange="HandleFileSelected" style="display:none;" />

@code {
    private void OpenImageUploadPopup()
    {
        IsUploadPopupOpen = true;
    }

    private string GetPlaceholderStyle()
    {
        return (!string.IsNullOrEmpty(_tempImagePreview) || !string.IsNullOrEmpty(NewItem.PackageFolder))
            ? "border: none; padding: 0; overflow: hidden;"
            : "";
    }
}