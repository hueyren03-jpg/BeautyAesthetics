@page "/staff"
@inherits SenangRetails.Shared.Pages.BasePage
@using SenangRetails.Shared.Models
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Components

<div class="staff-container">

    <!-- Page Header -->
    <div class="staff-header">
        <div class="staff-header-left">
            <h2 class="staff-title">Staff Setup</h2>
            <p class="staff-subtitle">Manage staff accounts, roles, and permissions</p>
        </div>
        <button class="staff-add-btn" @onclick="OpenNewStaffForm">
            <i class="fa-solid fa-plus"></i> Add
        </button>
    </div>

    <!-- Status Filter Tabs -->
    <div class="staff-tab-bar">
        <button class="staff-tab @(GetTabClass("All"))" @onclick='() => selectedStatusTab = "All"'>All</button>
        <button class="staff-tab @(GetTabClass("Active"))" @onclick='() => selectedStatusTab = "Active"'>Active</button>
        <button class="staff-tab @(GetTabClass("Inactive"))" @onclick='() => selectedStatusTab = "Inactive"'>Inactive</button>
    </div>

    <!-- Staff List Card -->
    <div class="staff-list-card">
        <!-- Search -->
        <div class="staff-search-wrap">
            <i class="bi bi-search staff-search-icon"></i>
            <input type="text" class="staff-search-input"
                   placeholder="@SearchPlaceholder"
                   @bind="searchQuery" @bind:event="oninput" />
        </div>

        <div class="staff-count-display">
            Displaying @GetFilteredStaff().Count user(s)
        </div>

        <!-- List -->
        <div class="staff-list-body">
        @if (isLoading)
        {
            <div class="staff-loading">Loading staff...</div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="staff-error">@errorMessage</div>
        }
        else if (!GetPagedStaff().Any())
        {
            <div class="staff-empty">No staff found.</div>
        }
        else
        {
            <div class="staff-list-container">
                @foreach (var staff in GetPagedStaff())
                {
                    <div class="staff-list-item" @onclick="() => ViewStaffDetails(staff)">
                        <div class="staff-item-left">
                            <img class="profile-border" src="_content/SenangRetails.Shared/images/fluent--person-16-regular.svg" />
                            <div class="staff-info">
                                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                    <span class="staff-name">@staff.AccountName</span>
                                    @if (!string.IsNullOrEmpty(staff.CommissionSchemeName))
                                    {
                                        <span style="font-size: 0.72rem; background: #FEF3C7; color: #D97706; padding: 2px 6px; border-radius: 4px; font-weight: 600;">@staff.CommissionSchemeName</span>
                                    }
                                </div>
                                <div class="staff-phone">@(string.IsNullOrEmpty(staff.Phone) ? "No Phone" : PhoneFormatter.Format(staff.Phone))</div>
                            </div>
                        </div>
                        <div class="staff-item-right">
                            <div class="staff-chevron">›</div>
                        </div>
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="staff-pagination">
                    <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => ChangePage(currentPage - 1)">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <span class="page-info">@currentPage / @TotalPages</span>
                    <button class="page-btn" disabled="@(currentPage >= TotalPages)" @onclick="() => ChangePage(currentPage + 1)">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            }
        }
        </div>
    </div>
</div>

<!-- Add New Staff Modal -->
@if (showNewStaffForm)
{
    <div class="modal-overlay" @onclick="CloseNewStaffForm">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="edit-staff-modal-header">
                <h3 class="modal-title">Add New Staff</h3>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(validationMessage))
                {
                    <div class="form-error">@validationMessage</div>
                }

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <label class="form-label" style="margin: 0;">Staff Name <span class="required">*</span></label>
                        <div class="modal-active-row">
                            <input type="checkbox" id="staffIsActive" class="staff-checkbox"
                                   checked="@IsNewStaffActive"
                                   @onchange="OnNewStaffActiveChanged" />
                            <label for="staffIsActive" class="staff-checkbox-label">Is Active</label>
                        </div>
                    </div>
                    <input type="text" class="form-control" @bind="newStaff.AccountName" placeholder="Name" />
                </div>

                <div class="form-group">
                    <label class="form-label">Mobile Phone <span class="required">*</span></label>
                    <input type="text" readonly class="form-control" value="@PhoneFormatter.Format(newStaff.Phone)" placeholder="Phone Number" @onclick="OpenStaffPhoneNumpad" style="cursor: pointer;" />
                </div>

                <div class="form-group">
                    <label class="form-label">Staff Group</label>
                    <select class="form-control" @bind="newStaff.JobTitle">
                        <option value="">Select Group</option>
                        <option value="Manager">Manager</option>
                        <option value="Therapist">Therapist</option>
                        <option value="Receptionist">Receptionist</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Gender</label>
                    <select class="form-control" @bind="newStaff.Gender">
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Sales Person Code</label>
                    <input type="text" class="form-control" @bind="newStaff.SalesPersonCode" placeholder="0001" />
                </div>

                <div class="form-group">
                    <label class="form-label">Commission Scheme</label>
                    <select class="form-control" @bind="newStaff.CommissionSchemeId">
                        <option value="">-- No Scheme (Manual / Default) --</option>
                        @foreach (var scheme in availableSchemes)
                        {
                            <option value="@scheme.Id">@scheme.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Date Hired</label>
                    <MobileDatePicker @bind-Value="newStaff.DateHired"
                                      DateFormat="dd/MM/yyyy"
                                      Placeholder="Select Date" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseNewStaffForm">Cancel</button>
                <button class="btn-save" @onclick="SaveNewStaff" disabled="@isLoading">
                    @(isLoading ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

<!-- View / Edit Staff Modal -->
@if (showDetailsModal)
{
    <div class="modal-overlay" @onclick="CloseDetailsModal">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="edit-staff-modal-header">
                <h3 class="modal-title">Edit Staff</h3>
                <span style="font-size: 12px;font-weight: 500;">Account ID: @newStaff.MasterAccountID</span>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(validationMessage))
                {
                    <div class="form-error">@validationMessage</div>
                }

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <label class="form-label" style="margin: 0;">Staff Name <span class="required">*</span></label>
                        <div class="modal-active-row">
                            <input type="checkbox" id="editIsActive" class="staff-checkbox"
                                   checked="@IsNewStaffActive"
                                   @onchange="OnNewStaffActiveChanged" />
                            <label for="editIsActive" class="staff-checkbox-label">Is Active</label>
                        </div>
                    </div>
                    <input type="text" class="form-control" @bind="newStaff.AccountName" />
                </div>

                <div class="form-group">
                    <label class="form-label">Mobile Phone <span class="required">*</span></label>
                    <input type="text" readonly class="form-control" value="@PhoneFormatter.Format(newStaff.Phone)" placeholder="Phone Number" @onclick="OpenStaffPhoneNumpad" style="cursor: pointer;" />
                </div>

                <div class="form-group">
                    <label class="form-label">Job Title</label>
                    <input type="text" class="form-control" @bind="newStaff.JobTitle" />
                </div>

                <div class="form-group">
                    <label class="form-label">Gender</label>
                    <select class="form-control" @bind="newStaff.Gender">
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Sales Person Code</label>
                    <input type="text" class="form-control" @bind="newStaff.SalesPersonCode" />
                </div>

                <div class="form-group">
                    <label class="form-label">Commission Scheme</label>
                    <select class="form-control" @bind="newStaff.CommissionSchemeId">
                        <option value="">-- No Scheme (Manual / Default) --</option>
                        @foreach (var scheme in availableSchemes)
                        {
                            <option value="@scheme.Id">@scheme.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Date Hired</label>
                    <MobileDatePicker @bind-Value="newStaff.DateHired"
                                      DateFormat="dd/MM/yyyy"
                                      Placeholder="Select Date" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseDetailsModal">Cancel</button>
                <button class="btn-save" @onclick="UpdateStaff" disabled="@isLoading">
                    @(isLoading ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

<PhoneNumpad IsOpen="isNumpadOpen" InitialValue="@numpadInitialValue" OnSave="OnNumpadSaved" OnClose="() => isNumpadOpen = false" />

<style>
    .staff-container {
        padding: 28px 30px;
        font-family: var(--font-family, 'Segoe UI', sans-serif);
        padding: clamp(0px, 4vw, 18px) clamp(16px, 4vw, 34px);
    }

    /* --- Header --- */
    .staff-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }
    
    .staff-title {
        font-size: 28px;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
    }

    .staff-subtitle {
        color: #666;
            font-size: 14px;
    }

    .staff-add-btn {
        background-color: var(--color-primary);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: opacity 0.2s;
        flex-shrink: 0;
    }

        .staff-add-btn:hover { opacity: 0.88; }

    /* --- Tab Bar --- */
    .staff-tab-bar {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
    }

    .staff-tab {
        padding: 8px 22px;
        border-radius: 10px;
        border: 1px solid #ddd;
        background: white;
        font-size: 14px;
        font-weight: 500;
        color: #555;
        cursor: pointer;
        transition: all 0.2s;
    }

        .staff-tab.active {
            background-color: var(--color-primary);
            color: white;
            border-color: var(--color-primary);
            font-weight: 600;
        }

        .staff-tab:not(.active):hover {
            background-color: #f5f5f5;
        }

    /* --- List Card --- */
    .staff-list-card {
        background: white;
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 20px 25px;
        margin-bottom: 20px;
    }

    /* --- Search --- */
    .staff-search-wrap {
        display: flex;
        align-items: center;
        background-color: white;
        border-radius: 10px;
        gap: 10px;
        margin-bottom: 12px;
        position: relative;
    }

    .staff-search-icon {
        color: #bbb;
        font-size: 13px;
        flex-shrink: 0;
    }

    .staff-search-input {
        border: none;
        outline: none;
        font-size: 14px;
        color: #333;
        width: 100%;
        font-family: inherit;
        background: transparent;
    }

        .staff-search-input::placeholder { color: #bbb; }

    .staff-count-display {
        font-size: 13px;
        color: #888;
        margin-bottom: 16px;
        font-weight: 500;
    }

    /* --- List Body --- */
    .staff-list-body {
        width: 100%;
    }

    .staff-list-container {
        display: flex;
        flex-direction: column;
    }

    /* --- List Items --- */
    .staff-list-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        transition: background-color 0.15s;
    }

        .staff-list-item:hover { background-color: #fafafa; }
        .staff-list-item:last-child { border-bottom: none; }

    .staff-item-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .staff-item-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .profile-border {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        border: 1px solid var(--color-primary);
        aspect-ratio: 1/1;
        flex-shrink: 0;
    }

    .staff-info { flex: 1; min-width: 0; }

    .staff-name {
        font-size: 15px;
        font-weight: 600;
        color: #222;
        margin-bottom: 2px;
    }

    .staff-phone {
        font-size: 12px;
        color: #888;
    }

    .staff-chevron {
        color: var(--color-primary);
        font-size: 28px;
        font-weight: 300;
        line-height: 1;
        padding: 5px 0;
        margin-top: 3px;
    }

    /* --- States --- */
    .staff-loading, .staff-empty, .staff-error {
        padding: 40px;
        text-align: center;
        font-size: 14px;
        color: #aaa;
    }

    .staff-error { color: #e57373; }

    /* --- Pagination --- */
    .staff-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 16px;
        border-top: 1px solid #f0f0f0;
    }

    .page-btn {
        background: none;
        border: 1px solid #ddd;
        border-radius: 6px;
        width: 32px;
        height: 32px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        transition: 0.2s;
    }

        .page-btn:disabled { opacity: 0.35; cursor: not-allowed; }
        .page-btn:not(:disabled):hover { background: #f5f5f5; }

    .page-info { font-size: 13px; color: #666; }

    /* --- Modal --- */
    .modal-overlay {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background-color: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(2px);
    }

    .modal-box {
        background: white;
        border-radius: 16px;
        width: 460px;
        max-width: 94%;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 50px rgba(0,0,0,0.15);
        overflow: hidden;
    }

    .modal-header {
        padding: 20px 24px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #f0f0f0;
        flex-shrink: 0;
    }

    .modal-title {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .modal-active-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .modal-body {
        padding: 20px 24px;
        overflow-y: auto;
        flex: 1;
    }

    .modal-footer {
        padding: 16px 24px;
        display: flex;
        gap: 12px;
        border-top: 1px solid #f0f0f0;
        flex-shrink: 0;
    }

    .btn-cancel {
        flex: 1;
        padding: 13px;
        border: 1px solid #ddd;
        border-radius: 10px;
        background: white;
        font-size: 15px;
        font-weight: 600;
        color: #444;
        cursor: pointer;
        transition: 0.2s;
        font-family: inherit;
    }

        .btn-cancel:hover { background: #f5f5f5; }

    .btn-save {
        flex: 1;
        padding: 13px;
        border: none;
        border-radius: 10px;
        background-color: var(--color-primary);
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s;
        font-family: inherit;
    }

        .btn-save:hover { opacity: 0.88; }
        .btn-save:disabled { opacity: 0.5; cursor: not-allowed; }

    /* --- Form Fields --- */
    .form-group { margin-bottom: 18px; }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .required { color: var(--color-primary); }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 14px;
        font-family: inherit;
        box-sizing: border-box;
        color: #222;
        transition: border-color 0.2s;
        background: white;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--color-primary);
        }

        .form-control:disabled {
            background-color: #fafafa;
            color: #666;
        }

    .form-error {
        background: #fff0f0;
        border: 1px solid #ffcdd2;
        color: #c62828;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 16px;
    }

    /* --- Custom Checkbox --- */
    .staff-checkbox {
        appearance: none;
        -webkit-appearance: none;
        width: 18px;
        height: 18px;
        border: 1.5px solid #ccc;
        border-radius: 5px;
        background-color: white;
        cursor: pointer;
        position: relative;
        flex-shrink: 0;
        transition: border-color 0.2s;
    }

        .staff-checkbox:checked {
            background-color: var(--color-primary);
            border-color: var(--color-primary);
        }

        .staff-checkbox:checked::after {
            content: '';
            position: absolute;
            left: 5px;
            top: 1px;
            width: 5px;
            height: 10px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

    .staff-checkbox-label {
        font-size: 14px;
        font-weight: 500;
        color: #444;
        cursor: pointer;
        margin: 0;
    }

    .edit-staff-modal-header{
        display: flex;
        padding: 20px 24px 0 24px;
        justify-content: space-between;
    }
    /* --- Status Badge --- */
    .status-badge {
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
    }

        .badge-active { background: #e8f5e9; color: #2e7d32; }
        .badge-inactive { background: #f5f5f5; color: #888; }
</style>