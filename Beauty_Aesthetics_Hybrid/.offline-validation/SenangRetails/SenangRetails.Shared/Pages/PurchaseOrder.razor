@code {
    [Parameter] public EventCallback OnToggleNav { get; set; }

    private List<PurchaseOrderModel> orders = new();
    private PurchaseOrderModel currentPo = new();
    private PurchaseOrderModel? selectedPoDetail = null;

    private bool isLoading = true;
    private bool showFormModal = false;
    private bool showViewModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private string errorMessage = "";

    private string searchQuery = "";
    private string statusFilter = "All";
    private string dateFilter = "All Time";

    private int TotalOrdersCount => orders.Count;
    private int PendingDeliveryCount => orders.Count(o => o.Status == "Pending Delivery" || o.Status == "Issued");
    private decimal TotalOrdersValue => orders.Sum(o => o.TotalAmount);

    private IEnumerable<PurchaseOrderModel> FilteredOrders
    {
        get
        {
            var query = orders.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(o =>
                    o.PoNo.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    o.Vendor.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    o.Branch.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    o.Status.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (statusFilter != "All")
            {
                query = query.Where(o => o.Status.Equals(statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (dateFilter == "Today")
            {
                query = query.Where(o => o.Date.Date == DateTime.Today);
            }
            else if (dateFilter == "Last 7 Days")
            {
                query = query.Where(o => o.Date.Date >= DateTime.Today.AddDays(-7));
            }
            else if (dateFilter == "This Month")
            {
                query = query.Where(o => o.Date.Month == DateTime.Today.Month && o.Date.Year == DateTime.Today.Year);
            }

            return query.OrderByDescending(o => o.Date);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task ToggleNav()
    {
        if (OnToggleNav.HasDelegate)
            await OnToggleNav.InvokeAsync();
    }

    private async Task LoadOrdersAsync()
    {
        isLoading = true;
        try
        {
            orders = await PoService.GetPurchaseOrdersAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        var randomNum = new Random().Next(100, 999);
        currentPo = new PurchaseOrderModel
        {
            PoNo = $"PO-{DateTime.Now:yyyyMMdd}-{randomNum}",
            Date = DateTime.Today,
            Branch = AppState.CurrentBranch?.Branch ?? "HQ",
            Vendor = "",
            PoType = "Standard",
            PaymentTerm = "Net 30",
            ExpectedDelivery = DateTime.Today.AddDays(7),
            Status = "Issued",
            Remarks = "",
            Items = new List<PurchaseOrderItemModel>
            {
                new PurchaseOrderItemModel { ProductName = "Item 1", Quantity = 10, UnitCost = 10.00m }
            }
        };
        isEditMode = false;
        errorMessage = "";
        showFormModal = true;
    }

    private void OpenEditModal(PurchaseOrderModel po)
    {
        currentPo = new PurchaseOrderModel
        {
            PoNo = po.PoNo,
            Date = po.Date,
            Branch = po.Branch,
            Vendor = po.Vendor,
            PoType = po.PoType,
            PaymentTerm = po.PaymentTerm,
            ExpectedDelivery = po.ExpectedDelivery,
            Status = po.Status,
            Remarks = po.Remarks,
            Items = po.Items != null ? po.Items.Select(i => new PurchaseOrderItemModel
            {
                ProductId = i.ProductId,
                ProductName = i.ProductName,
                Quantity = i.Quantity,
                UnitCost = i.UnitCost
            }).ToList() : new List<PurchaseOrderItemModel>()
        };
        isEditMode = true;
        errorMessage = "";
        showFormModal = true;
    }

    private void OpenViewModal(PurchaseOrderModel po)
    {
        selectedPoDetail = po;
        showViewModal = true;
    }

    private void CloseFormModal() => showFormModal = false;
    private void CloseViewModal() => showViewModal = false;

    private void AddProductLine()
    {
        if (currentPo.Items == null) currentPo.Items = new();
        currentPo.Items.Add(new PurchaseOrderItemModel
        {
            ProductName = $"Item {currentPo.Items.Count + 1}",
            Quantity = 1,
            UnitCost = 0.00m
        });
    }

    private async Task SavePo()
    {
        errorMessage = "";
        if (string.IsNullOrWhiteSpace(currentPo.PoNo))
        {
            errorMessage = "PO NO is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(currentPo.Vendor))
        {
            errorMessage = "Vendor / Supplier Name is required.";
            return;
        }

        isSaving = true;
        try
        {
            var success = await PoService.SavePurchaseOrderAsync(currentPo, !isEditMode);
            if (success)
            {
                showFormModal = false;
                await LoadOrdersAsync();
            }
            else
            {
                errorMessage = "Failed to save purchase order. A PO with this number may already exist.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePo(string poNo)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete Purchase Order '{poNo}'?"))
        {
            await PoService.DeletePurchaseOrderAsync(poNo);
            await LoadOrdersAsync();
        }
    }

    private void EditFromDetail(PurchaseOrderModel po)
    {
        CloseViewModal();
        OpenEditModal(po);
    }

    private async Task DeleteFromDetail(string poNo)
    {
        CloseViewModal();
        await DeletePo(poNo);
    }

    private string GetStatusCss(string status) => status switch
    {
        "Issued" => "issued",
        "Pending Delivery" => "pending",
        "Completed" => "completed",
        "Draft" => "draft",
        "Cancelled" => "cancelled",
        _ => "issued"
    };
}
