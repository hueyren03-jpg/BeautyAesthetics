@code {
    private List<PriceGroupModel> priceGroups = new();
    private PriceGroupModel currentGroup = new();
    private List<InventoryDM> availableProducts = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private string errorMessage = "";

    // List Search filter
    private string listSearchQuery = "";

    // Product Picker filters
    private string prodSearchQuery = "";
    private string prodCategoryFilter = "";

    // Keypad State
    private bool showKeypad = false;
    private string keypadTitle = "";
    private string keypadField = "";
    private string keypadValueString = "0";

    private IEnumerable<PriceGroupModel> FilteredPriceGroups
    {
        get
        {
            if (string.IsNullOrWhiteSpace(listSearchQuery))
                return priceGroups;
            return priceGroups.Where(g =>
                (g.Code ?? "").Contains(listSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                (g.Name ?? "").Contains(listSearchQuery, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<string> availableCategories =>
        availableProducts
            .Select(p => p.ItemGroupName ?? "")
            .Where(c => !string.IsNullOrEmpty(c))
            .Distinct()
            .OrderBy(c => c);

    private IEnumerable<InventoryDM> FilteredProductsForPicker
    {
        get
        {
            var query = availableProducts.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(prodCategoryFilter))
                query = query.Where(p => string.Equals(p.ItemGroupName, prodCategoryFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(prodSearchQuery))
                query = query.Where(p => (p.AccountName ?? "").Contains(prodSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                         (p.DisplayCode ?? "").Contains(prodSearchQuery, StringComparison.OrdinalIgnoreCase));
            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            priceGroups = await PriceGroupSvc.GetPriceGroupsAsync();
            if (CacheService.HasCache && CacheService.Items != null)
            {
                availableProducts = CacheService.Items;
            }
            else
            {
                var liveItems = await InventorySvc.LoadItemsAsync("");
                availableProducts = liveItems ?? new List<InventoryDM>();
            }
        }
        catch
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetDisplayImageUrl(InventoryDM item)
    {
        return CacheService.GetImage(item.MasterAccountID ?? "")
            ?? LocalImageCache.GetImage(item.MasterAccountID ?? "")
            ?? ((!string.IsNullOrEmpty(item.ImagePath) && !string.IsNullOrEmpty(item.ImageFileName))
                ? $"{item.ImagePath}/{item.ImageFileName}" : "");
    }

    private void OpenAddModal()
    {
        currentGroup = new PriceGroupModel
        {
            Price = 0.00m,
            VisibleBranchIds = AppState.AvailableBranches != null ? AppState.AvailableBranches.ToList() : new List<string>(),
            AppliedProductIds = new List<string>()
        };
        isEditMode = false;
        errorMessage = "";
        prodSearchQuery = "";
        prodCategoryFilter = "";
        showModal = true;
    }

    private void OpenEditModal(PriceGroupModel item)
    {
        currentGroup = new PriceGroupModel
        {
            Code = item.Code,
            Name = item.Name,
            Price = item.Price,
            MlmCommRate = item.MlmCommRate,
            MlmSalesTarget = item.MlmSalesTarget,
            VisibleBranchIds = item.VisibleBranchIds != null ? item.VisibleBranchIds.ToList() : new List<string>(),
            AppliedProductIds = item.AppliedProductIds != null ? item.AppliedProductIds.ToList() : new List<string>(),
            CreatedAt = item.CreatedAt
        };
        isEditMode = true;
        errorMessage = "";
        prodSearchQuery = "";
        prodCategoryFilter = "";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private bool IsAllBranchesSelected()
    {
        if (AppState.AvailableBranches == null || !AppState.AvailableBranches.Any()) return false;
        return AppState.AvailableBranches.All(b => currentGroup.VisibleBranchIds.Contains(b));
    }

    private void ToggleSelectAllBranches(ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked && AppState.AvailableBranches != null)
        {
            currentGroup.VisibleBranchIds = AppState.AvailableBranches.ToList();
        }
        else
        {
            currentGroup.VisibleBranchIds.Clear();
        }
    }

    private void ToggleBranchSelection(string branchId)
    {
        if (currentGroup.VisibleBranchIds.Contains(branchId))
        {
            currentGroup.VisibleBranchIds.Remove(branchId);
        }
        else
        {
            currentGroup.VisibleBranchIds.Add(branchId);
        }
    }

    private void ToggleProductSelection(string productId)
    {
        if (string.IsNullOrWhiteSpace(productId)) return;
        var trimmedId = productId.Trim();
        var existing = currentGroup.AppliedProductIds.FirstOrDefault(id => string.Equals(id?.Trim(), trimmedId, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
            currentGroup.AppliedProductIds.Remove(existing);
        else
            currentGroup.AppliedProductIds.Add(trimmedId);
    }

    private void SelectAllFilteredProducts()
    {
        foreach (var p in FilteredProductsForPicker)
        {
            if (!string.IsNullOrWhiteSpace(p.MasterAccountID))
            {
                var trimmed = p.MasterAccountID.Trim();
                if (!currentGroup.AppliedProductIds.Any(id => string.Equals(id?.Trim(), trimmed, StringComparison.OrdinalIgnoreCase)))
                    currentGroup.AppliedProductIds.Add(trimmed);
            }
        }
    }

    private void ClearAllProducts()
    {
        currentGroup.AppliedProductIds.Clear();
    }

    private async Task SaveGroup()
    {
        errorMessage = "";
        if (string.IsNullOrWhiteSpace(currentGroup.Code))
        {
            errorMessage = "Price Group Code is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(currentGroup.Name))
        {
            errorMessage = "Price Group Name is required.";
            return;
        }

        isSaving = true;
        try
        {
            var success = await PriceGroupSvc.SavePriceGroupAsync(currentGroup, !isEditMode);
            if (success)
            {
                CacheService.ClearLocalPatches();
                CacheService.TriggerBackgroundRefresh();

                showModal = false;
                await LoadDataAsync();
            }
            else
            {
                errorMessage = isEditMode ? "Failed to save price group." : "A price group with this Code already exists.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteGroup(string code)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete Price Group '{code}'?"))
        {
            await PriceGroupSvc.DeletePriceGroupAsync(code);
            CacheService.ClearLocalPatches();
            CacheService.TriggerBackgroundRefresh();
            await LoadDataAsync();
        }
    }

    // Touch Keypad Methods
    private void OpenKeypad(string field, decimal currentVal, string title)
    {
        keypadField = field;
        keypadTitle = title;
        keypadValueString = currentVal == 0 ? "0" : currentVal.ToString("0.##");
        showKeypad = true;
    }

    private void KeypadAppend(string val)
    {
        if (keypadValueString == "0" && val != ".")
            keypadValueString = val;
        else if (!(val == "." && keypadValueString.Contains(".")))
            keypadValueString += val;
    }

    private void KeypadClear() => keypadValueString = "0";

    private void KeypadBackspace()
    {
        if (keypadValueString.Length > 1)
            keypadValueString = keypadValueString.Substring(0, keypadValueString.Length - 1);
        else
            keypadValueString = "0";
    }

    private void KeypadSave()
    {
        if (decimal.TryParse(keypadValueString, out var val))
        {
            if (keypadField == "Price") currentGroup.Price = Math.Max(0, val);
            else if (keypadField == "MlmCommRate") currentGroup.MlmCommRate = Math.Max(0, val);
            else if (keypadField == "MlmSalesTarget") currentGroup.MlmSalesTarget = Math.Max(0, val);
        }
        showKeypad = false;
    }

    private void CloseKeypad() => showKeypad = false;
}
