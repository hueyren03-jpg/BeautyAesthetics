@namespace SenangRetails.Shared.Components.Reports
@inherits SenangRetails.Shared.Pages.BasePage
@using Microsoft.AspNetCore.Components
@using BlazorBootstrap
@using Microsoft.JSInterop
@using System.Text

<div class="package-transaction-report-container">
    <div class="package-transaction-report-list-container">
        <!-- Date Filter Section -->
        <div class="report-date-filter">
            <div class="date-filter-controls">
                <!-- Quick Date Range Buttons -->
                <div class="quick-date-buttons">
                    <button class="quick-date-btn @(selectedDateRange == "Today" ? "active" : "")" @onclick='() => SetDateRange("Today")'>
                        @LangSvc.GetText("Today")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Week" ? "active" : "")" @onclick='() => SetDateRange("Week")'>
                        @LangSvc.GetText("This Week")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Month" ? "active" : "")" @onclick='() => SetDateRange("Month")'>
                        @LangSvc.GetText("This Month")
                    </button>
                    <button class="quick-date-btn @(selectedDateRange == "Year" ? "active" : "")" @onclick='() => SetDateRange("Year")'>
                        @LangSvc.GetText("This Year")
                    </button>
                </div>

                <!-- Date Pickers for Custom Range -->
                <div class="date-picker-group">
                    <div class="date-picker-item">
                        <label class="date-picker-label">@LangSvc.GetText("Start Date")</label>
                        <MobileDatePicker @bind-Value="startDate"
                                          DateFormat="dd/MM/yyyy"
                                          Placeholder="Select Date" />
                    </div>
                    <div class="date-picker-item">
                        <label class="date-picker-label">@LangSvc.GetText("End Date")</label>
                        <MobileDatePicker @bind-Value="endDate"
                                          DateFormat="dd/MM/yyyy"
                                          Placeholder="Select Date" />
                    </div>
                    <button class="refresh-btn" @onclick="RefreshDataAsync" title="Refresh">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>

                <!-- Export Dropdown Button -->
                <div class="export-dropdown">
                    <button class="export-btn" @onclick="ToggleExportDropdown" @onclick:preventDefault="true">
                        <i class="bi bi-download"></i>
                        <span class="action-btn-text">@LangSvc.GetText("Export")</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    @if (showExportDropdown)
                    {
                        <div class="export-dropdown-menu">
                            <button class="export-dropdown-item" @onclick="ExportToCSV">
                                <i class="bi bi-file-spreadsheet"></i>
                                @LangSvc.GetText("Export CSV")
                            </button>
                            <button class="export-dropdown-item" @onclick="ExportToPDF">
                                <i class="bi bi-file-pdf"></i>
                                @LangSvc.GetText("Export PDF")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Filter Tabs for Transaction Type -->
        <div class="report-type-tabs">
            <button class="type-tab @(selectedTransactionType == "All" ? "active" : "")"
                    @onclick="@(() => SelectTransactionType("All"))">
                <i class="bi bi-grid"></i>
                @LangSvc.GetText("ReportAll")
            </button>
            <button class="type-tab @(selectedTransactionType == "Sign Up" ? "active" : "")"
                    @onclick="@(() => SelectTransactionType("Sign Up"))">
                <i class="bi bi-plus-circle"></i>
                @LangSvc.GetText("ReportSignUp")
            </button>
            <button class="type-tab @(selectedTransactionType == "Redeem" ? "active" : "")"
                    @onclick="@(() => SelectTransactionType("Redeem"))">
                <i class="bi bi-arrow-repeat"></i>
                @LangSvc.GetText("ReportRedeem")
            </button>
        </div>

        <!-- KPI Summary Cards -->
        <div class="kpi-cards">
            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@totalTransactions.ToString("N0")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Transactions")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">@totalQuantity.ToString("N0")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Quantity")</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="kpi-content">
                    @if (isLoading)
                    {
                        <div class="kpi-value">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Small" />
                        </div>
                    }
                    else
                    {
                        <div class="kpi-value">RM @totalValue.ToString("N2")</div>
                    }
                    <div class="kpi-label">@LangSvc.GetText("Total Value")</div>
                </div>
            </div>
        </div>

        <!-- Package Movement Table with Filter Inputs -->
        <div class="package-movement-table-wrapper">
            <div class="package-movement-table">
                <div class="package-movement-table-header">
                    <div class="package-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Date")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="dateFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="package-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Doc No")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="docNoFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="package-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Customer")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="customerFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="package-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Description")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="descriptionFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="package-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Package Name")</span>
                        <input type="text"
                               class="filter-input"
                               placeholder="Filter..."
                               @bind-value="packageFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="package-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Quantity")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="quantityFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                    <div class="package-movement-table-header-cell filter-header">
                        <span>@LangSvc.GetText("Value")</span>
                        <input type="text"
                               class="filter-input numeric-filter"
                               placeholder="Filter..."
                               @bind-value="valueFilter"
                               @bind-value:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                </div>
                <div class="filter-badge-container">
                    @if (HasActiveFilters())
                    {
                        <button class="clear-filters-btn" @onclick="ClearFilters">
                            <i class="bi bi-x-circle"></i> Clear All Filters
                        </button>
                    }
                </div>
                <div class="package-movement-table-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
                            <p>Loading data...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(exportMessage))
                    {
                        <div class="alert alert-@alertType">@exportMessage</div>
                    }
                    else if (filteredMovements.Any())
                    {
                        @foreach (var movement in filteredMovements)
                        {
                            <div class="package-movement-table-row">
                                <div class="package-movement-table-cell" data-label="@LangSvc.GetText("Date")">
                                    @movement.FinancialDate.ToString("dd/MM/yyyy")
                                </div>
                                <div class="package-movement-table-cell" data-label="@LangSvc.GetText("Doc No")">
                                    @movement.DisplayCode
                                </div>
                                <div class="package-movement-table-cell" data-label="@LangSvc.GetText("Customer")">
                                    <div class="member-info">
                                        <span class="member-name">@movement.CustomerName</span>
                                    </div>
                                </div>
                                <div class="package-movement-table-cell" data-label="@LangSvc.GetText("Description")">
                                    <span class="description-text">@movement.Description</span>
                                </div>
                                <div class="package-movement-table-cell" data-label="@LangSvc.GetText("Package Name")">
                                    <div class="package-info-cell">
                                        <div class="package-icon">
                                            <i class="bi bi-gift-fill"></i>
                                        </div>
                                        <div class="package-details">
                                            <span class="package-name">@movement.PackageName</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="package-movement-table-cell" data-label="@LangSvc.GetText("Quantity")">
                                    @movement.Quantity.ToString("N0")
                                </div>
                                <div class="package-movement-table-cell" data-label="@LangSvc.GetText("Value")">
                                    <span class="value-amount">@movement.TotalPrice.ToString("N2")</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">No data available</div>
                    }
                </div>
            </div>
        </div>
    </div>
    @if (showAlertDialogModal)
    {
        <div class="modal-overlay" @onclick="CloseAlertDialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="appointment-modal-header">
                    <div class="appt-title">@alertDialogTitle</div>
                </div>
                <div class="modal-body">
                    <p>@alertDialogMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="appt-btn-primary" style="flex: 1;" @onclick="CloseAlertDialog">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }
</div>