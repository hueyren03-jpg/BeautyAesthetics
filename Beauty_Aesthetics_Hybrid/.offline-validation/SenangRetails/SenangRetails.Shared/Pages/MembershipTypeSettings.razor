@using EBI.DM
@using EBI.UC
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Services.MembershipTypeService
@inherits SenangRetails.Shared.Pages.BasePage
@inject IMembershipTypeService MembershipTypeService;
@inject IJSRuntime JS;

<div class="section-container">
    <div class="section-header">
        <div class="header-left">
            <h2>Membership</h2>
            <p>Manage membership types</p>
        </div>
        <button class="add-btn" @onclick="OpenAddModal"><i class="fa-solid fa-plus"></i> New</button>
    </div>

    <div class="">
        <div class="point-section">
            <div class="section-title-row-with-action">
                <h3>Membership Types</h3>
            </div>

            @if (membershipTypes == null || membershipTypes.Count == 0)
            {
                <div class="empty-state">No membership types found.</div>
            }
            else
            {
                <div class="list-container">
                    @foreach (var mt in membershipTypes)
                    {
                        <div class="list-item @(!mt.Active ? "item-inactive" : "")">
                            <div class="list-item-left">
                                <span class="item-name">@mt.MemberTypeName</span>
                                <span class="item-code">@mt.MemberTypeID</span>
                            </div>
                            <div class="list-item-right">
                                <span class="status-badge @(mt.Active ? "badge-active" : "badge-inactive")">
                                    @(mt.Active ? "Active" : "Inactive")
                                </span>
                                <div class="payment-action-buttons">
                                    <button class="pt-action-btn" @onclick:stopPropagation="true" @onclick="() => OpenEditModal(mt)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                    <button class="pt-action-btn pt-delete-btn" @onclick:stopPropagation="true" @onclick="() => RequestDelete(mt)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@(isEditing ? "Edit Membership Type" : "Add Membership Type")</h3>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="error-banner">@formError</div>
                }

                <div class="form-group checkbox-group">
                    <label class="checkbox-container">
                        <input type="checkbox" id="memberTypeIsActive" class="custom-checkbox" @bind="currentForm.Active" />
                        <span class="custom-checkbox-box"></span>
                        <span class="checkbox-label">Active</span>
                    </label>
                </div>

                <div class="form-group">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <label class="form-label">Code <span class="required">*</span></label>
                    </div>
                    <input type="text" class="form-control" @bind="currentForm.MemberTypeID" placeholder="e.g. GOLD" readonly="@isEditing" />
                </div>

                <div class="form-group">
                    <label class="form-label">Name <span class="required">*</span></label>
                    <input type="text" class="form-control" @bind="currentForm.MemberTypeName" placeholder="e.g. Gold Member" />
                </div>

                <div class="modal-footer">
                    <button class="close-icon-btn" @onclick="CloseModal">Cancel</button>
                    <button class="save-btn" @onclick="SaveMembershipType">Save</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- DELETE CONFIRMATION POPUP -->
@if (showDeleteModal)
{
    <div class="modal-overlay" style="z-index: 3200;" @onclick="() => showDeleteModal = false">
        <div class="modal-container" style="text-align: center; max-width: 400px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Confirm Delete</h3>
            </div>
            <div class="modal-body" style="padding: 1.5rem 2rem; display: flex; flex-direction: column; align-items: center; gap: 0.75rem;">
                @if (!string.IsNullOrEmpty(deleteError))
                {
                    <div class="error-banner">@deleteError</div>
                }
                <div style="width: 56px; height: 56px; border-radius: 50%; background: #FFF0F0; display: flex; align-items: center; justify-content: center; margin-bottom: 10px;">
                    <i class="fa-solid fa-trash" style="font-size: 1.4rem; color: var(--primary);"></i>
                </div>
                <p style="color: #555; margin: 0; font-size: 14px; line-height: 1.5;">Are you sure you want to delete membership type <strong>@nameToDelete</strong>?</p>
            </div>
            <div class="modal-footer" style="justify-content: center; gap: 10px; padding: 0 1rem 1rem 1rem;">
                <button class="close-icon-btn" @onclick="() => { showDeleteModal = false; deleteError = string.Empty; }">Cancel</button>
                <button class="save-btn" style="background-color: var(--primary); border-color: var(--primary); color: white;" @onclick="ConfirmDelete" disabled="@isSaving">
                    @(isSaving ? "..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool showModal = false;
    private bool isEditing = false;
    private string formError = "";
    private bool showDeleteModal = false;
    private string deleteError = "";
    private bool isSaving = false;
    private string nameToDelete = "";
    private string idToDelete = "";

    private List<MembershipTypeDM> membershipTypes = new();
    private MembershipTypeDM currentForm = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshList();
    }

    private async Task RefreshList()
    {
        var response = await MembershipTypeService.GetAllMembershipTypesAsync();
        if (response != null)
        {
            membershipTypes = response;
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        currentForm = new MembershipTypeDM { Active = true };
        formError = "";
        showModal = true;
    }

    private void OpenEditModal(MembershipTypeDM mt)
    {
        isEditing = true;
        currentForm = new MembershipTypeDM
        {
            // Fields we are actually using
            MemberTypeID = mt.MemberTypeID,
            MemberTypeName = mt.MemberTypeName,
            Active = mt.Active,

        };
        formError = "";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveMembershipType()
    {
        if (string.IsNullOrWhiteSpace(currentForm.MemberTypeID) || string.IsNullOrWhiteSpace(currentForm.MemberTypeName))
        {
            formError = "Code and Name are required.";
            return;
        }

        var requestPayload = new EBI.UC.MembershipType
        {
            objMembershipType = currentForm,
            lstMembershipTypeDiscount = new System.Collections.ObjectModel.ObservableCollection<MembershipType_DiscountDM>()
        };

        if (isEditing)
        {
            try
            {
                var payloadJson = System.Text.Json.JsonSerializer.Serialize(requestPayload);
                Console.WriteLine($"Update Membership Type Payload: {payloadJson}");
                await JS.InvokeVoidAsync("console.log", "Update Membership Type Payload:", requestPayload);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to log membership type payload: {ex.Message}");
            }

            await MembershipTypeService.UpdateAsync(requestPayload);
            System.Diagnostics.Debug.WriteLine("IsUpdating");
        }
        else
        {
            // currentForm.saveAction = null;
            await MembershipTypeService.CreateAsync(requestPayload);
        }

        await RefreshList();
        CloseModal();
    }

    private void RequestDelete(MembershipTypeDM mt)
    {
        idToDelete = mt.MemberTypeID;
        nameToDelete = mt.MemberTypeName;
        deleteError = "";
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (string.IsNullOrEmpty(idToDelete)) return;
        isSaving = true;
        deleteError = "";
        try
        {
            await MembershipTypeService.DeleteAsync(idToDelete);
            showDeleteModal = false;
            idToDelete = "";
            nameToDelete = "";
            await RefreshList();
        }
        catch (Exception ex)
        {
            deleteError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}

