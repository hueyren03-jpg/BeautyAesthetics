@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Services.BarcodeSetupService
@inject IBarcodeSetupService BarcodeService
@inject IJSRuntime JS

<div class="bc-settings-wrapper">
    <!-- HEADER BAR -->
    <div class="bc-header-bar">
        <div class="bc-title-group">
            <div class="bc-header-icon-wrap">
                <i class="fa-solid fa-barcode"></i>
            </div>
            <div>
                <div class="bc-title-with-badge">
                    <h2 class="bc-title">Barcode Reading Setup</h2>
                    <span class="bc-count-badge">@rules.Count rules</span>
                </div>
                <p class="bc-subtitle">Configure scanner parsing rules, embedded field lengths, and prefix formats.</p>
            </div>
        </div>
        <button class="add-btn touch-target" title="Add barcode rule" aria-label="Add barcode rule" @onclick="OpenAddModal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Add Rule</span>
        </button>
    </div>

    <!-- ALERT NOTIFICATION -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="bc-alert @(isSuccess ? "success" : "error")">
            <i class="fa-solid @(isSuccess ? "fa-circle-check" : "fa-circle-exclamation")"></i>
            <span>@alertMessage</span>
        </div>
    }

    <!-- SEARCH & FILTER TOOLBAR -->
    <div class="bc-toolbar-row">
        <div class="bc-search-box">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text"
                   placeholder="Search prefix or barcode type..."
                   @bind="searchQuery"
                   @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <button class="bc-search-clear" @onclick='() => searchQuery = ""'>✕</button>
            }
        </div>
    </div>

    <!-- CONTENT SECTION -->
    @if (isLoading)
    {
        <div class="bc-loading">
            <i class="fa-solid fa-spinner fa-spin bc-spinner-icon"></i>
            <p>Loading barcode rules...</p>
        </div>
    }
    else if (!FilteredRules.Any())
    {
        <div class="bc-empty">
            <div class="bc-empty-icon-wrap">
                <i class="fa-solid fa-barcode"></i>
            </div>
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <h4>No matching rules</h4>
                <p>No barcode rules matched "<strong>@searchQuery</strong>".</p>
                <button class="bc-btn-subtle" @onclick='() => searchQuery = ""'>Clear Search</button>
            }
            else
            {
                <h4>No barcode rules configured yet</h4>
                <p>Add barcode prefix rules to allow the POS scanner to parse item codes, embedded prices, and quantities automatically.</p>
                <button class="add-btn touch-target" @onclick="OpenAddModal">+ Add First Rule</button>
            }
        </div>
    }
    else
    {
        <!-- MOBILE CARDS VIEW (Displayed on mobile & small tablets) -->
        <div class="bc-mobile-cards-list">
            @foreach (var rule in FilteredRules)
            {
                <article class="bc-card-item" @onclick="() => OpenEditModal(rule)">
                    <div class="bc-mobile-card-head">
                        <div class="bc-mobile-prefix">@rule.Prefix</div>
                        <div class="bc-mobile-card-title">
                            <h4>@rule.BarcodeType</h4>
                            <span><i class="fa-solid @(rule.SelectionType == "QRCode" ? "fa-qrcode" : "fa-barcode")"></i> @rule.SelectionType reader</span>
                        </div>
                        <span class="bc-status-pill @(rule.IsActive ? "active" : "inactive")">
                            @(rule.IsActive ? "Active" : "Disabled")
                        </span>
                    </div>

                    <div class="bc-mobile-pattern-label">
                        <span>Parsing pattern</span>
                        <strong>@(rule.ItemCodeLength + (rule.IsQuantityFixedAsOne ? 0 : rule.QuantityLength) + rule.PriceLength + rule.ChecksumLength + (rule.Prefix?.Length ?? 0)) digits</strong>
                    </div>
                    <div class="bc-structure-strip">
                        <div class="bc-strip-segment prefix" title="Prefix">
                            <span class="strip-lbl">PRE</span>
                            <span class="strip-val">@rule.Prefix</span>
                        </div>
                        <div class="bc-strip-segment item" title="Item Code Length">
                            <span class="strip-lbl">ITEM</span>
                            <span class="strip-val">@(rule.ItemCodeLength)d</span>
                        </div>
                        @if (!rule.IsQuantityFixedAsOne && rule.QuantityLength > 0)
                        {
                            <div class="bc-strip-segment qty" title="Quantity Length">
                                <span class="strip-lbl">QTY</span>
                                <span class="strip-val">@(rule.QuantityLength)d</span>
                            </div>
                        }
                        @if (rule.PriceLength > 0)
                        {
                            <div class="bc-strip-segment price" title="Price Length & Decimals">
                                <span class="strip-lbl">PRICE</span>
                                <span class="strip-val">@(rule.PriceLength)d (.@rule.DecimalPlace)</span>
                            </div>
                        }
                        @if (rule.ChecksumLength > 0)
                        {
                            <div class="bc-strip-segment checksum" title="Checksum Length">
                                <span class="strip-lbl">CHK</span>
                                <span class="strip-val">@(rule.ChecksumLength)d</span>
                            </div>
                        }
                    </div>

                    <div class="bc-mobile-metrics">
                        <div><strong>@rule.ItemCodeLength</strong><span>Item digits</span></div>
                        <div><strong>@(rule.IsQuantityFixedAsOne ? "Fixed 1" : rule.QuantityLength.ToString())</strong><span>Quantity</span></div>
                        <div><strong>@rule.PriceLength / @rule.DecimalPlace</strong><span>Price / decimal</span></div>
                    </div>

                    <div class="bc-mobile-card-foot">
                        <div class="bc-card-flags">
                            @if (rule.BarcodeIncludesPrefix)
                            {
                                <span class="bc-flag-badge neutral"><i class="fa-solid fa-check"></i> Prefix included</span>
                            }
                            @if (rule.HasOverlappingBarcodeItem)
                            {
                                <span class="bc-flag-badge warning"><i class="fa-solid fa-triangle-exclamation"></i> Overlap</span>
                            }
                        </div>
                        <div class="bc-card-actions" @onclick:stopPropagation>
                            <button class="bc-icon-btn bc-edit-btn" title="Edit barcode rule" aria-label="Edit prefix @rule.Prefix" @onclick="() => OpenEditModal(rule)">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button class="bc-icon-btn bc-del-btn" title="Delete barcode rule" aria-label="Delete prefix @rule.Prefix" @onclick="() => ConfirmDelete(rule)">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>

        <!-- DESKTOP TABLE VIEW (Displayed on wide screens) -->
        <div class="bc-desktop-table-card">
            <div class="bc-table-scroll">
                <table class="bc-table">
                    <thead>
                        <tr>
                            <th>Prefix</th>
                            <th>Barcode Type</th>
                            <th>Format</th>
                            <th class="align-center">Item Code Length</th>
                            <th class="align-center">Quantity Length</th>
                            <th class="align-center">Qty Fixed As 1</th>
                            <th class="align-center">Price Length</th>
                            <th class="align-center">Decimal Place</th>
                            <th class="align-center">Checksum Length</th>
                            <th class="align-center">Includes Prefix</th>
                            <th class="align-center">Overlapping</th>
                            <th class="align-center">Status</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in FilteredRules)
                        {
                            <tr class="bc-touch-row" @onclick="() => OpenEditModal(rule)">
                                <td><span class="bc-prefix-badge">@rule.Prefix</span></td>
                                <td><strong class="cell-main">@rule.BarcodeType</strong></td>
                                <td>
                                    <span class="bc-format-pill">
                                        <i class="fa-solid @(rule.SelectionType == "QRCode" ? "fa-qrcode" : "fa-barcode")"></i>
                                        @rule.SelectionType
                                    </span>
                                </td>
                                <td class="align-center"><span class="cell">@rule.ItemCodeLength</span></td>
                                <td class="align-center"><span class="cell">@rule.QuantityLength</span></td>
                                <td class="align-center">
                                    <span class="bc-flag-pill @(rule.IsQuantityFixedAsOne ? "yes" : "no")">
                                        @(rule.IsQuantityFixedAsOne ? "YES" : "NO")
                                    </span>
                                </td>
                                <td class="align-center"><span class="cell">@rule.PriceLength</span></td>
                                <td class="align-center"><span class="cell">@rule.DecimalPlace</span></td>
                                <td class="align-center"><span class="cell">@rule.ChecksumLength</span></td>
                                <td class="align-center">
                                    <span class="bc-flag-pill @(rule.BarcodeIncludesPrefix ? "yes" : "no")">
                                        @(rule.BarcodeIncludesPrefix ? "YES" : "NO")
                                    </span>
                                </td>
                                <td class="align-center">
                                    <span class="bc-flag-pill @(rule.HasOverlappingBarcodeItem ? "yes" : "no")">
                                        @(rule.HasOverlappingBarcodeItem ? "YES" : "NO")
                                    </span>
                                </td>
                                <td class="align-center">
                                    <span class="bc-status-pill @(rule.IsActive ? "active" : "inactive")">
                                        @(rule.IsActive ? "Active" : "Disabled")
                                    </span>
                                </td>
                                <td style="text-align: right;">
                                    <button class="bc-icon-btn bc-edit-btn" title="Edit" @onclick="() => OpenEditModal(rule)" @onclick:stopPropagation>
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button class="bc-icon-btn bc-del-btn" title="Delete" @onclick="() => ConfirmDelete(rule)" @onclick:stopPropagation>
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- TOUCH ADD / EDIT MODAL -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-container bc-modal" @onclick:stopPropagation>
            <!-- STICKY MODAL HEADER -->
            <div class="modal-header">
                <div class="bc-modal-header-left">
                    <div class="bc-modal-icon-badge">
                        <i class="fa-solid fa-barcode"></i>
                    </div>
                    <div>
                        <h3 class="bc-modal-title">@(isEditMode ? "Edit Barcode Rule" : "Add Barcode Rule")</h3>
                        <span class="bc-modal-sub">@(isEditMode ? $"Updating prefix rule {currentRule.Prefix}" : "Configure embedded barcode parsing pattern")</span>
                    </div>
                </div>
                <button class="close-btn" @onclick="CloseModal" aria-label="Close">✕</button>
            </div>

            <!-- MODAL BODY (SCROLLABLE & BOUNDED) -->
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-banner">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@errorMessage</span>
                    </div>
                }

                <!-- LIVE PARSING VISUAL SIMULATOR -->
                <div class="bc-live-preview-box">
                    <div class="bc-preview-title">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        <span>Live Barcode Parsing Preview</span>
                    </div>
                    <div class="bc-preview-strip">
                        <span class="bc-p-seg pre" title="Prefix">@(string.IsNullOrEmpty(currentRule.Prefix) ? "21" : currentRule.Prefix)</span>
                        <span class="bc-p-seg item" title="Item Code">@(new string('X', Math.Max(1, currentRule.ItemCodeLength)))</span>
                        @if (!currentRule.IsQuantityFixedAsOne && currentRule.QuantityLength > 0)
                        {
                            <span class="bc-p-seg qty" title="Quantity">@(new string('Q', currentRule.QuantityLength))</span>
                        }
                        @if (currentRule.PriceLength > 0)
                        {
                            <span class="bc-p-seg price" title="Price">@(new string('P', currentRule.PriceLength))</span>
                        }
                        @if (currentRule.ChecksumLength > 0)
                        {
                            <span class="bc-p-seg chk" title="Checksum">@(new string('C', currentRule.ChecksumLength))</span>
                        }
                    </div>
                    <div class="bc-preview-legend">
                        <span class="leg-item"><span class="leg-dot pre"></span> Prefix (@(currentRule.Prefix?.Length ?? 2))</span>
                        <span class="leg-item"><span class="leg-dot item"></span> Item (@currentRule.ItemCodeLength)</span>
                        @if (!currentRule.IsQuantityFixedAsOne)
                        {
                            <span class="leg-item"><span class="leg-dot qty"></span> Qty (@currentRule.QuantityLength)</span>
                        }
                        <span class="leg-item"><span class="leg-dot price"></span> Price (@currentRule.PriceLength, .@currentRule.DecimalPlace)</span>
                        @if (currentRule.ChecksumLength > 0)
                        {
                            <span class="leg-item"><span class="leg-dot chk"></span> Checksum (@currentRule.ChecksumLength)</span>
                        }
                    </div>
                </div>

                <!-- SECTION 1: IDENTITY & FORMAT -->
                <div class="bc-section-card">
                    <div class="bc-section-card-header">
                        <i class="fa-solid fa-id-card"></i>
                        <span>Identity &amp; Barcode Type</span>
                    </div>

                    <!-- Prefix -->
                    <div class="form-group">
                        <label class="form-label">Prefix (2 Chars) <span class="required">*</span></label>
                        <input type="text"
                               maxlength="2"
                               class="form-control text-uppercase text-mono @(isEditMode ? "readonly" : "")"
                               placeholder="e.g. 21"
                               @bind="currentRule.Prefix"
                               disabled="@isEditMode" />
                        @if (isEditMode)
                        {
                            <span class="bc-field-hint">Prefix is unique and locked after creation.</span>
                        }
                    </div>

                    <!-- Barcode Type -->
                    <div class="form-group">
                        <label class="form-label">Barcode Type</label>
                        <select class="form-control" @bind="currentRule.BarcodeType">
                            <option value="BarCode">BarCode (Standard)</option>
                            <option value="EAN-13">EAN-13 (Standard Retail)</option>
                            <option value="Code-128">Code-128</option>
                            <option value="UPC-A">UPC-A</option>
                            <option value="Custom Embedded">Custom Embedded Barcode</option>
                        </select>
                    </div>

                    <!-- Selection Type (Barcode / QRCode) -->
                    <div class="form-group">
                        <label class="form-label">Format Selection</label>
                        <div class="touch-pill-group">
                            <button type="button"
                                    class="touch-pill @(currentRule.SelectionType == "Barcode" ? "active" : "")"
                                    @onclick='() => currentRule.SelectionType = "Barcode"'>
                                <i class="fa-solid fa-barcode"></i> Barcode
                            </button>
                            <button type="button"
                                    class="touch-pill @(currentRule.SelectionType == "QRCode" ? "active" : "")"
                                    @onclick='() => currentRule.SelectionType = "QRCode"'>
                                <i class="fa-solid fa-qrcode"></i> QRCode
                            </button>
                        </div>
                    </div>
                </div>

                <!-- SECTION 2: FIELD LENGTHS & PARSING -->
                <div class="bc-section-card">
                    <div class="bc-section-card-header">
                        <i class="fa-solid fa-ruler-combined"></i>
                        <span>Field Lengths &amp; Parsing</span>
                    </div>

                    <!-- Item Code Length -->
                    <div class="form-group">
                        <label class="form-label">Item Code Length</label>
                        <div class="picker-field" @onclick='() => OpenKeypad("ItemCodeLength", currentRule.ItemCodeLength, "Item Code Length")'>
                            <div class="picker-field-left">
                                <i class="fa-solid fa-cube picker-icon"></i>
                                <span class="picker-value">@currentRule.ItemCodeLength digits</span>
                            </div>
                            <span class="picker-tap-btn"><i class="fa-solid fa-calculator"></i> Edit</span>
                        </div>
                    </div>

                    <!-- Quantity Fixed As One Toggle -->
                    <div class="form-group">
                        <label class="form-label">Quantity Mode</label>
                        <div class="touch-pill-group">
                            <button type="button"
                                    class="touch-pill @(!currentRule.IsQuantityFixedAsOne ? "active" : "")"
                                    @onclick="() => currentRule.IsQuantityFixedAsOne = false">
                                <i class="fa-solid fa-arrow-down-9-1"></i> Extract Qty
                            </button>
                            <button type="button"
                                    class="touch-pill @(currentRule.IsQuantityFixedAsOne ? "active" : "")"
                                    @onclick="() => currentRule.IsQuantityFixedAsOne = true">
                                <i class="fa-solid fa-1"></i> Fixed as 1
                            </button>
                        </div>
                    </div>

                    <!-- Quantity Length (if not fixed) -->
                    @if (!currentRule.IsQuantityFixedAsOne)
                    {
                        <div class="form-group">
                            <label class="form-label">Quantity Length</label>
                            <div class="picker-field" @onclick='() => OpenKeypad("QuantityLength", currentRule.QuantityLength, "Quantity Length")'>
                                <div class="picker-field-left">
                                    <i class="fa-solid fa-layer-group picker-icon"></i>
                                    <span class="picker-value">@currentRule.QuantityLength digits</span>
                                </div>
                                <span class="picker-tap-btn"><i class="fa-solid fa-calculator"></i> Edit</span>
                            </div>
                        </div>
                    }

                    <!-- Price Length & Decimal Place Grid -->
                    <div class="bc-grid-2col">
                        <div class="form-group">
                            <label class="form-label">Price Length</label>
                            <div class="picker-field" @onclick='() => OpenKeypad("PriceLength", currentRule.PriceLength, "Price Length")'>
                                <div class="picker-field-left">
                                    <i class="fa-solid fa-tag picker-icon"></i>
                                    <span class="picker-value">@currentRule.PriceLength digits</span>
                                </div>
                                <span class="picker-tap-btn"><i class="fa-solid fa-calculator"></i></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Decimal Place</label>
                            <div class="picker-field" @onclick='() => OpenKeypad("DecimalPlace", currentRule.DecimalPlace, "Decimal Place")'>
                                <div class="picker-field-left">
                                    <i class="fa-solid fa-divide picker-icon"></i>
                                    <span class="picker-value">.@currentRule.DecimalPlace digits</span>
                                </div>
                                <span class="picker-tap-btn"><i class="fa-solid fa-calculator"></i></span>
                            </div>
                        </div>
                    </div>

                    <!-- Checksum Length -->
                    <div class="form-group">
                        <label class="form-label">Check Sum Length</label>
                        <div class="picker-field" @onclick='() => OpenKeypad("ChecksumLength", currentRule.ChecksumLength, "Check Sum Length")'>
                            <div class="picker-field-left">
                                <i class="fa-solid fa-shield-halved picker-icon"></i>
                                <span class="picker-value">@currentRule.ChecksumLength digits</span>
                            </div>
                            <span class="picker-tap-btn"><i class="fa-solid fa-calculator"></i> Edit</span>
                        </div>
                    </div>
                </div>

                <!-- SECTION 3: SCANNER RULES & FLAGS -->
                <div class="bc-section-card">
                    <div class="bc-section-card-header">
                        <i class="fa-solid fa-sliders"></i>
                        <span>Scanner Rules &amp; Flags</span>
                    </div>

                    <div class="bc-toggle-card @(currentRule.BarcodeIncludesPrefix ? "checked" : "")"
                         @onclick="() => currentRule.BarcodeIncludesPrefix = !currentRule.BarcodeIncludesPrefix">
                        <div class="bc-toggle-left">
                            <i class="fa-solid fa-indent"></i>
                            <div>
                                <span class="bc-toggle-title">Barcode Includes Prefix</span>
                                <span class="bc-toggle-desc">Include the 2-digit prefix when matching the item code in inventory.</span>
                            </div>
                        </div>
                        <input type="checkbox"
                               class="custom-checkbox"
                               checked="@currentRule.BarcodeIncludesPrefix"
                               @onclick:stopPropagation />
                    </div>

                    <div class="bc-toggle-card @(currentRule.HasOverlappingBarcodeItem ? "checked" : "")"
                         @onclick="() => currentRule.HasOverlappingBarcodeItem = !currentRule.HasOverlappingBarcodeItem">
                        <div class="bc-toggle-left">
                            <i class="fa-solid fa-clone"></i>
                            <div>
                                <span class="bc-toggle-title">Has Overlapping Barcode Item</span>
                                <span class="bc-toggle-desc">Support items sharing overlapping sub-barcode series.</span>
                            </div>
                        </div>
                        <input type="checkbox"
                               class="custom-checkbox"
                               checked="@currentRule.HasOverlappingBarcodeItem"
                               @onclick:stopPropagation />
                    </div>

                    <div class="bc-toggle-card @(currentRule.IsActive ? "checked" : "")"
                         @onclick="() => currentRule.IsActive = !currentRule.IsActive">
                        <div class="bc-toggle-left">
                            <i class="fa-solid fa-power-off"></i>
                            <div>
                                <span class="bc-toggle-title">Active Rule</span>
                                <span class="bc-toggle-desc">Enable this parsing rule for all active POS scanner operations.</span>
                            </div>
                        </div>
                        <input type="checkbox"
                               class="custom-checkbox"
                               checked="@currentRule.IsActive"
                               @onclick:stopPropagation />
                    </div>
                </div>
            </div>

            <!-- STICKY MODAL FOOTER -->
            <div class="prod-modal-footer">
                @if (isEditMode)
                {
                    <button class="prod-modal-cancel-btn text-danger touch-target" @onclick="() => ConfirmDelete(currentRule)">
                        <i class="fa-solid fa-trash-can"></i> Delete
                    </button>
                }
                <button class="prod-modal-cancel-btn touch-target" @onclick="CloseModal">Cancel</button>
                <button class="prod-modal-save-btn touch-target" @onclick="SaveRule" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Save Rule</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- TOUCH CALCULATOR KEYPAD MODAL -->
@if (showKeypad)
{
    <div class="modal-overlay" @onclick="CloseKeypad">
        <div class="touch-keypad-modal" @onclick:stopPropagation>
            <div class="keypad-header">
                <span class="keypad-title">Enter @keypadTitle</span>
                <span class="keypad-display">@keypadValueString</span>
            </div>
            <div class="keypad-grid">
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("7")'>7</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("8")'>8</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("9")'>9</button>
                <button type="button" class="kp-btn kp-action" @onclick="KeypadClear">CE</button>

                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("4")'>4</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("5")'>5</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("6")'>6</button>
                <button type="button" class="kp-btn kp-action" @onclick="KeypadBackspace">⌫</button>

                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("1")'>1</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("2")'>2</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("3")'>3</button>
                <button type="button" class="kp-btn kp-cancel" @onclick="CloseKeypad">Cancel</button>

                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("0")'>0</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("00")'>00</button>
                <button type="button" class="kp-btn" disabled>.</button>
                <button type="button" class="kp-btn kp-submit" @onclick="KeypadSave">OK</button>
            </div>
        </div>
    </div>
}

<!-- DELETE CONFIRMATION MODAL -->
@if (showDeleteModal && ruleToDelete != null)
{
    <div class="modal-overlay" @onclick="() => showDeleteModal = false">
        <div class="modal-container bc-del-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="bc-del-header-left">
                    <div class="bc-del-icon-badge">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <h3 class="bc-modal-title" style="color: #DC2626;">Confirm Deletion</h3>
                        <span class="bc-modal-sub">This action cannot be undone.</span>
                    </div>
                </div>
            </div>
            <div class="modal-body" style="padding: 1.25rem;">
                <p style="margin: 0; font-size: 0.95rem; color: #334155; line-height: 1.5;">
                    Are you sure you want to delete the barcode reading rule for prefix
                    <strong style="color: #0F172A; font-family: monospace; font-size: 1.1rem; background: #F1F5F9; padding: 2px 6px; border-radius: 4px;">@ruleToDelete.Prefix</strong>?
                </p>
            </div>
            <div class="prod-modal-footer">
                <button class="prod-modal-cancel-btn touch-target" @onclick="() => showDeleteModal = false">Cancel</button>
