@page "/usercontrol/{RoleType}/{Feature}"
@inherits SenangRetails.Shared.Pages.BasePage
@inject NavigationManager Navigation
@inject AppState AppState
@inject IJSRuntime JS
@using SenangRetails.Shared.Models.DTOs
@using System.Text.Json

<div class="ucd-wrap @(isLeftPanelExpanded && !isLeftPanelHidden ? "sidebar-open" : "")">

    @if (isLeftPanelExpanded && !isLeftPanelHidden)
    {
        <div class="ucd-left-backdrop" @onclick="HideLeftPanel"></div>
    }

    @if (!isLeftPanelHidden)
    {
        <div class="ucd-left @(isLeftPanelExpanded ? "expanded" : "collapsed")">
            <div class="ucd-left-panel-header">
                <div class="ucd-back" @onclick="GoBack">
                    <i class="fa-solid fa-chevron-left"></i>
                    <span>Back</span>
                </div>
                <button class="ucd-hamburger-btn" @onclick="HideLeftPanel">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
            <div class="ucd-left-title">User Groups</div>
            <div class="ucd-left-tabs">
                @if (isLoadingGroups)
                {
                    <div class="ucd-tabs-loading" style="padding: 15px; text-align: center; color: #999; font-size: 13px;">
                        <div class="spinner-border spinner-border-sm" role="status" style="margin-right: 8px;"></div>
                        <span>Loading groups...</span>
                    </div>
                }
                else if (securityGroups == null || !securityGroups.Any())
                {
                    <div class="ucd-tabs-empty" style="padding: 15px; text-align: center; color: #999; font-size: 13px;">
                        No groups found.
                    </div>
                }
                else
                {
                    @foreach (var group in securityGroups)
                    {
                        var groupName = group.UserGroupName ?? "Unnamed Group";
                        <button class="ucd-left-tab @(RoleType == groupName ? "active" : "")"
                                @onclick="() => SwitchRole(groupName)">
                            <i class="fa-solid fa-user-gear"></i>
                            <span>@groupName</span>
                        </button>
                    }
                }
            </div>
        </div>
    }

    <div class="ucd-right">
        <div class="ucd-right-header">
            <div class="ucd-right-title-bar">
                @if (isLeftPanelHidden || !isLeftPanelExpanded)
                {
                    <button class="ucd-hamburger-btn-right" @onclick="ShowLeftPanel">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                }
                <!-- Full back button - always shows text + icon on all screens -->
                <div class="back-button" @onclick="GoBack">
                    <i class="bi bi-chevron-left"></i>
                    <span>Back</span>
                </div>
                <div class="ucd-right-info">
                    <h2 class="ucd-page-title">@Feature</h2>
                    <p class="ucd-page-sub">Manage your staff access on key features</p>
                </div>
            </div>
            <div class="ucd-search-wrap">
                <i class="fa-solid fa-magnifying-glass ucd-search-icon"></i>
                <input type="text" class="ucd-search-input" placeholder="Search modules..."
                       @bind="searchQuery" @bind:event="oninput" />
            </div>
        </div>

        <!-- Selected Role/Tab Display -->
        @if (!string.IsNullOrEmpty(RoleType))
        {
            <div class="uc-selected-role-container">
                <div class="uc-selected-role-badge">
                    <i class="fa-solid fa-tag"></i>
                    <span>Selected Role:</span>
                    <strong>@RoleType</strong>
                </div>
            </div>
        }

        <div class="ucd-container-body" style="padding: 10px 0; display: flex; flex-direction: column; gap: 25px;">
            @if (isLoadingPermissions)
            {
                <div class="ucd-loading-placeholder" style="text-align: center; padding: 60px 20px; color: #888;">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem; margin-bottom: 15px;"></div>
                    <p style="font-weight: 600; font-size: 15px;">Loading modules...</p>
                </div>
            }
            else if (!permissionRecords.Any())
            {
                <div class="ucd-empty-placeholder" style="background: white; border-radius: 8px; border: 1px solid #eee; padding: 40px; text-align: center; color: #777;">
                    <i class="fa-solid fa-shield-halved" style="font-size: 40px; color: #ccc; margin-bottom: 15px; display: block;"></i>
                    <span>No structural permission lines exist in category context "@Feature".</span>
                </div>
            }
            else
            {
                @foreach (var categoryGroup in GetFilteredGroupedPermissions())
                {
                    <div class="ucd-category-section" style="background: white; border: 1px solid #eef0f2; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); overflow: hidden;">
                        <div class="ucd-card" style="margin: 0; border: none; border-radius: 0;">

                            <div class="ucd-col-header-row">
                                <div class="ucd-col-spacer">Module Name</div>
                                <div class="ucd-cells-container">
                                    <div class="ucd-col-head">View</div>
                                    <div class="ucd-col-head">Add</div>
                                    <div class="ucd-col-head">Edit</div>
                                    <div class="ucd-col-head">Delete</div>
                                    <div class="ucd-col-head">Search</div>
                                </div>
                            </div>

                            @foreach (var row in categoryGroup)
                            {
                                <div class="ucd-row">
                                    <div class="ucd-row-name">
                                        <span class="module-title">@row.ModuleName</span>
                                    </div>

                                    <div class="ucd-cells-container">
                                        <div class="ucd-col-cell"><input type="checkbox" class="ucd-cb" @bind="row.CanViewRecord" /></div>
                                        <div class="ucd-col-cell"><input type="checkbox" class="ucd-cb" @bind="row.CanAddRecord" /></div>
                                        <div class="ucd-col-cell"><input type="checkbox" class="ucd-cb" @bind="row.CanEditRecord" /></div>
                                        <div class="ucd-col-cell"><input type="checkbox" class="ucd-cb" @bind="row.CanDeleteRecord" /></div>
                                        <div class="ucd-col-cell"><input type="checkbox" class="ucd-cb" @bind="row.CanSearch" /></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="ucd-footer" style="display: flex; justify-content: flex-end; align-items: center; gap: 20px; padding: 15px 20px; border-top: 1px solid #edf2f7;">
            @if (_saveMessage != null)
            {
                <span class="ucd-save-msg @(_saveSuccess ? "ok" : "err")" style="font-weight: 600; font-size: 13px; color: @(_saveSuccess ? "#2e7d32" : "#d32f2f"); white-space: nowrap;">
                    <i class="fa-solid @(_saveSuccess ? "fa-circle-check" : "fa-triangle-exclamation")" style="margin-right: 6px;"></i> @_saveMessage
                </span>
            }

            <button class="ucd-save-btn"
                    @onclick="SaveAsync"
                    disabled="@(_isSaving || isLoadingPermissions)"
                    style="padding: 10px 24px; background: #9b3a4a; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: background 0.2s; white-space: nowrap;">
                @(_isSaving ? "Saving changes..." : "Save Changes")
            </button>
        </div>
    </div>
</div>