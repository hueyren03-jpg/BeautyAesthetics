    private void EditAddedProductQty(AddedProductModel prod)
    {
        selectedProductName = prod.Name;
        selectedProductQuantity = prod.Quantity;
        selectedProductPrice = prod.Price;
        isEditingPriceMode = true;
        editingProductRef = prod;
        productDetailsModalIsOpen = true;
    }

    private void EditAddedProductPrice(AddedProductModel prod)
    {
        selectedProductName = prod.Name;
        selectedProductQuantity = prod.Quantity;
        selectedProductPrice = prod.Price;
        isEditingPriceMode = true;
        editingProductRef = prod;
        productDetailsModalIsOpen = true;
    }

    private void RemoveAddedProduct(AddedProductModel prod)
    {
        addedProducts.Remove(prod);
    }

    private int GetDistinctItemsCount(GRNModel note)
    {
        return note.Items.Count;
    }

    private void ToggleDetailsSearch()
    {
        detailsSearchIsOpen = !detailsSearchIsOpen;
        if (!detailsSearchIsOpen)
        {
            detailsSearchQuery = "";
        }
    }

    private List<AddedProductModel> GetFilteredNoteItems(GRNModel note)
    {
        var items = note.Items;
        if (!string.IsNullOrWhiteSpace(detailsSearchQuery))
        {
            items = items.Where(i => i.Name.Contains(detailsSearchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        return items;
    }
