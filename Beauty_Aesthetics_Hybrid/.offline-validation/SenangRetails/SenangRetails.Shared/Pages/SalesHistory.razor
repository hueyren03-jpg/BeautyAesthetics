@page "/sales-history"
@inherits SenangRetails.Shared.Pages.BasePage
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Sales History</PageTitle>

<div class="sh-container">
    <!-- Top Bar -->
    <div class="sh-topbar">
        <button class="sh-back-btn" @onclick="GoBack">
            <i class="bi bi-chevron-left"></i>
            Back
        </button>
        <div class="sh-title">Sales History</div>
    </div>

    <!-- Filters -->
    <div class="sh-filter-card">
        <div class="sh-filter-group">
            <label class="sh-filter-label">Select Date</label>
            <div class="sh-date-wrapper">
                <MobileDatePicker @bind-Value="selectedDate"
                                  DateFormat="dd/MM/yyyy"
                                  Placeholder="Select Date" />
            </div>
        </div>

        <div class="sh-filter-group">
            <label class="sh-filter-label">Search by Amount</label>
            <input type="text"
                   class="sh-search-input"
                   placeholder="Search by Amount"
                   @bind="searchAmount"
                   @bind:event="oninput"
                  />
            
            <div class="sh-error-text">
                Kindly enter a number or decimal value only (e.g., 123 or 123.45). Do not include "RM" or any currency.
            </div>
            
        </div>
    </div>

    <!-- Sales Cards -->
    <div class="sh-list">
        @if (isLoading)
        {
            <div class="sh-empty"><i class="bi bi-hourglass-split"></i> Loading sales...</div>
        }
        else
        {
            @foreach (var sale in FilteredSales())
            {
                <div class="sh-card">
                    <div class="sh-card-header">
                        <div class="sh-card-date">
                            <span class="sh-label">Date:</span>
                            <span>@sale.FinancialDate.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        <div class="sh-card-amount">RM @sale.TotalAfterTax.ToString("N2")</div>
                    </div>

                    <div class="sh-card-body">
                        <div class="sh-card-row">
                            <span class="sh-label">Invoice No:</span>
                            <span class="sh-value">@sale.DisplayCode</span>
                        </div>
                        <div class="sh-card-row">
                            <span class="sh-label">Customer Name:</span>
                            <span class="sh-value">@(string.IsNullOrWhiteSpace(sale.AccountName) ? "N/A" : sale.AccountName)</span>
                        </div>
                        <div class="sh-card-row">
                            <span class="sh-label">e-Invoice Status:</span>
                            @{
                                var status = string.IsNullOrEmpty(sale.eInvoiceStatus) ? "-" : sale.eInvoiceStatus;
                                var isActive = status != "-";
                            }
                            <span class="sh-einvoice-badge @(isActive ? "sh-einvoice-active" : "sh-einvoice-inactive")">
                                @status
                            </span>
                        </div>
                    </div>

                    <div class="sh-card-actions">
                        <button class="sh-action-btn sh-btn-delete" title="Delete" @onclick="() => ConfirmDelete(sale)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                            <span>Delete</span>
                        </button>
                        <button class="sh-action-btn sh-btn-print"
                                title="Print"
                                @onclick="() => PrintSale(sale)"
                                disabled="@isPrinting">
                            @if (isPrinting && selectedDocId == sale.DocumentID)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Print...</span>
                            }
                            else
                            {
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                    <rect x="6" y="14" width="12" height="8"></rect>
                                </svg>
                                <span>Print</span>
                            }
                        </button>
                        <button class="sh-action-btn sh-btn-whatsapp" title="WhatsApp" @onclick="() => OpenWhatsAppPrompt(sale)">
                            <i class="bi bi-whatsapp"></i>
                            <span>WhatsApp</span>
                        </button>
                        <button class="sh-action-btn sh-btn-einvoice"
                                title="Download PDF"
                                @onclick="() => DownloadPdf(sale)"
                                disabled="@isDownloading">
                            @if (isDownloading && selectedDocId == sale.DocumentID)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>PDF...</span>
                            }
                            else
                            {
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="12" y1="18" x2="12" y2="12"></line>
                                    <line x1="9" y1="15" x2="15" y2="15"></line>
                                </svg>
                                <span>PDF</span>
                            }
                        </button>
                    </div>
                </div>
            }
        }

        @if (!isLoading && !FilteredSales().Any())
        {
            <div class="sh-empty">
                <i class="bi bi-receipt sh-empty-icon"></i>
                <div>No sales records found for this date.</div>
            </div>
        }
    </div>
    @if (showDeleteConfirm && saleToDelete != null)
    {
        <div class="sh-modal-overlay" @onclick="CancelDelete">
            <div class="sh-modal" @onclick:stopPropagation>
                <div class="sh-modal-icon">
                    <i class="bi bi-exclamation-triangle" style="color: #f44336;"></i>
                </div>
                <div class="sh-modal-title">Confirm Deletion</div>
                <div class="sh-modal-text">
                    Are you sure you want to delete invoice <br />
                    <strong>@saleToDelete.DisplayCode</strong>?
                </div>
                <div class="sh-modal-actions">
                    <button class="sh-modal-btn sh-modal-cancel" @onclick="CancelDelete">Keep Record</button>
                    <button class="sh-modal-btn sh-modal-confirm"
                            style="background-color: #f44336;"
                            @onclick="ExecuteDelete"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {

                            <span>Yes, Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    @if (showWhatsAppModal)
    {
        <div class="sh-modal-overlay" @onclick="() => showWhatsAppModal = false">
            <div class="sh-modal sh-whatsapp-modal" @onclick:stopPropagation>

                <div class="sh-wa-header">
                    <i class="bi bi-whatsapp sh-wa-icon"></i>
                    <div class="sh-modal-title">e-Invoice Request (WhatsApp)</div>
                </div>

                <div class="sh-wa-body">
                    <div class="sh-wa-field-wrapper">
                        <label class="sh-wa-label">WhatsApp Number</label>
                        <div class="sh-wa-input-row">
                            <i class="bi bi-telephone sh-wa-input-icon"></i>
                            <input type="tel"
                                   class="sh-wa-input"
                                   placeholder="eg. 6012xxxxxxxx"
                                   @bind="targetPhone"
                                   @bind:event="oninput" />
                        </div>
                    </div>
                </div>

                <div class="sh-wa-footer">
                    <button class="sh-wa-btn sh-wa-cancel" @onclick="() => showWhatsAppModal = false">
                        Cancel
                    </button>
                    <button class="sh-wa-btn sh-wa-send"
                            @onclick="ProcessWhatsApp"
                            disabled="@(isProcessing || !IsValidPhoneNumber)">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Sending...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-fill"></i>
                            <span>Send</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    }
</div>
