    {
        dateRangeIsOpen = true;
    }

    private void CloseDateRange()
    {
        dateRangeIsOpen = false;
    }

    private void SelectDateRange(string val)
    {
        selectedDateRange = val;
        dateRangeIsOpen = false;
    }

    private void OpenFilter()
    {
        filterIsOpen = true;
    }

    private void CloseFilter()
    {
        filterIsOpen = false;
    }

    private void OpenOrder()
    {
        orderIsOpen = true;
    }

    private void CloseOrder()
    {
        orderIsOpen = false;
    }

    private void SelectSort(string val)
    {
        selectedSort = val;
        orderIsOpen = false;
    }

    private void OpenBreakdownModal()
    {
        showBreakdownModal = true;
    }

    private void CloseBreakdownModal()
    {
        showBreakdownModal = false;
    }

    private void OpenMemberRemarksModal()
    {
        memberRemarksModalIsOpen = true;
    }

    private void CloseMemberRemarksModal()
    {
        memberRemarksModalIsOpen = false;
    }

