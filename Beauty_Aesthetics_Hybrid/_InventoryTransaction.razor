    private void CloseTransactionSalesRowModal()
    {
        transactionSalesRowModalIsOpen = false;
    }

    private void OpenOrderDetailsModal()
    {
        transactionSalesRowModalIsOpen = false;
        orderDetailsModalIsOpen = true;
    }

    private void CloseOrderDetailsModal()
    {
        orderDetailsModalIsOpen = false;
    }

    private void OpenSelectStaffModal()
    {
        selectStaffModalIsOpen = true;
    }

    private void CloseSelectStaffModal()
    {
        selectStaffModalIsOpen = false;
    }

    private void OpenEditPaymentModal()
    {
        editPaymentModalIsOpen = true;
    }

    private void CloseEditPaymentModal()
    {
        editPaymentModalIsOpen = false;
    }

    private void OpenTransactionDetailsModal()
    {
        transactionDetailsModalIsOpen = true;
    }

    private void CloseTransactionDetailsModal()
    {
        transactionDetailsModalIsOpen = false;
    }

    private void OpenTransactionSalesModal()
    {
        transactionSalesModalIsOpen = true;
    }

    private void CloseTransactionSalesModal()
    {
        transactionSalesModalIsOpen = false;
