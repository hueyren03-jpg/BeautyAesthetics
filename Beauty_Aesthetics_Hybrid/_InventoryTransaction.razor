    {
        Console.WriteLine($"Saved New Remark: {newRemarkText}");
        newRemarkText = "";
        addRemarkModalIsOpen = false;
    }

    private void OpenMemberDetailsModal()
    {
        memberDetailsModalIsOpen = true;
    }

    private void CloseMemberDetailsModal()
    {
        memberDetailsModalIsOpen = false;
    }

    private void OpenTransactionOrderProductModal()
    {
        transactionOrderProductModalIsOpen = true;
    }

    private void CloseTransactionOrderProductModal()
    {
        transactionOrderProductModalIsOpen = false;
    }

