    {
        Console.WriteLine($"Staff {selectedStaffForProduct} assigned to product.");
        transactionOrderProductModalIsOpen = false;
    }

    private void OpenTransactionSalesRowModal()
    {
        transactionSalesRowModalIsOpen = true;
