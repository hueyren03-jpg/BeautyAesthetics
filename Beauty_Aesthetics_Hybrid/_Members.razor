@if (showVoucherModal && selectedMember != null)
{
    <div class="modal-overlay" @onclick="() => showVoucherModal = false">
        <div class="modal-content package-detail-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="page-title">@LangSvc.GetText("MemberVoucherModalTitle")</div>
            </div>

            <div class="modal-body package-modal-body">
                @if (isLoadingPackages)
                {
                    <div class="package-loading">
                        <div class="spinner"></div>
                        <p>@LangSvc.GetText("MemberFetchingBalances")</p>
                    </div>
                }
                else
                {
                    <div class="package-grid-container">
                        <div class="table-scroll-wrapper" style="max-height:310px;">
                            <table class="package-table">
                                <thead>
                                    <tr>
                                        <th class="col-id">@LangSvc.GetText("MemberPackageColumn")</th>
                                        <th>@LangSvc.GetText("MemberPackageNameColumn")</th>
                                        <th>@LangSvc.GetText("MemberPackageItemColumn")</th>
                                        <th>@LangSvc.GetText("MemberPurchaseDateColumn")</th>
                                        <th>@LangSvc.GetText("MemberExpiryDateColumn")</th>
                                        <th>@LangSvc.GetText("MemberUnitValueColumn")</th>
                                        <th>@LangSvc.GetText("MemberQtyPurchasedColumn")</th>
                                        <th>@LangSvc.GetText("MemberBalanceColumn")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pkg in customerPackages)
                                    {
                                        <tr @onclick="() => SelectPackageForRedemption(pkg)"
                                            class="package-row @(selectedPackageAutoID == pkg.AutoID ? "selected-row" : "")">
                                            <td data-label="@LangSvc.GetText("MemberPackageColumn")" class="col-id">@pkg.AutoID</td>
                                            <td data-label="@LangSvc.GetText("MemberPackageNameColumn")">@pkg.PackageName</td>
                                            <td data-label="@LangSvc.GetText("MemberPackageItemColumn")">@pkg.Description</td>
                                            <td data-label="@LangSvc.GetText("MemberPurchaseDateColumn")">@pkg.FinancialDate.ToString("dd/MM/yyyy")</td>
                                            <td data-label="@LangSvc.GetText("MemberExpiryDateColumn")">@pkg.ExpiryDate.ToString("dd/MM/yyyy")</td>
                                            <td data-label="@LangSvc.GetText("MemberUnitValueColumn")">@pkg.UnitPrice.ToString("N2")</td>
                                            <td data-label="@LangSvc.GetText("MemberQtyPurchasedColumn")">@pkg.QuantityPurchased.ToString("N0")</td>
                                            <td data-label="@LangSvc.GetText("MemberBalanceColumn")">@pkg.NetBalanceAfterUtilised.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="package-grid-footer">
                            <div class="footer-left-space">
                                <span class="footer-label">@LangSvc.GetText("MemberTotalPackage"): @customerPackages.Count</span>
                            </div>
                            <div class="footer-right-align">
                                <span class="footer-label">@LangSvc.GetText("MemberTotalBalance"): @customerPackages.Sum(x => x.NetBalanceAfterUtilised).ToString("N0")</span>
                            </div>
                        </div>
                    </div>

                    <div class="redemption-history-section" style="margin-top: 5px;">
                        <div class="modal-header">
                            <div class="page-title">@LangSvc.GetText("MemberRedemptionHistory")</div>
                        </div>
                        <div class="package-grid-container" style="margin-top: 5px;">
                            <div class="table-scroll-wrapper" style="max-height: 155px;">
                                <table class="package-table">
                                    <thead>
                                        <tr>
                                            <th>@LangSvc.GetText("MemberPackageColumn")</th>
                                            <th>@LangSvc.GetText("MemberDocNoColumn")</th>
                                            <th>@LangSvc.GetText("MemberRedeemDateColumn")</th>
                                            <th>@LangSvc.GetText("MemberQtyRedeemedColumn")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (isLoadingHistory)
                                        {
                                            <tr><td colspan="5" class="text-center">@LangSvc.GetText("MemberLoadingHistory")</td></tr>
                                        }
                                        else if (redemptionHistory.Any())
                                        {
                                            @foreach (var history in redemptionHistory)
                                            {
                                                <tr>
                                                    <td data-label="@LangSvc.GetText("MemberPackageColumn")">@history.SourceDocumentLineID</td>
                                                    <td data-label="@LangSvc.GetText("MemberDocNoColumn")">@history.DocumentID</td>
                                                    <td data-label="@LangSvc.GetText("MemberRedeemDateColumn")">@history.FinancialDate.ToString("dd/MM/yyyy")</td>
                                                    <td data-label="@LangSvc.GetText("MemberQtyRedeemedColumn")">@Math.Abs(history.QuantityRedeemed).ToString("N0")</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr class="empty-row"><td colspan="5">@LangSvc.GetText("MemberNoHistoryFound")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="orders-btn-secondary" style="flex: 1;"
                        @onclick="() => showVoucherModal = false">
                    @LangSvc.GetText("MemberClose")
                </button>
                <button class="orders-btn-primary" style="flex: 1;"
                        disabled="@(selectedPackageToRedeem == null || isRedeemingPackage)"
                        @onclick="ProceedToEditPackageRedemption">
                    @if (isRedeemingPackage)
                    {
                        <span>@LangSvc.GetText("MemberLoading")</span>
                    }
                    else
                    {
                        <span>@LangSvc.GetText("MemberProceedNext")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

