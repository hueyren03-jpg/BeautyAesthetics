            </div>

            <div class="member-modal-footer profile-edit-footer">
                <div class="form-2-columns">
                    <button class="modal-button-secondary" @onclick="() => showProfileEditModal = false">@LangSvc.GetText("Cancel")</button>
                    <button class="modal-button-primary"
