                    <!-- Remarks Section -->
                    <div class="treatment-section">
                        <span class="row-label" style="margin-bottom: 14px;">
                            @LangSvc.GetText("OrdersRemarks")
                        </span>
                        <textarea @bind="editRemarks" placeholder="@LangSvc.GetText("OrdersRemarksPlaceholder")" rows="3"></textarea>
                    </div>
                </div>
                <div class="order-item-edit-modal-body-part">
                    <div class="treatment-section">
                        <div class="edit-row total-row">
                            <span class="row-label">@LangSvc.GetText("MemberCommission")</span>
                        </div>
                        <div class="staff-rows-scroll-area">
                            @for (int i = 0; i < commissionRows.Count; i++)
                            {
                                var row = commissionRows[i];
                                int displayIndex = i + 1;
                                <div class="edit-row total-row">
                                    <span class="row-label">@LangSvc.GetText("MemberCommissionStaff") @displayIndex:</span>
                                    <select @bind="row.StaffId" class="staff-select">
                                        <option value="">@LangSvc.GetText("MemberSelectStaffPlaceholder")</option>
                                        @if (!staffList.Any())
                                        {
                                            <option disabled>@LangSvc.GetText("MemberNoActiveStaff")</option>
                                        }
                                        else
                                        {
                                            @foreach (var staff in staffList)
                                            {
                                                <option value="@staff.MasterAccountID">@staff.AccountName</option>
                                            }
                                        }
                                    </select>
                                    <div class="staff-commission-amount" @onclick="() => OpenNumpadForCommission(row)">
                                        <span>@row.Amount.ToString("F2")</span>
                                    </div>
                                    <select @bind="row.CommissionType" class="commission-type-select">
                                        <option value="%">%</option>
                                        <option value="MYR">MYR</option>
                                    </select>
                                    <button type="button" class="remove-staff-btn" @onclick="() => RemoveCommissionRow(row)">&times;</button>
                                </div>
                            }
                        </div>

                        <button class="orders-btn-tertiary" style="margin-top: 14px;" @onclick="AddCommissionRow">
                            <i class="bi bi-plus-lg"></i>
                            @LangSvc.GetText("MemberAddStaff")
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="orders-btn-secondary" style="flex: 1;" @onclick="CloseEditOrderItemModal">@LangSvc.GetText("OrdersCancel")</button>
                <button class="orders-btn-primary" style="flex: 1;" @onclick="SaveOrderItemChanges">
                    @if (isAddingNewItem)
                    {
                        @LangSvc.GetText("AddToCart")
                    }
                    else
                    {
                        @LangSvc.GetText("OrdersSave")
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (showNumpadModal)
{
    <div class="modal-overlay" style="z-index: 3000;" @onclick="CloseNumpadModal">
        <div class="modal-content keypad-modal" style="max-width: 350px;" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@LangSvc.GetText("Update") @GetFriendlyFieldName(currentEditField)</h3>
                <button class="close-btn" @onclick="CloseNumpadModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="keypad-display">
                    <div class="keypad-display-wrapper">
                        @if (currentEditField == "Price" || currentEditField == "DiscountAmount")
                        {
                            <span class="keypad-display-sign prefix">RM</span>
                        }
                        <span class="keypad-display-value">@currentEditValue</span>
                        @if (currentEditField == "DiscountPercent")
                        {
                            <span class="keypad-display-sign suffix">%</span>
                        }
                    </div>
                </div>
                @if (currentEditField == "Quantity" && (decimal.Parse(currentEditValue) <= 0))
                {
                    <div style="color: var(--color-red); text-align: center; font-size: 14px; font-weight: bold; margin-top: -10px; margin-bottom: 10px;">
                        @LangSvc.GetText("MemberMinValue"): 0.01
                    </div>
                }
                <div class="keypad-grid">
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("1")'>1</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("2")'>2</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("3")'>3</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("4")'>4</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("5")'>5</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("6")'>6</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("7")'>7</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("8")'>8</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("9")'>9</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit(".")'>.</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("0")'>0</button>
                    <button class="keypad-btn" @onclick='() => HandleNumpadEdit("⌫")'>⌫</button>
                </div>
                <div style="margin-top: 1rem; display: flex; gap: 10px; padding: 1rem;">
                    <button class="orders-btn-secondary" style="flex: 1;" @onclick='() => currentEditValue = "0"'>@LangSvc.GetText("OrdersClear")</button>
                    <button class="orders-btn-primary" style="flex: 1;" @onclick="SaveNumpadValue">@LangSvc.GetText("OrdersSave")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showAlertDialogModal)
{
    <div class="modal-overlay" @onclick="() => showAlertDialogModal = false">
        <div class="modal-content" @onclick:stopPropagation style="max-width: 400px; height: auto;">
            <h4 style="margin: 0 0 1rem 0;">@alertDialogTitle</h4>
            <p style="color: var(--text-primary); margin-bottom: 2rem; font-size: 18px; line-height: 1.5;">
                @((MarkupString)alertDialogMessage)
            </p>

            <div class="modal-footer">
                <button class="orders-btn-primary" style="flex: 1;" @onclick="() => showAlertDialogModal = false">
                    @LangSvc.GetText("StatusPaid") <!-- using generic OK/Paid equivalent or static fallback if desired -->
                </button>
            </div>
        </div>
    </div>
}

@if (showBalanceModal && selectedMember != null)
{
    <div class="modal-overlay" @onclick="() => showBalanceModal = false">
        <div class="modal-content package-detail-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="page-title">@LangSvc.GetText("MemberCreditModalTitle")</div>
            </div>

            <div class="modal-body package-modal-body">
                @if (isLoadingPackages)
                {
                    <div class="package-loading">
                        <div class="spinner"></div>
                        <p>@LangSvc.GetText("MemberFetchingBalances")</p>
                    </div>
                }
                else
                {
                    <div class="package-grid-container">
                        <div class="table-scroll-wrapper" style="max-height:310px;">
                            <table class="package-table">
                                <thead>
                                    <tr>
                                        <th class="col-id">@LangSvc.GetText("MemberCreditColumn")</th>
                                        <th>@LangSvc.GetText("MemberPurchaseDateColumn")</th>
                                        <th>@LangSvc.GetText("MemberDocNoColumn")</th>
                                        <th>@LangSvc.GetText("MemberTypeColumn")</th>
                                        <th>@LangSvc.GetText("MemberPurchaseViaItemColumn")</th>
                                        <th>@LangSvc.GetText("MemberExpiryDateColumn")</th>
                                        <th>@LangSvc.GetText("MemberQtyPurchasedColumn")</th>
                                        <th>@LangSvc.GetText("MemberBalanceColumn")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (customerCreditDetails != null)
                                    {
                                        @foreach (var credit in customerCreditDetails)
                                        {
                                            <tr @onclick="() => FetchCreditHistory(credit.ARAPOutstandingID)"
                                                class="package-row @(selectedCreditArapID == credit.ARAPOutstandingID ? "selected-row" : "")">
                                                <td data-label="@LangSvc.GetText("MemberCreditColumn")" class="col-id">@credit.ARAPOutstandingID</td>
                                                <td data-label="@LangSvc.GetText("MemberPurchaseDateColumn")">@credit.FinancialDate.ToString("dd/MM/yyyy")</td>
                                                <td data-label="@LangSvc.GetText("MemberDocNoColumn")">@credit.DisplayCode</td>
                                                <td data-label="@LangSvc.GetText("MemberTypeColumn")">@credit.MemberTypeID</td>
                                                <td data-label="@LangSvc.GetText("MemberPurchaseViaItemColumn")">@credit.ItemDescription</td>
                                                <td data-label="@LangSvc.GetText("MemberExpiryDateColumn")">@credit.DueDate.ToString("dd/MM/yyyy")</td>
                                                <td data-label="@LangSvc.GetText("MemberQtyPurchasedColumn")">@credit.TotalAmount.ToString("N2")</td>
                                                <td data-label="@LangSvc.GetText("MemberBalanceColumn")">
                                                    @credit.NetBalanceAfterUtilised.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="redemption-history-section" style="margin-top: 5px;">
                        <div class="modal-header">
                            <div class="page-title">@LangSvc.GetText("MemberRedemptionHistory")</div>
                        </div>
                        <div class="package-grid-container" style="margin-top: 5px;">
                            <div class="table-scroll-wrapper" style="max-height: 155px;">
                                <table class="package-table">
                                    <thead>
                                        <tr>
                                            <th>@LangSvc.GetText("MemberCreditColumn")</th>
                                            <th>@LangSvc.GetText("MemberRedeemDateColumn")</th>
                                            <th>@LangSvc.GetText("MemberDocNoColumn")</th>
                                            <th>@LangSvc.GetText("MemberRedeemAmtColumn")</th>
                                            <th>@LangSvc.GetText("MemberBranchIDColumn")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (isLoadingCreditHistory)
                                        {
                                            <tr><td colspan="5" class="text-center">@LangSvc.GetText("MemberLoadingCreditHistory")</td></tr>
                                        }
                                        else if (creditRedemptionHistory != null && creditRedemptionHistory.Any())
                                        {
                                            @foreach (var h in creditRedemptionHistory)
                                            {
                                                <tr>
                                                    <td data-label="@LangSvc.GetText("MemberCreditColumn")">@h.SourceARAPOutstandingID</td>
                                                    <td data-label="@LangSvc.GetText("MemberRedeemDateColumn")">@h.FinancialDate.ToString("dd/MM/yyyy")</td>
                                                    <td data-label="@LangSvc.GetText("MemberDocNoColumn")">@h.DisplayCode</td>
                                                    <td data-label="@LangSvc.GetText("MemberRedeemAmtColumn")" class="text-center">@Math.Abs(h.TotalAmount).ToString("N2")</td>
                                                    <td data-label="@LangSvc.GetText("MemberBranchIDColumn")">@h.BranchID</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr class="empty-row"><td colspan="5">@LangSvc.GetText("MemberNoHistoryFound")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="orders-btn-secondary" style="flex: 1;"
                        @onclick="() => showBalanceModal = false">
                    @LangSvc.GetText("MemberClose")
                </button>
            </div>
        </div>
    </div>
}

<!-- MEMBERSHIP TYPE PICKER MODAL -->
@if (showMembershipPicker)
{
    <div class="modal-overlay" style="z-index: 5000;" @onclick="() => showMembershipPicker = false">
        <div class="modal-content" style="max-width:320px; padding: 0;" @onclick:stopPropagation>
            <div class="modal-header" style="position: relative; border-bottom: 1px solid #eee; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center;">
                <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary); text-align: center; flex-grow: 1; margin: 0;">@LangSvc.GetText("MemberSelectMembershipTier")</h3>
                <button class="close-btn" style="position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); background: none; border: none; font-size: 1.5rem; color: black !important; cursor: pointer;" @onclick="() => showMembershipPicker = false">&times;</button>
            </div>
            <div class="modal-body" style="padding: 0; overflow-y: auto; max-height: 60vh; gap: 0;">
                <div class="picker-list-row" @onclick='() => SelectMembershipType("")'>
                    <span>@LangSvc.GetText("MemberNoneTier")</span>
                </div>
                @if (!AllMembershipTypes.Any())
                {
                    <div class="empty-state" style="padding:1.5rem;font-size:0.9rem;">@LangSvc.GetText("MemberNoMembershipTiers")</div>
                }
                else
                {
                    @foreach (var type in AllMembershipTypes)
                    {
                        <div class="picker-list-row" @onclick="() => SelectMembershipType(type.MemberTypeName)">
                            <span>@type.MemberTypeName</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}
