@page "/members"
@page "/members/{MemberId}"
@inherits SenangRetails.Shared.Pages.BasePage
@using System.Collections.Generic
@using System.Linq
@using SenangRetails.Shared.Services.FilePickerService;
@using SenangRetails.Shared.Services
@using Microsoft.JSInterop
@using SenangRetails.Shared.Services.CustomerService
@using SenangRetails.Shared.Services.FileDownloadService
@inject IJSRuntime JS
@inject AppState AppState
@inject NavigationManager Nav
@inject IFileDownloadService FileDownloadService
@inject ICustomerService CustomerService
@inject IFilePickerService FilePickerService
@inject IFormFactor FormFactor

<div class="page-layout @(selectedMember != null ? "details-open" : "")">

    <div class="page-content @(selectedMember != null ? "details-open" : "")" style="position: relative;">
        <!-- Top Bar with Back Button -->
        <div class="top-bar">
            <div class="top-bar-top">
                <div class="top-bar-left">
                    <button class="back-button" @onclick="GoBack">
                        <i class="bi bi-chevron-left"></i>
                        <span>@LangSvc.GetText("MemberBack")</span>
                    </button>
                    <span class="page-title-text" style="margin-left: 8px;">@LangSvc.GetText("MemberCustomerProfile")</span>
                </div>
                <div class="header-button">
                    <button class="button-secondary" @onclick="OpenUploadMemberModal">
                        <img style="height: 20px;" src="_content/SenangRetails.Shared/images/material-symbols-light--bookmark-manager-outline.svg" /> @LangSvc.GetText("MemberImport")
                    </button>
                    <button class="button-primary" @onclick="OpenAddMemberModal">
                        <i class="bi bi-plus"></i> @LangSvc.GetText("MemberAdd")
                    </button>
                </div>
            </div>
        </div>
        <div class="member-card">
            <div class="member-card-header">
                <div style="display: flex; align-items: center; gap: 16px; flex: 1;">
                    <input @bind="SearchTerm" @bind:event="oninput" class="search-box" type="search" placeholder="🔍︎ @LangSvc.GetText("MemberSearchPlaceholder")" style="flex: 1;" />
                    <span class="page-title-subtitle primary-color">@_customerList.Count(c => !string.Equals(c.AccountStatus, "Inactive", StringComparison.OrdinalIgnoreCase)) @LangSvc.GetText("MemberTotalCustomers")</span>
                </div>
                <div class="card-header-button">
                    <button class="button-alternate"><img style="height: 20px;" src="_content/SenangRetails.Shared/images/lets-icons--export.svg" />  @LangSvc.GetText("MemberExport")</button>
                </div>
            </div>
            <div class="card-content">
                <div class="member-table-wrapper">
                    <table class="member-table">
                        <thead>
                            <tr>
                                <th class="table-body-row col-1" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberCustomerNameHeader")</th>
                                <th class="col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberPhoneHeader")</th>
                                <th class="col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberMembershipHeader")</th>
                                <th class="col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberBirthdayHeader")</th>
                                <th class="member-table-column col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberStatusHeader")</th>
                                <th class="member-table-column col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberActionsHeader")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in FilteredMembers)
                            {
                                <tr @onclick="() => SelectMember(member)" class="table-body">
                                    <td data-label="@LangSvc.GetText("MemberCustomerNameHeader")" class="table-body-row member-table-name">
                                        <img class="profile-border" src="_content/SenangRetails.Shared/images/fluent--person-16-regular.svg" />
                                        @member.AccountName
                                    </td>
                                    <td data-label="@LangSvc.GetText("MemberPhoneHeader")" class="member-table-body">
                                        @PhoneFormatter.Format(member.Phone)
                                    </td>
                                    <td data-label="@LangSvc.GetText("MemberMembershipHeader")" class="member-table-body">
                                        @member.MembershipTypeName
                                    </td>
                                    <td data-label="@LangSvc.GetText("MemberBirthdayHeader")" class="member-table-body">
                                        @member.BirthdayDay/@member.BirthdayMonth/@member.BirthdayYear
                                    </td>
                                    <td data-label="@LangSvc.GetText("MemberStatusHeader")" class="member-table-column member-table-body">
                                        @{
                                            var isActive = !string.Equals(member.AccountStatus, "Inactive", StringComparison.OrdinalIgnoreCase);
                                            <span class="@(isActive ? "status-active" : "status-inactive")">
                                                @(isActive ? LangSvc.GetText("MemberActiveLabel") : LangSvc.GetText("MemberInactiveLabel"))
                                            </span>
                                        }
                                    </td>
                                    <td data-label="@LangSvc.GetText("MemberActionsHeader")" class="member-table-column member-table-body">
                                        <i class="bi bi-pencil-square" style="cursor: pointer;" @onclick="async () => { await SelectMember(member); OpenProfileEditModal(); }" @onclick:stopPropagation></i>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @if (selectedMember != null)
        {
            <div class="modal-overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 10; border-radius: inherit; border: none; background-color: var(--color-background);" @onclick="CloseMemberDetailsModal">
                <div class="modal-content member-details-modal" style="width: 100%; height: 100%; max-width: none; max-height: none; border-radius: inherit; display: flex; flex-direction: column; margin: 0; border: none; background-color: var(--color-background);" @onclick:stopPropagation>
                    <div class="members-modal-header" style="align-items: center;">
                        <h3 @onclick="CloseMemberDetailsModal" class="back-button" style="margin-bottom: 0; display: flex; align-items: center;"><i class="bi bi-chevron-left"></i> @LangSvc.GetText("MemberBack")</h3>
                        <button class="button-primary" @onclick="ViewCart" style="display: flex; align-items: center; gap: 8px;">
                            <i class="bi bi-cart3"></i> @LangSvc.GetText("MemberOrder") 
                        </button>
                    </div>
                    <div class="modal-body" style="flex: 1; overflow-y: auto;">
                        <div class="profile-main-info-wrapper">
                            <div class="profile-stat-wrapper">
                                <div class="profile-main-info">
                                    <div class="avatar-container" @onclick="OpenProfileEditModal">
                                        <div class="avatar">
                                            <i class="bi bi-person profile-picture"></i>
                                        </div>
                                    </div>
                                    <div class="profile-info">
                                        <div class="member-name-wrapper" style="align-items: center;">
                                            <span class="selected-member-name">@selectedMember.AccountName</span>
                                            @if (!String.IsNullOrEmpty(selectedMember.MembershipTypeName))
                                            {
 
                                                <span class="selected-member-membership">
                                                    @selectedMember.MembershipTypeName
                                                </span>
                                            }
                                            @{
                                                var isActive = !string.Equals(selectedMember.AccountStatus, "Inactive", StringComparison.OrdinalIgnoreCase);
                                                <span class="@(isActive ? "status-active" : "status-inactive")">
                                                    @(isActive ? LangSvc.GetText("MemberActiveLabel") : LangSvc.GetText("MemberInactiveLabel"))
                                                </span>
                                            }
                                        </div>
                                        <span class="page-title-subtitle">@PhoneFormatter.Format(selectedMember.Phone)</span>
                                        <span class="page-title-subtitle">@LangSvc.GetText("MemberSince") @FormatDate(selectedMember.CreatedDateTime, "Short")</span>
                                    </div>
                                    <div class="member-option-wrapper">
                                        <div class="member-option">
                                            <i class="bi bi-telephone-forward" style="cursor: pointer;" @onclick="async () => { contactMember = selectedMember; await ConfirmCall(); }"></i>
                                            <i class="bi bi-whatsapp" style="cursor: pointer;" @onclick="async () => { contactMember = selectedMember; await OpenWhatsApp(); }"></i>
                                            <i @onclick="OpenProfileEditModal" class="bi bi-pencil-square" style="cursor: pointer;"></i>
                                            
                                        </div>
                                        <div>
                                            <div class="tag-id page-title-subtitle">@selectedMember.MasterAccountID</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="stats-card">
 
                                    <div class="pill card" style="cursor:pointer;">
                                        <span class="card-icon"><i class="bi bi-currency-dollar"></i></span>
                                        <span class="balance">@(otherBalanceSummary?.Outstanding.ToString("N2") ?? "0.00")</span>
                                        <div class="pill-label page-title-subtitle">@LangSvc.GetText("MemberOutstanding")</div>
                                    </div>
                                    <div class="pill voucher card" @onclick="OpenPackageModal" style="cursor:pointer;">
                                        <span class="card-icon"><img src="_content/SenangRetails.Shared/images/circum--wallet.svg" alt="Alternate Text" /></span>
                                        <span class="balance">@creditResponseDTO.PackageBalance</span>
                                        <div class="pill-label page-title-subtitle">@LangSvc.GetText("MemberTotalPackage")</div>
                                    </div>
                                    <div class="pill credit card" @onclick="@(() => OpenBalanceModal(false))" style="cursor:pointer;">
                                        <span class="card-icon"><i class="bi bi-star"></i></span>
                                        <span class="balance">@creditResponseDTO.CreditBalance</span>
                                        <div class="pill-label page-title-subtitle">@LangSvc.GetText("MemberTotalCredit")</div>
                                    </div>
                                    <div class="pill points card" style="cursor:pointer;">
                                        <span class="card-icon"><i class="bi bi-gift"></i></span>
                                        <span class="balance">@creditResponseDTO.PointBalance</span>
                                        <div class="pill-label page-title-subtitle">@LangSvc.GetText("MemberTotalPoints")</div>
 
                                    </div>
                                </div>
                            </div>
 
                        </div>
                        <div class="package-appointment-wrapper">
                            <div class="packages-card">
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <span class="modal-title" style="margin-bottom: 0;"><img src="_content/SenangRetails.Shared/images/circum--wallet-black.svg" alt="Alternate Text" /> @LangSvc.GetText("MemberActivePackages")</span>
                                </div>
                                <div class="package-list">
                                    @if (ActivePackages != null && ActivePackages.Any())
                                    {
 
                                        @foreach (var package in ActivePackages)
                                        {
                                            <div class="package-info-wrapper">
                                                <span class="package-name">@package.PackageName</span>
                                                <div class="column-2-end">
                                                    <span class="page-title-subtitle">@LangSvc.GetText("MemberAvailablePackage")</span>
                                                    <span class="page-title-subtitle-color">@package.NetBalanceAfterUtilised.ToString("N0")</span>
                                                </div>
                                                <div class="column-2-end">
                                                    <span class="page-title-subtitle">@LangSvc.GetText("MemberExpires")</span>
                                                    <span class="page-title-subtitle">@FormatDate(package.ExpiryDate, "Short")</span>
                                                </div>
                                            </div>
                                        }
 
                                    }
                                    else
                                    {
                                        <div style="margin: auto;">
                                            @LangSvc.GetText("MemberNoActivePackage")
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="packages-card">
                            <div class="purchase-history-header">
                                <span class="modal-title">
                                    <i class="bi bi-cart2"></i> <span>@LangSvc.GetText("MemberPurchaseHistoryByMonth")</span>
                                </span>
                            </div>
                            <div class="purchase-history-table-wrapper">
                                <table class="purchase-history-table">
                                    <thead>
                                        <tr>
                                            <th class="purchase-history-table-body-row col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberDate")</th>
                                            <th class="col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberService")</th>
                                            <th class="purchase-history-table-column col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberQuantity")</th>
                                            <th class="purchase-history-table-column col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberDiscount")</th>
                                            <th class="purchase-history-table-column col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberStaff")</th>
                                            <th class="purchase-history-table-right col-2" style="font-size: 20px; font-weight: 500;">@LangSvc.GetText("MemberAmount")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (isLoadingServiceRecords)
                                        {
                                            <tr>
                                                <td colspan="6" style="text-align: center; padding: 20px; color: var(--text-tertiary);">@LangSvc.GetText("MemberLoading")</td>
                                            </tr>
                                        }
                                        else if (customerServiceRecords == null || !customerServiceRecords.Any())
                                        {
                                            <tr>
                                                <td colspan="6" style="text-align: center; padding: 20px; color: var(--text-tertiary);">@LangSvc.GetText("MemberNoPurchaseHistoryCurrentMonth")</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var record in customerServiceRecords)
                                            {
                                                <tr class="purchase-history-table-body">
                                                    <td data-label="@LangSvc.GetText("MemberDate")" class="purchase-history-table-body-row purchase-history-table-name">
                                                        @record.RecordDate.ToString("dd/MM/yyyy")
                                                    </td>
                                                    <td data-label="@LangSvc.GetText("MemberService")" class="purchase-history-table-name">
                                                        @record.ItemName
                                                    </td>
                                                    <td data-label="@LangSvc.GetText("MemberQuantity")" class="purchase-history-table-column">
                                                        @record.Quantity
                                                    </td>
                                                    <td data-label="@LangSvc.GetText("MemberDiscount")" class="purchase-history-table-column">
                                                        @(record.DiscountAmount > 0 ? $"RM {record.DiscountAmount.ToString("F2")}" : "-")
                                                    </td>
                                                    <td data-label="@LangSvc.GetText("MemberStaff")" class="purchase-history-table-column">
                                                        
                                                    </td>
                                                    <td data-label="@LangSvc.GetText("MemberAmount")" class="purchase-history-table-right">
                                                        RM @record.SubTotal.ToString("F2")
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
      
                        @*  <div class="photos-section">
                            <div class="section-header">
                                <h4>Photos</h4>
                                <span class="subtitle">Member gallery</span>
                                <span class="view-more">→</span>
                            </div>
                            <div class="photo-grid">
                                @if (selectedMember.Photos?.Any() == true)
                                {
                                    @foreach (var photo in selectedMember.Photos)
                                    {
                                        <div class="photo-item">
                                            <img src="@photo" alt="Member photo" style="width:100%; height:100%; object-fit:cover; border-radius:12px;" />
                                        </div>
                                    }
                                }
                                else
                                {

                                }
                                <div class="photo-item add" @onclick="OpenPhotoUploadModal">
                                    <span>+</span>
                                </div>
                            </div>
                        </div> *@

                        @* <h4 class="section-title">@LangSvc.GetText("QuickAccess")</h4>
                            <div class="feature-grid">
                                <div class="feature-item" @onclick="OpenBreakdown"><div class="icon">🕘</div><span>@LangSvc.GetText("Breakdown")</span></div> *@
                        @*  <div class="feature-item" @onclick="OpenRemarks"><div class="icon">📝</div><span>Remarks</span></div>
                                <div class="feature-item" @onclick="OpenChecklist"><div class="icon">🗹</div><span>Checklist</span></div>
                                <div class="feature-item" @onclick="OpenReferral"><div class="icon">🎁</div><span>Referral</span></div> *@
                        @* <div class="feature-item" @onclick="OpenMessage"><div class="icon">💬</div><span>@LangSvc.GetText("MessageAction")</span></div>*@                    @*  <div class="feature-item" @onclick="OpenForm"><div class="icon">📄</div><span>Form</span></div> *@
                        @* <div class="feature-item" @onclick="OpenDocument"><div class="icon">📑</div><span>Document</span></div> *@
                        @* <div class="feature-item" @onclick="OpenBroadcast"><div class="icon">🔊</div><span>@LangSvc.GetText("Broadcast")</span></div> *@
                        @*  <div class="feature-item" @onclick="OpenBeautyRecord"><div class="icon">🗂️</div><span>Beauty Record</span></div>
                                <div class="feature-item" @onclick="OpenConsentForm"><div class="icon">✅</div><span>Consent Form</span></div>
                                <div class="feature-item" @onclick="OpenEngagement"><div class="icon">👥</div><span>Engagement</span></div>
                                <div class="feature-item" @onclick="OpenFamily"><div class="icon">👨‍👩‍👧‍👦</div><span>Family</span></div>
                                <div class="feature-item" @onclick="OpenNotes"><div class="icon">📒</div><span>Notes</span></div> *@
                        @* </div> *@
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (showUploadMemberModal)
{
    <div class="modal-overlay" @onclick="CloseUploadMemberModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="">
                <h3 class="modal-title members-modal-header">@LangSvc.GetText("MemberImportCustomerData")</h3>
                <div style="width: 40px;"></div>
            </div>

            <div class="modal-body">
                <div class="processing-container @(IsProcessing ? "" : "hidden")">
                    <div class="spinner"></div>
                    <p class="status-text">@UploadStatus</p>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="error-alert-container">
                        <div class="error-alert-header">
                            <span>@LangSvc.GetText("MemberUploadError")</span>
                            <button class="close-icon-btn" @onclick="() => ErrorMessage = null">&times;</button>
                        </div>
                        <div class="error-alert-body">
                            @ErrorMessage
                        </div>
                    </div>
                }

                <div class="@(IsProcessing ? "hidden" : "")">
                    <div class="template-download-section">
                        <button class="btn-download-template" @onclick="DownloadTemplate">
                            <i class="fa-solid fa-file-csv"></i> @LangSvc.GetText("MemberDownloadCSVTemplate")
                        </button>
                    </div>

                    <div class="upload-section">
                        <div class="file-upload-area">
                            <div class="upload-icon"><img class="upload-file-image" src="_content/SenangRetails.Shared/images/glyphs-poly--folder-open.svg" /></div>
                            @if (FormFactor.GetFormFactor() == "Web")
                            {
                                <InputFile OnChange="HandleFileSelected"
                                           id="memberUploadInput"
                                           accept=".csv"
                                           hidden />
                                <label for="memberUploadInput" class="select-file-btn" style="cursor:pointer;">
                                    @LangSvc.GetText("DataControlSelectFile")
                                </label>
                            }
                            else
                            {
                                <button class="select-file-btn" @onclick="PickFileNativeAsync">
                                    @LangSvc.GetText("DataControlSelectFile")
                                </button>
                            }
                            <p class="upload-hint">@(selectedFileName ?? LangSvc.GetText("MemberChooseCSVFileToUpload"))</p>
                        </div>
                    </div>

                    <div class="import-instructions">
                        <div class="instruction-header">
                            @LangSvc.GetText("MemberImportInstructions")
                        </div>
                        <ul class="instruction-list">
                            <li><strong>@LangSvc.GetText("MemberInstructionFileFormat")</strong> CSV</li>
                            <li>@LangSvc.GetText("MemberInstructionHeaderRequired")</li>
                            <li><strong>@LangSvc.GetText("MemberInstructionColumnsInOrder")</strong> Name, Contact, Birthday Year, Birthday Month, Birthday Day, Gender, Email, NRIC, Ethnicity, Marital Status, Source, Member Tier, Remarks, Address 1, Address 2, Postal Code, City, State, Country</li>
                            <li>@LangSvc.GetText("MemberInstructionNameAndContactRequired")</li>
                            <li>@LangSvc.GetText("MemberInstructionBirthdayNumbers")</li>
                            <li>@LangSvc.GetText("MemberInstructionOptionalFields")</li>
                            <li>@LangSvc.GetText("MemberInstructionIfAnyRowMissing")</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseUploadMemberModal">@LangSvc.GetText("Cancel")</button>
                <button class="btn btn-primary" @onclick="ConfirmUpload">@LangSvc.GetText("DataControlUploadModalTitle")</button>
            </div>
        </div>
    </div>
}

@if (showAddMemberModal)
{
    <div class="modal-overlay" @onclick="CloseAddMemberModal">
        <div class="modal-content add-member-modal" @onclick:stopPropagation>
            <div style="padding-bottom: 0;" class="members-modal-header">
                <h3 class="modal-title">@LangSvc.GetText("AddNewMemberTitle")</h3>
                <div class="modal-controls">
                    <button class="button-alternative-primary" @onclick="OpenFormSettings"><i class="bi bi-gear"></i> @LangSvc.GetText("MemberSettingsLink")</button>
                </div>
            </div>
            <div class="modal-body" style="max-height:68vh; overflow-y:auto; padding-bottom:24px;">
                @if (formSettings.ShowName)
                {
                    <div class="form-group">
                        <label>@LangSvc.GetText("MemberName")<span style="color: var(--color-red);"> *</span></label>
                        <input type="text" @bind="newName" placeholder="@LangSvc.GetText("FullNamePlaceholder")" autofocus />
                    </div>
                }
                <div class="form-2-columns">
                    @if (formSettings.ShowMobile)
                    {
                        <div class="form-group">
                            <label>@LangSvc.GetText("MemberMobile")<span style="color: var(--color-red);"> *</span></label>
                            <input type="text" readonly value="@PhoneFormatter.Format(newPhone)" placeholder="@LangSvc.GetText("MemberPhoneHeader")" @onclick="OpenNewPhoneNumpad" style="cursor: pointer;" />
                        </div>
                    }
                    @if (formSettings.ShowBirthday)
                    {
                        <div class="form-group">
                            <label>@LangSvc.GetText("MemberBirthday")</label>
                            <MobileDatePicker @bind-Value="newBirthday"
                                              DateFormat="dd/MM/yyyy"
                                              Placeholder="@LangSvc.GetText("AppointmentSelectDate")" />
                        </div>
                    }
                    @if (formSettings.ShowGender)
                    {
                        <div class="form-group">
                            <label>@LangSvc.GetText("MemberGender")</label>
                            <div style="display:flex; gap:32px; margin-top:8px;">
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="radio" name="gender" value="Male" checked="@(newGender == "Male")" @onchange="@(() => newGender = "Male")" style="accent-color: var(--color-primary);" /> @LangSvc.GetText("MemberGenderMale")
                                </label>
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="radio" name="gender" value="Female" checked="@(newGender == "Female")" @onchange="@(() => newGender = "Female")" style="accent-color: var(--color-primary);" /> @LangSvc.GetText("MemberGenderFemale")
                                </label>
                            </div>
                        </div>
                    }
                    @if (formSettings.ShowEmail)
                    {
                        <div class="form-group">
                            <label>@LangSvc.GetText("MemberEmail")</label>
                            <input type="email" @bind="newEmail" placeholder="example@email.com" />
                        </div>
                    }
                    @if (formSettings.ShowIC)
                    {
                        <div class="form-group">
                            <label>@LangSvc.GetText("MemberIC")</label>
                            <input type="text" @bind="newIC" placeholder="......xxxxxx" />
                        </div>
                    }
                    @if (formSettings.ShowEthnic)
                    {
                        <div class="form-group">
                            <label>@LangSvc.GetText("MemberEthnicity")</label>
                            <input type="text" @bind="newEthnic" placeholder="@LangSvc.GetText("MemberEthnicityPlaceholder")" />
                        </div>
                    }
                    @if (formSettings.ShowMarital)
                    {
                        <div class="form-group">
                            <label>@LangSvc.GetText("MemberMaritalStatus")</label>
                            <div class="custom-select-container">

                                <select class="form-select-custom" @bind="newMarital">
                                    <option value="">@LangSvc.GetText("MemberSelectStatus")</option>
                                    <option value="Single">@LangSvc.GetText("MemberSingle")</option>
                                    <option value="Married">@LangSvc.GetText("MemberMarried")</option>
                                    <option value="Divorced">@LangSvc.GetText("MemberDivorced")</option>
