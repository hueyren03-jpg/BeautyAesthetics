                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>@LangSvc.GetText("MemberCountry")</label>
                                <input type="text" @bind="editCountry" placeholder="@LangSvc.GetText("MemberCountry")" />
                            </div>
                        </div>
                    }
                    else if (activeProfileTab == "Settings")
                    {
                        <div class="form-2-columns">
                            <button class="modal-button-secondary" style="height: fit-content; display: none;" @onclick="MergeMember">
                                @LangSvc.GetText("MergeMember")
