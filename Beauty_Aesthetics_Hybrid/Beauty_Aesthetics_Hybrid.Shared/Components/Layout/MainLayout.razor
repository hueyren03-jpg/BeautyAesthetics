@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject NavigationManager NavManager
@inject Beauty_Aesthetics_Hybrid.Shared.Services.IFormFactor FormFactor
@inject IAuthService AuthService
@inject Beauty_Aesthetics_WebPos.Components.Services.AppState AppState
@inject IBranchSessionService BranchSession
@inject AppFeedbackService Feedback
@inject Microsoft.JSInterop.IJSRuntime JSRuntime

<div class="MainLayout">
    @* This is the side bar *@

    @* This is the main body *@
    <div class="PageWrapper">
        @* move this back up if broken *@
        <div class="SidebarWrapper @(isSidebarOpen ? "" : "sidebarClose") @(isMobileLayout ? "compact-sidebar" : "desktop-sidebar")">
            <div class="Sidebar">
                <div class="SidebarLogoWrapper">
                    <img src="images/EBI_Logo.png" class="SidebarLogo" />
                </div>
                <div class="SidebarHeader" @onclick="ToggleSideBar">
                    <i class="fa-solid fa-bars SidebarItemIcon"></i>
                    <h5>@L["Menu"]</h5>
                </div>
                <div class="@GetSidebarItemClass("dashboard")" @onclick='() => NavigateToRoute("/")'>
                    <i class="fa-solid fa-chart-column SidebarItemIcon  @(isSidebarOpen ? "" : "HideIcon")"></i>
                    <h5>@L["Dashboard"]</h5>
                </div>            
                <div class="@GetSidebarItemClass("appointments")" @onclick='() => NavigateToRoute("/appointments")'>
                    <i class="fa-regular fa-calendar-check SidebarItemIcon"></i>
                    <h5>@L["Appointment"]</h5>
                </div>
                <div class="@GetSidebarItemClass("customers")" @onclick='() => NavigateToRoute("/customers")'>
                    <i class="fa-solid fa-users SidebarItemIcon"></i>
                    <h5>@L["Customers"]</h5>
                </div>
                <div class="@GetSidebarItemClass("sales")" @onclick='() => NavigateToRoute("/sales")'>
                    <i class="fa-solid fa-bag-shopping SidebarItemIcon"></i>
                    <h5>@L["Sales"]</h5>
                </div>
                <div class="@GetSidebarItemClass("roster")" @onclick='() => NavigateToRoute("/roster")'>
                    <i class="fa-solid fa-user-group SidebarItemIcon"></i>
                    <h5>@L["Roster"]</h5>
                </div>
                <div class="@GetSidebarItemClass("inventory")" @onclick='() => NavigateToRoute("/inventory")'>
                    <i class="fa-solid fa-warehouse SidebarItemIcon"></i>
                    <h5>@L["Inventory"]</h5>
                </div>
                <div class="@GetSidebarItemClass("services")" @onclick='() => NavigateToRoute("/services")'>
                    <i class="fa-solid fa-briefcase SidebarItemIcon"></i>
                    <h5>@L["Services"]</h5>
                </div>
                <div class="@GetSidebarItemClass("employee")" @onclick='() => NavigateToRoute("/employee")'>
                    <i class="fa-solid fa-user-tie SidebarItemIcon"></i>
                    <h5>@L["Employee"]</h5>
                </div>
                <div class="@GetSidebarItemClass("voucher")" @onclick='() => NavigateToRoute("/voucher")'>
                    <i class="fa-solid fa-ticket SidebarItemIcon"></i>
                    <h5>@L["Voucher"]</h5>
                </div>
                <div class="@GetSidebarItemClass("passcode")" @onclick='() => NavigateToRoute("/passcode")'>
                    <i class="fa-solid fa-key SidebarItemIcon"></i>
                    <h5>@L["Passcode"]</h5>
                </div>
                <div class="@GetSidebarItemClass("reportmenu")" @onclick='() => NavigateToRoute("/ReportMenu")'>
                    <i class="fa-solid fa-file SidebarItemIcon"></i>
                    <h5>@L["Report"]</h5>
                </div>
                <div class="@GetSidebarItemClass("configurations")" @onclick='() => NavigateToRoute("/config")'>
                    <i class="fa-solid fa-gear SidebarItemIcon"></i>
                    <h5>@L["Configurations"]</h5>
                </div>
                
            </div>
        </div>
        <div class="SidebarOverlay @(isSidebarOpen ? "visible" : "") @(isMobileLayout ? "compact-overlay" : "desktop-overlay")"
             @onclick="CloseSidebar"
             aria-hidden="true"></div>
        <div class="page">
            <div class="HeaderWrapper @(isMobileLayout ? "compact-header" : string.Empty)">
                <button type="button"
                        class="mobile-nav-toggle @(isMobileLayout ? "mobile-nav-toggle--visible" : string.Empty)"
                        @onclick="ToggleSideBar"
                        title="Open Menu"
                        aria-label="Toggle Menu">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="header">
                    <button type="button"
                            class="HeaderBranchSwitch"
                            @onclick="ToggleBranchPicker"
                            disabled="@(BranchSession.AvailableBranches.Count <= 1)"
                            aria-expanded="@isBranchPickerOpen"
                            title="@(BranchSession.AvailableBranches.Count > 1 ? "Switch working branch" : "Current working branch")"
                            aria-label="@(BranchSession.AvailableBranches.Count > 1 ? $"Switch branch. Current branch: {BranchSession.CurrentBranch?.DisplayName ?? "Not selected"}" : $"Current branch: {BranchSession.CurrentBranch?.DisplayName ?? "Not selected"}")">
                        <span class="HeaderBranchSwitch__icon">
                            <i class="fa-solid fa-building"></i>
                        </span>
                        <span class="HeaderBranchSwitch__copy">
                            <small>Working branch</small>
                            <strong>@(BranchSession.CurrentBranch?.DisplayName ?? "Not selected")</strong>
                        </span>
                        @if (BranchSession.AvailableBranches.Count > 1)
                        {
                            <span class="HeaderBranchSwitch__action" aria-hidden="true">
                                <i class="fa-solid fa-arrow-right-arrow-left"></i>
                            </span>
                        }
                    </button>

                    <div @onclick="ToggleProfile" class="profile">
                        <i class="fa-solid fa-user ProfileIcon"></i>
                        <i class="fa-solid fa-caret-down ProfileDropdown"></i>
                        <div class="ProfileSelection @(isProfileOpen ? "" : "isProfileClose")">
                            <p class="ProfileUserName">Tay Keng Aik</p>
                            <p class="ProfileEmail">taykengaik@gmail.com</p>
                            <div class="ProfileSelectionItemGroup" @onclick='() => NavigateToRoute("/profile")'>
                                <i class="fa-solid fa-user-gear ProfileSelectionIcon"></i>
                                <p class="ProfileSelectionItem">@L["Profile"]</p>
                            </div>
                            <p class="ProfileSelectionLogout" @onclick="LogoutAsync">@L["Logout"]</p>
                        </div>
                    </div>
                </div>

                @if (isBranchPickerOpen)
                {
                    <div class="HeaderBranchPickerBackdrop" @onclick="CloseBranchPicker"></div>
                    <section class="HeaderBranchPicker" @onclick:stopPropagation="true" aria-label="Switch working branch">
                        <div class="HeaderBranchPicker__header">
                            <div>
                                <small>WORKING BRANCH</small>
                                <strong>Switch branch</strong>
                            </div>
                            <button type="button"
                                    class="HeaderBranchPicker__close"
                                    @onclick="CloseBranchPicker"
                                    aria-label="Close branch picker">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(branchSwitchError))
                        {
                            <div class="HeaderBranchPicker__error" role="alert">@branchSwitchError</div>
                        }

                        <div class="HeaderBranchPicker__list">
                            @foreach (var branch in BranchSession.AvailableBranches)
                            {
                                var isCurrent = string.Equals(
                                    branch.Id,
                                    BranchSession.CurrentBranch?.Id,
                                    StringComparison.OrdinalIgnoreCase);

                                <button type="button"
                                        class="HeaderBranchPicker__item @(isCurrent ? "is-current" : string.Empty)"
                                        disabled="@(isSwitchingBranch || isCurrent)"
                                        @onclick="() => ChooseHeaderBranchAsync(branch.Id)">
                                    <span class="HeaderBranchPicker__itemIcon">
                                        <i class="bi bi-building"></i>
                                    </span>
                                    <span class="HeaderBranchPicker__itemCopy">
                                        <strong>@branch.DisplayName</strong>
                                        <small>@branch.Id</small>
                                    </span>
                                    @if (isCurrent)
                                    {
                                        <span class="HeaderBranchPicker__current">Current</span>
                                    }
                                    else if (isSwitchingBranch)
                                    {
                                        <i class="bi bi-arrow-repeat"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-chevron-right"></i>
                                    }
                                </button>
                            }
                        </div>
                    </section>
                }
            </div>
            <div class="content">
                @Body
            </div>
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isProfileOpen = false;
    private bool isBranchPickerOpen = false;
    private bool isSwitchingBranch = false;
    private string? branchSwitchError;
    private bool isSidebarOpen = false;
    private bool isMobileLayout = true;
    private string detectedFormFactor = string.Empty;

    protected override void OnInitialized()
    {
        AppState.AuthenticationChanged += HandleAuthenticationChanged;
        AppState.BranchChanged += HandleBranchChanged;

        try
        {
            detectedFormFactor = FormFactor.GetFormFactor() ?? string.Empty;
            var desktopCapable =
                detectedFormFactor.Equals("Desktop", StringComparison.OrdinalIgnoreCase) ||
                detectedFormFactor.Equals("Web", StringComparison.OrdinalIgnoreCase);

            isSidebarOpen = desktopCapable;
            isMobileLayout = !desktopCapable;
        }
        catch
        {
            detectedFormFactor = string.Empty;
            isSidebarOpen = false;
            isMobileLayout = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Keep compact drawer positioning tied to the real rendered header edge.
        // Android WebView safe-area values are not reliable in landscape.
        try
        {
            await JSRuntime.InvokeVoidAsync("posResponsive.syncHeaderMetrics");
        }
        catch
        {
            // Layout still has CSS fallbacks when JS metrics are unavailable.
        }

        if (!firstRender)
        {
            return;
        }

        try
        {
            var isWeb =
                detectedFormFactor.Equals("Web", StringComparison.OrdinalIgnoreCase);

            var isDesktopDevice =
                detectedFormFactor.Equals("Desktop", StringComparison.OrdinalIgnoreCase);

            // Keep Razor's shell decision aligned with the Web stylesheet media rule:
            // phone width always uses compact UI; touch/coarse-pointer tablets up to
            // 1180px also use compact UI; mouse/desktop Web keeps the full sidebar.
            var useCompactLayout = isWeb
                ? await JSRuntime.InvokeAsync<bool>("posResponsive.useCompactWebLayout")
                : !isDesktopDevice;

            if (isMobileLayout != useCompactLayout ||
                (useCompactLayout && isSidebarOpen) ||
                (!useCompactLayout && !isSidebarOpen))
            {
                isMobileLayout = useCompactLayout;
                isSidebarOpen = !useCompactLayout;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Keep the form-factor fallback when viewport interop is unavailable.
        }
    }

    public void Dispose()
    {
        AppState.AuthenticationChanged -= HandleAuthenticationChanged;
        AppState.BranchChanged -= HandleBranchChanged;
    }

    private void HandleAuthenticationChanged()
    {
        if (AppState.IsAuthenticated)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (!NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("login", StringComparison.OrdinalIgnoreCase))
            {
                NavigationManager.NavigateTo("/login", replace: true);
            }
        });
    }

    private void ToggleSideBar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void HandleBranchChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleBranchPicker()
    {
        isProfileOpen = false;
        branchSwitchError = null;
        isBranchPickerOpen = !isBranchPickerOpen;
    }

    private void CloseBranchPicker()
    {
        if (isSwitchingBranch)
        {
            return;
        }

        isBranchPickerOpen = false;
        branchSwitchError = null;
    }

    private async Task ChooseHeaderBranchAsync(string branchId)
    {
        if (isSwitchingBranch ||
            string.IsNullOrWhiteSpace(branchId) ||
            string.Equals(branchId, BranchSession.CurrentBranch?.Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        isSwitchingBranch = true;
        branchSwitchError = null;

        try
        {
            var selected = await BranchSession.SelectAsync(branchId);
            if (!selected)
            {
                branchSwitchError = "The selected branch could not be activated.";
                return;
            }

            // Reload the exact same route after persisting the branch. This gives every
            // branch-scoped page a clean state and avoids hot-swapping live components.
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            branchSwitchError = $"Unable to switch branch. {ex.Message}";
        }
        finally
        {
            isSwitchingBranch = false;
        }
    }

    private void CloseSidebar()
    {
        if (isSidebarOpen)
        {
            isSidebarOpen = false;
        }
    }

    private void ToggleProfile()
    {
        isProfileOpen = !isProfileOpen;
    }

    private void NavigateToRoute(string route)
    {
        var target = string.IsNullOrWhiteSpace(route) ? "/" : route;

        if (isMobileLayout || isSidebarOpen)
        {
            isSidebarOpen = false;
        }

        if (!NavigationManager.Uri.EndsWith(target, StringComparison.OrdinalIgnoreCase))
        {
            NavigationManager.NavigateTo(target);
        }
    }

    private async Task LogoutAsync()
    {
        var feedbackId = Feedback.Loading("Signing out securely...", "Signing out");
        try
        {
            await BranchSession.ClearAsync();
            await AuthService.LogoutAsync();
            Feedback.Resolve(feedbackId, "You have been signed out successfully.", "Signed out", 2600);
            NavigationManager.NavigateTo("/login", replace: true);
        }
        catch (Exception ex)
        {
            Feedback.Fail(feedbackId, $"Unable to sign out. {ex.Message}", "Sign out failed");
        }
    }

    private string GetSidebarItemClass(string matchPrefix)
    {
        var css = "SidebarItem";
        if (IsActive(matchPrefix))
        {
            css += " active";
        }

        return css;
    }
    private bool IsActive(string matchPrefix)
    {
        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        var normalizedPrefix = matchPrefix.Trim('/');

        if (string.IsNullOrEmpty(normalizedPrefix))
        {
            return string.IsNullOrEmpty(relativeUri);
        }

        return relativeUri.StartsWith(normalizedPrefix, StringComparison.OrdinalIgnoreCase);
    }
}