    private async Task InitializeCharts()
    {
        // Let the route transition finish so Chart.js can measure both canvases.
        await Task.Delay(100);

        for (var attempt = 1; attempt <= 3; attempt++)
        {
            try
            {
                await JS.InvokeVoidAsync("salesCharts.createPieChart", "transactionPieChart",
                    transactionData.Select(t => t.Category).ToArray(), transactionData.Select(t => (double)t.Amount).ToArray(),
                    transactionData.Select((_, index) => ChartColor(index)).ToArray());
                await JS.InvokeVoidAsync("salesCharts.createBarChart", "cashFlowBarChart",
                    cashFlowData.Select(c => c.Category).ToArray(), cashFlowData.Select(c => (double)c.Amount).ToArray(),
                    cashFlowData.Select((_, index) => ChartColor(index + 2)).ToArray());
                return;
            }
            catch (Exception) when (attempt < 3)
            {
                await Task.Delay(150);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing sales charts: {ex.Message}");
            }
        }
    }

