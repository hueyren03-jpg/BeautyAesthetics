    private static Transaction CloneTransaction(Transaction source) => new()
    {
        Id = source.Id,
        DocumentId = source.DocumentId,
        AccountId = source.AccountId,
        BranchId = source.BranchId,
        PaymentTypeId = source.PaymentTypeId,
        InvoiceNumber = source.InvoiceNumber,
        Date = source.Date,
        CustomerName = source.CustomerName,
        CustomerContact = source.CustomerContact,
        CustomerEmail = source.CustomerEmail,
        Branch = source.Branch,
        Type = source.Type,
        ItemCount = source.ItemCount,
        Amount = source.Amount,
        Subtotal = source.Subtotal,
        Tax = source.Tax,
        Discount = source.Discount,
        PaymentMethod = source.PaymentMethod,
        Status = source.Status,
        ReferenceNumber = source.ReferenceNumber,
        Notes = source.Notes,
        Items = source.Items.Select(item => new TransactionItem
        {
            Id = item.Id,
            InventoryId = item.InventoryId,
            Name = item.Name,
            Description = item.Description,
            ImageUrl = item.ImageUrl,
            Category = item.Category,
            Quantity = item.Quantity,
            UnitPrice = item.UnitPrice,
            TotalPrice = item.TotalPrice,
            Discount = item.Discount
        }).ToList(),
        Payments = source.Payments.Select(payment => new TransactionPayment
        {
            ReceiptLineId = payment.ReceiptLineId,
            PaymentTypeId = payment.PaymentTypeId,
            PaymentMethod = payment.PaymentMethod,
            Amount = payment.Amount
        }).ToList(),
        CreatedAt = source.CreatedAt,
        CreatedBy = source.CreatedBy
    };

    private static Transaction MergeReceiptTransaction(Transaction sale, Transaction? apiResult)
    {
        var receipt = CloneTransaction(sale);
        if (apiResult is null)
            return receipt;

        receipt.Id = apiResult.Id != 0 ? apiResult.Id : receipt.Id;
        receipt.DocumentId = string.IsNullOrWhiteSpace(apiResult.DocumentId) ? receipt.DocumentId : apiResult.DocumentId;
        receipt.InvoiceNumber = string.IsNullOrWhiteSpace(apiResult.InvoiceNumber) ? receipt.InvoiceNumber : apiResult.InvoiceNumber;
        receipt.Date = apiResult.Date == default ? receipt.Date : apiResult.Date;
        receipt.Status = string.IsNullOrWhiteSpace(apiResult.Status) ? receipt.Status : apiResult.Status;
        return receipt;
    }

    private void ShowCancelModal(Transaction transaction)
    {
        cancellingTransaction = transaction;
        cancellationReason = "";
        showCancelModal = true;
    }

    private void HideCancelModal()
    {
        showCancelModal = false;
        cancellingTransaction = null;
        cancellationReason = "";
    }

    private async Task ConfirmCancelTransaction()
    {
        if (cancellingTransaction is null || isSaving) return;

        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            Feedback.Warning("Please provide a deletion reason.", "Reason required");
            return;
        }

        if (string.IsNullOrWhiteSpace(cancellingTransaction.DocumentId))
        {
            apiError = "This transaction does not contain a server document ID and cannot be deleted.";
            return;
        }

        var invoice = string.IsNullOrWhiteSpace(cancellingTransaction.InvoiceNumber)
            ? "transaction"
            : cancellingTransaction.InvoiceNumber;
        var feedbackId = Feedback.Loading($"Deleting {invoice}...", "Deleting sale");

        isSaving = true;
        apiError = "";

        try
        {
            var result = await CashSalesService.DeleteTransactionAsync(cancellingTransaction, cancellationReason);
            if (!result.Success)
            {
                apiError = result.ErrorMessage ?? "Unable to delete the cash sale.";
                Feedback.Dismiss(feedbackId);
                return;
            }

            HideCancelModal();
            await LoadDataAsync();
            await InitializeCharts();
            Feedback.Resolve(feedbackId, $"{invoice} deleted successfully.", "Sale deleted");
        }
        catch (Exception ex)
        {
            apiError = $"Unable to delete the cash sale. {ex.Message}";
            Feedback.Dismiss(feedbackId);
        }
        finally
        {
            isSaving = false;
        }
    }

