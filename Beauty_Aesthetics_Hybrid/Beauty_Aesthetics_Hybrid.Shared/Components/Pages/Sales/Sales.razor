    private async Task SaveNewSale()
    {
        newSaleValidationMessages = GetNewSaleValidationMessages(newSale);
        if (newSaleValidationMessages.Any() || isSaving) return;

        isSaving = true;
        apiError = "";
        try
        {
            ApplySelections(newSale);
            var customer = customerOptions.FirstOrDefault(item => item.SystemID == newSale.AccountId);
            if (customer is null)
            {
                newSaleValidationMessages.Add("Select a customer.");
                return;
            }
            ApplyCustomerSelection(newSale, customer);
            BuildTotalsAndLine(newSale);
            newSalePaidAmount = Math.Max(newSalePaidAmount, newSale.Amount);

            var feedbackId = Feedback.Loading("Saving cash sale...", "Saving sale");
            var result = await CashSalesService.CreateTransactionAsync(newSale);
            if (!result.Success)
            {
                apiError = result.ErrorMessage ?? "Unable to create the cash sale.";
                Feedback.Dismiss(feedbackId);
                return;
            }

            savedNewSale = MergeReceiptTransaction(newSale, result.Value);
            savedSaleChange = Math.Max(0, newSalePaidAmount - savedNewSale.Amount);
            showNewSaleReceipt = true;
            showSaleChangeConfirmation = true;
            newSaleStep = 4;
            await LoadDataAsync();
            await InitializeCharts();
            Feedback.Resolve(
                feedbackId,
                $"Sale {savedNewSale.InvoiceNumber} created successfully.",
                "Sale created");
        }
        finally
        {
            isSaving = false;
        }
    }

