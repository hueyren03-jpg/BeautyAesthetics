    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        await LoadLookupsAsync();
        await LoadDataAsync();
        chartsNeedRefresh = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chartsNeedRefresh)
        {
            chartsNeedRefresh = false;
            await InitializeCharts();
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        var route = NavigationManager.ToBaseRelativePath(args.Location)
            .Split('?', '#')[0]
            .Trim('/');

        if (string.Equals(route, "sales", StringComparison.OrdinalIgnoreCase))
            _ = InvokeAsync(RefreshSalesDashboardAsync);
    }

    private async Task RefreshSalesDashboardAsync()
    {
        if (routeRefreshInProgress)
            return;

        routeRefreshInProgress = true;
        try
        {
            await LoadDataAsync();
            chartsNeedRefresh = true;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            routeRefreshInProgress = false;
        }
    }

    private async Task LoadLookupsAsync()
    {
        var branchResult = await BranchLookupService.LoadBranchesAsync();
        if (branchResult.Success && branchResult.Value is not null)
            branches = branchResult.Value.ToList();
        else
            apiError = branchResult.ErrorMessage ?? "Unable to load branches.";

        var paymentResult = await CashSalesService.LoadPaymentTypesAsync();
        if (paymentResult.Success && paymentResult.Value is not null)
            paymentTypes = paymentResult.Value.ToList();
        else if (string.IsNullOrWhiteSpace(apiError))
            apiError = paymentResult.ErrorMessage ?? "Unable to load payment methods.";

        var customerResult = await CustomerService.SearchCustomersAsync(string.Empty);
        if (customerResult.Success && customerResult.Value is not null)
            customerOptions = customerResult.Value
                .Where(customer => !string.IsNullOrWhiteSpace(customer.SystemID))
                .OrderBy(customer => customer.FirstName)
                .ThenBy(customer => customer.LastName)
                .ToList();
        else if (string.IsNullOrWhiteSpace(apiError))
            apiError = customerResult.ErrorMessage ?? "Unable to load customers.";

        await LoadSaleCatalogAsync();
    }

    private async Task LoadSaleCatalogAsync()
    {
        isCatalogLoading = true;
        try
        {
            var productTask = ProductInventoryService.LoadProductsAsync("HQ");
            var serviceTask = ServiceItemService.LoadServiceItemsAsync("hq");
            await Task.WhenAll(productTask, serviceTask);

            var productResult = await productTask;
            var serviceResult = await serviceTask;
            var services = serviceResult.Success && serviceResult.Value is not null
                ? serviceResult.Value
                    .Where(item => !string.Equals(item.Status, "Inactive", StringComparison.OrdinalIgnoreCase))
                    .ToList()
                : [];

            var catalog = new List<SaleCatalogItem>();
            if (productResult.Success && productResult.Value is not null)
            {
                catalog.AddRange(productResult.Value
                    .Where(item => !string.IsNullOrWhiteSpace(item.MasterAccountId))
                    .Select(item => new SaleCatalogItem(
                        item.MasterAccountId,
                        item.Type,
                        item.Sku,
                        "Product",
                        item.Price,
                        item.Type,
                        ResolveCatalogImage("Product", item.MasterAccountId, item.ImagePath, item.ImageFileName))));
            }

            catalog.AddRange(services
                .Where(item => !string.IsNullOrWhiteSpace(item.MasterAccountId))
                .Select(item => new SaleCatalogItem(
                    item.MasterAccountId!,
                    item.ServiceName,
                    item.Sku,
                    "Service",
                    item.Price,
                    item.SalesDescription,
                    ResolveCatalogImage("Service", item.MasterAccountId, item.ImagePath, item.ImageFileName))));

            if (services.Count > 0)
            {
                var packageResult = await PackageService.LoadPackagesAsync(services, "hq");
                if (packageResult.Success && packageResult.Value is not null)
                {
                    catalog.AddRange(packageResult.Value
                        .Where(item => !string.IsNullOrWhiteSpace(item.MasterAccountId)
                            && !string.Equals(item.Status, "Inactive", StringComparison.OrdinalIgnoreCase))
                        .Select(item => new SaleCatalogItem(
                            item.MasterAccountId,
                            item.Name,
                            item.Sku,
                            "Package",
                            item.Price,
                            item.SalesDescription,
                            ResolveCatalogImage("Package", item.MasterAccountId, item.ImagePath, item.ImageFileName))));
                }
            }

            saleCatalogItems = catalog
                .GroupBy(item => item.Id, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderBy(item => item.Type)
                .ThenBy(item => item.Name)
                .ToList();

            if (saleCatalogItems.Count == 0 && string.IsNullOrWhiteSpace(apiError))
                apiError = productResult.ErrorMessage ?? serviceResult.ErrorMessage ?? "Unable to load sale items.";
        }
        finally
        {
            isCatalogLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        apiError = "";
        try
        {
            var result = await LoadSelectedOutletTransactionsAsync();
            if (!result.Success || result.Value is null)
            {
                recentTransactions = new();
                RebuildSummary();
                apiError = result.ErrorMessage ?? "Unable to load cash sales.";
            }
            else
            {
                recentTransactions = result.Value.ToList();
                RebuildSummary();
            }

            await LoadChartDataAsync();
            await LoadComparisonDataAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<ApiCallResult<IReadOnlyList<Transaction>>> LoadSelectedOutletTransactionsAsync(
        DateTime? rangeStart = null, DateTime? rangeEnd = null, bool resolvePaymentMethods = true)
    {
        var effectiveStart = rangeStart ?? startDate;
        var effectiveEnd = rangeEnd ?? endDate;

        if (!string.IsNullOrWhiteSpace(selectedOutlet) || branches.Count == 0)
            return await CashSalesService.LoadTransactionsAsync(effectiveStart, effectiveEnd, selectedOutlet, resolvePaymentMethods);

        var branchIds = branches
            .Select(branch => branch.Id)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (branchIds.Count == 0)
            return await CashSalesService.LoadTransactionsAsync(effectiveStart, effectiveEnd, string.Empty, resolvePaymentMethods);

        var results = await Task.WhenAll(branchIds.Select(branchId =>
            CashSalesService.LoadTransactionsAsync(effectiveStart, effectiveEnd, branchId, resolvePaymentMethods)));
        var successfulResults = results.Where(result => result.Success && result.Value is not null).ToList();

        if (successfulResults.Count == 0)
        {
            var firstFailure = results.FirstOrDefault(result => !result.Success);
            return ApiCallResult<IReadOnlyList<Transaction>>.Failure(
                firstFailure?.StatusCode ?? System.Net.HttpStatusCode.BadGateway,
                firstFailure?.ErrorMessage ?? "Unable to load sales for any outlet.");
        }

        var transactions = successfulResults
            .SelectMany(result => result.Value!)
            .GroupBy(TransactionIdentity, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .OrderByDescending(transaction => transaction.Date)
            .ToList();

        return ApiCallResult<IReadOnlyList<Transaction>>.Ok(successfulResults[0].StatusCode, transactions);
    }

    private static string TransactionIdentity(Transaction transaction) =>
        !string.IsNullOrWhiteSpace(transaction.DocumentId)
            ? transaction.DocumentId
            : $"{transaction.BranchId}|{transaction.InvoiceNumber}|{transaction.Date:O}|{transaction.Amount}";

    private void RebuildSummary()
    {
        var serviceAmount = recentTransactions.Where(t => t.Type.Equals("Service", StringComparison.OrdinalIgnoreCase)).Sum(t => t.Amount);
        var productAmount = recentTransactions.Where(t => t.Type.Equals("Product", StringComparison.OrdinalIgnoreCase)).Sum(t => t.Amount);
        var total = recentTransactions.Sum(t => t.Amount);
        summary = new SalesSummary
        {
            TotalSales = total,
            TotalTransactions = recentTransactions.Count,
            AverageSale = recentTransactions.Count == 0 ? 0 : total / recentTransactions.Count,
            TotalCash = PaymentTotal("cash"),
            TotalCard = PaymentTotal("card"),
            TotalOnlineTransfer = PaymentTotal("transfer", "online"),
            TotalEWallet = PaymentTotal("wallet", "e-wallet"),
            Outstanding = recentTransactions.Where(t => t.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase)).Sum(t => t.Amount),
            ServicesAmount = serviceAmount,
            ProductsAmount = productAmount,
            ServicesPercentage = total == 0 ? "0" : Math.Round(serviceAmount / total * 100).ToString("0"),
            ProductsPercentage = total == 0 ? "0" : Math.Round(productAmount / total * 100).ToString("0"),
            FromDate = startDate,
            ToDate = endDate
        };
        transactionData = new();
        cashFlowData = new();
    }

    private async Task LoadChartDataAsync()
    {
        var branchIds = GetAnalyticsBranchIds();
        var typeResults = await Task.WhenAll(branchIds.Select(branchId =>
            CashSalesService.LoadSalesByTypeAsync(startDate, endDate, branchId)));
        var typeValues = typeResults
            .Where(result => result.Success && result.Value is not null)
            .Select(result => result.Value!)
            .ToList();

        var categoryAmounts = new (string Name, decimal Amount)[]
        {
            ("Services", typeValues.Sum(value => value.Service)),
            ("Products", typeValues.Sum(value => value.Product)),
            ("Packages", typeValues.Sum(value => value.Package)),
            ("Vouchers", typeValues.Sum(value => value.Voucher)),
            ("Top Ups", typeValues.Sum(value => value.TopUp)),
            ("Bundles", typeValues.Sum(value => value.Bundle)),
            ("Deposits", typeValues.Sum(value => value.Deposit)),
            ("Service Charges", typeValues.Sum(value => value.ServiceCharge))
        };
        var categorizedTotal = categoryAmounts.Sum(item => item.Amount);
        transactionData = categoryAmounts
            .Where(item => item.Amount != 0)
            .Select(item => new TransactionCategory
            {
                Category = item.Name,
                Amount = item.Amount,
                Percentage = categorizedTotal == 0 ? 0 : item.Amount / categorizedTotal * 100
            })
            .ToList();

        if (typeValues.Count > 0)
        {
            summary.ServicesAmount = typeValues.Sum(value => value.Service);
            summary.ProductsAmount = typeValues.Sum(value => value.Product);
            summary.ServicesPercentage = PercentageOf(summary.ServicesAmount, categorizedTotal);
            summary.ProductsPercentage = PercentageOf(summary.ProductsAmount, categorizedTotal);
        }

        var collectionValues = await LoadCollectionValuesAsync(startDate, endDate, branchIds);
        cashFlowData = collectionValues
            .Where(item => !string.IsNullOrWhiteSpace(item.ReportGroup))
            .GroupBy(item => item.ReportGroup!.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(group => new CashFlowItem
            {
                Category = group.Key,
                Amount = group.Sum(item => item.Amount),
                Date = endDate
            })
            .Where(item => item.Amount != 0)
            .OrderByDescending(item => item.Amount)
            .ToList();
    }

    private async Task LoadComparisonDataAsync()
    {
        var dayCount = Math.Max(1, (endDate.Date - startDate.Date).Days + 1);
        var previousEnd = startDate.Date.AddTicks(-1);
        var previousStart = startDate.Date.AddDays(-dayCount);

        var previousTransactionsResult = await LoadSelectedOutletTransactionsAsync(
            previousStart,
            previousEnd,
            resolvePaymentMethods: false);
        var previousTransactions = previousTransactionsResult.Success &&
                                   previousTransactionsResult.Value is not null
            ? previousTransactionsResult.Value
            : Array.Empty<Transaction>();

        previousTotalSales = previousTransactions.Sum(transaction => transaction.Amount);
        previousTransactionCount = previousTransactions.Count;
        previousAverageSale = previousTransactionCount == 0
            ? 0
            : previousTotalSales / previousTransactionCount;

        var previousCollections = await LoadCollectionValuesAsync(
            previousStart,
            previousEnd,
            GetAnalyticsBranchIds());
        previousCashMovement = previousCollections.Sum(item => item.Amount);
    }

    private async Task<IReadOnlyList<SalesByCollectionDTO>> LoadCollectionValuesAsync(
        DateTime rangeStart,
        DateTime rangeEnd,
        IReadOnlyList<string> branchIds)
    {
        var results = await Task.WhenAll(branchIds.Select(branchId =>
            CashSalesService.LoadSalesByCollectionAsync(rangeStart, rangeEnd, branchId)));
        return results
            .Where(result => result.Success && result.Value is not null)
            .SelectMany(result => result.Value!)
            .ToList();
    }

    private static string FormatChange(decimal current, decimal previous)
    {
        if (previous == 0)
            return current == 0 ? "0.0%" : "New";

        var percentage = (current - previous) / Math.Abs(previous) * 100;
        return $"{(percentage > 0 ? "+" : string.Empty)}{percentage:0.0}%";
    }

    private static string ChangeClass(decimal current, decimal previous) =>
        current > previous ? "positive" : current < previous ? "negative" : "neutral";
    private IReadOnlyList<string> GetAnalyticsBranchIds()
    {
        if (!string.IsNullOrWhiteSpace(selectedOutlet))
            return new[] { selectedOutlet };

        var branchIds = branches
            .Select(branch => branch.Id)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return branchIds.Count > 0 ? branchIds : new[] { "HQ" };
    }

    private static string PercentageOf(decimal amount, decimal total) =>
        total == 0 ? "0" : Math.Round(amount / total * 100).ToString("0");

    private static string ChartColor(int index) => ChartColors[index % ChartColors.Length];
    private decimal PaymentTotal(params string[] terms) => recentTransactions
        .Where(t => terms.Any(term => t.PaymentMethod.Contains(term, StringComparison.OrdinalIgnoreCase)))
        .Sum(t => t.Amount);

