    private static void ApplyCustomerSelection(Transaction sale, Customer customer)
    {
        sale.AccountId = customer.SystemID ?? string.Empty;
        sale.CustomerName = $"{customer.FirstName} {customer.LastName}".Trim();
        sale.CustomerContact = customer.ContactNumber1;
        sale.CustomerEmail = customer.Email;
    }

    private static string CustomerOptionLabel(Customer customer)
    {
        var name = $"{customer.FirstName} {customer.LastName}".Trim();
        return string.IsNullOrWhiteSpace(customer.ContactNumber1) ? name : $"{name} - {customer.ContactNumber1}";
    }
    private void ApplySelections(Transaction sale)
    {
        sale.Branch = branches.FirstOrDefault(item => item.Id == sale.BranchId)?.Name ?? sale.BranchId;
        if (sale.Payments.Count > 0)
        {
            foreach (var payment in sale.Payments)
                payment.PaymentMethod = paymentTypes.FirstOrDefault(item => item.POSPaymentTypeID == payment.PaymentTypeId)?.POSPaymentTypeName ?? payment.PaymentMethod;
            sale.PaymentTypeId = sale.Payments[0].PaymentTypeId;
            sale.PaymentMethod = string.Join(" + ", sale.Payments
                .Select(payment => payment.PaymentMethod)
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase));
        }
        else
        {
            sale.PaymentMethod = paymentTypes.FirstOrDefault(item => item.POSPaymentTypeID == sale.PaymentTypeId)?.POSPaymentTypeName ?? sale.PaymentMethod;
        }
    }

    private static void BuildTotalsAndLine(Transaction sale)
    {
        if (sale.Items.Any())
        {
            foreach (var item in sale.Items)
            {
                item.Quantity = Math.Max(1, item.Quantity);
                var gross = item.Quantity * item.UnitPrice;
                item.Discount = Math.Clamp(item.Discount, 0, gross);
                item.TotalPrice = decimal.Round(Math.Max(0, gross - item.Discount), 2);
                if (string.IsNullOrWhiteSpace(item.Category))
                    item.Category = "Product";
            }

            sale.Subtotal = decimal.Round(sale.Items.Sum(item => item.Quantity * item.UnitPrice), 2);
            sale.Discount = decimal.Round(sale.Items.Sum(item => item.Discount), 2);
            sale.Tax = 0;
            sale.Amount = decimal.Round(Math.Max(0, sale.Subtotal - sale.Discount + sale.Tax), 2);
            sale.ItemCount = sale.Items.Sum(item => Math.Max(1, item.Quantity));
            var categories = sale.Items
                .Select(item => item.Category)
                .Where(category => !string.IsNullOrWhiteSpace(category))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            sale.Type = categories.Count == 1 ? categories[0] : "Mixed";
            return;
        }

        sale.Subtotal = decimal.Round(sale.Amount / 1.06m, 2);
        sale.Tax = sale.Amount - sale.Subtotal;
        var quantity = Math.Max(1, sale.ItemCount);
        sale.Items = new()
        {
            new TransactionItem
            {
                Name = sale.Type == "Service" ? "Service Item" : "Product Item",
                Category = sale.Type,
                Quantity = quantity,
                UnitPrice = sale.Subtotal / quantity,
                TotalPrice = sale.Subtotal
            }
        };
    }

    private static decimal BuildSaleTotal(Transaction sale)
    {
        if (!sale.Items.Any())
            return sale.Amount;

        return decimal.Round(sale.Items.Sum(item =>
        {
            var gross = Math.Max(1, item.Quantity) * item.UnitPrice;
            return Math.Max(0, gross - Math.Clamp(item.Discount, 0, gross));
        }), 2);
    }

    private static TransactionItem CreateDefaultSaleItem() => new()
    {
        Category = "-",
        Quantity = 1
    };

