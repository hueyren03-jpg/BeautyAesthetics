    private async Task EditTransaction(Transaction transaction)
    {
        apiError = "";
        var source = transaction;
        if (!string.IsNullOrWhiteSpace(transaction.DocumentId))
        {
            var result = await CashSalesService.LoadTransactionAsync(transaction.DocumentId);
            if (!result.Success || result.Value is null)
            {
                apiError = result.ErrorMessage ?? "Unable to load the cash sale for editing.";
                return;
            }
            source = result.Value;
        }
        editingTransaction = CloneTransaction(source);
        showEditModal = true;
    }

    private void HideEditModal()
    {
        showEditModal = false;
        editingTransaction = null;
    }

    private async Task SaveEditTransaction()
    {
        if (editingTransaction is null || isSaving) return;

        var validation = GetNewSaleValidationMessages(editingTransaction);
        if (validation.Any())
        {
            apiError = string.Join(" ", validation);
            return;
        }

        isSaving = true;
        apiError = "";
        var invoice = string.IsNullOrWhiteSpace(editingTransaction.InvoiceNumber)
            ? "transaction"
            : editingTransaction.InvoiceNumber;
        var feedbackId = Feedback.Loading($"Updating {invoice}...", "Updating sale");

        try
        {
            ApplySelections(editingTransaction);
            BuildTotalsAndLine(editingTransaction);

            var result = await CashSalesService.UpdateTransactionAsync(editingTransaction);
            if (!result.Success)
            {
                apiError = result.ErrorMessage ?? "Unable to update the cash sale.";
                Feedback.Dismiss(feedbackId);
                return;
            }

            showEditModal = false;
            editingTransaction = null;
            await LoadDataAsync();
            await InitializeCharts();
            Feedback.Resolve(feedbackId, $"{invoice} updated successfully.", "Sale updated");
        }
        catch (Exception ex)
        {
            apiError = $"Unable to update the cash sale. {ex.Message}";
            Feedback.Dismiss(feedbackId);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ApplyNewSaleCustomerSelection()
