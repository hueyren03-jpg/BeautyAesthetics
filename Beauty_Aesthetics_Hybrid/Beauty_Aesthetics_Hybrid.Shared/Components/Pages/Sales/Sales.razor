            ? transaction.DocumentId
            : transaction.InvoiceNumber;
        var paidAmount = amountReceived.GetValueOrDefault(transaction.Amount);
        if (paidAmount <= 0)
            paidAmount = transaction.Amount;

        var change = Math.Max(0, paidAmount - transaction.Amount);
        var rows = transaction.Items.Any()
            ? string.Join(string.Empty, transaction.Items.Select(item => $"""
                <tr>
                    <td><strong>{EncodeReceiptText(item.Name)}</strong><small>{EncodeReceiptText(item.Category)}</small></td>
                    <td class="number">{Math.Max(1, item.Quantity)}</td>
                    <td class="number">{item.UnitPrice:N2}</td>
                    <td class="number">{item.Discount:N2}</td>
                    <td class="number">{item.TotalPrice:N2}</td>
                </tr>
                """))
            : "<tr><td colspan=\"5\" class=\"empty\">No item details returned.</td></tr>";

        var html = $$"""
            <!doctype html>
            <html>
            <head>
                <meta charset="utf-8">
                <title>Receipt {{EncodeReceiptText(receiptNumber)}}</title>
                <style>
                    * { box-sizing: border-box; }
                    body { margin: 0; padding: 18px; color: #172033; font-family: Arial, sans-serif; font-size: 12px; }
                    .receipt { width: 100%; max-width: 390px; margin: 0 auto; }
                    .brand { text-align: center; padding-bottom: 14px; border-bottom: 2px solid #0759ad; }
                    .brand h1 { margin: 0; color: #064a94; font-size: 22px; }
                    .brand p { margin: 4px 0 0; color: #64748b; }
                    .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 14px; padding: 14px 0; }
                    .meta div { min-width: 0; }
                    .meta span { display: block; color: #64748b; font-size: 10px; text-transform: uppercase; }
                    .meta strong { display: block; margin-top: 2px; overflow-wrap: anywhere; }
                    table { width: 100%; border-collapse: collapse; }
                    th { padding: 8px 4px; border-top: 1px solid #cbd5e1; border-bottom: 1px solid #cbd5e1; color: #475569; font-size: 10px; text-align: left; }
                    td { padding: 9px 4px; border-bottom: 1px solid #e2e8f0; vertical-align: top; }
                    td small { display: block; margin-top: 2px; color: #64748b; }
                    .number { text-align: right; white-space: nowrap; }
                    .empty { color: #64748b; text-align: center; }
                    .totals { margin: 12px 0 0 auto; width: 72%; }
                    .total-row { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; }
                    .total-row.final { margin-top: 5px; padding-top: 9px; border-top: 2px solid #0759ad; color: #064a94; font-size: 15px; font-weight: 700; }
                    .payment { margin-top: 14px; padding: 11px; border-radius: 6px; background: #eff6ff; }
                    .footer { margin-top: 18px; color: #64748b; text-align: center; font-size: 10px; }
                    @media print { body { padding: 0; } }
                </style>
            </head>
            <body>
                <main class="receipt">
                    <header class="brand"><h1>Beauty Aesthetics</h1><p>Clinic Management</p></header>
                    <section class="meta">
                        <div><span>Receipt No.</span><strong>{{EncodeReceiptText(receiptNumber)}}</strong></div>
                        <div><span>Date</span><strong>{{transaction.Date:dd/MM/yyyy hh:mm tt}}</strong></div>
                        <div><span>Customer</span><strong>{{EncodeReceiptText(transaction.CustomerName)}}</strong></div>
                        <div><span>Branch</span><strong>{{EncodeReceiptText(string.IsNullOrWhiteSpace(transaction.Branch) ? transaction.BranchId : transaction.Branch)}}</strong></div>
                    </section>
                    <table>
                        <thead><tr><th>Item</th><th class="number">Qty</th><th class="number">Price</th><th class="number">Disc.</th><th class="number">Total</th></tr></thead>
                        <tbody>{{rows}}</tbody>
