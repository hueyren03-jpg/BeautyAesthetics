    };

    private static string PaymentMethodIcon(string? paymentMethod)
    {
        var method = paymentMethod?.Trim().ToLowerInvariant() ?? string.Empty;

        if (method.Contains("cash")) return "bi-cash-stack";
        if (method.Contains("bank") || method.Contains("transfer")) return "bi-bank";
        if (method.Contains("card") || method.Contains("visa") || method.Contains("master")) return "bi-credit-card-2-front";
        if (method.Contains("wallet") || method.Contains("e-wallet") || method.Contains("ewallet")) return "bi-wallet2";
        if (method.Contains("voucher")) return "bi-ticket-perforated";
        if (method.Contains("point")) return "bi-stars";
        if (method.Contains("cheque") || method.Contains("check")) return "bi-receipt";

        return "bi-credit-card";
    }

