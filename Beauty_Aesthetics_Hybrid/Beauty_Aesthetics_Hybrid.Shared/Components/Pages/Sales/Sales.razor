    {
        showSaleChangeConfirmation = false;
    }

    private List<string> GetNewSaleValidationMessages(Transaction sale)
    {
        var messages = new List<string>();
        if (string.IsNullOrWhiteSpace(sale.AccountId)) messages.Add("Customer Name");
        if (sale.Date == default) messages.Add("Transaction Date");
        if (string.IsNullOrWhiteSpace(sale.BranchId)) messages.Add("Outlet / Branch");
        if (sale.PaymentTypeId == 0) messages.Add("Payment Method");
        if (!sale.Items.Any()) messages.Add("Add at least one item.");
        if (sale.Items.Any(item => string.IsNullOrWhiteSpace(item.Name))) messages.Add("Every item needs a name.");
        if (sale.Items.Any(item => item.Quantity <= 0)) messages.Add("Item quantity must be at least 1.");
        if (sale.Items.Any(item => item.UnitPrice <= 0)) messages.Add("Item price must be more than 0.");
        if (sale.Items.Any(item => item.Discount < 0)) messages.Add("Item discount cannot be negative.");
        if (BuildSaleTotal(sale) <= 0) messages.Add("Total amount must be more than 0.");
        if (ReferenceEquals(sale, newSale) && newSalePaidAmount > 0 && newSalePaidAmount < BuildSaleTotal(sale)) messages.Add("Amount received is lower than the sale total.");
        return messages;
    }

    private void ContinueFromCustomerStep()
    {
        newSaleValidationMessages.Clear();
        if (string.IsNullOrWhiteSpace(newSale.AccountId))
            newSaleValidationMessages.Add("Select a customer.");
        if (newSale.Date == default)
            newSaleValidationMessages.Add("Select the transaction date.");
        if (string.IsNullOrWhiteSpace(newSale.BranchId))
            newSaleValidationMessages.Add("Select an outlet or branch.");
        if (newSaleValidationMessages.Any()) return;

        ApplySelections(newSale);
        var customer = customerOptions.FirstOrDefault(item => item.SystemID == newSale.AccountId);
        if (customer is not null)
            ApplyCustomerSelection(newSale, customer);
        newSaleStep = 2;
    }

    private void ContinueFromCartStep()
    {
        newSaleValidationMessages.Clear();
        if (!newSale.Items.Any())
        {
            newSaleValidationMessages.Add("Add at least one item to the cart.");
            return;
        }

        UpdateNewSaleTotals();
        newSalePaidAmount = NewSaleTotal;
        isMobileCartOpen = false;
        newSaleStep = 3;
    }

    private void OpenMobileCart() => isMobileCartOpen = true;

    private void CloseMobileCart() => isMobileCartOpen = false;

    private void UseExactNewSaleAmount()
    {
        newSalePaidAmount = NewSaleTotal;
        newSaleValidationMessages.Clear();
    }

    private void SetNewSaleStep(int step)
    {
        if (step is < 1 or > 4) return;
        if (step == 4 && !showNewSaleReceipt) return;
        if (step > newSaleStep && step != 4) return;
        newSaleValidationMessages.Clear();
        isMobileCartOpen = false;
        newSaleStep = step;
    }

    private void AddDraftItemToSale()
    {
        var draftTotal = Math.Max(1, newSaleItemDraft.Quantity) * newSaleItemDraft.UnitPrice;
        newSaleValidationMessages.Clear();
        if (string.IsNullOrWhiteSpace(newSaleItemDraft.InventoryId))
            newSaleValidationMessages.Add("Choose an item to add to the cart.");
        if (newSaleItemDraft.UnitPrice <= 0)
            newSaleValidationMessages.Add("Enter an item price more than 0.");
        if (newSaleItemDraft.Discount < 0 || newSaleItemDraft.Discount > draftTotal)
            newSaleValidationMessages.Add("Discount cannot be higher than the item amount.");
        if (newSaleValidationMessages.Any())
        {
            newSaleStep = 2;
            return;
        }

        var quantity = Math.Max(1, newSaleItemDraft.Quantity);
        var discount = Math.Clamp(newSaleItemDraft.Discount, 0, draftTotal);
        newSale.Items.Add(new TransactionItem
        {
            InventoryId = newSaleItemDraft.InventoryId,
            Name = newSaleItemDraft.Name.Trim(),
            Description = newSaleItemDraft.Description,
            ImageUrl = newSaleItemDraft.ImageUrl,
            Category = string.IsNullOrWhiteSpace(newSaleItemDraft.Category) ? "Product" : newSaleItemDraft.Category,
            Quantity = quantity,
            UnitPrice = decimal.Round(newSaleItemDraft.UnitPrice, 2),
            Discount = decimal.Round(discount, 2),
            TotalPrice = decimal.Round(draftTotal - discount, 2)
        });
        newSaleItemDraft = CreateDefaultSaleItem();
        newSaleItemDraft.Category = selectedSaleItemType;
        selectedCatalogItemId = "";
        UpdateNewSaleTotals();
        newSaleStep = 2;
    }

    private void SelectSaleCatalogItem(string itemId)
    {
        selectedCatalogItemId = itemId;
        var selected = saleCatalogItems.FirstOrDefault(item =>
            string.Equals(item.Id, selectedCatalogItemId, StringComparison.OrdinalIgnoreCase));

        if (selected is null)
        {
            newSaleItemDraft = CreateDefaultSaleItem();
            newSaleItemDraft.Category = selectedSaleItemType;
            return;
        }

        newSaleItemDraft.InventoryId = selected.Id;
        newSaleItemDraft.Name = selected.Name;
        newSaleItemDraft.Description = string.IsNullOrWhiteSpace(selected.Description)
            ? selected.Name
            : selected.Description;
        newSaleItemDraft.ImageUrl = selected.ImageUrl;
        newSaleItemDraft.Category = selected.Type;
        newSaleItemDraft.UnitPrice = selected.Price;
        newSaleItemDraft.Quantity = Math.Max(1, newSaleItemDraft.Quantity);
        newSaleValidationMessages.Clear();
    }

    private void AddCatalogItemToSale(SaleCatalogItem catalogItem)
    {
        newSaleValidationMessages.Clear();
        if (catalogItem.Price <= 0)
        {
            SelectSaleCatalogItem(catalogItem.Id);
            newSaleValidationMessages.Add("This item does not have a valid selling price.");
            return;
        }

        var existingItem = newSale.Items.FirstOrDefault(item =>
            string.Equals(item.InventoryId, catalogItem.Id, StringComparison.OrdinalIgnoreCase)
            && item.Discount == 0);

        if (existingItem is not null)
        {
            existingItem.Quantity = Math.Max(1, existingItem.Quantity) + 1;
            existingItem.TotalPrice = decimal.Round(existingItem.Quantity * existingItem.UnitPrice, 2);
        }
        else
        {
            newSale.Items.Add(new TransactionItem
            {
                InventoryId = catalogItem.Id,
                Name = catalogItem.Name,
                Description = string.IsNullOrWhiteSpace(catalogItem.Description)
                    ? catalogItem.Name
                    : catalogItem.Description,
                ImageUrl = catalogItem.ImageUrl,
                Category = catalogItem.Type,
                Quantity = 1,
                UnitPrice = decimal.Round(catalogItem.Price, 2),
                Discount = 0,
                TotalPrice = decimal.Round(catalogItem.Price, 2)
            });
        }

        selectedCatalogItemId = catalogItem.Id;
        UpdateNewSaleTotals();
    }

    private void SelectSaleItemType(string type)
    {
        selectedSaleItemType = type;
        selectedCatalogItemId = "";
        newSaleItemDraft = CreateDefaultSaleItem();
        newSaleItemDraft.Category = selectedSaleItemType;
        newSaleValidationMessages.Clear();
    }

