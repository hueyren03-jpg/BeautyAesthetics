@page "/sales/outstanding-history"
@namespace Beauty_Aesthetics_WebPos.Components.Pages
@using Beauty_Aesthetics_WebPos.Models.DTOs
@using Beauty_Aesthetics_WebPos.Components.Services.Customers
@using Beauty_Aesthetics_WebPos.Components.Services.Feedback
@inject OutstandingPaymentHistoryService HistoryService
@inject NavigationManager Navigation
@inject AppFeedbackService Feedback

<main class="outstanding-history-page">
    <header class="history-header">
        <div class="history-title-group">
            <button type="button" class="icon-button" title="Back to Sales" @onclick="BackToSales">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div>
                <h1>Outstanding Payment History</h1>
                <p>AR Receipt payments created successfully from BeautyAesthetics.</p>
            </div>
        </div>

        <button type="button" class="refresh-button" disabled="@isLoading" @onclick="LoadHistoryAsync">
            <i class="bi bi-arrow-clockwise"></i>
            <span>@(isLoading ? "Loading..." : "Refresh")</span>
        </button>
    </header>

    <section class="history-summary" aria-label="Outstanding payment history summary">
        <article class="summary-card">
            <span>Receipts</span>
            <strong>@FilteredRecords.Count</strong>
        </article>
        <article class="summary-card">
            <span>Total Collected</span>
            <strong>MYR @FilteredRecords.Sum(item => item.PaidAmount).ToString("N2")</strong>
        </article>
        <article class="summary-card">
            <span>Verified</span>
            <strong>@FilteredRecords.Count(item => item.VerificationPassed)</strong>
        </article>
        <article class="summary-card">
            <span>Latest Payment</span>
            <strong>@LatestPaymentText</strong>
        </article>
    </section>

    <section class="history-panel">
        <div class="history-toolbar">
            <label class="search-box">
                <i class="bi bi-search"></i>
                <input type="search"
                       placeholder="Search receipt, customer, payment method or source document"
                       @bind="searchText"
                       @bind:event="oninput" />
            </label>
        </div>

        @if (isLoading)
        {
            <div class="history-state">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Loading Outstanding payment history...</span>
            </div>
        }
        else if (FilteredRecords.Count == 0)
        {
            <div class="history-state history-empty">
                <i class="bi bi-receipt"></i>
                <strong>No Outstanding payment history found.</strong>
                <span>Successful AR Receipt payments made from BeautyAesthetics will appear here.</span>
            </div>
        }
        else
        {
            <div class="history-table-wrap">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Receipt No.</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Payment Method</th>
                            <th class="amount-column">Amount</th>
                            <th>Status</th>
                            <th class="action-column">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in PagedRecords)
                        {
                            <tr @key="HistoryIdentity(record)">
                                <td>
                                    <div class="receipt-cell">
                                        <strong>@Display(record.ReceiptNo)</strong>
                                        <span>@Display(record.ReceiptID)</span>
                                    </div>
                                </td>
                                <td>@record.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td>
                                    <div class="customer-cell">
                                        <strong>@Display(record.CustomerName)</strong>
                                        <span>@Display(record.CustomerID)</span>
                                    </div>
                                </td>
                                <td>@Display(record.PaymentMethod)</td>
                                <td class="amount-column">MYR @record.PaidAmount.ToString("N2")</td>
                                <td>
                                    <span class="verification-pill @(record.VerificationPassed ? "verified" : "pending")">
                                        <i class="bi @(record.VerificationPassed ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
                                        @(record.VerificationPassed ? "Verified" : "Review")
                                    </span>
                                </td>
                                <td class="action-column">
                                    <button type="button" class="view-button" @onclick="() => OpenDetails(record)">
                                        <i class="bi bi-eye"></i>
                                        <span>View</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="history-mobile-list">
                @foreach (var record in PagedRecords)
                {
                    <article class="history-mobile-card" @key="HistoryIdentity(record)">
                        <div class="mobile-card-heading">
                            <div>
                                <strong>@Display(record.ReceiptNo)</strong>
                                <span>@record.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                            <span class="verification-pill @(record.VerificationPassed ? "verified" : "pending")">
                                @(record.VerificationPassed ? "Verified" : "Review")
                            </span>
                        </div>

                        <div class="mobile-card-grid">
                            <div>
                                <span>Customer</span>
                                <strong>@Display(record.CustomerName)</strong>
                            </div>
                            <div>
                                <span>Payment</span>
                                <strong>@Display(record.PaymentMethod)</strong>
                            </div>
                            <div>
                                <span>Amount</span>
                                <strong>MYR @record.PaidAmount.ToString("N2")</strong>
                            </div>
                            <div>
                                <span>Documents</span>
                                <strong>@record.Documents.Count</strong>
                            </div>
                        </div>

                        <button type="button" class="view-button mobile-view-button" @onclick="() => OpenDetails(record)">
                            <i class="bi bi-eye"></i>
                            <span>View Details</span>
                        </button>
                    </article>
                }
            </div>

            <footer class="history-pagination">
                <span>Showing @PageStart-@PageEnd of @FilteredRecords.Count</span>
                <div>
                    <button type="button" class="icon-button" title="Previous page" disabled="@(currentPage <= 1)" @onclick="PreviousPage">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <strong>@currentPage of @TotalPages</strong>
                    <button type="button" class="icon-button" title="Next page" disabled="@(currentPage >= TotalPages)" @onclick="NextPage">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </footer>
        }
    </section>
</main>

@if (selectedRecord is not null)
{
    <div class="history-dialog-backdrop" @onclick="CloseDetails"></div>
    <section class="history-dialog" role="dialog" aria-modal="true" aria-labelledby="outstanding-history-detail-title">
        <header class="history-dialog-header">
            <div>
                <h2 id="outstanding-history-detail-title">
                    <i class="bi bi-receipt-cutoff"></i>
                    Outstanding Payment Details
                </h2>
                <span>@Display(selectedRecord.ReceiptNo)</span>
            </div>
            <button type="button" title="Close" aria-label="Close Outstanding payment details" @onclick="CloseDetails">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="history-dialog-content">
            <section class="detail-section">
                <h3>Receipt Information</h3>
                <div class="detail-grid">
                    <div class="detail-item">
                        <span>Receipt No.</span>
                        <strong>@Display(selectedRecord.ReceiptNo)</strong>
                    </div>
                    <div class="detail-item">
                        <span>Receipt ID</span>
                        <strong>@Display(selectedRecord.ReceiptID)</strong>
                    </div>
                    <div class="detail-item">
                        <span>Date</span>
                        <strong>@selectedRecord.PaymentDate.ToString("dd MMMM yyyy, hh:mm tt")</strong>
                    </div>
                    <div class="detail-item">
                        <span>Branch</span>
                        <strong>@Display(selectedRecord.BranchID)</strong>
                    </div>
                    <div class="detail-item">
                        <span>Customer</span>
                        <strong>@Display(selectedRecord.CustomerName)</strong>
                    </div>
                    <div class="detail-item">
                        <span>Customer ID</span>
                        <strong>@Display(selectedRecord.CustomerID)</strong>
                    </div>
                    <div class="detail-item">
                        <span>Payment Method</span>
                        <strong>@Display(selectedRecord.PaymentMethod)</strong>
                    </div>
                    <div class="detail-item">
                        <span>Amount Paid</span>
                        <strong class="detail-amount">MYR @selectedRecord.PaidAmount.ToString("N2")</strong>
                    </div>
                </div>
            </section>

            <section class="detail-section">
                <div class="detail-section-heading">
                    <h3>Settled Documents</h3>
                    <span>@selectedRecord.Documents.Count document(s)</span>
                </div>

                @if (selectedRecord.Documents.Count == 0)
                {
                    <p class="detail-muted">No source-document details were stored for this receipt.</p>
                }
                else
                {
                    <div class="document-table-wrap">
                        <table class="document-table">
                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Document ID</th>
                                    <th>Paid</th>
                                    <th>Remaining After</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var document in selectedRecord.Documents)
                                {
                                    <tr>
                                        <td>@Display(document.DocumentNo)</td>
                                        <td>@Display(document.SourceDocumentID)</td>
                                        <td>MYR @document.AmountPaid.ToString("N2")</td>
                                        <td>MYR @document.RemainingAfterPayment.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="verification-card @(selectedRecord.VerificationPassed ? "verified" : "pending")">
                <div>
                    <i class="bi @(selectedRecord.VerificationPassed ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                    <div>
                        <strong>@(selectedRecord.VerificationPassed ? "Post-save verification passed" : "Post-save verification needs review")</strong>
                        <span>@Display(selectedRecord.VerificationMessage)</span>
                    </div>
                </div>

                @if (selectedRecord.CustomerOutstandingAfterPayment.HasValue)
                {
                    <div class="verified-balance">
                        <span>Customer Outstanding After Payment</span>
                        <strong>MYR @selectedRecord.CustomerOutstandingAfterPayment.Value.ToString("N2")</strong>
                    </div>
                }
            </section>
        </div>
    </section>
}

@code {
    private readonly List<OutstandingPaymentHistoryDTO> records = new();
    private OutstandingPaymentHistoryDTO? selectedRecord;
    private bool isLoading = true;
    private bool hasLoaded;
    private string searchText = string.Empty;
    private int currentPage = 1;
    private const int PageSize = 20;

    private IReadOnlyList<OutstandingPaymentHistoryDTO> FilteredRecords
    {
        get
        {
            var query = records.AsEnumerable();
            var search = searchText?.Trim() ?? string.Empty;

            if (!string.IsNullOrWhiteSpace(search))
            {
                query = query.Where(record =>
                    Contains(record.ReceiptNo, search) ||
                    Contains(record.ReceiptID, search) ||
                    Contains(record.CustomerName, search) ||
                    Contains(record.CustomerID, search) ||
                    Contains(record.PaymentMethod, search) ||
                    record.Documents.Any(document =>
                        Contains(document.DocumentNo, search) ||
                        Contains(document.SourceDocumentID, search)));
            }

            return query
                .OrderByDescending(record => record.PaymentDate)
                .ToList();
        }
    }

    private IReadOnlyList<OutstandingPaymentHistoryDTO> PagedRecords =>
        FilteredRecords
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRecords.Count / (double)PageSize));
    private int PageStart => FilteredRecords.Count == 0 ? 0 : ((currentPage - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(currentPage * PageSize, FilteredRecords.Count);

    private string LatestPaymentText =>
        FilteredRecords.Count == 0
            ? "-"
            : FilteredRecords.Max(item => item.PaymentDate).ToString("dd MMM yyyy");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasLoaded)
        {
            return;
        }

        hasLoaded = true;
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var loaded = await HistoryService.LoadAsync();
            records.Clear();
            records.AddRange(loaded);
            currentPage = 1;

            Console.WriteLine(
                $"[Outstanding Step 12] HISTORY PAGE LOADED | Records={records.Count} | " +
                $"Total={records.Sum(item => item.PaidAmount):N2}");
        }
        catch (Exception ex)
        {
            Feedback.Error(
                $"Unable to load Outstanding payment history. {ex.Message}",
                "Outstanding history unavailable");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenDetails(OutstandingPaymentHistoryDTO record) => selectedRecord = record;
    private void CloseDetails() => selectedRecord = null;
    private void BackToSales() => Navigation.NavigateTo("/sales");

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private static string HistoryIdentity(OutstandingPaymentHistoryDTO record) =>
        !string.IsNullOrWhiteSpace(record.ReceiptID)
            ? record.ReceiptID
            : $"{record.ReceiptNo}|{record.PaymentDate:O}";
}
