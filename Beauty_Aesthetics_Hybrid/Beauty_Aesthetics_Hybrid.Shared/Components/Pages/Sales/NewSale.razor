    private void ReconcileAssignedCreditAfterLineChange(
        TransactionItem item,
        decimal previousLineTotal,
        string changeSource)
    {
        if (!currentOrder.IsRedemptionMode || item.ActivityTypeId != 6)
        {
            return;
        }

        var allocations = EffectiveLineCreditAllocations(item);
        if (allocations.Count == 0)
        {
            ClearCreditFromLine(item);
            return;
        }

        var newLineTotal = Math.Round(
            Math.Max(0m, item.TotalPrice),
            2,
            MidpointRounding.AwayFromZero);
        var previousTotal = Math.Round(
            Math.Max(0m, previousLineTotal),
            2,
            MidpointRounding.AwayFromZero);
        var allocatedTotal = Math.Round(
            allocations.Sum(allocation => allocation.Amount),
            2,
            MidpointRounding.AwayFromZero);

        if (newLineTotal <= 0m)
        {
            var released = allocatedTotal;
            ClearCreditFromLine(item);
            currentOrder.Payments.Clear();

            Console.WriteLine(
                $"[Member Credit Step 34] RELEASE | Item={item.InventoryId} | Change={changeSource} | " +
                $"PreviousLine={previousTotal:N2} | NewLine=0.00 | Released={released:N2}");

            Feedback.Info(
                $"The line is now RM 0.00, so RM {released:N2} of local Member Credit allocation was released.",
                "Member Credit adjusted",
                2600);
            return;
        }

        if (allocatedTotal - newLineTotal > 0.009m)
        {
            // Preserve the existing FIFO/account order and trim only the excess.
            // Earlier allocations stay intact; the last-used account is reduced first.
            var remainingNeeded = newLineTotal;
            var adjusted = new List<MemberCreditAllocation>();

            foreach (var allocation in allocations)
            {
                if (remainingNeeded <= 0m)
                {
                    break;
                }

                var amount = Math.Min(
                    Math.Round(allocation.Amount, 2, MidpointRounding.AwayFromZero),
                    remainingNeeded);
                amount = Math.Round(amount, 2, MidpointRounding.AwayFromZero);

                if (amount <= 0m)
                {
                    continue;
                }

                adjusted.Add(new MemberCreditAllocation
                {
                    MemberCreditAccountId = allocation.MemberCreditAccountId,
                    MemberTypeId = allocation.MemberTypeId,
                    Amount = amount
                });

                remainingNeeded = Math.Max(0m, remainingNeeded - amount);
            }

            ApplyCanonicalLineCreditAllocation(item, adjusted);
            currentOrder.Payments.Clear();

            var adjustedTotal = adjusted.Sum(allocation => allocation.Amount);
            var released = Math.Max(0m, allocatedTotal - adjustedTotal);

            Console.WriteLine(
                $"[Member Credit Step 34] LOWER | Item={item.InventoryId} | Change={changeSource} | " +
                $"PreviousLine={previousTotal:N2} | NewLine={newLineTotal:N2} | " +
                $"BeforeCredit={allocatedTotal:N2} | AfterCredit={adjustedTotal:N2} | Released={released:N2}");

            Feedback.Info(
                $"The line amount decreased to RM {newLineTotal:N2}. Member Credit was reduced automatically by RM {released:N2}.",
                "Member Credit recalculated",
                2800);
            return;
        }

        // Keep valid credit already assigned when the line becomes more expensive.
        // The user can add another credit account in the selector. Because Senang's
        // redemption request requires ActivityTypeID=6 lines to be fully covered,
        // the incomplete line is blocked before payment until the gap is resolved
        // or Member Credit is removed from this line.
        ApplyCanonicalLineCreditAllocation(item, allocations);

        if (newLineTotal - allocatedTotal > 0.009m)
        {
            currentOrder.Payments.Clear();
            var extraNeeded = Math.Round(
                newLineTotal - allocatedTotal,
                2,
                MidpointRounding.AwayFromZero);

            Console.WriteLine(
                $"[Member Credit Step 34] HIGHER | Item={item.InventoryId} | Change={changeSource} | " +
                $"PreviousLine={previousTotal:N2} | NewLine={newLineTotal:N2} | " +
                $"CreditKept={allocatedTotal:N2} | ExtraNeeded={extraNeeded:N2}");

            Feedback.Warning(
                $"The line amount increased to RM {newLineTotal:N2}. Existing Member Credit RM {allocatedTotal:N2} was kept. " +
                $"Assign another RM {extraNeeded:N2} of Member Credit, or remove Member Credit from this line to use another payment source.",
                "More credit required");
            return;
        }

        Console.WriteLine(
            $"[Member Credit Step 34] MATCH | Item={item.InventoryId} | Change={changeSource} | " +
            $"Line={newLineTotal:N2} | Credit={allocatedTotal:N2}");
    }

    private static void ApplyCanonicalLineCreditAllocation(
        TransactionItem item,
        IReadOnlyList<MemberCreditAllocation> allocations)
    {
        var normalized = allocations
            .Where(allocation =>
                !string.IsNullOrWhiteSpace(allocation.MemberCreditAccountId) &&
                allocation.Amount > 0m)
            .GroupBy(
                allocation => allocation.MemberCreditAccountId.Trim(),
                StringComparer.OrdinalIgnoreCase)
            .Select(group => new MemberCreditAllocation
            {
                MemberCreditAccountId = group.Key,
                MemberTypeId = group
                    .Select(allocation => allocation.MemberTypeId)
                    .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))
                    ?? string.Empty,
                Amount = Math.Round(
                    group.Sum(allocation => allocation.Amount),
                    2,
                    MidpointRounding.AwayFromZero)
            })
            .ToList();

        if (normalized.Count == 0)
        {
            ClearCreditFromLine(item);
            return;
        }

        item.MemberCreditAllocations = normalized;
        item.ActivityTypeId = 6;
        item.MemberTypeId = normalized[0].MemberTypeId;

        if (normalized.Count == 1)
        {
            item.MemberCreditAccountId = normalized[0].MemberCreditAccountId;
            item.MembershipCredit = string.Empty;
        }
        else
        {
            item.MemberCreditAccountId = string.Empty;
            item.MembershipCredit = SerializeLineCreditAllocations(normalized);
        }
    }

