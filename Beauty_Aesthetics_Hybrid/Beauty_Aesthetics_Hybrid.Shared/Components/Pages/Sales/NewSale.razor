@if (showCustomerPackageDialog)
{
    <CustomerPackageDialog CustomerId="@currentOrder.AccountId" CustomerName="@currentOrder.CustomerName" AllowRedeem="@currentOrder.IsRedemptionMode"
                           ReservedQuantities="@ReservedPackageQuantities" OnRedeem="AddPackageRedemption" OnClose="CloseCustomerPackages" />
}

@code {
    private enum SaleStage
    {
        PendingOrders,
        CustomerSelection,
        Cart,
        Payment,
        Complete
    }

    [SupplyParameterFromQuery(Name = "redemptionId")]
    public string? ReopenRedemptionId { get; set; }

    private SaleStage stage = SaleStage.PendingOrders;
    private PendingOrder currentOrder = new();
    private bool showCustomerPackageDialog;

    private void OpenCustomerPackages()
    {
        if (string.IsNullOrWhiteSpace(currentOrder.AccountId))
        {
            Feedback.Warning("Select a customer first.", "Customer required");
            return;
        }
        mobileCartOpen = false;
        showCustomerPackageDialog = true;
    }

    private void CloseCustomerPackages() => showCustomerPackageDialog = false;

    private IEnumerable<TransactionItem> ReservedPackageItems => currentOrder.Items.Concat(
        PendingOrderService.GetAll()
            .Where(order => order.Id != currentOrder.Id &&
                string.Equals(order.AccountId, currentOrder.AccountId, StringComparison.OrdinalIgnoreCase))
            .SelectMany(order => order.Items)).Where(item => item.IsPackageRedemption);

    private IReadOnlyDictionary<string, decimal> ReservedPackageQuantities => ReservedPackageItems
        .GroupBy(item => item.SourceDocumentLineId, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(group => group.Key, group => (decimal)group.Sum(item => item.Quantity), StringComparer.OrdinalIgnoreCase);

    private decimal PackageReservedQuantity(string sourceId, TransactionItem? excluding = null) => ReservedPackageItems
        .Where(item => !ReferenceEquals(item, excluding) && string.Equals(item.SourceDocumentLineId, sourceId, StringComparison.OrdinalIgnoreCase))
        .Sum(item => item.Quantity);

    private void AddPackageRedemption(TransactionItem item)
    {
        if (!currentOrder.IsRedemptionMode || !item.IsPackageRedemption) return;
        currentOrder.Items.Add(item);
        currentOrder.Payments.Clear();
        PendingOrderService.SaveOrUpdate(currentOrder);
        showCustomerPackageDialog = false;
        Feedback.Success($"{item.Name} added to cart.", "Package session", 2000);
    }

    private bool isReopenedRedemption;
    private List<PendingOrder> pendingOrders = new();
    private PendingOrder? orderToDelete;
    private string pendingSearchText = string.Empty;

    private Transaction? savedSale;
    private List<Customer> customers = new();
    private List<Customer> defaultCustomers = new();
    private List<CashSalesPaymentTypeDTO> paymentTypes = new();
    private List<CatalogItem> catalog = new();

    private bool isAddingNewCustomer;

    private string selectedType = string.Empty;
    private string searchText = string.Empty;
    private string customerSearchText = string.Empty;
    private bool isChangingCustomerForExistingOrder;

    private bool isCustomerSearchLoading;
    private bool isLoading = true;
    private bool isSaving;
    private bool isDownloadingReceipt;
    private int customerSearchRequestVersion;
    private CancellationTokenSource? customerSearchCts;

    private decimal? selectedCustomerOutstandingBalance;
    private List<OutstandingDocumentDTO> outstandingDocuments = new();
    private string? outstandingDocumentsError;
    private bool isOutstandingDocumentsLoading;
    private bool showOutstandingSettlement;
    private Dictionary<string, decimal> outstandingSettlementSelections =
        new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, decimal> outstandingSettlementExpectedBalances =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly List<TransactionPayment> outstandingSettlementPayments = new();
    private bool isOutstandingPaymentMode;
    private decimal? selectedCustomerPointBalance;
    private bool showPointHistory;
    private bool isPointHistoryLoading;
    private string? pointHistoryError;
    private PointHistorySnapshotDTO? pointHistorySnapshot;
    private DateTime pointHistoryFrom = DateTime.Today.AddYears(-1);
    private DateTime pointHistoryTo = DateTime.Today;
    private int pointHistoryRequestVersion;
    private decimal PointDialogCurrentBalance =>
        Math.Max(0m, pointHistorySnapshot?.CurrentPointBalance ?? selectedCustomerPointBalance ?? 0m);
    private decimal PointDialogAllocated =>
        PointsAllocatedOnCurrentBill();
    private decimal? selectedCustomerPackageBalance;
    private decimal? selectedCustomerCreditBalance;
    private List<RedeemableCreditDTO> redeemableCredits = new();
    private bool isRedeemableCreditsLoading;
    private string? redeemableCreditsError;
    private bool showRedeemableCredits;
    private bool showLineCreditSelector;
    private TransactionItem? creditTargetItem;
    private readonly Dictionary<string, decimal> draftLineCreditAllocations =
        new(StringComparer.OrdinalIgnoreCase);
    private List<CreditRedemptionHistoryDTO> creditRedemptionHistory = new();
    private bool isCreditHistoryLoading;
    private string? creditHistoryError;
    private string selectedHistoryCreditId = string.Empty;
    private int creditHistoryRequestVersion;
    private bool isSelectedCustomerBalanceLoading;
    private string? selectedCustomerBalanceError;
    private int selectedCustomerBalanceRequestVersion;
    private int redeemableCreditRequestVersion;
    private bool heldRedemptionCreditValidationRequired;
    private string? heldRedemptionCreditValidationError;

    private CatalogItem? editingCatalogItem;
    private TransactionItem? editingCartItem;
    private int draftQuantity = 1;
    private decimal draftDiscount;
    private string draftCashDiscountId = string.Empty;
    private string draftDiscountMemo = string.Empty;
    private List<CashDiscountRuleDTO> discountRules = new();
    private List<GstTaxCodeDTO> activeTaxCodes = new();
    private string draftTaxCodeId = string.Empty;
    private decimal draftTaxPercentage;
    private bool draftIsTaxInclusive;

    private CashSalesPaymentTypeDTO? calculatorMethod;
    private bool mobileCartOpen;
    private string calculatorDigits = string.Empty;

    private List<TransactionPayment> ActivePaymentLines =>
        isOutstandingPaymentMode
            ? outstandingSettlementPayments
            : currentOrder.Payments;

    private IEnumerable<CashSalesPaymentTypeDTO> VisiblePaymentTypes =>
        isOutstandingPaymentMode
            ? paymentTypes.Where(method => method.POSPaymentTypeID != -10)
            : paymentTypes;

    private decimal OutstandingSettlementAmount =>
        Math.Round(
            outstandingSettlementSelections.Values.Sum(),
            2,
            MidpointRounding.AwayFromZero);

    private decimal PaymentTargetAmount =>
        isOutstandingPaymentMode
            ? OutstandingSettlementAmount
            : AmountDueAfterCredit;

    private bool HasPointRedemption =>
        currentOrder.Items.Any(item => item.Points > 0m);

    private bool HasMemberCreditRedemptionState =>
        currentOrder.IsRedemptionMode ||
        currentOrder.Items.Any(item =>
            item.ActivityTypeId == 6 ||
            !string.IsNullOrWhiteSpace(item.MemberCreditAccountId) ||
            item.MemberCreditAllocations.Count > 0);

    private bool IsFullyPointRedeemedSale =>
        !isOutstandingPaymentMode &&
        !currentOrder.IsRedemptionMode &&
        HasPointRedemption &&
        PaymentTargetAmount <= 0.009m;

    private bool IsFullyCoveredRedemption => !isOutstandingPaymentMode && currentOrder.IsRedemptionMode &&
        currentOrder.Items.Count > 0 && currentOrder.Items.Any(item => item.IsPackageRedemption || item.ActivityTypeId == 6) &&
        PaymentTargetAmount <= 0.009m;
    private decimal RedeemedPackageAmount => currentOrder.IsRedemptionMode
        ? currentOrder.Items.Where(item => item.IsPackageRedemption).Sum(item => item.TotalPrice) : 0m;

    private decimal PaidAmount => ActivePaymentLines.Sum(payment => payment.Amount);
    private decimal RedeemedCreditAmount => currentOrder.IsRedemptionMode
        ? currentOrder.Items
            .Where(item => item.ActivityTypeId == 6)
            .Sum(RedeemedAmountForItem)
        : 0m;

    private decimal DraftLineCreditAllocated => draftLineCreditAllocations.Values.Sum();
    private decimal DraftLineCreditRemaining => creditTargetItem is null
        ? 0m
        : Math.Max(0m, creditTargetItem.TotalPrice - DraftLineCreditAllocated);
    private bool HasFifoCreditAvailable => creditTargetItem is not null &&
        redeemableCredits.Any(credit =>
            credit.IsRedeemable &&
            !string.IsNullOrWhiteSpace(credit.ARAPOutstandingID) &&
            credit.NetBalanceAfterUtilised > 0m &&
            (credit.DueDate.Year <= 1900 || credit.DueDate.Date >= DateTime.Today) &&
            CreditAvailableForLine(credit, creditTargetItem) > 0m);
    private decimal AmountDueAfterCredit => Math.Max(0m, currentOrder.Total - RedeemedCreditAmount - RedeemedPackageAmount);
    private decimal? CreditModalTotalAmount =>
        selectedCustomerCreditBalance ??
        (redeemableCredits.Count > 0
            ? Math.Round(
                redeemableCredits.Sum(credit => credit.NetBalanceAfterUtilised),
                2,
                MidpointRounding.AwayFromZero)
            : null);
    private decimal CreditModalSelectedAmount =>
        Math.Round(RedeemedCreditAmount, 2, MidpointRounding.AwayFromZero);
    private decimal? CreditModalRemainingAmount =>
        CreditModalTotalAmount.HasValue
            ? Math.Round(
                Math.Max(0m, CreditModalTotalAmount.Value - CreditModalSelectedAmount),
                2,
                MidpointRounding.AwayFromZero)
            : null;
    private string FormatCreditModalAmount(decimal? amount) =>
        amount.HasValue
            ? $"RM {amount.Value:N2}"
            : isRedeemableCreditsLoading
                ? "Loading..."
                : "—";

    private decimal CreditSelectedOnCurrentBill(string? accountId)
    {
        if (string.IsNullOrWhiteSpace(accountId))
        {
            return 0m;
        }

        return Math.Round(
            currentOrder.Items
                .Where(item => item.ActivityTypeId == 6)
                .SelectMany(EffectiveLineCreditAllocations)
                .Where(allocation =>
                    string.Equals(
                        allocation.MemberCreditAccountId,
                        accountId,
                        StringComparison.OrdinalIgnoreCase))
                .Sum(allocation => allocation.Amount),
            2,
            MidpointRounding.AwayFromZero);
    }

    private decimal CreditRemainingAfterCurrentBill(RedeemableCreditDTO credit) =>
        Math.Round(
            Math.Max(
                0m,
                credit.NetBalanceAfterUtilised -
                CreditSelectedOnCurrentBill(credit.ARAPOutstandingID)),
            2,
            MidpointRounding.AwayFromZero);
    private decimal Remaining => Math.Max(0, PaymentTargetAmount - PaidAmount);
    private decimal Change => Math.Max(0, PaidAmount - PaymentTargetAmount);
    private decimal PaidExcludingCalculatorMethod => calculatorMethod is null
        ? PaidAmount
        : ActivePaymentLines
            .Where(payment => payment.PaymentTypeId != calculatorMethod.POSPaymentTypeID)
            .Sum(payment => payment.Amount);
    private decimal CalculatorRemaining => Math.Max(0, PaymentTargetAmount - PaidExcludingCalculatorMethod);
    private CashDiscountRuleDTO? SelectedDraftDiscountRule =>
        discountRules.FirstOrDefault(rule =>
            rule.Id.Equals(draftCashDiscountId, StringComparison.OrdinalIgnoreCase));
    private decimal DraftResolvedDiscount => ResolveDraftDiscount(out _);
    private (decimal BeforeTax, decimal Tax) DraftTaxAmounts
    {
        get
        {
            if (editingCatalogItem is null)
            {
                return (0m, 0m);
            }

            OrderLineTaxCalculator.ComputeLineAmounts(
                editingCatalogItem.Price,
                Math.Max(1, draftQuantity),
                DraftResolvedDiscount,
                draftTaxPercentage,
                draftIsTaxInclusive,
                out var beforeTax,
                out var tax);

            return (beforeTax, tax);
        }
    }
    private decimal DraftTaxAmount => DraftTaxAmounts.Tax;
    private decimal DraftTotal => Math.Max(0m, DraftTaxAmounts.BeforeTax + DraftTaxAmounts.Tax);
    private decimal CalculatorAmount => decimal.TryParse(calculatorDigits, out var cents) ? cents / 100m : 0;

    private string ReceiptNumber => string.IsNullOrWhiteSpace(savedSale?.InvoiceNumber) ? currentOrder.OrderNumber : savedSale.InvoiceNumber;
    private decimal ReceiptSubtotalAmount => isReopenedRedemption && savedSale is not null ? savedSale.Subtotal : currentOrder.Subtotal;
    private decimal ReceiptDiscountAmount => isReopenedRedemption && savedSale is not null ? savedSale.Discount : currentOrder.Discount;
    private decimal ReceiptTaxAmount
    {
        get
        {
            var savedTax = savedSale?.Tax ?? 0m;
            if (savedTax != 0m)
            {
                return savedTax;
            }

            var savedLineTax = savedSale?.Items.Sum(item => item.TaxAmount) ?? 0m;
            return savedLineTax != 0m ? savedLineTax : currentOrder.Tax;
        }
    }
    private decimal ReceiptTotalAmount => isReopenedRedemption && savedSale is not null ? savedSale.Amount : currentOrder.Total;
    private DateTime ReceiptDate => savedSale?.Date is { Year: > 1 } value ? value : DateTime.Now;
    private string ReceiptCustomer => string.IsNullOrWhiteSpace(savedSale?.CustomerName) ? currentOrder.CustomerName : savedSale.CustomerName;
    private string ReceiptBranch => string.IsNullOrWhiteSpace(savedSale?.Branch) ? currentOrder.BranchName : savedSale.Branch;
    private IReadOnlyList<TransactionPayment> ReceiptDisplayPayments =>
