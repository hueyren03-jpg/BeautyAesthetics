            </p>
            <div class="confirm-actions">
                <button type="button" class="secondary-action" @onclick="CancelDeleteOrder">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteOrder">Delete Order</button>
            </div>
        </div>
    </section>
