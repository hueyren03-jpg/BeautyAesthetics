    protected override async Task OnInitializedAsync()
    {
        PendingOrderService.OnOrdersChanged += HandlePendingOrdersChanged;
        await LoadWorkspaceAsync();
        RefreshPendingOrders();

        if (!string.IsNullOrWhiteSpace(ReopenRedemptionId))
        {
            await ReopenSavedRedemptionAsync(ReopenRedemptionId);
        }

        isLoading = false;
    }

    private void HandlePendingOrdersChanged()
    {
        InvokeAsync(() =>
        {
            RefreshPendingOrders();
            StateHasChanged();
        });
    }

    private void RefreshPendingOrders()
    {
        pendingOrders = PendingOrderService.GetAll().ToList();
    }

    private async Task LoadWorkspaceAsync()
    {
        await BranchSession.InitializeAsync();

        var branch = BranchSession.CurrentBranch;
        var branchId = branch?.Id ?? "HQ";

        var paymentTask = CashSalesService.LoadPaymentTypesAsync(
            branchId,
            branch?.GroupId ?? string.Empty,
            string.Empty);
        var discountTask = CashDiscountService.LoadAvailableAsync(branchId);
        var customerTask = CustomerService.SearchCustomersAsync(string.Empty);
        var productTask = ProductInventoryService.LoadProductsAsync(branchId);
        var serviceTask = ServiceItemService.LoadServiceItemsAsync(branchId);
        var memberCreditTask = MemberCreditService.LoadMemberCreditsAsync(branchId);
        var taxCodeTask = GstTaxRateService.LoadActiveTaxCodesAsync();

        await Task.WhenAll(paymentTask, discountTask, customerTask, productTask, serviceTask, memberCreditTask, taxCodeTask);

        var paymentResult = await paymentTask;
        var discountResult = await discountTask;
        var customerResult = await customerTask;
        var productResult = await productTask;
        var serviceResult = await serviceTask;
        var memberCreditResult = await memberCreditTask;
        var taxCodeResult = await taxCodeTask;

        activeTaxCodes = taxCodeResult.Success && taxCodeResult.Value is not null
            ? taxCodeResult.Value.ToList()
            : new List<GstTaxCodeDTO>();

        if (paymentResult.Success && paymentResult.Value is not null)
            paymentTypes = paymentResult.Value.ToList();

        discountRules = discountResult.Success && discountResult.Value is not null
            ? discountResult.Value.ToList()
            : new List<CashDiscountRuleDTO>();

        if (customerResult.Success && customerResult.Value is not null)
        {
            customers = customerResult.Value.Where(x => !string.IsNullOrWhiteSpace(x.SystemID)).OrderBy(CustomerName).ToList();
            defaultCustomers = customers.ToList();
        }

        var products = productResult.Success && productResult.Value is not null
            ? productResult.Value
                .Where(x => !string.IsNullOrWhiteSpace(x.MasterAccountId))
                .ToList()
            : new List<InventoryViewModel.InventoryItem>();

        var services = serviceResult.Success && serviceResult.Value is not null
            ? serviceResult.Value
                .Where(x => !string.Equals(x.Status, "Inactive", StringComparison.OrdinalIgnoreCase))
                .ToList()
            : new List<ServiceViewModel.ServiceItem>();

        IReadOnlyList<InventoryPackageSummary> packages = Array.Empty<InventoryPackageSummary>();
        var packageResult = await PackageService.LoadPackagesAsync(services, branchId);
        if (packageResult.Success && packageResult.Value is not null)
        {
            packages = packageResult.Value
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.MasterAccountId) &&
                    !string.Equals(x.Status, "Inactive", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        Console.WriteLine(
            $"[Sales Catalog] WORKSPACE | Branch={branchId} | " +
            $"Products={products.Count} | Services={services.Count} | Packages={packages.Count} | " +
            $"MemberCredit={(memberCreditResult.Success && memberCreditResult.Value is not null ? memberCreditResult.Value.Count : 0)}");

        // Product, Service and Package proxy records already carry their TaxCode
        // and IsTaxInclusive values. Resolve the configured rate once per unique
        // tax code before building the Sales catalog.
        var taxRates = await LoadCatalogTaxRatesAsync(
            products.Select(x => x.TaxCode)
                .Concat(services.Select(x => x.TaxCode))
                .Concat(packages.Select(x => x.TaxCode)));

        catalog.Clear();

        catalog.AddRange(products.Select(x => new CatalogItem(
            x.MasterAccountId,
            x.Type,
            x.Sku,
            "Product",
            x.Price,
            ProductImageService.ResolveImageUrl(x.MasterAccountId, x.ImagePath, x.ImageFileName),
            InventoryTypeId: 1,
            TaxCodeId: x.TaxCode,
            IsTaxInclusive: x.IsTaxInclusive,
            TaxPercentage: CatalogTaxRate(taxRates, x.TaxCode),
            PointToRedeem: x.RedeemPoint,
            AllowPointRedemption: x.AllowPointRedemption)));

        catalog.AddRange(services
            .Where(x => !string.IsNullOrWhiteSpace(x.MasterAccountId))
            .Select(x => new CatalogItem(
                x.MasterAccountId!,
                x.ServiceName,
                x.Sku,
                "Service",
                x.Price,
                ProductImageService.ResolveImageUrl(x.MasterAccountId, x.ImagePath, x.ImageFileName),
                InventoryTypeId: 3,
                TaxCodeId: x.TaxCode,
                IsTaxInclusive: x.IsTaxInclusive,
                TaxPercentage: CatalogTaxRate(taxRates, x.TaxCode),
                PointToRedeem: x.RedeemPoint,
                AllowPointRedemption: x.AllowPointRedemption)));

        catalog.AddRange(packages.Select(x => new CatalogItem(
            x.MasterAccountId,
            x.Name,
            x.Sku,
            "Package",
            x.Price,
            ProductImageService.ResolveImageUrl(x.MasterAccountId, x.ImagePath, x.ImageFileName),
            InventoryTypeId: 5,
            TaxCodeId: x.TaxCode,
            IsTaxInclusive: x.IsTaxInclusive,
            TaxPercentage: CatalogTaxRate(taxRates, x.TaxCode))));

        if (memberCreditResult.Success && memberCreditResult.Value is not null)
        {
            var memberCreditCatalog = await LoadMemberCreditCatalogAsync(
                memberCreditResult.Value,
                branchId);
            catalog.AddRange(memberCreditCatalog);
        }

        catalog = catalog
            .GroupBy(x => x.Id, StringComparer.OrdinalIgnoreCase)
            .Select(x => x.First())
            .OrderBy(x => x.Type)
            .ThenBy(x => x.Name)
            .ToList();

        Console.WriteLine(
            $"[Sales Catalog] READY | Branch={branchId} | Total={catalog.Count} | " +
            $"Product={catalog.Count(item => item.InventoryTypeId == 1)} | " +
            $"Service={catalog.Count(item => item.InventoryTypeId == 3)} | " +
            $"Package={catalog.Count(item => item.InventoryTypeId == 5)} | " +
            $"MemberCredit={catalog.Count(item => item.InventoryTypeId == 7)}");
    }

    private async Task<IReadOnlyDictionary<string, decimal>> LoadCatalogTaxRatesAsync(
        IEnumerable<string?> taxCodes)
    {
        var codes = taxCodes
            .Where(code => !string.IsNullOrWhiteSpace(code))
            .Select(code => code!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (codes.Count == 0)
        {
            return new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
        }

        var resolved = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
        foreach (var code in codes)
        {
            resolved[code] = await GstTaxRateService.GetRateForTaxCodeAsync(code);
        }

        return resolved;
    }

    private static decimal CatalogTaxRate(
        IReadOnlyDictionary<string, decimal> taxRates,
        string? taxCode)
    {
        if (string.IsNullOrWhiteSpace(taxCode))
        {
            return 0m;
        }

        return taxRates.TryGetValue(taxCode.Trim(), out var rate)
            ? Math.Max(0m, rate)
            : 0m;
    }

    private async Task<IReadOnlyList<CatalogItem>> LoadMemberCreditCatalogAsync(
        IReadOnlyList<MembershipViewModel.MemberCredit> summaries,
        string branchId)
    {
        var candidates = summaries
            .Where(item => !string.IsNullOrWhiteSpace(item.MasterAccountId))
            .ToList();

        var tasks = candidates.Select(async credit =>
        {
            var taxRate = await GstTaxRateService.GetRateForTaxCodeAsync(credit.TaxCode);
            return new CatalogItem(
                credit.MasterAccountId!,
                credit.Name,
                credit.Code,
                "Member Credit",
                credit.Price,
                string.Empty,
                InventoryTypeId: 7,
                TaxCodeId: credit.TaxCode,
                IsTaxInclusive: credit.IsTaxInclusive,
                TaxPercentage: taxRate);
        });

        return (await Task.WhenAll(tasks))
            .OrderBy(item => item.Name)
            .ToList();
    }

    private static void RecalculateItemTaxAndTotal(TransactionItem item)
    {
        OrderLineTaxCalculator.ComputeLineAmounts(
            item.UnitPrice,
            Math.Max(1, item.Quantity),
            item.Discount,
            item.TaxPercentage,
            item.IsTaxInclusive,
            out var beforeTax,
            out var taxAmount);

        item.TaxAmount = taxAmount;
        item.TotalPrice = Math.Max(
            0m,
            Math.Round(beforeTax + taxAmount, 2, MidpointRounding.AwayFromZero));
    }

