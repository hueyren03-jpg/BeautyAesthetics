    private decimal PointsAllocatedOnCurrentBill(TransactionItem? except = null) =>
        Math.Round(
            currentOrder.Items
                .Where(item =>
                    !ReferenceEquals(item, except) &&
                    item.Points > 0m)
                .Sum(item => Math.Max(0m, item.Points)),
            2,
            MidpointRounding.AwayFromZero);

    private static bool IsPointRedemptionEligible(TransactionItem item) =>
        !item.IsPackageRedemption && (item.InventoryTypeId is 1 or 3) &&
        item.AllowPointRedemption &&
        item.PointToRedeem > 0m;

    private static decimal RequiredPointsFor(TransactionItem item) =>
        Math.Round(
            Math.Max(0m, item.PointToRedeem) * Math.Max(1, item.Quantity),
            2,
            MidpointRounding.AwayFromZero);

    private void RemovePointRedemption(TransactionItem item, bool clearPayments = true)
    {
        if (item.Points <= 0m)
        {
            return;
        }

        var catalogPrice = catalog
            .FirstOrDefault(candidate =>
                string.Equals(candidate.Id, item.InventoryId, StringComparison.OrdinalIgnoreCase))
            ?.Price ?? 0m;

        item.Points = 0m;
        item.UnitPrice = item.OriginalUnitPrice > 0m
            ? item.OriginalUnitPrice
            : Math.Max(0m, catalogPrice);
        RecalculateItemTaxAndTotal(item);

        if (clearPayments)
        {
            currentOrder.Payments.Clear();
        }
    }

    private decimal ClearAllPointRedemptions()
    {
        var released = Math.Round(
            currentOrder.Items
                .Where(item => item.Points > 0m)
                .Sum(item => Math.Max(0m, item.Points)),
            2,
            MidpointRounding.AwayFromZero);

        foreach (var item in currentOrder.Items.Where(item => item.Points > 0m).ToList())
        {
            RemovePointRedemption(item, clearPayments: false);
        }

        if (released > 0m)
        {
            currentOrder.Payments.Clear();
        }

        return released;
    }

    private async Task<CatalogItem> LoadPointConfigurationAsync(CatalogItem item)
    {
        if (item.InventoryTypeId == 1)
        {
            var productResult = await ProductInventoryService.LoadProductPointConfigurationAsync(item.Id);
            if (productResult.Success && productResult.Value is not null)
            {
                var pointToRedeem = Math.Max(0m, productResult.Value.RedeemPoint);
                return item with
                {
                    PointToRedeem = pointToRedeem,
                    AllowPointRedemption =
                        productResult.Value.AllowPointRedemption &&
                        pointToRedeem > 0m
                };
            }

            Console.WriteLine(
                $"[Point Step 2] Product point config unavailable | Inventory={item.Id} | Error={productResult.ErrorMessage}");
        }
        else if (item.InventoryTypeId == 3)
        {
            var serviceResult = await ServiceItemService.LoadServiceAsync(item.Id);
            if (serviceResult.Success && serviceResult.Value is not null)
            {
                var pointToRedeem = Math.Max(0m, serviceResult.Value.RedeemPoint);
                return item with
                {
                    PointToRedeem = pointToRedeem,
                    AllowPointRedemption =
                        serviceResult.Value.AllowPointRedemption &&
                        pointToRedeem > 0m
                };
            }

            Console.WriteLine(
                $"[Point Step 2] Service point config unavailable | Inventory={item.Id} | Error={serviceResult.ErrorMessage}");
        }

        return item with
        {
            PointToRedeem = 0m,
            AllowPointRedemption = false
        };
    }

    private async Task TogglePointRedemptionAsync(TransactionItem item)
    {
        if (item.InventoryTypeId != 1 && item.InventoryTypeId != 3)
        {
            Console.WriteLine(
                $"[Point Step 9] BLOCKED | Source=Sales | Inventory={item.InventoryId} | " +
                $"Type={item.InventoryTypeId} | Reason=PointRedemptionProductServiceOnly");

            Feedback.Warning(
                "Point redemption is currently supported only for Product and Service items. Package point redemption is postponed.",
                "Points unavailable");
            return;
        }

        if (item.Points > 0m)
        {
            var released = item.Points;
            RemovePointRedemption(item);
            PendingOrderService.SaveOrUpdate(currentOrder);
            Feedback.Info(
                $"{released:0.##} points were released from {item.Name}.",
                "Points removed",
                2200);
            return;
        }

        if (HasMemberCreditRedemptionState)
        {
            Console.WriteLine(
                $"[Point Step 8] BLOCKED | Source=Sales | Customer={currentOrder.AccountId} | " +
                $"Reason=MemberCreditRedemptionState | RedemptionMode={currentOrder.IsRedemptionMode}");

            Feedback.Warning(
                "Point redemption cannot be combined with Member Credit redemption. Switch back to normal Sales mode first.",
                "Points unavailable");
            return;
        }

        if (string.IsNullOrWhiteSpace(currentOrder.AccountId))
        {
            Feedback.Warning(
                "Select a customer before using points.",
                "Customer required");
            return;
        }

        // The product/service proxy list does not always carry point-redemption fields.
        // Refresh the full inventory record when the cashier actually chooses Use points,
        // so a valid backend PointToRedeem/AllowPointRedemption configuration is never
        // hidden by stale catalog data.
        if (item.InventoryTypeId == 1)
        {
            var productResult = await ProductInventoryService.LoadProductPointConfigurationAsync(item.InventoryId);
            if (productResult.Success && productResult.Value is not null)
            {
                item.PointToRedeem = Math.Max(0m, productResult.Value.RedeemPoint);
                item.AllowPointRedemption =
                    productResult.Value.AllowPointRedemption &&
                    item.PointToRedeem > 0m;
            }
            else
            {
                Console.WriteLine(
                    $"[Point Step 2] Product point refresh failed | Inventory={item.InventoryId} | Error={productResult.ErrorMessage}");
            }
        }
        else if (item.InventoryTypeId == 3)
        {
            var serviceResult = await ServiceItemService.LoadServiceAsync(item.InventoryId);
            if (serviceResult.Success && serviceResult.Value is not null)
            {
                item.PointToRedeem = Math.Max(0m, serviceResult.Value.RedeemPoint);
                item.AllowPointRedemption =
                    serviceResult.Value.AllowPointRedemption &&
                    item.PointToRedeem > 0m;
            }
            else
            {
                Console.WriteLine(
                    $"[Point Step 2] Service point refresh failed | Inventory={item.InventoryId} | Error={serviceResult.ErrorMessage}");
            }
        }

        Console.WriteLine(
            $"[Point Step 3] ELIGIBILITY | Inventory={item.InventoryId} | Type={item.InventoryTypeId} | " +
            $"Allow={item.AllowPointRedemption} | PointToRedeem={item.PointToRedeem:0.##} | " +
            $"Eligible={IsPointRedemptionEligible(item)}");

        if (!IsPointRedemptionEligible(item))
        {
            Feedback.Warning(
                $"{item.Name} is not configured for point redemption.",
                "Points unavailable");
            return;
        }

        var balanceResult = await CustomerService.GetBalanceSummaryAsync(currentOrder.AccountId);
        if (!balanceResult.Success || balanceResult.Value is null)
        {
            Feedback.Error(
                balanceResult.ErrorMessage ?? "Unable to load the latest point balance.",
                "Point balance unavailable");
            return;
        }

        selectedCustomerPointBalance = balanceResult.Value.PointBalance;
        var required = RequiredPointsFor(item);
        var alreadyAllocated = PointsAllocatedOnCurrentBill(item);
        var latestBalance = Math.Max(0m, balanceResult.Value.PointBalance);
        var availableForThisLine = Math.Max(0m, latestBalance - alreadyAllocated);

        Console.WriteLine(
            $"[Point Step 6] BALANCE CHECK | Source=Sales | Customer={currentOrder.AccountId} | " +
            $"Inventory={item.InventoryId} | LatestBalance={latestBalance:0.##} | " +
            $"AllocatedElsewhere={alreadyAllocated:0.##} | Available={availableForThisLine:0.##} | " +
            $"Required={required:0.##}");

        if (required <= 0m ||
            required - availableForThisLine > 0.009m)
        {
            Console.WriteLine(
                $"[Point Step 6] BLOCKED | Source=Sales | Customer={currentOrder.AccountId} | " +
                $"Inventory={item.InventoryId} | Available={availableForThisLine:0.##} | Required={required:0.##}");

            Feedback.Warning(
                $"Insufficient points. Available: {availableForThisLine:0.##} pts, Required: {required:0.##} pts.",
                "Not enough points");
            return;
        }

        Console.WriteLine(
            $"[Point Step 6] PASS | Source=Sales | Customer={currentOrder.AccountId} | " +
            $"Inventory={item.InventoryId} | AvailableBeforeAssignment={availableForThisLine:0.##} | " +
            $"Required={required:0.##} | RemainingAfterAssignment={Math.Max(0m, availableForThisLine - required):0.##}");

        if (item.OriginalUnitPrice <= 0m)
        {
            item.OriginalUnitPrice = item.UnitPrice > 0m
                ? item.UnitPrice
                : catalog.FirstOrDefault(candidate =>
                    string.Equals(candidate.Id, item.InventoryId, StringComparison.OrdinalIgnoreCase))?.Price ?? 0m;
        }

        // Point Step 4 follows Senang's item-specific redemption rule:
        // PointToRedeem is a fixed point cost per unit and redemption replaces
        // the full item price. No POS payment PointDeductionRatio/RM conversion
        // is used for this item-redemption flow.
        Console.WriteLine(
            $"[Point Step 4] CONVERSION | Inventory={item.InventoryId} | " +
            $"Rule=FixedItemPointToRedeem | PointToRedeem={item.PointToRedeem:0.##} | " +
            $"Qty={item.Quantity} | Required={required:0.##} | PriceMode=FullReplacement");

        // Beauty's backend consumes DocumentLine.Points as the total deduction
        // for the line, verified by the multi-quantity Step 2 backend test.
        item.Points = required;
        item.UnitPrice = 0m;
        item.Discount = 0m;
        item.CashDiscountId = string.Empty;
        item.DiscountMemo = string.Empty;

        Console.WriteLine(
            $"[Point Step 5] LINE ASSIGNED | Source=Sales | Inventory={item.InventoryId} | " +
            $"Type={item.InventoryTypeId} | Qty={item.Quantity} | " +
            $"PointToRedeem={item.PointToRedeem:0.##} | Points={item.Points:0.##} | " +
            $"UnitPrice={item.UnitPrice:N2} | OriginalUnitPrice={item.OriginalUnitPrice:N2}");

        RecalculateItemTaxAndTotal(item);
        currentOrder.Payments.Clear();
        PendingOrderService.SaveOrUpdate(currentOrder);

        Console.WriteLine(
            $"[Point Step 2] ASSIGNED | Customer={currentOrder.AccountId} | Item={item.InventoryId} | " +
            $"PointToRedeem={item.PointToRedeem:0.##} | Qty={item.Quantity} | " +
            $"LinePoints={item.Points:0.##} | Required={required:0.##} | " +
            $"LatestBalance={latestBalance:0.##} | AllocatedElsewhere={alreadyAllocated:0.##}");

        var totalAllocatedAfterAssignment = PointsAllocatedOnCurrentBill();
        Console.WriteLine(
            $"[Point Step 7] TOTAL ALLOCATION | Source=Sales | Customer={currentOrder.AccountId} | " +
            $"Lines={currentOrder.Items.Count(candidate => candidate.Points > 0m)} | " +
            $"Allocated={totalAllocatedAfterAssignment:0.##} | LatestBalance={latestBalance:0.##} | " +
            $"AvailableRemaining={Math.Max(0m, latestBalance - totalAllocatedAfterAssignment):0.##}");

        Feedback.Success(
            $"{required:0.##} points applied to {item.Name}.",
            "Points applied",
            2200);
    }

    private async Task<bool> RevalidatePointRedemptionsAsync(bool showFeedback = true)
    {
        var pointLines = currentOrder.Items
            .Where(item => item.Points > 0m)
            .ToList();

        if (pointLines.Count == 0)
        {
            return true;
        }

        if (currentOrder.IsRedemptionMode)
        {
            if (showFeedback)
            {
                Feedback.Warning(
                    "Point redemption cannot be combined with Member Credit Redemption Mode.",
                    "Points unavailable");
            }
            return false;
        }

        if (string.IsNullOrWhiteSpace(currentOrder.AccountId))
        {
            if (showFeedback)
            {
                Feedback.Warning(
                    "Select a customer before using points.",
                    "Customer required");
            }
            return false;
        }

        foreach (var item in pointLines)
        {
            if (!IsPointRedemptionEligible(item) ||
                Math.Abs(RequiredPointsFor(item) - item.Points) > 0.009m ||
                Math.Abs(item.UnitPrice) > 0.009m ||
                Math.Abs(item.Discount) > 0.009m ||
                Math.Abs(item.TaxAmount) > 0.009m)
            {
                if (showFeedback)
                {
                    Feedback.Warning(
                        $"{item.Name} has an invalid point-redemption state. Remove and apply points again.",
                        "Points need updating");
                }
                return false;
            }
        }

        var balanceResult = await CustomerService.GetBalanceSummaryAsync(currentOrder.AccountId);
        if (!balanceResult.Success || balanceResult.Value is null)
        {
            if (showFeedback)
            {
                Feedback.Error(
                    balanceResult.ErrorMessage ?? "Unable to recheck the latest point balance.",
                    "Point balance unavailable");
            }
            return false;
        }

        selectedCustomerPointBalance = balanceResult.Value.PointBalance;
        var totalRequired = Math.Round(
            pointLines.Sum(item => Math.Max(0m, item.Points)),
            2,
            MidpointRounding.AwayFromZero);
        var latestBalance = Math.Max(0m, balanceResult.Value.PointBalance);

        Console.WriteLine(
            $"[Point Step 10] FINAL REVALIDATION | Source=Sales | Customer={currentOrder.AccountId} | " +
            $"LatestBalance={latestBalance:0.##} | Required={totalRequired:0.##} | Lines={pointLines.Count}");

        if (totalRequired - latestBalance > 0.009m)
        {
            Console.WriteLine(
                $"[Point Step 10] BLOCKED | Source=Sales | Customer={currentOrder.AccountId} | " +
                $"LatestBalance={latestBalance:0.##} | Required={totalRequired:0.##}");

            if (showFeedback)
            {
                Feedback.Warning(
                    $"The latest point balance is {latestBalance:0.##} pts, but this sale requires {totalRequired:0.##} pts. Remove or adjust point redemption before continuing.",
                    "Point balance changed");
            }
            return false;
        }

        Console.WriteLine(
            $"[Point Step 10] PASS | Source=Sales | Customer={currentOrder.AccountId} | " +
            $"LatestBalance={latestBalance:0.##} | Required={totalRequired:0.##} | " +
            $"RemainingAfterSave={Math.Max(0m, latestBalance - totalRequired):0.##}");

        return true;
    }

