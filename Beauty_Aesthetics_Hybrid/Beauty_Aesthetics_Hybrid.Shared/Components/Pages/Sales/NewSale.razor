    private void ConfirmPaymentAmount()
    {
        if (calculatorMethod is null || CalculatorAmount <= 0m)
        {
            return;
        }

        if (isOutstandingPaymentMode)
        {
            if (calculatorMethod.POSPaymentTypeID == -10)
            {
                Feedback.Warning(
                    "Member Credit cannot be used for Outstanding settlement.",
                    "Payment method not allowed");
                return;
            }

            if (CalculatorAmount > CalculatorRemaining + 0.009m)
            {
                Feedback.Warning(
                    $"This payment method cannot exceed MYR {CalculatorRemaining:N2}; the split total must remain MYR {PaymentTargetAmount:N2}.",
                    "Amount too high");
                return;
            }
        }

        var payment = PaymentFor(calculatorMethod.POSPaymentTypeID);
        if (payment is null)
        {
            payment = new TransactionPayment
            {
                PaymentTypeId = calculatorMethod.POSPaymentTypeID
            };
            ActivePaymentLines.Add(payment);
        }

        payment.PaymentMethod =
            calculatorMethod.POSPaymentTypeName ?? "Payment";
        payment.Amount = CalculatorAmount;
        payment.FinancialAccountId =
            calculatorMethod.FinancialAccountID ?? string.Empty;
        payment.BankName =
            calculatorMethod.FinancialAccountName ?? string.Empty;

        if (!isOutstandingPaymentMode)
        {
            PendingOrderService.SaveOrUpdate(currentOrder);
        }

        calculatorMethod = null;
    }

    private async Task SaveSale()
    {
        if (isSaving) return;

        if (isOutstandingPaymentMode)
        {
            if (Remaining > 0m || ActivePaymentLines.Count == 0)
            {
                Feedback.Warning(
                    $"Add MYR {Remaining:N2} more before continuing.",
                    "Payment incomplete");
                return;
            }

            var outstandingPayments = ActivePaymentLines
                .Where(payment => payment.Amount > 0m)
                .ToList();

            if (outstandingPayments.Count == 0 ||
                outstandingPayments.Any(payment => payment.PaymentTypeId == -10))
            {
                Feedback.Warning(
                    "Choose one or more regular payment methods for Outstanding settlement.",
                    "Payment method required");
                return;
            }

            if (Math.Abs(PaidAmount - PaymentTargetAmount) > 0.009m)
            {
                Feedback.Warning(
                    PaidAmount > PaymentTargetAmount
                        ? $"Outstanding payment exceeds the selected amount by MYR {(PaidAmount - PaymentTargetAmount):N2}."
                        : $"Add MYR {(PaymentTargetAmount - PaidAmount):N2} more before continuing.",
                    PaidAmount > PaymentTargetAmount
                        ? "Payment amount too high"
                        : "Payment incomplete");
                return;
            }

            var outstandingPayment = outstandingPayments[0];
            var branch = BranchSession.CurrentBranch;
            var branchId = string.IsNullOrWhiteSpace(currentOrder.BranchId)
                ? branch?.Id ?? string.Empty
                : currentOrder.BranchId;
            var groupId = string.IsNullOrWhiteSpace(currentOrder.GroupId)
                ? branch?.GroupId ?? branchId
                : currentOrder.GroupId;

            if (string.IsNullOrWhiteSpace(branchId) ||
                string.IsNullOrWhiteSpace(groupId))
            {
                Feedback.Error(
                    "The working branch/group is unavailable for Outstanding settlement.",
                    "Branch required");
                return;
            }

            isSaving = true;
            var feedbackId = Feedback.Loading(
                "Saving Outstanding settlement...",
                "Outstanding payment");

            try
            {
                Console.WriteLine(
                    $"[Outstanding Step 5] SAVE START | Customer={currentOrder.AccountId} | " +
                    $"Branch={branchId} | Group={groupId} | " +
                    $"Documents={outstandingSettlementSelections.Count} | " +
                    $"Amount={PaymentTargetAmount:N2} | Methods={outstandingPayments.Count} | " +
                    $"Split={string.Join(" + ", outstandingPayments.Select(payment => $"{payment.PaymentMethod}:{payment.Amount:N2}"))}");

                var result = await OutstandingBalanceService.CreateSettlementAsync(
                    new OutstandingSettlementSaveRequestDTO
                    {
                        CustomerID = currentOrder.AccountId,
                        CustomerName = currentOrder.CustomerName,
                        BranchID = branchId,
                        GroupID = groupId,
                        FinancialAccountID =
                            outstandingPayment.FinancialAccountId,
                        FinancialAccountName =
                            outstandingPayment.BankName,
                        Payments = outstandingPayments
                            .Select(payment => new OutstandingSettlementPaymentDTO
                            {
                                PaymentTypeID = payment.PaymentTypeId,
                                PaymentMethod = payment.PaymentMethod,
                                FinancialAccountID = payment.FinancialAccountId,
                                FinancialAccountName = payment.BankName,
                                Amount = payment.Amount
                            })
                            .ToList(),
                        ExpectedOutstandingAmounts = new Dictionary<string, decimal>(
                            outstandingSettlementExpectedBalances,
                            StringComparer.OrdinalIgnoreCase),
                        SelectedAmounts = new Dictionary<string, decimal>(
                            outstandingSettlementSelections,
                            StringComparer.OrdinalIgnoreCase)
                    });

                if (!result.Success || result.Value is null)
                {
                    var errorMessage =
                        result.ErrorMessage ??
                        "Unable to save Outstanding settlement.";

                    Console.WriteLine(
                        $"[Outstanding Step 9] SAVE BLOCKED / REFRESH | Customer={currentOrder.AccountId} | " +
                        $"Error={errorMessage}");

                    var isStaleOutstanding =
                        errorMessage.Contains("changed from", StringComparison.OrdinalIgnoreCase) ||
                        errorMessage.Contains("no longer available", StringComparison.OrdinalIgnoreCase) ||
                        errorMessage.Contains("now has only", StringComparison.OrdinalIgnoreCase) ||
                        errorMessage.Contains("latest balance", StringComparison.OrdinalIgnoreCase);

                    outstandingSettlementPayments.Clear();
                    calculatorMethod = null;
                    calculatorDigits = string.Empty;
                    isOutstandingPaymentMode = false;
                    stage = SaleStage.Cart;

                    await LoadSelectedCustomerBalancesAsync(currentOrder.AccountId);
                    showOutstandingSettlement = true;

                    Feedback.Fail(
                        feedbackId,
                        errorMessage,
                        isStaleOutstanding
                            ? "Outstanding changed — review latest balance"
                            : "Outstanding payment failed");
                    return;
                }

                var saved = result.Value;

                Console.WriteLine(
                    $"[Outstanding Step 5] SAVE COMPLETE | Id={saved.Id} | " +
                    $"DisplayCode={saved.DisplayCode} | " +
                    $"Amount={saved.TotalAllocatedAmount:N2} | " +
                    $"Documents={saved.SettledDocumentCount}");

                // Match Senang Retail: preserve the AR Receipt completion
                // details, then show the common Payment Successful receipt screen.
                var paymentMethodDisplay = string.Join(
                    ", ",
                    outstandingPayments.Select(payment => payment.PaymentMethod));

                var outstandingReceipt = new Transaction
                {
                    DocumentId = saved.Id,
                    DocumentTypeId = 11,
                    AccountId = currentOrder.AccountId,
                    BranchId = branchId,
                    GroupId = groupId,
                    Date = DateTime.Now,
                    InvoiceNumber = saved.DisplayCode,
                    CustomerName = currentOrder.CustomerName,
                    CustomerContact = currentOrder.CustomerContact,
                    Branch = branch?.Name ?? branchId,
                    Type = "Outstanding Payment",
                    ItemCount = 1,
                    Amount = saved.TotalAllocatedAmount,
                    Subtotal = saved.TotalAllocatedAmount,
                    Tax = 0m,
                    Discount = 0m,
                    CurrencyName = "MYR",
                    PaymentMethod = paymentMethodDisplay,
                    Status = "Paid",
                    Items = new List<TransactionItem>
                    {
                        new()
                        {
                            Name = "Outstanding Payment",
                            Description = $"{saved.SettledDocumentCount} outstanding document(s)",
                            Category = "Outstanding",
                            Quantity = 1,
                            UnitPrice = saved.TotalAllocatedAmount,
                            TotalPrice = saved.TotalAllocatedAmount
                        }
                    },
                    Payments = outstandingPayments
                        .Select(payment => new TransactionPayment
                        {
                            PaymentTypeId = payment.PaymentTypeId,
                            PaymentMethod = payment.PaymentMethod,
                            Amount = payment.Amount,
                            FinancialAccountId = payment.FinancialAccountId,
                            BankName = payment.BankName
                        })
                        .ToList()
                };
                outstandingReceipt.ReceiptPayments = outstandingReceipt.Payments
                    .Select(payment => new TransactionPayment
                    {
                        PaymentTypeId = payment.PaymentTypeId,
                        PaymentMethod = payment.PaymentMethod,
                        Amount = payment.Amount,
                        FinancialAccountId = payment.FinancialAccountId,
                        BankName = payment.BankName
                    })
                    .ToList();

                AppState.LastSaleDocumentId = saved.Id;
                AppState.LastReceiptNo = saved.DisplayCode;
                AppState.LastPaidAmount = saved.TotalAllocatedAmount;
                AppState.LastPaymentMethod = paymentMethodDisplay;
                AppState.LastCompletedTransaction = outstandingReceipt;
                AppState.LastPaymentReturnUrl = "/sales/new";
                AppState.IsOutstandingPaymentMode = true;

                outstandingSettlementSelections.Clear();
                outstandingSettlementExpectedBalances.Clear();
                outstandingSettlementPayments.Clear();
                isOutstandingPaymentMode = false;
                calculatorMethod = null;
                calculatorDigits = string.Empty;
                stage = SaleStage.Cart;

                if (saved.VerificationPassed)
                {
                    Feedback.Resolve(
                        feedbackId,
                        string.IsNullOrWhiteSpace(saved.DisplayCode)
                            ? $"Outstanding payment of MYR {saved.TotalAllocatedAmount:N2} completed and verified successfully."
                            : $"Outstanding payment {saved.DisplayCode} completed and verified successfully.",
                        "Outstanding payment successful");
                }
                else
                {
                    Feedback.Resolve(
                        feedbackId,
                        string.IsNullOrWhiteSpace(saved.DisplayCode)
                            ? $"Outstanding payment of MYR {saved.TotalAllocatedAmount:N2} was saved."
                            : $"Outstanding payment {saved.DisplayCode} was saved.",
                        "Outstanding payment saved");

                    Feedback.Warning(
                        string.IsNullOrWhiteSpace(saved.VerificationMessage)
                            ? "The AR Receipt was saved, but the latest Outstanding balance could not be fully verified. Refresh Outstanding before taking any further action."
                            : saved.VerificationMessage,
                        "Outstanding verification pending",
                        6000);
                }

                Console.WriteLine(
                    $"[Outstanding Step 11] UI RESULT | Receipt={saved.DisplayCode} | " +
                    $"Verified={saved.VerificationPassed} | " +
                    $"CustomerOutstanding={(saved.VerifiedCustomerOutstanding.HasValue ? saved.VerifiedCustomerOutstanding.Value.ToString("N2") : "unavailable")}");

                NavigationManager.NavigateTo("/complete-sales");
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    $"[Outstanding] SAVE EXCEPTION | Customer={currentOrder.AccountId} | Error={ex}");

                Feedback.Fail(
                    feedbackId,
                    $"Unable to confirm the Outstanding payment. {ex.Message} Refresh Outstanding before retrying.",
                    "Outstanding payment failed");
            }
            finally
            {
                isSaving = false;
            }

            return;
        }

        if (!RebindCurrentOrderToWorkingBranch(out var branchChanged))
        {
            Feedback.Error(
                "The working branch is unavailable. Select a branch before completing the sale.",
                "Branch required");
            return;
        }

        if (branchChanged)
        {
            if (currentOrder.IsRedemptionMode &&
                currentOrder.Items.Any(item =>
                    item.ActivityTypeId == 6 ||
                    EffectiveLineCreditAllocations(item).Count > 0))
            {
                var valid = await RefreshAndRevalidateHeldRedemptionCreditsAsync(showFeedback: true);
                if (!valid)
                {
                    return;
                }
            }
            else if (!string.IsNullOrWhiteSpace(currentOrder.AccountId))
            {
                await LoadSelectedCustomerBalancesAsync(currentOrder.AccountId);
            }

            if (currentOrder.IsHeld)
            {
                PendingOrderService.SaveOrUpdate(currentOrder);
            }

            Console.WriteLine(
                $"[Member Credit Step 38] SAVE PREFLIGHT | " +
                $"Branch={currentOrder.BranchId} | Group={currentOrder.GroupId} | " +
                $"CreditRevalidated={currentOrder.IsRedemptionMode}");
        }

        // Branch rebinding clears stale payment rows, so validate payment only after
        // the Step 38 branch/credit preflight has finished.
        if (Remaining > 0)
        {
            Feedback.Warning($"Add MYR {Remaining:N2} more before completing the sale.", "Payment incomplete");
            return;
        }

        // Point Step 10 — re-read the customer's latest PointBalance at the
        // final UI save boundary. This catches points spent by another
        // terminal after this bill was prepared but before Complete Sale.
        if (HasPointRedemption)
        {
            var finalPointValid = await RevalidatePointRedemptionsAsync(showFeedback: true);
            if (!finalPointValid)
            {
                return;
            }
        }

        isSaving = true;
        try
        {
            var saleTransaction = new Transaction
            {
                DocumentTypeId = currentOrder.IsRedemptionMode ? 52 : 5,
                AccountId = currentOrder.AccountId,
                CustomerName = currentOrder.CustomerName,
                CustomerContact = currentOrder.CustomerContact,
                CustomerEmail = currentOrder.CustomerEmail,
                BranchId = currentOrder.BranchId,
                GroupId = currentOrder.GroupId,
                Branch = currentOrder.BranchName,
                Date = DateTime.Today,
                Status = "Paid",
                Notes = currentOrder.Notes,
                Items = currentOrder.Items.Select(i => new TransactionItem
                {
                    InventoryId = i.InventoryId,
                    Name = i.Name,
                    Sku = i.Sku,
                    Description = i.Description,
                    Category = i.Category,
                    InventoryTypeId = i.InventoryTypeId,
                    ImageUrl = i.ImageUrl,
                    Quantity = i.Quantity,
                    UnitPrice = i.UnitPrice,
                    Discount = i.Discount,
                    CashDiscountId = i.CashDiscountId,
                    DiscountMemo = i.DiscountMemo,
                    TotalPrice = i.TotalPrice,
                    UnitOfMeasureId = i.UnitOfMeasureId,
                    TaxCodeId = i.TaxCodeId,
                    TaxPercentage = i.TaxPercentage,
                    TaxAmount = i.TaxAmount,
                    IsTaxInclusive = i.IsTaxInclusive,
                    PointToRedeem = i.PointToRedeem,
                    AllowPointRedemption = i.AllowPointRedemption,
                    Points = i.Points,
                    OriginalUnitPrice = i.OriginalUnitPrice,
                    ActivityTypeId = i.ActivityTypeId,
                    SourceDocumentLineId = i.SourceDocumentLineId,
                    KitMemberId = i.KitMemberId,
                    OriginalKitPrice = i.OriginalKitPrice,
                    UnitActualValue = i.UnitActualValue,
                    MemberCreditAccountId = i.MemberCreditAccountId,
                    MemberTypeId = i.MemberTypeId,
                    MembershipCredit = i.MembershipCredit,
                    MemberCreditAllocations = i.MemberCreditAllocations
                        .Select(allocation => new MemberCreditAllocation
                        {
                            MemberCreditAccountId = allocation.MemberCreditAccountId,
                            MemberTypeId = allocation.MemberTypeId,
                            Amount = allocation.Amount
                        })
                        .ToList()
                }).ToList(),
                Payments = currentOrder.Payments.Select(p => new TransactionPayment
                {
                    PaymentTypeId = p.PaymentTypeId,
                    PaymentMethod = p.PaymentMethod,
                    Amount = p.Amount
                }).ToList(),
                Subtotal = currentOrder.SubtotalBeforeTax,
                Discount = currentOrder.Discount,
                Tax = currentOrder.Tax,
                Amount = currentOrder.Total,
                ItemCount = currentOrder.ItemCount,
                Type = currentOrder.Items.Select(x => x.Category).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1
                    ? currentOrder.Items[0].Category
                    : "Mixed"
            };

            var firstPayment = currentOrder.Payments.FirstOrDefault();
            saleTransaction.PaymentTypeId = firstPayment?.PaymentTypeId ?? 0;
            saleTransaction.PaymentMethod = string.Join(" + ", currentOrder.Payments.Select(p => p.PaymentMethod).Distinct(StringComparer.OrdinalIgnoreCase));

            var feedbackId = Feedback.Loading("Completing the sale...", "Saving sale");
            var result = await CashSalesService.CreateTransactionAsync(saleTransaction);
            if (!result.Success)
            {
                if ((currentOrder.IsRedemptionMode || saleTransaction.Items.Any(item => item.Points > 0m)) &&
                    !string.IsNullOrWhiteSpace(currentOrder.AccountId))
                {
                    await LoadSelectedCustomerBalancesAsync(currentOrder.AccountId);
                }

                Feedback.Fail(
                    feedbackId,
                    result.ErrorMessage ?? "Unable to complete the sale.",
                    currentOrder.IsRedemptionMode
                        ? "Redemption not completed"
                        : "Sale not completed");
                return;
            }

            savedSale = result.Value ?? saleTransaction;
            if (string.IsNullOrWhiteSpace(savedSale.CustomerName)) savedSale.CustomerName = currentOrder.CustomerName;
            if (savedSale.Amount <= 0) savedSale.Amount = currentOrder.Total;

            if (string.IsNullOrWhiteSpace(savedSale.DocumentId))
            {
                Feedback.Fail(
                    feedbackId,
                    currentOrder.IsRedemptionMode
                        ? "The redemption was not completed because the API did not return Result.Id."
                        : "The sale was not completed because the API did not return Result.Id.",
                    currentOrder.IsRedemptionMode ? "Redemption not completed" : "Sale not completed");
                savedSale = null;
                return;
            }

            // Reload the completed document so the receipt screen uses the actual
            // backend receipt rows, including Member Credit POSPaymentTypeID = -10.
            if (!string.IsNullOrWhiteSpace(savedSale.DocumentId))
            {
                var completedResult = await CashSalesService.LoadTransactionAsync(
                    savedSale.DocumentId,
                    currentOrder.IsRedemptionMode ? 52 : 5);
                if (completedResult.Success && completedResult.Value is not null)
                {
                    var completedSale = completedResult.Value;
                    if (string.IsNullOrWhiteSpace(completedSale.CustomerName))
                        completedSale.CustomerName = currentOrder.CustomerName;
                    if (completedSale.Amount <= 0)
                        completedSale.Amount = currentOrder.Total;
                    if (string.IsNullOrWhiteSpace(completedSale.InvoiceNumber))
                        completedSale.InvoiceNumber = savedSale.InvoiceNumber;

                    savedSale = completedSale;
                }
            }

            // A successfully paid order must never remain in Pending Orders.
            // Clear held state first so any late cart/payment persistence call cannot re-add it.
            var completedOrderId = currentOrder.Id;
            var completedOrderNumber = currentOrder.OrderNumber;
            currentOrder.IsHeld = false;

            var completedPendingCopies = PendingOrderService.GetAll()
                .Where(order =>
                    string.Equals(order.Id, completedOrderId, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrWhiteSpace(completedOrderNumber) &&
                     string.Equals(order.OrderNumber, completedOrderNumber, StringComparison.OrdinalIgnoreCase)))
                .ToList();

            foreach (var pendingCopy in completedPendingCopies)
            {
                PendingOrderService.Delete(pendingCopy.Id);
            }

            // Defensive fallback for a stale/legacy entry where only the order number matches.
            if (completedPendingCopies.Count == 0)
            {
                PendingOrderService.Delete(completedOrderId);
                if (!string.IsNullOrWhiteSpace(completedOrderNumber))
                {
                    PendingOrderService.Delete(completedOrderNumber);
                }
            }

            RefreshPendingOrders();

            stage = SaleStage.Complete;
            Feedback.Resolve(
                feedbackId,
                currentOrder.IsRedemptionMode
                    ? $"Redemption {savedSale.InvoiceNumber} completed successfully."
                    : $"Sale {savedSale.InvoiceNumber} completed successfully.",
                currentOrder.IsRedemptionMode ? "Redemption completed" : "Sale completed");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<ReceiptData> BuildReceiptDataForOutputAsync()
    {
        var receiptItems = savedSale?.Items is { Count: > 0 }
            ? savedSale.Items
            : currentOrder.Items;
        var receiptTaxItems = receiptItems.Any(item =>
                !string.IsNullOrWhiteSpace(item.TaxCodeId) || item.TaxAmount != 0m)
            ? receiptItems
            : currentOrder.Items;
        var customerId = string.IsNullOrWhiteSpace(savedSale?.AccountId)
            ? currentOrder.AccountId
            : savedSale.AccountId;
        var branchId = string.IsNullOrWhiteSpace(savedSale?.BranchId)
            ? currentOrder.BranchId
            : savedSale.BranchId;

        Customer? fullCustomer = null;
        if (!string.IsNullOrWhiteSpace(customerId))
        {
            var customerResult = await CustomerService.LoadCustomerAsync(customerId);
            if (customerResult.Success)
            {
                fullCustomer = customerResult.Value;
            }
        }

        System.Text.Json.Nodes.JsonObject? branchRecord = null;
        if (!string.IsNullOrWhiteSpace(branchId))
        {
            var branchResult = await BranchAC.LoadRecordAsync(branchId);
            if (branchResult.Success)
            {
                branchRecord = branchResult.Value;
            }
        }

        var paidAmount = ReceiptDisplayPayments.Sum(payment => payment.Amount);
        var changeAmount = ReceiptDisplayPayments
            .Where(payment => payment.ChangeAmount > 0m)
            .Sum(payment => payment.ChangeAmount);
        if (changeAmount <= 0m)
        {
            changeAmount = Math.Max(0m, paidAmount - (savedSale?.Amount ?? currentOrder.Total));
        }

        var taxSummary = receiptTaxItems
            .Where(item => !string.IsNullOrWhiteSpace(item.TaxCodeId))
            .GroupBy(item => new { item.TaxCodeId, item.TaxPercentage })
            .Select(group => new TaxSummaryLine
            {
                TaxCode = $"{group.Key.TaxCodeId} {group.Key.TaxPercentage * 100:0.#}%",
                Amount = group.Sum(item => ReceiptLineTaxAmounts(item).BeforeTax),
                Tax = group.Sum(item =>
                    item.TaxAmount != 0m
                        ? item.TaxAmount
                        : ReceiptLineTaxAmounts(item).Tax)
            })
            .ToList();
        var receiptTaxAmount = savedSale?.Tax ?? 0m;
        if (receiptTaxAmount == 0m)
        {
            receiptTaxAmount = taxSummary.Sum(line => line.Tax);
        }
        if (receiptTaxAmount == 0m)
        {
            receiptTaxAmount = currentOrder.Tax;
        }

        return new ReceiptData
        {
            CompanyName = ReceiptBranding.AppTitle,
            LogoUrl = ReceiptBranding.LogoUrl,
            BranchName = ReceiptBranch,
            OutletName = FirstNonEmpty(
                ReceiptRecordReader.Text(branchRecord, "OutletName"),
                ReceiptBranch),
            Address1 = ReceiptRecordReader.Text(branchRecord, "Address1"),
            Address2 = ReceiptRecordReader.Text(branchRecord, "Address2"),
            Address3 = ReceiptRecordReader.Text(branchRecord, "Address3"),
            Phone = ReceiptRecordReader.Text(branchRecord, "Phone", "Contact"),
            Email = ReceiptRecordReader.Text(branchRecord, "Email"),
            CoRegistrationNo = ReceiptRecordReader.Text(
                branchRecord,
                "CoRegistrationNo",
                "CompanyRegistrationNo",
                "RegistrationNo"),
            TIN = ReceiptRecordReader.Text(branchRecord, "TIN", "TaxIdentificationNumber"),
            ReceiptNo = ReceiptNumber,
            DateTimeOfSale = ReceiptDate,
            ReferenceNumber = FirstNonEmpty(savedSale?.ReferenceNumber, currentOrder.OrderNumber),
            CustomerID = customerId,
            CustomerName = ReceiptCustomer,
            CustomerAddress1 = fullCustomer?.Address1 ?? string.Empty,
            CustomerAddress2 = fullCustomer?.Address2 ?? string.Empty,
            CustomerAddress3 = fullCustomer?.Address3 ?? string.Empty,
            CustomerCity = fullCustomer?.City ?? string.Empty,
            CustomerPostcode = fullCustomer?.Postcode ?? string.Empty,
            CustomerState = fullCustomer?.State ?? string.Empty,
            CustomerCountry = fullCustomer?.Country ?? string.Empty,
            CustomerPhone = FirstNonEmpty(
                fullCustomer?.ContactNumber1,
                savedSale?.CustomerContact,
                currentOrder.CustomerContact),
            CashierName = savedSale?.CreatedBy ?? string.Empty,
            CurrencyName = FirstNonEmpty(savedSale?.CurrencyName, "MYR"),
            Items = receiptItems.Select(item => new ReceiptLineItem
            {
                Name = string.IsNullOrWhiteSpace(item.Description) ? item.Name : item.Description,
                Quantity = Math.Max(1, item.Quantity),
                Discount = item.Discount,
                LineTotal = item.TotalPrice != 0m
                    ? item.TotalPrice
                    : (item.UnitPrice * Math.Max(1, item.Quantity)) - item.Discount,
                Remarks = item.Remarks
            }).ToList(),
            Payments = ReceiptDisplayPayments
                .Where(payment => payment.Amount > 0m)
                .Select(payment => new ReceiptPaymentLine
                {
                    Method = ReceiptPaymentLabel(payment),
                    Amount = payment.Amount
                })
                .ToList(),
            TaxSummary = taxSummary,
            Subtotal = savedSale is { Subtotal: > 0m }
                ? savedSale.Subtotal
                : currentOrder.SubtotalBeforeTax,
            TaxAmount = receiptTaxAmount,
            TotalBeforeTax_ServiceCharge = savedSale?.ServiceChargeAmount ?? 0m,
            RoundingAmount = savedSale?.RoundingAmount ?? 0m,
            GrandTotal = savedSale is { Amount: > 0m }
                ? savedSale.Amount
                : currentOrder.Total,
            PaidAmount = paidAmount,
            ChangeAmount = changeAmount
        };
    }

    private async Task PrintReceipt()
    {
        if (savedSale is null)
        {
            return;
        }

        var printer = PrinterSelectionService.GetSelectedPrinter();
        if (printer is null)
        {
            Feedback.Warning(
                "Select a receipt printer in General Setup > Hardware Control > Printer before printing.",
                "Printer missing");
            return;
        }

        var receiptData = await BuildReceiptDataForOutputAsync();
        var printResult = await ReceiptPrinterService.PrintAsync(printer, receiptData);
        if (!printResult.Success)
        {
            Feedback.Error(
                string.IsNullOrWhiteSpace(printResult.Error)
                    ? "The receipt printer did not complete the print job."
                    : printResult.Error,
                "Receipt print failed");
            return;
        }

        Feedback.Success(
            $"Receipt {ReceiptNumber} printed to {printer.Name}.",
            "Receipt printed",
            2800);
    }

    private async Task DownloadPdfReceipt()
    {
        if (savedSale is null)
        {
            Feedback.Error("The completed sale is unavailable.", "Receipt unavailable");
            return;
        }

        if (isDownloadingReceipt)
        {
            return;
        }

        try
        {
            isDownloadingReceipt = true;
            await InvokeAsync(StateHasChanged);

            var fileId = string.IsNullOrWhiteSpace(savedSale.DocumentId)
                ? ReceiptNumber
                : savedSale.DocumentId;
            var receiptDocumentTypeId =
                currentOrder.IsRedemptionMode || isReopenedRedemption
                    ? 52
                    : 5;
            var downloaded = await CashSalesService.DownloadReceiptPdfAsync(
                fileId,
                receiptDocumentTypeId);

            if (!downloaded.Success)
            {
                Feedback.Error(
                    downloaded.ErrorMessage ?? "Unable to download the receipt PDF.",
                    "Receipt download failed");
                return;
            }

            Feedback.Success(
                $"Receipt {ReceiptNumber} downloaded in the Senang thermal format.",
                "Receipt downloaded",
                2800);
        }
        catch (Exception ex)
        {
            Feedback.Error(
                $"Unable to download the receipt PDF. {ex.Message}",
                "Receipt download failed");
        }
        finally
        {
            isDownloadingReceipt = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string EncodeReceiptText(string? value) =>
        System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(value) ? "-" : value);

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static (decimal BeforeTax, decimal Tax) ReceiptLineTaxAmounts(TransactionItem item)
    {
        OrderLineTaxCalculator.ComputeLineAmounts(
            item.UnitPrice,
            Math.Max(1, item.Quantity),
            item.Discount,
            item.TaxPercentage,
            item.IsTaxInclusive,
            out var beforeTax,
            out var tax);

        return (beforeTax, tax);
    }

    private void StartAnotherSale()
    {
        currentOrder = new();
        savedSale = null;
        RefreshPendingOrders();
        stage = SaleStage.PendingOrders;
    }

    private void GoToSalesDashboard() => NavigationManager.NavigateTo("/sales");

    private void OpenCustomerRating()
    {
        if (!CanRequestReview || savedSale is null)
        {
            Feedback.Warning("A customer and completed sales document are required before requesting a review.", "Review unavailable");
            return;
        }

        var branchId = string.IsNullOrWhiteSpace(savedSale.BranchId)
            ? BranchSession.CurrentBranch?.Id ?? string.Empty
            : savedSale.BranchId;
        var customerId = Uri.EscapeDataString(savedSale.AccountId);
        var documentId = Uri.EscapeDataString(savedSale.DocumentId);
        var encodedBranchId = Uri.EscapeDataString(branchId);

        NavigationManager.NavigateTo(
            $"/CustomerRating?customerId={customerId}&documentId={documentId}&branchId={encodedBranchId}&groupId={encodedBranchId}");
    }

    private static string CustomerName(Customer x) => $"{x.FirstName} {x.LastName}".Trim();
    private static string CustomerMeta(Customer x) => string.Join(" | ", new[] { x.ContactNumber1, x.Email }.Where(v => !string.IsNullOrWhiteSpace(v)));
    private static string CustomerMembership(Customer x) => string.IsNullOrWhiteSpace(x.MembershipType) ? "Standard" : x.MembershipType;

    private static string CustomerInitials(Customer x) => GetCustomerInitials(CustomerName(x));

    private static string GetCustomerInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : string.Concat(parts.Take(2).Select(v => char.ToUpperInvariant(v[0])));
    }

    private static string TypeIcon(string type) => type.ToLowerInvariant() switch
    {
        "service" => "bi-stars",
        "package" => "bi-box2-heart",
        _ => "bi-bag"
    };

    private const string EmptyItemImage = "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=";
    private static string ItemImage(string type, string? value) => string.IsNullOrWhiteSpace(value) ? EmptyItemImage : value.Trim();

    private static string PaymentIcon(string? value)
    {
        var v = value?.ToLowerInvariant() ?? "";
        if (v.Contains("cash")) return "bi-cash-stack";
        if (v.Contains("bank") || v.Contains("transfer")) return "bi-bank";
        if (v.Contains("card")) return "bi-credit-card-2-front";
        if (v.Contains("wallet")) return "bi-wallet2";
        if (v.Contains("voucher")) return "bi-ticket-perforated";
        if (v.Contains("point")) return "bi-stars";
        return "bi-credit-card";
    }

