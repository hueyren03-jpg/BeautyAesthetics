        catalog.AddRange(services
            .Where(x => !string.IsNullOrWhiteSpace(x.MasterAccountId))
            .Select(x => new CatalogItem(
                x.MasterAccountId!,
                x.ServiceName,
                x.Sku,
                "Service",
                x.Price,
                ProductImageService.ResolveImageUrl(x.MasterAccountId, x.ImagePath, x.ImageFileName),
                InventoryTypeId: 3)));

        if (services.Count > 0)
        {
            var packageResult = await PackageService.LoadPackagesAsync(services, branchId);
            if (packageResult.Success && packageResult.Value is not null)
            {
                catalog.AddRange(packageResult.Value
                    .Where(x => !string.IsNullOrWhiteSpace(x.MasterAccountId) && !string.Equals(x.Status, "Inactive", StringComparison.OrdinalIgnoreCase))
                    .Select(x => new CatalogItem(
