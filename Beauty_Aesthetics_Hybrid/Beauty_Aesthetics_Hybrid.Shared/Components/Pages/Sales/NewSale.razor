    private async Task UpdateCustomerSearch(ChangeEventArgs e)
    {
        customerSearchText = e.Value?.ToString() ?? string.Empty;
        var keyword = customerSearchText.Trim();
        var requestVersion = ++customerSearchRequestVersion;

        customerSearchCts?.Cancel();
        customerSearchCts?.Dispose();
        customerSearchCts = null;

        if (string.IsNullOrWhiteSpace(keyword))
        {
            customers = defaultCustomers.ToList();
            isCustomerSearchLoading = false;
            return;
        }

        var cts = new CancellationTokenSource();
        customerSearchCts = cts;

        try
        {
            await Task.Delay(350, cts.Token);
            isCustomerSearchLoading = true;
            await InvokeAsync(StateHasChanged);

            var result = await CustomerService.SearchCustomersAsync(keyword, cts.Token);
            if (cts.IsCancellationRequested || requestVersion != customerSearchRequestVersion)
            {
                return;
            }

            customers = result.Success && result.Value is not null
                ? result.Value.Where(x => !string.IsNullOrWhiteSpace(x.SystemID)).OrderBy(CustomerName).ToList()
                : new List<Customer>();

            if (!result.Success)
            {
                Feedback.Error(result.ErrorMessage ?? "Unable to search customers.", "Customer search failed");
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (requestVersion == customerSearchRequestVersion)
            {
                isCustomerSearchLoading = false;
                customerSearchCts = null;
                await InvokeAsync(StateHasChanged);
            }

            cts.Dispose();
        }
    }

    // ========================================= PAYMENT & COMPLETE =========================================

    private async Task ContinueToPayment()
    {
        if (!currentOrder.Items.Any())
        {
            Feedback.Warning("Please add at least one item before proceeding to payment.", "Cart is empty");
            return;
        }

        if (currentOrder.Items.Any(item => item.InventoryTypeId == 7) &&
            string.IsNullOrWhiteSpace(currentOrder.AccountId))
        {
            Feedback.Warning(
                "Select a customer before purchasing Member Credit.",
                "Customer required");
            return;
        }

        if (currentOrder.IsRedemptionMode)
        {
            if (string.IsNullOrWhiteSpace(currentOrder.AccountId))
            {
                Feedback.Warning("Select a customer before redeeming Member Credit.", "Customer required");
                return;
            }

            if (heldRedemptionCreditValidationRequired)
            {
                var revalidated = await RefreshAndRevalidateHeldRedemptionCreditsAsync(showFeedback: true);
                if (!revalidated)
                {
                    return;
                }
            }

            if (!currentOrder.Items.Any(item =>
                    item.ActivityTypeId == 6 &&
                    EffectiveLineCreditAllocations(item).Count > 0))
            {
                Feedback.Warning("Assign a Member Credit account to at least one cart line.", "Credit not assigned");
                return;
            }

            var incompleteCreditLine = currentOrder.Items
                .Where(item => item.ActivityTypeId == 6)
                .Select(item => new
                {
                    Item = item,
                    Allocated = Math.Round(
                        EffectiveLineCreditAllocations(item).Sum(allocation => allocation.Amount),
                        2,
                        MidpointRounding.AwayFromZero),
                    Required = Math.Round(
                        Math.Max(0m, item.TotalPrice),
                        2,
                        MidpointRounding.AwayFromZero)
                })
                .FirstOrDefault(value =>
                    Math.Abs(value.Required - value.Allocated) > 0.009m);

            if (incompleteCreditLine is not null)
            {
                var extraNeeded = Math.Max(
                    0m,
                    incompleteCreditLine.Required - incompleteCreditLine.Allocated);

                Console.WriteLine(
                    $"[Member Credit Step 34] BLOCKED | Item={incompleteCreditLine.Item.InventoryId} | " +
                    $"Required={incompleteCreditLine.Required:N2} | Allocated={incompleteCreditLine.Allocated:N2} | " +
                    $"ExtraNeeded={extraNeeded:N2}");

                Feedback.Warning(
                    extraNeeded > 0m
                        ? $"{incompleteCreditLine.Item.Name} now needs another RM {extraNeeded:N2} of Member Credit. " +
                          "Assign extra credit, or remove Member Credit from that line to use another payment source."
                        : $"{incompleteCreditLine.Item.Name} has an invalid Member Credit allocation. Reassign its credit before continuing.",
                    "Member Credit needs updating");
                return;
            }

            if (Remaining <= 0m)
            {
                paymentTypes.Clear();
                stage = SaleStage.Payment;
                return;
            }
        }

        var branch = BranchSession.CurrentBranch;
        var branchId = string.IsNullOrWhiteSpace(currentOrder.BranchId)
            ? branch?.Id ?? "HQ"
            : currentOrder.BranchId;
        var groupId = branch?.GroupId ?? string.Empty;

        var paymentResult = await CashSalesService.LoadPaymentTypesAsync(
            branchId,
            groupId,
            currentOrder.AccountId);

        if (!paymentResult.Success || paymentResult.Value is null)
        {
            Feedback.Error(
                paymentResult.ErrorMessage ?? "Unable to load payment methods.",
                "Payment methods not loaded");
            return;
        }

        paymentTypes = paymentResult.Value.ToList();

        PendingOrderService.SaveOrUpdate(currentOrder);
        stage = SaleStage.Payment;
    }

