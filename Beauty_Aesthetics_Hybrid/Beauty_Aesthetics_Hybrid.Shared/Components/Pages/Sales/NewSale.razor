    private async Task ReopenSavedRedemptionAsync(string documentId)
    {
        var normalizedId = documentId.Trim();
        if (string.IsNullOrWhiteSpace(normalizedId))
        {
            return;
        }

        var result = await CashSalesService.LoadTransactionAsync(normalizedId, 52);
        if (!result.Success || result.Value is null)
        {
            stage = SaleStage.PendingOrders;
            Feedback.Fail(
                Feedback.Loading("Loading saved redemption...", "Reopening redemption"),
                result.ErrorMessage ?? "Unable to load the saved redemption.",
                "Redemption not reopened");
            return;
        }

        var restored = result.Value;
        var redemptionItems = restored.Items
            .Where(item => item.ActivityTypeId == 6)
            .ToList();

        if (redemptionItems.Count == 0)
        {
            stage = SaleStage.PendingOrders;
            Feedback.Warning(
                $"Document {normalizedId} did not contain saved redemption lines.",
                "Redemption not reopened");
            return;
        }

        savedSale = restored;
        savedSale.DocumentTypeId = 52;
        currentOrder = PendingOrderFromSavedRedemption(savedSale);
        isReopenedRedemption = true;
        stage = SaleStage.Complete;

        var restoredCreditAccounts = redemptionItems
            .SelectMany(item =>
                item.MemberCreditAllocations.Count > 0
                    ? item.MemberCreditAllocations.Select(allocation => allocation.MemberCreditAccountId)
                    : string.IsNullOrWhiteSpace(item.MemberCreditAccountId)
                        ? Array.Empty<string>()
                        : new[] { item.MemberCreditAccountId })
            .Where(accountId => !string.IsNullOrWhiteSpace(accountId))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        var restoredReceiptLines = savedSale.ReceiptPayments.Count(payment =>
            payment.PaymentTypeId == -10 &&
            !string.IsNullOrWhiteSpace(payment.SourceDocumentLineId) &&
            payment.Amount > 0m);

        var allCreditMappingsRestored = redemptionItems.All(item =>
            item.MemberCreditAllocations.Any(allocation =>
                !string.IsNullOrWhiteSpace(allocation.MemberCreditAccountId) &&
                allocation.Amount > 0m));

        var step32Passed =
            allCreditMappingsRestored &&
            restoredCreditAccounts > 0 &&
            restoredReceiptLines > 0;

        Console.WriteLine(
            $"[Member Credit Step 32] {(step32Passed ? "PASS" : "WARNING")} | Document={savedSale.DocumentId} | " +
            $"RedemptionLines={redemptionItems.Count} | CreditAccounts={restoredCreditAccounts} | " +
            $"CreditReceiptLines={restoredReceiptLines}");

        if (step32Passed)
        {
            Feedback.Success(
                $"Redemption {savedSale.InvoiceNumber} was reloaded from the saved backend record.",
                "Redemption reopened",
                2600);
        }
        else
        {
            Feedback.Warning(
                $"Redemption {savedSale.InvoiceNumber} was loaded, but some saved Member Credit mappings or receipt lines were not returned by the backend.",
                "Redemption reopened with warning");
        }
    }

    private static PendingOrder PendingOrderFromSavedRedemption(Transaction transaction)
    {
        var membershipType = transaction.Items
            .Where(item => item.ActivityTypeId == 6)
            .SelectMany(item =>
                item.MemberCreditAllocations.Count > 0
                    ? item.MemberCreditAllocations.Select(allocation => allocation.MemberTypeId)
                    : new[] { item.MemberTypeId })
            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))
            ?? string.Empty;

        return new PendingOrder
        {
            Id = $"reopened-{transaction.DocumentId}",
            OrderNumber = string.IsNullOrWhiteSpace(transaction.InvoiceNumber)
                ? transaction.DocumentId
                : transaction.InvoiceNumber,
            CreatedAt = transaction.Date,
            UpdatedAt = transaction.Date,
            IsHeld = false,
            IsRedemptionMode = true,
            AccountId = transaction.AccountId,
            CustomerName = transaction.CustomerName,
            CustomerContact = transaction.CustomerContact,
            CustomerEmail = transaction.CustomerEmail,
            MembershipType = membershipType,
            BranchId = transaction.BranchId,
            BranchName = string.IsNullOrWhiteSpace(transaction.Branch)
                ? transaction.BranchId
                : transaction.Branch,
            GroupId = transaction.GroupId,
            Notes = transaction.Notes,
            Items = transaction.Items.Select(item => new TransactionItem
            {
                Id = item.Id,
                TransactionId = item.TransactionId,
                InventoryId = item.InventoryId,
                Name = item.Name,
                Sku = item.Sku,
                Description = item.Description,
                Remarks = item.Remarks,
                ImageUrl = item.ImageUrl,
                Category = item.Category,
                InventoryTypeId = item.InventoryTypeId,
                Quantity = item.Quantity,
                UnitPrice = item.UnitPrice,
                TotalPrice = item.TotalPrice,
                Discount = item.Discount,
                CashDiscountId = item.CashDiscountId,
                DiscountMemo = item.DiscountMemo,
                UnitOfMeasureId = item.UnitOfMeasureId,
                TaxCodeId = item.TaxCodeId,
                TaxPercentage = item.TaxPercentage,
                TaxAmount = item.TaxAmount,
                IsTaxInclusive = item.IsTaxInclusive,
                PointToRedeem = item.PointToRedeem,
                AllowPointRedemption = item.AllowPointRedemption,
                Points = item.Points,
                OriginalUnitPrice = item.OriginalUnitPrice,
                ActivityTypeId = item.ActivityTypeId,
                SourceDocumentLineId = item.SourceDocumentLineId,
                KitMemberId = item.KitMemberId,
                OriginalKitPrice = item.OriginalKitPrice,
                UnitActualValue = item.UnitActualValue,
                MemberCreditAccountId = item.MemberCreditAccountId,
                MemberTypeId = item.MemberTypeId,
                MembershipCredit = item.MembershipCredit,
                MemberCreditAllocations = item.MemberCreditAllocations
                    .Select(allocation => new MemberCreditAllocation
                    {
                        MemberCreditAccountId = allocation.MemberCreditAccountId,
                        MemberTypeId = allocation.MemberTypeId,
