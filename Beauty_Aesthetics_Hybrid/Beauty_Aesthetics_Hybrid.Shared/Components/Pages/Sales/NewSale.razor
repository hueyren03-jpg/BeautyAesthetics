    private async Task OpenItemEditor(CatalogItem item)
    {
        if (currentOrder.IsRedemptionMode && IsRedemptionRestrictedPurchaseType(item.InventoryTypeId))
        {
            Feedback.Warning(
                "This purchase item is not available in Redemption Mode. Use Product or Service items for Member Credit redemption.",
                "Redemption mode");
            return;
        }

        if (item.InventoryTypeId == 7 && string.IsNullOrWhiteSpace(currentOrder.AccountId))
        {
            Feedback.Warning(
                "Select a customer before adding member credit.",
                "Customer required");
            return;
        }

        if (item.InventoryTypeId == 7)
        {
            var fullResult = await MemberCreditService.LoadMemberCreditAsync(item.Id);
            if (fullResult.Success && fullResult.Value is not null)
            {
                var credit = fullResult.Value;
                var taxRate = await GstTaxRateService.GetRateForTaxCodeAsync(credit.TaxCode);
                item = item with
                {
                    Name = credit.Name,
                    Sku = credit.Code,
                    Price = credit.Price,
                    TaxCodeId = credit.TaxCode,
                    IsTaxInclusive = credit.IsTaxInclusive,
                    TaxPercentage = taxRate
                };
            }
            else
            {
                Console.WriteLine(
                    $"[Member Credit] Full record load failed for {item.Id}; continuing with branch proxy data. {fullResult.ErrorMessage}");
            }
        }

        editingCatalogItem = item;
        editingCartItem = null;
        draftQuantity = 1;
        draftDiscount = 0;
        draftCashDiscountId = string.Empty;
        draftDiscountMemo = string.Empty;
    }

    private void EditCartItem(TransactionItem item)
    {
        editingCartItem = item;
        editingCatalogItem = catalog.FirstOrDefault(x => x.Id == item.InventoryId) ??
            new CatalogItem(
                item.InventoryId,
                item.Name,
                item.Sku,
                item.Category,
                item.UnitPrice,
                ItemImage(item.Category, item.ImageUrl),
                item.InventoryTypeId,
                item.TaxCodeId,
                item.IsTaxInclusive,
                item.TaxPercentage);
        draftQuantity = item.Quantity;
        draftDiscount = item.Discount;
        draftCashDiscountId = item.CashDiscountId;
        draftDiscountMemo = item.DiscountMemo;
    }

    private void CloseItemEditor()
    {
        editingCatalogItem = null;
        editingCartItem = null;
        draftCashDiscountId = string.Empty;
        draftDiscountMemo = string.Empty;
    }

    private void OnDraftDiscountRuleChanged(ChangeEventArgs e)
    {
        draftCashDiscountId = e.Value?.ToString() ?? string.Empty;
        var rule = SelectedDraftDiscountRule;
        draftDiscountMemo = rule?.Description ?? string.Empty;

        if (rule is null)
        {
            return;
        }

        if (rule.IsOpenDiscount)
        {
            draftDiscount = 0m;
            return;
        }

        if (rule.TryCalculate(
                (editingCatalogItem?.Price ?? 0m) * Math.Max(1, draftQuantity),
                0m,
                out var calculated,
                out _))
        {
            draftDiscount = calculated;
        }
    }

    private decimal ResolveDraftDiscount(out string? error)
    {
        error = null;
        if (editingCatalogItem is null)
        {
            return 0m;
        }

        var gross = editingCatalogItem.Price * Math.Max(1, draftQuantity);
        var rule = SelectedDraftDiscountRule;
        if (rule is null)
        {
            return Math.Clamp(draftDiscount, 0m, gross);
        }

        return rule.TryCalculate(gross, draftDiscount, out var discount, out error)
            ? discount
            : 0m;
    }

    private void ConfirmItem()
    {
        if (editingCatalogItem is null) return;

        if (editingCatalogItem.InventoryTypeId == 7 && string.IsNullOrWhiteSpace(currentOrder.AccountId))
        {
            Feedback.Warning(
                "Select a customer before adding member credit.",
                "Customer required");
            return;
        }

        var quantity = Math.Max(1, draftQuantity);
        var discount = ResolveDraftDiscount(out var discountError);
        if (!string.IsNullOrWhiteSpace(discountError))
        {
            Feedback.Warning(discountError, "Discount not applied");
            return;
        }
        discount = Math.Clamp(discount, 0, editingCatalogItem.Price * quantity);

        if (editingCartItem is null)
        {
            var existing = currentOrder.Items.FirstOrDefault(i =>
                string.Equals(i.InventoryId, editingCatalogItem.Id, StringComparison.OrdinalIgnoreCase) &&
                i.Discount == 0 &&
                discount == 0 &&
                string.IsNullOrWhiteSpace(i.CashDiscountId) &&
                string.IsNullOrWhiteSpace(draftCashDiscountId));

            if (existing is not null)
            {
                var previousLineTotal = existing.TotalPrice;
                existing.Quantity += quantity;
                RecalculateItemTaxAndTotal(existing);
                ReconcileAssignedCreditAfterLineChange(
                    existing,
                    previousLineTotal,
                    "quantity");
            }
            else
            {
                var newItem = new TransactionItem
                {
                    InventoryId = editingCatalogItem.Id,
                    Name = editingCatalogItem.Name,
                    Sku = editingCatalogItem.Sku,
                    Description = editingCatalogItem.Name,
                    Category = editingCatalogItem.Type,
                    InventoryTypeId = editingCatalogItem.InventoryTypeId,
                    ImageUrl = editingCatalogItem.ImageUrl,
                    Quantity = quantity,
                    UnitPrice = editingCatalogItem.Price,
                    Discount = discount,
                    CashDiscountId = draftCashDiscountId,
                    DiscountMemo = draftDiscountMemo,
                    UnitOfMeasureId = "UNIT",
                    TaxCodeId = editingCatalogItem.TaxCodeId,
                    TaxPercentage = editingCatalogItem.TaxPercentage,
                    IsTaxInclusive = editingCatalogItem.IsTaxInclusive
                };
                RecalculateItemTaxAndTotal(newItem);
                currentOrder.Items.Add(newItem);
            }
        }
        else
        {
            var previousLineTotal = editingCartItem.TotalPrice;
            var previousQuantity = editingCartItem.Quantity;
            var previousDiscount = editingCartItem.Discount;
            var previousUnitPrice = editingCartItem.UnitPrice;

            editingCartItem.Quantity = quantity;
            editingCartItem.Discount = discount;
            editingCartItem.CashDiscountId = draftCashDiscountId;
            editingCartItem.DiscountMemo = draftDiscountMemo;
            RecalculateItemTaxAndTotal(editingCartItem);

            var changeSource = previousUnitPrice != editingCartItem.UnitPrice
                ? "price"
                : previousQuantity != editingCartItem.Quantity
                    ? "quantity"
                    : previousDiscount != editingCartItem.Discount
                        ? "discount"
                        : "item";

            ReconcileAssignedCreditAfterLineChange(
                editingCartItem,
                previousLineTotal,
                changeSource);
        }

        PendingOrderService.SaveOrUpdate(currentOrder);
        CloseItemEditor();
    }

    private void ChangeCartItemQuantity(TransactionItem item, int delta)
    {
        var newQty = item.Quantity + delta;
        if (newQty <= 0)
        {
            RemoveItem(item);
            return;
        }
        var previousLineTotal = item.TotalPrice;
        item.Quantity = newQty;
        var gross = item.Quantity * item.UnitPrice;
        if (!string.IsNullOrWhiteSpace(item.CashDiscountId))
        {
            var rule = discountRules.FirstOrDefault(candidate =>
                candidate.Id.Equals(item.CashDiscountId, StringComparison.OrdinalIgnoreCase));
            if (rule is { IsOpenDiscount: false } &&
                rule.TryCalculate(gross, item.Discount, out var recalculated, out _))
            {
                item.Discount = recalculated;
            }
        }

        item.Discount = Math.Clamp(item.Discount, 0m, gross);
        RecalculateItemTaxAndTotal(item);
        ReconcileAssignedCreditAfterLineChange(
            item,
            previousLineTotal,
            "quantity");
        PendingOrderService.SaveOrUpdate(currentOrder);
    }

    private void RemoveItem(TransactionItem item)
    {
        var releasedAllocations = EffectiveLineCreditAllocations(item);
        var releasedAmount = releasedAllocations.Sum(allocation => allocation.Amount);

        currentOrder.Items.Remove(item);

        if (releasedAmount > 0m)
        {
            currentOrder.Payments.Clear();

            Console.WriteLine(
                $"[Member Credit Step 34] DELETE | Item={item.InventoryId} | " +
                $"ReleasedAccounts={releasedAllocations.Select(allocation => allocation.MemberCreditAccountId).Distinct(StringComparer.OrdinalIgnoreCase).Count()} | " +
                $"Released={releasedAmount:N2}");

            Feedback.Info(
                $"Removed {item.Name}; RM {releasedAmount:N2} of its local Member Credit allocation was released.",
                "Member Credit released",
                2400);
        }

        PendingOrderService.SaveOrUpdate(currentOrder);
    }

    private async Task ClearCartAsync()
    {
        if (!currentOrder.Items.Any()) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Clear all items from this cart?")) return;

        var releasedCredit = currentOrder.Items
            .Where(item => item.ActivityTypeId == 6)
            .SelectMany(EffectiveLineCreditAllocations)
            .Sum(allocation => allocation.Amount);

        currentOrder.Items.Clear();
        currentOrder.Payments.Clear();
        PendingOrderService.SaveOrUpdate(currentOrder);

        if (releasedCredit > 0m)
        {
            Console.WriteLine(
                $"[Member Credit Step 34] CLEAR CART | Released={releasedCredit:N2}");
        }

        Feedback.Info("All items were removed from the cart.", "Cart cleared", 2400);
    }

    private void SelectType(string type) => selectedType = type;
