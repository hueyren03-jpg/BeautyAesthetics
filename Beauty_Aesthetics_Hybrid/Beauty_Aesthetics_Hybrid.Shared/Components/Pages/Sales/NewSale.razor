    private async Task OpenItemEditor(CatalogItem item)
    {
        if (currentOrder.IsRedemptionMode && IsRedemptionRestrictedPurchaseType(item.InventoryTypeId))
        {
            Feedback.Warning(
                "This purchase item is not available in Redemption Mode. Use Product or Service items for Member Credit redemption.",
                "Redemption mode");
            return;
        }

        if ((item.InventoryTypeId is 5 or 7) && string.IsNullOrWhiteSpace(currentOrder.AccountId))
        {
            Feedback.Warning(
                "Select a customer before adding a package or Member Credit.",
                "Customer required");
            return;
        }

        if (item.InventoryTypeId is 1 or 3)
        {
            item = await LoadPointConfigurationAsync(item);
            var catalogIndex = catalog.FindIndex(candidate =>
                string.Equals(candidate.Id, item.Id, StringComparison.OrdinalIgnoreCase));
            if (catalogIndex >= 0)
            {
                catalog[catalogIndex] = item;
            }

            Console.WriteLine(
                $"[Point Step 3] CATALOG ELIGIBILITY | Inventory={item.Id} | Type={item.InventoryTypeId} | " +
                $"Allow={item.AllowPointRedemption} | PointToRedeem={item.PointToRedeem:0.##} | " +
                $"Eligible={item.AllowPointRedemption && item.PointToRedeem > 0m}");
        }

        if (item.InventoryTypeId == 7)
        {
            var fullResult = await MemberCreditService.LoadMemberCreditAsync(item.Id);
            if (fullResult.Success && fullResult.Value is not null)
            {
                var credit = fullResult.Value;
                var taxRate = await GstTaxRateService.GetRateForTaxCodeAsync(credit.TaxCode);
                item = item with
                {
                    Name = credit.Name,
                    Sku = credit.Code,
                    Price = credit.Price,
                    TaxCodeId = credit.TaxCode,
                    IsTaxInclusive = credit.IsTaxInclusive,
                    TaxPercentage = taxRate
                };
            }
            else
            {
                Console.WriteLine(
                    $"[Member Credit] Full record load failed for {item.Id}; continuing with branch proxy data. {fullResult.ErrorMessage}");
            }
        }

        editingCatalogItem = item;
        editingCartItem = null;
        draftQuantity = 1;
        draftDiscount = 0;
        draftCashDiscountId = string.Empty;
        draftDiscountMemo = string.Empty;
        draftTaxCodeId = item.TaxCodeId ?? string.Empty;
        draftTaxPercentage = item.TaxPercentage;
        draftIsTaxInclusive = item.IsTaxInclusive;
    }

    private void EditCartItem(TransactionItem item)
    {
        if (item.IsPackageRedemption)
        {
            Feedback.Info("Use the quantity buttons to change package sessions.", "Package redemption");
            return;
        }
        if (item.Points > 0m)
        {
            Feedback.Info(
                "Remove point redemption from this line before editing its price, discount or tax details.",
                "Remove points first",
                2600);
            return;
        }

        editingCartItem = item;
        editingCatalogItem = catalog.FirstOrDefault(x => x.Id == item.InventoryId) ??
            new CatalogItem(
                item.InventoryId,
                item.Name,
                item.Sku,
                item.Category,
                item.UnitPrice,
                ItemImage(item.Category, item.ImageUrl),
                item.InventoryTypeId,
                item.TaxCodeId,
                item.IsTaxInclusive,
                item.TaxPercentage,
                item.PointToRedeem,
                item.AllowPointRedemption);
        draftQuantity = item.Quantity;
        draftDiscount = item.Discount;
        draftCashDiscountId = item.CashDiscountId;
        draftDiscountMemo = item.DiscountMemo;
        draftTaxCodeId = item.TaxCodeId;
        draftTaxPercentage = item.TaxPercentage;
        draftIsTaxInclusive = item.IsTaxInclusive;
    }

    private void CloseItemEditor()
    {
        editingCatalogItem = null;
        editingCartItem = null;
        draftCashDiscountId = string.Empty;
        draftDiscountMemo = string.Empty;
        draftTaxCodeId = string.Empty;
        draftTaxPercentage = 0m;
        draftIsTaxInclusive = false;
