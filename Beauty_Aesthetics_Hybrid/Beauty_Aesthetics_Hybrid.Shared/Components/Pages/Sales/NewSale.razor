    private async Task<IReadOnlyList<CatalogItem>> LoadMemberCreditCatalogAsync(
        IReadOnlyList<MembershipViewModel.MemberCredit> summaries,
        string branchId)
    {
        var candidates = summaries
            .Where(item => !string.IsNullOrWhiteSpace(item.MasterAccountId))
            .ToList();

        var tasks = candidates.Select(async credit =>
        {
            var taxRate = await GstTaxRateService.GetRateForTaxCodeAsync(credit.TaxCode);
            return new CatalogItem(
                credit.MasterAccountId!,
                credit.Name,
                credit.Code,
                "Member Credit",
                credit.Price,
                string.Empty,
                InventoryTypeId: 7,
                TaxCodeId: credit.TaxCode,
                IsTaxInclusive: credit.IsTaxInclusive,
                TaxPercentage: taxRate);
        });

        return (await Task.WhenAll(tasks))
            .OrderBy(item => item.Name)
            .ToList();
    }

    private static void RecalculateItemTaxAndTotal(TransactionItem item)
    {
        OrderLineTaxCalculator.ComputeLineAmounts(
            item.UnitPrice,
            Math.Max(1, item.Quantity),
            item.Discount,
            item.TaxPercentage,
            item.IsTaxInclusive,
            out var beforeTax,
            out var taxAmount);

        item.TaxAmount = taxAmount;
        item.TotalPrice = Math.Max(
            0m,
            Math.Round(beforeTax + taxAmount, 2, MidpointRounding.AwayFromZero));
    }

    private string FormatOutstandingBalance() =>
