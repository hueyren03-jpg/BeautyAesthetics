    private async Task ConfirmOutstandingSelection(
        IReadOnlyDictionary<string, decimal> selections)
    {
        var selectedTotal = Math.Round(
            selections.Values.Sum(),
            2,
            MidpointRounding.AwayFromZero);

        if (selectedTotal <= 0m)
        {
            Feedback.Warning(
                "Select at least one outstanding document and settlement amount.",
                "Outstanding required");
            return;
        }

        if (HasPointRedemption)
        {
            var pointValid = await RevalidatePointRedemptionsAsync(showFeedback: true);
            if (!pointValid)
            {
                return;
            }

            if (currentOrder.Total <= 0.009m)
            {
                currentOrder.Payments.Clear();
                PendingOrderService.SaveOrUpdate(currentOrder);
                stage = SaleStage.Payment;
                return;
            }
        }

        var branch = BranchSession.CurrentBranch;
        var branchId = string.IsNullOrWhiteSpace(currentOrder.BranchId)
            ? branch?.Id ?? "HQ"
            : currentOrder.BranchId;
        var groupId = string.IsNullOrWhiteSpace(branch?.GroupId)
            ? branchId
            : branch.GroupId;

        var paymentResult = await CashSalesService.LoadPaymentTypesAsync(
            branchId,
            groupId,
            currentOrder.AccountId);

        if (!paymentResult.Success || paymentResult.Value is null)
        {
            Feedback.Error(
                paymentResult.ErrorMessage ?? "Unable to load payment methods.",
                "Payment methods not loaded");
            return;
        }

        outstandingSettlementSelections = new Dictionary<string, decimal>(
            selections,
            StringComparer.OrdinalIgnoreCase);
        outstandingSettlementExpectedBalances = new Dictionary<string, decimal>(
            StringComparer.OrdinalIgnoreCase);

        foreach (var document in outstandingDocuments)
        {
            var key = OutstandingDocumentSelectionKey(document);
            if (selections.ContainsKey(key))
            {
                outstandingSettlementExpectedBalances[key] = Math.Round(
                    Math.Max(0m, document.RemainingAmount),
                    2,
                    MidpointRounding.AwayFromZero);
            }
        }

        Console.WriteLine(
            $"[Outstanding Step 9] SNAPSHOT | Customer={currentOrder.AccountId} | " +
            $"Documents={outstandingSettlementExpectedBalances.Count} | " +
            $"Balances={string.Join(", ", outstandingSettlementExpectedBalances.Select(pair => $"{pair.Key}:{pair.Value:N2}"))}");

        outstandingSettlementPayments.Clear();
        calculatorMethod = null;
        calculatorDigits = string.Empty;
        isOutstandingPaymentMode = true;

        paymentTypes = paymentResult.Value.ToList();

        if (!VisiblePaymentTypes.Any())
        {
            isOutstandingPaymentMode = false;
            Feedback.Error(
                "No regular payment methods are available for Outstanding settlement.",
                "Payment method unavailable");
            return;
        }

        showOutstandingSettlement = false;
        stage = SaleStage.Payment;

        Console.WriteLine(
            $"[Outstanding Step 4] PAYMENT MODE | Customer={currentOrder.AccountId} | " +
            $"Documents={outstandingSettlementSelections.Count} | Amount={selectedTotal:N2} | " +
            $"RegularMethods={VisiblePaymentTypes.Count()} | MemberCreditExcluded=True");

        Feedback.Info(
            $"RM {selectedTotal:N2} selected. Choose one or more payment methods.",
            "Outstanding payment",
            2800);
    }

