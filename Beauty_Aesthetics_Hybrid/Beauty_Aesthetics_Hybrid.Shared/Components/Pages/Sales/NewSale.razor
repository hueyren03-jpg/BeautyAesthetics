    private void ResetSelectedCustomerBalances()
    {
        selectedCustomerOutstandingBalance = null;
        selectedCustomerPointBalance = null;
        selectedCustomerPackageBalance = null;
        selectedCustomerCreditBalance = null;
        redeemableCredits.Clear();
        redeemableCreditsError = null;
        isRedeemableCreditsLoading = false;
        showRedeemableCredits = false;
        creditRedemptionHistory.Clear();
        selectedHistoryCreditId = string.Empty;
        creditHistoryError = null;
        isCreditHistoryLoading = false;
        selectedCustomerBalanceError = null;
        isSelectedCustomerBalanceLoading = false;
    }

    private async Task LoadSelectedCustomerBalancesAsync(string? customerId)
    {
        var requestVersion = ++selectedCustomerBalanceRequestVersion;
        ResetSelectedCustomerBalances();

        if (string.IsNullOrWhiteSpace(customerId))
        {
            return;
        }

        isSelectedCustomerBalanceLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var memberBalanceTask = CustomerService.GetBalanceSummaryAsync(customerId);
            var otherBalanceTask = CustomerService.GetOtherBalanceSummaryAsync(customerId, DateTime.UtcNow);
            var redeemableCreditTask = CustomerService.GetRedeemableCreditsAsync(customerId, DateTime.Today);

            await Task.WhenAll(memberBalanceTask, otherBalanceTask, redeemableCreditTask);

            if (requestVersion != selectedCustomerBalanceRequestVersion)
            {
                return;
            }

            var memberBalance = await memberBalanceTask;
            var otherBalance = await otherBalanceTask;
            var redeemableCredit = await redeemableCreditTask;

            if (memberBalance.Success && memberBalance.Value is not null)
            {
                selectedCustomerPointBalance = memberBalance.Value.PointBalance;
                selectedCustomerPackageBalance = memberBalance.Value.PackageBalance;
                selectedCustomerCreditBalance = memberBalance.Value.CreditBalance;
            }

            if (otherBalance.Success && otherBalance.Value is not null)
            {
                selectedCustomerOutstandingBalance = otherBalance.Value.Outstanding;
            }

            if (redeemableCredit.Success && redeemableCredit.Value is not null)
            {
                redeemableCredits = redeemableCredit.Value
                    .Where(credit =>
                        credit.IsRedeemable &&
                        !string.IsNullOrWhiteSpace(credit.ARAPOutstandingID) &&
                        credit.NetBalanceAfterUtilised > 0m &&
                        (credit.DueDate.Year <= 1900 || credit.DueDate.Date >= DateTime.Today))
                    .OrderBy(credit => credit.DueDate)
                    .ThenBy(credit => credit.ARAPOutstandingID)
                    .ToList();
                redeemableCreditsError = null;
            }
            else
            {
                redeemableCredits.Clear();
                redeemableCreditsError = redeemableCredit.ErrorMessage ?? "Redeemable Member Credit accounts are unavailable.";
            }

            if (!memberBalance.Success && !otherBalance.Success)
            {
                selectedCustomerBalanceError =
                    memberBalance.ErrorMessage ??
                    otherBalance.ErrorMessage ??
                    "Customer balances are unavailable.";
            }
            else if (!memberBalance.Success)
            {
                selectedCustomerBalanceError =
                    memberBalance.ErrorMessage ??
                    "Point, package and credit balances are unavailable.";
            }
            else if (!otherBalance.Success)
            {
                selectedCustomerBalanceError =
                    otherBalance.ErrorMessage ??
                    "Outstanding balance is unavailable.";
            }
        }
        catch (Exception ex)
        {
            if (requestVersion == selectedCustomerBalanceRequestVersion)
            {
                selectedCustomerBalanceError = $"Unable to load customer balances: {ex.Message}";
            }
        }
        finally
        {
            if (requestVersion == selectedCustomerBalanceRequestVersion)
            {
                isSelectedCustomerBalanceLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ToggleRedemptionModeAsync()
    {
        if (!currentOrder.IsRedemptionMode)
        {
            if (string.IsNullOrWhiteSpace(currentOrder.AccountId))
            {
                Feedback.Warning("Select a customer before switching to Redemption Mode.", "Customer required");
                return;
            }

            var removedCount = currentOrder.Items.RemoveAll(item =>
                IsRedemptionRestrictedPurchaseType(item.InventoryTypeId));
            currentOrder.IsRedemptionMode = true;
            currentOrder.Payments.Clear();
            ClearAllLineCreditSelections();
            await ReloadRedeemableCredits();

            if (removedCount > 0)
            {
                Feedback.Info(
                    $"{removedCount} non-redeemable purchase item(s) were removed. Senang Redemption Mode allows normal Product and Service items, but not Package, Member Credit/Top Up, or Deposit purchases.",
                    "Redemption mode");
            }
        }
        else
        {
            currentOrder.IsRedemptionMode = false;
            currentOrder.Payments.Clear();
            ClearAllLineCreditSelections();
        }

        selectedType = string.Empty;
        PendingOrderService.SaveOrUpdate(currentOrder);
    }

    private async Task OpenLineCreditSelectorAsync(TransactionItem item)
    {
        if (!currentOrder.IsRedemptionMode)
        {
            Feedback.Warning("Switch to Redemption Mode before assigning Member Credit.", "Redemption mode");
            return;
        }

        if (string.IsNullOrWhiteSpace(currentOrder.AccountId))
        {
            Feedback.Warning("Select a customer before redeeming Member Credit.", "Customer required");
            return;
        }

        if (redeemableCredits.Count == 0)
        {
            await ReloadRedeemableCredits();
        }

        creditTargetItem = item;
        draftLineCreditAllocations.Clear();

        if (item.MemberCreditAllocations.Count > 0)
        {
            foreach (var allocation in item.MemberCreditAllocations)
            {
                if (!string.IsNullOrWhiteSpace(allocation.MemberCreditAccountId) && allocation.Amount > 0m)
                {
                    draftLineCreditAllocations[allocation.MemberCreditAccountId] = allocation.Amount;
                }
            }
        }
        else if (!string.IsNullOrWhiteSpace(item.MemberCreditAccountId))
        {
            draftLineCreditAllocations[item.MemberCreditAccountId] = item.TotalPrice;
        }

        showLineCreditSelector = true;
    }

    private void CloseLineCreditSelector()
    {
        showLineCreditSelector = false;
        creditTargetItem = null;
        draftLineCreditAllocations.Clear();
    }

    private decimal AllocatedFromAccountOnItem(TransactionItem item, string accountId)
    {
        if (item.MemberCreditAllocations.Count > 0)
        {
            return item.MemberCreditAllocations
                .Where(allocation =>
                    string.Equals(
                        allocation.MemberCreditAccountId,
                        accountId,
                        StringComparison.OrdinalIgnoreCase))
                .Sum(allocation => allocation.Amount);
        }

        return string.Equals(
                item.MemberCreditAccountId,
                accountId,
                StringComparison.OrdinalIgnoreCase)
            ? item.TotalPrice
            : 0m;
    }

    private decimal CreditAvailableForLine(RedeemableCreditDTO credit, TransactionItem target)
    {
        var accountId = credit.ARAPOutstandingID ?? string.Empty;
        var allocatedElsewhere = currentOrder.Items
            .Where(item => !ReferenceEquals(item, target) && item.ActivityTypeId == 6)
            .Sum(item => AllocatedFromAccountOnItem(item, accountId));

        return Math.Max(0m, credit.NetBalanceAfterUtilised - allocatedElsewhere);
    }

    private decimal DraftCreditAllocationAmount(RedeemableCreditDTO credit)
    {
        var accountId = credit.ARAPOutstandingID ?? string.Empty;
        return draftLineCreditAllocations.TryGetValue(accountId, out var amount)
            ? amount
            : 0m;
    }

    private void ToggleLineCreditAllocation(RedeemableCreditDTO credit, bool selected)
    {
        if (creditTargetItem is null || string.IsNullOrWhiteSpace(credit.ARAPOutstandingID))
        {
            return;
        }

        var accountId = credit.ARAPOutstandingID;
        if (!selected)
        {
            draftLineCreditAllocations.Remove(accountId);
            return;
        }

        var available = CreditAvailableForLine(credit, creditTargetItem);
        var remaining = Math.Max(0m, creditTargetItem.TotalPrice - DraftLineCreditAllocated);
        var amount = Math.Min(available, remaining);

        if (amount > 0m)
        {
            draftLineCreditAllocations[accountId] = Math.Round(amount, 2, MidpointRounding.AwayFromZero);
        }
    }

    private void AutoAllocateLineCredit()
    {
        if (creditTargetItem is null)
        {
            return;
        }

        draftLineCreditAllocations.Clear();

        var remaining = Math.Max(0m, creditTargetItem.TotalPrice);
        var seenAccountIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var credit in redeemableCredits
                     .Where(credit =>
                         credit.IsRedeemable &&
                         !string.IsNullOrWhiteSpace(credit.ARAPOutstandingID) &&
                         credit.NetBalanceAfterUtilised > 0m &&
                         (credit.DueDate.Year <= 1900 || credit.DueDate.Date >= DateTime.Today))
                     .OrderBy(credit => credit.DueDate)
                     .ThenBy(credit => credit.ARAPOutstandingID, StringComparer.OrdinalIgnoreCase))
        {
            if (remaining <= 0m)
            {
                break;
            }

            var accountId = credit.ARAPOutstandingID!.Trim();
            if (!seenAccountIds.Add(accountId))
            {
                continue;
            }

            var available = CreditAvailableForLine(credit, creditTargetItem);
            if (available <= 0m)
            {
                continue;
            }

            var amountToUse = Math.Min(available, remaining);
            amountToUse = Math.Round(amountToUse, 2, MidpointRounding.AwayFromZero);
            if (amountToUse <= 0m)
            {
                continue;
            }

            draftLineCreditAllocations[accountId] = amountToUse;
            remaining = Math.Max(0m, remaining - amountToUse);
        }

        if (draftLineCreditAllocations.Count == 0)
        {
            Feedback.Warning(
                "No usable Member Credit is available for this redemption line.",
                "Auto allocation unavailable");
            return;
        }

        if (remaining > 0.009m)
        {
            Feedback.Warning(
                $"Available Member Credit is short by RM {remaining:N2}. The usable credit has been allocated; adjust it manually or reduce the redemption amount.",
                "Insufficient Member Credit");
            return;
        }

        Feedback.Success(
            $"FIFO allocation prepared across {draftLineCreditAllocations.Count} credit account{(draftLineCreditAllocations.Count == 1 ? string.Empty : "s")}. Review the amounts, then apply Member Credit.",
            "Credit auto allocated",
            2400);
    }

    private void UpdateLineCreditAllocationAmount(RedeemableCreditDTO credit, string? rawValue)
    {
        if (creditTargetItem is null || string.IsNullOrWhiteSpace(credit.ARAPOutstandingID))
        {
            return;
        }

        var accountId = credit.ARAPOutstandingID;
        if (!draftLineCreditAllocations.ContainsKey(accountId))
        {
            return;
        }

        if (!decimal.TryParse(
                rawValue,
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture,
                out var amount))
        {
            amount = 0m;
        }

        var available = CreditAvailableForLine(credit, creditTargetItem);
        var otherAllocated = draftLineCreditAllocations
            .Where(pair => !string.Equals(pair.Key, accountId, StringComparison.OrdinalIgnoreCase))
            .Sum(pair => pair.Value);
        var lineRemainingForAccount = Math.Max(0m, creditTargetItem.TotalPrice - otherAllocated);
        var maximum = Math.Min(available, lineRemainingForAccount);

        draftLineCreditAllocations[accountId] = Math.Round(
            Math.Clamp(amount, 0m, maximum),
            2,
            MidpointRounding.AwayFromZero);
    }

    private void ApplyLineCreditSelection()
    {
        if (creditTargetItem is null)
        {
            return;
        }

        if (draftLineCreditAllocations.Count == 0)
        {
            ClearCreditFromLine(creditTargetItem);
            PendingOrderService.SaveOrUpdate(currentOrder);
            CloseLineCreditSelector();
            return;
        }

        var allocations = new List<MemberCreditAllocation>();
        foreach (var pair in draftLineCreditAllocations)
        {
            var credit = redeemableCredits.FirstOrDefault(item =>
                string.Equals(item.ARAPOutstandingID, pair.Key, StringComparison.OrdinalIgnoreCase));

            if (credit is null ||
                !credit.IsRedeemable ||
                credit.NetBalanceAfterUtilised <= 0m ||
                (credit.DueDate.Year > 1900 && credit.DueDate.Date < DateTime.Today))
            {
                Feedback.Warning($"Member Credit {pair.Key} is expired or no longer redeemable.", "Credit unavailable");
                return;
            }

            if (pair.Value <= 0m)
            {
                Feedback.Warning($"Enter an amount greater than RM 0.00 for {pair.Key}.", "Invalid allocation");
                return;
            }

            var available = CreditAvailableForLine(credit, creditTargetItem);
            if (pair.Value > available)
            {
                Feedback.Warning(
                    $"Credit {pair.Key} has only RM {available:N2} available.",
                    "Allocation exceeds balance");
                return;
            }

            allocations.Add(new MemberCreditAllocation
            {
                MemberCreditAccountId = pair.Key,
                MemberTypeId = credit.MemberTypeID ?? string.Empty,
                Amount = Math.Round(pair.Value, 2, MidpointRounding.AwayFromZero)
            });
        }

        var allocatedTotal = allocations.Sum(allocation => allocation.Amount);
        if (allocatedTotal > creditTargetItem.TotalPrice)
        {
            Feedback.Warning(
                $"Allocated Member Credit RM {allocatedTotal:N2} exceeds the line amount RM {creditTargetItem.TotalPrice:N2}.",
                "Too much credit allocated");
            return;
        }

        if (Math.Abs(allocatedTotal - creditTargetItem.TotalPrice) > 0.009m)
        {
            Feedback.Warning(
                $"Allocate the full RM {creditTargetItem.TotalPrice:N2} line amount before applying Member Credit.",
                "Credit allocation incomplete");
            return;
        }

        creditTargetItem.MemberCreditAllocations = allocations;
        creditTargetItem.ActivityTypeId = 6;
        creditTargetItem.MemberTypeId = allocations.First().MemberTypeId;

        if (allocations.Count == 1)
        {
            creditTargetItem.MemberCreditAccountId = allocations[0].MemberCreditAccountId;
            creditTargetItem.MembershipCredit = string.Empty;
        }
        else
        {
            creditTargetItem.MemberCreditAccountId = string.Empty;
            creditTargetItem.MembershipCredit = SerializeLineCreditAllocations(allocations);
        }

        currentOrder.Payments.Clear();
        PendingOrderService.SaveOrUpdate(currentOrder);

        Feedback.Success(
            allocations.Count == 1
                ? $"{creditTargetItem.Name} assigned to {allocations[0].MemberCreditAccountId}."
                : $"{creditTargetItem.Name} assigned across {allocations.Count} Member Credit accounts.",
            "Member Credit updated",
            2200);

        CloseLineCreditSelector();
    }

    private void ClearLineCreditSelection()
    {
        if (creditTargetItem is not null)
        {
            ClearCreditFromLine(creditTargetItem);
            currentOrder.Payments.Clear();
