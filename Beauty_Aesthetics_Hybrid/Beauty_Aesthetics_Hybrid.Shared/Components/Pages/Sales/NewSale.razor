    private void OnDraftTaxCodeChanged(ChangeEventArgs e)
    {
        draftTaxCodeId = e.Value?.ToString()?.Trim() ?? string.Empty;

        var selected = activeTaxCodes.FirstOrDefault(code =>
            string.Equals(code.TaxCodeID, draftTaxCodeId, StringComparison.OrdinalIgnoreCase));

        draftTaxPercentage = selected?.TaxRate ?? 0m;

        if (string.IsNullOrWhiteSpace(draftTaxCodeId))
        {
            draftIsTaxInclusive = false;
        }
    }

    private void OnDraftDiscountRuleChanged(ChangeEventArgs e)
    {
        draftCashDiscountId = e.Value?.ToString() ?? string.Empty;
        var rule = SelectedDraftDiscountRule;
        draftDiscountMemo = rule?.Description ?? string.Empty;

        if (rule is null)
        {
            return;
        }

        if (rule.IsOpenDiscount)
        {
            draftDiscount = 0m;
            return;
        }

        if (rule.TryCalculate(
                (editingCatalogItem?.Price ?? 0m) * Math.Max(1, draftQuantity),
                0m,
                out var calculated,
                out _))
        {
            draftDiscount = calculated;
        }
    }

    private decimal ResolveDraftDiscount(out string? error)
    {
        error = null;
        if (editingCatalogItem is null)
        {
            return 0m;
        }

        var gross = editingCatalogItem.Price * Math.Max(1, draftQuantity);
        var rule = SelectedDraftDiscountRule;
        if (rule is null)
        {
            return Math.Clamp(draftDiscount, 0m, gross);
        }

        return rule.TryCalculate(gross, draftDiscount, out var discount, out error)
            ? discount
            : 0m;
    }

    private void ConfirmItem()
    {
        if (editingCatalogItem is null) return;

        if ((editingCatalogItem.InventoryTypeId is 5 or 7) && string.IsNullOrWhiteSpace(currentOrder.AccountId))
        {
            Feedback.Warning(
                "Select a customer before adding a package or Member Credit.",
                "Customer required");
            return;
        }

        var quantity = Math.Max(1, draftQuantity);
        var discount = ResolveDraftDiscount(out var discountError);
        if (!string.IsNullOrWhiteSpace(discountError))
        {
            Feedback.Warning(discountError, "Discount not applied");
            return;
        }
        discount = Math.Clamp(discount, 0, editingCatalogItem.Price * quantity);

        if (editingCartItem is null)
        {
            var existing = currentOrder.Items.FirstOrDefault(i =>
                string.Equals(i.InventoryId, editingCatalogItem.Id, StringComparison.OrdinalIgnoreCase) &&
                !i.IsPackageRedemption &&
                i.Points <= 0m &&
                i.Discount == 0 &&
                discount == 0 &&
                string.IsNullOrWhiteSpace(i.CashDiscountId) &&
                string.IsNullOrWhiteSpace(draftCashDiscountId) &&
                string.Equals(i.TaxCodeId, draftTaxCodeId, StringComparison.OrdinalIgnoreCase) &&
                i.IsTaxInclusive == draftIsTaxInclusive);

            if (existing is not null)
            {
                var previousLineTotal = existing.TotalPrice;
                existing.PointToRedeem = editingCatalogItem.PointToRedeem;
                existing.AllowPointRedemption = editingCatalogItem.AllowPointRedemption;
                if (existing.OriginalUnitPrice <= 0m)
                {
                    existing.OriginalUnitPrice = existing.UnitPrice;
                }
                existing.Quantity += quantity;
                RecalculateItemTaxAndTotal(existing);
                ReconcileAssignedCreditAfterLineChange(
                    existing,
                    previousLineTotal,
                    "quantity");
            }
            else
            {
                var newItem = new TransactionItem
                {
                    InventoryId = editingCatalogItem.Id,
                    Name = editingCatalogItem.Name,
                    Sku = editingCatalogItem.Sku,
                    Description = editingCatalogItem.Name,
                    Category = editingCatalogItem.Type,
                    InventoryTypeId = editingCatalogItem.InventoryTypeId,
                    ImageUrl = editingCatalogItem.ImageUrl,
                    Quantity = quantity,
                    UnitPrice = editingCatalogItem.Price,
                    Discount = discount,
                    CashDiscountId = draftCashDiscountId,
                    DiscountMemo = draftDiscountMemo,
                    UnitOfMeasureId = "UNIT",
                    TaxCodeId = draftTaxCodeId,
                    TaxPercentage = draftTaxPercentage,
                    IsTaxInclusive = draftIsTaxInclusive,
                    PointToRedeem = editingCatalogItem.PointToRedeem,
                    AllowPointRedemption = editingCatalogItem.AllowPointRedemption,
                    OriginalUnitPrice = editingCatalogItem.Price
                };
                RecalculateItemTaxAndTotal(newItem);
                currentOrder.Items.Add(newItem);
            }
        }
        else
        {
            var previousLineTotal = editingCartItem.TotalPrice;
            var previousQuantity = editingCartItem.Quantity;
            var previousDiscount = editingCartItem.Discount;
            var previousUnitPrice = editingCartItem.UnitPrice;

            editingCartItem.Quantity = quantity;
            editingCartItem.UnitPrice = editingCatalogItem.Price;
            editingCartItem.Discount = discount;
            editingCartItem.CashDiscountId = draftCashDiscountId;
            editingCartItem.DiscountMemo = draftDiscountMemo;
            editingCartItem.TaxCodeId = draftTaxCodeId;
            editingCartItem.TaxPercentage = draftTaxPercentage;
            editingCartItem.IsTaxInclusive = draftIsTaxInclusive;
            RecalculateItemTaxAndTotal(editingCartItem);

            var changeSource = previousUnitPrice != editingCartItem.UnitPrice
                ? "price"
                : previousQuantity != editingCartItem.Quantity
                    ? "quantity"
                    : previousDiscount != editingCartItem.Discount
                        ? "discount"
                        : "item";

            ReconcileAssignedCreditAfterLineChange(
                editingCartItem,
                previousLineTotal,
                changeSource);
        }

        PendingOrderService.SaveOrUpdate(currentOrder);
        CloseItemEditor();
    }

    private async Task ChangeCartItemQuantity(TransactionItem item, int delta)
    {
        var newQty = item.Quantity + delta;
        if (newQty <= 0)
        {
            RemoveItem(item);
            return;
        }

        if (item.IsPackageRedemption && delta > 0)
        {
            var result = await CustomerService.GetPackagesAsync(currentOrder.AccountId);
            var balance = result.Value?.FirstOrDefault(entry => entry.AutoID == item.SourceDocumentLineId);
            var reserved = PackageReservedQuantity(item.SourceDocumentLineId, item);
            if (!result.Success || balance is null || balance.IsRedeemable == false ||
                (balance.ExpiryDate.Year > 1900 && balance.ExpiryDate.Date < DateTime.Today) ||
                newQty + reserved > balance.NetBalanceAfterUtilised)
            {
                Feedback.Warning(result.ErrorMessage ?? "No more package sessions are available.", "Package balance");
                return;
            }
        }

        if (item.Points > 0m)
        {
            if (string.IsNullOrWhiteSpace(currentOrder.AccountId))
            {
                Feedback.Warning("Select a customer before changing a point-redeemed quantity.", "Customer required");
                return;
            }

            // Point Step 16: quantity changes must use the latest backend balance,
            // not the balance cached when points were first assigned.
            var balanceResult = await CustomerService.GetBalanceSummaryAsync(currentOrder.AccountId);
            if (!balanceResult.Success || balanceResult.Value is null)
            {
                Feedback.Error(
                    balanceResult.ErrorMessage ?? "Unable to recheck the latest point balance.",
                    "Point balance unavailable");
                return;
            }

            selectedCustomerPointBalance = balanceResult.Value.PointBalance;
            var latestBalance = Math.Max(0m, balanceResult.Value.PointBalance);
            var required = Math.Round(
                Math.Max(0m, item.PointToRedeem) * newQty,
                2,
                MidpointRounding.AwayFromZero);
            var allocatedElsewhere = PointsAllocatedOnCurrentBill(item);
            var availableForThisLine = Math.Max(0m, latestBalance - allocatedElsewhere);

            Console.WriteLine(
                $"[Point Step 16] QUANTITY CHECK | Source=Sales | Customer={currentOrder.AccountId} | " +
                $"Inventory={item.InventoryId} | OldQty={item.Quantity} | NewQty={newQty} | " +
                $"LatestBalance={latestBalance:0.##} | AllocatedElsewhere={allocatedElsewhere:0.##} | " +
                $"AvailableForLine={availableForThisLine:0.##} | Required={required:0.##}");

            if (required - availableForThisLine > 0.009m)
            {
                Console.WriteLine(
                    $"[Point Step 16] QUANTITY BLOCKED | Source=Sales | Customer={currentOrder.AccountId} | " +
                    $"Inventory={item.InventoryId} | NewQty={newQty} | Available={availableForThisLine:0.##} | Required={required:0.##}");

                Feedback.Warning(
                    $"Not enough points for quantity {newQty}. Available for this line: {availableForThisLine:0.##} pts.",
                    "Not enough points");
                return;
            }

            item.Quantity = newQty;
            item.Points = required;
            item.Discount = 0m;
            item.CashDiscountId = string.Empty;
            item.DiscountMemo = string.Empty;
            RecalculateItemTaxAndTotal(item);
            currentOrder.Payments.Clear();
            PendingOrderService.SaveOrUpdate(currentOrder);

            Console.WriteLine(
                $"[Point Step 16] QUANTITY PASS | Source=Sales | Customer={currentOrder.AccountId} | " +
                $"Inventory={item.InventoryId} | Qty={item.Quantity} | LinePoints={item.Points:0.##} | " +
                $"TotalAllocated={PointsAllocatedOnCurrentBill():0.##}");
            return;
        }

        var previousLineTotal = item.TotalPrice;
        item.Quantity = newQty;
        var gross = item.Quantity * item.UnitPrice;
        if (!string.IsNullOrWhiteSpace(item.CashDiscountId))
        {
            var rule = discountRules.FirstOrDefault(candidate =>
                candidate.Id.Equals(item.CashDiscountId, StringComparison.OrdinalIgnoreCase));
            if (rule is { IsOpenDiscount: false } &&
                rule.TryCalculate(gross, item.Discount, out var recalculated, out _))
            {
                item.Discount = recalculated;
            }
        }

        item.Discount = Math.Clamp(item.Discount, 0m, gross);
        RecalculateItemTaxAndTotal(item);
        ReconcileAssignedCreditAfterLineChange(
            item,
            previousLineTotal,
            "quantity");
        PendingOrderService.SaveOrUpdate(currentOrder);
    }

    private void RemoveItem(TransactionItem item)
    {
        var releasedAllocations = EffectiveLineCreditAllocations(item);
        var releasedAmount = releasedAllocations.Sum(allocation => allocation.Amount);
        var releasedPoints = Math.Max(0m, item.Points);

        currentOrder.Items.Remove(item);

        if (releasedAmount > 0m || releasedPoints > 0m)
        {
            currentOrder.Payments.Clear();

            Console.WriteLine(
                $"[Member Credit Step 34] DELETE | Item={item.InventoryId} | " +
                $"ReleasedAccounts={releasedAllocations.Select(allocation => allocation.MemberCreditAccountId).Distinct(StringComparer.OrdinalIgnoreCase).Count()} | " +
                $"Released={releasedAmount:N2}");

            Feedback.Info(
                $"Removed {item.Name}; RM {releasedAmount:N2} of its local Member Credit allocation was released.",
                "Member Credit released",
                2400);
        }

        if (releasedPoints > 0m)
        {
            var remainingAllocated = PointsAllocatedOnCurrentBill();
            Console.WriteLine(
                $"[Point Step 7] RELEASE | Source=Sales | Customer={currentOrder.AccountId} | " +
                $"Item={item.InventoryId} | Released={releasedPoints:0.##} | " +
                $"RemainingAllocated={remainingAllocated:0.##}");

            Feedback.Info(
                $"Removed {item.Name}; {releasedPoints:0.##} point(s) were released.",
                "Points released",
                2200);
        }

        PendingOrderService.SaveOrUpdate(currentOrder);
    }

    private async Task ClearCartAsync()
    {
        if (!currentOrder.Items.Any()) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Clear all items from this cart?")) return;

        var releasedCredit = currentOrder.Items
            .Where(item => item.ActivityTypeId == 6)
            .SelectMany(EffectiveLineCreditAllocations)
            .Sum(allocation => allocation.Amount);
        var releasedPoints = Math.Round(
            currentOrder.Items.Sum(item => Math.Max(0m, item.Points)),
            2,
            MidpointRounding.AwayFromZero);

        currentOrder.Items.Clear();
        currentOrder.Payments.Clear();
        PendingOrderService.SaveOrUpdate(currentOrder);

        if (releasedCredit > 0m)
        {
            Console.WriteLine(
                $"[Member Credit Step 34] CLEAR CART | Released={releasedCredit:N2}");
        }

        if (releasedPoints > 0m)
        {
            Console.WriteLine(
                $"[Point Step 16] CLEAR CART | Customer={currentOrder.AccountId} | Released={releasedPoints:0.##}");
        }

        Feedback.Info("All items were removed from the cart.", "Cart cleared", 2400);
    }

    private void SelectType(string type) => selectedType = type;
    private void UpdateSearch(ChangeEventArgs e) => searchText = e.Value?.ToString() ?? string.Empty;

    private async Task UpdateCustomerSearch(ChangeEventArgs e)
    {
        customerSearchText = e.Value?.ToString() ?? string.Empty;
        var keyword = customerSearchText.Trim();
        var requestVersion = ++customerSearchRequestVersion;

        customerSearchCts?.Cancel();
        customerSearchCts?.Dispose();
        customerSearchCts = null;

        if (string.IsNullOrWhiteSpace(keyword))
        {
            customers = defaultCustomers.ToList();
            isCustomerSearchLoading = false;
            return;
        }

        var cts = new CancellationTokenSource();
        customerSearchCts = cts;

        try
        {
            await Task.Delay(350, cts.Token);
            isCustomerSearchLoading = true;
            await InvokeAsync(StateHasChanged);

            var result = await CustomerService.SearchCustomersAsync(keyword, cts.Token);
            if (cts.IsCancellationRequested || requestVersion != customerSearchRequestVersion)
            {
                return;
            }

            customers = result.Success && result.Value is not null
                ? result.Value.Where(x => !string.IsNullOrWhiteSpace(x.SystemID)).OrderBy(CustomerName).ToList()
                : new List<Customer>();

            if (!result.Success)
            {
                Feedback.Error(result.ErrorMessage ?? "Unable to search customers.", "Customer search failed");
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (requestVersion == customerSearchRequestVersion)
            {
                isCustomerSearchLoading = false;
                customerSearchCts = null;
                await InvokeAsync(StateHasChanged);
            }

            cts.Dispose();
        }
    }

    // ========================================= PAYMENT & COMPLETE =========================================

    private async Task ContinueToPayment()
    {
        if (!currentOrder.Items.Any())
        {
            Feedback.Warning("Please add at least one item before proceeding to payment.", "Cart is empty");
            return;
        }

        if (currentOrder.Items.Any(item => item.InventoryTypeId is 5 or 7) &&
            string.IsNullOrWhiteSpace(currentOrder.AccountId))
        {
            Feedback.Warning(
                "Select a customer before purchasing a package or Member Credit.",
                "Customer required");
            return;
        }

        if (currentOrder.IsRedemptionMode)
        {
            if (string.IsNullOrWhiteSpace(currentOrder.AccountId))
            {
                Feedback.Warning("Select a customer before redeeming Member Credit.", "Customer required");
                return;
            }

            if (heldRedemptionCreditValidationRequired)
            {
                var revalidated = await RefreshAndRevalidateHeldRedemptionCreditsAsync(showFeedback: true);
                if (!revalidated)
                {
                    return;
                }
            }

            if (!currentOrder.Items.Any(item => item.IsPackageRedemption ||
                    (item.ActivityTypeId == 6 &&
                    EffectiveLineCreditAllocations(item).Count > 0)))
            {
                Feedback.Warning("Select package sessions or assign Member Credit.", "Select redemption");
                return;
            }

            var incompleteCreditLine = currentOrder.Items
                .Where(item => item.ActivityTypeId == 6)
                .Select(item => new
                {
                    Item = item,
                    Allocated = Math.Round(
                        EffectiveLineCreditAllocations(item).Sum(allocation => allocation.Amount),
                        2,
                        MidpointRounding.AwayFromZero),
                    Required = Math.Round(
                        Math.Max(0m, item.TotalPrice),
                        2,
                        MidpointRounding.AwayFromZero)
                })
                .FirstOrDefault(value =>
                    Math.Abs(value.Required - value.Allocated) > 0.009m);

            if (incompleteCreditLine is not null)
            {
                var extraNeeded = Math.Max(
                    0m,
                    incompleteCreditLine.Required - incompleteCreditLine.Allocated);

                Console.WriteLine(
                    $"[Member Credit Step 34] BLOCKED | Item={incompleteCreditLine.Item.InventoryId} | " +
                    $"Required={incompleteCreditLine.Required:N2} | Allocated={incompleteCreditLine.Allocated:N2} | " +
                    $"ExtraNeeded={extraNeeded:N2}");

                Feedback.Warning(
                    extraNeeded > 0m
                        ? $"{incompleteCreditLine.Item.Name} now needs another RM {extraNeeded:N2} of Member Credit. " +
                          "Assign extra credit, or remove Member Credit from that line to use another payment source."
                        : $"{incompleteCreditLine.Item.Name} has an invalid Member Credit allocation. Reassign its credit before continuing.",
                    "Member Credit needs updating");
                return;
            }

            if (Remaining <= 0m)
            {
                paymentTypes.Clear();
                stage = SaleStage.Payment;
                return;
            }
        }

        var branch = BranchSession.CurrentBranch;
        var branchId = string.IsNullOrWhiteSpace(currentOrder.BranchId)
            ? branch?.Id ?? "HQ"
            : currentOrder.BranchId;
        var groupId = branch?.GroupId ?? string.Empty;

        var paymentResult = await CashSalesService.LoadPaymentTypesAsync(
            branchId,
            groupId,
            currentOrder.AccountId);

        if (!paymentResult.Success || paymentResult.Value is null)
        {
            Feedback.Error(
                paymentResult.ErrorMessage ?? "Unable to load payment methods.",
                "Payment methods not loaded");
            return;
        }

        paymentTypes = paymentResult.Value.ToList();

        PendingOrderService.SaveOrUpdate(currentOrder);
        stage = SaleStage.Payment;
    }

    private void BackToCart()
    {
        if (isOutstandingPaymentMode)
        {
            outstandingSettlementPayments.Clear();
            calculatorMethod = null;
            calculatorDigits = string.Empty;
            isOutstandingPaymentMode = false;
        }

        stage = SaleStage.Cart;
    }

    private void OpenCalculator(CashSalesPaymentTypeDTO method)
    {
        if (isOutstandingPaymentMode)
        {
            if (method.POSPaymentTypeID == -10)
            {
                Feedback.Warning(
                    "Member Credit cannot be used as an Outstanding settlement payment method.",
                    "Payment method not allowed");
                return;
            }

            var existingOutstandingPayment = PaymentFor(method.POSPaymentTypeID);

            if (existingOutstandingPayment is null)
            {
                // Step 8 keeps Beauty's existing multi-payment workflow:
                // first click allocates the current remaining amount; click the
                // selected method again to edit its amount, then add another method.
                var amount = Math.Round(
                    Math.Max(0m, Remaining),
                    2,
                    MidpointRounding.AwayFromZero);

                if (amount <= 0m)
                {
                    Feedback.Warning(
                        "The Outstanding settlement is already fully allocated. Edit or remove an existing payment before adding another method.",
                        "Outstanding fully allocated");
                    return;
                }

                outstandingSettlementPayments.Add(new TransactionPayment
                {
                    PaymentTypeId = method.POSPaymentTypeID,
                    PaymentMethod = method.POSPaymentTypeName ?? "Payment",
                    Amount = amount,
                    FinancialAccountId = method.FinancialAccountID ?? string.Empty,
                    BankName = method.FinancialAccountName ?? string.Empty
                });

                calculatorMethod = null;
                calculatorDigits = string.Empty;

                Console.WriteLine(
                    $"[Outstanding Step 8] PAYMENT METHOD ADDED | " +
                    $"Type={method.POSPaymentTypeID} | Method={method.POSPaymentTypeName} | " +
                    $"Amount={amount:N2} | Methods={ActivePaymentLines.Count} | " +
                    $"Paid={PaidAmount:N2} | Remaining={Remaining:N2}");

                StateHasChanged();
                return;
            }
        }

        calculatorMethod = method;
        var existing = PaymentFor(method.POSPaymentTypeID);
        calculatorDigits = existing is null
            ? string.Empty
            : ((long)Math.Round(existing.Amount * 100)).ToString();
    }

    private void EditPayment(TransactionPayment payment)
