@page "/sales/new"
@namespace Beauty_Aesthetics_WebPos.Components.Pages
@using Beauty_Aesthetics_WebPos.APIClient
@using Beauty_Aesthetics_WebPos.Components.Models
@using Beauty_Aesthetics_WebPos.Components.Services.Customers
@using Beauty_Aesthetics_WebPos.Components.Services.Branches
@using Beauty_Aesthetics_WebPos.Components.Services.Inventory
@using Beauty_Aesthetics_WebPos.Components.Services.Printing
@using Beauty_Aesthetics_WebPos.Components.Services.Sales
@using Beauty_Aesthetics_WebPos.Components.Services.Tax
@using Beauty_Aesthetics_WebPos.Components.ViewModels
@using Beauty_Aesthetics_WebPos.Models.DTOs
@inject ICashSalesService CashSalesService
@inject ICashDiscountService CashDiscountService
@inject IPendingOrderService PendingOrderService
@inject IBranchSessionService BranchSession
@inject ICustomerService CustomerService
@inject IProductInventoryService ProductInventoryService
@inject ProductImageService ProductImageService
@inject IServiceItemService ServiceItemService
@inject IPackageService PackageService
@inject IMemberCreditService MemberCreditService
@inject IGstTaxRateService GstTaxRateService
@inject BranchAC BranchAC
@inject IPrinterSelectionService PrinterSelectionService
@inject IReceiptPrinterService ReceiptPrinterService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AppFeedbackService Feedback
@implements IDisposable

<PageTitle>New Sale - Pending Orders</PageTitle>

<main class="sale-page">
    @* ========================================= 1. MAIN HEADER ========================================= *@
    <header class="sale-page-header @(stage == SaleStage.Cart ? "cart-stage-header" : null) @(stage is SaleStage.Payment or SaleStage.Complete ? "mobile-step-header" : null)">
        <div>
            @if (stage == SaleStage.PendingOrders)
            {
                <button type="button" class="icon-button" title="Back to sales dashboard" @onclick="GoToSalesDashboard">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <span class="sale-page-icon"><i class="bi bi-clock-history"></i></span>
                <div>
                    <h1>Pending Orders</h1>
                    <p>Resume a held order or select a customer to create a new order.</p>
                </div>
            }
            else if (stage == SaleStage.CustomerSelection)
            {
                <button type="button" class="icon-button" title="Back to pending orders" @onclick="CancelCustomerSelection">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <span class="sale-page-icon"><i class="bi bi-person-plus"></i></span>
                <div>
                    <h1>Select Customer</h1>
                    <p>Choose a customer to create and build the order.</p>
                </div>
            }
            else if (stage == SaleStage.Cart)
            {
                <button type="button" class="icon-button" title="Back to pending orders" @onclick="BackToPendingOrdersFromCart">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <span class="sale-page-icon"><i class="bi bi-bag-plus"></i></span>
                <div class="sale-title-copy">
                    <h1>@(currentOrder.IsRedemptionMode ? "Select Redemption Items" : "Select Items")</h1>
                    <p>@(currentOrder.IsRedemptionMode ? "Member Credit Redemption" : "Sales") · @(string.IsNullOrWhiteSpace(currentOrder.CustomerName) ? "Customer" : currentOrder.CustomerName) (@currentOrder.OrderNumber)</p>
                </div>

            }
            else if (stage == SaleStage.Payment)
            {
                <button type="button" class="icon-button" title="Back to cart" @onclick="BackToCart">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <span class="sale-page-icon"><i class="bi bi-credit-card"></i></span>
                <div>
                    <h1>Payment</h1>
                    <p>Choose a payment method and collect payment.</p>
                </div>
            }
            else
            {
                <span class="sale-page-icon receipt-success"><i class="bi bi-check2-circle"></i></span>
                <div>
                    <h1>@(currentOrder.IsRedemptionMode ? "Redemption Completed" : "Sale Completed")</h1>
                    <p>@(currentOrder.IsRedemptionMode ? "Member Credit redemption saved successfully." : "Transaction saved successfully and ready to print.")</p>
                </div>
            }
        </div>

        @if (stage == SaleStage.Cart)
        {
            <div class="sale-mode-slot" aria-label="Sales mode selector">
                <button type="button"
                        class="senang-mode-toggle"
                        @onclick="ToggleRedemptionModeAsync"
                        disabled="@string.IsNullOrWhiteSpace(currentOrder.AccountId)"
                        title="@(currentOrder.IsRedemptionMode ? "Switch to Sales mode" : "Switch to Redemption mode")"
                        aria-label="@(currentOrder.IsRedemptionMode ? "Switch to Sales mode" : "Switch to Redemption mode")">
                    <span class="senang-toggle-pill @(currentOrder.IsRedemptionMode ? "redemption" : "sales")"
                          aria-hidden="true">
                        <span class="senang-toggle-circle"></span>
                        <span class="senang-toggle-label">@(currentOrder.IsRedemptionMode ? "R" : "S")</span>
                    </span>
                </button>
            </div>
        }

        <div class="sale-progress" aria-label="Sale progress">
            @if (stage == SaleStage.PendingOrders)
            {
                <span class="active"><i class="bi bi-clock-history"></i> Pending Orders</span>
            }
            else if (stage == SaleStage.CustomerSelection)
            {
                <span class="active"><i class="bi bi-person-check"></i> Step 1: Customer</span>
            }
            else if (stage == SaleStage.Cart)
            {
                <span class="active"><i class="bi bi-cart3"></i> Step 2: Items</span>
            }
            else if (stage == SaleStage.Payment)
            {
                <span class="active"><i class="bi bi-credit-card"></i> Step 3: Payment</span>
            }
            else
            {
                <span class="done"><i class="bi bi-check-lg"></i> Step 4: Completed</span>
            }
        </div>
    </header>

    @* ========================================= 2. LOADING STATE ========================================= *@
    @if (isLoading)
    {
        <section class="sale-loading">
            <span class="spinner-border"></span>
            <strong>Preparing sale workspace...</strong>
        </section>
    }
    @* ========================================= 3. STAGE 1: PENDING ORDERS ========================================= *@
    else if (stage == SaleStage.PendingOrders)
    {
        <section class="pending-orders-container">
            <div class="pending-orders-toolbar">
                <div class="pending-search-wrap">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           value="@pendingSearchText"
                           @oninput="UpdatePendingSearch"
                           placeholder="Search pending orders by customer, phone, or order #..." />
                    @if (!string.IsNullOrWhiteSpace(pendingSearchText))
                    {
                        <button type="button" class="clear-search-btn" @onclick="() => pendingSearchText = string.Empty">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>

                <div class="pending-toolbar-actions">
                    <div class="pending-stats-pill">
                        <i class="bi bi-receipt"></i>
                        <span><strong>@pendingOrders.Count</strong> @(pendingOrders.Count == 1 ? "Order" : "Orders") Pending</span>
                        @if (pendingOrders.Any())
                        {
                            <span class="pill-divider">|</span>
                            <span>Total: <strong>MYR @pendingOrders.Sum(x => x.Total).ToString("N2")</strong></span>
                        }
                    </div>
                    <button type="button" class="primary-action" @onclick="StartNewOrderCustomerSelection">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>+ New Order</span>
                    </button>
                </div>
            </div>

            @if (!FilteredPendingOrders.Any())
            {
                <div class="pending-empty-state">
                    <div class="empty-icon-wrap">
                        <i class="bi bi-inbox"></i>
                    </div>
                    @if (string.IsNullOrWhiteSpace(pendingSearchText))
                    {
                        <h3>No Pending Orders</h3>
                        <p>There are no held orders at this time. Click below to select a customer and create a new order.</p>
                        <button type="button" class="primary-action big-action-btn" @onclick="StartNewOrderCustomerSelection">
                            <i class="bi bi-person-plus-fill"></i>
                            <span>Select Customer & Create Order</span>
                        </button>
                    }
                    else
                    {
                        <h3>No Matching Pending Orders</h3>
                        <p>No held orders matched "<strong>@pendingSearchText</strong>". Try another keyword.</p>
                        <button type="button" class="secondary-action" @onclick="() => pendingSearchText = string.Empty">
                            <span>Clear Search</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="pending-grid">
                    @foreach (var order in FilteredPendingOrders)
                    {
                        <article class="pending-card" @onclick="() => ResumeOrder(order)">
                            <div class="pending-card-top">
                                <div class="order-badge">
                                    <i class="bi bi-bookmark-fill"></i>
                                    <span>@order.OrderNumber</span>
                                </div>
                                <div class="pending-time" title="@order.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")">
                                    <i class="bi bi-clock"></i>
                                    <span>@order.CreatedAt.ToString("hh:mm tt")</span>
                                </div>
                            </div>

                            <div class="pending-customer-row">
                                <div class="customer-avatar-circle">
                                    @GetCustomerInitials(order.CustomerName)
                                </div>
                                <div class="customer-info-block">
                                    <strong class="customer-name-text">@order.CustomerName</strong>
                                    <span class="customer-meta-text">
                                        @(string.IsNullOrWhiteSpace(order.CustomerContact) ? "No contact" : order.CustomerContact)
                                    </span>
                                    <span class="membership-pill">@order.MembershipType</span>
                                </div>
                            </div>

                            <div class="pending-items-summary">
                                <div class="items-count-tag">
                                    <i class="bi bi-box-seam"></i>
                                    <span>@order.ItemCount @(order.ItemCount == 1 ? "Item" : "Items")</span>
                                </div>
                                @if (order.Items.Any())
                                {
                                    <p class="items-preview-text">
                                        @string.Join(", ", order.Items.Take(3).Select(x => x.Name))
                                        @(order.Items.Count > 3 ? $" +{order.Items.Count - 3} more" : "")
                                    </p>
                                }
                                else
                                {
                                    <p class="items-preview-text empty">No items added yet</p>
                                }
                            </div>

                            <div class="pending-card-footer">
                                <div class="pending-amount-wrap">
                                    <span class="amount-label">Order Total</span>
                                    <strong class="amount-value">MYR @order.Total.ToString("N2")</strong>
                                </div>
                                <div class="pending-actions-wrap" @onclick:stopPropagation>
                                    <button type="button"
                                            class="delete-order-btn"
                                            title="Delete held order"
                                            @onclick="() => RequestDeleteOrder(order)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                    <button type="button"
                                            class="resume-order-btn"
                                            @onclick="() => ResumeOrder(order)">
                                        <span>Resume</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
    @* ========================================= 4. STAGE 2: SELECT CUSTOMER ========================================= *@
    else if (stage == SaleStage.CustomerSelection)
    {
        @if (isAddingNewCustomer)
        {
            <section class="customer-selection-page customer-add-embedded-wrapper">
                <Customers IsDedicatedAddPage="true"
                           OnCustomerCreated="HandleCustomerCreatedFromComponent"
                           OnCancel="() => isAddingNewCustomer = false" />
            </section>
        }
        else
        {
            <section class="customer-selection-page">
                <div class="customer-selection-heading">
                    <div>
                        <span>Customer Selection</span>
                        <h2>Who is this order for?</h2>
                        <p>Search customer by name, contact number, email, or membership type.</p>
                    </div>
                </div>

                <div class="customer-selection-controls">
                    <div class="customer-search">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               value="@customerSearchText"
                               @oninput="UpdateCustomerSearch"
                               placeholder="Search customer by name, contact number, email, or membership..."
                               autofocus />
                        @if (!string.IsNullOrWhiteSpace(customerSearchText))
                        {
                            <button type="button" class="clear-search-btn" @onclick="() => { customerSearchText = string.Empty; }" title="Clear search">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        }
                    </div>

                    <div class="customer-controls-actions">
                        <button type="button" class="new-customer-btn" @onclick="() => isAddingNewCustomer = true" title="Create a new customer profile">
                            <i class="bi bi-person-plus-fill"></i>
                            <span>+ New Customer</span>
                        </button>
                        <button type="button" class="walkin-customer-btn" @onclick="SelectWalkInCustomer" title="Fast walk-in order">
                            <i class="bi bi-person-walking"></i>
                            <span>Select Walk-in Customer</span>
                        </button>
                    </div>
                </div>

                @if (isCustomerSearchLoading)
                {
                    <div class="customer-empty">
                        <span class="spinner-border spinner-border-sm"></span>
                        <strong>Searching customers...</strong>
                    </div>
                }
                else if (!FilteredCustomers.Any())
                {
                    <div class="customer-empty">
                        <i class="bi bi-person-x"></i>
                        <strong>No customers found</strong>
                        <span>Try another name, phone number, email, or select Walk-in Customer.</span>
                        <button type="button" class="secondary-action" style="margin-top: 10px;" @onclick="SelectWalkInCustomer">
                            <i class="bi bi-person-walking"></i>
                            <span>Continue as Walk-in Customer</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="customer-selection-list">
                        @foreach (var customer in FilteredCustomers)
                        {
                            <button type="button"
                                    class="customer-option @(customer.SystemID == currentOrder.AccountId ? "selected" : string.Empty)"
                                    @onclick="() => SelectCustomer(customer)">
                                <div class="customer-option-avatar">
                                    <span>@CustomerInitials(customer)</span>
                                </div>
                                <div class="customer-option-meta">
                                    <div class="customer-option-top-row">
                                        <strong class="customer-option-name">@CustomerName(customer)</strong>
                                        <span class="customer-membership-tag @(CustomerMembership(customer).ToLowerInvariant().Replace(" ", "-"))">
                                            @CustomerMembership(customer)
                                        </span>
                                    </div>
                                    <div class="customer-option-details">
                                        @if (!string.IsNullOrWhiteSpace(customer.ContactNumber1))
                                        {
                                            <span class="customer-contact-item">
                                                <i class="bi bi-telephone-fill"></i>
                                                <span>@customer.ContactNumber1</span>
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(customer.Email))
                                        {
                                            <span class="customer-contact-item">
                                                <i class="bi bi-envelope-fill"></i>
                                                <span>@customer.Email</span>
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="customer-option-arrow">
                                    <i class="bi @(customer.SystemID == currentOrder.AccountId ? "bi-check-circle-fill" : "bi-chevron-right")"></i>
                                </div>
                            </button>
                        }
                    </div>
                }
            </section>
        }
    }
    @* ========================================= 5. STAGE 3: CART / SELECT ITEMS ========================================= *@
    else if (stage == SaleStage.Cart)
    {
        <section class="sale-workspace">
            <div class="catalog-column">
                @* Customer Info Bar *@
                <section class="customer-strip">
                    <div class="customer-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="customer-copy">
                        <div class="customer-order-tag">
                            <span>Order: <strong>@currentOrder.OrderNumber</strong></span>
                            <span class="dot-separator">•</span>
                            <span>Outlet: <strong>@currentOrder.BranchName</strong></span>
                        </div>
                        <strong>@currentOrder.CustomerName</strong>
                        <small>@(string.IsNullOrWhiteSpace(currentOrder.CustomerContact) ? "No contact" : currentOrder.CustomerContact) | @currentOrder.MembershipType</small>
                    </div>

                    <div class="customer-balance-summary" aria-label="Selected customer balances">
                        <div class="customer-balance-item">
                            <span class="customer-balance-icon"><i class="bi bi-cash-stack"></i></span>
                            <span class="customer-balance-copy">
                                <small>Outstanding</small>
                                <strong>@FormatOutstandingBalance()</strong>
                            </span>
                        </div>
                        <div class="customer-balance-item">
                            <span class="customer-balance-icon"><i class="bi bi-stars"></i></span>
                            <span class="customer-balance-copy">
                                <small>Point</small>
                                <strong>@FormatPointBalance()</strong>
                            </span>
                        </div>
                        <div class="customer-balance-item">
                            <span class="customer-balance-icon"><i class="bi bi-box2-heart"></i></span>
                            <span class="customer-balance-copy">
                                <small>Package</small>
                                <strong>@FormatPackageBalance()</strong>
                            </span>
                        </div>
                        <button type="button"
                                class="customer-balance-item customer-balance-button"
                                title="View redeemable Member Credit accounts"
                                disabled="@string.IsNullOrWhiteSpace(currentOrder.AccountId)"
                                @onclick="OpenRedeemableCredits">
                            <span class="customer-balance-icon"><i class="bi bi-credit-card-2-front"></i></span>
                            <span class="customer-balance-copy">
                                <small>Credit</small>
                                <strong>@FormatCreditBalance()</strong>
                            </span>
                            <i class="bi bi-chevron-right customer-balance-chevron"></i>
                        </button>
                    </div>

                    <div class="customer-strip-actions">
                        @if (!string.IsNullOrWhiteSpace(selectedCustomerBalanceError))
                        {
                            <span class="customer-balance-warning" title="@selectedCustomerBalanceError">
                                <i class="bi bi-exclamation-circle"></i>
                                <span>Balance unavailable</span>
                            </span>
                        }
                        <button type="button" class="change-customer-btn" @onclick="OpenChangeCustomerSelection" title="Change customer for this order">
                            <i class="bi bi-person-gear"></i>
                            <span>Change Customer</span>
                        </button>
                    </div>
                </section>

                @* Catalog Toolbar & Item Grid *@
                <section class="catalog-panel">
                    <div class="catalog-toolbar">
                        <div class="type-tabs" role="tablist">
                            <button type="button"
                                    class="@(string.IsNullOrEmpty(selectedType) ? "active" : null)"
                                    @onclick="() => SelectType(string.Empty)">
                                All (@AvailableCatalogItems.Count())
                            </button>
                            @foreach (var type in ItemTypes)
                            {
                                var typeCount = AvailableCatalogItems.Count(x => string.Equals(x.Type, type, StringComparison.OrdinalIgnoreCase));
                                <button type="button"
                                        class="@(selectedType == type ? "active" : null)"
                                        @onclick="() => SelectType(type)">
                                    <i class="bi @TypeIcon(type)"></i>
                                    @type (@typeCount)
                                </button>
                            }
                        </div>
                        <div class="catalog-search">
                            <i class="bi bi-search"></i>
                            <input type="text"
                                   value="@searchText"
                                   @oninput="UpdateSearch"
                                   placeholder="Search item name or SKU..." />
                            @if (!string.IsNullOrWhiteSpace(searchText))
                            {
                                <button type="button" class="clear-search-btn" @onclick="() => searchText = string.Empty" title="Clear search">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            }
                        </div>
                    </div>

                    @if (!FilteredItems.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-search"></i>
                            <strong>No matching items</strong>
                            <span>Try another name, SKU, or item category tab.</span>
                        </div>
                    }
                    else
                    {
                        <div class="catalog-grid">
                            @foreach (var item in FilteredItems)
                            {
                                <button type="button" class="catalog-item" @onclick="() => OpenItemEditor(item)">
                                    <img src="@ItemImage(item.Type, item.ImageUrl)" alt="" />
                                    <span class="catalog-item-copy">
                                        <small>@item.Type</small>
                                        <strong>@item.Name</strong>
                                        <span>@item.Sku</span>
                                        <b>MYR @item.Price.ToString("N2")</b>
                                    </span>
                                    <span class="catalog-add" title="Add to cart"><i class="bi bi-plus-lg"></i></span>
                                </button>
                            }
                        </div>
                    }
                </section>
            </div>

            @* Cart Panel *@
            @if (mobileCartOpen)
            {
                <button type="button" class="mobile-cart-backdrop" aria-label="Close cart" @onclick="CloseMobileCart"></button>
            }
            <aside class="cart-panel @(mobileCartOpen ? "mobile-open" : null)" aria-label="Shopping cart">
                <header>
                    <div>
                        <span class="panel-icon"><i class="bi bi-cart3"></i></span>
                        <div>
                            <h2>Cart</h2>
                            <p>@currentOrder.Items.Count item line(s)</p>
                        </div>
                    </div>
                    <div class="cart-header-actions">
                        @if (currentOrder.Items.Any())
                        {
                            <button type="button" class="clear-cart-button" title="Clear cart" @onclick="ClearCartAsync">
                                <i class="bi bi-trash3"></i>
                                <span>Clear</span>
                            </button>
                        }
                        <strong class="cart-count">@currentOrder.ItemCount</strong>
                        <button type="button" class="mobile-cart-close" title="Close cart" aria-label="Close cart" @onclick="CloseMobileCart">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </header>

                @if (!currentOrder.Items.Any())
                {
                    <div class="cart-empty">
                        <i class="bi bi-basket"></i>
                        <strong>Your cart is empty</strong>
                        <span>Select an item from the catalog to build this order.</span>
                    </div>
                }
                else
                {
                    <div class="cart-list">
                        @foreach (var item in currentOrder.Items)
                        {
                            <article class="cart-item">
                                <img src="@ItemImage(item.Category, item.ImageUrl)" alt="" />
                                <div class="cart-item-info">
                                    <strong>@item.Name</strong>
                                    <span>@item.Category@(string.IsNullOrWhiteSpace(item.Sku) ? string.Empty : $" · {item.Sku}") | MYR @item.UnitPrice.ToString("N2") each</span>
                                    @if (item.Discount > 0)
                                    {
                                        <small class="discount-badge">- MYR @item.Discount.ToString("N2") disc.</small>
                                    }
                                    @if (currentOrder.IsRedemptionMode)
                                    {
                                        @if (item.MemberCreditAllocations.Count > 1)
                                        {
                                            <small class="discount-badge">
                                                Member Credit · @item.MemberCreditAllocations.Count accounts · RM @item.MemberCreditAllocations.Sum(x => x.Amount).ToString("N2")
                                            </small>
                                            @foreach (var allocation in item.MemberCreditAllocations)
                                            {
                                                <small>@allocation.MemberCreditAccountId · RM @allocation.Amount.ToString("N2")</small>
                                            }
                                        }
                                        else if (!string.IsNullOrWhiteSpace(item.MemberCreditAccountId))
                                        {
                                            <small class="discount-badge">
                                                Member Credit · @item.MemberTypeId · @item.MemberCreditAccountId
                                            </small>
                                        }
                                        else
                                        {
                                            <small>Not assigned to Member Credit</small>
                                        }
                                    }
                                </div>
                                <div class="cart-item-qty-stepper">
                                    <button type="button" class="qty-btn" @onclick="() => ChangeCartItemQuantity(item, -1)" title="Decrease">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <span class="qty-num">@item.Quantity</span>
                                    <button type="button" class="qty-btn" @onclick="() => ChangeCartItemQuantity(item, 1)" title="Increase">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>
                                <b>MYR @item.TotalPrice.ToString("N2")</b>
                                <div class="cart-item-actions">
                                    @if (currentOrder.IsRedemptionMode)
                                    {
                                        <button type="button"
                                                title="Select Member Credit account"
                                                @onclick="() => OpenLineCreditSelectorAsync(item)">
                                            <i class="bi bi-wallet2"></i>
                                        </button>
                                    }
                                    <button type="button" title="Edit item discount/price" @onclick="() => EditCartItem(item)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="remove" title="Remove item" @onclick="() => RemoveItem(item)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }

                <footer>
                    <div><span>Subtotal</span><strong>MYR @currentOrder.Subtotal.ToString("N2")</strong></div>
                    <div><span>Discount</span><strong>- MYR @currentOrder.Discount.ToString("N2")</strong></div>
                    @if (currentOrder.Tax > 0m)
                    {
                        <div><span>Tax</span><strong>MYR @currentOrder.Tax.ToString("N2")</strong></div>
                    }
                    <div class="cart-total"><span>Total</span><strong>MYR @currentOrder.Total.ToString("N2")</strong></div>
                    @if (currentOrder.IsRedemptionMode && RedeemedCreditAmount > 0m)
                    {
                        <div><span>Member Credit</span><strong>- MYR @RedeemedCreditAmount.ToString("N2")</strong></div>
                        <div><span>Balance to Pay</span><strong>MYR @AmountDueAfterCredit.ToString("N2")</strong></div>
                    }

                    <div class="cart-footer-buttons">
                        <button type="button" class="secondary-action hold-cart-btn" @onclick="HoldCurrentOrder">
                            <i class="bi bi-pause-circle"></i> Hold Order
                        </button>
                        <button type="button" class="primary-action proceed-pay-btn" disabled="@(!currentOrder.Items.Any())" @onclick="ContinueToPayment">
                            <span>Proceed to Payment</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </footer>
            </aside>

            @* Mobile checkout trigger bar *@
            <div class="mobile-checkout-bar" aria-label="Cart summary">
                <button type="button" class="mobile-cart-trigger" @onclick="OpenMobileCart" aria-label="Open cart with @currentOrder.Items.Count items">
                    <span class="mobile-checkout-count">
                        <span>Items</span>
                        <strong>@currentOrder.ItemCount</strong>
                    </span>
                    <span class="mobile-checkout-total">
                        <span>Total</span>
                        <strong>MYR @currentOrder.Total.ToString("N2")</strong>
                    </span>
                    <i class="bi bi-chevron-up" aria-hidden="true"></i>
                </button>
                <button type="button" class="mobile-checkout-action" disabled="@(!currentOrder.Items.Any())" @onclick="ContinueToPayment">
                    <span>Proceed</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </section>
    }
    @* ========================================= 6. STAGE 4: PAYMENT ========================================= *@
    else if (stage == SaleStage.Payment)
    {
        <section class="payment-workspace">
            <div class="payment-column">
                <div class="section-heading">
                    <div>
                        <span>Payment Collection</span>
                        <h2>How is the customer paying?</h2>
                    </div>
                </div>

                <div class="payment-method-grid">
                    @foreach (var method in paymentTypes)
                    {
                        var allocation = PaymentFor(method.POSPaymentTypeID);
                        <button type="button" class="payment-method @(allocation is not null ? "selected" : null)" @onclick="() => OpenCalculator(method)">
                            <span class="payment-method-icon"><i class="bi @PaymentIcon(method.POSPaymentTypeName)"></i></span>
                            <span class="payment-method-copy">
                                <strong>@method.POSPaymentTypeName</strong>
                                <small>@(allocation is not null ? $"MYR {allocation.Amount:N2}" : "Add payment")</small>
                            </span>
                            @if (allocation is not null)
                            {
                                <i class="bi bi-check-circle-fill selected-check"></i>
                            }
                        </button>
                    }
                </div>

                @if (currentOrder.Payments.Count > 0)
                {
                    <section class="split-payments" aria-label="Added payments">
                        <header>
                            <div>
                                <span>Payment Breakdown</span>
                                <strong>@currentOrder.Payments.Count method(s) applied</strong>
                            </div>
                            <b>MYR @PaidAmount.ToString("N2") collected</b>
                        </header>
                        @foreach (var payment in currentOrder.Payments)
                        {
                            <div class="split-payment-row">
                                <span class="payment-symbol"><i class="bi @PaymentIcon(payment.PaymentMethod)"></i></span>
                                <div>
                                    <strong>@payment.PaymentMethod</strong>
                                    <small>@(Remaining > 0 ? $"MYR {Remaining:N2} remaining" : "Covered")</small>
                                </div>
                                <b>MYR @payment.Amount.ToString("N2")</b>
                                <button type="button" title="Edit payment" @onclick="() => EditPayment(payment)"><i class="bi bi-pencil"></i></button>
                                <button type="button" class="remove-payment" title="Remove payment" @onclick="() => RemovePayment(payment)"><i class="bi bi-trash"></i></button>
                            </div>
                        }
                    </section>
                }

                <label class="notes-field">
                    <span>Receipt Notes (Optional)</span>
                    <textarea @bind="currentOrder.Notes" placeholder="Enter notes or remarks for this receipt..."></textarea>
                </label>
            </div>

            <aside class="order-panel">
                <header>
                    <span class="panel-icon"><i class="bi bi-receipt"></i></span>
                    <div>
                        <h2>Order Summary</h2>
                        <p>@currentOrder.OrderNumber</p>
                    </div>
                </header>

                <div class="order-customer">
                    <i class="bi bi-person-badge"></i>
                    <div>
                        <span>Customer</span>
                        <strong>@currentOrder.CustomerName</strong>
                        <small>@currentOrder.CustomerContact | @currentOrder.MembershipType</small>
                    </div>
                </div>

                <div class="order-list">
                    @foreach (var item in currentOrder.Items)
                    {
                        <div>
                            <img src="@ItemImage(item.Category, item.ImageUrl)" alt="" />
                            <span>
                                <strong>@item.Name</strong>
                                <small>@item.Category | Qty @item.Quantity</small>
                            </span>
                            <b>MYR @item.TotalPrice.ToString("N2")</b>
                        </div>
                    }
                </div>

                <div class="order-totals">
                    <div><span>Subtotal</span><strong>MYR @currentOrder.Subtotal.ToString("N2")</strong></div>
                    <div><span>Discount</span><strong>- MYR @currentOrder.Discount.ToString("N2")</strong></div>
                    <div class="grand-total"><span>Total Payable</span><strong>MYR @currentOrder.Total.ToString("N2")</strong></div>
                    @if (currentOrder.IsRedemptionMode && RedeemedCreditAmount > 0m)
                    {
                        <div><span>Member Credit</span><strong>- MYR @RedeemedCreditAmount.ToString("N2")</strong></div>
                    }
                    <div><span>Amount Received</span><strong>MYR @PaidAmount.ToString("N2")</strong></div>
                    <div class="remaining @(Remaining > 0 ? "due" : "covered")">
                        <span>Remaining</span>
                        <strong>MYR @Remaining.ToString("N2")</strong>
                    </div>
                    <div class="change"><span>Change</span><strong>MYR @Change.ToString("N2")</strong></div>
                </div>

                <button type="button"
                        class="primary-action"
                        disabled="@(isSaving || Remaining > 0 || (!currentOrder.IsRedemptionMode && currentOrder.Payments.Count == 0))"
                        @onclick="SaveSale">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Saving transaction...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <span>Complete Sale</span>
                    }
                </button>
            </aside>
        </section>
    }
    @* ========================================= 7. STAGE 5: RECEIPT ========================================= *@
    else if (stage == SaleStage.Complete && savedSale is not null)
    {
        <section class="receipt-panel">
            <header class="receipt-heading">
                <span class="receipt-success"><i class="bi bi-check2"></i></span>
                <div>
                    <span>@(isReopenedRedemption ? "Saved Redemption" : "Payment Successful")</span>
                    <h2>@(isReopenedRedemption ? "Redemption Reopened" : currentOrder.IsRedemptionMode ? "Redemption Completed" : "Sale Completed")</h2>
                    <p>@(isReopenedRedemption ? "Loaded from the official saved redemption record." : "The transaction has been saved successfully and is ready to print.")</p>
                </div>
            </header>

            <article class="receipt-paper" aria-label="Sale receipt">
                <header class="receipt-brand">
                    <img class="receipt-brand-logo" src="@ReceiptBranding.LogoUrl" alt="EBI logo" />
                    <div><strong>@ReceiptBranding.AppTitle</strong><small>@ReceiptBranding.AppSubtitle</small></div>
                    <b>OFFICIAL RECEIPT</b>
                </header>

                <section class="receipt-meta">
                    <div><span>Receipt No.</span><strong>@ReceiptNumber</strong></div>
                    <div><span>Date</span><strong>@ReceiptDate.ToString("dd/MM/yyyy hh:mm tt")</strong></div>
                    <div><span>Customer</span><strong>@ReceiptCustomer</strong></div>
                    <div><span>Branch</span><strong>@ReceiptBranch</strong></div>
                </section>

                <section class="receipt-items">
                    <header><span>Item</span><span>Qty</span><span>Total</span></header>
                    @foreach (var item in currentOrder.Items)
                    {
                        <div class="receipt-item-row">
                            <div><strong>@item.Name</strong><small>@item.Category - MYR @item.UnitPrice.ToString("N2") each</small></div>
                            <span>@Math.Max(1, item.Quantity)</span>
                            <strong>MYR @item.TotalPrice.ToString("N2")</strong>
                        </div>
                    }
                </section>

                <section class="receipt-totals">
                    <div><span>Subtotal</span><strong>MYR @ReceiptSubtotalAmount.ToString("N2")</strong></div>
                    <div><span>Discount</span><strong>- MYR @ReceiptDiscountAmount.ToString("N2")</strong></div>
                    <div class="receipt-total"><span>Total Paid</span><strong>MYR @ReceiptTotalAmount.ToString("N2")</strong></div>
                </section>

                <section class="receipt-payment-breakdown">
                    <h3>Payment Breakdown</h3>
                    @foreach (var payment in ReceiptDisplayPayments)
                    {
                        <div><span><i class="bi @PaymentIcon(payment.PaymentMethod)"></i> @ReceiptPaymentLabel(payment)</span><strong>MYR @payment.Amount.ToString("N2")</strong></div>
                    }
                    <div><span>Amount Received</span><strong>MYR @PaidAmount.ToString("N2")</strong></div>
                    <div class="receipt-change"><span>Change Returned</span><strong>MYR @Change.ToString("N2")</strong></div>
                </section>

                <footer>Thank you for visiting @ReceiptBranding.AppTitle.</footer>
            </article>

            <div class="receipt-actions">
                <button type="button" class="secondary-action" @onclick="LeaveReceipt">
                    <i class="bi bi-arrow-left"></i> @(isReopenedRedemption ? "Back to Redemption History" : "Back to Sales")
                </button>
                <button type="button" class="print-receipt-action" @onclick="PrintReceipt">
                    <i class="bi bi-printer"></i> Print Receipt
                </button>
                <button type="button"
                        class="secondary-action"
                        @onclick="DownloadPdfReceipt"
                        disabled="@isDownloadingReceipt">
                    @if (isDownloadingReceipt)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Downloading...</span>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-pdf"></i>
                        <span>Download PDF Receipt</span>
                    }
                </button>
                @if (CanRequestReview)
                {
                    <button type="button" class="secondary-action" @onclick="OpenCustomerRating">
                        <i class="bi bi-star"></i> Customer Review
                    </button>
                }
                <button type="button" class="primary-action" @onclick="StartAnotherSale">
                    <i class="bi bi-plus-lg"></i> New Sale
                </button>
            </div>
        </section>
    }
</main>

@* ========================================= DIALOGS & MODALS ========================================= *@

@* Item Quantity & Discount Editor Dialog *@
@if (showRedeemableCredits)
{
    <div class="dialog-backdrop" @onclick="CloseRedeemableCredits"></div>
    <section class="credit-accounts-dialog" role="dialog" aria-modal="true" aria-label="Redeemable Member Credit accounts">
        <header>
            <div>
                <span class="credit-dialog-icon"><i class="bi bi-wallet2"></i></span>
                <div>
                    <h2>Member Credit Accounts</h2>
                    <p>@currentOrder.CustomerName · available credit accounts ordered by expiry</p>
                </div>
            </div>
            <button type="button" class="icon-button" title="Close" @onclick="CloseRedeemableCredits">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        @if (isRedeemableCreditsLoading)
        {
            <div class="credit-dialog-state">
                <span class="spinner-border spinner-border-sm"></span>
                <span>Loading redeemable credit accounts...</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(redeemableCreditsError))
        {
            <div class="credit-dialog-state credit-dialog-error">
                <i class="bi bi-exclamation-circle"></i>
                <span>@redeemableCreditsError</span>
                <button type="button" class="secondary-action" @onclick="ReloadRedeemableCredits">Retry</button>
            </div>
        }
        else if (redeemableCredits.Count == 0)
        {
            <div class="credit-dialog-state">
                <i class="bi bi-wallet"></i>
                <strong>No redeemable Member Credit</strong>
                <span>This customer has no available Member Credit account for the current date.</span>
            </div>
        }
        else
        {
            <div class="credit-account-summary">
                <span><strong>@redeemableCredits.Count</strong> account@(redeemableCredits.Count == 1 ? "" : "s")</span>
                <span>Total available: <strong>RM @redeemableCredits.Sum(x => x.NetBalanceAfterUtilised).ToString("N2")</strong></span>
            </div>
            <div class="credit-account-table-wrap">
                <table class="credit-account-table">
                    <thead>
                        <tr>
                            <th>Credit Account</th>
                            <th>Purchase Date</th>
                            <th>Document</th>
                            <th>Member Type</th>
                            <th>Purchased Via</th>
                            <th>Expiry</th>
                            <th class="amount-cell">Original</th>
                            <th class="amount-cell">Balance</th>
                            <th>History</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var credit in redeemableCredits)
                        {
                            <tr>
                                <td><strong>@credit.ARAPOutstandingID</strong></td>
                                <td>@FormatCreditDate(credit.FinancialDate)</td>
                                <td>@(string.IsNullOrWhiteSpace(credit.DisplayCode) ? "—" : credit.DisplayCode)</td>
                                <td>@(string.IsNullOrWhiteSpace(credit.MemberTypeID) ? "—" : credit.MemberTypeID)</td>
                                <td>@(string.IsNullOrWhiteSpace(credit.ItemDescription) ? "—" : credit.ItemDescription)</td>
                                <td>@FormatCreditDate(credit.DueDate)</td>
                                <td class="amount-cell">RM @credit.TotalAmount.ToString("N2")</td>
                                <td class="amount-cell credit-balance-value">RM @credit.NetBalanceAfterUtilised.ToString("N2")</td>
                                <td>
                                    <button type="button"
                                            class="secondary-action credit-history-button"
                                            @onclick="() => LoadCreditRedemptionHistoryAsync(credit)">
                                        History
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedHistoryCreditId))
            {
                <section class="credit-redemption-history">
                    <div class="credit-history-heading">
                        <div>
                            <strong>Redemption History</strong>
                            <span>@selectedHistoryCreditId</span>
                        </div>
                    </div>

                    @if (isCreditHistoryLoading)
                    {
                        <div class="credit-dialog-state">
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Loading redemption history...</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(creditHistoryError))
                    {
                        <div class="credit-dialog-state credit-dialog-error">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@creditHistoryError</span>
                        </div>
                    }
                    else if (creditRedemptionHistory.Count == 0)
                    {
                        <div class="credit-dialog-state">
                            <span>No redemption history found for this Member Credit account.</span>
                        </div>
                    }
                    else
                    {
                        <div class="credit-account-table-wrap">
                            <table class="credit-account-table">
                                <thead>
                                    <tr>
                                        <th>Member Credit</th>
                                        <th>Redeem Date</th>
                                        <th>Document</th>
                                        <th class="amount-cell">Redeem Amount</th>
                                        <th>Branch</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var history in creditRedemptionHistory)
                                    {
                                        <tr>
                                            <td>@history.SourceARAPOutstandingID</td>
                                            <td>@FormatCreditDate(history.FinancialDate)</td>
                                            <td>@history.DisplayCode</td>
                                            <td class="amount-cell">RM @Math.Abs(history.TotalAmount).ToString("N2")</td>
                                            <td>@history.BranchID</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        }

        <footer>
            <span class="credit-dialog-note">
                <i class="bi bi-info-circle"></i>
                In Redemption Mode, use the wallet button on a cart line to assign one of these accounts.
            </span>
            <button type="button" class="secondary-action" @onclick="CloseRedeemableCredits">Close</button>
        </footer>
    </section>
}

@if (showLineCreditSelector && creditTargetItem is not null)
{
    <div class="dialog-backdrop" @onclick="CloseLineCreditSelector"></div>
    <section class="credit-accounts-dialog" role="dialog" aria-modal="true" aria-label="Select Member Credit account">
        <header>
            <div>
                <span class="credit-dialog-icon"><i class="bi bi-wallet2"></i></span>
                <div>
                    <h2>Select Member Credit</h2>
                    <p>@creditTargetItem.Name · line total RM @creditTargetItem.TotalPrice.ToString("N2")</p>
                </div>
            </div>
            <button type="button" class="icon-button" title="Close" @onclick="CloseLineCreditSelector">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        @if (isRedeemableCreditsLoading)
        {
            <div class="credit-dialog-state">
                <span class="spinner-border spinner-border-sm"></span>
                <span>Loading redeemable credit accounts...</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(redeemableCreditsError))
        {
            <div class="credit-dialog-state credit-dialog-error">
                <i class="bi bi-exclamation-circle"></i>
                <span>@redeemableCreditsError</span>
                <button type="button" class="secondary-action" @onclick="ReloadRedeemableCredits">Retry</button>
            </div>
        }
        else if (redeemableCredits.Count == 0)
        {
            <div class="credit-dialog-state">
                <i class="bi bi-wallet"></i>
                <strong>No redeemable Member Credit</strong>
            </div>
        }
        else
        {
            <div class="credit-allocation-summary">
                <div>
                    <span>Redemption amount</span>
                    <strong>RM @creditTargetItem.TotalPrice.ToString("N2")</strong>
                </div>
                <div>
                    <span>Credit allocated</span>
                    <strong>RM @DraftLineCreditAllocated.ToString("N2")</strong>
                </div>
                <div>
                    <span>Remaining</span>
                    <strong class="@(DraftLineCreditRemaining > 0m ? "credit-remaining" : "credit-covered")">
                        RM @DraftLineCreditRemaining.ToString("N2")
                    </strong>
                </div>
            </div>

            <div class="credit-auto-allocation-bar">
                <div>
                    <strong>Automatic allocation</strong>
                    <span>Uses credit by earliest expiry, then Credit Account ID. You can edit the amounts afterward.</span>
                </div>
                <button type="button"
                        class="credit-auto-allocate-button"
                        disabled="@(creditTargetItem.TotalPrice <= 0m || !HasFifoCreditAvailable)"
                        @onclick="AutoAllocateLineCredit">
                    <i class="bi bi-lightning-charge-fill"></i>
                    Auto Allocate
                </button>
            </div>

            <div class="credit-account-table-wrap">
                <table class="credit-account-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Credit Account</th>
                            <th>Member Type</th>
                            <th>Expiry</th>
                            <th class="amount-cell">Available</th>
                            <th class="amount-cell">Use</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var credit in redeemableCredits)
                        {
                            var accountId = credit.ARAPOutstandingID ?? string.Empty;
                            var available = CreditAvailableForLine(credit, creditTargetItem);
                            var selected = draftLineCreditAllocations.ContainsKey(accountId);
                            <tr class="@(selected ? "credit-allocation-selected" : string.Empty)">
                                <td>
                                    <input type="checkbox"
                                           checked="@selected"
                                           disabled="@(!selected && (available <= 0m || DraftLineCreditRemaining <= 0m))"
                                           @onchange="(ChangeEventArgs e) => ToggleLineCreditAllocation(credit, e.Value is bool isChecked && isChecked)" />
                                </td>
                                <td>
                                    <strong>@credit.ARAPOutstandingID</strong>
                                    <small>@(string.IsNullOrWhiteSpace(credit.ItemDescription) ? "" : credit.ItemDescription)</small>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(credit.MemberTypeID) ? "—" : credit.MemberTypeID)</td>
                                <td>@FormatCreditDate(credit.DueDate)</td>
                                <td class="amount-cell">RM @available.ToString("N2")</td>
                                <td class="amount-cell">
                                    <input type="number"
                                           class="credit-allocation-input"
                                           min="0"
                                           step="0.01"
                                           max="@FormatCreditAmountInput(available)"
                                           disabled="@(!selected)"
                                           value="@FormatCreditAmountInput(DraftCreditAllocationAmount(credit))"
                                           @onchange="(ChangeEventArgs e) => UpdateLineCreditAllocationAmount(credit, e.Value?.ToString())" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <footer>
            <button type="button" class="secondary-action" @onclick="ClearLineCreditSelection">
                Remove Credit
            </button>
            <button type="button"
                    class="primary-action"
                    disabled="@(draftLineCreditAllocations.Count == 0 || DraftLineCreditRemaining > 0m || DraftLineCreditAllocated > creditTargetItem.TotalPrice)"
                    @onclick="ApplyLineCreditSelection">
                Apply Member Credit
            </button>
        </footer>
    </section>
}

@if (editingCatalogItem is not null)
{
    <div class="dialog-backdrop" @onclick="CloseItemEditor"></div>
    <section class="item-dialog" role="dialog" aria-modal="true" aria-label="Adjust item">
        <header>
            <div>
                <img src="@ItemImage(editingCatalogItem.Type, editingCatalogItem.ImageUrl)" alt="" />
                <div>
                    <span>@editingCatalogItem.Type</span>
                    <h2>@editingCatalogItem.Name</h2>
                    <small>@editingCatalogItem.Sku</small>
                </div>
            </div>
            <button type="button" class="icon-button" @onclick="CloseItemEditor"><i class="bi bi-x-lg"></i></button>
        </header>

        <div class="item-dialog-price">
            <span>Unit Price</span>
            <strong>MYR @editingCatalogItem.Price.ToString("N2")</strong>
        </div>

        <div class="item-fields">
            <label>
                <span>Quantity</span>
                <input type="number" min="1" step="1" @bind="draftQuantity" />
            </label>
            <label>
                <span>Discount Rule</span>
                <select value="@draftCashDiscountId" @onchange="OnDraftDiscountRuleChanged">
                    <option value="">Manual / No preset</option>
                    @foreach (var rule in discountRules)
                    {
                        <option value="@rule.Id">@rule.DisplayLabel</option>
                    }
                </select>
            </label>
            <label>
                <span>Discount (MYR)</span>
                <input type="number"
                       min="0"
                       step="0.01"
                       @bind="draftDiscount"
                       disabled="@(SelectedDraftDiscountRule is { IsOpenDiscount: false })" />
            </label>
        </div>

        <div class="item-dialog-total">
            <span>Line Total</span>
            <strong>MYR @DraftTotal.ToString("N2")</strong>
        </div>

        <footer>
            <button type="button" class="secondary-action" @onclick="CloseItemEditor">Cancel</button>
            <button type="button" class="primary-action" @onclick="ConfirmItem">
                <i class="bi bi-cart-plus"></i> @(editingCartItem is null ? "Add to Cart" : "Update Item")
            </button>
        </footer>
    </section>
}

@* Payment Keypad / Calculator Dialog *@
@if (calculatorMethod is not null)
{
    <div class="dialog-backdrop" @onclick="CloseCalculator"></div>
    <section class="calculator-dialog" role="dialog" aria-modal="true" aria-label="Enter payment amount">
        <header>
            <div>
                <span class="payment-symbol"><i class="bi @PaymentIcon(calculatorMethod.POSPaymentTypeName)"></i></span>
                <div>
                    <span>Payment Method</span>
                    <h2>@calculatorMethod.POSPaymentTypeName</h2>
                </div>
            </div>
            <button type="button" class="icon-button" @onclick="CloseCalculator"><i class="bi bi-x-lg"></i></button>
        </header>

        <div class="calculator-summary">
            <div><span>Total Payable</span><strong>MYR @currentOrder.Total.ToString("N2")</strong></div>
            <div><span>Already Paid</span><strong>MYR @PaidExcludingCalculatorMethod.ToString("N2")</strong></div>
            <div><span>Remaining</span><strong>MYR @CalculatorRemaining.ToString("N2")</strong></div>
        </div>

        <div class="calculator-display">
            <span>MYR</span>
            <strong>@CalculatorAmount.ToString("N2")</strong>
        </div>

        <button type="button" class="exact-button" @onclick="UseExactAmount">
            <i class="bi bi-check2-circle"></i> Pay Remaining | MYR @CalculatorRemaining.ToString("N2")
        </button>

        <div class="keypad">
            @foreach (var key in KeypadKeys)
            {
                <button type="button" @onclick="() => PressKey(key)">@key</button>
            }
            <button type="button" @onclick="ClearCalculator">Clear</button>
            <button type="button" @onclick="PressZero">0</button>
            <button type="button" @onclick="BackspaceCalculator"><i class="bi bi-backspace"></i></button>
            <button type="button" class="double-zero" @onclick="PressDoubleZero">00</button>
        </div>

        <footer>
            <button type="button" class="secondary-action" @onclick="CloseCalculator">Cancel</button>
            <button type="button" class="primary-action" @onclick="ConfirmPaymentAmount">
                Use MYR @CalculatorAmount.ToString("N2")
            </button>
        </footer>
    </section>
}

@* Delete Held Order Confirmation Modal *@
@if (orderToDelete is not null)
{
    <div class="dialog-backdrop" @onclick="CancelDeleteOrder"></div>
