@page "/EmailSettings"
@inject NavigationManager navigationManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="SettingContent">
    <div>
        <button class="btn-back" @onclick="Back">@L["Back"]</button>
    </div>
    <div class="Card">
        <div class="CardHeader">
            <h4>@L["EmailAccount"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["EmailAddress"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["DisplayName"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["Username"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["Password"]</span>
                    <input type="password" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["SMTPServer"]</span>
                    <input type="text" value="smtp.gmail.com" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["PortNo"]</span>
                    <input type="number" value="587" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["EnableSSL"]</span>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="Card">
        <div class="CardHeader">
            <h4>@L["DiscountOneTimePasswordControl"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["EnableDiscountOTP_Control"]</span>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["OTPSendToEmail"]</span>
                    <input type="text" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void Back()
    {
        navigationManager.NavigateTo("/config");
    }
}
