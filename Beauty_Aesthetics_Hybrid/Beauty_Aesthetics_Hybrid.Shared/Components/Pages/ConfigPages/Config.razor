@using Beauty_Aesthetics_WebPos.Components.Layout
@layout MainLayout
@page "/Config"
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="ConfigSelectionWrapper">

    <div class="config-page-header">
        <i class="fa-solid fa-gear config-page-header-icon"></i>
        <h3 class="config-page-title">@L["Settings"]</h3>
    </div>

    <div class="ConfigSelectItemWrapper">
        @foreach (var item in settingOptions)
        {
            <div @onclick="() => NavigateToSettings(item.Name)" class="ConfigItemWrapper">
                <div class="ConfigItemIcon">
                    <i class="@item.IconClass"></i>
                </div>
                <div class="ConfigItemDetails">
                    <h4 class="ConfigItemDetailName">@L[GetSettingNameKey(item.Name)]</h4>
                </div>
                <i class="fa-solid fa-chevron-right ConfigItemRightIcon"></i>
            </div>
        }
    </div>

</div>

