                                <input @bind="RequestOtpSelected" type="text" />
                            </div>
                            <div class="DropdownIcon">
                                <i @onclick="ToggleRequestOtp" class="fa-solid fa-caret-down DropdownIcon"></i>
                            </div>
                            @if (requestOtpOpen)
                            {
