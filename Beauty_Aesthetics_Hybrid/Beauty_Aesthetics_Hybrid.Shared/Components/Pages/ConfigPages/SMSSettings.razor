                    <span>@L["OnPasswordReSend"]</span>
                    <div class="DoubleInput">
                        <div id="PasswordResendSelect" class="SingleInputSelect">
                            <div class="InputSelect">
                                <input @bind="PasswordResendSelected" type="text" />
                            </div>
                            <div class="DropdownIcon">
                                <i @onclick="TogglePasswordResend" class="fa-solid fa-caret-down DropdownIcon"></i>
                            </div>
