@page "/SmsSettings"
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="SettingContent">
    <div>
        <button class="btn-back" @onclick="Back">@L["Back"]</button>
    </div>
    <div class="Card">
        <div class="CardHeader">
            <span>@L["MessagingAccount"]</span>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["Provider"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["URL"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["Username"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["Password"]</span>
                    <input type="password" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["Sender"]</span>
                    <input type="text" value="smtp.gmail.com" />
                </div>
            </div>
        </div>
    </div>
    <div class="Card">
        <div class="CardHeader">
            <span>@L["DefaultMessagingMethod"]</span>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="SelectField">
                    <span>@L["ApplicationStyle"]</span>
                    <select class="DropdownSelect">
                        <option value="Default">@L["Default"]</option>
                        <option value="App">@L["App"]</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="Card">
        <div class="hardware-panel">
            <div class="CardHeader">
                <span>@L["HardwareControl"]</span>
            </div>

            <div class="tabs-container">
                @foreach (var tab in Tabs)
                {
                    <button class="tab-button @(ActiveTab == tab ? "active" : "")"
                            @onclick="() => ActiveTab = tab">
                        @L[tab.Replace(" ", "")]
                    </button>
                }
            </div>

            <div class="tab-content">
                @if (ActiveTab == "SMS Content")
                {
                    <div class="FormContainer">
                        <div class="SingleInput">
                            <div class="TextAreaWrapper">
                                <span>@L["OnPackagePurchase"]</span>
                                <div class="TextAreaInputWrapper">
                                    <textarea class="DropdownTextField"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="SingleInput">
                            <div class="TextAreaWrapper">
                                <span>@L["OnPackageRedemption"]</span>
                                <div class="TextAreaInputWrapper">
                                    <textarea class="DropdownTextField"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="SingleInput">
                            <div class="TextAreaWrapper">
                                <span>@L["OnPackageExtension"]</span>
                                <div class="TextAreaInputWrapper">
                                    <textarea class="DropdownTextField"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="SingleInput">
                            <div class="TextAreaWrapper">
                                <span>@L["OnCreditTopUp"]</span>
                                <div class="TextAreaInputWrapper">
                                    <textarea class="DropdownTextField"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="SingleInput">
                            <div class="TextAreaWrapper">
                                <span>@L["OnCreditRedemption"]</span>
                                <div class="TextAreaInputWrapper">
                                    <textarea class="DropdownTextField"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="SingleInput">
                            <div class="TextAreaWrapper">
                                <span>@L["OnPointRedemption"]</span>
                                <div class="TextAreaInputWrapper">
                                    <textarea class="DropdownTextField"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="SingleInput">
                            <div class="TextAreaWrapper">
                                <span>@L["OnTimeRedemption"]</span>
                                <div class="TextAreaInputWrapper">
                                    <textarea class="DropdownTextField"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="SingleInput">
                            <div class="TextAreaWrapper">
                                <span>@L["OnRequestOTP"]</span>
                                <div class="TextAreaInputWrapper">
                                    <textarea class="DropdownTextField"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="SingleInput">
                            <div class="TextAreaWrapper">
                                <span>@L["OnPasswordReSend"]</span>
                                <div class="TextAreaInputWrapper">
                                    <textarea class="DropdownTextField"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="SingleInput">
                            <div class="TextAreaWrapper">
                                <span>@L["OnItemReadyForCollection"]</span>
                                <div class="TextAreaInputWrapper">
                                    <textarea class="DropdownTextField"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (ActiveTab == "Whatsapp Template")
                {
                    <span>@L["OnPackageRedemption"]</span>
                    <div class="DoubleInput">
                        <div id="PackageRedemptionSelect" class="SingleInputSelect">
                            <div class="InputSelect">
                                <input @bind="PackageRedemptionSelected" type="text" />
                            </div>
                            <div class="DropdownIcon">
                                <i @onclick="TogglePackageRedemption" class="fa-solid fa-caret-down DropdownIcon"></i>
                            </div>
                            @if (packageRedemptionOpen)
                            {
                                <div class="DropdownContainer">
                                    <div class="DropdownSelectTable">
                                        <div class="dropdownTableRow">
                                            <div class="column1"><span>@L["Name"]</span></div>
                                            <div class="column2"><span>@L["Category"]</span></div>
                                            <div class="column3"><span>@L["Status"]</span></div>
                                            <div class="column4"><span>@L["Content"]</span></div>
                                        </div>
                                        @foreach (var item in PackageRedemptionOptions)
                                        {
                                            <div @onclick="() => SelectPackageRedemption(item)" class="dropdownTableRow">
                                                <div class="column1"><span>@item.name</span></div>
                                                <div class="column2"><span>@item.category</span></div>
                                                <div class="column3"><span>@item.status</span></div>
                                                <div class="column4"><span>@item.content</span></div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="TextAreaWrapper">
                            <div class="TextAreaInputWrapper">
                                <textarea class="DropdownTextField"></textarea>
                            </div>
                        </div>
                    </div>

                    <span>@L["OnPackageExtension"]</span>
                    <div class="DoubleInput">
                        <div id="PackageExtensionSelect" class="SingleInputSelect">
                            <div class="InputSelect">
                                <input @bind="PackageExtensionSelected" type="text" />
                            </div>
