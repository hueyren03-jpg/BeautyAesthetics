                                <input @bind="ItemReadySelected" type="text" />
                            </div>
                            <div class="DropdownIcon">
                                <i @onclick="ToggleItemReady" class="fa-solid fa-caret-down DropdownIcon"></i>
                            </div>
                            @if (itemReadyOpen)
                            {
