@page "/ACCIntegration"
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="SettingContent">
    <div>
        <button class="btn-back" @onclick="Back">@L["Back"]</button>
    </div>
    <div class="Card">
        <div class="CardHeader">
            <h4>@L["AccountingIntegration"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["AccountingIntegration"]</span>
                    <input type="text" placeholder="Enter integration name" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["AccountingSoftware"]</span>
                    <select class="DropdownSelect">
                        <option value="">@L["SelectSoftware"]</option>
                        <option>SQL Accounting</option>
                        <option>AutoCount</option>
                        <option>QuickBooks</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="hardware-panel integration-panel">
            <div class="tabs-container">
                @foreach (var tab in Tabs)
                {
                    <button class="tab-button @(ActiveTab == tab ? "active" : "")"
                             @onclick="() => ActiveTab = tab">
                        @L[tab.Replace(" ", "")]
                    </button>
                }
            </div>
            <div class="tab-content">
                @if (ActiveTab == "Default Control Account")
                {
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["CashCustomerCode"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["CustomerControlAccount"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["SalesControlAccount"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["SalesReturnAccount"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["SupplierControlAccount"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["PurchaseControlAccount"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["PurchaseReturnControlAccount"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["IncludesStockCodeInSalesExport"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <button class="reset-button">@L["ResetDefaultAccount"]</button>
                    </div>
                }
                else if (ActiveTab == "Sales Control Account")
                {
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Product"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Service"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Package"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Voucher"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["TopUp"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["CashTopUpItem"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Bundle"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["ServiceCharge"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Deposit"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["RoundingAmount"]</span>
                            <input type="text" />
                        </div>
                    </div>
                }
                else if (ActiveTab == "Sales Return Control Account")
                {
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Product"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Service"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Package"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Voucher"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["TopUp"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["CashTopUpItem"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Bundle"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["ServiceCharge"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["Deposit"]</span>
                            <input type="text" />
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputTextField">
                            <span>@L["RoundingAmount"]</span>
                            <input type="text" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

