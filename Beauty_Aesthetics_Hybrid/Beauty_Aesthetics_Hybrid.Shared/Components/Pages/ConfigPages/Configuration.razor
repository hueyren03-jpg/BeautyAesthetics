@page "/Configuration"
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="SettingContent">
    <div>
        <button class="btn-back" @onclick="Back">@L["Back"]</button>
    </div>
    <div class="Card">
        <div class="CardHeader">
            <h4>@L["MembershipConfiguration"]</h4>
        </div>
        <div class="CardContent">
            <div class="DoubleInput">
                <div class="SettingsColumn">
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["PromptMemberTypeChangeUponTopUp"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["HideCustomerPhoneNumber"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["AllowOtherBranchMemberWithoutCard"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["AllowCustomerMemberTypeOverride"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["KeepTrackCustomerServiceRecords"]</span>
                            <label class="switch">
                                <input type="checkbox" checked />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["DisableAutoBundleDetectionPrompt"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["UseLoginUserAsDefaultSalesPerson"]</span>
                            <label class="switch">
                                <input type="checkbox" checked />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["CombineIdenticalItems"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="SettingsColumn">
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["AllowMemberCrossBranchTopUp"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["VoucherTrackDetailMovement"]</span>
                            <label class="switch">
                                <input type="checkbox" checked />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["EnableClickToChangeItem"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["KeepTrackCommissionRecords"]</span>
                            <label class="switch">
                                <input type="checkbox" checked />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["EnableEmployeeJobSchedulerControl"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["AllowPackageOffsetInSettlementLine"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["PromptUserLogoutUponOrder"]</span>
                            <label class="switch">
                                <input type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="SingleInput">
                        <div class="InputButton">
                            <span>@L["PromptForPaxNoInput"]</span>
                            <label class="switch">
                                <input type="checkbox" checked />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

}
