@page "/RoomLayoutSettings"
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="SettingContent">
    <div>
        <button class="btn-back" @onclick="Back">@L["Back"]</button>
    </div>
    <div class="Card">
        <div class="CardHeader">
            <h4>@L["KitchenPrinting"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["EnableKitchenPrinter"]</span>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["PrintItemByItem"]</span>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["CombinedPrintingByPrinter"]</span>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["PrintToKitchenOnTableChanged"]</span>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["SkipPrintVoidItem"]</span>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["PrintOrderChit"]</span>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["CombinedPrintingKitchenCopies"]</span>
                    <input type="number" value="0" />
                </div>
            </div>
        </div>
    </div>

    <div class="Card">
        <div class="CardHeader">
            <h4>@L["ServiceChargeSetting"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["EnableServiceCharge"]</span>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["ServiceChargeItem"]</span>
                    <div class="InputWithButton">
                        <input type="text" />
                    </div>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["DiningTypeCovered"]</span>
                    <div class="SingleInputSelect">
                        <input type="text" placeholder="@L["DiningTypePlaceholder"]" />
                        <div class="DropdownIcon">
                            <i class="fa-solid fa-caret-down"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["ServiceChargePercent"]</span>
                    <input type="text" value="0.00%" />
                </div>
            </div>
        </div>
    </div>

    <div class="Card">
        <div class="CardHeader">
            <h4>@L["TableLayoutSettings"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="SelectField">
                    <span>@L["TableLayoutTemplate"]</span>
                    <select class="DropdownSelect">
                        <option>FNB</option>
                        <option>Default</option>
                        <option>Custom</option>
                    </select>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["FirstReminderMinutes"]</span>
                    <input type="number" value="10" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["SecondReminderMinutes"]</span>
                    <input type="number" value="10" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["TableOccupiedColor"]</span>
                    <div class="ColorPickerContainer">
                        <input type="color" value="#CBAFED" class="ColorPicker" />
                        <div class="DropdownIcon">
                        </div>
                    </div>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["FirstReminderColor"]</span>
                    <div class="ColorPickerContainer">
                        <input type="color" value="#CBAFED" class="ColorPicker" />
                        <div class="DropdownIcon">
                        </div>
                    </div>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["SecondReminderColor"]</span>
                    <div class="ColorPickerContainer">
                        <input type="color" value="#CBAFED" class="ColorPicker" />
                        <div class="DropdownIcon">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="Card">
        <div class="CardHeader">
            <h4>@L["ItemSelectionLayout"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["RowCount"]</span>
                    <input type="number" value="2" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["ColumnCount"]</span>
                    <input type="number" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["FontSize"]</span>
                    <input type="number" value="19" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject]
    private NavigationManager navigationManager { get; set; } = default!;
    private void Back()
    {
        navigationManager.NavigateTo("/config");
    }
}
