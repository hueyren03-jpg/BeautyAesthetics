@page "/CentralControl"
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="SettingContent">
    <div>
        <button class="btn-back" @onclick="Back">@L["Back"]</button>
    </div>
  <div class="Card">
    <div class="CardHeader">
      <h4>@L["CentralisedControl"]</h4>
    </div>
    <div class="CardContent">
      <div class="DoubleInput">
        <div class="SettingsColumn">
          <div class="SingleInput"><div class="InputButton"><span>@L["EnableMGM_Reward"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["ChangeCustomerICNoAtHQOnly"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["ChangeCustomerPhoneAtHQOnly"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["UseMemberCreditOnFIFO_Basis"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["CalculateTaxOnRedemption"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["AutoExtendPackageExpiryOnPurchase"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["ApplyPriceGroupOnRedemption"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["BlockUseStockReturnAsDeposit"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
        </div>
        <div class="SettingsColumn">
          <div class="SingleInput"><div class="InputButton"><span>@L["DisallowDuplicateCustomerICNo"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["DisallowDuplicateCustomerPhone"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["DisallowDuplicateCustomerEmail"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["MemCreditPackageVoucherCantUseSameTime"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["EnableMemberPasswordProtection"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["AutoExtendCreditExpiryOnPurchase"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["ShowOnlyCustomersServedBefore"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
          <div class="SingleInput"><div class="InputButton"><span>@L["UseSinglePriceForAllOutlets"]</span><label class="switch"><input type="checkbox" /><span class="slider"></span></label></div></div>
        </div>
      </div>
    </div>
  </div>

  <div class="Card">
    <div class="tabs-container">
      <button class="tab-button @(ActiveTab == "Other Settings" ? "active" : "")" @onclick='() => ActiveTab = "Other Settings"'>@L["OtherSettings"]</button>
      <button class="tab-button @(ActiveTab == "Custom Templates" ? "active" : "")" @onclick='() => ActiveTab = "Custom Templates"'>@L["CustomTemplates"]</button>
      <button class="tab-button @(ActiveTab == "EBI Member App" ? "active" : "")" @onclick='() => ActiveTab = "EBI Member App"'>@L["EBIMemberApp"]</button>
    </div>
    <div class="tab-content">
      @if (ActiveTab == "Other Settings")
      {
        <div class="CardContent">
          <div class="SingleInput"><div class="SelectField"><span>@L["POSCustomerRegistrationStyle"]</span><select class="DropdownSelect"><option>Full</option></select></div></div>
          <div class="SingleInput"><div class="SelectField"><span>@L["RoundingMethod"]</span><select class="DropdownSelect"><option>5-Cent</option></select></div></div>
          <div class="SingleInput"><div class="SelectField"><span>@L["InputTextMaskingMethod"]</span><select class="DropdownSelect"><option>None</option></select></div></div>
          <div class="SingleInput"><div class="InputTextField"><span>@L["DefaultLayoutFolder"]</span><input type="text" /></div></div>
          <div class="SingleInput"><div class="InputTextField"><span>@L["VoucherItem"]</span><input type="text" /></div></div>
          <div class="SingleInput">
            <div class="InputTextField">
                <span>@L["DepositItem"]</span>
                <div class="InputAndButtonWrapper">
                    <input class="Flex9" type="text" />
                    <button class="Flex1 ButtonField">@L["Detect"]</button>
                </div>
            </div>
          </div>
          <div class="SingleInput"><div class="SelectField"><span>@L["CommissionFormulaControl"]</span><select class="DropdownSelect"><option>Centralised</option></select></div></div>
          <div class="SingleInput"><div class="InputTextField"><span>@L["CommissionFormulaControlExclude"]</span><input type="text" /></div></div>
          <div class="SingleInput"><div class="InputTextField"><span>@L["AutoMembershipForNewCustomer"]</span><input type="text" /></div></div>
        </div>
      }
      else if (ActiveTab == "Custom Templates")
      {
        <div class="CardContent">
          <div class="SingleInput"><div class="InputTextField"><span>@L["CustomerCurrentCondition"]</span><textarea class="InputTextField"></textarea></div></div>
          <div class="SingleInput"><div class="InputTextField"><span>@L["CustomerCurrentlyUsingProduct"]</span><textarea class="InputTextField"></textarea></div></div>
        </div>
      }
      else if (ActiveTab == "EBI Member App")
      {
        <div class="CardContent">
          <div class="SingleInput"><div class="InputTextField"><span>@L["MemberAppSalesItemFromBranch"]</span><input type="text" /></div></div>
          <div class="SingleInput"><div class="InputTextField"><span>@L["MemberAppSalesPutUnderBranch"]</span><input type="text" /></div></div>
        </div>
      }
    </div>
  </div>
</div>
@code {
  
}
