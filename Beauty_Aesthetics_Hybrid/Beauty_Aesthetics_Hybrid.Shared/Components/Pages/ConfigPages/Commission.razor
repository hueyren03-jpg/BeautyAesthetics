@page "/Commission"
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="SettingContent">
    <div>
        <button class="btn-back" @onclick="Back">@L["Back"]</button>
    </div>
    <div class="Card">
        <div class="CardHeader">
            @L["CommissionSetting"]
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["AutoShareCommissionBasedOnLoginCashier"]</span>
                    <label class="switch">
                        <input type="checkbox">
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
            <div class="SingleInput">
                <div id="CashierCommissionGroupSelect" class="SingleInputSelect">
                    <div class="InputSelect">
                        <span>@L["DefaultCashierCommissionGroup"]</span>
                        <input @bind="CashierCommissionGroupSelect" type="text" />
                        <div class="DropdownIcon">
                            <i @onclick="() => ToggleCashierCommissionGroup()" class="fa-solid fa-caret-down DropdownIcon"></i>
                        </div>
                        @if (CashierCommissionGroupIsOpen)
                        {
                            <div class="DropdownContainer @(CashierCommissionOpenUpwards ? "open-up" : "")">
                                <div class="DropdownSelectTable">
                                    <div class="dropdownTableRow">
                                        <div class="column1">
                                            <span>@L["GLDescription"]</span>
                                        </div>
                                    </div>
                                    @foreach (var item in CommissionGroupList)
                                    {
                                        <div @onclick="() => SelectDebtorControlAccount(item)" class="dropdownTableRow">
                                            <div class="column1">
                                                <span>@item</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>

@code {
    
}
