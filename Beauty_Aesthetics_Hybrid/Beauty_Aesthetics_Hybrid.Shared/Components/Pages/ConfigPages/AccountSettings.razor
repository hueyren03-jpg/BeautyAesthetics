@code {
    private string DefaultDebtorControlAccount = "Accounts Receivable";

    //to check if there is enough space below the dropdown to open downwards
    private bool OpenUpwards { get; set; } = false;

    private bool DebtorControlAccountIsOpen { get; set; } = false;

    private class GLAccount
    {
        public string GLDescription { get; set; }
        public string GLCode { get; set; }
    }

    private List<GLAccount> DebtorControlAccountItems = new()
    {
        new GLAccount { GLDescription = "Accounts Receivable", GLCode = "14-1-0003" },
        new GLAccount { GLDescription = "Accounts Receivable", GLCode = "14-1-0003" }
    };

    private async Task ToggleDebtorControlAccount()
    {
        if (!DebtorControlAccountIsOpen)
        {
            // Before opening, ask JS if we should go UP or DOWN
            OpenUpwards = await JSRuntime.InvokeAsync<bool>(
                "dropdownPositioner.shouldOpenUpwards",
                "SingleInputSelect"
            );
            DebtorControlAccountIsOpen = true;
        }
        else
        {
            DebtorControlAccountIsOpen = false;
        }
    }

    private void SelectDebtorControlAccount(GLAccount item)
    {
        DefaultDebtorControlAccount = item.GLDescription;
        DebtorControlAccountIsOpen = false;
    }
} *@

