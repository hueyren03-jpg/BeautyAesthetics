@page "/EInvoice"
@inject NavigationManager navigationManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="SettingContent">
    <div>
        <button class="btn-back" @onclick="Back">@L["Back"]</button>
    </div>
    <div class="Card">
        <div class="CardHeader">
            <h4>@L["CustomerSelfServiceEInvoiceRequest"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["EInvoiceType"]</span>
                    <select class="DropdownSelect">
                        <option value="">@L["None"]</option>
                        <option>Peppol</option>
                        <option>MyInvois</option>
                        <option>e-Invoicing API</option>
                    </select>
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["AppPortal"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["EndPoint"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["AccountNo"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["SecretKey"]</span>
                    <input type="text" />
                </div>
            </div>
        </div>
    </div>

    <div class="Card">
        <div class="CardHeader">
            <h4>@L["SelfOrderEInvoiceProcessingTerminal"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["ProcessingTerminalIPAddress"]</span>
                    <input type="text" placeholder="Fill in the IP Address of the processing terminal if you have sub-terminals." />
                </div>
            </div>
        </div>
    </div>

    <div class="Card">
        <div class="CardHeader">
            <h4>@L["SelfOrder"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["AppPortal"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["EndPoint"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["AccountNo"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["SecretKey"]</span>
                    <input type="text" />
                </div>
            </div>
        </div>
    </div>

    <div class="Card">
        <div class="CardHeader">
            <h4>@L["EBIOnlineEInvoice"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["FileUploadCode"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["FileUploadSecretKey"]</span>
                    <input type="text" />
                </div>
            </div>
            <div class="SingleInput">
                <div class="InputTextField">
                    <span>@L["MemberLoAppAccount"]</span>
                    <input type="text" />
                </div>
            </div>
        </div>
    </div>

    <div class="Card">
        <div class="CardHeader">
            <h4>@L["EBIPOSMobile"]</h4>
        </div>
        <div class="CardContent">
            <div class="SingleInput">
                <div class="InputButton">
                    <span>@L["ShowAppointmentsFromMemberApp"]</span>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void Back()
    {
        navigationManager.NavigateTo("/config");
    }
}
