                Description: string.IsNullOrWhiteSpace(NewServiceDescription)
                    ? NewServiceName.Trim()
                    : NewServiceDescription.Trim());

            var result = IsEditMode
                ? await ServiceItemService.UpdateServiceAsync(service, ServiceBranchId)
                : await ServiceItemService.CreateServiceAsync(service, ServiceBranchId);

            if (!result.Success)
            {
                ServiceApiError = result.ErrorMessage ?? "Unable to save service.";
                return;
            }

            CloseAddServiceForm();
            await LoadServiceItemsFromApiAsync();
        }
        catch (Exception ex)
        {
            ServiceApiError = $"Unable to save service. {ex.Message}";
            Feedback.Error(ServiceApiError, "Service not saved");
        }
        finally
        {
            IsSavingService = false;
        }
    }

