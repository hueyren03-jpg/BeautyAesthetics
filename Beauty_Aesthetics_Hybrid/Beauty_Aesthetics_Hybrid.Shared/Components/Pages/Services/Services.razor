    private IEnumerable<MembershipViewModel.MemberCredit> ApplyMemberCreditFilter(IEnumerable<MembershipViewModel.MemberCredit> items, MultiTableFilter.FilterData filter)
    {
        return filter.Column switch
        {
            "Name" => items.Where(item => ServiceFilterTextMatches(item.Name, filter)),
            "Code" => items.Where(item => ServiceFilterTextMatches(item.Code, filter)),
            "CreditValue" => items.Where(item => ServiceFilterInRange(item.CreditValue, filter)),
            "Price" => items.Where(item => ServiceFilterInRange(item.Price, filter)),
            _ => items
        };
    }
    private IEnumerable<string> GetMemberCreditFilterSuggestions(string column, string term)
    {
        term = term?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(column) || string.IsNullOrWhiteSpace(term))
        {
            return Enumerable.Empty<string>();
        }

        IEnumerable<string> values = column switch
        {
            "Name" => MemberCreditItems.Select(mc => mc.Name),
            "Code" => MemberCreditItems.Select(mc => mc.Code),
            "CreditValue" => MemberCreditItems.Select(mc => mc.CreditValue.ToString("N2")),
            "Price" => MemberCreditItems.Select(mc => mc.Price.ToString("N2")),
            _ => Enumerable.Empty<string>()
        };

        return values
            .Where(v => !string.IsNullOrWhiteSpace(v) && v.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v.StartsWith(term, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(v => v)
            .Take(10);
    }

    // Member Credit filtering and sorting
    private List<MultiTableFilter.FilterColumn> MemberCreditFilterColumns => new()
    {
        new() { Value = "Name", Label = "Credit Name", ControlType = "Typeahead", Placeholder = "Search credit name", Options = ServiceCountOptions(MemberCreditItems.Select(credit => credit.Name)) },
        new() { Value = "Code", Label = "Credit Code", ControlType = "Text", Placeholder = "Search credit code" },
        new() { Value = "CreditValue", Label = "Credit Value (MYR)", ControlType = "NumberRange", IsNumeric = true },
        new() { Value = "Price", Label = "Price (MYR)", ControlType = "NumberRange", IsNumeric = true }
    };

    private IEnumerable<MembershipViewModel.MemberCredit> FilteredMemberCredits
    {
        get
        {
            var items = MemberCreditItems.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(MemberCreditSearchQuery))
            {
                var search = MemberCreditSearchQuery.Trim();
                items = items.Where(m =>
                    (m.Name?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.Code?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    m.CreditValue.ToString("N2").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    m.Price.ToString("N2").Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            foreach (var filter in ActiveMemberCreditFilters)
            {
                items = ApplyMemberCreditFilter(items, filter);
            }

            if (!string.IsNullOrEmpty(MemberCreditSortColumn))
            {
                items = MemberCreditSortColumn switch
                {
                    "Name" => MemberCreditSortAscending ? items.OrderBy(m => m.Name) : items.OrderByDescending(m => m.Name),
                    "Code" => MemberCreditSortAscending ? items.OrderBy(m => m.Code) : items.OrderByDescending(m => m.Code),
                    "CreditValue" => MemberCreditSortAscending ? items.OrderBy(m => m.CreditValue) : items.OrderByDescending(m => m.CreditValue),
                    "Price" => MemberCreditSortAscending ? items.OrderBy(m => m.Price) : items.OrderByDescending(m => m.Price),
                    _ => items
                };
            }

            return items;
        }
    }

