        {
            "BundleName" => bundles.Where(bundle => ServiceFilterTextMatches(bundle.BundleName, filter)),
            "SKU" => bundles.Where(bundle => ServiceFilterTextMatches(bundle.SKU, filter)),
            "ServicesCount" => bundles.Where(bundle => ServiceFilterInRange(bundle.ServicesCount, filter)),
            "TotalDuration" => bundles.Where(bundle => ServiceFilterInRange(bundle.TotalDuration, filter)),
            "Price" => bundles.Where(bundle => ServiceFilterInRange(bundle.Price, filter)),
            _ => bundles
        };
    }
    private IEnumerable<string> GetBundleFilterSuggestions(string column, string term)
    {
        term = term?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(column) || string.IsNullOrWhiteSpace(term))
            return Enumerable.Empty<string>();

        IEnumerable<string> values = column switch
        {
            "BundleName" => Bundles.Select(b => b.BundleName),
            "SKU" => Bundles.Select(b => b.SKU),
            "ServicesCount" => Bundles.Select(b => b.ServicesCount.ToString()),
            "TotalDuration" => Bundles.Select(b => b.TotalDuration.ToString()),
            "Price" => Bundles.Select(b => b.Price.ToString("N2")),
            _ => Enumerable.Empty<string>()
        };

        return values
            .Where(v => !string.IsNullOrWhiteSpace(v) && v.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v.StartsWith(term, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(v => v)
            .Take(10);
    }

