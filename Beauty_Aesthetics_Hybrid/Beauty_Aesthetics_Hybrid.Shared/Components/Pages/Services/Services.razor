    private async Task LoadServiceItemsFromApiAsync()
    {
        IsServiceApiLoading = true;
        ServiceApiError = null;

        try
        {
            var result = await ServiceItemService.LoadServiceItemsAsync("hq");
            if (result.Success && result.Value is not null)
            {
                ServiceItems = result.Value.ToList();
                SelectedService = null;
                ExpandedMobileServiceSku = null;
                ServiceCurrentPage = 1;
            }
            else
            {
                ServiceApiError = result.ErrorMessage ?? "Unable to load service records.";
            }
        }
        finally
        {
            IsServiceApiLoading = false;
        }
    }

