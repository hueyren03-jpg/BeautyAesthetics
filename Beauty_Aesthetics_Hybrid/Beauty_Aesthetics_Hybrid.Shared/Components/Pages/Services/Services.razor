                                    <button class="bundle-modal__btn bundle-modal__btn--save" disabled="@IsSavingBundle" @onclick="HandleSaveBundle">
                                        @(IsSavingBundle ? "Saving..." : L["Save"])
                                    </button>
                                    <button class="bundle-modal__btn bundle-modal__btn--cancel" @onclick="CloseAddBundleForm">
                                        @L["Cancel"]
                                    </button>
                                </div>
                            </div>
                            <div class="bundle-modal__body">
                                <form class="bundle-form" @onsubmit:preventDefault>
                                    <div class="bundle-form__section">
                                        <h3 class="bundle-form__section-title">@L["PackageInformation"]</h3>

                                        <div class="bundle-form__field">
                                            <label>@L["PackageName"] <span class="bundle-form__required">*</span></label>
                                            <input type="text" @bind="NewBundleName" placeholder="@L["EnterPackageName"]" required />
                                        </div>

                                        <div class="bundle-form__field">
                                            <label>@L["PackageSKU"] <span class="bundle-form__required">*</span></label>
                                            <input type="text" @bind="NewBundleSKU" placeholder="@L["EnterPackageSKU"]" required />
                                        </div>

                                        <div class="bundle-form__field">
                                            <label>@L["PackagePriceMyr"] <span class="bundle-form__required">*</span></label>
                                            <input type="number" step="0.01" @bind="NewBundlePrice" placeholder="0.00" min="0" required />
                                        </div>
                                    </div>

                                    <div class="bundle-form__section">
                                        <h3 class="bundle-form__section-title">@L["SelectServices"]</h3>
                                        <p class="bundle-form__section-subtitle">@L["ChooseServicesToInclude"]</p>

                                        <div class="bundle-form__services-list">
