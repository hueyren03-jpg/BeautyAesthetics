<AppErrorPopup Title="Service request failed"
               Message="@ServicesErrorMessage"
               OnDismiss="DismissServicesError" />

@code {
    private string? ServicesErrorMessage => new[]
    {
        ServiceApiError,
        MemberCreditApiError,
        BundleApiError,
        MemberTypeApiError,
        MemberPointApiError
    }.FirstOrDefault(message => !string.IsNullOrWhiteSpace(message));

    private void DismissServicesError()
    {
        ServiceApiError = null;
        MemberCreditApiError = null;
        BundleApiError = null;
        MemberTypeApiError = null;
        MemberPointApiError = null;
    }


    private string ActiveTab { get; set; } = "Services";
    private MembershipViewModel MembershipViewModel { get; } = new();
    private InventoryViewModel InventoryViewModel { get; } = new();

    // Missing variables
    private Dictionary<string, List<ServiceViewModel.ServiceItem>> BundleServicesLookup { get; set; } = new();
    private int skuIndex;
    private List<ServiceViewModel.ServiceItem> updatedItems = new();
    private int updatedCount;
    private object row;
    private HashSet<string> existingSkus = new();
    private List<string> fileSkus = new();
    private int index;
    private ServiceViewModel.ServiceItem? SelectedService { get; set; }
    private MembershipTypeDM? MemberTypeDetailsItem { get; set; }
    private ServiceViewModel.ServiceItem? ServiceDetailsItem { get; set; }
    private MembershipViewModel.MemberCredit? MemberCreditDetailsItem { get; set; }
    private BundleItem? BundleDetailsItem { get; set; }
    private string? ExpandedMobileServiceSku { get; set; }
    private string? ExpandedMobileMemberCreditCode { get; set; }
    private string? ExpandedMobileBundleSku { get; set; }

    // Pagination properties
    private int ServiceCurrentPage { get; set; } = 1;
    private int MemberCreditCurrentPage { get; set; } = 1;
    private int MemberTypeCurrentPage { get; set; } = 1;
    private int MemberPointCurrentPage { get; set; } = 1;
    private int BundleCurrentPage { get; set; } = 1;
    private int OverrideItemsPageSize { get; set; } = 10;
    private int OverrideServicePage { get; set; } = 1;
    private int OverridePackagePage { get; set; } = 1;
    private int OverrideInventoryPage { get; set; } = 1;
    private string SearchQuery { get; set; } = string.Empty;
    private List<MultiTableFilter.FilterData> ActiveServiceFilters { get; set; } = new();
    private List<MultiTableFilter.FilterData> ActiveBundleFilters { get; set; } = new();

