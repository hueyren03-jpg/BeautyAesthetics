    {
        IsAddMemberTypeFormVisible = false;
        ResetMemberTypeForm();
    }

    private void ResetMemberTypeForm()
    {
        NewMemberTypeCode = string.Empty;
        NewMemberTypeActive = true;
        NewMemberTypeDiscountCredit = false;
        NewMemberTypeName = string.Empty;
        NewMemberTypeProductDiscount = 0.00m;
        NewMemberTypeServiceDiscount = 0.00m;
        NewMemberTypePackageDiscount = 0.00m;
        NewMemberTypeBundleDiscount = 0.00m;
        NewMemberTypeTimeFrom = "00:00";
        NewMemberTypeTimeTo = "23:59";
        SelectedItemBrand = string.Empty;
        SelectedItemGroup = string.Empty;
        SelectedItem = string.Empty;
        MemberTypeApiError = null;
    }

    private async Task HandleAddMemberType()
    {
        if (string.IsNullOrWhiteSpace(NewMemberTypeCode))
        {
            MemberTypeApiError = "Code is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(NewMemberTypeName))
        {
            MemberTypeApiError = "Name is required.";
            return;
        }

        IsSavingMemberType = true;
        MemberTypeApiError = null;

        try
        {
            var timeFrom = NewMemberTypeTimeFrom;
            if (timeFrom.Length == 5) timeFrom = $"{timeFrom}:00";
            var timeTo = NewMemberTypeTimeTo;
            if (timeTo.Length == 5) timeTo = $"{timeTo}:59";

            var memberType = new MembershipTypeDM
            {
                MemberTypeID = NewMemberTypeCode,
                MemberTypeName = NewMemberTypeName,
                Active = NewMemberTypeActive,
                IsDiscountLimitToCreditRedemption = NewMemberTypeDiscountCredit,
                MemberDiscountOnInventory = NewMemberTypeProductDiscount,
                MemberDiscountOnServices = NewMemberTypeServiceDiscount,
                MemberDiscountOnBundle = NewMemberTypeBundleDiscount,
                MemberDiscountOnPackage = NewMemberTypeBundleDiscount,
                DiscountTimeFrom = timeFrom,
                DiscountTimeTo = timeTo,
                ApplicableToItemBrand = SelectedItemBrand,
                ApplicableToItemGroup = SelectedItemGroup,
                ApplicableToItems = SelectedItem
            };

            ApiCallResult<bool> result;
            if (IsMemberTypeEditMode)
            {
                result = await MembershipTypeService.UpdateAsync(memberType);
            }
            else
            {
                result = await MembershipTypeService.CreateAsync(memberType);
            }

            if (result.Success)
            {
                CloseAddMemberTypeForm();
                await LoadMemberTypesFromApiAsync();
            }
            else
            {
                MemberTypeApiError = result.ErrorMessage ?? "An error occurred while saving the membership type.";
            }
        }
        catch (Exception ex)
        {
            MemberTypeApiError = ex.Message;
        }
        finally
        {
            IsSavingMemberType = false;
        }
    }

