    private async Task HandleAddMemberPoint()
    {
        if (IsSavingMemberPoint)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(NewMemberPointMemberType))
        {
            MemberPointApiError = "Member type is required.";
            return;
        }

        if (NewMemberPointForEveryAmount <= 0 || NewMemberPointEqualToPoint <= 0)
        {
            MemberPointApiError = "For Every X Amount and Equal to X Point must be greater than zero.";
            return;
        }

        if (NewMemberPointStartDate is null || NewMemberPointEndDate is null)
        {
            MemberPointApiError = "Start date and end date are required.";
            return;
        }

        if (NewMemberPointEndDate.Value.Date < NewMemberPointStartDate.Value.Date)
        {
            MemberPointApiError = "End date cannot be earlier than start date.";
            return;
        }

        IsSavingMemberPoint = true;
        MemberPointApiError = null;

        try
        {
            var payload = new PointConversionDM
            {
                PointID = IsMemberPointEditMode ? SelectedMemberPoint?.PointId : null,
                MemberTypeID = NewMemberPointMemberType,
                MinimumSpend = Math.Max(0, NewMemberPointMinAmount),
                ForEveryXDollar = NewMemberPointForEveryAmount,
                EqualToXPoint = NewMemberPointEqualToPoint,
                RMConversionRatio = Math.Max(0, NewMemberPointMoneyConversion),
                RoundDownToInteger = NewMemberPointRoundDown,
                FromDate = NewMemberPointStartDate.Value,
                ToDate = NewMemberPointEndDate.Value,
                ExpiryOption = int.TryParse(NewMemberPointExpiryOption, out var option) ? option : 0,
                ExpiryMonth = Math.Max(0, NewMemberPointExpiryMonth),
                VisibleToBranchID = string.IsNullOrWhiteSpace(NewMemberPointVisibleToBranchId)
                    ? null
                    : NewMemberPointVisibleToBranchId,
                ExcludeTaxAmount = NewMemberPointExcludeTax,
                ConvertRebateIntoCashVoucher = NewMemberPointConvertVoucher
            };

            var result = IsMemberPointEditMode
                ? await PointConversionService.UpdateAsync(payload)
                : await PointConversionService.CreateAsync(payload);

            if (!result.Success)
            {
                MemberPointApiError = result.ErrorMessage ?? "Unable to save member point rule.";
                return;
            }

            CloseAddMemberPointForm();
            await LoadMemberPointsFromApiAsync();
        }
        finally
        {
            IsSavingMemberPoint = false;
        }
    }

