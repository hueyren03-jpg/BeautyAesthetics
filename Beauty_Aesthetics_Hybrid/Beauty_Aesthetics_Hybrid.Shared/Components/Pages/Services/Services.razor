    private static int CalculateTotalPages(int totalItems, int pageSize)
    {
        if (pageSize <= 0)
        {
            return 1;
        }

        return Math.Max(1, (int)Math.Ceiling(totalItems / (double)pageSize));
    }

    private void ChangeOverrideInventoryPage(int delta)
    {
        var totalPages = CalculateTotalPages(FilteredOverrideInventoryItems.Count(), OverrideItemsPageSize);
        OverrideInventoryPage = Math.Clamp(OverrideInventoryPage + delta, 1, totalPages);
    }

    private void ChangeOverrideServicePage(int delta)
    {
        var totalPages = CalculateTotalPages(FilteredOverrideServiceItems.Count(), OverrideItemsPageSize);
        OverrideServicePage = Math.Clamp(OverrideServicePage + delta, 1, totalPages);
    }

    private void ChangeOverridePackagePage(int delta)
    {
        var totalPages = CalculateTotalPages(FilteredOverrideBundles.Count(), OverrideItemsPageSize);
        OverridePackagePage = Math.Clamp(OverridePackagePage + delta, 1, totalPages);
    }

