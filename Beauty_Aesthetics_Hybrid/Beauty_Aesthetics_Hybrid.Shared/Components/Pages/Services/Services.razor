@page "/services"
@namespace Beauty_Aesthetics_WebPos.Components.Pages
@using Beauty_Aesthetics_WebPos.Components.ViewModels
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using System.Text
@using System.Globalization
@using ClosedXML.Excel
@using System.IO
@using Beauty_Aesthetics_WebPos.Components.Services.Inventory
@using Beauty_Aesthetics_WebPos.Components.Services.MembershipTypes
@using Beauty_Aesthetics_WebPos.Components.Services.PointConversions
@using Beauty_Aesthetics_WebPos.Models.DTOs
@using Beauty_Aesthetics_WebPos.APIClient.ResultPattern
@inject IJSRuntime JSRuntime
@inject IServiceItemService ServiceItemService
@inject IBranchSessionService BranchSession
@inject IMemberCreditService MemberCreditService
@inject IPackageService PackageService
@inject IMembershipTypeService MembershipTypeService
@inject IPointConversionService PointConversionService
@inject AppFeedbackService Feedback
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<PageTitle>@L["Services"]</PageTitle>

<section class="services">
    <header class="services__header">
        <h1>
            @L["Services"]
            <i class="bi bi-info-circle"
               data-bs-toggle="tooltip"
               data-bs-placement="right"
               title="@L["ManageServicesMembershipsPackages"]"></i>
            <div class="services__dropdown-container">
                <button class="services__dropdown-toggle" @onclick="ToggleServiceImportExportDropdown" title="@L["ImportExportOptions"]">
                    <i class="bi bi-chevron-down @(ShowServiceImportExportDropdown ? "rotated" : "")"></i>
                </button>
                @if (ShowServiceImportExportDropdown)
                {
                    <div class="services__dropdown-backdrop" @onclick="CloseServiceImportExportDropdown"></div>
                    <div class="services__dropdown-menu">
                        <button class="services__dropdown-btn" @onclick="ImportServiceItems">
                            <i class="bi bi-upload"></i>
                            @L["ImportServices"]
                        </button>
                        <button class="services__dropdown-btn" @onclick="ExportServiceItems">
                            <i class="bi bi-download"></i>
                            @L["ExportServices"]
                        </button>
                        <button class="services__dropdown-btn" @onclick="GetServiceImportTemplate">
                            <i class="bi bi-file-earmark-text"></i>
                            @L["GetImportTemplate"]
                        </button>
                        <button class="services__dropdown-btn" @onclick="UpdateServicesFromExcel">
                            <i class="bi bi-file-earmark-excel"></i>
                            @L["UpdateFromExcel"]
                        </button>
                    </div>
                }
            </div>
        </h1>
    </header>

    @*     <InputFile id="servicesImportFileInput"
               style="display:none"
               OnChange="HandleServiceImportFileSelected"
               accept=".csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" /> *@

    <InputFile id="servicesUpdateFileInput"
               style="display:none"
               OnChange="HandleServiceUpdateFileSelected"
               accept=".csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />

    <nav class="services__menu desktop-view">
        <button class="services__menu-item @(ActiveTab == "Services" ? "active" : "")"
                @onclick='() => SetActiveTab("Services")'>
            @L["Services"]
        </button>
        <button class="services__menu-item @(ActiveTab == "MemberCredit" ? "active" : "")"
                @onclick='() => SetActiveTab("MemberCredit")'>
            @L["MemberCredit"]
        </button>
        <button class="services__menu-item @(ActiveTab == "Bundle" ? "active" : "")"
                @onclick='() => SetActiveTab("Bundle")'>
            @L["Package"]
        </button>
        <button class="services__menu-item @(ActiveTab == "Membership" ? "active" : "")"
                @onclick='() => SetActiveTab("Membership")'>
            @L["MembershipConfiguration"]
        </button>
    </nav>

    <div class="services__tab-selector-container mobile-view">
        <select class="services__tab-select" @onchange="OnTabSelectChanged" value="@ActiveTab">
            <option value="Services">@L["Services"]</option>
            <option value="MemberCredit">@L["MemberCredit"]</option>
            <option value="Bundle">@L["Package"]</option>
            <option value="Membership">@L["MembershipConfiguration"]</option>
        </select>
    </div>

    <div class="services__content">
        @if (ActiveTab == "Services")
        {
            <div class="services__section">
                @if (!IsAddServiceFormVisible)
                {
                    <div class="services__toolbar">
                        <div class="services__toolbar-primary">
                            <div class="services__action-buttons">
                                <button class="services__action-btn" title="@L["AddService"]" @onclick="ShowAddServiceForm">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                                <button class="btn-delete" title="@L["DeleteServices"]" @onclick="ToggleServiceDeleteMode">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                            <div class="services__search-container">
                                <input class="services__search"
                                       type="search"
                                       placeholder="@L["Search"]..."
                                       value="@SearchQuery"
                                       @oninput="OnServiceSearchChanged" />
                                <i class="bi bi-search services__search-icon"></i>
                            </div>
                        </div>
                        <AdvancedInventoryFilter Columns="@ServiceFilterColumns"
                                                 OnApply="@HandleServiceFiltersApplied"
                                                 OnClear="@HandleServiceFiltersCleared"
                                                 ModuleName="Services"
                                                 ContextLabel="Services"
                                                 ResultCount="@FilteredServices.Count()" />
                    </div>

                    @if (IsServiceApiLoading)
                    {
                        <div class="services__api-message services__api-message--loading">
                            Loading services...
                        </div>
                    }

                    @if (IsServiceDeleteMode)
                    {
                        <div class="services__delete-bar">
                            <button type="button" class="selected-delete-banner-close" @onclick="CancelServiceDeleteMode" title="Cancel delete mode">
                                <i class="bi bi-x-lg"></i>
                            </button>
                            <div class="services__delete-info">
                                <span>@SelectedServicesForDeletion.Count @L["ItemsSelected"]</span>
                            </div>
                            <div class="services__delete-actions">
                                <button class="services__btn services__btn--secondary" @onclick="CancelServiceDeleteMode">
                                    @L["Cancel"]
                                </button>
                                <button class="services__btn services__btn--danger"
                                        disabled="@(!SelectedServicesForDeletion.Any())"
                                        @onclick='() => RequestSelectedDeleteConfirmation("services", SelectedServicesForDeletion.Count, "service(s)")'>
                                    @L["DeleteSelected"]
                                </button>
                            </div>
                        </div>
                    }

                    <div class="services__table-wrapper desktop-view">
                        <table class="services__table resizable-table">
                            <thead>
                                <tr>
                                    @if (IsServiceDeleteMode)
                                    {
                                        <th class="services__checkbox-col"></th>
                                    }
                                    <th class="services__image-col">Image</th>
                                    <th class='@GetServiceSortHeaderClass(SortColumn, SortAscending, "ServiceName")' @onclick='() => ToggleSort("ServiceName")'>
                                        Service Name <span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetServiceSortHeaderClass(SortColumn, SortAscending, "Category")' @onclick='() => ToggleSort("Category")'>
                                        Section <span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetServiceSortHeaderClass(SortColumn, SortAscending, "Price")' @onclick='() => ToggleSort("Price")'>
                                        @L["PriceMyr"] <span class="resize-handle"></span>
                                    </th>
                                    <th class="services__actions-col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!PaginatedServices.Any())
                                {
                                    <tr>
                                        <td colspan="@(IsServiceDeleteMode ? 6 : 5)" class="services__empty-cell">
                                            No services found.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var service in PaginatedServices)
                                    {
                                        <tr class="@(SelectedService == service ? "selected" : "")" @onclick="() => HandleRowClick(service)">
                                            @if (IsServiceDeleteMode)
                                            {
                                                <td class="services__checkbox-col" @onclick:stopPropagation="true">
                                                    <input type="checkbox"
                                                           checked="@SelectedServicesForDeletion.Contains(service)"
                                                           @onchange="() => ToggleServiceForDeletion(service)" />
                                                </td>
                                            }
                                            <td class="services__image-col">
                                                @{
                                                    var serviceImage = BuildRecordImageUrl(service.ImagePath, service.ImageFileName);
                                                }
                                                @if (!string.IsNullOrWhiteSpace(serviceImage))
                                                {
                                                    <img class="services__record-image" src="@serviceImage" alt="@service.ServiceName" />
                                                }
                                                else
                                                {
                                                    <span class="services__record-image-placeholder" aria-hidden="true"><i class="bi bi-scissors"></i></span>
                                                }
                                            </td>
                                            <td>@service.ServiceName</td>
                                            <td>@service.Category</td>
                                            <td class="services-money-value">@service.Price.ToString("N2")</td>
                                            <td class="services__actions-col" @onclick:stopPropagation="true">
                                                <div class="services__row-actions">
                                                    <button type="button" class="services__action-btn services__action-btn--view" title="View details" @onclick="() => ShowServiceDetails(service)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button type="button" class="services__action-btn services__action-btn--edit" title="@L["EditService"]" @onclick="() => EditService(service)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="service-mobile-records mobile-view">
                        @if (!PaginatedServices.Any())
                        {
                            <div class="service-mobile-records__empty">No services found. Tap the + button to add a new service.</div>
                        }
                        else
                        {
                            @foreach (var service in PaginatedServices)
                            {
                                var serviceImage = BuildRecordImageUrl(service.ImagePath, service.ImageFileName);
                                <article class="service-mobile-record @(SelectedService == service && !IsServiceDeleteMode ? "is-selected" : string.Empty)"
                                         @onclick="() => HandleMobileServiceCardClick(service)">
                                    <div class="service-mobile-record__header">
                                        @if (IsServiceDeleteMode)
                                        {
                                            <label class="service-mobile-record__select" @onclick:stopPropagation="true">
                                                <input type="checkbox"
                                                       aria-label="Select @service.ServiceName"
                                                       checked="@SelectedServicesForDeletion.Contains(service)"
                                                       @onchange="() => ToggleServiceForDeletion(service)" />
                                            </label>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(serviceImage))
                                        {
                                            <img class="service-mobile-record__image" src="@serviceImage" alt="@service.ServiceName" />
                                        }
                                        else
                                        {
                                            <div class="service-mobile-record__icon" aria-hidden="true"><i class="bi bi-scissors"></i></div>
                                        }
                                        <div class="service-mobile-record__identity">
                                            <h3>@service.ServiceName</h3>
                                            <p>@service.Category</p>
                                        </div>
                                    </div>
                                    <div class="service-mobile-record__facts">
                                        <div class="service-mobile-record__fact service-mobile-record__fact--wide">
                                            <span>Section</span>
                                            <strong>@service.Category</strong>
                                        </div>
                                        <div class="service-mobile-record__fact service-mobile-record__fact--wide">
                                            <span>@L["Price"]</span>
                                            <strong>MYR @service.Price.ToString("N2")</strong>
                                        </div>
                                    </div>
                                    @if (!IsServiceDeleteMode)
                                    {
                                        <div class="service-mobile-record__actions" @onclick:stopPropagation="true">
                                            <button type="button" class="services__action-btn services__action-btn--view" title="View details" aria-label="View service details" @onclick="() => ShowServiceDetails(service)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button type="button" class="services__action-btn services__action-btn--edit" title="@L["EditService"]" aria-label="@L["EditService"]" @onclick="() => EditService(service)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    }
                                </article>
                            }
                        }
                    </div>

                    <Pagination CurrentPage="@ServiceCurrentPage"
                                ItemsPerPage="5"
                                TotalItems="@FilteredServices.Count()"
                                OnPageChanged="@HandleServicePageChanged" />
                    <div class="pagination-summary">
                        @L["TotalItems"]: @FilteredServices.Count()
                    </div>
                }
                else
                {
                    <div class="senang-editor">
                        <div class="senang-editor__topbar">
                            <div class="senang-editor__heading">
                                <button type="button" class="senang-editor__back" @onclick="CloseAddServiceForm" title="Back">
                                    <i class="bi bi-arrow-left"></i>
                                </button>
                                <div>
                                    <h2>@(IsEditMode ? "Edit Service" : "Add Service")</h2>
                                    <span>Management</span>
                                </div>
                            </div>
                            <div class="senang-editor__actions">
                                <button type="button" class="senang-editor__cancel" @onclick="CloseAddServiceForm" disabled="@IsSavingService">Cancel</button>
                                <button type="button" class="senang-editor__save" @onclick="HandleSaveService" disabled="@IsSavingService">
                                    @(IsSavingService ? "Saving..." : "Save")
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ServiceApiError))
                        {
                            <div class="services__api-message services__api-message--error">@ServiceApiError</div>
                        }

                        <div class="senang-editor__content">
                            <div class="senang-editor__identity">
                                <div class="senang-editor__image-placeholder">
                                    <i class="bi bi-scissors"></i>
                                    <span>Service</span>
                                </div>
                            </div>

                            <div class="senang-editor__tabs">
                                <button type="button"
                                        class="@(ServiceEditorTab == "Info" ? "active" : string.Empty)"
                                        @onclick='() => ServiceEditorTab = "Info"'>
                                    Info
                                </button>
                                <button type="button"
                                        class="@(ServiceEditorTab == "Advance" ? "active" : string.Empty)"
                                        @onclick='() => ServiceEditorTab = "Advance"'>
                                    Advance
                                </button>
                            </div>

                            <div class="senang-editor__panel">
                                @if (ServiceEditorTab == "Info")
                                {
                                    <div class="senang-editor__form-grid">
                                        <div class="senang-editor__field senang-editor__field--code">
                                            <label>Item Code <span>*</span></label>
                                            <input type="text" @bind="NewServiceSKU" placeholder="Display / item code" />
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Service Name <span>*</span></label>
                                            <input type="text" @bind="NewServiceName" placeholder="Enter service name" />
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Section <span>*</span></label>
                                            <select @bind="NewServiceCategory">
                                                <option value="">Select Section</option>
                                                <option value="Facial">Facial</option>
                                                <option value="Body">Body</option>
                                                <option value="Hair">Hair</option>
                                                <option value="Massage">Massage</option>
                                                <option value="Spa">Spa</option>
                                            </select>
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Status</label>
                                            <select @bind="NewServiceIsActive">
                                                <option value="true">Active</option>
                                                <option value="false">Inactive</option>
                                            </select>
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Tax Code</label>
                                            <select @bind="NewServiceTaxCode">
                                                <option value="">Select Tax Code</option>
                                                <option value="SV-6">SV-6</option>
                                                <option value="SST-8">SST-8</option>
                                                <option value="GST-6">GST-6</option>
                                                <option value="NA">NA</option>
                                            </select>
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Price Inclusive Tax</label>
                                            <select @bind="NewServiceTaxInclusive">
                                                <option value="true">Yes</option>
                                                <option value="false">No</option>
                                            </select>
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Price (MYR)</label>
                                            <input type="number" step="0.01" min="0" @bind="NewServicePrice" />
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Cost (MYR)</label>
                                            <input type="number" step="0.01" min="0" @bind="NewServiceCost" />
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="senang-editor__form-grid">
                                        <div class="senang-editor__field">
                                            <label>Barcode</label>
                                            <div class="senang-editor__icon-input">
                                                <input type="text" @bind="NewServiceBarcode" placeholder="Scan or type barcode" />
                                                <i class="bi bi-upc-scan"></i>
                                            </div>
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>UOM</label>
                                            <select @bind="NewServiceUom">
                                                <option value="unit">unit</option>
                                                <option value="pcs">pcs</option>
                                                <option value="set">set</option>
                                                <option value="box">box</option>
                                                <option value="kg">kg</option>
                                                <option value="litre">litre</option>
                                                <option value="hour">hour</option>
                                                <option value="session">session</option>
                                            </select>
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Duration (Minutes) <span>*</span></label>
                                            <input type="number" min="0" @bind="NewServiceDuration" />
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Buffer Time (Minutes) <span>*</span></label>
                                            <input type="number" min="0" @bind="NewServiceBufferTime" />
                                        </div>
                                        <div class="senang-editor__field senang-editor__field--full">
                                            <label>Description</label>
                                            <textarea rows="3" @bind="NewServiceDescription" placeholder="Sales description"></textarea>
                                        </div>
                                        <div class="senang-editor__field senang-editor__field--full">
                                            <label>Add To Package List</label>
                                            <div class="senang-editor__toggle-row">
                                                <label class="service-form__toggle">
                                                    <input type="checkbox" @bind="NewServiceAddToBundle" />
                                                    <span class="service-form__toggle-slider"></span>
                                                </label>
                                                <div>
                                                    <strong>@(NewServiceAddToBundle ? "Available for packages" : "Not available for packages")</strong>
                                                    <small>Only enabled services can be selected in the Package Items tab.</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (ActiveTab == "MemberCredit")
        {
            <div class="services__section services__section--member-credit">
                <div class="services__toolbar">
                    <div class="services__toolbar-primary">
                        <div class="services__action-buttons">
                            <button class="services__action-btn" title="@L["AddMemberCredit"]" @onclick="ShowAddMemberCreditForm">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            <button class="btn-delete" title="@L["DeleteMemberCredits"]" @onclick="ToggleMemberCreditDeleteMode">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                        <div class="services__search-container">
                            <input class="services__search"
                                   type="search"
                                   placeholder="@L["Search"]..."
                                   value="@MemberCreditSearchQuery"
                                   @oninput="OnMemberCreditSearchChanged" />
                            <i class="bi bi-search services__search-icon"></i>
                        </div>
                    </div>
                    <AdvancedInventoryFilter Columns="@MemberCreditFilterColumns"
                                             OnApply="@HandleMemberCreditFiltersApplied"
                                             OnClear="@HandleMemberCreditFiltersCleared"
                                             ModuleName="Member Credit"
                                             ContextLabel="Services"
                                             ResultCount="@FilteredMemberCredits.Count()" />
                </div>


                @if (IsMemberCreditDeleteMode)
                {
                    <div class="services__delete-bar">
                        <button type="button" class="selected-delete-banner-close" @onclick="CancelMemberCreditDeleteMode" title="Cancel delete mode">
                            <i class="bi bi-x-lg"></i>
                        </button>
                        <div class="services__delete-info">
                            <span>@SelectedMemberCreditsForDeletion.Count @L["ItemsSelected"]</span>
                        </div>
                        <div class="services__delete-actions">
                            <button class="services__btn services__btn--secondary" @onclick="CancelMemberCreditDeleteMode">
                                @L["Cancel"]
                            </button>
                            <button class="services__btn services__btn--danger" @onclick='() => RequestSelectedDeleteConfirmation("memberCredits", SelectedMemberCreditsForDeletion.Count, "member credit(s)")' disabled="@(!SelectedMemberCreditsForDeletion.Any())">
                                @L["DeleteSelected"]
                            </button>
                        </div>
                    </div>
                }

                <div class="services__table-wrapper desktop-view">
                    <table class="services__table">
                        <thead>
                            <tr>
                                @if (IsMemberCreditDeleteMode)
                                {
                                    <th class="services__checkbox-col">
                                        <input type="checkbox" @onchange="ToggleSelectAllMemberCredits" checked="@IsAllMemberCreditsSelected" />
                                    </th>
                                }
                                <th class='@GetServiceSortHeaderClass(MemberCreditSortColumn, MemberCreditSortAscending, "Name")' @onclick='() => ToggleMemberCreditSort("Name")'>
                                    @L["CreditName"]
                                </th>
                                <th class='@GetServiceSortHeaderClass(MemberCreditSortColumn, MemberCreditSortAscending, "Code")' @onclick='() => ToggleMemberCreditSort("Code")'>
                                    @L["CreditCode"]
                                </th>
                                <th class='@GetServiceSortHeaderClass(MemberCreditSortColumn, MemberCreditSortAscending, "CreditValue")' @onclick='() => ToggleMemberCreditSort("CreditValue")'>
                                    @L["CreditValueMyr"]
                                </th>
                                <th class='@GetServiceSortHeaderClass(MemberCreditSortColumn, MemberCreditSortAscending, "Price")' @onclick='() => ToggleMemberCreditSort("Price")'>
                                    @L["PriceMyr"]
                                </th>
                                <th class="services__actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var memberCredit in PaginatedMemberCredits)
                            {
                                var isSelected = SelectedMemberCredit == memberCredit && !IsMemberCreditDeleteMode;
                                <tr class="@(isSelected ? "selected" : string.Empty)" @onclick="() => ToggleMobileMemberCreditRow(memberCredit)">
                                    @if (IsMemberCreditDeleteMode)
                                    {
                                        <td class="services__checkbox-col" @onclick:stopPropagation="true">
                                            <input type="checkbox" checked="@SelectedMemberCreditsForDeletion.Contains(memberCredit)" @onchange="() => ToggleMemberCreditSelection(memberCredit)" />
                                        </td>
                                    }
                                    <td>@memberCredit.Name</td>
                                    <td>@memberCredit.Code</td>
                                    <td class="services-money-value">@memberCredit.CreditValue.ToString("N2")</td>
                                    <td class="services-money-value">@memberCredit.Price.ToString("N2")</td>
                                    <td class="services__actions-col" @onclick:stopPropagation="true">
                                        <div class="services__row-actions">
                                            <button type="button" class="services__action-btn services__action-btn--view" title="View details" @onclick="() => ShowMemberCreditDetails(memberCredit)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button type="button" class="services__action-btn services__action-btn--edit" title="@L["EditMemberCredit"]" @onclick="() => EditMemberCredit(memberCredit)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="service-mobile-records mobile-view">
                    @if (!PaginatedMemberCredits.Any())
                    {
                        <div class="service-mobile-records__empty">No member credits found. Tap the + button to add one.</div>
                    }
                    else
                    {
                        @foreach (var memberCredit in PaginatedMemberCredits)
                        {
                            <article class="service-mobile-record @(SelectedMemberCredit == memberCredit && !IsMemberCreditDeleteMode ? "is-selected" : string.Empty)"
                                     @onclick="() => HandleMobileMemberCreditCardClick(memberCredit)">
                                <div class="service-mobile-record__header">
                                    @if (IsMemberCreditDeleteMode)
                                    {
                                        <label class="service-mobile-record__select" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   aria-label="Select @memberCredit.Name"
                                                   checked="@SelectedMemberCreditsForDeletion.Contains(memberCredit)"
                                                   @onchange="() => ToggleMemberCreditSelection(memberCredit)" />
                                        </label>
                                    }
                                    <div class="service-mobile-record__icon" aria-hidden="true">
                                        <i class="bi bi-credit-card"></i>
                                    </div>
                                    <div class="service-mobile-record__identity">
                                        <h3>@memberCredit.Name</h3>
                                        <p>Code: @memberCredit.Code</p>
                                    </div>
                                </div>
                                <div class="service-mobile-record__facts">
                                    <div class="service-mobile-record__fact">
                                        <span>@L["CreditValueMyr"]</span>
                                        <strong>MYR @memberCredit.CreditValue.ToString("N2")</strong>
                                    </div>
                                    <div class="service-mobile-record__fact">
                                        <span>@L["PriceMyr"]</span>
                                        <strong>MYR @memberCredit.Price.ToString("N2")</strong>
                                    </div>
                                </div>
                                @if (!IsMemberCreditDeleteMode)
                                {
                                    <div class="service-mobile-record__actions" @onclick:stopPropagation="true">
                                        <button type="button" class="services__action-btn services__action-btn--view" title="View details" aria-label="View member credit details" @onclick="() => ShowMemberCreditDetails(memberCredit)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="services__action-btn services__action-btn--edit" title="@L["EditMemberCredit"]" aria-label="@L["EditMemberCredit"]" @onclick="() => EditMemberCredit(memberCredit)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </div>
                                }
                            </article>
                        }
                    }
                </div>

                <Pagination CurrentPage="@MemberCreditCurrentPage"
                            ItemsPerPage="5"
                            TotalItems="@FilteredMemberCredits.Count()"
                            OnPageChanged="@HandleMemberCreditPageChanged" />
                <div class="pagination-summary">
                    @L["TotalItems"]: @FilteredMemberCredits.Count()
                </div>

            </div>

            @if (IsAddMemberCreditFormVisible)
            {
                <div class="member-credit-modal-overlay" @onclick="CloseAddMemberCreditForm">
                    <div class="member-credit-modal" @onclick:stopPropagation="true">
                        <div class="member-credit-modal__header">
                            <div class="member-credit-modal__title">
                                <i class="bi bi-credit-card"></i>
                                <h2>@L["CreditSetup"]</h2>
                            </div>
                            <div class="member-credit-modal__actions">
                                <button class="member-credit-modal__btn member-credit-modal__btn--save"
                                        disabled="@IsSavingMemberCredit"
                                        @onclick="HandleAddMemberCredit">
                                    @(IsSavingMemberCredit ? "Saving..." : L["Save"])
                                </button>
                                <button class="member-credit-modal__btn member-credit-modal__btn--cancel" @onclick="CloseAddMemberCreditForm">
                                    @L["Cancel"]
                                </button>
                            </div>
                        </div>
                        <div class="member-credit-modal__body">
                            <form class="member-credit-form" @onsubmit:preventDefault>
                                <div class="member-credit-form__field">
                                    <label>@L["CreditName"]</label>
                                    <input type="text" @bind="NewMemberCreditName" placeholder="@L["EnterCreditName"]" required />
                                </div>

                                <div class="member-credit-form__field">
                                    <label>@L["CreditCode"]</label>
                                    <input type="text" @bind="NewMemberCreditCode" placeholder="@L["EnterCreditCode"]" required />
                                </div>

                                <div class="member-credit-form__field">
                                    <label>@L["ValueOfCreditRm"]</label>
                                    <input type="number" step="0.01" @bind="NewMemberCreditValue" placeholder="0.00" required />
                                </div>

                                <div class="member-credit-form__field">
                                    <label>@L["PriceForThisCreditRm"]</label>
                                    <input type="number" step="0.01" @bind="NewMemberCreditPrice" placeholder="0.00" required />
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else if (ActiveTab == "Membership")
        {
            <div class="membership-options">
                <div class="membership-options__grid">
                    <!-- Member Type Section -->
                    <div class="membership-options__card membership-options__card--member-type">
                        <div class="membership-options__card-header">
                            <h3>@L["MemberType"]</h3>
                            <div class="membership-options__header-actions">
                                <button class="services__action-btn" @onclick="ShowAddMemberTypeForm">
                                    <i class="bi bi-plus-lg"></i>
                                </button>

                                <button class="btn-delete" @onclick="ToggleMemberTypeDeleteMode" title="@L["DeleteMemberTypes"]">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                        <div class="membership-options__card-body">
                            @if (IsMemberTypeApiLoading)
                            {
                                <div class="services__api-message services__api-message--loading">
                                    Loading member types...
                                </div>
                            }

                            @if (IsMemberTypeDeleteMode)
                            {
                                <div class="membership-options__delete-bar">
                                    <button type="button" class="selected-delete-banner-close" @onclick="CancelMemberTypeDeleteMode" title="Cancel delete mode">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <div class="membership-options__delete-info">
                                        <span>@SelectedMemberTypesForDeletion.Count @L["ItemsSelected"]</span>
                                    </div>
                                    <div class="membership-options__delete-actions">
                                        <button class="membership-options__btn membership-options__btn--secondary" @onclick="CancelMemberTypeDeleteMode">
                                            @L["Cancel"]
                                        </button>
                                        <button class="membership-options__btn membership-options__btn--danger" @onclick='() => RequestSelectedDeleteConfirmation("memberTypes", SelectedMemberTypesForDeletion.Count, "member type(s)")' disabled="@(!SelectedMemberTypesForDeletion.Any())">
                                            @L["DeleteSelected"]
                                        </button>
                                    </div>
                                </div>
                            }
                            <div class="member-type-search">
                                <input type="text" placeholder="@L["Search"]..." value="@MemberTypeSearch" @oninput="(ChangeEventArgs e) => { MemberTypeSearch = e.Value?.ToString() ?? string.Empty; MemberTypeCurrentPage = 1; }" />
                            </div>
                            <div class="membership-options__table-region">
                                <table class="member-type-table">
                                    <thead>
                                        <tr>
                                            @if (IsMemberTypeDeleteMode)
                                            {
                                                <th class="member-type-table__checkbox-col">
                                                    <input type="checkbox" @onchange="ToggleSelectAllMemberTypes" checked="@IsAllMemberTypesSelected" />
                                                </th>
                                            }
                                            <th class='member-type-table__code @GetServiceSortHeaderClass(MemberTypeSortColumn, MemberTypeSortAscending, "Code")' @onclick='() => ToggleMemberTypeSort("Code")'>
                                                Code
                                            </th>
                                            <th class='member-type-table__name @GetServiceSortHeaderClass(MemberTypeSortColumn, MemberTypeSortAscending, "Name")' @onclick='() => ToggleMemberTypeSort("Name")'>
                                                @L["MemberType"]
                                            </th>
                                            <th class='member-type-table__status @GetServiceSortHeaderClass(MemberTypeSortColumn, MemberTypeSortAscending, "Status")' @onclick='() => ToggleMemberTypeSort("Status")'>
                                                Status
                                            </th>
                                            <th class="member-type-table__actions">@L["Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var memberType in PaginatedMemberTypes)
                                        {
                                            <tr class="@(SelectedMemberType == memberType ? "selected" : "")" @onclick="() => HandleMemberTypeRowClick(memberType)">
                                                @if (IsMemberTypeDeleteMode)
                                                {
                                                    <td class="member-type-table__checkbox-col" @onclick:stopPropagation="true">
                                                        <input type="checkbox" checked="@SelectedMemberTypesForDeletion.Contains(memberType)" @onchange="() => ToggleMemberTypeSelection(memberType)" />
                                                    </td>
                                                }
                                                <td class="member-type-table__code">@memberType.MemberTypeID</td>
                                                <td class="member-type-table__name">@memberType.MemberTypeName</td>
                                                <td class="member-type-table__status">
                                                    <span class="service-status-indicator service-status-indicator--@(memberType.Active ? "success" : "danger")">
                                                        @(memberType.Active ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="member-type-table__actions" @onclick:stopPropagation="true">
                                                    <div class="membership-options__row-actions">
                                                        <button type="button" class="membership-options__view-btn membership-options__view-btn--icon" title="@L["EditMemberType"]" aria-label="@L["EditMemberType"]" @onclick="() => EditMemberTypeFromRow(memberType)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <Pagination CurrentPage="@MemberTypeCurrentPage"
                                         ItemsPerPage="5"
                                         TotalItems="@FilteredMemberTypes.Count()"
                                         OnPageChanged="@HandleMemberTypePageChanged" />
                            <div class="pagination-summary">
                                @L["TotalItems"]: @FilteredMemberTypes.Count()
                            </div>
                        </div>
                    </div>
                    <!-- Member Point Section -->
                    <div class="membership-options__card membership-options__card--member-point">
                        <div class="membership-options__card-header">
                            <div class="point-rule-heading">
                                <h3>@L["MemberPoint"]</h3>
                                <p>Configure how each membership type earns points.</p>
                            </div>
                            <div class="membership-options__header-actions">
                                <button class="services__action-btn" @onclick="ShowAddMemberPointForm">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                                <button class="btn-delete" @onclick="ToggleMemberPointDeleteMode" title="@L["DeleteMemberPoints"]">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                        <div class="membership-options__card-body">
                            @if (IsMemberPointApiLoading)
                            {
                                <div class="services__api-message services__api-message--loading">
                                    Loading member point rules...
                                </div>
                            }

                            @if (IsMemberPointDeleteMode)
                            {
                                <div class="membership-options__delete-bar">
                                    <button type="button" class="selected-delete-banner-close" @onclick="CancelMemberPointDeleteMode" title="Cancel delete mode">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <div class="membership-options__delete-info">
                                        <span>@SelectedMemberPointsForDeletion.Count @L["ItemsSelected"]</span>
                                    </div>
                                    <div class="membership-options__delete-actions">
                                        <button class="membership-options__btn membership-options__btn--secondary" @onclick="CancelMemberPointDeleteMode">
                                            @L["Cancel"]
                                        </button>
                                        <button class="membership-options__btn membership-options__btn--danger"
                                                disabled="@(!SelectedMemberPointsForDeletion.Any())"
                                                @onclick='() => RequestSelectedDeleteConfirmation("memberPoints", SelectedMemberPointsForDeletion.Count, "member point(s)")'>
                                            @L["DeleteSelected"]
                                        </button>
                                    </div>
                                </div>
                            }

                            <div class="membership-options__search">
                                <input type="text" placeholder="Search member type or point rule..." value="@MemberPointSearch" @oninput="(ChangeEventArgs e) => { MemberPointSearch = e.Value?.ToString() ?? string.Empty; MemberPointCurrentPage = 1; }" />
                            </div>
                            <div class="membership-options__table-region">
                            <table class="membership-options__table membership-options__table--member-point">
                                <thead>
                                    <tr>
                                        @if (IsMemberPointDeleteMode)
                                        {
                                            <th class="membership-options__checkbox-col">
                                                <input type="checkbox" @onchange="ToggleSelectAllMemberPoints" checked="@IsAllMemberPointsSelected" />
                                            </th>
                                        }
                                        <th class='point-rule-member @GetServiceSortHeaderClass(MemberPointSortColumn, MemberPointSortAscending, "MemberType")' @onclick='() => ToggleMemberPointSort("MemberType")'>
                                            @L["MemberType"]
                                        </th>
                                        <th class='point-rule-amount @GetServiceSortHeaderClass(MemberPointSortColumn, MemberPointSortAscending, "ForEveryAmount")' @onclick='() => ToggleMemberPointSort("ForEveryAmount")'>For Every (MYR)</th>
                                        <th class='point-rule-points @GetServiceSortHeaderClass(MemberPointSortColumn, MemberPointSortAscending, "EqualToPoint")' @onclick='() => ToggleMemberPointSort("EqualToPoint")'>Earned Points</th>
                                        <th class='point-rule-round @GetServiceSortHeaderClass(MemberPointSortColumn, MemberPointSortAscending, "RoundDown")' @onclick='() => ToggleMemberPointSort("RoundDown")'>Round Down</th>
                                        <th class='point-rule-date @GetServiceSortHeaderClass(MemberPointSortColumn, MemberPointSortAscending, "StartDate")' @onclick='() => ToggleMemberPointSort("StartDate")'>Start Date</th>
                                        <th class='point-rule-date @GetServiceSortHeaderClass(MemberPointSortColumn, MemberPointSortAscending, "EndDate")' @onclick='() => ToggleMemberPointSort("EndDate")'>End Date</th>
                                        <th class="member-point-actions-col">@L["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var memberPoint in PaginatedMemberPoints)
                                    {
                                        <tr class="point-rule-row @(SelectedMemberPointsForDeletion.Contains(memberPoint) ? "selected" : "")"
                                            @onclick="() => HandleMemberPointRowClick(memberPoint)">
                                            @if (IsMemberPointDeleteMode)
                                            {
                                                <td class="membership-options__checkbox-col" @onclick:stopPropagation="true">
                                                    <input type="checkbox"
                                                           checked="@SelectedMemberPointsForDeletion.Contains(memberPoint)"
                                                           @onchange="() => ToggleMemberPointSelection(memberPoint)" />
                                                </td>
                                            }
                                            <td class="point-rule-member">
                                                <strong>@memberPoint.MemberType</strong>
                                                <small>@memberPoint.MemberTypeId</small>
                                            </td>
                                            <td class="point-rule-amount">MYR @memberPoint.ForEveryAmount.ToString("N2")</td>
                                            <td class="point-rule-points">@memberPoint.EqualToPoint.ToString("0.##")</td>
                                            <td class="point-rule-round">
                                                <span class="point-rule-toggle @(memberPoint.RoundDownToInteger ? "point-rule-toggle--on" : "point-rule-toggle--off")">
                                                    <i class="bi @(memberPoint.RoundDownToInteger ? "bi-check-circle-fill" : "bi-dash-circle")"></i>
                                                    @(memberPoint.RoundDownToInteger ? "Yes" : "No")
                                                </span>
                                            </td>
                                            <td class="point-rule-date">@memberPoint.StartDate?.ToString("dd/MM/yyyy")</td>
                                            <td class="point-rule-date">@memberPoint.EndDate?.ToString("dd/MM/yyyy")</td>
                                            <td class="member-point-actions-col" @onclick:stopPropagation="true">
                                                <div class="membership-options__row-actions member-point-row-actions">
                                                    <button type="button" class="membership-options__view-btn membership-options__view-btn--icon" title="Edit member point" aria-label="Edit member point" @onclick="() => EditMemberPointFromRow(memberPoint)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    @if (!PaginatedMemberPoints.Any())
                                    {
                                        <tr class="point-rule-empty-row">
                                            <td colspan="@(IsMemberPointDeleteMode ? 8 : 7)">No point rules found.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                            <Pagination CurrentPage="@MemberPointCurrentPage"
                                        ItemsPerPage="5"
                                        TotalItems="@FilteredMemberPoints.Count()"
                                        OnPageChanged="@HandleMemberPointPageChanged" />
                            <div class="pagination-summary">
                                Total items: @FilteredMemberPoints.Count()
                            </div>
                        </div>
                    </div>
                </div>

                @* Add Member Type Modal *@
                @if (IsAddMemberTypeFormVisible)
                {
                    <div class="member-type-modal-overlay" @onclick="CloseAddMemberTypeForm">
                        <div class="member-type-modal member-type-modal--compact" @onclick:stopPropagation="true">
                            <div class="member-type-modal__header">
                                <div class="member-type-modal__title">
                                    <i class="bi bi-person-badge"></i>
                                    <h2>@(IsMemberTypeEditMode ? "Edit Member Type" : "Add Member Type")</h2>
                                </div>
                                <div class="member-type-modal__actions">
                                    <button type="button" class="member-type-modal__btn member-type-modal__btn--save" disabled="@IsSavingMemberType" @onclick="HandleAddMemberType">
                                        @(IsSavingMemberType ? "Saving..." : L["Save"])
                                    </button>
                                    <button type="button" class="member-type-modal__btn member-type-modal__btn--cancel" @onclick="CloseAddMemberTypeForm">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                            <div class="member-type-modal__body">
                                <form class="member-type-form member-type-form--compact" @onsubmit:preventDefault>
                                    <div class="member-type-form__compact-grid">
                                        <div class="member-type-form__group">
                                            <label for="memberTypeCode">Code <span class="member-type-form__required">*</span></label>
                                            <input id="memberTypeCode"
                                                   type="text"
                                                   @bind="NewMemberTypeCode"
                                                   autocomplete="off"
                                                   required />
                                        </div>

                                        <div class="member-type-form__group">
                                            <label for="memberTypeName">Member Type <span class="member-type-form__required">*</span></label>
                                            <input id="memberTypeName"
                                                   type="text"
                                                   @bind="NewMemberTypeName"
                                                   autocomplete="off"
                                                   required />
                                        </div>
                                    </div>

                                    <label class="member-type-form__status-control" for="memberTypeActive">
                                        <input id="memberTypeActive" type="checkbox" @bind="NewMemberTypeActive" />
                                        <span class="member-type-form__status-copy">
                                            <strong>Active</strong>
                                            <small>Allow staff to use this membership type.</small>
                                        </span>
                                    </label>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                @* Add Member Point Modal *@
                @if (IsAddMemberPointFormVisible)
                {
                    <div class="member-point-modal-overlay" @onclick="CloseAddMemberPointForm">
                        <div class="member-point-modal" @onclick:stopPropagation="true">
                            <div class="member-point-modal__header">
                                <div class="member-point-modal__title">
                                    <i class="bi bi-star"></i>
                                    <div>
                                        <h2>Point Setup</h2>
                                    </div>
                                </div>
                                <div class="member-point-modal__actions">
                                    <button class="member-point-modal__btn member-point-modal__btn--save"
                                            disabled="@IsSavingMemberPoint"
                                            @onclick="HandleAddMemberPoint">
                                        @(IsSavingMemberPoint ? "Saving..." : "Save")
                                    </button>
                                    <button class="member-point-modal__btn member-point-modal__btn--cancel" @onclick="CloseAddMemberPointForm">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                            <div class="member-point-modal__body">

                                @if (!string.IsNullOrWhiteSpace(MemberPointApiError))
                                {
                                    <div class="point-setup-error" role="alert">@MemberPointApiError</div>
                                }

                                <form class="member-point-form point-setup-form" @onsubmit:preventDefault>
                                    <fieldset class="point-setup-section point-setup-section--first">
                                        <legend>Earning</legend>

                                        <div class="point-setup-field point-setup-field--wide">
                                            <label for="pointMemberType">Member Type <span>*</span></label>
                                            <select id="pointMemberType" @bind="NewMemberPointMemberType" required>
                                                <option value="">Select member type</option>
                                                @foreach (var memberType in MemberTypeItems.Where(item => item.Active))
                                                {
                                                    <option value="@memberType.MemberTypeID">@memberType.MemberTypeName (@memberType.MemberTypeID)</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="point-setup-grid point-setup-grid--three">
                                            <div class="point-setup-field">
                                                <label for="pointMinimumSpend">Minimum Spend</label>
                                                <div class="point-setup-input-prefix"><span>MYR</span><input id="pointMinimumSpend" type="number" min="0" step="0.01" @bind="NewMemberPointMinAmount" /></div>
                                            </div>
                                            <div class="point-setup-field">
                                                <label for="pointForEvery">Spend Amount <span>*</span></label>
                                                <div class="point-setup-input-prefix"><span>MYR</span><input id="pointForEvery" type="number" min="0.01" step="0.01" @bind="NewMemberPointForEveryAmount" required /></div>
                                            </div>
                                            <div class="point-setup-field">
                                                <label for="pointEarned">Points Earned <span>*</span></label>
                                                <input id="pointEarned" type="number" min="0.01" step="0.01" @bind="NewMemberPointEqualToPoint" required />
                                            </div>
                                        </div>

                                        <div class="point-setup-toggle-grid">
                                            <label class="point-setup-toggle" for="excludeTaxCheckbox">
                                                <input type="checkbox" id="excludeTaxCheckbox" @bind="NewMemberPointExcludeTax" />
                                                <span><strong>Exclude Tax</strong></span>
                                            </label>
                                            <label class="point-setup-toggle" for="pointRoundDownCheckbox">
                                                <input type="checkbox" id="pointRoundDownCheckbox" @bind="NewMemberPointRoundDown" />
                                                <span><strong>Round Down Points</strong></span>
                                            </label>
                                        </div>
                                    </fieldset>

                                    <fieldset class="point-setup-section">
                                        <legend>Validity</legend>
                                        <div class="point-setup-grid">
                                            <div class="point-setup-field">
                                                <label for="pointStartDate">Valid From <span>*</span></label>
                                                <input id="pointStartDate" type="date" @bind="NewMemberPointStartDate" required />
                                            </div>
                                            <div class="point-setup-field">
                                                <label for="pointEndDate">Valid Until <span>*</span></label>
                                                <input id="pointEndDate" type="date" @bind="NewMemberPointEndDate" required />
                                            </div>
                                        </div>
                                        <div class="point-setup-grid point-setup-grid--three">
                                            <div class="point-setup-field">
                                                <label for="pointExpiryOption">Expiry</label>
                                                <select id="pointExpiryOption" @bind="NewMemberPointExpiryOption">
                                                    <option value="0">No Expiry</option>
                                                    <option value="1">Months After Earning</option>
                                                    <option value="2">Fixed Expiry Month</option>
                                                </select>
                                            </div>
                                            @if (NewMemberPointExpiryOption != "0")
                                            {
                                                <div class="point-setup-field">
                                                    <label for="pointExpiryMonth">@(NewMemberPointExpiryOption == "1" ? "Valid Months" : "Expiry Month")</label>
                                                    <input id="pointExpiryMonth" type="number" min="0" step="1" @bind="NewMemberPointExpiryMonth" />
                                                </div>
                                            }
                                            <div class="point-setup-field">
                                                <label for="pointConversionRate">MYR per Point</label>
                                                <input id="pointConversionRate" type="number" min="0" step="0.0001" @bind="NewMemberPointMoneyConversion" />
                                            </div>
                                        </div>

                                        <label class="point-setup-toggle" for="convertVoucherCheckbox">
                                            <input type="checkbox" id="convertVoucherCheckbox" @bind="NewMemberPointConvertVoucher" />
                                            <span><strong>Convert to Cash Voucher</strong></span>
                                        </label>
                                    </fieldset>

                                    <fieldset class="point-setup-section">
                                        <legend>Branches</legend>
                                        <div class="point-setup-section__title-row">
                                            @if (BranchSession.AvailableBranches.Count > 0)
                                            {
                                                <label class="point-setup-select-all">
                                                    <input type="checkbox" checked="@AreAllMemberPointBranchesSelected" @onchange="ToggleAllMemberPointBranches" />
                                                    All Branches
                                                </label>
                                            }
                                        </div>
                                        <div class="point-setup-branch-list">
                                            @if (BranchSession.AvailableBranches.Count == 0)
                                            {
                                                <p class="point-setup-branch-empty">No branches are available.</p>
                                            }
                                            else
                                            {
                                                @foreach (var branch in BranchSession.AvailableBranches)
                                                {
                                                    <label class="point-setup-branch" for="pointBranch_@branch.Id">
                                                        <input id="pointBranch_@branch.Id"
                                                               type="checkbox"
                                                               checked="@IsMemberPointBranchSelected(branch.Id)"
                                                               @onchange="e => ToggleMemberPointBranch(branch.Id, e)" />
                                                        <span><strong>@branch.Id</strong><small>@branch.Name</small></span>
                                                    </label>
                                                }
                                            }
                                        </div>
                                    </fieldset>

                                </form>
                            </div>
                        </div>
                    </div>
                }

                @* View Member Point Details Modal *@
                @if (IsViewMemberPointDetailsVisible && ViewingMemberPoint != null)
                {
                    <div class="member-point-view-modal-overlay" @onclick="CloseViewMemberPointDetails">
                        <div class="member-point-view-modal" @onclick:stopPropagation="true">
                            <div class="member-point-view-modal__header">
                                <div class="member-point-view-modal__title">
                                    <div class="member-point-view-modal__icon-wrapper">
                                        <i class="bi bi-stars"></i>
                                    </div>
                                    <div>
                                        <h2>Point Setup Details</h2>
                                        <p class="member-point-view-modal__subtitle">View member point configuration</p>
                                    </div>
                                </div>
                                <button class="member-point-view-modal__close" @onclick="CloseViewMemberPointDetails">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="member-point-view-modal__body">
                                <div class="member-point-view-details">
                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon">
                                            <i class="bi bi-person-badge"></i>
                                        </div>
                                        <div class="member-point-view-details__content">
                                            <label class="member-point-view-details__label">Member Type</label>
                                            <span class="member-point-view-details__value">@ViewingMemberPoint.MemberType</span>
                                        </div>
                                    </div>

                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon">
                                            <i class="bi bi-currency-dollar"></i>
                                        </div>
                                        <div class="member-point-view-details__content">
                                            <label class="member-point-view-details__label">Minimum Amount Spent</label>
                                            <span class="member-point-view-details__value">MYR @ViewingMemberPoint.MinAmount.ToString("N2")</span>
                                        </div>
                                    </div>

                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon">
                                            <i class="bi bi-cash-coin"></i>
                                        </div>
                                        <div class="member-point-view-details__content">
                                            <label class="member-point-view-details__label">For Every X Amount</label>
                                            <span class="member-point-view-details__value">MYR @ViewingMemberPoint.ForEveryAmount.ToString("N2")</span>
                                        </div>
                                    </div>

                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon">
                                            <i class="bi bi-star-fill"></i>
                                        </div>
                                        <div class="member-point-view-details__content">
                                            <label class="member-point-view-details__label">Equal to X Point</label>
                                            <span class="member-point-view-details__value">@ViewingMemberPoint.EqualToPoint points</span>
                                        </div>
                                    </div>

                                    <div class="member-point-view-details__card member-point-view-details__card--highlight">
                                        <div class="member-point-view-details__icon member-point-view-details__icon--highlight">
                                            <i class="bi bi-clock-history"></i>
                                        </div>
                                        <div class="member-point-view-details__content">
                                            <label class="member-point-view-details__label">Expiry Option</label>
                                            <span class="member-point-view-details__value member-point-view-details__value--highlight">
                                                @(ViewingMemberPoint.ExpiryOption == "NA" ? "No Expiry" : ViewingMemberPoint.ExpiryOption)
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon"><i class="bi bi-arrow-left-right"></i></div>
                                        <div class="member-point-view-details__content"><label class="member-point-view-details__label">Money Conversion Rate</label><span class="member-point-view-details__value">@ViewingMemberPoint.MoneyConversionRate.ToString("N4")</span></div>
                                    </div>
                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon"><i class="bi bi-calendar-range"></i></div>
                                        <div class="member-point-view-details__content"><label class="member-point-view-details__label">Effective Date</label><span class="member-point-view-details__value">@FormatPointDateRange(ViewingMemberPoint.StartDate, ViewingMemberPoint.EndDate)</span></div>
                                    </div>
                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon"><i class="bi bi-hourglass-split"></i></div>
                                        <div class="member-point-view-details__content"><label class="member-point-view-details__label">Expiry Month</label><span class="member-point-view-details__value">@ViewingMemberPoint.ExpiryMonth</span></div>
                                    </div>
                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon"><i class="bi bi-building"></i></div>
                                        <div class="member-point-view-details__content"><label class="member-point-view-details__label">Visible to Branch</label><span class="member-point-view-details__value">@FormatDisplay(ViewingMemberPoint.VisibleToBranchId)</span></div>
                                    </div>
                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon"><i class="bi bi-receipt"></i></div>
                                        <div class="member-point-view-details__content"><label class="member-point-view-details__label">Exclude Tax Amount</label><span class="member-point-view-details__value">@(ViewingMemberPoint.ExcludeTaxAmount ? "Yes" : "No")</span></div>
                                    </div>
                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon"><i class="bi bi-arrow-down-circle"></i></div>
                                        <div class="member-point-view-details__content"><label class="member-point-view-details__label">Round Down Points</label><span class="member-point-view-details__value">@(ViewingMemberPoint.RoundDownToInteger ? "Yes" : "No")</span></div>
                                    </div>
                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon"><i class="bi bi-ticket-perforated"></i></div>
                                        <div class="member-point-view-details__content"><label class="member-point-view-details__label">Convert to Voucher</label><span class="member-point-view-details__value">@(ViewingMemberPoint.ConvertToVoucher ? "Yes" : "No")</span></div>
                                    </div>
                                    <div class="member-point-view-details__card">
                                        <div class="member-point-view-details__icon"><i class="bi bi-key"></i></div>
                                        <div class="member-point-view-details__content"><label class="member-point-view-details__label">Point ID</label><span class="member-point-view-details__value">@FormatDisplay(ViewingMemberPoint.PointId)</span></div>
                                    </div>

                                    <div class="member-point-view-modal__actions">
                                    <button type="button" class="member-point-view-modal__btn member-point-view-modal__btn--edit" @onclick="EditMemberPointFromView">
                                        <i class="bi bi-pencil"></i>
                                        Edit Configuration
                                    </button>
                                    <button type="button" class="member-point-view-modal__btn member-point-view-modal__btn--close" @onclick="CloseViewMemberPointDetails">
                                        Close
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @* Add Member Credit Modal *@
                @if (IsAddMemberCreditFormVisible)
                {
                    <div class="member-credit-modal-overlay" @onclick="CloseAddMemberCreditForm">
                        <div class="member-credit-modal" @onclick:stopPropagation="true">
                            <div class="member-credit-modal__header">
                                <div class="member-credit-modal__title">
                                    <i class="bi bi-credit-card"></i>
                                    <h2>Credit Setup</h2>
                                </div>
                                <div class="member-credit-modal__actions">
                                    <button class="member-credit-modal__btn member-credit-modal__btn--save"
                                            disabled="@IsSavingMemberCredit"
                                            @onclick="HandleAddMemberCredit">
                                        @(IsSavingMemberCredit ? "Saving..." : "Save")
                                    </button>
                                    <button class="member-credit-modal__btn member-credit-modal__btn--cancel" @onclick="CloseAddMemberCreditForm">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                            <div class="member-credit-modal__body">
                                <form class="member-credit-form" @onsubmit:preventDefault>
                                    <div class="member-credit-form__field">
                                        <label>Name</label>
                                        <input type="text" @bind="NewMemberCreditName" placeholder="Enter credit name" required />
                                    </div>

                                    <div class="member-credit-form__field">
                                        <label>Code</label>
                                        <input type="text" @bind="NewMemberCreditCode" placeholder="Enter credit code" required />
                                    </div>

                                    <div class="member-credit-form__field">
                                        <label>Value of Credit (RM)</label>
                                        <input type="number" step="0.01" @bind="NewMemberCreditValue" placeholder="0.00" required />
                                    </div>

                                    <div class="member-credit-form__field">
                                        <label>Price for this Credit (RM)</label>
                                        <input type="number" step="0.01" @bind="NewMemberCreditPrice" placeholder="0.00" required />
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (ActiveTab == "Bundle")
        {
            <div class="services__section">
                @if (!IsAddBundleFormVisible)
                {
                    <div class="services__toolbar">
                        <div class="services__toolbar-primary">
                            <div class="services__action-buttons">
                                <button class="services__action-btn" title="@L["AddPackage"]" @onclick="ShowAddBundleForm">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                                <button class="btn-delete" title="@L["DeletePackages"]" @onclick="ToggleBundleDeleteMode">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                            <div class="services__search-container">
                                <input class="services__search"
                                       type="search"
                                       placeholder="@L["Search"]..."
                                       value="@BundleSearchQuery"
                                       @oninput="OnBundleSearchChanged" />
                                <i class="bi bi-search services__search-icon"></i>
                            </div>
                        </div>
                        <AdvancedInventoryFilter Columns="@BundleFilterColumns"
                                                 OnApply="@HandleBundleFiltersApplied"
                                                 OnClear="@HandleBundleFiltersCleared"
                                                 ModuleName="Packages"
                                                 ContextLabel="Services"
                                                 ResultCount="@FilteredBundles.Count()" />
                    </div>

                    @if (IsBundleApiLoading)
                    {
                        <div class="services__api-message services__api-message--loading">
                            Loading packages...
                        </div>
                    }

                    @if (IsBundleDeleteMode)
                    {
                        <div class="services__delete-bar">
                            <button type="button" class="selected-delete-banner-close" @onclick="CancelBundleDeleteMode" title="Cancel delete mode">
                                <i class="bi bi-x-lg"></i>
                            </button>
                            <div class="services__delete-info">
                                <span>@SelectedBundlesForDeletion.Count @L["ItemsSelected"]</span>
                            </div>
                            <div class="services__delete-actions">
                                <button class="services__btn services__btn--secondary" @onclick="CancelBundleDeleteMode">
                                    @L["Cancel"]
                                </button>
                                <button class="services__btn services__btn--danger"
                                        disabled="@(!SelectedBundlesForDeletion.Any())"
                                        @onclick='() => RequestSelectedDeleteConfirmation("bundles", SelectedBundlesForDeletion.Count, "package(s)")'>
                                    @L["DeleteSelected"]
                                </button>
                            </div>
                        </div>
                    }

                    <div class="services__table-wrapper desktop-view">
                        <table class="services__table">
                            <thead>
                                <tr>
                                    @if (IsBundleDeleteMode)
                                    {
                                        <th class="services__checkbox-col"></th>
                                    }
                                    <th class="services__image-col">Image</th>
                                    <th class='@GetServiceSortHeaderClass(BundleSortColumn, BundleSortAscending, "BundleName")' @onclick='() => ToggleBundleSort("BundleName")'>
                                        Package Name
                                    </th>
                                    <th>Section</th>
                                    <th class='@GetServiceSortHeaderClass(BundleSortColumn, BundleSortAscending, "TotalDuration")' @onclick='() => ToggleBundleSort("TotalDuration")'>
                                        Duration
                                    </th>
                                    <th class='@GetServiceSortHeaderClass(BundleSortColumn, BundleSortAscending, "Price")' @onclick='() => ToggleBundleSort("Price")'>
                                        @L["PriceMyr"]
                                    </th>
                                    <th class="services__actions-col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!PaginatedBundles.Any())
                                {
                                    <tr>
                                        <td colspan="@(IsBundleDeleteMode ? 7 : 6)" class="services__empty-cell">
                                            @L["NoPackagesFoundCreateFirst"]
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var bundle in PaginatedBundles)
                                    {
                                        var isSelected = SelectedBundle == bundle && !IsBundleDeleteMode;
                                        <tr @onclick="() => ToggleMobileBundleRow(bundle)" class="@(isSelected ? "selected" : "")">
                                            @if (IsBundleDeleteMode)
                                            {
                                                <td class="services__checkbox-col" @onclick:stopPropagation="true">
                                                    <input type="checkbox"
                                                           checked="@SelectedBundlesForDeletion.Contains(bundle)"
                                                           @onchange="() => ToggleBundleForDeletion(bundle)" />
                                                </td>
                                            }
                                            <td class="services__image-col">
                                                @{
                                                    var packageImage = BuildRecordImageUrl(bundle.ImagePath, bundle.ImageFileName);
                                                }
                                                @if (!string.IsNullOrWhiteSpace(packageImage))
                                                {
                                                    <img class="services__record-image" src="@packageImage" alt="@bundle.BundleName" />
                                                }
                                                else
                                                {
                                                    <span class="services__record-image-placeholder services__record-image-placeholder--package" aria-hidden="true"><i class="bi bi-box-seam"></i></span>
                                                }
                                            </td>
                                            <td>@bundle.BundleName</td>
                                            <td>@FormatDisplay(bundle.Section)</td>
                                            <td>@bundle.TotalDuration @L["Min"]</td>
                                            <td class="services-money-value">@bundle.Price.ToString("N2")</td>
                                            <td class="services__actions-col" @onclick:stopPropagation="true">
                                                <div class="services__row-actions">
                                                    <button type="button" class="services__action-btn services__action-btn--view" title="View details" @onclick="() => ShowBundleDetails(bundle)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button type="button" class="services__action-btn services__action-btn--edit" title="@L["EditPackage"]" @onclick="() => EditBundle(bundle)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="service-mobile-records mobile-view">
                        @if (!PaginatedBundles.Any())
                        {
                            <div class="service-mobile-records__empty">@L["NoPackagesFoundCreateFirst"]</div>
                        }
                        else
                        {
                            @foreach (var bundle in PaginatedBundles)
                            {
                                var packageImage = BuildRecordImageUrl(bundle.ImagePath, bundle.ImageFileName);
                                <article class="service-mobile-record @(SelectedBundle == bundle && !IsBundleDeleteMode ? "is-selected" : string.Empty)"
                                         @onclick="() => HandleMobileBundleCardClick(bundle)">
                                    <div class="service-mobile-record__header">
                                        @if (IsBundleDeleteMode)
                                        {
                                            <label class="service-mobile-record__select" @onclick:stopPropagation="true">
                                                <input type="checkbox"
                                                       aria-label="Select @bundle.BundleName"
                                                       checked="@SelectedBundlesForDeletion.Contains(bundle)"
                                                       @onchange="() => ToggleBundleForDeletion(bundle)" />
                                            </label>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(packageImage))
                                        {
                                            <img class="service-mobile-record__image" src="@packageImage" alt="@bundle.BundleName" />
                                        }
                                        else
                                        {
                                            <div class="service-mobile-record__icon" aria-hidden="true"><i class="bi bi-box-seam"></i></div>
                                        }
                                        <div class="service-mobile-record__identity">
                                            <h3>@bundle.BundleName</h3>
                                            <p>@FormatDisplay(bundle.Section)</p>
                                        </div>
                                    </div>
                                    <div class="service-mobile-record__facts">
                                        <div class="service-mobile-record__fact">
                                            <span>Section</span>
                                            <strong>@FormatDisplay(bundle.Section)</strong>
                                        </div>
                                        <div class="service-mobile-record__fact">
                                            <span>Duration</span>
                                            <strong>@bundle.TotalDuration @L["Min"]</strong>
                                        </div>
                                        <div class="service-mobile-record__fact service-mobile-record__fact--wide">
                                            <span>@L["PriceMyr"]</span>
                                            <strong>MYR @bundle.Price.ToString("N2")</strong>
                                        </div>
                                    </div>
                                    @if (!IsBundleDeleteMode)
                                    {
                                        <div class="service-mobile-record__actions" @onclick:stopPropagation="true">
                                            <button type="button" class="services__action-btn services__action-btn--view" title="View details" aria-label="View package details" @onclick="() => ShowBundleDetails(bundle)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button type="button" class="services__action-btn services__action-btn--edit" title="@L["EditPackage"]" aria-label="@L["EditPackage"]" @onclick="() => EditBundle(bundle)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    }
                                </article>
                            }
                        }
                    </div>

                    <Pagination CurrentPage="@BundleCurrentPage"
                                ItemsPerPage="5"
                                TotalItems="@FilteredBundles.Count()"
                                OnPageChanged="@HandleBundlePageChanged" />
                    <div class="pagination-summary">
                        @L["TotalItems"]: @FilteredBundles.Count()
                    </div>
                }
                else
                {
                    <div class="senang-editor">
                        <div class="senang-editor__topbar">
                            <div class="senang-editor__heading">
                                <button type="button" class="senang-editor__back" @onclick="CloseAddBundleForm" title="Back">
                                    <i class="bi bi-arrow-left"></i>
                                </button>
                                <div>
                                    <h2>@(IsBundleEditMode ? "Edit Package" : "Add Package")</h2>
                                    <span>Management</span>
                                </div>
                            </div>
                            <div class="senang-editor__actions">
                                <button type="button" class="senang-editor__cancel" @onclick="CloseAddBundleForm" disabled="@IsSavingBundle">Cancel</button>
                                <button type="button" class="senang-editor__save" @onclick="HandleSaveBundle" disabled="@IsSavingBundle">
                                    @(IsSavingBundle ? "Saving..." : "Save")
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(BundleApiError))
                        {
                            <div class="services__api-message services__api-message--error">@BundleApiError</div>
                        }

                        <div class="senang-editor__content">
                            <div class="senang-editor__identity">
                                <div class="senang-editor__image-placeholder senang-editor__image-placeholder--package">
                                    <i class="bi bi-box-seam"></i>
                                    <span>Package</span>
                                </div>
                            </div>

                            <div class="senang-editor__tabs senang-editor__tabs--package">
                                <button type="button"
                                        class="@(BundleEditorTab == "Info" ? "active" : string.Empty)"
                                        @onclick='() => BundleEditorTab = "Info"'>
                                    Info
                                </button>
                                <button type="button"
                                        class="@(BundleEditorTab == "Items" ? "active" : string.Empty)"
                                        @onclick='() => BundleEditorTab = "Items"'>
                                    Items
                                    @if (SelectedBundleServices.Any())
                                    {
                                        <span class="senang-editor__tab-badge">@SelectedBundleServices.Count</span>
                                    }
                                </button>
                                <button type="button"
                                        class="@(BundleEditorTab == "Advance" ? "active" : string.Empty)"
                                        @onclick='() => BundleEditorTab = "Advance"'>
                                    Advance
                                </button>
                                <button type="button"
                                        class="@(BundleEditorTab == "Membership" ? "active" : string.Empty)"
                                        @onclick='() => BundleEditorTab = "Membership"'>
                                    Membership
                                </button>
                            </div>

                            <div class="senang-editor__panel">
                                @if (BundleEditorTab == "Info")
                                {
                                    <div class="senang-editor__form-grid">
                                        <div class="senang-editor__field">
                                            <label>Package Name <span>*</span></label>
                                            <input type="text" @bind="NewBundleName" placeholder="Package name" />
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Package SKU <span>*</span></label>
                                            <input type="text" @bind="NewBundleSKU" placeholder="Package SKU" />
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Section</label>
                                            <input type="text" @bind="NewBundleSection" placeholder="Package section" />
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Status</label>
                                            <select @bind="NewBundleIsActive">
                                                <option value="true">Active</option>
                                                <option value="false">Inactive</option>
                                            </select>
                                        </div>
                                        <div class="senang-editor__field senang-editor__field--full">
                                            <label>Price (MYR) <span>*</span></label>
                                            <input type="number" step="0.01" min="0" @bind="NewBundlePrice" />
                                        </div>
                                    </div>
                                }
                                else if (BundleEditorTab == "Items")
                                {
                                    <div class="senang-package-items">
                                        <div class="senang-package-items__heading">
                                            <div>
                                                <h3>Package Items</h3>
                                                <p>Select services, then maintain the Senang package-line values.</p>
                                            </div>
                                            <span>@SelectedBundleServices.Count selected</span>
                                        </div>

                                        @if (!BundleEligibleServices.Any())
                                        {
                                            <div class="senang-record-list__empty">
                                                <i class="bi bi-inbox"></i>
                                                <strong>No package-eligible services</strong>
                                                <span>Enable “Add To Package List” on a service first.</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="senang-package-items__list">
                                                @foreach (var service in BundleEligibleServices)
                                                {
                                                    var lineKey = BundleServiceKey(service);
                                                    var selected = SelectedBundleServices.Contains(service);
                                                    <div class="senang-package-item @(selected ? "is-selected" : string.Empty)">
                                                        <label class="senang-package-item__select">
                                                            <input type="checkbox"
                                                                   checked="@selected"
                                                                   @onchange="() => ToggleServiceSelection(service)" />
                                                            <span class="senang-package-item__icon"><i class="bi bi-scissors"></i></span>
                                                            <span class="senang-package-item__body">
                                                                <strong>@service.ServiceName</strong>
                                                                <small>@service.Category • @service.DurationSpend</small>
                                                            </span>
                                                        </label>

                                                        @if (selected)
                                                        {
                                                            <div class="senang-package-item__fields">
                                                                <label>
                                                                    <span>Deferred</span>
                                                                    <input type="checkbox"
                                                                           checked="@BundleDeferredServiceIds.Contains(lineKey)"
                                                                           @onchange="(ChangeEventArgs e) => SetBundleDeferred(service, e.Value is true)" />
                                                                </label>
                                                                <label>
                                                                    <span>Unit Price</span>
                                                                    <input type="number"
                                                                           min="0"
                                                                           step="0.01"
                                                                           @bind="BundleLineUnitPrices[lineKey]" />
                                                                </label>
                                                                <label>
                                                                    <span>Qty</span>
                                                                    <input type="number"
                                                                           min="1"
                                                                           step="1"
                                                                           @bind="BundleLineQuantities[lineKey]" />
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else if (BundleEditorTab == "Advance")
                                {
                                    <div class="senang-editor__form-grid">
                                        <div class="senang-editor__field">
                                            <label>Barcode</label>
                                            <div class="senang-editor__icon-input">
                                                <input type="text" @bind="NewBundleBarcode" placeholder="Scan or type barcode" />
                                                <i class="bi bi-upc-scan"></i>
                                            </div>
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>UOM</label>
                                            <select @bind="NewBundleUom">
                                                <option value="unit">unit</option>
                                                <option value="piece">piece</option>
                                                <option value="set">set</option>
                                                <option value="package">package</option>
                                                <option value="session">session</option>
                                            </select>
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Validity Days</label>
                                            <input type="number" min="0" @bind="NewBundleValidityDays" />
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Working Branch</label>
                                            <input type="text" value="@ServiceBranchId" readonly />
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="senang-editor__form-grid">
                                        <div class="senang-editor__field">
                                            <label>Credit Expiry (Days)</label>
                                            <input type="number" min="0" @bind="NewBundleMemberExpiryDays" />
                                        </div>
                                        <div class="senang-editor__field">
                                            <label>Member Type</label>
                                            <select @bind="NewBundleTriggeredMemberTypeId">
                                                <option value="">No member type</option>
                                                @foreach (var memberType in MemberTypeItems.Where(item => item.Active))
                                                {
                                                    <option value="@memberType.MemberTypeID">@memberType.MemberTypeName (@memberType.MemberTypeID)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="senang-editor__field senang-editor__field--full">
                                            <label>Member Credit Amount</label>
                                            <input type="number" min="0" step="0.01" @bind="NewBundleMemberCredit" />
                                        </div>
                                    </div>
                                }
                            </div>
