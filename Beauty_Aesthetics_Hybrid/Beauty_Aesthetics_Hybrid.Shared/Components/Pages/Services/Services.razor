    private static string FormatPointDateRange(DateTime? from, DateTime? to)
    {
        if (from is null && to is null)
        {
            return "-";
        }

        return $"{(from?.ToString("dd/MM/yyyy") ?? "-")} - {(to?.ToString("dd/MM/yyyy") ?? "-")}";
    }

    private static string FormatMemberTypeTimeRange(string? from, string? to)
    {
        var start = string.IsNullOrWhiteSpace(from) ? "00:00" : from[..Math.Min(5, from.Length)];
        var end = string.IsNullOrWhiteSpace(to) ? "23:59" : to[..Math.Min(5, to.Length)];
        return $"{start} - {end}";
    }

    private static string FormatDisplay(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetServiceDetailStatusTone(string? status)
    {
        var normalized = status?.Trim() ?? string.Empty;

        if (normalized.Contains("inactive", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("cancel", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("void", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("disable", StringComparison.OrdinalIgnoreCase))
        {
            return "danger";
        }

        if (normalized.Contains("pending", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("draft", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("hold", StringComparison.OrdinalIgnoreCase))
        {
            return "warning";
        }

        if (normalized.Contains("active", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("approve", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("complete", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("available", StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        return "neutral";
    }

    private static string FormatDateRange(DateTime? from, DateTime? to)
    {
        var start = FormatDate(from);
        var end = FormatDate(to);
        return start == "-" && end == "-" ? "-" : $"{start} - {end}";
    }

    private static string FormatDate(DateTime? value) =>
        value.HasValue && value.Value.Year > 1900 ? value.Value.ToString("dd/MM/yyyy") : "-";

    private static string FormatTimeRange(TimeSpan? from, TimeSpan? to)
    {
        var start = FormatTime(from);
        var end = FormatTime(to);
        return start == "-" && end == "-" ? "-" : $"{start} - {end}";
    }

    private static string FormatTime(TimeSpan? value) =>
        value.HasValue ? DateTime.Today.Add(value.Value).ToString("hh:mm tt") : "-";

    private string GetBundleServiceNames(BundleItem bundle)
    {
        var serviceNames = ServiceItems
            .Where(service => !string.IsNullOrWhiteSpace(service.MasterAccountId) && bundle.ServiceIDs.Contains(service.MasterAccountId))
            .Select(service => service.ServiceName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return serviceNames.Any() ? string.Join(", ", serviceNames) : "-";
    }
