    {
        IsBundleDeleteMode = !IsBundleDeleteMode;
        if (!IsBundleDeleteMode)
        {
            SelectedBundlesForDeletion.Clear();
        }
    }

    private void CancelBundleDeleteMode()
    {
        IsBundleDeleteMode = false;
        SelectedBundlesForDeletion.Clear();
    }

    private void ToggleBundleForDeletion(BundleItem bundle)
    {
        if (SelectedBundlesForDeletion.Contains(bundle))
        {
            SelectedBundlesForDeletion.Remove(bundle);
        }
        else
        {
            SelectedBundlesForDeletion.Add(bundle);
        }
    }

    private void ToggleAllBundlesSelection()
    {
        if (IsAllBundlesSelected)
        {
            SelectedBundlesForDeletion.Clear();
        }
        else
        {
            SelectedBundlesForDeletion.Clear();
            foreach (var bundle in FilteredBundles)
            {
                SelectedBundlesForDeletion.Add(bundle);
            }
        }
    }

    private async Task DeleteSelectedBundles()
    {
        BundleApiError = null;

        foreach (var bundle in SelectedBundlesForDeletion.ToList())
        {
            if (string.IsNullOrWhiteSpace(bundle.MasterAccountID))
            {
                continue;
            }

            var result = await PackageService.DeletePackageAsync(bundle.MasterAccountID);
            if (!result.Success)
            {
                BundleApiError = result.ErrorMessage ?? $"Unable to delete {bundle.BundleName}.";
                return;
            }
        }

        SelectedBundlesForDeletion.Clear();
        IsBundleDeleteMode = false;
        await LoadPackagesFromApiAsync();
    }

    private void SelectBundle(BundleItem bundle)
    {
        SelectedBundle = bundle;
    }

    private void ToggleMobileBundleRow(BundleItem bundle)
    {
        SelectBundle(bundle);

        if (IsBundleDeleteMode)
        {
            ExpandedMobileBundleSku = null;
            return;
        }

        ExpandedMobileBundleSku = ExpandedMobileBundleSku == bundle.SKU ? null : bundle.SKU;
    }

    private void HandleMobileBundleCardClick(BundleItem bundle)
    {
        if (IsBundleDeleteMode)
        {
            ToggleBundleForDeletion(bundle);
            return;
        }

        SelectedBundle = bundle;
        ShowBundleDetails(bundle);
    }

