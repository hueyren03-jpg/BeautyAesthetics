    private async Task DeleteSelectedServices()
    {
        var selectedServices = SelectedServicesForDeletion.ToList();
        if (selectedServices.Count == 0)
        {
            IsServiceDeleteMode = false;
            return;
        }

        ServiceApiError = null;
        var deletedServices = new List<ServiceViewModel.ServiceItem>();

        foreach (var service in selectedServices)
        {
            var result = await ServiceItemService.DeleteServiceAsync(service.MasterAccountId);
            if (result.Success)
            {
                deletedServices.Add(service);
                continue;
            }

            ServiceApiError = result.ErrorMessage ?? "Unable to delete one or more services.";
            break;
        }

        foreach (var service in deletedServices)
        {
            ServiceItems.Remove(service);
        }

        SelectedServicesForDeletion.Clear();
        IsServiceDeleteMode = false;
    }

