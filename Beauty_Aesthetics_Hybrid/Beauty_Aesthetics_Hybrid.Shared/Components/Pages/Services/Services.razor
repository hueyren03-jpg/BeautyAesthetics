    private static List<MultiTableFilter.FilterOption> ServiceCountOptions(IEnumerable<string?> values) =>
        values.Where(value => !string.IsNullOrWhiteSpace(value))
            .GroupBy(value => value!.Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => group.Key)
            .Select(group => new MultiTableFilter.FilterOption { Value = group.Key, Label = group.Key, Count = group.Count() })
            .ToList();

    private static List<MultiTableFilter.FilterOption> ServiceFixedOptions(params (string Value, string Label)[] values) =>
        values.Select(value => new MultiTableFilter.FilterOption { Value = value.Value, Label = value.Label }).ToList();
