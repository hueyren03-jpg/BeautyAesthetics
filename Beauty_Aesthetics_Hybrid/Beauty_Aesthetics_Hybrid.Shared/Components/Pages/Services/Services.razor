    private async Task UpdateServicesFromExcel(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
        {
            return;
        }

        try
        {
            var extension = Path.GetExtension(file.Name);
            var importedCount = 0;

            var existingSkus = new HashSet<string>(
                ServiceItems.Select(s => s.Sku),
                StringComparer.OrdinalIgnoreCase);

            var newItems = new List<ServiceViewModel.ServiceItem>();
            var fileSkus = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            if (string.Equals(extension, ".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                await using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                memoryStream.Position = 0;

                using var workbook = new XLWorkbook(memoryStream);
                var worksheet = workbook.Worksheets.FirstOrDefault();

                if (worksheet == null)
                {
                    ShowServiceFeedback("Unable to read Excel worksheet from the selected file.");
                    return;
                }

                var headerLine = new StringBuilder();
                for (var col = 1; col <= 7; col++)
                {
                    if (col > 1)
                    {
                        headerLine.Append(',');
                    }

                    headerLine.Append(worksheet.Cell(1, col).GetString().Trim());
                }

                if (!string.Equals(headerLine.ToString(), ServiceImportExpectedHeader, StringComparison.OrdinalIgnoreCase))
                {
                    ShowServiceFeedback("The selected file does not match the Service Import Template header. Please download the latest template and try again.");
                    return;
                }

                var row = 2;
                while (true)
                {
                    var sku = worksheet.Cell(row, 1).GetString().Trim();
                    var serviceName = worksheet.Cell(row, 2).GetString().Trim();

                    if (string.IsNullOrWhiteSpace(sku) && string.IsNullOrWhiteSpace(serviceName))
                    {
                        if (string.IsNullOrWhiteSpace(worksheet.Cell(row, 3).GetString()))
                        {
                            break;
                        }
                    }

                    // Skip the example row from the import template if present
                    if (string.Equals(sku, "EXAMPLE-SRV-001", StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(serviceName, "Sample Service Name", StringComparison.OrdinalIgnoreCase))
                    {
                        row++;
                        continue;
                    }

                    var category = worksheet.Cell(row, 3).GetString().Trim();
                    var durationText = worksheet.Cell(row, 4).GetString().Trim();
                    var bufferText = worksheet.Cell(row, 5).GetString().Trim();
                    var packageText = worksheet.Cell(row, 6).GetString().Trim();
                    var priceText = worksheet.Cell(row, 7).GetString().Trim();

                    if (!string.IsNullOrWhiteSpace(sku))
                    {
                        if (existingSkus.Contains(sku) || !fileSkus.Add(sku))
                        {
                            ShowServiceFeedback($"Duplicate SKU '{sku}' found in import file or already exists in services. Import cancelled.");
                            return;
                        }
                    }

                    if (!decimal.TryParse(priceText, NumberStyles.Any, CultureInfo.InvariantCulture, out var price))
                    {
                        price = 0m;
                    }

                    int.TryParse(durationText, NumberStyles.Any, CultureInfo.InvariantCulture, out var durationMinutes);
                    var durationSpend = durationMinutes > 0 ? $"{durationMinutes} mins" : string.Empty;

                    int.TryParse(bufferText, NumberStyles.Any, CultureInfo.InvariantCulture, out var bufferMinutes);

                    var isBundle = string.Equals(packageText, "Yes", StringComparison.OrdinalIgnoreCase);

                    var newItem = new ServiceViewModel.ServiceItem(
                        sku,
                        serviceName,
                        category,
                        durationSpend,
                        bufferMinutes,
                        isBundle,
                        price);

                    newItems.Add(newItem);
                    importedCount++;
                    row++;
                }
            }
            else
            {
                await using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var reader = new StreamReader(stream);

                var headerLine = await reader.ReadLineAsync() ?? string.Empty;

                if (!string.Equals(headerLine.Trim(), ServiceImportExpectedHeader, StringComparison.OrdinalIgnoreCase))
                {
                    ShowServiceFeedback("The selected file does not match the Service Import Template header. Please download the latest template and try again.");
                    return;
                }

                string? line;
                while ((line = await reader.ReadLineAsync()) != null)
                {
                    if (string.IsNullOrWhiteSpace(line))
                    {
                        continue;
                    }

                    var columns = line.Split(',');
                    if (columns.Length < 7)
                    {
                        // Skip malformed rows
                        continue;
                    }

                    static string Clean(string? value)
                    {
                        if (string.IsNullOrEmpty(value))
                        {
                            return string.Empty;
                        }

                        var cleaned = value.Trim();
                        if (cleaned.StartsWith(""", StringComparison.Ordinal) && cleaned.EndsWith(""", StringComparison.Ordinal) && cleaned.Length >= 2)
                        {
                            cleaned = cleaned.Substring(1, cleaned.Length - 2);
                        }

                        cleaned = cleaned.TrimStart('\t');
                        return cleaned;
                    }

                    var sku = Clean(columns[0]);
                    var serviceName = Clean(columns[1]);

                    // if (string.IsNullOrWhiteSpace(sku) || !skuIndex.TryGetValue(sku, out var index))
                    // {
                    //     continue;
                    // }

                    // Skip the example row from the import template if present
                    if (string.Equals(sku, "EXAMPLE-SRV-001", StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(serviceName, "Sample Service Name", StringComparison.OrdinalIgnoreCase))
                    {
                        continue;
                    }

                    var category = Clean(columns[2]);
                    var durationText = Clean(columns[3]);
                    var bufferText = Clean(columns[4]);
                    var packageText = Clean(columns[5]);
                    var priceText = Clean(columns[6]);

                    if (!decimal.TryParse(priceText, NumberStyles.Any, CultureInfo.InvariantCulture, out var price))
                    {
                        price = 0m;
                    }

                    int.TryParse(durationText, NumberStyles.Any, CultureInfo.InvariantCulture, out var durationMinutes);
                    var durationSpend = durationMinutes > 0 ? $"{durationMinutes} mins" : string.Empty;

                    int.TryParse(bufferText, NumberStyles.Any, CultureInfo.InvariantCulture, out var bufferMinutes);

                    var isBundle = string.Equals(packageText, "Yes", StringComparison.OrdinalIgnoreCase);

                    var updated = new ServiceViewModel.ServiceItem(
                        sku,
                        serviceName,
                        category,
                        durationSpend,
                        bufferMinutes,
                        isBundle,
                        price);

                    // updatedItems[index] = updated;
                    // updatedCount++;
                    // row++;
                }
            }

            if (importedCount > 0)
            {
                ServiceItems.AddRange(newItems);
            }

            ShowServiceFeedback($"Successfully imported {importedCount} service(s).");
        }
        catch (Exception ex)
        {
            ShowServiceFeedback($"Error reading import file: {ex.Message}");
        }
    }

    private async Task ExportServiceItems()
    {
        ShowServiceImportExportDropdown = false;

        try
        {
            await EnsureServicesModuleAsync();

            if (_servicesModule == null)
            {
                ShowServiceFeedback("Unable to load export module. Please try again.");
                return;
            }

            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Services");

            var headers = new[]
            {
                "SKU","Service Name","Category","Duration (minutes)","Buffer Time (minutes)","Package","Price (MYR)"
            };

            for (var i = 0; i < headers.Length; i++)
            {
                worksheet.Cell(1, i + 1).Value = headers[i];
                worksheet.Cell(1, i + 1).Style.Font.Bold = true;
            }

            var row = 2;
            foreach (var item in ServiceItems)
            {
                worksheet.Cell(row, 1).Value = item.Sku;
                worksheet.Cell(row, 2).Value = item.ServiceName;
                worksheet.Cell(row, 3).Value = item.Category;

                // Duration (minutes) from DurationSpend string, written as text for left alignment
                var durationStr = item.DurationSpend.Split(' ')[0];
                worksheet.Cell(row, 4).Value = durationStr;

                // Buffer Time written as text for left alignment
                worksheet.Cell(row, 5).Value = item.BufferTimeMinutes.ToString();

                worksheet.Cell(row, 6).Value = item.IsBundle ? "Yes" : "No";

                // Price written as text for left alignment, still parseable
                worksheet.Cell(row, 7).Value = item.Price.ToString(CultureInfo.InvariantCulture);
                row++;
            }

            worksheet.Columns().AdjustToContents();
            for (var col = 1; col <= headers.Length; col++)
            {
                worksheet.Column(col).Width += 2;
            }

            // Align numeric-like fields to the left for consistency
            worksheet.Column(4).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left; // Duration (minutes)
            worksheet.Column(5).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left; // Buffer Time (minutes)
            worksheet.Column(7).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left; // Price (MYR)

            // Align numeric-like fields to the left for consistency
            worksheet.Column(4).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left; // Duration (minutes)
            worksheet.Column(5).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left; // Buffer Time (minutes)
            worksheet.Column(7).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left; // Price (MYR)

            var fileName = $"Services_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            using var ms = new MemoryStream();
            workbook.SaveAs(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            await _servicesModule.InvokeVoidAsync("downloadFile", fileName, base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Feedback.Success($"{ServiceItems.Count} service record{(ServiceItems.Count == 1 ? string.Empty : "s")} exported.", "Service export complete");
        }
        catch (Exception ex)
        {
            ShowServiceFeedback($"Error exporting services: {ex.Message}");
        }
    }

