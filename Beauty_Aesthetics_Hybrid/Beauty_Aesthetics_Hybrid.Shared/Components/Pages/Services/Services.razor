                    AvailableDateTo = package.AvailableDateTo,
                    AvailableTimeFrom = package.AvailableTimeFrom,
                    AvailableTimeTo = package.AvailableTimeTo,
                    EInvoiceClassificationCode = package.EInvoiceClassificationCode,
