                    b.TotalDuration.ToString().Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    b.Price.ToString("N2").Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            foreach (var filter in ActiveBundleFilters)
            {
                bundles = ApplyBundleFilter(bundles, filter);
            }

            if (!string.IsNullOrEmpty(BundleSortColumn))
            {
                bundles = BundleSortColumn switch
                {
                    "BundleName" => BundleSortAscending ? bundles.OrderBy(b => b.BundleName) : bundles.OrderByDescending(b => b.BundleName),
                    "SKU" => BundleSortAscending ? bundles.OrderBy(b => b.SKU) : bundles.OrderByDescending(b => b.SKU),
                    "ServicesCount" => BundleSortAscending ? bundles.OrderBy(b => b.ServicesCount) : bundles.OrderByDescending(b => b.ServicesCount),
                    "TotalDuration" => BundleSortAscending ? bundles.OrderBy(b => b.TotalDuration) : bundles.OrderByDescending(b => b.TotalDuration),
                    "Price" => BundleSortAscending ? bundles.OrderBy(b => b.Price) : bundles.OrderByDescending(b => b.Price),
                    _ => bundles
                };
            }

            return bundles;
        }
    }

