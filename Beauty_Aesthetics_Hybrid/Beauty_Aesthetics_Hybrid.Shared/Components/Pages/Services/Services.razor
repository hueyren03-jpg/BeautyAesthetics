    private IEnumerable<ServiceViewModel.ServiceItem> FilteredServices
    {
        get
        {
            var items = ServiceItems.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                var search = SearchQuery.Trim();
                items = items.Where(s =>
                    (s.ServiceName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (s.Sku?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (s.Category?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    s.DurationSpend.ToString().Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    s.BufferTimeMinutes.ToString().Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    s.Price.ToString("N2").Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            // Apply multiple filters
            foreach (var filter in ActiveServiceFilters)
            {
                items = ApplyServiceFilter(items, filter);
            }

            // Apply sorting
            if (!string.IsNullOrEmpty(SortColumn))
            {
                items = SortColumn switch
                {
                    "ServiceName" => SortAscending ? items.OrderBy(s => s.ServiceName) : items.OrderByDescending(s => s.ServiceName),
                    "Sku" => SortAscending ? items.OrderBy(s => s.Sku) : items.OrderByDescending(s => s.Sku),
                    "Category" => SortAscending ? items.OrderBy(s => s.Category) : items.OrderByDescending(s => s.Category),
                    "DurationSpend" => SortAscending ? items.OrderBy(s => s.DurationSpend) : items.OrderByDescending(s => s.DurationSpend),
                    "IsBundle" => SortAscending ? items.OrderBy(s => s.IsBundle) : items.OrderByDescending(s => s.IsBundle),
                    "Price" => SortAscending ? items.OrderBy(s => s.Price) : items.OrderByDescending(s => s.Price),
                    _ => items
                };
            }

            return items;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        InventoryItems = InventoryViewModel.Items.ToList();
        MemberCreditItems.Clear();
        Bundles.Clear();

        // Services are branch-scoped just like Inventory records. Initialize the
        // persisted/current branch before issuing the service API request.
        await BranchSession.InitializeAsync();

        await LoadServiceItemsFromApiAsync();
        await LoadMemberCreditsFromApiAsync();
