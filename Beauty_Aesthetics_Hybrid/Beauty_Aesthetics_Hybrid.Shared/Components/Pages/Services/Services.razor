                                            {
                                                <div class="bundle-form__empty-state">
                                                    <i class="bi bi-inbox"></i>
                                                    <p>@L["NoPackageEligibleServices"]</p>
                                                    <p class="bundle-form__empty-hint">@L["AddServicesWithAddToPackageListFirst"]</p>
                                                </div>
                                            }
                                            else
                                            {
