        NewMemberPointEqualToPoint = 0;
        NewMemberPointExcludeTax = false;
        NewMemberPointRoundDown = false;
        NewMemberPointExpiryOption = "0";
        NewMemberPointExpiryMonth = 0;
        NewMemberPointMoneyConversion = 0.0000m;
        NewMemberPointConvertVoucher = false;
        NewMemberPointStartDate = DateTime.Today;
        NewMemberPointEndDate = DateTime.Today.AddYears(1);
