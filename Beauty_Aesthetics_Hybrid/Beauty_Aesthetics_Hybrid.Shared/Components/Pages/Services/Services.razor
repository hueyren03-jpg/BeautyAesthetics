    private IEnumerable<string> GetServiceFilterSuggestions(string column, string term)
    {
        term = term?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(column) || string.IsNullOrWhiteSpace(term))
            return Enumerable.Empty<string>();

        IEnumerable<string> values = column switch
        {
            "ServiceName" => ServiceItems.Select(s => s.ServiceName),
            "Sku" => ServiceItems.Select(s => s.Sku),
            "Category" => ServiceItems.Select(s => s.Category),
            "DurationSpend" => ServiceItems.Select(s => s.DurationSpend),
            "IsBundle" => ServiceItems.Select(s => s.IsBundle.ToString()),
            "Price" => ServiceItems.Select(s => s.Price.ToString("N2")),
            _ => Enumerable.Empty<string>()
        };

        return values
            .Where(v => !string.IsNullOrWhiteSpace(v) && v.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v.StartsWith(term, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(v => v)
            .Take(10);
    }

