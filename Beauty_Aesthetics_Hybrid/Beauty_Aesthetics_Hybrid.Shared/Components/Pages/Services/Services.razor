    private async Task HandleSaveBundle()
    {
        if (IsSavingBundle)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(NewBundleName) ||
            string.IsNullOrWhiteSpace(NewBundleSKU) ||
            NewBundlePrice < 0)
        {
            BundleApiError = "Package name, SKU, and a valid price are required.";
            return;
        }

        if (SelectedBundleServices.Count == 0)
        {
            BundleApiError = "Select at least one service for this package.";
            return;
        }

        IsSavingBundle = true;
        BundleApiError = null;

        try
        {
            var packageLines = SelectedBundleServices
                .Where(service => !string.IsNullOrWhiteSpace(service.MasterAccountId))
                .Select(service =>
                {
                    var key = BundleServiceKey(service);
                    return new InventoryPackageLineEdit(
                        service,
                        BundleLineQuantities.TryGetValue(key, out var quantity) ? Math.Max(1m, quantity) : 1m,
                        BundleLineUnitPrices.TryGetValue(key, out var unitPrice) ? Math.Max(0m, unitPrice) : Math.Max(0m, service.Price),
                        BundleDeferredServiceIds.Contains(key));
                })
                .ToList();

            var package = new InventoryPackageEdit(
                IsBundleEditMode ? SelectedBundle?.MasterAccountID : null,
                NewBundleName.Trim(),
                NewBundleSKU.Trim(),
                NewBundlePrice,
                SelectedBundleServices.ToList(),
                NewBundleSection.Trim(),
                NewBundleIsActive,
                NewBundleBarcode.Trim(),
                string.IsNullOrWhiteSpace(NewBundleUom) ? "unit" : NewBundleUom.Trim(),
                Math.Max(0, NewBundleValidityDays),
                Math.Max(0, NewBundleMemberExpiryDays),
                NewBundleTriggeredMemberTypeId.Trim(),
                Math.Max(0m, NewBundleMemberCredit),
                packageLines);

            var result = IsBundleEditMode
                ? await PackageService.UpdatePackageAsync(package, ServiceBranchId)
                : await PackageService.CreatePackageAsync(package, ServiceBranchId);

            if (!result.Success)
            {
                BundleApiError = result.ErrorMessage ?? "Unable to save package.";
                return;
            }

            CloseAddBundleForm();
            await LoadPackagesFromApiAsync();
        }
        finally
        {
            IsSavingBundle = false;
        }
    }

    private void ShowEditBundleForm()
    {
        if (SelectedBundle == null) return;

        IsBundleEditMode = true;
        NewBundleName = SelectedBundle.BundleName;
        NewBundleSKU = SelectedBundle.SKU;
        NewBundleSection = SelectedBundle.Section;
        NewBundleIsActive = SelectedBundle.IsActive;
        NewBundleBarcode = SelectedBundle.Barcode;
        NewBundleUom = string.IsNullOrWhiteSpace(SelectedBundle.UnitOfMeasure) ? "unit" : SelectedBundle.UnitOfMeasure;
        NewBundleValidityDays = SelectedBundle.ValidityDays;
        NewBundleMemberExpiryDays = SelectedBundle.MemberExpiryDays;
        NewBundleTriggeredMemberTypeId = SelectedBundle.TriggeredMemberTypeId;
        NewBundleMemberCredit = SelectedBundle.MemberMainAccountCredit;
        NewBundlePrice = SelectedBundle.Price;

        SelectedBundleServices = ServiceItems
            .Where(service =>
                !string.IsNullOrWhiteSpace(service.MasterAccountId) &&
                SelectedBundle.ServiceIDs.Contains(service.MasterAccountId))
            .ToHashSet();

        BundleLineQuantities.Clear();
        BundleLineUnitPrices.Clear();
        BundleDeferredServiceIds.Clear();
        foreach (var service in SelectedBundleServices)
        {
            var key = BundleServiceKey(service);
            var line = SelectedBundle.ServiceLines.FirstOrDefault(item =>
                string.Equals(item.ServiceId, service.MasterAccountId, StringComparison.OrdinalIgnoreCase));
            BundleLineQuantities[key] = line is null ? 1m : Math.Max(1m, line.Quantity);
            BundleLineUnitPrices[key] = line is null ? Math.Max(0m, service.Price) : Math.Max(0m, line.UnitPrice);
            if (line?.IsDeferred == true)
            {
                BundleDeferredServiceIds.Add(key);
            }
        }

        BundleApiError = null;
        BundleEditorTab = "Info";
        IsAddBundleFormVisible = true;
        Feedback.Info(
            SelectedBundle is null ? "Opening package editor." : $"Editing package {SelectedBundle.BundleName}.",
            "Edit package",
            2200);
    }

