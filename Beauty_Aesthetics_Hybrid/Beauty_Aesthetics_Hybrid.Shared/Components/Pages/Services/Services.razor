    private async Task EnsureServicesModuleAsync()
    {
        if (_servicesModule != null || _servicesModuleLoadFailed)
        {
            return;
        }

        try
        {
            _servicesModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Beauty_Aesthetics_Hybrid.Shared/js/inventory.js");
        }
        catch (JSException ex)
        {
            _servicesModuleLoadFailed = true;
            Console.WriteLine($"Error loading services interop module: {ex.Message}");
        }
        catch (JSDisconnectedException)
        {
            _servicesModuleLoadFailed = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_servicesModule == null)
        {
            return;
        }

        try
        {
            await _servicesModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Ignore if JS runtime is gone
        }
    }

    private void ShowServiceFeedback(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        var normalized = message.Trim();
        if (normalized.Contains("success", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("imported", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("updated", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("downloaded", StringComparison.OrdinalIgnoreCase))
        {
            Feedback.Success(normalized);
        }
        else if (normalized.Contains("duplicate", StringComparison.OrdinalIgnoreCase) ||
                 normalized.Contains("does not match", StringComparison.OrdinalIgnoreCase) ||
                 normalized.Contains("required", StringComparison.OrdinalIgnoreCase))
        {
            Feedback.Warning(normalized, "Check service data");
        }
        else if (normalized.Contains("unable", StringComparison.OrdinalIgnoreCase) ||
                 normalized.Contains("error", StringComparison.OrdinalIgnoreCase) ||
                 normalized.Contains("failed", StringComparison.OrdinalIgnoreCase))
        {
            Feedback.Error(normalized);
        }
        else
        {
            Feedback.Info(normalized);
        }
    }

