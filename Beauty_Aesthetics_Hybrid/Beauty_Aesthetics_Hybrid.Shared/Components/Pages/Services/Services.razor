    private IEnumerable<ServiceViewModel.ServiceItem> ApplyServiceFilter(IEnumerable<ServiceViewModel.ServiceItem> items, MultiTableFilter.FilterData filter)
    {
        return filter.Column switch
        {
            "ServiceName" => items.Where(item => ServiceFilterTextMatches(item.ServiceName, filter)),
            "Sku" => items.Where(item => ServiceFilterTextMatches(item.Sku, filter)),
            "Category" => items.Where(item => ServiceFilterTextMatches(item.Category, filter)),
            "DurationSpend" => items.Where(item => ServiceFilterInRange(ServiceDurationMinutes(item.DurationSpend), filter)),
            "BufferTime" => items.Where(item => ServiceFilterInRange(item.BufferTimeMinutes, filter)),
            "IsBundle" => items.Where(item => ServiceFilterTextMatches(item.IsBundle ? "Yes" : "No", filter)),
            "Price" => items.Where(item => ServiceFilterInRange(item.Price, filter)),
            _ => items
        };
    }

    private static bool ServiceFilterTextMatches(string? source, MultiTableFilter.FilterData filter)
    {
        if (string.IsNullOrWhiteSpace(source))
            return false;

        if (filter.Values.Count > 0)
            return filter.Values.Any(value => string.Equals(source.Trim(), value.Trim(), StringComparison.OrdinalIgnoreCase));

        return string.IsNullOrWhiteSpace(filter.Value) ||
               source.Contains(filter.Value.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static bool ServiceFilterInRange(decimal value, MultiTableFilter.FilterData filter) =>
        (!filter.MinValue.HasValue || value >= filter.MinValue.Value) &&
        (!filter.MaxValue.HasValue || value <= filter.MaxValue.Value);

    private static decimal ServiceDurationMinutes(string? duration)
    {
        if (string.IsNullOrWhiteSpace(duration))
            return 0;

        var value = duration.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return decimal.TryParse(value, out var minutes) ? minutes : 0;
    }
