    private async Task ConfirmSelectedDelete()
    {
        var deleteType = PendingSelectedDeleteType;
        CancelSelectedDeleteConfirmation();

        switch (deleteType)
        {
            case "services":
                await DeleteSelectedServices();
                break;
            case "memberCredits":
                await ConfirmMemberCreditDelete();
                break;
            case "memberTypes":
                await ConfirmMemberTypeDelete();
                break;
            case "memberPoints":
                await ConfirmMemberPointDelete();
                break;
            case "bundles":
                await DeleteSelectedBundles();
                break;
        }
    }

