    private async Task LoadServiceSectionsAsync()
    {
        var result = await SupportingTableAC.LoadListByTypeAsync(4);
        ServiceSections = result.Success && result.Value is not null
            ? result.Value
                .Where(section => section.Active && !string.IsNullOrWhiteSpace(section.SupportingTableName))
                .OrderBy(section => section.SupportingTableName)
                .ToList()
            : new List<SupportingTableDM>();
    }

    private async Task LoadProductsForPackageAsync()
    {
        var result = await ProductInventoryService.LoadProductsAsync("HQ");
        InventoryItems = result.Success && result.Value is not null
            ? result.Value.Where(item => !string.IsNullOrWhiteSpace(item.MasterAccountId)).ToList()
            : new List<InventoryViewModel.InventoryItem>();
    }

