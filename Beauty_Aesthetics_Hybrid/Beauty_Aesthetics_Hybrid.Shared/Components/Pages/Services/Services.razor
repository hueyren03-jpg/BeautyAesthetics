    private async Task LoadMemberPointsFromApiAsync()
    {
        IsMemberPointApiLoading = true;
        MemberPointApiError = null;

        try
        {
            var result = await PointConversionService.GetAllAsync();
            if (!result.Success || result.Value is null)
            {
                MemberPointItems.Clear();
                MemberPointApiError = result.ErrorMessage ?? "Unable to load member point rules.";
                return;
            }

            var currentBranchId = ServiceBranchId;
            MemberPointItems = result.Value
                .Where(item =>
                    string.IsNullOrWhiteSpace(item.VisibleToBranchID) ||
                    item.VisibleToBranchID.Split(',', StringSplitOptions.RemoveEmptyEntries)
                        .Any(branch => string.Equals(branch.Trim(), currentBranchId, StringComparison.OrdinalIgnoreCase)))
                .Select(MapMemberPoint)
                .OrderBy(item => item.MemberType)
                .ToList();

            SelectedMemberPoint = null;
            ViewingMemberPoint = null;
            MemberPointCurrentPage = 1;
        }
        catch (Exception ex)
        {
            MemberPointItems.Clear();
            MemberPointApiError = $"Unable to load member point rules. {ex.Message}";
        }
        finally
        {
            IsMemberPointApiLoading = false;
        }
    }

