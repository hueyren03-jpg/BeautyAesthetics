    private async Task ConfirmDeleteCategoryAction()
    {
        if (string.IsNullOrEmpty(_categoryToDelete))
        {
            CancelDeleteCategory();
            return;
        }
        
        var categoryToDelete = _categoryToDelete;
        
        // Check if any drugs are using this category (case-insensitive comparison)
        var drugsUsingCategory = ViewModel.Drugs.Where(d => 
            !string.IsNullOrEmpty(d.Category) && 
            d.Category.Equals(categoryToDelete, StringComparison.OrdinalIgnoreCase)).ToList();
        
        if (drugsUsingCategory.Count > 0)
        {
            // Prevent deletion - show error message
            _categoryErrorMessage = $"Cannot delete category. There {(drugsUsingCategory.Count == 1 ? "is" : "are")} {drugsUsingCategory.Count} drug{(drugsUsingCategory.Count == 1 ? "" : "s")} still using this category. Please update or remove those drugs before deleting.";
            Feedback.Warning(_categoryErrorMessage, "Category not deleted");
            StateHasChanged();
            return;
        }
        
        _categoryErrorMessage = string.Empty;
        try
        {
            var deletedCategory = _categoryToDelete;
            ViewModel.DeleteCategory(deletedCategory);
            _showDeleteCategoryModal = false;
            _categoryToDelete = string.Empty;
            Feedback.Success($"Category '{deletedCategory}' deleted.", "Category deleted");
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _categoryErrorMessage = ex.Message;
            Feedback.Error(_categoryErrorMessage, "Category not deleted");
            StateHasChanged();
        }
    }
    
    // Pagination Methods
    private IEnumerable<CaseNotePrescriptionBuilderViewModel.Drug> GetPaginatedDrugs()
    {
        if (ViewModel.FilteredDrugs == null || !ViewModel.FilteredDrugs.Any())
            return Enumerable.Empty<CaseNotePrescriptionBuilderViewModel.Drug>();
            
        var filtered = ViewModel.FilteredDrugs.ToList();
        var startIndex = (_currentPage - 1) * _itemsPerPage;
        return filtered.Skip(startIndex).Take(_itemsPerPage);
    }
    
    private int GetTotalPages()
    {
        if (ViewModel.FilteredDrugs == null || !ViewModel.FilteredDrugs.Any())
            return 0;
            
        var totalDrugs = ViewModel.FilteredDrugs.Count();
        return (int)Math.Ceiling((double)totalDrugs / _itemsPerPage);
    }
    
    private void GoToPage(int page)
    {
        if (page >= 1 && page <= GetTotalPages())
        {
            _currentPage = page;
            StateHasChanged();
        }
    }
    
    private void GoToNextPage()
    {
        if (_currentPage < GetTotalPages())
        {
            _currentPage++;
            StateHasChanged();
        }
    }
    
    private void GoToPreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            StateHasChanged();
        }
    }
    
