    private void CancelDelete()
    {
        _showDeleteModal = false;
        _drugToDeleteId = null;
        _drugToDeleteName = string.Empty;
        Feedback.Info("Medicine deletion cancelled.", "Delete cancelled", 1800);
        StateHasChanged();
