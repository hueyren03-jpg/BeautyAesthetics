    private async Task DownloadExcelTemplate()
    {
        try
        {
            var excelBytes = ViewModel.GenerateExcelTemplate();
            var fileName = $"Prescription_Template_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            
            await JS.InvokeVoidAsync("downloadFile", fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(excelBytes));
            Feedback.Success($"{fileName} downloaded.", "Template downloaded", 2400);
        }
        catch (Exception ex)
        {
            _showValidationError = true;
            _validationErrorMessage = $"Error generating template: {ex.Message}";
            Feedback.Error(_validationErrorMessage, "Template download failed");
            StateHasChanged();
        }
    }
    
    private async Task HandleExcelImport(InputFileChangeEventArgs e)
    {
        _showImportStatus = false;
        _showValidationError = false;
        _showSuccessMessage = false;
        
        var file = e.File;
        if (file == null) return;
        
        // Validate file size (max 5MB)
        const long maxFileSize = 5 * 1024 * 1024;
        if (file.Size > maxFileSize)
        {
            _showValidationError = true;
            _validationErrorMessage = "File size exceeds 5MB limit.";
            Feedback.Warning(_validationErrorMessage, "Import file too large");
            StateHasChanged();
            return;
        }
        
        // Validate file extension
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension != ".xlsx" && extension != ".xls")
        {
            _showValidationError = true;
            _validationErrorMessage = "Invalid file format. Please upload an Excel file (.xlsx or .xls).";
            Feedback.Warning(_validationErrorMessage, "Invalid import file");
            StateHasChanged();
            return;
        }

        try
        {
            // Show loading indicator immediately
            _isImportingExcel = true;
            _showImportStatus = true;
            _isImportSuccess = true;
            _importStatusMessage = "Importing Excel file...";
            await InvokeAsync(StateHasChanged);
            
            using var stream = file.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            
            List<CaseNotePrescriptionBuilderViewModel.Drug> importedDrugs;
            
            try
            {
                // Offload heavy Excel processing to background thread
                importedDrugs = await Task.Run(() => ViewModel.ImportDrugsFromExcel(memoryStream));
            }
            catch (InvalidOperationException ex)
            {
                // Handle validation errors (duplicates, missing fields, etc.)
                // Show errors in modal popup instead of inline message
                _importErrorMessage = ex.Message;
                _showImportErrorModal = true;
                Feedback.Error(_importErrorMessage, "Excel import failed");
                _showImportStatus = false;
                await InvokeAsync(StateHasChanged);
                return;
            }
            
            // Update UI with success message
            _isImportSuccess = true;
            _importStatusMessage = $"Successfully imported {importedDrugs.Count} drug(s) from Excel.";
            Feedback.Success(_importStatusMessage, "Excel import complete");
            await InvokeAsync(StateHasChanged);
            
            // Auto-hide success message after 3 seconds (in background)
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                _showImportStatus = false;
                await InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            // Handle unexpected errors - show in modal
            _importErrorMessage = $"Error importing Excel file: {ex.Message}";
            _showImportErrorModal = true;
            Feedback.Error(_importErrorMessage, "Excel import failed");
            _showImportStatus = false;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _isImportingExcel = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    
