@page "/templates/builder"
@using Beauty_Aesthetics_WebPos.Components.Layout
@layout EmptyLayout
@using Beauty_Aesthetics_WebPos.Components.ViewModels
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager NavigationManager
@inject DocumentTemplateViewModel TemplateViewModel

<PageTitle>Template Builder - Beauty Aesthetics</PageTitle>

<div class="template-builder-page">
    <!-- Header -->
    <header class="builder-header">
        <div class="header-left">
            <i class="bi bi-file-earmark-plus header-icon"></i>
            <h1 class="header-title">Template Builder</h1>
        </div>
        <div class="header-right">
            <a href="/documents" class="btn-close-header">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <div class="builder-content">
        <!-- Template Info Section -->
        <div class="template-info-section">
            <div class="section-card">
                <h2 class="section-title">Template Information</h2>
                <div class="form-row">
                    <div class="form-group">
                        <label>Template Name <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="ViewModel.TemplateName" @bind:event="oninput" @onkeypress="HandleTemplateNameKeyPress" placeholder="Enter template name" />
                        @if (string.IsNullOrWhiteSpace(ViewModel.TemplateName) && _showError)
                        {
                            <small style="color: #ef4444; font-size: 12px; margin-top: 4px; display: block;">Template name is required</small>
                        }
                    </div>
                    <div class="form-group">
                        <label>Document Type</label>
                        <select class="form-input" @bind="ViewModel.TemplateCategory">
                            @foreach (var docType in ViewModel.DocumentTypes.OrderBy(t => t))
                            {
                                <option value="@docType">@docType</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea class="form-textarea" @bind="ViewModel.TemplateDescription" @bind:event="oninput" rows="2" placeholder="Describe the purpose of this template..."></textarea>
                </div>
            </div>
        </div>

        <!-- Field Builder Section -->
        <div class="field-builder-section">
            <div class="builder-layout">
                <!-- Fields List Panel -->
                <div class="fields-panel">
                    <div class="section-card">
                        <div class="section-header">
                            <div>
                                <h2 class="section-title">Template Fields</h2>
                                <p class="section-subtitle">Click "Add Field" to start, then click any field to edit it.</p>
                            </div>
                            <button type="button" class="btn-add-field" @onclick="ShowFieldTypeSelector">
                                <i class="bi bi-plus-lg"></i>
                                <span>Add Field</span>
                            </button>
                        </div>

                        @if (ViewModel.TemplateFields.Any())
                        {
                            <div class="fields-list" id="fields-list">
                                @{
                                    var orderedFields = ViewModel.TemplateFields.OrderBy(f => f.Order).ToList();
                                }
                                @foreach (var field in orderedFields)
                                {
                                    var isSelected = _editingField?.Id == field.Id;
                                    var index = orderedFields.IndexOf(field);
                                    <div class="field-card @(isSelected ? "selected" : "")" 
                                         draggable="true"
                                         data-field-id="@field.Id"
                                         @ondragstart="(e) => OnDragStart(e, field.Id)"
                                         @ondragover="OnDragOver"
                                         @ondragover:preventDefault="true"
                                         @ondrop="(e) => OnDrop(e, field.Id)"
                                         @ondrop:preventDefault="true"
                                         @ondragend="OnDragEnd"
                                         @onclick="() => EditField(field)">
                                        <div class="field-card-header">
                                            <div class="field-card-drag-handle" @onclick:stopPropagation="true">
                                                <i class="bi bi-grip-vertical"></i>
                                            </div>
                                            <div class="field-card-order">
                                                <span>@field.Order</span>
                                            </div>
                                            <div class="field-card-info">
                                                <div class="field-card-title">
                                                    <i class="bi @GetFieldIcon(field.Type) field-icon"></i>
                                                    <span class="field-name">@field.Label</span>
                                                    @if (field.IsRequired)
                                                    {
                                                        <span class="required-badge">Required</span>
                                                    }
                                                </div>
                                                <div class="field-card-meta">
                                                    <span class="field-card-type">
                                                        <i class="bi @GetFieldIcon(field.Type)"></i>
                                                        @GetFieldTypeLabel(field.Type)
                                                    </span>
                                                    @if (!string.IsNullOrEmpty(field.Placeholder))
                                                    {
                                                        <span class="field-card-detail">
                                                            <i class="bi bi-quote"></i>
                                                            "@field.Placeholder"
                                                        </span>
                                                    }
                                                    @if (field.Options != null && field.Options.Any())
                                                    {
                                                        <span class="field-card-detail">
                                                            <i class="bi bi-list-ul"></i>
                                                            @field.Options.Count option@(field.Options.Count > 1 ? "s" : "")
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="field-card-actions" @onclick:stopPropagation="true">
                                                <button type="button" class="btn-card-action btn-edit" @onclick="() => EditField(field)" title="Edit Field">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button type="button" class="btn-card-action btn-delete" @onclick="() => ConfirmDeleteField(field.Id)" title="Delete Field">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            <!-- Quick Add Button -->
                            <div class="quick-add-section">
                                <button type="button" class="btn-add-field-quick" @onclick="ShowFieldTypeSelector">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>Add Another Field</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="empty-fields">
                                <div class="empty-fields-content">
                                    <div class="empty-icon-wrapper">
                                        <i class="bi bi-sliders2-empty"></i>
                                    </div>
                                    <h3 class="empty-title">Start Building Your Template</h3>
                                    <p class="empty-description">Create your first field to get started. You can add text inputs, dropdowns, dates, and more.</p>
                                    <button type="button" class="btn-add-field-primary" @onclick="ShowFieldTypeSelector">
                                        <i class="bi bi-plus-lg"></i>
                                        <span>Add Your First Field</span>
                                    </button>
                                    <div class="empty-tips">
                                        <div class="tip-item">
                                            <i class="bi bi-lightbulb"></i>
                                            <span>Tip: You can add fields like patient name, date of visit, treatment notes, and more.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Field Editor Modal -->
                @if (_showFieldEditor)
                {
                    <div class="modal-overlay">
                        <div class="modal-container field-editor-modal">
                            <div class="modal-header modal-header-add">
                                <i class="bi @(_editingField == null ? "bi-plus-circle" : "bi-pencil-square")"></i>
                                <div>
                                    <h3>@(_editingField == null ? "Add New Field" : "Edit Field")</h3>
                                    @if (_editingField != null)
                                    {
                                        <span class="modal-subtitle">Field #@_editingField.Order</span>
                                    }
                                </div>
                                <button type="button" class="btn-close-modal" @onclick="CloseFieldEditor" title="Close">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="modal-body field-editor-body">
                                <!-- Field Type Selection - Show First -->
                                <div class="config-section">
                                    <label class="config-label">
                                        <span class="label-with-icon">
                                            <i class="bi bi-sliders"></i>
                                            Field Type
                                        </span>
                                        @if (_editingField == null)
                                        {
                                            <div class="field-type-grid-compact">
                                                @foreach (var type in _fieldTypes)
                                                {
                                                    var isSelected = _fieldType == type.Type;
                                                    <button type="button" 
                                                            class="field-type-card-compact @(isSelected ? "selected" : "")" 
                                                            @onclick="() => SelectFieldType(type.Type)">
                                                        <i class="bi @type.Icon"></i>
                                                        <span>@type.Label</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="field-type-display-readonly">
                                                <i class="bi @GetFieldTypeIcon(_fieldType)"></i>
                                                <span>@GetFieldTypeLabel(_fieldType)</span>
                                            </div>
                                        }
                                    </label>
                                </div>

                                <!-- Field Label - Below Field Type -->
                                <div class="config-section highlight-section">
                                    <label class="config-label">
                                        <span class="label-with-icon">
                                            <i class="bi bi-tag"></i>
                                            Field Label <span class="required">*</span>
                                        </span>
                                        <input type="text" 
                                               class="config-input config-input-large" 
                                               @bind="_fieldLabel" 
                                               @bind:event="oninput" 
                                               @onkeypress="HandleFieldLabelKeyPress"
                                               placeholder="e.g., Patient Name, Date of Visit, Treatment Notes..." 
                                               autofocus />
                                    </label>
                                </div>

                                <!-- Required Toggle -->
                                <div class="config-section">
                                    <label class="config-checkbox-large">
                                        <input type="checkbox" @bind="_fieldRequired" />
                                        <div class="checkbox-content">
                                            <span class="checkbox-label">This field is required</span>
                                            <span class="checkbox-description">Users must fill this field before submitting</span>
                                        </div>
                                    </label>
                                </div>

                                <!-- Additional Options (Collapsible) -->
                                <div class="config-section">
                                    <button type="button" class="btn-toggle-advanced" @onclick="ToggleAdvancedOptions">
                                        <i class="bi bi-chevron-@(_showAdvancedOptions ? "up" : "down")"></i>
                                        <span>Advanced Options</span>
                                    </button>
                                </div>

                                @if (_showAdvancedOptions)
                                {
                                    <div class="advanced-options">
                                        <div class="config-section">
                                            <label class="config-label">
                                                <span>Placeholder Text</span>
                                                <input type="text" class="config-input" @bind="_fieldPlaceholder" @bind:event="oninput" @onkeypress="HandleFieldLabelKeyPress" placeholder="What users will see as a hint" />
                                            </label>
                                        </div>

                                        <div class="config-section">
                                            <label class="config-label">
                                                <span>Default Value</span>
                                                <input type="text" class="config-input" @bind="_fieldDefaultValue" @bind:event="oninput" @onkeypress="HandleFieldLabelKeyPress" placeholder="Pre-filled value (optional)" />
                                            </label>
                                        </div>

                                        <div class="config-section">
                                            <label class="config-label">
                                                <span>Help Text</span>
                                                <textarea class="config-textarea" @bind="_fieldHelpText" @bind:event="oninput" @onkeypress="HandleFieldLabelKeyPress" rows="2" placeholder="Additional guidance for users (optional)"></textarea>
                                            </label>
                                        </div>
                                    </div>
                                }

                                <!-- Options for Dropdown/Radio/Checkbox -->
                                @if (_fieldType == DocumentTemplateViewModel.FieldType.Dropdown || 
                                     _fieldType == DocumentTemplateViewModel.FieldType.Radio ||
                                     _fieldType == DocumentTemplateViewModel.FieldType.Checkbox)
                                {
                                    <div class="config-section options-section">
                                        <label class="config-label">
                                            <span class="label-with-icon">
                                                <i class="bi bi-list-ul"></i>
                                                Options <span class="required">*</span>
                                            </span>
                                            <div class="options-builder">
                                                @for (int i = 0; i < _fieldOptions.Count; i++)
                                                {
                                                    var index = i;
                                                    <div class="option-row">
                                                        <span class="option-number">@(index + 1)</span>
                                                        <input type="text" 
                                                               class="option-input" 
                                                               @bind="_fieldOptions[index]" 
                                                               @bind:event="oninput" 
                                                               placeholder="Option @(index + 1)" />
                                                        @if (_fieldOptions.Count > 1)
                                                        {
                                                            <button type="button" class="btn-remove-option" @onclick="() => RemoveOption(index)" title="Remove">
                                                                <i class="bi bi-x"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                                <button type="button" class="btn-add-option" @onclick="AddOption">
                                                    <i class="bi bi-plus"></i>
                                                    <span>Add Option</span>
                                                </button>
                                            </div>
                                        </label>
                                    </div>
                                }
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-modal-cancel" @onclick="CloseFieldEditor">
                                    <i class="bi bi-x-circle"></i>
                                    <span>Cancel</span>
                                </button>
                                <button type="button" class="btn-modal-save" @onclick="SaveField" disabled="@(!CanSaveField())">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>@(_editingField == null ? "Add Field" : "Save Changes")</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Actions -->
        <div class="builder-actions">
            <div class="builder-actions-buttons">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <button type="button" class="btn-cancel" @onclick="NavigateBack">
                        <i class="bi bi-x-circle"></i>
                        <span>Cancel</span>
                    </button>
                </div>
                <button type="button" class="btn-save" @onclick="async () => await SaveTemplate()" disabled="@(!CanSaveTemplate())">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Save Template</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Field Confirmation Modal -->
@if (_showDeleteConfirm && _fieldToDelete.HasValue)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <h3>Delete Field</h3>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this field?</p>
                <p class="modal-warning">This action cannot be undone. The field will be permanently removed from the template.</p>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CancelDelete">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-delete" @onclick="DeleteField">
                    <i class="bi bi-trash3-fill"></i>
                    <span>Delete Field</span>
                </button>
            </div>
        </div>
    </div>
}

<AppErrorPopup Title="Unable to save document template"
               Message="@(_showError ? _errorMessage : null)"
               OnDismiss="CloseError" />

@code {
    private DocumentTemplateViewModel ViewModel => TemplateViewModel;
    
    // Field Editor State
    private bool _showFieldEditor = false;
    private bool _showAdvancedOptions = false;
    private DocumentTemplateViewModel.TemplateField? _editingField = null;
    private string _fieldLabel = "";
    private DocumentTemplateViewModel.FieldType _fieldType = DocumentTemplateViewModel.FieldType.Text;
    private bool _fieldRequired = false;
    private string _fieldPlaceholder = "";
    private string _fieldDefaultValue = "";
    private string _fieldHelpText = "";
    private List<string> _fieldOptions = new();
    
    // Error handling
    private bool _showError = false;
    private string _errorMessage = "";

    // Field types with icons - Reordered: Text, Phone, Email, then others
    private readonly List<(DocumentTemplateViewModel.FieldType Type, string Label, string Icon)> _fieldTypes = new()
    {
        (DocumentTemplateViewModel.FieldType.Text, "Text", "bi-type"),
        (DocumentTemplateViewModel.FieldType.Phone, "Phone", "bi-telephone"),
        (DocumentTemplateViewModel.FieldType.Email, "Email", "bi-envelope"),
        (DocumentTemplateViewModel.FieldType.TextArea, "Text Area", "bi-textarea-resize"),
        (DocumentTemplateViewModel.FieldType.Number, "Number", "bi-123"),
        (DocumentTemplateViewModel.FieldType.Date, "Date", "bi-calendar3"),
        (DocumentTemplateViewModel.FieldType.DateTime, "Date & Time", "bi-calendar-event"),
        (DocumentTemplateViewModel.FieldType.Time, "Time", "bi-clock"),
        (DocumentTemplateViewModel.FieldType.Dropdown, "Dropdown", "bi-list-ul"),
        (DocumentTemplateViewModel.FieldType.Radio, "Radio", "bi-circle"),
        (DocumentTemplateViewModel.FieldType.Checkbox, "Checkbox", "bi-check-square")
    };


    protected override void OnInitialized()
    {
        // Only start a new template if there's no template being edited
        if (ViewModel.TemplateBeingEdited == null)
        {
            ViewModel.StartNewTemplate();
        }
        // If editing a template, the EditTemplate method should have already populated
        // TemplateName, TemplateCategory, TemplateDescription, and TemplateFields
    }
    
    protected override void OnAfterRender(bool firstRender)
    {
        // Ensure template data is loaded if editing
        if (firstRender && ViewModel.TemplateBeingEdited != null)
        {
            // Force UI update to reflect the template being edited
            StateHasChanged();
        }
    }

    private void ShowFieldTypeSelector()
    {
        _editingField = null;
        ResetFieldForm();
        _fieldType = DocumentTemplateViewModel.FieldType.Text;
        _showAdvancedOptions = false;
        _showFieldEditor = true;
        StateHasChanged();
    }

    private void SelectFieldType(DocumentTemplateViewModel.FieldType type)
    {
        _fieldType = type;
        if ((type == DocumentTemplateViewModel.FieldType.Dropdown || 
             type == DocumentTemplateViewModel.FieldType.Radio ||
             type == DocumentTemplateViewModel.FieldType.Checkbox) && 
            !_fieldOptions.Any())
        {
            _fieldOptions = new List<string> { "" };
        }
        StateHasChanged();
    }

    private void ToggleAdvancedOptions()
    {
        _showAdvancedOptions = !_showAdvancedOptions;
        StateHasChanged();
    }

    private void EditField(DocumentTemplateViewModel.TemplateField field)
    {
        _editingField = field;
        _fieldLabel = field.Label;
        _fieldType = field.Type;
        _fieldRequired = field.IsRequired;
        _fieldPlaceholder = field.Placeholder ?? "";
        _fieldDefaultValue = field.DefaultValue ?? "";
        _fieldHelpText = field.HelpText ?? "";
        _fieldOptions = field.Options?.ToList() ?? new List<string>();
        if ((_fieldType == DocumentTemplateViewModel.FieldType.Dropdown || 
             _fieldType == DocumentTemplateViewModel.FieldType.Radio ||
             _fieldType == DocumentTemplateViewModel.FieldType.Checkbox) && 
            (_fieldOptions == null || !_fieldOptions.Any()))
        {
            _fieldOptions = new List<string> { "" };
        }
        _showAdvancedOptions = !string.IsNullOrEmpty(_fieldPlaceholder) || 
                               !string.IsNullOrEmpty(_fieldDefaultValue) || 
                               !string.IsNullOrEmpty(_fieldHelpText);
        _showFieldEditor = true;
        StateHasChanged();
    }

    private void CloseFieldEditor()
    {
        _showFieldEditor = false;
        _editingField = null;
        _showAdvancedOptions = false;
        ResetFieldForm();
    }

    private void ResetFieldForm()
    {
        _fieldLabel = "";
        _fieldType = DocumentTemplateViewModel.FieldType.Text;
        _fieldRequired = false;
        _fieldPlaceholder = "";
        _fieldDefaultValue = "";
        _fieldHelpText = "";
        _fieldOptions = new List<string>();
    }


    private void AddOption()
    {
        _fieldOptions.Add("");
    }

    private void RemoveOption(int index)
    {
        if (_fieldOptions.Count > index)
        {
            _fieldOptions.RemoveAt(index);
        }
    }

    private bool CanSaveField()
    {
        if (string.IsNullOrWhiteSpace(_fieldLabel))
            return false;
        
        if ((_fieldType == DocumentTemplateViewModel.FieldType.Dropdown || 
             _fieldType == DocumentTemplateViewModel.FieldType.Radio ||
             _fieldType == DocumentTemplateViewModel.FieldType.Checkbox) && 
            (!_fieldOptions.Any() || _fieldOptions.All(string.IsNullOrWhiteSpace)))
            return false;
        
        return true;
    }

    private void HandleTemplateNameKeyPress(KeyboardEventArgs e)
    {
        // When Enter is pressed in template name, move focus to the first field or add field button
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(ViewModel.TemplateName))
        {
            // Try to open the Add Field modal
            ShowFieldTypeSelector();
        }
    }

    private void HandleFieldLabelKeyPress(KeyboardEventArgs e)
    {
        // Save field when Enter is pressed
        if (e.Key == "Enter" && CanSaveField())
        {
            SaveField();
        }
    }

    private void SaveField()
    {
        if (!CanSaveField())
            return;

        var options = (_fieldType == DocumentTemplateViewModel.FieldType.Dropdown || 
                       _fieldType == DocumentTemplateViewModel.FieldType.Radio ||
                       _fieldType == DocumentTemplateViewModel.FieldType.Checkbox)
            ? _fieldOptions.Where(o => !string.IsNullOrWhiteSpace(o)).ToList()
            : null;

        var nextFieldId = ViewModel.TemplateFields.Any() 
            ? ViewModel.TemplateFields.Max(f => f.Id) + 1 
            : 1;

        var order = _editingField?.Order ?? (ViewModel.TemplateFields.Any() 
            ? ViewModel.TemplateFields.Max(f => f.Order) + 1 
            : 1);

        var field = new DocumentTemplateViewModel.TemplateField(
            _editingField?.Id ?? nextFieldId,
            _fieldLabel.Trim(),
            _fieldType,
            _fieldRequired,
            order,
            string.IsNullOrWhiteSpace(_fieldPlaceholder) ? null : _fieldPlaceholder.Trim(),
            string.IsNullOrWhiteSpace(_fieldDefaultValue) ? null : _fieldDefaultValue.Trim(),
            options?.Any() == true ? options : null,
            null,
            string.IsNullOrWhiteSpace(_fieldHelpText) ? null : _fieldHelpText.Trim()
        );

        if (_editingField != null)
        {
            ViewModel.UpdateField(_editingField.Id, field);
        }
        else
        {
            ViewModel.AddField(field);
        }

        CloseFieldEditor();
        StateHasChanged();
    }

    // Delete confirmation state
    private bool _showDeleteConfirm = false;
    private int? _fieldToDelete = null;
    
    private void ConfirmDeleteField(int fieldId)
    {
        _fieldToDelete = fieldId;
        _showDeleteConfirm = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
        _fieldToDelete = null;
        StateHasChanged();
    }

    private void DeleteField()
    {
        if (_fieldToDelete.HasValue)
        {
            var fieldId = _fieldToDelete.Value;
            ViewModel.RemoveField(fieldId);
            if (_editingField?.Id == fieldId)
            {
                CloseFieldEditor();
            }
            _showDeleteConfirm = false;
            _fieldToDelete = null;
            StateHasChanged();
        }
    }

    private void RemoveField(int fieldId)
    {
        try
        {
            ViewModel.RemoveField(fieldId);
            if (_editingField?.Id == fieldId)
            {
                CloseFieldEditor();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing field {fieldId}: {ex.Message}");
        }
    }

    private bool CanSaveTemplate()
    {
        // Only check if there are fields, don't block button if template name is missing
        // Validation will show error message when SaveTemplate() is called
        return ViewModel.TemplateFields.Any();
    }

    private async Task SaveTemplate()
    {
        // Clear previous errors
        _showError = false;
        _errorMessage = "";
        
        // Get current values
        var templateName = ViewModel.TemplateName?.Trim() ?? "";
        var fieldCount = ViewModel.TemplateFields?.Count ?? 0;
        
        // Validate template name is not empty
        if (string.IsNullOrWhiteSpace(templateName))
        {
            _errorMessage = "Template name is required.";
            _showError = true;
            StateHasChanged();
            return;
        }

        // Validate at least one field exists
        if (fieldCount == 0)
        {
            _errorMessage = "Please add at least one field to the template.";
            _showError = true;
            StateHasChanged();
            return;
        }

        try
        {
            // Save the template
            var template = ViewModel.SaveTemplate();
            
            // Auto-save to localStorage
            await ViewModel.SaveTemplatesToStorageAsync();
            
            // Verify template was saved
            if (template == null)
            {
                _errorMessage = "Failed to save template. Please try again.";
                _showError = true;
                StateHasChanged();
                return;
            }
            
            // Verify it's in the list
            var savedTemplates = ViewModel.CustomTemplates;
            if (!savedTemplates.Any(t => t.Id == template.Id && t.Name == template.Name))
            {
                _errorMessage = "Template saved but not found in list. Please check the templates page.";
                _showError = true;
                StateHasChanged();
                return;
            }
            
            // Success - navigate to documents page after a brief delay
            await Task.Delay(300);
            NavigationManager.NavigateTo("/documents");
        }
        catch (InvalidOperationException ex)
        {
            // Show validation error to user
            _errorMessage = ex.Message;
            _showError = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Show error to user
            _errorMessage = $"Error saving template: {ex.Message}";
            _showError = true;
            StateHasChanged();
        }
    }

    private void CloseError()
    {
        _showError = false;
        _errorMessage = "";
        StateHasChanged();
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/documents");
    }

    private string GetFieldTypeLabel(DocumentTemplateViewModel.FieldType type)
    {
        return type switch
        {
            DocumentTemplateViewModel.FieldType.Text => "Text",
            DocumentTemplateViewModel.FieldType.TextArea => "Text Area",
            DocumentTemplateViewModel.FieldType.Number => "Number",
            DocumentTemplateViewModel.FieldType.Date => "Date",
            DocumentTemplateViewModel.FieldType.DateTime => "Date & Time",
            DocumentTemplateViewModel.FieldType.Time => "Time",
            DocumentTemplateViewModel.FieldType.Dropdown => "Dropdown",
            DocumentTemplateViewModel.FieldType.Radio => "Radio",
            DocumentTemplateViewModel.FieldType.Checkbox => "Checkbox",
            DocumentTemplateViewModel.FieldType.Email => "Email",
            DocumentTemplateViewModel.FieldType.Phone => "Phone",
            _ => "Text"
        };
    }

    private string GetFieldIcon(DocumentTemplateViewModel.FieldType type)
    {
        var fieldType = _fieldTypes.FirstOrDefault(t => t.Type == type);
        return fieldType != default ? fieldType.Icon : "bi-type";
    }

    private string GetFieldTypeIcon(DocumentTemplateViewModel.FieldType type)
    {
        return GetFieldIcon(type);
    }

    // Drag and Drop handlers
    private int? _draggedFieldId = null;

    private void OnDragStart(DragEventArgs e, int fieldId)
    {
        _draggedFieldId = fieldId;
        if (e.DataTransfer != null)
        {
            e.DataTransfer.EffectAllowed = "move";
        }
    }

    private void OnDragOver(DragEventArgs e)
    {
        // PreventDefault is handled by @ondragover:preventDefault="true" attribute
        // Set drop effect
        if (e.DataTransfer != null)
        {
            e.DataTransfer.DropEffect = "move";
        }
    }

    private void OnDrop(DragEventArgs e, int targetFieldId)
    {
        // PreventDefault is handled by @ondrop:preventDefault="true" attribute
        
        if (_draggedFieldId == null || _draggedFieldId == targetFieldId)
        {
            _draggedFieldId = null;
            return;
        }

        var draggedField = ViewModel.TemplateFields.FirstOrDefault(f => f.Id == _draggedFieldId);
        var targetField = ViewModel.TemplateFields.FirstOrDefault(f => f.Id == targetFieldId);

        if (draggedField != null && targetField != null)
        {
            var draggedOrder = draggedField.Order;
            var targetOrder = targetField.Order;

            // Update dragged field
            var updatedDragged = draggedField with { Order = targetOrder };
            ViewModel.UpdateField(draggedField.Id, updatedDragged);

            // Update target field
            var updatedTarget = targetField with { Order = draggedOrder };
            ViewModel.UpdateField(targetField.Id, updatedTarget);

            StateHasChanged();
        }

        _draggedFieldId = null;
    }

    private void OnDragEnd(DragEventArgs e)
    {
        _draggedFieldId = null;
    }
}


