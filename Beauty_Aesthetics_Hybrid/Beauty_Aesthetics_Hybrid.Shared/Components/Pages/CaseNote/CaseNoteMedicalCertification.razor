        return hour == 0 ? 12 : hour;
    }

    private void SetStartHour(int hour)
    {
        bool isPM = ViewModel.TimeOffStartTime.Hour >= 12;
        int hour24 = hour == 12 ? (isPM ? 12 : 0) : (isPM ? hour + 12 : hour);
        ViewModel.TimeOffStartTime = new TimeOnly(hour24, ViewModel.TimeOffStartTime.Minute);
    }

    private void SetStartMinute(int minute)
    {
        ViewModel.TimeOffStartTime = new TimeOnly(ViewModel.TimeOffStartTime.Hour, minute);
    }

    private void SetStartPeriod(bool isAM)
    {
        int currentHour = ViewModel.TimeOffStartTime.Hour;
        int hour12 = currentHour % 12;
        int newHour = isAM ? hour12 : (hour12 + 12);
        if (hour12 == 0 && isAM) newHour = 0;
        if (hour12 == 0 && !isAM) newHour = 12;
        ViewModel.TimeOffStartTime = new TimeOnly(newHour, ViewModel.TimeOffStartTime.Minute);
    }

    private void SetEndHour(int hour)
    {
        bool isPM = ViewModel.TimeOffEndTime.Hour >= 12;
        int hour24 = hour == 12 ? (isPM ? 12 : 0) : (isPM ? hour + 12 : hour);
        ViewModel.TimeOffEndTime = new TimeOnly(hour24, ViewModel.TimeOffEndTime.Minute);
