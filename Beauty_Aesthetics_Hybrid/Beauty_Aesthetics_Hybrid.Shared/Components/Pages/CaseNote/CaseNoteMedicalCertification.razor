@page "/case-note-medical-certification"
@using Beauty_Aesthetics_WebPos.Components.Layout
@layout EmptyLayout
@using Beauty_Aesthetics_WebPos.Components.ViewModels
@implements IDisposable
@inject IJSRuntime JS
@inject AppFeedbackService Feedback
@inject Beauty_Aesthetics_WebPos.Components.Services.Clinical.ClinicalPatientContext PatientContext
@inject Beauty_Aesthetics_WebPos.Components.Services.Clinical.IMedicalCertificateService MedicalCertificateService
@inject Beauty_Aesthetics_WebPos.Components.Services.Branches.IBranchSessionService BranchSession

<PageTitle>Medical Certificate</PageTitle>

<div class="mc-container">
    @if (_isPageInitializing)
    {
        <div class="case-module-page-loading" role="status" aria-live="polite">
            <div class="case-module-page-loading__content">
                <span class="spinner-border" aria-hidden="true"></span>
                <span>Loading medical certificate...</span>
            </div>
        </div>
    }
    <!-- Tab Navigation -->
    <div class="tab-navigation">
        <button 
            class="tab-button @(ViewModel.ActiveTab == "day-off" ? "active" : "")"
            @onclick='() => ViewModel.SetTab("day-off")'>
            <i class="bi bi-calendar-x"></i>
            <span>Day-Off Slip</span>
        </button>
        <button 
            class="tab-button @(ViewModel.ActiveTab == "time-off" ? "active" : "")"
            @onclick='() => ViewModel.SetTab("time-off")'>
            <i class="bi bi-clock-history"></i>
            <span>Time-Off Slip</span>
        </button>

        <button type="button" class="mc-history-trigger" @onclick="OpenHistoryModal" title="Medical certificate history">
            <i class="bi bi-clock-history"></i>
            <span>History</span>
            @if (_certificateHistory.Count > 0)
            {
                <span class="mc-history-count">@_certificateHistory.Count</span>
            }
        </button>

        <a href="@(PatientContext.WithCustomer("/case-notes"))" class="btn-close">
            <i class="bi bi-x-lg"></i>
        </a>
    </div>

    <!-- Status Message -->
    @if (!string.IsNullOrEmpty(ViewModel.StatusMessage))
    {
        <div class="status-banner @(ViewModel.IsSuccess ? "status-success" : "status-error")">
            <i class="bi @(ViewModel.IsSuccess ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
            <span>@ViewModel.StatusMessage</span>
            <button class="btn-dismiss" @onclick="DismissMessage">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <!-- Tab Content -->
    <div class="tab-content">
        @if (ViewModel.ActiveTab == "day-off")
        {
            <!-- Day-Off Slip Tab -->
            <div class="form-panel">
                <div class="form-content">
                    <!-- Patient Name -->
                    <div class="form-group">
                        <label class="form-label">Patient Name <span class="required">*</span></label>
                        <input 
                            type="text" 
                            class="form-input" 
                            placeholder="Patient from appointment"
                            @bind="ViewModel.PatientName"
                            @bind:event="oninput"
                            readonly />
                    </div>

                    <!-- Date Range -->
                    <div class="form-group">
                        <label class="form-label">Start Date</label>
                        <div class="date-input-wrapper">
                            <i class="bi bi-calendar3 date-icon"></i>
                            <input 
                                type="date" 
                                class="form-input date-input" 
                                @bind="ViewModel.DayOffStartDate" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">End Date</label>
                        <div class="date-input-wrapper">
                            <i class="bi bi-calendar3 date-icon"></i>
                            <input 
                                type="date" 
                                class="form-input date-input" 
                                @bind="ViewModel.DayOffEndDate" />
                        </div>
                    </div>

                    <!-- Duration Display -->
                    <div class="duration-card">
                        <div class="duration-content">
                            <div class="duration-info">
                                <span class="duration-label">Duration:</span>
                                <span class="duration-value">@ViewModel.DurationDays @(ViewModel.DurationDays == 1 ? "Day" : "Days")@(ViewModel.IncludeHalfDay ? " + 0.5 Day" : "")</span>
                            </div>
                            <label class="checkbox-label">
                                <input 
                                    type="checkbox" 
                                    class="checkbox-input"
                                    @bind="ViewModel.IncludeHalfDay" />
                                <span class="checkbox-text">Add Half Day</span>
                            </label>
                        </div>
                    </div>

                    <!-- Reason -->
                    <div class="form-group">
                        <div class="reason-heading">
                            <label class="form-label">Reason <span class="required">*</span></label>
                            <a href="@(PatientContext.WithCustomer("/reason-manager"))" class="btn-manage-reasons" title="Manage Custom Reasons">
                                <i class="bi bi-gear"></i>
                                <span>Manage reasons</span>
                            </a>
                        </div>
                        
                        <!-- Predefined Reasons Buttons -->
                        <div class="reason-buttons">
                            @foreach (var reason in _customReasons)
                            {
                                <button 
                                    type="button"
                                    class="btn-reason"
                                    @onclick="() => ViewModel.SetDayOffPredefinedReason(reason.Value)">
                                    <i class="bi bi-file-text"></i>
                                    @reason.Key
                                </button>
                            }
                        </div>

                        <textarea 
                            class="form-textarea" 
                            rows="4"
                            placeholder="Enter reason for day-off or select from predefined reasons above..."
                            @bind="ViewModel.DayOffReason"
                            @bind:event="oninput"></textarea>
                    </div>

                    <!-- Actions -->
                    <div class="form-actions">
                        <button 
                            class="btn-reset"
                            @onclick="ViewModel.ResetDayOff">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Reset
                        </button>
                        <button 
                            class="btn-submit"
                            @onclick="PreviewDayOffMC"
                            disabled="@(!ViewModel.CanSubmitDayOff())">
                            <i class="bi bi-file-earmark-text"></i>
                            Generate Certificate
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Time-Off Slip Tab -->
            <div class="form-panel">
                <div class="form-content">
                    <!-- Patient Name -->
                    <div class="form-group">
                        <label class="form-label">Patient Name <span class="required">*</span></label>
                        <input 
                            type="text" 
                            class="form-input" 
                            placeholder="Patient from appointment"
                            @bind="ViewModel.PatientName"
                            @bind:event="oninput"
                            readonly />
                    </div>

                    <!-- Start Date -->
                    <div class="form-group">
                        <label class="form-label">Start Date</label>
                        <div class="date-input-wrapper">
                            <i class="bi bi-calendar3 date-icon"></i>
                            <input 
                                type="date" 
                                class="form-input date-input" 
                                @bind="ViewModel.TimeOffStartDate" />
                        </div>
                    </div>

                    <!-- Start & End Time -->
                    <div class="datetime-row">
                        <div class="form-group">
                            <label class="form-label">Start Time</label>
                            <div class="custom-time-picker">
                                <button type="button" class="time-display-btn" @onclick="() => ToggleTimePicker(true)">
                                    <i class="bi bi-clock"></i>
                                    <span>@FormatTime(ViewModel.TimeOffStartTime)</span>
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                                
                                @if (_showStartTimePicker)
                                {
                                    <div class="time-picker-dropdown">
                                        <div class="time-picker-header">
                                            <span>Select Start Time</span>
                                            <button type="button" class="btn-close-picker" @onclick="() => _showStartTimePicker = false">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                        <div class="time-picker-body">
                                            <div class="time-column">
                                                <label class="column-label">Hour</label>
                                                <div class="time-options">
                                                    @for (int h = 1; h <= 12; h++)
                                                    {
                                                        var hour = h;
                                                        var isSelected = GetHour12(ViewModel.TimeOffStartTime) == hour;
                                                        <button type="button" 
                                                                class="time-option @(isSelected ? "selected" : "")"
                                                                @onclick="() => SetStartHour(hour)">
                                                            @hour.ToString("00")
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="time-column">
                                                <label class="column-label">Minute</label>
                                                <div class="time-options">
                                                    @foreach (var min in new[] { 0, 15, 30, 45 })
                                                    {
                                                        var minute = min;
                                                        var isSelected = ViewModel.TimeOffStartTime.Minute == minute;
                                                        <button type="button" 
                                                                class="time-option @(isSelected ? "selected" : "")"
                                                                @onclick="() => SetStartMinute(minute)">
                                                            @minute.ToString("00")
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="time-column">
                                                <label class="column-label">Period</label>
                                                <div class="time-options">
                                                    <button type="button" 
                                                            class="time-option period-option @(ViewModel.TimeOffStartTime.Hour < 12 ? "selected" : "")"
                                                            @onclick="() => SetStartPeriod(true)">
                                                        AM
                                                    </button>
                                                    <button type="button" 
                                                            class="time-option period-option @(ViewModel.TimeOffStartTime.Hour >= 12 ? "selected" : "")"
                                                            @onclick="() => SetStartPeriod(false)">
                                                        PM
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">End Time</label>
                            <div class="custom-time-picker">
                                <button type="button" class="time-display-btn" @onclick="() => ToggleTimePicker(false)">
                                    <i class="bi bi-clock"></i>
                                    <span>@FormatTime(ViewModel.TimeOffEndTime)</span>
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                                
                                @if (_showEndTimePicker)
                                {
                                    <div class="time-picker-dropdown">
                                        <div class="time-picker-header">
                                            <span>Select End Time</span>
                                            <button type="button" class="btn-close-picker" @onclick="() => _showEndTimePicker = false">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                        <div class="time-picker-body">
                                            <div class="time-column">
                                                <label class="column-label">Hour</label>
                                                <div class="time-options">
                                                    @for (int h = 1; h <= 12; h++)
                                                    {
                                                        var hour = h;
                                                        var isSelected = GetHour12(ViewModel.TimeOffEndTime) == hour;
                                                        <button type="button" 
                                                                class="time-option @(isSelected ? "selected" : "")"
                                                                @onclick="() => SetEndHour(hour)">
                                                            @hour.ToString("00")
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="time-column">
                                                <label class="column-label">Minute</label>
                                                <div class="time-options">
                                                    @foreach (var min in new[] { 0, 15, 30, 45 })
                                                    {
                                                        var minute = min;
                                                        var isSelected = ViewModel.TimeOffEndTime.Minute == minute;
                                                        <button type="button" 
                                                                class="time-option @(isSelected ? "selected" : "")"
                                                                @onclick="() => SetEndMinute(minute)">
                                                            @minute.ToString("00")
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="time-column">
                                                <label class="column-label">Period</label>
                                                <div class="time-options">
                                                    <button type="button" 
                                                            class="time-option period-option @(ViewModel.TimeOffEndTime.Hour < 12 ? "selected" : "")"
                                                            @onclick="() => SetEndPeriod(true)">
                                                        AM
                                                    </button>
                                                    <button type="button" 
                                                            class="time-option period-option @(ViewModel.TimeOffEndTime.Hour >= 12 ? "selected" : "")"
                                                            @onclick="() => SetEndPeriod(false)">
                                                        PM
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Duration Display -->
                    <div class="duration-card">
                        <div class="duration-content">
                            <div class="duration-info">
                                <span class="duration-label">Duration:</span>
                                <span class="duration-value">@ViewModel.DurationHours @(ViewModel.DurationHours == 1 ? "Hour" : "Hours")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Reason -->
                    <div class="form-group">
                        <div class="reason-heading">
                            <label class="form-label">Reason <span class="required">*</span></label>
                            <a href="@(PatientContext.WithCustomer("/reason-manager"))" class="btn-manage-reasons" title="Manage Custom Reasons">
                                <i class="bi bi-gear"></i>
                                <span>Manage reasons</span>
                            </a>
                        </div>
                        
                        <!-- Predefined Reasons Buttons -->
                        <div class="reason-buttons">
                            @foreach (var reason in _customReasons)
                            {
                                <button 
                                    type="button"
                                    class="btn-reason"
                                    @onclick="() => ViewModel.SetTimeOffPredefinedReason(reason.Value)">
                                    <i class="bi bi-file-text"></i>
                                    @reason.Key
                                </button>
                            }
                        </div>

                        <textarea 
                            class="form-textarea" 
                            rows="4"
                            placeholder="Enter reason for time-off or select from predefined reasons above..."
                            @bind="ViewModel.TimeOffReason"
                            @bind:event="oninput"></textarea>
                    </div>

                    <!-- Actions -->
                    <div class="form-actions">
                        <button 
                            class="btn-reset"
                            @onclick="ViewModel.ResetTimeOff">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Reset
                        </button>
                        <button 
                            class="btn-submit"
                            @onclick="PreviewTimeOffMC"
                            disabled="@(!ViewModel.CanSubmitTimeOff())">
                            <i class="bi bi-file-earmark-text"></i>
                            Generate Certificate
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Medical Certificate History Modal -->
@if (_showHistoryModal)
{
    <div class="modal-overlay" @onclick="CloseHistoryModal">
        <div class="modal-container mc-history-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">
                    <i class="bi bi-clock-history"></i>
                    Medical Certificate History
                </h2>
                <button class="btn-close-modal" @onclick="CloseHistoryModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body mc-history-body">
                @if (_isHistoryLoading)
                {
                    <div class="mc-history-empty">
                        <span class="spinner-border" aria-hidden="true"></span>
                        <strong>Loading certificate history...</strong>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_historyError))
                {
                    <div class="mc-history-empty is-error">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Unable to load history</strong>
                        <span>@_historyError</span>
                        <button type="button" class="btn-secondary" @onclick="LoadCertificateHistoryAsync">Retry</button>
                    </div>
                }
                else if (_certificateHistory.Count == 0)
                {
                    <div class="mc-history-empty">
                        <i class="bi bi-file-earmark-medical"></i>
                        <strong>No medical certificates yet</strong>
                        <span>Issued certificates for this patient will appear here.</span>
                    </div>
                }
                else
                {
                    <div class="mc-history-list">
                        @foreach (var certificate in _certificateHistory)
                        {
                            <article class="mc-history-card">
                                <div class="mc-history-card-icon">
                                    <i class="bi @(certificate.CertificateType == "time-off" ? "bi-clock-history" : "bi-calendar2-check")"></i>
                                </div>
                                <div class="mc-history-card-copy">
                                    <div class="mc-history-card-top">
                                        <strong>@certificate.CertificateNumber</strong>
                                        <span>@CertificateTypeLabel(certificate.CertificateType)</span>
                                    </div>
                                    <small>@certificate.IssuedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                                    <p>@certificate.Reason</p>
                                    <div class="mc-history-meta">
                                        <span><i class="bi bi-person-badge"></i> @certificate.DoctorName</span>
                                        <span><i class="bi bi-calendar-range"></i> @certificate.DurationText</span>
                                    </div>
                                </div>
                                <div class="mc-history-card-actions">
                                    <button type="button" class="mc-history-action" @onclick="() => OpenSavedCertificate(certificate)">
                                        <i class="bi bi-eye"></i>
                                        <span>Open</span>
                                    </button>
                                    <button type="button" class="mc-history-action danger" @onclick="() => DeleteCertificateAsync(certificate)">
                                        <i class="bi bi-trash3"></i>
                                        <span>Delete</span>
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Preview Modal -->
@if (_showPreviewModal)
{
    <div class="modal-overlay" @onclick="ClosePreviewModal">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">
                    <i class="bi bi-file-earmark-medical"></i>
                    Medical Certificate Preview
                </h2>
                <button class="btn-close-modal" @onclick="ClosePreviewModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body">
                <!-- Doctor Details Section -->
                <div class="doctor-details-section">
                    <h3 class="section-title">
                        <i class="bi bi-person-badge"></i>
                        Doctor Information
                    </h3>
                    <div class="doctor-form">
                        <div class="form-group">
                            <label class="form-label">Doctor Name <span class="required">*</span></label>
                            <input 
                                type="text" 
                                class="form-input" 
                                placeholder="Dr. John Smith"
                                @bind="_doctorName"
                                @bind:event="oninput" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Registration Number <span class="required">*</span></label>
                            <input
                                type="text"
                                class="form-input"
                                placeholder="Enter practitioner registration number"
                                @bind="_doctorRegNumber"
                                @bind:event="oninput" />
                            <small class="form-hint">Use the practitioner's actual registration number.</small>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Digital Signature <span class="required">*</span></label>
                            @if (string.IsNullOrWhiteSpace(_signatureDataUrl))
                            {
                                <button type="button" class="btn-open-signature" @onclick="OpenSignatureModal">
                                    <i class="bi bi-pen"></i>
                                    <span>Click to Sign</span>
                                </button>
                                <small class="form-hint">Click to open signature pad</small>
                            }
                            else
                            {
                                <div class="signature-preview-container">
                                    <img src="@_signatureDataUrl" class="signature-preview-image" alt="Your Signature" />
                                    <button type="button" class="btn-change-signature" @onclick="OpenSignatureModal">
                                        <i class="bi bi-pen"></i>
                                        Change Signature
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Certificate Preview -->
                <div class="certificate-preview-section">
                    <h3 class="section-title">
                        <i class="bi bi-eye"></i>
                        Certificate Preview
                    </h3>
                    <div class="certificate-preview-wrapper">
                        <div class="mc-document preview-mode">
                            <div class="mc-header">
                                <h1 class="mc-title">MEDICAL CERTIFICATE</h1>
                                <p class="mc-clinic-name">Beauty Aesthetics Clinic</p>
                                <p class="mc-clinic-address">123 Medical Drive, Healthcare Center</p>
                                <p class="mc-clinic-contact">Tel: (555) 123-4567 | Email: clinic@beautyaesthetics.com</p>
                            </div>

                            <div class="mc-body">
                                <div class="mc-cert-number">
                                    <strong>Certificate No:</strong> @_previewCertNumber
                                </div>
                                <div class="mc-date-issued">
                                    <strong>Date Issued:</strong> @_previewDateIssued
                                </div>

                                <div class="mc-content">
                                    <p class="mc-intro">This is to certify that:</p>

                                    <div class="mc-info-section">
                                        <div class="mc-info-row">
                                            <span class="mc-info-label">Patient Name:</span>
                                            <span class="mc-info-value">@(string.IsNullOrWhiteSpace(ViewModel.PatientName) ? "[Patient Name]" : ViewModel.PatientName)</span>
                                        </div>

                                        <div class="mc-info-row">
                                            <span class="mc-info-label">Medical Status:</span>
                                            <span class="mc-info-value">@_previewBodyText</span>
                                        </div>

                                        <div class="mc-info-row">
                                            <span class="mc-info-label">Period:</span>
                                            <span class="mc-info-value">@_previewPeriod</span>
                                        </div>

                                        <div class="mc-info-row">
                                            <span class="mc-info-label">Duration:</span>
                                            <span class="mc-info-value">@_previewDuration</span>
                                        </div>

                                        <div class="mc-info-row">
                                            <span class="mc-info-label">Reason:</span>
                                            <span class="mc-info-value">@_previewReason</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mc-footer">
                                    <div class="mc-signature">
                                        @if (!string.IsNullOrWhiteSpace(_signatureDataUrl))
                                        {
                                            <img src="@_signatureDataUrl" class="signature-image" alt="Doctor's Signature" />
                                        }
                                        else
                                        {
                                            <div class="signature-line"></div>
                                        }
                                        <p class="signature-label">@(string.IsNullOrWhiteSpace(_doctorName) ? "Dr. [Doctor Name]" : _doctorName)</p>
                                        <p class="signature-title">Medical Practitioner</p>
                                        <p class="signature-reg">Registration No: @_doctorRegNumber</p>
                                    </div>
                                    
                                    <div class="mc-stamp">
                                        <div class="stamp-box">
                                            <p>OFFICIAL</p>
                                            <p>CLINIC STAMP</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mc-disclaimer">
                                <p>This medical certificate is issued based on medical examination and professional judgment. 
                                It is valid only for the period stated above. Any alteration will render this certificate invalid.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-secondary" @onclick="ClosePreviewModal">
                    <i class="bi bi-x-circle"></i>
                    Cancel
                </button>
                <button
                    class="btn-primary"
                    @onclick="PrintCertificate"
                    disabled="@(!CanPrintCertificate() || _isSavingCertificate)">
                    @if (_isSavingCertificate)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-printer-fill"></i>
                        <span>@(string.IsNullOrWhiteSpace(_previewRecordId) ? "Save & Print / PDF" : "Update & Print / PDF")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Signature Modal Popup -->
@if (_showSignatureModal)
{
    <div class="signature-modal-overlay">
        <div class="signature-modal-container" @onclick:stopPropagation="true">
            <div class="signature-modal-header">
                <h3 class="signature-modal-title">
                    <i class="bi bi-pen"></i>
                    Draw Your Signature
                </h3>
            </div>

            <div class="signature-modal-body">
                <p class="signature-instruction">
                    <i class="bi bi-info-circle"></i>
                    Draw your signature below using your mouse or finger
                </p>
                <div class="signature-canvas-wrapper">
                    <canvas 
                        id="signatureCanvas" 
                        width="800" 
                        height="300"
                        @ref="_signatureCanvas"
                        @onmousedown="StartDrawing"
                        @onmousemove="Draw"
                        @onmouseup="StopDrawing"
                        @onmouseleave="StopDrawing"
                        @ontouchstart="StartDrawingTouch"
                        @ontouchmove="DrawTouch"
                        @ontouchend="StopDrawing">
                    </canvas>
                </div>
            </div>

            <div class="signature-modal-footer">
                <button type="button" class="btn-signature-clear" @onclick="ClearSignature">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Clear
                </button>
                <div class="signature-modal-actions">
                    <button type="button" class="btn-signature-cancel" @onclick="CloseSignatureModal">
                        <i class="bi bi-x-circle"></i>
                        Cancel
                    </button>
                    <button type="button" class="btn-signature-save" @onclick="SaveSignature">
