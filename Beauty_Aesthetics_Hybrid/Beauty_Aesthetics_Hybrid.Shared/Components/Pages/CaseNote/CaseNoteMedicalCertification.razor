    private void ResetFormPreservingPatient()
    {
        var patientName = ViewModel.PatientName;
        if (_certificateType == "day-off") ViewModel.ResetDayOff();
        else ViewModel.ResetTimeOff();
        ViewModel.PatientName = patientName;
    }

    private async Task LoadCertificateHistoryAsync()
    {
        _historyError = null;
        if (string.IsNullOrWhiteSpace(_customerId))
        {
            _certificateHistory.Clear();
            return;
        }

        _isHistoryLoading = true;
        try
        {
            var result = await MedicalCertificateService.LoadByCustomerAsync(_customerId);
            if (result.Success && result.Value is not null)
            {
                _certificateHistory = result.Value.OrderByDescending(item => item.IssuedAt).ToList();
            }
            else
            {
                _certificateHistory.Clear();
                _historyError = result.ErrorMessage ?? "Unable to load medical certificate history.";
            }
        }
        catch (Exception ex)
        {
            _certificateHistory.Clear();
            _historyError = ex.Message;
        }
        finally
        {
            _isHistoryLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenHistoryModal()
    {
        _showHistoryModal = true;
        await LoadCertificateHistoryAsync();
    }

    private void CloseHistoryModal() => _showHistoryModal = false;

    private void OpenSavedCertificate(Beauty_Aesthetics_WebPos.Models.DTOs.MedicalCertificateRecordDTO record)
    {
        _showHistoryModal = false;
        _previewRecordId = record.RecordId;
        _certificateType = record.CertificateType;
        _previewIssuedAt = record.IssuedAt;
        _previewCertNumber = record.CertificateNumber;
        _previewDateIssued = record.IssuedAt.ToString("MMMM dd, yyyy");
        _previewBodyText = record.BodyText;
        _previewPeriod = record.PeriodText;
        _previewDuration = record.DurationText;
        _previewReason = record.Reason;
        _doctorName = record.DoctorName;
        _doctorRegNumber = record.DoctorRegistrationNumber;
        _signatureDataUrl = record.SignatureDataUrl;
        ViewModel.PatientName = record.PatientName;

        if (record.CertificateType == "time-off")
        {
            ViewModel.SetTab("time-off");
            ViewModel.TimeOffStartDate = record.StartDate;
            if (TimeOnly.TryParse(record.StartTime, out var startTime)) ViewModel.TimeOffStartTime = startTime;
            if (TimeOnly.TryParse(record.EndTime, out var endTime)) ViewModel.TimeOffEndTime = endTime;
            ViewModel.TimeOffReason = record.Reason;
        }
        else
        {
            ViewModel.SetTab("day-off");
            ViewModel.DayOffStartDate = record.StartDate;
            ViewModel.DayOffEndDate = record.EndDate;
            ViewModel.IncludeHalfDay = record.IncludeHalfDay;
            ViewModel.DayOffReason = record.Reason;
        }

        _showPreviewModal = true;
    }

    private async Task DeleteCertificateAsync(Beauty_Aesthetics_WebPos.Models.DTOs.MedicalCertificateRecordDTO record)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete medical certificate {record.CertificateNumber}? This cannot be undone.");
        if (!confirmed) return;

        var result = await MedicalCertificateService.DeleteAsync(record.RecordId);
        if (!result.Success)
        {
            Feedback.Error(result.ErrorMessage ?? "Unable to delete the medical certificate.", "Delete failed");
            return;
        }

        _certificateHistory.RemoveAll(item =>
            item.RecordId.Equals(record.RecordId, StringComparison.OrdinalIgnoreCase));

        if (_previewRecordId.Equals(record.RecordId, StringComparison.OrdinalIgnoreCase))
        {
            _showPreviewModal = false;
            _previewRecordId = string.Empty;
        }

        Feedback.Success($"Medical certificate {record.CertificateNumber} deleted.", "Certificate deleted");
    }

