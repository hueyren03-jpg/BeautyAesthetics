    private async Task PrintCertificate()
    {
        if (!CanPrintCertificate())
        {
            Feedback.Warning("Doctor name, patient name and signature are required before printing.", "Certificate not printed");
            return;
        }

        // Update print template via JavaScript
        await JS.InvokeVoidAsync("populateMCTemplate", 
            _previewCertNumber, 
            ViewModel.PatientName, 
            _previewDateIssued, 
            _previewBodyText, 
            _previewPeriod, 
            _previewDuration, 
            _previewReason,
            _doctorName,
            _doctorRegNumber,
            _signatureDataUrl);

        // Close modal
        _showPreviewModal = false;

        // Trigger print dialog
        await JS.InvokeVoidAsync("printMedicalCertificate");

        // Show success message
        ViewModel.StatusMessage = $"✓ Medical Certificate {_previewCertNumber} prepared for printing!";
        ViewModel.IsSuccess = true;
        Feedback.Success(ViewModel.StatusMessage, "Certificate ready");
        
        // Reset form
        if (_certificateType == "day-off")
        {
            ViewModel.ResetDayOff();
        }
        else
        {
            ViewModel.ResetTimeOff();
        }
        
        // Clear doctor details for next certificate
        _doctorName = "";
        _doctorRegNumber = "";
        _signatureDataUrl = "";
        await ClearSignature();
    }

