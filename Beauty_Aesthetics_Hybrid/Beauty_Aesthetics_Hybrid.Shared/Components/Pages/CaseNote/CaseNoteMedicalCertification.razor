    {
        if (!ViewModel.CanSubmitTimeOff())
        {
            ViewModel.StatusMessage = ViewModel.TimeOffValidationError;
            ViewModel.IsSuccess = false;
            Feedback.Warning(ViewModel.StatusMessage, "Certificate not ready");
