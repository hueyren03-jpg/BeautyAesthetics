    {
        _tempSignatureDataUrl = await JS.InvokeAsync<string>("getSignatureDataUrl");
    }

    private string GenerateDoctorRegNumber()
    {
        var random = new Random();
        var prefix = "MC";
        var number = random.Next(10000, 99999);
        var suffix = (char)random.Next('A', 'Z' + 1);
        return $"{prefix}{number}{suffix}";
    }

    private bool CanPrintCertificate()
    {
        return !string.IsNullOrWhiteSpace(_doctorName) && 
               !string.IsNullOrWhiteSpace(ViewModel.PatientName) &&
               !string.IsNullOrWhiteSpace(_signatureDataUrl);
    }

    private class BoundingClientRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Right { get; set; }
        public double Bottom { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private async Task PreviewDayOffMC()
    {
        if (!ViewModel.CanSubmitDayOff())
        {
            ViewModel.StatusMessage = ViewModel.DayOffValidationError;
            ViewModel.IsSuccess = false;
            Feedback.Warning(ViewModel.StatusMessage, "Certificate not ready");
            return;
        }

        // Generate certificate number and registration number
        _previewCertNumber = $"DC-{DateTime.Now:yyyyMMdd}-{new Random().Next(1000, 9999)}";
        _doctorRegNumber = GenerateDoctorRegNumber();
        _previewDateIssued = DateTime.Now.ToString("MMMM dd, yyyy");
        _previewBodyText = "was examined and found to be unfit for work/school.";
        _previewPeriod = $"{ViewModel.DayOffStartDate:MMM dd, yyyy} to {ViewModel.DayOffEndDate:MMM dd, yyyy}";
        _previewDuration = $"{ViewModel.DurationDays} {(ViewModel.DurationDays == 1 ? "Day" : "Days")}{(ViewModel.IncludeHalfDay ? " + 0.5 Day" : "")}";
        _previewReason = ViewModel.DayOffReason;
        
        _certificateType = "day-off";
        _showPreviewModal = true;
        
        // Initialize signature canvas after modal is shown
        await Task.Delay(100);
        await InitializeSignatureCanvas();
    }

