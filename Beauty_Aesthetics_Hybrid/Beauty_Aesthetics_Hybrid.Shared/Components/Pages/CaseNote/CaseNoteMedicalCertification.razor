        _previewPeriod = $"{ViewModel.TimeOffStartDate:MMM dd, yyyy} from {FormatTime(ViewModel.TimeOffStartTime)} to {FormatTime(ViewModel.TimeOffEndTime)}";
        _previewDuration = $"{ViewModel.DurationHours} {(ViewModel.DurationHours == 1 ? "Hour" : "Hours")}";
        _previewReason = ViewModel.TimeOffReason;
        
