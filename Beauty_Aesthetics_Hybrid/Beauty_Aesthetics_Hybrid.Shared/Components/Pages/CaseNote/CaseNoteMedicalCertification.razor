    private async Task StartDrawingTouch(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            _isDrawing = true;
            var touch = e.Touches[0];
            var rect = await JS.InvokeAsync<BoundingClientRect>("getCanvasRect");
            _lastX = touch.ClientX - rect.Left;
            _lastY = touch.ClientY - rect.Top;
        }
