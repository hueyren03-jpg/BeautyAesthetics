        else
        {
            _customerId = CustomerId?.Trim() ?? string.Empty;
            Feedback.Error(customerResult.ErrorMessage ?? "Unable to load the appointment patient.", "Patient not loaded");
        }

        ViewModel.PropertyChanged += (sender, args) => 
        {
            StateHasChanged();
            
            // Auto-dismiss success messages after 5 seconds
            if (args.PropertyName == nameof(ViewModel.StatusMessage) && 
                !string.IsNullOrEmpty(ViewModel.StatusMessage) && 
                ViewModel.IsSuccess)
            {
                _messageTimer?.Dispose();
                _messageTimer = new System.Threading.Timer(_ =>
                {
                    InvokeAsync(() =>
                    {
                        ViewModel.StatusMessage = string.Empty;
                        StateHasChanged();
                    });
                }, null, 5000, Timeout.Infinite);
            }
        };

        try
        {
            await Task.WhenAll(
                LoadCustomReasons(),
                LoadCertificateHistoryAsync());
        }
        finally
        {
            _isPageInitializing = false;
        }
