    private async Task PrintCertificate()
    {
        if (!CanPrintCertificate())
        {
            Feedback.Warning(
                "Doctor name, registration number, patient and signature are required before issuing the certificate.",
                "Certificate not issued");
            return;
        }

        _isSavingCertificate = true;
        try
        {
            var record = BuildCurrentCertificateRecord();
            var branch = BranchSession.CurrentBranch;
            var saveResult = await MedicalCertificateService.SaveAsync(
                record,
                branch?.Id ?? string.Empty,
                branch?.GroupId ?? string.Empty);

            if (!saveResult.Success || saveResult.Value is null)
            {
                Feedback.Error(
                    saveResult.ErrorMessage ?? "Unable to save the medical certificate.",
                    "Certificate not issued");
                return;
            }

            var saved = saveResult.Value;
            _previewRecordId = saved.RecordId;

            var existingIndex = _certificateHistory.FindIndex(item =>
                item.RecordId.Equals(saved.RecordId, StringComparison.OrdinalIgnoreCase));
            if (existingIndex >= 0)
                _certificateHistory[existingIndex] = saved;
            else
                _certificateHistory.Insert(0, saved);

            await PopulateAndPrintCertificateAsync(saved);
            _showPreviewModal = false;

            ViewModel.StatusMessage = $"✓ Medical Certificate {saved.CertificateNumber} saved and prepared for printing!";
            ViewModel.IsSuccess = true;
            Feedback.Success(ViewModel.StatusMessage, "Certificate issued");

            ResetFormPreservingPatient();
            _previewRecordId = string.Empty;
        }
        catch (Exception ex)
        {
            Feedback.Error($"Unable to issue medical certificate: {ex.Message}", "Certificate not issued");
        }
        finally
        {
            _isSavingCertificate = false;
        }
    }

    private Beauty_Aesthetics_WebPos.Models.DTOs.MedicalCertificateRecordDTO BuildCurrentCertificateRecord()
    {
        var isTimeOff = _certificateType == "time-off";
        return new Beauty_Aesthetics_WebPos.Models.DTOs.MedicalCertificateRecordDTO
        {
            RecordId = _previewRecordId,
            CertificateNumber = _previewCertNumber,
            CustomerId = _customerId,
            PatientName = ViewModel.PatientName,
            CertificateType = _certificateType,
            IssuedAt = _previewIssuedAt,
            StartDate = isTimeOff ? ViewModel.TimeOffStartDate : ViewModel.DayOffStartDate,
            EndDate = isTimeOff ? ViewModel.TimeOffEndDate : ViewModel.DayOffEndDate,
            StartTime = isTimeOff ? ViewModel.TimeOffStartTime.ToString("HH:mm") : string.Empty,
            EndTime = isTimeOff ? ViewModel.TimeOffEndTime.ToString("HH:mm") : string.Empty,
            IncludeHalfDay = !isTimeOff && ViewModel.IncludeHalfDay,
            DurationText = _previewDuration,
            Reason = _previewReason,
            BodyText = _previewBodyText,
            PeriodText = _previewPeriod,
            DoctorName = _doctorName.Trim(),
            DoctorRegistrationNumber = _doctorRegNumber.Trim(),
            SignatureDataUrl = _signatureDataUrl,
            Status = "Issued"
        };
    }

    private async Task PopulateAndPrintCertificateAsync(Beauty_Aesthetics_WebPos.Models.DTOs.MedicalCertificateRecordDTO record)
    {
        await JS.InvokeVoidAsync("populateMCTemplate",
