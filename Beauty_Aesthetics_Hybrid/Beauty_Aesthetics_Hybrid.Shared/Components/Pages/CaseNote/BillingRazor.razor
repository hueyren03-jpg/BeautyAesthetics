    private void ConfirmBillingPaymentAmount()
    {
        if (_billingCalculatorMethod is null || BillingCalculatorAmount <= 0m)
        {
            Feedback.Warning("Enter a payment amount first.", "Payment amount required");
            return;
        }

        var payment = BillingPaymentFor(_billingCalculatorMethod.POSPaymentTypeID);
        if (payment is null)
        {
            Feedback.Error(
                "The selected payment method is not available in the current payment configuration.",
                "Payment method unavailable");
            return;
        }

        payment.Amount = BillingCalculatorAmount;
        payment.AmountText = BillingCalculatorAmount.ToString("0.00");

        SynchronizeBillingPaymentTotals();
        CloseBillingPaymentCalculator();
        StateHasChanged();
    }

    private void SynchronizeBillingPaymentTotals()
    {
        var total = MultiPaymentTotal;
        AmountReceived = total > 0m ? total : null;
        AmountReceivedText = total > 0m ? total.ToString("0.00") : string.Empty;
        AmountReceivedError = null;

        var first = SelectedPaymentSplits.FirstOrDefault();
        if (first is null)
        {
            SelectedPaymentTypeId = 0;
            SelectedPaymentMethod = string.Empty;
            return;
        }

        SelectedPaymentTypeId = first.PaymentTypeId;
        SelectedPaymentMethod = first.MethodLabel;
    }

