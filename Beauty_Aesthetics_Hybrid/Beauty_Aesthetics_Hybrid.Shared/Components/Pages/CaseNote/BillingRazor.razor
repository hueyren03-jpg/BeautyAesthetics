    // Billing payment calculator mirrors Sales > New Sale behavior.
    private void OpenBillingPaymentCalculator(CashSalesPaymentTypeDTO method)
    {
        if (method.POSPaymentTypeID == -5 || (HasBillingPackageRedemption && method.POSPaymentTypeID == -10)) return;
        if (HasBillingPointRedemption && method.POSPaymentTypeID == -10)
        {
            Console.WriteLine(
                $"[Point Step 8] BLOCKED | Source=Billing | Customer={_billingCustomerId} | " +
                $"Reason=MemberCreditTenderWithPoints");

            Feedback.Warning(
                "Member Credit cannot be combined with point redemption on the same bill.",
                "Payment method not allowed");
            return;
        }

        if (_isOutstandingPaymentMode)
        {
            if (method.POSPaymentTypeID == -10)
            {
                Feedback.Warning(
                    "Member Credit cannot be used as an Outstanding settlement payment method.",
                    "Payment method not allowed");
                return;
            }

            var existingOutstandingPayment =
                BillingPaymentFor(method.POSPaymentTypeID);

            if (existingOutstandingPayment is null)
            {
                // Step 8 uses the same Beauty split-payment interaction as Sales:
                // first click fills only the current remaining amount; edit a
                // selected method, then add another configured method.
                var amount = Math.Round(
                    Math.Max(0m, BillingRemaining),
                    2,
                    MidpointRounding.AwayFromZero);

                if (amount <= 0m)
                {
                    Feedback.Warning(
                        "The Outstanding settlement is already fully allocated. Edit or remove an existing payment before adding another method.",
                        "Outstanding fully allocated");
                    return;
                }

                _outstandingSettlementPayments.Add(new TransactionPayment
                {
                    PaymentTypeId = method.POSPaymentTypeID,
                    PaymentMethod =
                        method.POSPaymentTypeName ??
                        $"Payment {method.POSPaymentTypeID}",
                    Amount = amount,
                    FinancialAccountId =
                        method.FinancialAccountID ?? string.Empty,
                    BankName =
                        method.FinancialAccountName ?? string.Empty
                });

                _billingCalculatorMethod = null;
                _billingCalculatorDigits = string.Empty;
                SelectedPaymentTypeId = method.POSPaymentTypeID;
                SelectedPaymentMethod =
                    method.POSPaymentTypeName ??
                    $"Payment {method.POSPaymentTypeID}";

                SynchronizeBillingPaymentTotals();

                Console.WriteLine(
                    $"[Outstanding Step 8] BILLING PAYMENT METHOD ADDED | " +
                    $"Type={method.POSPaymentTypeID} | Method={method.POSPaymentTypeName} | " +
                    $"Amount={amount:N2} | Methods={ActiveBillingPayments.Count} | " +
                    $"Paid={BillingPaidAmount:N2} | Remaining={BillingRemaining:N2}");

                StateHasChanged();
                return;
            }
        }

        _billingCalculatorMethod = method;
        SelectedPaymentTypeId = method.POSPaymentTypeID;
        SelectedPaymentMethod =
            method.POSPaymentTypeName ?? $"Payment {method.POSPaymentTypeID}";

        var existing = BillingPaymentFor(method.POSPaymentTypeID);
        _billingCalculatorDigits = existing is null
            ? string.Empty
            : ((long)Math.Round(existing.Amount * 100m)).ToString();
    }

