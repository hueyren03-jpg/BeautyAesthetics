    {
        _showPrescriptionModal = false;
        PrescriptionViewModel.SelectedDrugToAdd = null;
        _showPrescriptionValidationError = false;
        _editingPrescriptionItem = null; // Reset editing state
        ResetPrescriptionModal();
    }

