    private async Task DownloadReceiptPdfAndClose()
    {
        if (_isProcessingPayment)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_completedSaleDocumentId))
        {
            Feedback.Error(
                "The completed sales document ID is missing.",
                "Receipt unavailable");
            return;
        }

        _isProcessingPayment = true;
        var completed = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var completedDocumentTypeId =
                AppState.LastCompletedTransaction?.DocumentTypeId == 52 ? 52 : 5;

            var saleResult = await CashSalesService.LoadTransactionAsync(
                _completedSaleDocumentId,
                completedDocumentTypeId);

            var transaction = saleResult.Success && saleResult.Value is not null
                ? saleResult.Value
                : AppState.LastCompletedTransaction;

            if (transaction is null)
            {
                Feedback.Error(
                    saleResult.ErrorMessage ?? "Unable to load the completed sale for the receipt.",
                    "Receipt unavailable");
                return;
            }

            var fileId = string.IsNullOrWhiteSpace(transaction.DocumentId)
                ? _completedSaleDocumentId
                : transaction.DocumentId;
            var downloaded = await CashSalesService.DownloadReceiptPdfAsync(
                fileId,
                completedDocumentTypeId);

            if (!downloaded.Success)
            {
                Feedback.Error(
                    downloaded.ErrorMessage ?? "Unable to download the receipt PDF.",
                    "Receipt download failed");
                return;
            }

            Feedback.Success(
                $"Receipt {_completedReceiptNumber} downloaded in the Senang thermal format.",
                "Receipt downloaded",
                2400);

            completed = true;
        }
        catch (Exception ex)
        {
            Feedback.Error(
                $"Unable to download receipt: {ex.Message}",
                "Receipt download failed");
        }
        finally
        {
            _isProcessingPayment = false;
            if (completed)
            {
                _showPaymentSummaryModal = false;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

