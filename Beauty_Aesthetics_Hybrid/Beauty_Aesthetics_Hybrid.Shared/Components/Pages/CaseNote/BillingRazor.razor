    private async Task AppendPrescriptionToBilling(CaseNotePrescriptionViewModel.Prescription prescription)
    {
        foreach (var drug in prescription.Drugs)
        {
            var taxRate = await GstTaxRateService.GetRateForTaxCodeAsync(drug.Drug.TaxCode);
            var qty = (int)Math.Max(1, Math.Round(drug.Quantity));
            var existing = PrescriptionItems.FirstOrDefault(item =>
                (!string.IsNullOrWhiteSpace(drug.Drug.InventoryId) && string.Equals(item.SourceId, drug.Drug.InventoryId, StringComparison.OrdinalIgnoreCase)) ||
                (string.IsNullOrWhiteSpace(drug.Drug.InventoryId) && item.Name.Equals(drug.Drug.Name, StringComparison.OrdinalIgnoreCase)));

            if (existing != null)
            {
                var index = PrescriptionItems.IndexOf(existing);
                PrescriptionItems[index] = existing with { Quantity = existing.Quantity + qty };
            }
            else
            {
                PrescriptionItems.Add(new BillingItem(
                    drug.Drug.Name,
                    qty,
                    drug.Drug.Price,
                    0m,
                    drug.Frequency,
                    drug.Duration,
                    drug.Reason,
                    drug.Notes,
                    drug.Drug.InventoryId,
                    drug.Drug.DrugCode,
                    drug.Drug.StockQuantity,
                    drug.Drug.TaxCode,
                    drug.Drug.IsTaxInclusive,
                    taxRate));
            }
        }
    }

