    private async Task RunPostPaymentActionAsync(string action)
    {
        if (_isProcessingPayment)
        {
            return;
        }

        _postPaymentEmailError = null;

        if (string.IsNullOrWhiteSpace(_completedSaleDocumentId))
        {
            _postPaymentEmailError = "The completed sales document ID is missing.";
            Feedback.Error(_postPaymentEmailError, "Invoice unavailable");
            return;
        }

        _isProcessingPayment = true;
        var completed = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var invoiceResult = await CashSalesService.RequestInvoiceLinkAsync(_completedSaleDocumentId);
            if (!invoiceResult.Success || string.IsNullOrWhiteSpace(invoiceResult.Value))
            {
                _postPaymentEmailError = invoiceResult.ErrorMessage ?? "Unable to generate the invoice link.";
                Feedback.Error(_postPaymentEmailError, "Invoice unavailable");
                return;
            }

            _invoiceDownloadUrl = invoiceResult.Value;

            if (string.Equals(action, "print", StringComparison.OrdinalIgnoreCase))
            {
                await JS.InvokeVoidAsync("open", _invoiceDownloadUrl, "_blank");
                Feedback.Success(
                    string.IsNullOrWhiteSpace(_completedReceiptNumber)
                        ? "Invoice PDF opened."
                        : $"Invoice {_completedReceiptNumber} opened.",
                    "Invoice ready",
                    2400);
            }
            else
            {
                var subject = Uri.EscapeDataString(
                    string.IsNullOrWhiteSpace(_completedReceiptNumber)
                        ? "Your invoice"
                        : $"Invoice {_completedReceiptNumber}");
                var body = Uri.EscapeDataString(
                    $"Your invoice is available here:{Environment.NewLine}{_invoiceDownloadUrl}");
                var email = Uri.EscapeDataString(_postPaymentEmail);
                var mailto = $"mailto:{email}?subject={subject}&body={body}";

                await JS.InvokeVoidAsync("open", mailto, "_self");
                Feedback.Success(
                    $"Invoice link prepared for {_postPaymentEmail}.",
                    "Invoice email ready",
                    2400);
            }

            completed = true;
        }
        catch (Exception ex)
        {
            _postPaymentEmailError = $"Unable to prepare invoice: {ex.Message}";
            Feedback.Error(_postPaymentEmailError, "Invoice unavailable");
        }
        finally
        {
            _isProcessingPayment = false;
            if (completed)
            {
                _showPostPaymentModal = false;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool IsValidEmail(string email)
    {
        // Simple email format check suitable for UI validation
        var pattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        return Regex.IsMatch(email, pattern, RegexOptions.IgnoreCase);
    }

    private void OpenDiscountModal(object item)
    {
        _selectedDiscountItem = item;
        _discountError = null;
        _selectedDiscountRuleId = string.Empty;
        _isPercentageDiscount = false;

        switch (item)
        {
            case BillingItem billingItem:
                _discountValue = billingItem.Discount > 0m ? billingItem.Discount.ToString("0.00") : string.Empty;
                _selectedDiscountRuleId = billingItem.CashDiscountId;
                break;
            case BillingService billingService:
                _discountValue = billingService.Discount > 0m ? billingService.Discount.ToString("0.00") : string.Empty;
                _selectedDiscountRuleId = billingService.CashDiscountId;
                break;
            case BillingMemberCredit memberCredit:
                _discountValue = memberCredit.Discount > 0m ? memberCredit.Discount.ToString("0.00") : string.Empty;
                _selectedDiscountRuleId = memberCredit.CashDiscountId;
                break;
            default:
                if (ReferenceEquals(item, BillDiscountToken))
                {
                    _discountValue = BillDiscount > 0m ? BillDiscount.ToString("0.00") : string.Empty;
                    _selectedDiscountRuleId = BillDiscountCashDiscountId;
                }
                break;
        }

        var rule = SelectedDiscountRule;
        _isPercentageDiscount = rule is { IsOpenDiscount: false, CashDiscountTypeID: 1 };
        _showDiscountModal = true;
    }

