<AppErrorPopup Title="Billing request failed"
               Message="@BillingErrorMessage"
               OnDismiss="DismissBillingError" />

@code {
    [SupplyParameterFromQuery(Name = "customerId")]
    public string? CustomerId { get; set; }

    [SupplyParameterFromQuery(Name = "appointmentId")]
    public string? AppointmentId { get; set; }

    private string? BillingErrorMessage => new[]
    {
        AmountReceivedError,
        _showPrescriptionValidationError ? "Please fill in prescription frequency, duration, and reason." : null,
        _paymentValidationError,
        _paymentMethodsError,
        _postPaymentEmailError,
        _discountError,
        _appointmentBillingError
    }.FirstOrDefault(message => !string.IsNullOrWhiteSpace(message));

    private void DismissBillingError()
    {
        AmountReceivedError = null;
        _showPrescriptionValidationError = false;
        _paymentValidationError = null;
        _paymentMethodsError = null;
        _postPaymentEmailError = string.Empty;
        _discountError = string.Empty;
        _appointmentBillingError = null;
    }

    private string PatientName { get; set; } = "-";
    private string PatientBirthday { get; set; } = "-";
    private string PatientPhone { get; set; } = "-";
    private string _billingCustomerId = string.Empty;
    private string? _loadedBillingCustomerKey;
    private Appointment? _billingAppointment;
    private bool _appointmentSaleExists;
    private bool _paymentCommitted;
    private string? _appointmentBillingError;
    private bool IsAppointmentPaymentLocked =>
        _paymentCommitted ||
        _appointmentSaleExists ||
        IsAppointmentPaid(_billingAppointment);

    private bool _isPatientInfoCollapsed = false;
    private bool _isPatientDrawerOpen = false;
    private string _billingStep = "summary";

    private string VisitDate { get; set; } = DateTime.Now.ToString("dd/MM/yyyy");
