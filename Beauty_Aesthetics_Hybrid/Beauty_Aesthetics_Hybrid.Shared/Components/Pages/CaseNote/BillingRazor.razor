    private void EditPrescriptionItem(BillingItem item)
    {
        if (_isDeleteMode) return; // Disable edit in delete mode

        _editingPrescriptionItem = item;
        
        // Find the drug in the shared list to select it
        var drug = PrescriptionViewModel.Drugs.FirstOrDefault(d => d.Name == item.Name);
        if (drug != null)
        {
            PrescriptionViewModel.SelectedDrugToAdd = drug;
        }

        // Pre-fill form
        PrescriptionViewModel.NewDrugQuantity = item.Quantity;
        PrescriptionViewModel.NewDrugFrequency = item.Frequency ?? string.Empty;
        PrescriptionViewModel.NewDrugDuration = item.Duration ?? string.Empty;
        PrescriptionViewModel.NewDrugReason = item.Reason ?? string.Empty;
        PrescriptionViewModel.NewDrugNotes = item.Notes ?? string.Empty;

        // Show modal
        _showPrescriptionModal = true;
    }

    private void AddSinglePrescriptionDrug()
    {
        // 1. Validate
        if (string.IsNullOrWhiteSpace(PrescriptionViewModel.NewDrugFrequency) ||
            string.IsNullOrWhiteSpace(PrescriptionViewModel.NewDrugDuration) ||
            string.IsNullOrWhiteSpace(PrescriptionViewModel.NewDrugReason))
        {
            _showPrescriptionValidationError = true;
            return;
        }

        // 2. Add or Update
        var drug = PrescriptionViewModel.SelectedDrugToAdd;
        if (drug != null)
        {
             var newItem = new BillingItem(
                 drug.Name,
                 (int)PrescriptionViewModel.NewDrugQuantity,
                 0m, // Price not available in Drug model, defaulting to 0
                 0m, // No discount initially
                 PrescriptionViewModel.NewDrugFrequency,
                 PrescriptionViewModel.NewDrugDuration,
                 PrescriptionViewModel.NewDrugReason,
                 PrescriptionViewModel.NewDrugNotes
             );

             if (_editingPrescriptionItem != null)
             {
                 // Update existing item
                 var index = PrescriptionItems.IndexOf(_editingPrescriptionItem);
                 if (index != -1)
                 {
                     PrescriptionItems[index] = newItem;
                 }
             }
             else
             {
                 // Add new item
                 PrescriptionItems.Add(newItem);
             }
             
             StateHasChanged();
        }

        // 3. Close Modal & Reset
        ClosePrescriptionModal();
    }

