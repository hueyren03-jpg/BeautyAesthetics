@if (_showDiscountModal)
{
    <div class="modal-overlay" @onclick="CloseDiscountModal">
        <div class="modal-container billing-discount-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-info">
                <i class="bi bi-percent"></i>
                <h3>Apply Discount</h3>
            </div>
            <div class="modal-body">
                <div class="discount-input-group">
                    <label>Discount Rule</label>
                    <select value="@_selectedDiscountRuleId"
                            @onchange="OnDiscountRuleChanged"
                            disabled="@_isDiscountRulesLoading">
                        <option value="">Manual discount</option>
                        @foreach (var rule in AvailableDiscountRules)
                        {
                            <option value="@rule.Id">@rule.DisplayLabel</option>
                        }
                    </select>
                    @if (_isDiscountRulesLoading)
                    {
                        <small>Loading available discounts...</small>
                    }
                    else if (!string.IsNullOrWhiteSpace(_discountRulesError) && AvailableDiscountRules.Count == 0)
                    {
                        <small>@_discountRulesError</small>
                    }
                </div>

                <div class="discount-toggle-row">
                    <button class="discount-type-btn @(!_isPercentageDiscount ? "active" : "")" @onclick="() => SetDiscountType(false)">
                        RM (Fixed)
                    </button>
                    <button class="discount-type-btn @(_isPercentageDiscount ? "active" : "")" @onclick="() => SetDiscountType(true)">
                        % (Percentage)
                    </button>
                </div>

                <div class="discount-input-group">
                    <label>Discount Amount</label>
                    <div class="input-with-prefix">
                        <span class="prefix">@(_isPercentageDiscount ? "%" : "RM")</span>
                        <input type="text" inputmode="decimal" @bind="_discountValue" @bind:event="oninput" placeholder="0.00" @onkeydown="HandleDiscountEnterKey" />
                    </div>
                </div>

                <div class="quick-discount-grid">
                    @if (_isPercentageDiscount)
                    {
                        <button class="btn-quick-discount" @onclick='() => QuickApplyDiscount("5", true)'>5%</button>
                        <button class="btn-quick-discount" @onclick='() => QuickApplyDiscount("10", true)'>10%</button>
                        <button class="btn-quick-discount" @onclick='() => QuickApplyDiscount("20", true)'>20%</button>
                        <button class="btn-quick-discount" @onclick='() => QuickApplyDiscount("50", true)'>50%</button>
                    }
                    else
                    {
                        <button class="btn-quick-discount" @onclick='() => QuickApplyDiscount("10", false)'>RM 10</button>
                        <button class="btn-quick-discount" @onclick='() => QuickApplyDiscount("20", false)'>RM 20</button>
                        <button class="btn-quick-discount" @onclick='() => QuickApplyDiscount("50", false)'>RM 50</button>
                        <button class="btn-quick-discount" @onclick='() => QuickApplyDiscount("100", false)'>RM 100</button>
                    }
                </div>

            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CloseDiscountModal">
                    Cancel
                </button>
                <button class="btn-modal-confirm" @onclick="ApplyDiscount">
                    Apply Discount
                </button>
            </div>
        </div>
    </div>
}

@if (_showServicePickerModal)
{
    <div class="modal-overlay" @onclick="CloseServicePickerModal">
        <div class="modal-container billing-service-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-info">
                <i class="bi bi-grid"></i>
                <h3>Select Service</h3>
            </div>
            <div class="modal-body">
                <div class="service-search-bar">
                    <i class="bi bi-search"></i>
                    <input type="text" class="service-search-input" placeholder="Search services..." value="@_serviceSearchQuery" @oninput="UpdateServiceSearch" />
                </div>
                
                <div class="service-category-filter">
                    @foreach (var cat in ServiceCategories)
                    {
                        <button class="btn-category-filter @(cat == _selectedServiceCategory ? "active" : "")" 
                                @onclick="() => SetServiceCategory(cat)">
                            @cat
                        </button>
                    }
                </div>

                <div class="service-catalog-list">
                    @if (_isServiceCatalogLoading)
                    {
                        <div class="catalog-state"><span class="spinner-border spinner-border-sm"></span> Loading services...</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_serviceCatalogError))
                    {
                        <div class="catalog-state catalog-state-error">
                            <span>@_serviceCatalogError</span>
                            <button type="button" @onclick="LoadServiceCatalogAsync">Retry</button>
                        </div>
                    }
                    else if (!FilteredServiceCatalog.Any())
                    {
                        <div class="catalog-state">No active services found.</div>
                    }
                    else
                    {
                        @foreach (var svc in FilteredServiceCatalog)
                        {
                            <div class="service-catalog-row @(_loadingServiceId == svc.MasterAccountId ? "loading" : string.Empty)"
                                 @onclick="() => AddServiceFromCatalogAsync(svc)">
                                <div class="service-icon">
                                    @if (!string.IsNullOrWhiteSpace(ResolveCatalogImage(svc.MasterAccountId, svc.ImagePath, svc.ImageFileName)))
                                    {
                                        <img src="@ResolveCatalogImage(svc.MasterAccountId, svc.ImagePath, svc.ImageFileName)" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-stars"></i>
                                    }
                                </div>
                                <div class="service-info">
                                    <h4>@svc.ServiceName</h4>
                                    <div class="service-meta">
                                        <span>@svc.Sku</span>
                                        <span class="dot">•</span>
                                        <span>@svc.Category</span>
                                        @if (!string.IsNullOrWhiteSpace(svc.DurationSpend))
                                        {
                                            <span class="dot">•</span>
                                            <span>@svc.DurationSpend</span>
                                        }
                                    </div>
                                </div>
                                <div class="service-price">RM @svc.Price.ToString("N2")</div>
                                <button type="button"
                                        class="btn-add-service-item"
                                        aria-label="Add @svc.ServiceName"
                                        disabled="@(_loadingServiceId == svc.MasterAccountId)"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => AddServiceFromCatalogAsync(svc)">
                                    @if (_loadingServiceId == svc.MasterAccountId)
                                    {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-plus-lg"></i>
                                    }
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CloseServicePickerModal">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@if (_showMemberCreditPickerModal)
{
