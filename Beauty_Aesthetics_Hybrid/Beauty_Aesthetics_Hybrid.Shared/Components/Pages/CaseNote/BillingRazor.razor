    private async Task LoadBillingAppointmentAsync()
    {
        _appointmentBillingError = null;

        if (string.IsNullOrWhiteSpace(AppointmentId))
        {
            return;
        }

        var appointmentId = AppointmentId.Trim();
        var loadResult = await AppointmentService.GetAppointmentByIdAsync(appointmentId);
        if (!loadResult.Success || loadResult.Value is null)
        {
            _appointmentBillingError =
                loadResult.ErrorMessage ?? $"Unable to load appointment {appointmentId}.";
            Feedback.Warning(_appointmentBillingError, "Appointment status unavailable");
            return;
        }

        _billingAppointment = loadResult.Value;

        if (!string.IsNullOrWhiteSpace(_billingCustomerId) &&
            !string.IsNullOrWhiteSpace(_billingAppointment.CustomerId) &&
            !string.Equals(
                _billingCustomerId,
                _billingAppointment.CustomerId,
                StringComparison.OrdinalIgnoreCase))
        {
            _appointmentBillingError =
                "The billing customer does not match the selected appointment customer.";
            Feedback.Error(_appointmentBillingError, "Billing blocked");
            _paymentCommitted = true;
            return;
        }

        await CheckExistingAppointmentSaleAsync();

        if (IsAppointmentPaymentLocked)
        {
            BillingStatusText = "Paid";
            _billingStep = "summary";
            BillingPayments.Clear();
            SynchronizeBillingPaymentTotals();
        }
    }

    private async Task CheckExistingAppointmentSaleAsync()
    {
        if (string.IsNullOrWhiteSpace(AppointmentId) || _billingAppointment is null)
        {
            return;
        }

        var branchId = string.IsNullOrWhiteSpace(AppState.SelectedBranchID)
            ? _billingAppointment.BranchId
            : AppState.SelectedBranchID!;

        var appointmentDate = _billingAppointment.Start.Date;
        var today = DateTime.Today;
        var startDate = appointmentDate <= today ? appointmentDate.AddDays(-1) : today.AddDays(-1);
        var endDate = appointmentDate >= today ? appointmentDate.AddDays(1) : today.AddDays(1);

        var historyResult = await CashSalesService.LoadTransactionsAsync(
            startDate,
            endDate,
            branchId ?? string.Empty,
            resolvePaymentMethods: false);

        if (!historyResult.Success || historyResult.Value is null)
        {
            return;
        }

        var existingSale = historyResult.Value.FirstOrDefault(transaction =>
            !string.Equals(transaction.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) &&
            string.Equals(
                transaction.ReferenceNumber?.Trim(),
                AppointmentId.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (existingSale is null)
        {
            return;
        }

        _appointmentSaleExists = true;
        _paymentCommitted = true;
        _completedSaleDocumentId = existingSale.DocumentId;
        _completedReceiptNumber = existingSale.InvoiceNumber;
        BillingStatusText = "Paid";
    }

    private static bool IsAppointmentPaid(Appointment? appointment)
    {
        if (appointment is null)
        {
            return false;
        }

        return appointment.PaymentStatus > 0 ||
               appointment.StatusName.Contains("paid", StringComparison.OrdinalIgnoreCase) ||
               appointment.Label == 4;
    }

    private async Task<bool> MarkBillingAppointmentPaidAsync()
    {
        if (string.IsNullOrWhiteSpace(AppointmentId))
        {
            return true;
        }

        var appointmentId = AppointmentId.Trim();
        var result = await AppointmentService.MarkAppointmentPaidAsync(appointmentId);
        if (!result.Success || result.Value is null)
        {
            await Task.Delay(250);
            result = await AppointmentService.MarkAppointmentPaidAsync(appointmentId);
        }

        if (!result.Success || result.Value is null)
        {
            _appointmentBillingError =
                result.ErrorMessage ??
                $"Sale was saved, but appointment {appointmentId} could not be marked paid.";
            return false;
        }

        _billingAppointment = result.Value;
        _appointmentSaleExists = true;
        BillingStatusText = "Paid";
        return true;
    }

