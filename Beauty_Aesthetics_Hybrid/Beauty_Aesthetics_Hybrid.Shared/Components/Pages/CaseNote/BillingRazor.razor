    private void OnDiscountRuleChanged(ChangeEventArgs e)
    {
        _selectedDiscountRuleId = e.Value?.ToString() ?? string.Empty;
        _discountError = null;

        var rule = SelectedDiscountRule;
        if (rule is null)
        {
            return;
        }

        _isPercentageDiscount = rule is { IsOpenDiscount: false, CashDiscountTypeID: 1 };

        if (rule.IsOpenDiscount)
        {
            _discountValue = string.Empty;
            _isPercentageDiscount = false;
            return;
        }

        if (rule.TryCalculate(GetSelectedDiscountGross(), 0m, out var amount, out var error))
        {
            _discountValue = amount.ToString("0.00");
        }
        else
        {
            _discountError = error;
        }
    }

    private decimal GetSelectedDiscountGross()
    {
        return _selectedDiscountItem switch
        {
            BillingItem item => Math.Max(0m, item.UnitPrice * item.Quantity),
            BillingService service => Math.Max(0m, service.UnitPrice * service.Quantity),
            BillingMemberCredit credit => Math.Max(0m, credit.UnitPrice * credit.Quantity),
            _ when ReferenceEquals(_selectedDiscountItem, BillDiscountToken) =>
                Math.Max(0m,
                    PrescriptionItems.Sum(item => item.LineTotal) +
                    ServiceItems.Sum(item => item.LineTotal) +
                    MemberCreditItems.Sum(item => item.LineTotal)),
            _ => 0m
        };
    }

    private void HandleDiscountEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ApplyDiscount();
        }
    }

    private void ApplyDiscount()
    {
        if (_selectedDiscountItem is null)
        {
            return;
        }

        _discountError = null;
        var gross = GetSelectedDiscountGross();
        if (gross <= 0m)
        {
            _discountError = "There is no amount available to discount.";
            Feedback.Warning(_discountError, "Discount not applied");
            return;
        }

        var hasValue = decimal.TryParse(_discountValue, out var enteredValue);
        var rule = SelectedDiscountRule;
        decimal newDiscount;
        string cashDiscountId;
        string discountMemo;

        if (rule is not null)
        {
            if (rule.IsOpenDiscount && (!hasValue || enteredValue < 0m))
            {
                _discountError = "Enter a valid discount amount.";
                Feedback.Warning(_discountError, "Discount not applied");
                return;
            }

            if (!rule.TryCalculate(gross, hasValue ? enteredValue : 0m, out newDiscount, out var ruleError))
            {
                _discountError = ruleError ?? "This discount cannot be applied.";
                Feedback.Warning(_discountError, "Discount not applied");
                return;
            }

            cashDiscountId = rule.Id;
            discountMemo = rule.Description;
        }
        else
        {
            if (!hasValue || enteredValue < 0m)
            {
                _discountError = "Enter a valid discount amount.";
                Feedback.Warning(_discountError, "Discount not applied");
                return;
            }

            if (_isPercentageDiscount && enteredValue > 100m)
            {
                _discountError = "Percentage discount cannot exceed 100%.";
                Feedback.Warning(_discountError, "Discount not applied");
                return;
            }

            newDiscount = _isPercentageDiscount
                ? Math.Round(gross * (enteredValue / 100m), 2, MidpointRounding.AwayFromZero)
                : enteredValue;
            newDiscount = Math.Clamp(newDiscount, 0m, gross);
            cashDiscountId = string.Empty;
            discountMemo = newDiscount > 0m
                ? (_isPercentageDiscount
                    ? $"Manual discount {enteredValue:0.##}%"
                    : $"Manual discount RM {newDiscount:0.00}")
                : string.Empty;
        }

        switch (_selectedDiscountItem)
        {
            case BillingItem item:
            {
                var index = PrescriptionItems.IndexOf(item);
                if (index >= 0)
                {
                    PrescriptionItems[index] = item with
                    {
                        Discount = newDiscount,
                        CashDiscountId = cashDiscountId,
                        DiscountMemo = discountMemo
                    };
                }
                break;
            }
            case BillingService service:
            {
                var index = ServiceItems.IndexOf(service);
                if (index >= 0)
                {
                    ServiceItems[index] = service with
                    {
                        Discount = newDiscount,
                        CashDiscountId = cashDiscountId,
                        DiscountMemo = discountMemo
                    };
                }
                break;
            }
            case BillingMemberCredit memberCredit:
            {
                var index = MemberCreditItems.IndexOf(memberCredit);
                if (index >= 0)
                {
                    MemberCreditItems[index] = memberCredit with
                    {
                        Discount = newDiscount,
                        CashDiscountId = cashDiscountId,
                        DiscountMemo = discountMemo
                    };
                }
                break;
            }
            default:
                if (ReferenceEquals(_selectedDiscountItem, BillDiscountToken))
                {
                    BillDiscount = newDiscount;
                    BillDiscountCashDiscountId = cashDiscountId;
                    BillDiscountMemo = discountMemo;
                }
                break;
        }

        SynchronizeBillingPaymentTotals();
        CloseDiscountModal();

        if (newDiscount > 0m)
        {
            Feedback.Success($"Discount of RM {newDiscount:N2} applied.", "Discount applied", 2200);
        }
        else
        {
            Feedback.Info("Discount removed.", "Discount updated", 1800);
        }
    }

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static (decimal BeforeTax, decimal Tax) CalculateBillingLineAmounts(
        decimal unitPrice,
        decimal quantity,
        decimal discount,
        decimal taxRate,
        bool isTaxInclusive)
    {
        Beauty_Aesthetics_WebPos.Components.Services.Tax.OrderLineTaxCalculator.ComputeLineAmounts(
            unitPrice,
            Math.Max(1m, quantity),
            discount,
            taxRate,
            isTaxInclusive,
            out var beforeTax,
            out var tax);

        return (beforeTax, tax);
    }

    private record BillingItem(string Name, int Quantity, decimal UnitPrice, decimal Discount, 
        string? Frequency = null, string? Duration = null, string? Reason = null, string? Notes = null,
        string SourceId = "", string Sku = "", decimal? AvailableStock = null,
        string TaxCode = "", bool IsTaxInclusive = false, decimal TaxRate = 0m,
        string CashDiscountId = "", string DiscountMemo = "")
    {
        public decimal LineTotal => Math.Max(0m, UnitPrice * Quantity - Discount);
        public decimal LineTaxAmount => CalculateBillingLineAmounts(
            UnitPrice, Quantity, Discount, TaxRate, IsTaxInclusive).Tax;
        public decimal LineTotalAfterTax
        {
            get
