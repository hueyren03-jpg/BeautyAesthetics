        }

        if (string.IsNullOrWhiteSpace(_completedSaleDocumentId))
        {
            Feedback.Error(
                "The completed sales document ID is missing.",
                "Receipt unavailable");
            return;
        }

        _isProcessingPayment = true;
        var completed = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await CashSalesService.RequestReceiptPdfAsync(
                _completedSaleDocumentId);

