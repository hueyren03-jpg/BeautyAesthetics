    private async Task ConfirmPaymentAsync()
    {
        SynchronizeBillingPaymentTotals();

        if (AmountReceived is null || AmountReceived < TotalPayable)
        {
            Feedback.Warning(
                $"Add RM {Math.Max(0m, TotalPayable - (AmountReceived ?? 0m)):N2} more before completing the sale.",
                "Payment incomplete");
            return;
        }

        _paymentValidationError = null;
        _isProcessingPayment = true;
        var feedbackId = Feedback.Loading("Completing the sale...", "Saving sale");
        await InvokeAsync(StateHasChanged);

        try
        {
            var transaction = BuildBillingTransaction();
            var result = await CashSalesService.CreateTransactionAsync(transaction);

            if (!result.Success || result.Value is null)
            {
                _paymentValidationError = result.ErrorMessage ?? "Unable to complete the sale.";
                Feedback.Fail(
                    feedbackId,
                    _paymentValidationError,
                    "Sale not completed");
                return;
            }

            _completedSaleDocumentId = result.Value.DocumentId;
            _completedReceiptNumber = result.Value.InvoiceNumber;
            BillingStatusText = "Paid";

            AppState.LastSaleDocumentId = result.Value.DocumentId;
            AppState.LastReceiptNo = result.Value.InvoiceNumber;
            AppState.LastPaidAmount = AmountReceived ?? TotalPayable;
            AppState.LastPaymentMethod = PaymentMethodDisplay;
            AppState.LastCompletedTransaction = result.Value;
            AppState.LastPaymentReturnUrl = PatientContext.WithCustomer("/case-notes");

            _showConfirmPaymentModal = false;

            Feedback.Resolve(
                feedbackId,
                $"Sale {result.Value.InvoiceNumber} completed successfully.",
                "Sale completed");

            NavigationManager.NavigateTo("/complete-sales");
        }
        catch (Exception ex)
        {
            _paymentValidationError = $"Unable to complete the sale: {ex.Message}";
            Feedback.Fail(
                feedbackId,
                _paymentValidationError,
                "Sale not completed");
        }
        finally
        {
            _isProcessingPayment = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Transaction BuildBillingTransaction()
    {
        var branchId = string.IsNullOrWhiteSpace(AppState.SelectedBranchID)
            ? "HQ"
            : AppState.SelectedBranchID!;
        var branchGroupId = AppState.CurrentBranch?.GroupId ?? string.Empty;

        var transaction = new Transaction
        {
            AccountId = _billingCustomerId,
            BranchId = branchId,
            GroupId = branchGroupId,
            Date = DateTime.Now,
            CustomerName = PatientName,
            CustomerContact = PatientPhone == "-" ? string.Empty : PatientPhone,
            Branch = AppState.CurrentBranch?.Name ?? branchId,
            Type = PrescriptionItems.Count > 0 && ServiceItems.Count > 0
                ? "Mixed"
                : ServiceItems.Count > 0 ? "Service" : "Product",
            ItemCount = PrescriptionItems.Sum(item => item.Quantity) + ServiceItems.Sum(item => item.Quantity),
            Amount = TotalPayable,
            Subtotal = Math.Max(0m, Subtotal - DiscountTotal - McCoverage),
            Tax = TaxAmount,
            Discount = DiscountTotal,
            PaymentTypeId = SelectedPaymentSplits.FirstOrDefault()?.PaymentTypeId ?? SelectedPaymentTypeId,
            PaymentMethod = PaymentMethodDisplay,
            Status = "Paid",
            Notes = BuildBillingPaymentNotes(),
            CreatedBy = SelectedCollector,
            Items = BuildBillingTransactionItems(),
            Payments = BuildBillingTransactionPayments()
        };

        return transaction;
    }

    private List<TransactionItem> BuildBillingTransactionItems()
    {
        var items = new List<TransactionItem>();

        items.AddRange(PrescriptionItems.Select(item => new TransactionItem
        {
            InventoryId = item.SourceId,
            Name = item.Name,
            Description = BuildPrescriptionLineDescription(item),
            Category = "Product",
            Quantity = item.Quantity,
            UnitPrice = item.UnitPrice,
            Discount = item.Discount,
            TotalPrice = item.LineTotal
        }));

        items.AddRange(ServiceItems.Select(item => new TransactionItem
        {
            InventoryId = item.SourceId,
            Name = item.Name,
            Description = string.IsNullOrWhiteSpace(item.Description) ? item.Name : item.Description,
            Category = "Service",
            Quantity = item.Quantity,
            UnitPrice = item.UnitPrice,
            Discount = item.Discount,
            TotalPrice = item.LineTotal,
            UnitOfMeasureId = item.UnitOfMeasureId,
            TaxCodeId = item.TaxCode,
            IsTaxInclusive = item.IsTaxInclusive
        }));

        return items;
    }

    private List<TransactionPayment> BuildBillingTransactionPayments()
    {
        if (SelectedPaymentSplits.Any())
        {
            return SelectedPaymentSplits
                .Select(split => new TransactionPayment
                {
                    PaymentTypeId = split.PaymentTypeId,
                    PaymentMethod = split.MethodLabel,
                    Amount = split.Amount ?? 0m,
                    FinancialAccountId = split.FinancialAccountId
                })
                .Where(payment => payment.PaymentTypeId != 0 && payment.Amount > 0)
                .ToList();
        }

        var method = AvailablePaymentMethods.FirstOrDefault(item =>
            item.POSPaymentTypeID == SelectedPaymentTypeId);

        return method is null
            ? new List<TransactionPayment>()
            : new List<TransactionPayment>
            {
                new()
                {
                    PaymentTypeId = method.POSPaymentTypeID,
                    PaymentMethod = method.POSPaymentTypeName ?? SelectedPaymentMethod,
                    Amount = AmountReceived ?? TotalPayable,
                    FinancialAccountId = method.FinancialAccountID ?? string.Empty
                }
            };
    }

    private string BuildBillingPaymentNotes()
    {
        var parts = new List<string>();
        if (McCoverage > 0m) parts.Add($"MC Coverage RM {McCoverage:N2}");
        if (BillDiscount > 0m) parts.Add($"Bill Discount RM {BillDiscount:N2}");
        if (!string.IsNullOrWhiteSpace(SelectedCollectorId)) parts.Add($"Collector {SelectedCollector} ({SelectedCollectorId})");
        return string.Join(" | ", parts);
    }

    private static string BuildPrescriptionLineDescription(BillingItem item)
    {
        var details = new[] { item.Frequency, item.Duration, item.Reason }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var suffix = string.Join(" · ", details);
        return string.IsNullOrWhiteSpace(suffix) ? item.Name : $"{item.Name} - {suffix}";
    }

