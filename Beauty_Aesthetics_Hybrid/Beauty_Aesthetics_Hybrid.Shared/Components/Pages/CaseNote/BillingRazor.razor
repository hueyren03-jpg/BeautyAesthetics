    // Edit/Delete State
    private bool _isDeleteMode;
    private HashSet<BillingItem> _selectedItemsToDelete = new();
    private BillingItem? _editingPrescriptionItem;

    // Service Delete State
    private bool _isServiceDeleteMode;
    private HashSet<BillingService> _selectedServiceItemsToDelete = new();

    // Delete Confirmation State
    private bool _showDeleteConfirmModal;
    private List<(string Name, int Quantity)> _pendingDeleteItems = new();
    private bool _pendingDeleteIsService;

    private void ToggleDeleteMode()
    {
        _isDeleteMode = !_isDeleteMode;
        _selectedItemsToDelete.Clear();
    }

    private void ToggleItemSelection(BillingItem item)
    {
        if (_selectedItemsToDelete.Contains(item))
        {
            _selectedItemsToDelete.Remove(item);
        }
        else
        {
            _selectedItemsToDelete.Add(item);
        }
    }

    private void DeleteSelectedItems()
    {
        _pendingDeleteItems = _selectedItemsToDelete.Select(i => (i.Name, i.Quantity)).ToList();
        _pendingDeleteIsService = false;
        _showDeleteConfirmModal = true;
    }

    private void ConfirmDeleteItems()
    {
        var releasedPoints = Math.Round(
            _pendingDeleteIsService
                ? _selectedServiceItemsToDelete.Sum(item => Math.Max(0m, item.Points))
                : _selectedItemsToDelete.Sum(item => Math.Max(0m, item.Points)),
            2,
            MidpointRounding.AwayFromZero);

        if (_pendingDeleteIsService)
        {
            foreach (var item in _selectedServiceItemsToDelete)
            {
                ServiceItems.Remove(item);
            }
            ToggleServiceDeleteMode();
        }
        else
        {
            foreach (var item in _selectedItemsToDelete)
            {
                PrescriptionItems.Remove(item);
            }
            ToggleDeleteMode();
        }

        if (releasedPoints > 0m)
        {
            ClearBillingTenderAfterPointChange();
            Console.WriteLine(
                $"[Point Step 7] RELEASE | Source=Billing | Customer={_billingCustomerId} | " +
                $"DeletedLines=true | Released={releasedPoints:0.##} | RemainingAllocated={BillingPointsAllocated():0.##}");
        }
        
        var deletedCount = _pendingDeleteItems.Sum(item => item.Quantity);
        _showDeleteConfirmModal = false;
        Feedback.Success(
            $"{deletedCount} billing item{(deletedCount == 1 ? string.Empty : "s")} removed.",
            "Items removed",
            2400);
        StateHasChanged();
    }

    private void CancelDeleteConfirm()
