    private void ConfirmBillingPaymentAmount()
    {
        if (_billingCalculatorMethod is null || BillingCalculatorAmount <= 0m)
        {
            Feedback.Warning("Enter a payment amount first.", "Payment amount required");
            return;
        }

        if (HasBillingPointRedemption &&
            _billingCalculatorMethod.POSPaymentTypeID == -10)
        {
            Console.WriteLine(
                $"[Point Step 8] BLOCKED | Source=Billing | Customer={_billingCustomerId} | " +
                $"Reason=MemberCreditTenderWithPoints");

            Feedback.Warning(
                "Member Credit cannot be combined with point redemption on the same bill.",
                "Payment method not allowed");
            return;
        }

        if (_isOutstandingPaymentMode)
        {
            if (_billingCalculatorMethod.POSPaymentTypeID == -10)
            {
                Feedback.Warning(
                    "Member Credit cannot be used for Outstanding settlement.",
                    "Payment method not allowed");
                return;
            }

            if (BillingCalculatorAmount > BillingCalculatorRemaining + 0.009m)
            {
                Feedback.Warning(
                    $"This payment method cannot exceed RM {BillingCalculatorRemaining:N2}; the split total must remain RM {PaymentTotalPayable:N2}.",
                    "Amount too high");
                return;
            }
        }

        var payment = BillingPaymentFor(_billingCalculatorMethod.POSPaymentTypeID);
        if (payment is null)
        {
            payment = new TransactionPayment
            {
                PaymentTypeId = _billingCalculatorMethod.POSPaymentTypeID
            };
            ActiveBillingPayments.Add(payment);
        }

        payment.PaymentMethod =
            _billingCalculatorMethod.POSPaymentTypeName ?? "Payment";
        payment.Amount = BillingCalculatorAmount;
        payment.FinancialAccountId =
            _billingCalculatorMethod.FinancialAccountID ?? string.Empty;
        payment.BankName =
            _billingCalculatorMethod.FinancialAccountName ?? string.Empty;

        SynchronizeBillingPaymentTotals();
        CloseBillingPaymentCalculator();
        StateHasChanged();
    }

    private void SynchronizeBillingPaymentTotals()
    {
        var total = BillingPaidAmount;
        AmountReceived = total > 0m ? total : null;
        AmountReceivedText = total > 0m ? total.ToString("0.00") : string.Empty;
        AmountReceivedError = null;

        var first = ActiveBillingPayments.FirstOrDefault();
        if (first is null)
        {
            SelectedPaymentTypeId = 0;
            SelectedPaymentMethod = string.Empty;
            return;
        }

        SelectedPaymentTypeId = first.PaymentTypeId;
        SelectedPaymentMethod = first.PaymentMethod;
    }

