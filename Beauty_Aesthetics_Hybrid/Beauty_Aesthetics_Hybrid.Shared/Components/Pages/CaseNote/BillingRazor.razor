    private async Task AddMemberCreditFromCatalogAsync(MembershipViewModel.MemberCredit credit)
    {
        if (HasBillingPackageRedemption) return;
        if (string.IsNullOrWhiteSpace(_billingCustomerId))
        {
            Feedback.Warning("Select a valid customer before adding Member Credit.", "Customer required");
            return;
        }

        var creditId = credit.MasterAccountId?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(creditId) || !string.IsNullOrWhiteSpace(_loadingMemberCreditId))
        {
            return;
        }

        _loadingMemberCreditId = creditId;
        await InvokeAsync(StateHasChanged);

        try
        {
            var detailResult = await MemberCreditService.LoadMemberCreditAsync(creditId);
            var detail = detailResult.Success && detailResult.Value is not null
                ? detailResult.Value
                : credit;

            if (!detailResult.Success)
            {
                Console.WriteLine(
                    $"[Billing Member Credit] Falling back to catalog summary for {creditId}: {detailResult.ErrorMessage}");
            }

            // The catalog itself already came from Inventory/LoadProxy for the current branch.
            // Like Senang, full-load only the selected Top Up for its complete configuration.
            var taxRate = await GstTaxRateService.GetRateForTaxCodeAsync(detail.TaxCode);
            var existing = MemberCreditItems.FirstOrDefault(item =>
                string.Equals(item.SourceId, creditId, StringComparison.OrdinalIgnoreCase));

            if (existing is not null)
            {
                var index = MemberCreditItems.IndexOf(existing);
                MemberCreditItems[index] = existing with { Quantity = existing.Quantity + 1 };
            }
            else
            {
                MemberCreditItems.Add(new BillingMemberCredit(
                    detail.Name,
                    1,
                    detail.Price,
                    0m,
                    creditId,
                    detail.Code,
                    detail.TaxCode,
                    detail.IsTaxInclusive,
                    taxRate));
            }

            _showMemberCreditPickerModal = false;
            Feedback.Success($"{detail.Name} added to billing.", "Member Credit added", 2200);
        }
        catch (Exception ex)
        {
            Feedback.Error($"Unable to add Member Credit: {ex.Message}", "Member Credit not added");
        }
        finally
        {
            _loadingMemberCreditId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

