    private static string GetStaffInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string GetStaffSecondaryText(Employee employee)
    {
        if (!string.IsNullOrWhiteSpace(employee.JobTitle))
        {
            return employee.JobTitle;
        }

        if (!string.IsNullOrWhiteSpace(employee.SalesPersonCode))
        {
            return employee.SalesPersonCode;
        }

        return employee.IsServiceStaff ? "Service staff" : "Active staff";
    }

