    private async Task ToggleBillingProductPointRedemptionAsync(BillingItem item)
    {
        if (HasBillingPackageRedemption) { Feedback.Warning("Complete package redemption before using points.", "Separate transaction required"); return; }
        var index = PrescriptionItems.IndexOf(item);
        if (index < 0)
        {
            return;
        }

        if (item.Points > 0m)
        {
            var released = item.Points;
            PrescriptionItems[index] = item with
            {
                Points = 0m,
                UnitPrice = item.OriginalUnitPrice
            };
            ClearBillingTenderAfterPointChange();

            Console.WriteLine(
                $"[Point Step 7] RELEASE | Source=Billing | Customer={_billingCustomerId} | " +
                $"Inventory={item.SourceId} | Type=1 | Released={released:0.##} | " +
                $"RemainingAllocated={BillingPointsAllocated():0.##}");

            Feedback.Info($"{released:0.##} points were released from {item.Name}.", "Points removed", 2200);
            return;
        }

        if (_isOutstandingPaymentMode)
        {
            Feedback.Warning("Point redemption is only available for the current Billing sale.", "Points unavailable");
            return;
        }

        if (string.IsNullOrWhiteSpace(_billingCustomerId))
        {
            Feedback.Warning("Select a valid customer before using points.", "Customer required");
            return;
        }

        var productResult =
            await ProductInventoryService.LoadProductPointConfigurationAsync(item.SourceId);
        if (!productResult.Success || productResult.Value is null)
        {
            Feedback.Error(
                productResult.ErrorMessage ?? "Unable to load the product point configuration.",
                "Points unavailable");
            return;
        }

        var pointToRedeem = Math.Max(0m, productResult.Value.RedeemPoint);
        var eligible =
            productResult.Value.AllowPointRedemption &&
            pointToRedeem > 0m;

        Console.WriteLine(
            $"[Point Step 3] BILLING ELIGIBILITY | Inventory={item.SourceId} | Type=1 | " +
            $"Allow={productResult.Value.AllowPointRedemption} | PointToRedeem={pointToRedeem:0.##} | Eligible={eligible}");

        if (!eligible)
        {
            Feedback.Warning(
                $"{item.Name} is not configured for point redemption.",
                "Points unavailable");
            return;
        }

        var balanceResult = await CustomerService.GetBalanceSummaryAsync(_billingCustomerId);
        if (!balanceResult.Success || balanceResult.Value is null)
        {
            Feedback.Error(
                balanceResult.ErrorMessage ?? "Unable to load the latest point balance.",
                "Point balance unavailable");
            return;
        }

        CustomerPointBalance = balanceResult.Value.PointBalance;
        var required = Math.Round(
            pointToRedeem * Math.Max(1, item.Quantity),
            2,
            MidpointRounding.AwayFromZero);
        var allocatedElsewhere = BillingPointsAllocated(item);
        var latestBalance = Math.Max(0m, balanceResult.Value.PointBalance);
        var availableForThisLine = Math.Max(0m, latestBalance - allocatedElsewhere);

        Console.WriteLine(
            $"[Point Step 4] BILLING CONVERSION | Inventory={item.SourceId} | " +
            $"Rule=FixedItemPointToRedeem | PointToRedeem={pointToRedeem:0.##} | " +
            $"Qty={item.Quantity} | Required={required:0.##} | PriceMode=FullReplacement");

        Console.WriteLine(
            $"[Point Step 6] BALANCE CHECK | Source=Billing | Customer={_billingCustomerId} | " +
            $"Inventory={item.SourceId} | Type=1 | LatestBalance={latestBalance:0.##} | " +
            $"AllocatedElsewhere={allocatedElsewhere:0.##} | Available={availableForThisLine:0.##} | " +
            $"Required={required:0.##}");

        if (required <= 0m ||
            required - availableForThisLine > 0.009m)
        {
            Console.WriteLine(
                $"[Point Step 6] BLOCKED | Source=Billing | Customer={_billingCustomerId} | " +
                $"Inventory={item.SourceId} | Type=1 | Available={availableForThisLine:0.##} | Required={required:0.##}");

            Feedback.Warning(
                $"Insufficient points. Available: {availableForThisLine:0.##} pts, Required: {required:0.##} pts.",
                "Not enough points");
            return;
        }

        Console.WriteLine(
            $"[Point Step 6] PASS | Source=Billing | Customer={_billingCustomerId} | " +
            $"Inventory={item.SourceId} | Type=1 | AvailableBeforeAssignment={availableForThisLine:0.##} | " +
            $"Required={required:0.##} | RemainingAfterAssignment={Math.Max(0m, availableForThisLine - required):0.##}");

        PrescriptionItems[index] = item with
        {
            PointToRedeem = pointToRedeem,
            AllowPointRedemption = true,
            Points = required,
            OriginalUnitPrice = item.UnitPrice,
            UnitPrice = 0m,
            Discount = 0m,
            CashDiscountId = string.Empty,
            DiscountMemo = string.Empty
        };

        var assignedProduct = PrescriptionItems[index];
        Console.WriteLine(
            $"[Point Step 5] LINE ASSIGNED | Source=Billing | Inventory={assignedProduct.SourceId} | " +
            $"Type=1 | Qty={assignedProduct.Quantity} | " +
            $"PointToRedeem={assignedProduct.PointToRedeem:0.##} | Points={assignedProduct.Points:0.##} | " +
            $"UnitPrice={assignedProduct.UnitPrice:N2} | OriginalUnitPrice={assignedProduct.OriginalUnitPrice:N2}");

        ClearBillingTenderAfterPointChange();

        Console.WriteLine(
            $"[Point Step 7] TOTAL ALLOCATION | Source=Billing | Customer={_billingCustomerId} | " +
            $"Lines={PrescriptionItems.Count(candidate => candidate.Points > 0m) + ServiceItems.Count(candidate => candidate.Points > 0m)} | " +
            $"Allocated={BillingPointsAllocated():0.##} | LatestBalance={latestBalance:0.##} | " +
            $"AvailableRemaining={Math.Max(0m, latestBalance - BillingPointsAllocated()):0.##}");

        Feedback.Success(
            $"{required:0.##} points applied to {item.Name}.",
            "Points applied",
            2200);
    }

