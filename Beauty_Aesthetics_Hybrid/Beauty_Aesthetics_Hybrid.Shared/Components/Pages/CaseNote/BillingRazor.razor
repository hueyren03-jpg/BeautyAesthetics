            await FileDownloadService.DownloadBinaryFileAsync(
                fileName,
                receiptPdf,
                "application/pdf");

            Feedback.Success(
                $"{fileName} downloaded.",
                "Receipt downloaded",
                2400);

            completed = true;
        }
        catch (Exception ex)
        {
            Feedback.Error(
                $"Unable to download receipt: {ex.Message}",
                "Receipt download failed");
        }
        finally
        {
            _isProcessingPayment = false;
            if (completed)
            {
                _showPaymentSummaryModal = false;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ProcessReceiptAction(string action)
    {
        if (_isProcessingPayment)
        {
            return;
        }

        if (string.Equals(action, "email", StringComparison.OrdinalIgnoreCase))
        {
            Feedback.Warning(
                "The Senang receipt API generates the receipt PDF, but it does not provide a server-side email receipt endpoint.",
                "Receipt email not available");
            return;
        }

        if (string.IsNullOrWhiteSpace(_completedSaleDocumentId))
        {
            Feedback.Error(
                "The completed sales document ID is missing.",
                "Receipt unavailable");
            return;
        }

        _isProcessingPayment = true;
        var completed = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await CashSalesService.RequestReceiptPdfAsync(
                _completedSaleDocumentId);

            if (!result.Success || string.IsNullOrWhiteSpace(result.Value))
            {
                Feedback.Error(
                    result.ErrorMessage ?? "Unable to generate the receipt PDF.",
                    "Receipt unavailable");
                return;
            }

            var receiptPdf = result.Value.Trim();
            var receiptDataUrl = receiptPdf.StartsWith(
                "data:application/pdf;base64,",
                StringComparison.OrdinalIgnoreCase)
                ? receiptPdf
                : $"data:application/pdf;base64,{receiptPdf}";

            await JS.InvokeVoidAsync("open", receiptDataUrl, "_blank");

            Feedback.Success(
                string.IsNullOrWhiteSpace(_completedReceiptNumber)
                    ? "Receipt PDF opened."
                    : $"Receipt {_completedReceiptNumber} opened.",
                "Receipt ready",
                2400);

            completed = true;
        }
        catch (Exception ex)
        {
            Feedback.Error(
                $"Unable to prepare receipt: {ex.Message}",
                "Receipt unavailable");
        }
        finally
        {
            _isProcessingPayment = false;
            if (completed)
            {
                _showPaymentSummaryModal = false;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

