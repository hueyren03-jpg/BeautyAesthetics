@page "/billing"
@using Beauty_Aesthetics_WebPos.APIClient
@using Beauty_Aesthetics_WebPos.Components.Layout
@using Beauty_Aesthetics_WebPos.Components.Shared
@layout EmptyLayout
@using Microsoft.AspNetCore.Components
@using Beauty_Aesthetics_WebPos.Components.ViewModels
@using Beauty_Aesthetics_WebPos.Components.Models.Employee
@using Beauty_Aesthetics_WebPos.Components.Models
@using Beauty_Aesthetics_WebPos.Components.Services.Printing
@using Beauty_Aesthetics_WebPos.Models.DTOs
@using System.Linq
@using System.Text.RegularExpressions
@inject NavigationManager NavigationManager
@inject AppFeedbackService Feedback
@inject Beauty_Aesthetics_WebPos.Components.Services.Clinical.ClinicalPatientContext PatientContext
@inject Beauty_Aesthetics_WebPos.Components.Services.Customers.ICustomerService CustomerService
@inject Beauty_Aesthetics_WebPos.Components.Services.Customers.IPointHistoryService PointHistoryService
@inject Beauty_Aesthetics_WebPos.Components.Services.Customers.IMemberCreditWalletService MemberCreditWalletService
@inject Beauty_Aesthetics_WebPos.Components.Services.Customers.IOutstandingBalanceService OutstandingBalanceService
@inject Beauty_Aesthetics_WebPos.Components.Services.AppointmentService AppointmentService
@inject Beauty_Aesthetics_WebPos.Components.Services.Inventory.IProductInventoryService ProductInventoryService
@inject Beauty_Aesthetics_WebPos.Components.Services.Inventory.IServiceItemService ServiceItemService
@inject Beauty_Aesthetics_WebPos.Components.Services.Inventory.IMemberCreditService MemberCreditService
@inject Beauty_Aesthetics_WebPos.Components.Services.Employees.IEmployeeService EmployeeService
@inject Beauty_Aesthetics_WebPos.Components.Services.Sales.ICashSalesService CashSalesService
@inject Beauty_Aesthetics_WebPos.Components.Services.Sales.ICashDiscountService CashDiscountService
@inject Beauty_Aesthetics_WebPos.Components.Services.Tax.IGstTaxRateService GstTaxRateService
@inject BranchAC BranchAC
@inject Beauty_Aesthetics_WebPos.Components.Services.Printing.IPrinterSelectionService PrinterSelectionService
@inject Beauty_Aesthetics_WebPos.Components.Services.Printing.IReceiptPrinterService ReceiptPrinterService
@inject Beauty_Aesthetics_WebPos.Components.Services.Inventory.ProductImageService ProductImageService
@inject Beauty_Aesthetics_WebPos.Components.Services.AppState AppState
@inject Beauty_Aesthetics_WebPos.Components.Services.Branches.IBranchSessionService BranchSession
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Billing - Beauty Aesthetics</PageTitle>

<div class="billing-page">
<button class="billing-close-btn" @onclick="CloseBilling" aria-label="Close billing and return to case notes">
        <i class="bi bi-x-lg"></i>
    </button>
    <button type="button"
            class="billing-patient-drawer-btn"
            @onclick="TogglePatientDrawer"
            title="View Patient Information"
            aria-label="View Patient Information"
            aria-expanded="@_isPatientDrawerOpen">
        <i class="bi bi-person-vcard"></i>
    </button>
    <div class="main-layout">
        <!-- Main Content Area -->
        <main class="content-area">
            <!-- Patient Info Card - same structure as CaseNotePage -->
                        @if (_isPatientDrawerOpen)
            {
                <button type="button"
                        class="patient-drawer-backdrop"
                        @onclick="ClosePatientDrawer"
                        aria-label="Close Patient Information"></button>
            }

            <div class="info-card patient-drawer @( _isPatientInfoCollapsed ? "collapsed" : string.Empty ) @(_isPatientDrawerOpen ? "open" : string.Empty)">
                <div class="info-card-header" @onclick="TogglePatientInfo">
                    <div class="info-card-title">
                        <i class="bi bi-person-badge"></i>
                        <span>Patient Information</span>
                    </div>
                    <button class="btn-toggle-info" title="@(_isPatientInfoCollapsed ? "Expand" : "Collapse")">
                        <i class="bi @(_isPatientInfoCollapsed ? "bi-chevron-down" : "bi-chevron-up")"></i>
                    </button>
                    <button type="button"
                            class="patient-drawer-close"
                            @onclick="ClosePatientDrawer"
                            @onclick:stopPropagation="true"
                            title="Close Patient Information"
                            aria-label="Close Patient Information">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="info-card-content">
                    <div class="info-grid">
                        <div class="info-item">
                            <i class="bi bi-person"></i>
                            <div class="info-content">
                                <span class="info-label">Name</span>
                                <span class="info-value">@PatientName</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="bi bi-calendar-heart"></i>
                            <div class="info-content">
                                <span class="info-label">Birthday</span>
                                <span class="info-value">@PatientBirthday</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="bi bi-telephone"></i>
                            <div class="info-content">
                                <span class="info-label">Phone</span>
                                <span class="info-value">@PatientPhone</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Billing Card -->
            <div class="billing-card">
                <!-- Billing Header -->
                <div class="billing-header">
                    <div class="billing-header-left">
                        <div class="billing-title-row">
                            <i class="bi bi-wallet2"></i>
                            <h2>@(_billingStep == "payment" ? (_isOutstandingPaymentMode ? "Outstanding Payment" : "Payment") : "Billing")</h2>
                        </div>
                    </div>
                    <div class="billing-header-right">
                        <div class="billing-status @BillingStatusCss">
                            <span class="status-dot"></span>
                            <span>@BillingStatusText</span>
                        </div>
                    </div>
                </div>

                @if (_billingStep == "summary")
                {
                    <section class="billing-wallet-overview" aria-label="Patient balances">
                        <div class="billing-wallet-actions" aria-busy="@_isCustomerBalanceLoading">
                            <button type="button" class="billing-wallet-action" aria-haspopup="dialog" aria-expanded="@_showOutstandingSettlement" @onclick="OpenOutstandingSettlementAsync">
                                <span class="billing-wallet-action-icon"><i class="bi bi-receipt-cutoff" aria-hidden="true"></i></span>
                                <span class="billing-wallet-action-copy"><span>Outstanding</span><strong>@FormatMoneyBalance(CustomerOutstandingBalance)</strong></span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="billing-wallet-action" aria-haspopup="dialog" aria-expanded="@_showPointHistory" @onclick="OpenPointHistoryAsync">
                                <span class="billing-wallet-action-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                                <span class="billing-wallet-action-copy"><span>Points</span><strong>@FormatPointBalance(CustomerPointBalance)</strong></span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="billing-wallet-action" aria-haspopup="dialog" aria-expanded="@showCustomerPackageDialog" @onclick="OpenCustomerPackages">
                                <span class="billing-wallet-action-icon"><i class="bi bi-box2-heart" aria-hidden="true"></i></span>
                                <span class="billing-wallet-action-copy"><span>Packages</span><strong>@FormatPackageBalance(CustomerPackageBalance)</strong></span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="billing-wallet-action" aria-haspopup="dialog" aria-expanded="@_showRedeemableCredits" @onclick="OpenRedeemableCredits">
                                <span class="billing-wallet-action-icon"><i class="bi bi-credit-card-2-front" aria-hidden="true"></i></span>
                                <span class="billing-wallet-action-copy"><span>Member Credit</span><strong>@FormatMoneyBalance(CustomerCreditBalance)</strong></span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </button>
                        </div>
                    </section>
                }

                <!-- Billing Content -->
                <div class="billing-content @(_billingStep == "payment" ? "billing-content--payment-step" : "billing-content--summary-step")">
                    @if (_billingStep == "summary")
                    {
                    <!-- Left: Items -->
                    <div class="billing-left">
                        <div class="billing-section">
                            <div class="section-header">
                                <h3>Prescription Items</h3>
                                <div class="header-actions" style="display: flex; gap: 8px;">
                                    @if (_isDeleteMode)
                                    {
                                        <button class="btn-delete-confirm" @onclick="DeleteSelectedItems" disabled="@(!_selectedItemsToDelete.Any())">
                                            Confirm Delete (@_selectedItemsToDelete.Count)
                                        </button>
                                        <button class="btn-delete-cancel" @onclick="ToggleDeleteMode">
                                            Cancel
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-delete-mode" @onclick="ToggleDeleteMode" title="Delete Items">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <button type="button"
                                                class="btn-add-prescription"
                                                @onclick="OpenPrescriptionModal">
                                            <i class="bi bi-plus-lg"></i>
                                            <span>Add Item</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="table-wrapper">
                                <table class="billing-table">
                                    <thead>
                                        <tr>
                                            @if (_isDeleteMode)
                                            {
                                                <th class="col-checkbox" style="width: 40px;"></th>
                                            }
                                            <th>Item</th>
                                            <th>Qty</th>
                                            <th>Unit Price</th>
                                            <th>Discount</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (PrescriptionItems.Count == 0)
                                        {
                                            <tr class="empty-row"><td colspan="@(_isDeleteMode ? 6 : 5)">No prescription items added.</td></tr>
                                        }
                                        @foreach (var item in PrescriptionItems)
                                        {
                                            <tr @onclick="@(() => { if (_isDeleteMode) ToggleItemSelection(item); })"
                                                class="@(_isDeleteMode ? "row-clickable" : "")">
                                                @if (_isDeleteMode)
                                                {
                                                    <td>
                                                        <input type="checkbox" 
                                                               class="delete-checkbox"
                                                               checked="@_selectedItemsToDelete.Contains(item)" 
                                                               @onchange="() => ToggleItemSelection(item)"
                                                               @onclick:stopPropagation="true" />
                                                    </td>
                                                }
                                                <td>
                                                    <span class="clickable-item-name" @onclick="() => EditPrescriptionItem(item)" style="cursor: pointer;">
                                                        @item.Name
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(item.Sku))
                                                    {
                                                        <small class="billing-line-code">@item.Sku</small>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.TaxCode))
                                                    {
                                                        <small class="billing-line-code">
                                                            Tax @item.TaxCode · @((item.TaxRate * 100m).ToString("0.##"))% · @(item.IsTaxInclusive ? "Inclusive" : "Exclusive") · RM @item.LineTaxAmount.ToString("N2")
                                                        </small>
                                                    }
                                                    @if (item.Points > 0m)
                                                    {
                                                        <small class="billing-line-code point-line-badge">
                                                            <i class="bi bi-stars"></i> Points redeemed · @item.Points.ToString("0.##") pts
                                                        </small>
                                                    }
                                                    <button type="button"
                                                            class="btn-discount-cell"
                                                            @onclick="() => ToggleBillingProductPointRedemptionAsync(item)"
                                                            @onclick:stopPropagation="true">
                                                        <i class="bi bi-stars"></i>
                                                        @(item.Points > 0m ? "Remove points" : "Use points")
                                                    </button>
                                                </td>
                                                <td>@item.Quantity</td>
                                                <td>RM @item.UnitPrice.ToString("N2")</td>
                                                <td>
                                                    <button class="btn-discount-cell" @onclick="() => OpenDiscountModal(item)">
                                                        @if (item.Discount > 0)
                                                        {
                                                            <span class="discount-active">-RM @item.Discount.ToString("N2")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="discount-empty">Add Discount</span>
                                                        }
                                                    </button>
                                                </td>
                                                <td>RM @item.LineTotalAfterTax.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="billing-section">
                            <div class="section-header">
                                <h3>Services</h3>
                                <div class="header-actions" style="display: flex; gap: 8px;">
                                    @if (_isServiceDeleteMode)
                                    {
                                        <button class="btn-delete-confirm" @onclick="DeleteSelectedServiceItems" disabled="@(!_selectedServiceItemsToDelete.Any())">
                                            Confirm Delete (@_selectedServiceItemsToDelete.Count)
                                        </button>
                                        <button class="btn-delete-cancel" @onclick="ToggleServiceDeleteMode">
                                            Cancel
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-delete-mode" @onclick="ToggleServiceDeleteMode" title="Delete Items">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <button type="button"
                                                class="btn-add-prescription btn-add-service"
                                                @onclick="OpenServicePickerModal">
                                            <i class="bi bi-plus-lg"></i>
                                            <span>Service</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="table-wrapper">
                                <table class="billing-table">
                                    <thead>
                                        <tr>
                                            @if (_isServiceDeleteMode)
                                            {
                                                <th style="width: 40px;"></th>
                                            }
                                            <th>Service</th>
                                            <th>Staff</th>
                                            <th>Qty</th>
                                            <th>Unit Price</th>
                                            <th>Discount</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (ServiceItems.Count == 0)
                                        {
                                            <tr class="empty-row"><td colspan="@(_isServiceDeleteMode ? 7 : 6)">No services added.</td></tr>
                                        }
                                        @foreach (var service in ServiceItems)
                                        {
                                            <tr @onclick="@(() => { if (_isServiceDeleteMode) ToggleServiceItemSelection(service); })"
                                                class="@(_isServiceDeleteMode ? "row-clickable" : "")">
                                                @if (_isServiceDeleteMode)
                                                {
                                                    <td>
                                                        <input type="checkbox" 
                                                               class="delete-checkbox"
                                                               checked="@_selectedServiceItemsToDelete.Contains(service)"
                                                               @onchange="@(() => ToggleServiceItemSelection(service))"
                                                               @onclick:stopPropagation="true" />
                                                    </td>
                                                }
                                                <td>
                                                    <span>@service.Name</span>
                                                    @if (!string.IsNullOrWhiteSpace(service.Sku))
                                                    {
                                                        <small class="billing-line-code">@service.Sku</small>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(service.TaxCode))
                                                    {
                                                        <small class="billing-line-code">
                                                            Tax @service.TaxCode · @((service.TaxRate * 100m).ToString("0.##"))% · @(service.IsTaxInclusive ? "Inclusive" : "Exclusive") · RM @service.LineTaxAmount.ToString("N2")
                                                        </small>
                                                    }
                                                    @if (service.Points > 0m)
                                                    {
                                                        <small class="billing-line-code point-line-badge">
                                                            <i class="bi bi-stars"></i> Points redeemed · @service.Points.ToString("0.##") pts
                                                        </small>
                                                    }
                                                    <button type="button"
                                                            class="btn-discount-cell"
                                                            @onclick="() => ToggleBillingServicePointRedemptionAsync(service)"
                                                            @onclick:stopPropagation="true">
                                                        <i class="bi bi-stars"></i>
                                                        @(service.Points > 0m ? "Remove points" : "Use points")
                                                    </button>
                                                </td>
                                                <td>@service.Staff</td>
                                                <td>@service.Quantity</td>
                                                <td>RM @service.UnitPrice.ToString("N2")</td>
                                                <td>
                                                    <button class="btn-discount-cell" @onclick="() => OpenDiscountModal(service)">
                                                        @if (service.Discount > 0)
                                                        {
                                                            <span class="discount-active">-RM @service.Discount.ToString("N2")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="discount-empty">Add Discount</span>
                                                        }
                                                    </button>
                                                </td>
                                                <td>RM @service.LineTotalAfterTax.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="billing-section billing-member-credit-purchases">
                            <div class="section-header">
                                <h3>Member Credit</h3>
                                <div class="header-actions" style="display:flex; gap:8px;">
                                    <button type="button"
                                            class="btn-add-prescription btn-add-service"
                                            @onclick="OpenMemberCreditPickerModal">
                                        <i class="bi bi-plus-lg"></i>
                                        <span>Buy Credit</span>
                                    </button>
                                </div>
                            </div>
                            <div class="table-wrapper">
                                <table class="billing-table">
                                    <thead>
                                        <tr>
                                            <th>Member Credit</th>
                                            <th>Qty</th>
                                            <th>Unit Price</th>
                                            <th>Discount</th>
                                            <th>Total</th>
                                            <th style="width:52px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (MemberCreditItems.Count == 0)
                                        {
                                            <tr class="empty-row"><td colspan="6">No credit added.</td></tr>
                                        }
                                        @foreach (var credit in MemberCreditItems)
                                        {
                                            <tr>
                                                <td data-label="Member Credit">
                                                    <span>@credit.Name</span>
                                                    @if (!string.IsNullOrWhiteSpace(credit.Sku))
                                                    {
                                                        <small class="billing-line-code">@credit.Sku</small>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(credit.TaxCode))
                                                    {
                                                        <small class="billing-line-code">
                                                            Tax @credit.TaxCode · @((credit.TaxRate * 100m).ToString("0.##"))% · @(credit.IsTaxInclusive ? "Inclusive" : "Exclusive") · RM @credit.LineTaxAmount.ToString("N2")
                                                        </small>
                                                    }
                                                </td>
                                                <td data-label="Qty">@credit.Quantity</td>
                                                <td data-label="Unit Price">RM @credit.UnitPrice.ToString("N2")</td>
                                                <td data-label="Discount">
                                                    <button class="btn-discount-cell" @onclick="() => OpenDiscountModal(credit)">
                                                        @if (credit.Discount > 0m)
                                                        {
                                                            <span class="discount-active">-RM @credit.Discount.ToString("N2")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="discount-empty">Add Discount</span>
                                                        }
                                                    </button>
                                                </td>
                                                <td data-label="Total">RM @credit.LineTotalAfterTax.ToString("N2")</td>
                                                <td class="billing-credit-purchase-remove">
                                                    <button type="button"
                                                            class="btn-delete-mode"
                                                            title="Remove Member Credit"
                                                            aria-label="@($"Remove {credit.Name}")"
                                                            @onclick="() => RemoveMemberCreditItem(credit)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <section class="billing-section billing-packages">
                            <div class="section-header">
                                <h3>Packages</h3>
                                <div class="billing-package-actions">
                                    <button type="button" disabled="@(!CanBuyBillingPackage)" @onclick="OpenBillingPackagePurchase"><i class="bi bi-plus-lg"></i> Buy Package</button>
                                    <button type="button" disabled="@(!CanRedeemBillingPackage)" @onclick="OpenCustomerPackages"><i class="bi bi-box2-heart"></i> Redeem</button>
                                </div>
                            </div>
                            @if (BillingPackageItems.Count == 0)
                            {
                                <div class="billing-package-empty">No packages added.</div>
                            }
                            @foreach (var item in BillingPackageItems)
                            {
                                <article class="billing-package-line">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="" /> }
                                    else { <span class="billing-package-picture"><i class="bi bi-box2-heart"></i></span> }
                                    <div class="billing-package-copy"><strong>@item.Name</strong><small>@item.Sku</small>
                                        @if (item.IsPackageRedemption) { <span class="billing-package-status">@item.Quantity redeemed</span><small>@item.SourceDocumentLineId</small> }
                                        else { <small>RM @item.UnitPrice.ToString("N2") each</small> }
                                    </div>
                                    @if (!item.IsPackageRedemption)
                                    {
                                        <div class="billing-package-stepper">
                                            <button type="button" aria-label="Decrease package quantity" disabled="@(IsAppointmentPaymentLocked || _isProcessingPayment || item.Quantity <= 1)" @onclick="() => ChangeBillingPackageQuantity(item, -1)"><i class="bi bi-dash"></i></button>
                                            <span>@item.Quantity</span>
                                            <button type="button" aria-label="Increase package quantity" disabled="@(IsAppointmentPaymentLocked || _isProcessingPayment)" @onclick="() => ChangeBillingPackageQuantity(item, 1)"><i class="bi bi-plus"></i></button>
                                        </div>
                                    }
                                    <strong class="billing-package-amount">@(item.IsPackageRedemption ? "Covered" : $"RM {PackageLineTotal(item):N2}")</strong>
                                    <button type="button" class="billing-package-remove" aria-label="@($"Remove {item.Name}")" disabled="@(IsAppointmentPaymentLocked || _isProcessingPayment)" @onclick="() => RemoveBillingPackageItem(item)"><i class="bi bi-trash"></i></button>
                                </article>
                            }
                        </section>

                        <div class="billing-section mc-section">
                            <div class="section-header">
                                <h3>MC / Medical Certificate</h3>
                            </div>
                            <div class="mc-body">
                                <div class="mc-actions">
                                    <button class="btn-mc-action btn-mc-print" type="button">
                                        <i class="bi bi-printer"></i>
                                        <span>Print MC</span>
                                    </button>
                                    <button class="btn-mc-action btn-mc-email" type="button">
                                        <i class="bi bi-envelope"></i>
                                        <span>Email MC</span>
                                    </button>
                                    <button class="btn-mc-action btn-mc-whatsapp" type="button">
                                        <i class="bi bi-whatsapp"></i>
                                        <span>WhatsApp MC</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    }

                    <!-- Right: Summary / Payment -->
                    <div class="billing-right @(_billingStep == "payment" ? "billing-right--payment-step" : string.Empty)">
                        @if (_billingStep == "summary")
                        {
                        <div class="billing-section">
                            <div class="section-header">
                                <h3>Summary</h3>
                            </div>
                            <div class="summary-list">
                                <div class="summary-row">
                                    <span>Subtotal before discount</span>
                                    <span>RM @GrossSubtotal.ToString("N2")</span>
                                </div>
                                @if (LineDiscountTotal > 0m)
                                {
                                    <div class="summary-row">
                                        <span>Item Discounts</span>
                                        <span>-RM @LineDiscountTotal.ToString("N2")</span>
                                    </div>
                                }
                                <div class="summary-row">
                                    <span>Bill Discount</span>
                                    <button class="btn-summary-discount" @onclick="() => OpenDiscountModal(BillDiscountToken)">
                                        @if (BillDiscount > 0)
                                        {
                                            <span class="discount-value discount-active">
                                                <i class="bi bi-tag-fill"></i> -RM @BillDiscount.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="discount-placeholder">
                                                <i class="bi bi-plus-circle-dotted"></i> Add Discount
                                            </span>
                                        }
                                    </button>
                                </div>
                                <div class="summary-row">
                                    <span>Subtotal before tax</span>
                                    <span>RM @SubtotalBeforeTax.ToString("N2")</span>
                                </div>
                                @if (TaxAmount > 0m)
                                {
                                    <div class="summary-row">
                                        <span>Tax</span>
                                        <span>RM @TaxAmount.ToString("N2")</span>
                                    </div>
                                }
                                @if (RoundingAmount != 0m)
                                {
                                    <div class="summary-row">
                                        <span>Rounding</span>
                                        <span>@($"{(RoundingAmount >= 0m ? "+" : "-")}RM {Math.Abs(RoundingAmount):N2}")</span>
                                    </div>
                                }
                                <div class="summary-divider"></div>
                                @if (HasBillingPackageRedemption)
                                {
                                    <div class="summary-row"><span>Package Sessions</span><span>-RM @BillingPackageCoveredAmount.ToString("N2")</span></div>
                                }
                                <div class="summary-row total-row">
                                    <span>Total Payable</span>
                                    <span>RM @BillingAmountDue.ToString("N2")</span>
                                </div>
                            </div>
                        </div>


                        <div class="billing-next-step">
                            <button type="button"
                                    class="btn-proceed-payment"
                                    disabled="@IsAppointmentPaymentLocked"
                                    @onclick="GoToPayment">
                                <span>@(IsAppointmentPaymentLocked ? "Already Paid" : "Proceed to Payment")</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                        }

                        @if (_billingStep == "payment")
                        {
                        <div class="billing-payment-page">
                            <div class="payment-step-header">
                                <button type="button" class="btn-back-to-billing" @onclick="BackToBilling">
                                    <i class="bi bi-arrow-left"></i>
                                    <span>Back to Billing</span>
                                </button>
                            </div>

                            <div class="payment-checkout-grid">
                                <div class="payment-checkout-main">
                                    <section class="payment-panel">
                                        <div class="payment-panel-heading">
                                            <div class="payment-panel-icon"><i class="bi bi-credit-card-2-front"></i></div>
                                            <div>
                                                <h4>@(HasBillingPackageRedemption && CanCompleteBillingWithoutTender ? "Package Redemption" : "Payment Method")</h4>
                                            </div>
                                        </div>

                                        @if (HasBillingPackageRedemption && CanCompleteBillingWithoutTender)
                                        {
                                            <div class="billing-package-covered"><i class="bi bi-check-circle"></i><span>Covered by package</span></div>
                                        }
                                        else if (_isPaymentMethodsLoading)
                                        {
                                            <div class="payment-method-loading">
                                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                <span>Loading payment methods...</span>
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(_paymentMethodsError))
                                        {
                                            <div class="payment-method-error">
                                                <span>@_paymentMethodsError</span>
                                                <button type="button" @onclick="LoadPaymentMethodsAsync">Retry</button>
                                            </div>
                                        }
                                        else if (AvailablePaymentMethods.Count == 0)
                                        {
                                            <div class="payment-method-empty">No payment methods are available for this branch.</div>
                                        }
                                        else
                                        {
                                            <div class="payment-method-card-grid" role="group" aria-label="Payment method">
                                                @foreach (var method in VisibleBillingPaymentMethods)
                                                {
                                                    var methodName = method.POSPaymentTypeName ?? $"Payment {method.POSPaymentTypeID}";
                                                    var allocation = BillingPaymentFor(method.POSPaymentTypeID);
                                                    var isSelected = allocation is not null;
                                                    <button type="button"
                                                            class="payment-method-card @(isSelected ? "active" : string.Empty)"
                                                            aria-pressed="@isSelected"
                                                            @onclick="() => OpenBillingPaymentCalculator(method)">
                                                        <span class="payment-method-card__icon"><i class="@GetPaymentMethodIcon(methodName)"></i></span>
                                                        <span class="payment-method-card__copy">
                                                            <strong>@methodName</strong>
                                                            @if (allocation is not null)
                                                            {
                                                                <small>RM @allocation.Amount.ToString("N2")</small>
                                                            }
                                                        </span>
                                                        <span class="payment-method-card__check"><i class="bi bi-check-lg"></i></span>
                                                    </button>
                                                }
                                            </div>
                                        }

                                        @if (ActiveBillingPayments.Count > 0)
                                        {
                                            <div class="payment-split-strip">
                                                <div>
                                                    <span class="payment-split-strip__label">Payment Breakdown</span>
                                                    <div class="payment-split-badges">
                                                        @foreach (var payment in ActiveBillingPayments)
                                                        {
                                                            <span class="payment-multi-badge">
                                                                <button type="button"
                                                                        class="payment-allocation-edit"
                                                                        title="Edit payment"
                                                                        @onclick="() => EditBillingPayment(payment)">
                                                                    <span>@payment.PaymentMethod</span>
                                                                    <strong>RM @payment.Amount.ToString("N2")</strong>
                                                                </button>
                                                                <button type="button"
                                                                        class="payment-allocation-remove"
                                                                        title="Remove payment"
                                                                        @onclick="() => RemoveBillingPayment(payment)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </section>

                                    <section class="payment-panel">
                                        <div class="payment-panel-heading">
                                            <div class="payment-panel-icon"><i class="bi bi-person-check"></i></div>
                                            <div>
                                                <h4>Collected By</h4>
                                            </div>
                                        </div>
                                        <div class="payment-field-block">
                                            <label class="payment-field-label">Staff</label>
                                            <div class="custom-dropdown-wrapper form-dropdown payment-collector-dropdown">
                                                <div class="custom-dropdown-trigger @(_isCollectorDropdownOpen ? "open" : "") @(_isStaffLoading ? "disabled" : "")"
                                                     @onclick="ToggleCollectorDropdown">
                                                    <span>@(_isStaffLoading ? "Loading staff..." : string.IsNullOrWhiteSpace(SelectedCollector) ? "Select staff" : SelectedCollector)</span>
                                                    @if (_isStaffLoading)
                                                    {
                                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-chevron-down dropdown-arrow"></i>
                                                    }
                                                </div>
                                                @if (_isCollectorDropdownOpen && !_isStaffLoading)
                                                {
                                                    <div class="custom-dropdown-menu">
                                                        @if (!string.IsNullOrWhiteSpace(_staffLoadError))
                                                        {
                                                            <div class="dropdown-item payment-staff-state">
                                                                <span>@_staffLoadError</span>
                                                                <button type="button" class="payment-staff-retry" @onclick="LoadBillingStaffAsync">Retry</button>
                                                            </div>
                                                        }
                                                        else if (CollectorOptions.Count == 0)
                                                        {
                                                            <div class="dropdown-item payment-staff-state">No active staff found for this branch.</div>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var staff in CollectorOptions)
                                                            {
                                                                <button type="button"
                                                                        class="dropdown-item payment-staff-option @(SelectedCollectorId == staff.Code ? "selected" : string.Empty)"
                                                                        @onclick="() => SelectCollector(staff)">
                                                                    <span class="payment-staff-option__avatar">@GetStaffInitials(staff.Name)</span>
                                                                    <span class="payment-staff-option__copy">
                                                                        <strong>@staff.Name</strong>
                                                                        <small>@GetStaffSecondaryText(staff)</small>
                                                                    </span>
                                                                    @if (SelectedCollectorId == staff.Code)
                                                                    {
                                                                        <i class="bi bi-check-lg payment-staff-option__check"></i>
                                                                    }
                                                                </button>
                                                            }
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </section>
                                </div>

                                <aside class="payment-review-card">
                                    <div class="payment-review-card__header">
                                        <div>
                                            <span>Payment Summary</span>
                                        </div>
                                    </div>

                                    <div class="payment-review-total">
                                        <span>@(_isOutstandingPaymentMode ? "Total to Settle" : "Total Payable")</span>
                                        <strong>RM @PaymentTotalPayable.ToString("N2")</strong>
                                    </div>

                                    <div class="payment-review-breakdown">
                                        @if (_isOutstandingPaymentMode)
                                        {
                                            <div><span>Selected Documents</span><strong>@_outstandingSettlementSelections.Count</strong></div>
                                            @foreach (var document in _outstandingDocuments)
                                            {
                                                var key = BillingOutstandingDocumentSelectionKey(document);
                                                if (_outstandingSettlementSelections.TryGetValue(key, out var settlementAmount))
                                                {
                                                    <div>
                                                        <span>@(string.IsNullOrWhiteSpace(document.DocumentNumber) ? "Outstanding document" : document.DocumentNumber)</span>
                                                        <strong>RM @settlementAmount.ToString("N2")</strong>
                                                    </div>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <div><span>Subtotal before discount</span><strong>RM @GrossSubtotal.ToString("N2")</strong></div>
                                            @if (LineDiscountTotal > 0m)
                                            {
                                                <div><span>Item Discounts</span><strong>-RM @LineDiscountTotal.ToString("N2")</strong></div>
                                            }
                                            @if (BillDiscount > 0m)
                                            {
                                                <div><span>Bill Discount</span><strong>-RM @BillDiscount.ToString("N2")</strong></div>
                                            }
                                            <div><span>Subtotal before tax</span><strong>RM @SubtotalBeforeTax.ToString("N2")</strong></div>
                                            @if (TaxAmount > 0m)
                                            {
                                                <div><span>Tax</span><strong>RM @TaxAmount.ToString("N2")</strong></div>
                                            }
                                            @if (RoundingAmount != 0m)
                                            {
                                                <div><span>Rounding</span><strong>@($"{(RoundingAmount >= 0m ? "+" : "-")}RM {Math.Abs(RoundingAmount):N2}")</strong></div>
                                            }
                                            @if (HasBillingPackageRedemption)
                                            {
                                                <div><span>Package Sessions</span><strong>-RM @BillingPackageCoveredAmount.ToString("N2")</strong></div>
                                            }
                                        }
                                    </div>

                                    <div class="payment-review-divider"></div>

                                    <div class="payment-selected-method">
                                        <span class="payment-selected-method__icon"><i class="bi bi-credit-card-2-front"></i></span>
                                        <div>
                                            <small>Payment method</small>
                                            <strong>@PaymentMethodDisplay</strong>
                                        </div>
                                    </div>

                                    @if (!(HasBillingPackageRedemption && CanCompleteBillingWithoutTender))
                                    {
                                    <div class="payment-amount-entry">
                                        <label for="billing-amount-received">Amount Received</label>
                                        <div class="payment-amount-input-wrap">
                                            <span>RM</span>
                                            <input id="billing-amount-received"
                                                   class="payment-input payment-input--amount"
                                                   type="text"
                                                   inputmode="decimal"
                                                   placeholder="0.00"
                                                   value="@AmountReceivedText"
                                                   readonly
                                                   title="Amount received is calculated from the selected payment method amount(s)." />
                                        </div>
                                    </div>

                                    }
                                    <div class="payment-result-grid">
                                        <div class="payment-result-box">
                                            <span>@(_isOutstandingPaymentMode ? "Remaining" : "Outstanding")</span>
                                            <strong class="@(OutstandingAmount > 0 ? "is-due" : string.Empty)">RM @OutstandingAmount.ToString("N2")</strong>
                                        </div>
                                        <div class="payment-result-box">
                                            <span>Change</span>
                                            <strong class="@(ChangeAmount > 0 ? "is-change" : string.Empty)">RM @ChangeAmount.ToString("N2")</strong>
                                        </div>
                                    </div>

                                    <button type="button"
                                            class="payment-confirm-button"
                                            disabled="@(_isProcessingPayment || (!_isOutstandingPaymentMode && IsAppointmentPaymentLocked) || (ActiveBillingPayments.Count == 0 && !CanCompleteBillingWithoutTender) || (_isOutstandingPaymentMode ? Math.Abs(BillingPaidAmount - PaymentTotalPayable) > 0.009m : BillingPaidAmount < PaymentTotalPayable))"
                                        @onclick="OnConfirmPaymentClicked">
                                        <span>
                                            <strong>@(_isOutstandingPaymentMode ? "Continue" : CanCompleteBillingWithoutTender && HasBillingPackageRedemption ? "Complete Redemption" : $"Pay RM {PaymentTotalPayable:N2}")</strong>
                                        </span>
                                        <i class="bi bi-arrow-right-circle-fill"></i>
                                    </button>
                                </aside>
                            </div>
                        </div>
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

@if (_showPrescriptionModal)
{
    <div class="rx-overlay" @onclick="ClosePrescriptionModal">
        <section class="rx-dialog @(PrescriptionViewModel.SelectedDrugToAdd is not null ? "rx-has-selection" : string.Empty)" role="dialog" aria-modal="true" aria-labelledby="rx-title" @onclick:stopPropagation="true" @onkeydown="HandlePrescriptionKeyDown">
            <BillingWalletFormHeader Title="@(_editingPrescriptionItem is null ? "Add Prescription Item" : "Edit Prescription Item")" TitleId="rx-title" Icon="bi-capsule" OnClose="ClosePrescriptionModal" />
            <div class="rx-workspace">
                <section class="rx-catalog" aria-label="Inventory items">
                    <div class="rx-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search" aria-label="Search inventory" placeholder="Search name or code" value="@PrescriptionViewModel.SearchTerm" @oninput="HandlePrescriptionSearch" />
                    </div>
                    <select class="rx-category" aria-label="Category" value="@PrescriptionViewModel.SelectedCategory" @onchange="(ChangeEventArgs e) => SetDrugCategory(e.Value?.ToString() ?? string.Empty)">
                        <option value="">All Categories</option>
                        @foreach (var category in PrescriptionViewModel.AvailableCategories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                    <div class="rx-catalog-list" aria-busy="@_isProductCatalogLoading">
                        @if (_isProductCatalogLoading)
                        {
                            <p class="rx-state" role="status"><span class="spinner-border spinner-border-sm"></span>Loading items…</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(_productCatalogError))
                        {
                            <div class="rx-state rx-error" role="alert"><span>@_productCatalogError</span><button type="button" @onclick="LoadProductCatalogAsync">Retry</button></div>
                        }
                        else if (!PrescriptionViewModel.FilteredDrugs.Any())
                        {
                            <p class="rx-state">No items found.</p>
                        }
                        else
                        {
                            @foreach (var drug in PrescriptionViewModel.FilteredDrugs)
                            {
                                var unavailable = !drug.IsActive || (drug.StockQuantity.HasValue && drug.StockQuantity.Value <= 0);
                                <button type="button" class="rx-item @(PrescriptionViewModel.SelectedDrugToAdd?.InventoryId == drug.InventoryId ? "rx-selected" : string.Empty)" aria-pressed="@(PrescriptionViewModel.SelectedDrugToAdd?.InventoryId == drug.InventoryId)" disabled="@unavailable" @onclick="() => SelectDrug(drug)">
                                    <span class="rx-picture">
                                        @if (!string.IsNullOrWhiteSpace(ResolveCatalogImage(drug.InventoryId, drug.ImagePath, drug.ImageFileName)))
                                        {
                                            <img src="@ResolveCatalogImage(drug.InventoryId, drug.ImagePath, drug.ImageFileName)" alt="" loading="lazy" />
                                        }
                                        else { <i class="bi bi-box-seam"></i> }
                                    </span>
                                    <span class="rx-item-copy"><strong>@drug.Name</strong><small>@drug.DrugCode</small><span>@drug.Category</span></span>
                                    <span class="rx-item-amount">RM @drug.Price.ToString("N2")</span>
                                    <span class="rx-stock @(unavailable ? "rx-stock-empty" : string.Empty)">@(drug.StockQuantity.HasValue ? $"Stock {drug.StockQuantity.Value:N0}" : "Stock unavailable")</span>
                                </button>
                            }
                        }
                    </div>
                </section>
                <section class="rx-details" aria-label="Prescription details" @onclick="ClosePrescriptionOptions">
                    @if (PrescriptionViewModel.SelectedDrugToAdd is { } selectedDrug)
                    {
                        <div class="rx-selected-item">
                            <div><strong>@selectedDrug.Name</strong><span>@selectedDrug.DrugCode</span><span>RM @selectedDrug.Price.ToString("N2")</span></div>
                            <button type="button" class="rx-change" @onclick="CancelPrescriptionDrugSelection"><i class="bi bi-arrow-left-right"></i> Change</button>
                        </div>
                        <div class="rx-fields">
                            <div class="rx-field">
                                <label for="rx-dosage">Dosage</label>
                                <input id="rx-dosage" type="number" inputmode="decimal" step="0.01" min="0" @bind="PrescriptionViewModel.NewDrugQuantity" />
                            </div>
                            <div class="rx-field">
                                <div class="rx-field-heading"><label for="rx-frequency">Frequency</label>
                                    <button type="button" class="rx-entry-mode" aria-label="@(_manualFrequency ? "Choose frequency" : "Enter frequency")" aria-pressed="@_manualFrequency" @onclick="ToggleManualFrequency"><i class="bi @(_manualFrequency ? "bi-list-check" : "bi-pencil-square")"></i></button>
                                </div>
                                @if (_manualFrequency)
                                {
                                    <input id="rx-frequency" type="text" @bind="PrescriptionViewModel.NewDrugFrequency" />
                                }
                                else
                                {
<div class="rx-option-picker">
                                        <button id="rx-frequency" type="button" class="rx-option-trigger" aria-expanded="@(_openPrescriptionOption == PrescriptionOption.Frequency)" aria-controls="rx-frequency-choices" @onclick="ToggleFrequencyOptions" @onclick:stopPropagation="true">
                                            <span>@(string.IsNullOrWhiteSpace(PrescriptionViewModel.NewDrugFrequency) ? "Select frequency" : PrescriptionViewModel.NewDrugFrequency)</span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </button>
                                        @if (_openPrescriptionOption == PrescriptionOption.Frequency)
                                        {
                                            <div id="rx-frequency-choices" class="rx-option-choices" role="group" aria-label="Frequency choices" @onclick:stopPropagation="true">
                                                @foreach (var option in PrescriptionViewModel.FrequencyOptions)
                                                {
                                                    <button type="button" aria-pressed="@(PrescriptionViewModel.NewDrugFrequency == option)" @onclick="() => SelectFrequency(option)">
                                                        <span>@option</span>
                                                        @if (PrescriptionViewModel.NewDrugFrequency == option) { <i class="bi bi-check-lg" aria-hidden="true"></i> }
                                                    </button>
                                                }
                                                @if (PrescriptionViewModel.FrequencyOptions.Count == 0)
                                                {
                                                    <span class="rx-no-options">No choices available</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="rx-field">
                                <div class="rx-field-heading"><label for="rx-duration">Duration</label>
                                    <button type="button" class="rx-entry-mode" aria-label="@(_manualDuration ? "Choose duration" : "Enter duration")" aria-pressed="@_manualDuration" @onclick="ToggleManualDuration"><i class="bi @(_manualDuration ? "bi-list-check" : "bi-pencil-square")"></i></button>
                                </div>
                                @if (_manualDuration)
                                {
                                    <input id="rx-duration" type="text" @bind="PrescriptionViewModel.NewDrugDuration" />
                                }
                                else
                                {
<div class="rx-option-picker">
                                        <button id="rx-duration" type="button" class="rx-option-trigger" aria-expanded="@(_openPrescriptionOption == PrescriptionOption.Duration)" aria-controls="rx-duration-choices" @onclick="ToggleDurationOptions" @onclick:stopPropagation="true">
                                            <span>@(string.IsNullOrWhiteSpace(PrescriptionViewModel.NewDrugDuration) ? "Select duration" : PrescriptionViewModel.NewDrugDuration)</span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </button>
                                        @if (_openPrescriptionOption == PrescriptionOption.Duration)
                                        {
                                            <div id="rx-duration-choices" class="rx-option-choices" role="group" aria-label="Duration choices" @onclick:stopPropagation="true">
                                                @foreach (var option in PrescriptionViewModel.DurationOptions)
                                                {
                                                    <button type="button" aria-pressed="@(PrescriptionViewModel.NewDrugDuration == option)" @onclick="() => SelectDuration(option)">
                                                        <span>@option</span>
                                                        @if (PrescriptionViewModel.NewDrugDuration == option) { <i class="bi bi-check-lg" aria-hidden="true"></i> }
                                                    </button>
                                                }
                                                @if (PrescriptionViewModel.DurationOptions.Count == 0)
                                                {
                                                    <span class="rx-no-options">No choices available</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="rx-field">
                                <div class="rx-field-heading"><label for="rx-reason">Reason</label>
                                    <button type="button" class="rx-entry-mode" aria-label="@(_manualReason ? "Choose reason" : "Enter reason")" aria-pressed="@_manualReason" @onclick="ToggleManualReason"><i class="bi @(_manualReason ? "bi-list-check" : "bi-pencil-square")"></i></button>
                                </div>
                                @if (_manualReason)
                                {
                                    <input id="rx-reason" type="text" @bind="PrescriptionViewModel.NewDrugReason" />
                                }
                                else
                                {
<div class="rx-option-picker">
                                        <button id="rx-reason" type="button" class="rx-option-trigger" aria-expanded="@(_openPrescriptionOption == PrescriptionOption.Reason)" aria-controls="rx-reason-choices" @onclick="ToggleReasonOptions" @onclick:stopPropagation="true">
                                            <span>@(string.IsNullOrWhiteSpace(PrescriptionViewModel.NewDrugReason) ? "Select reason" : PrescriptionViewModel.NewDrugReason)</span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </button>
                                        @if (_openPrescriptionOption == PrescriptionOption.Reason)
                                        {
                                            <div id="rx-reason-choices" class="rx-option-choices" role="group" aria-label="Reason choices" @onclick:stopPropagation="true">
                                                @foreach (var option in PrescriptionViewModel.ReasonOptions)
                                                {
                                                    <button type="button" aria-pressed="@(PrescriptionViewModel.NewDrugReason == option)" @onclick="() => SelectReason(option)">
                                                        <span>@option</span>
                                                        @if (PrescriptionViewModel.NewDrugReason == option) { <i class="bi bi-check-lg" aria-hidden="true"></i> }
                                                    </button>
                                                }
                                                @if (PrescriptionViewModel.ReasonOptions.Count == 0)
                                                {
                                                    <span class="rx-no-options">No choices available</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="rx-field rx-notes">
                                <label for="rx-notes">Notes</label>
                                <textarea id="rx-notes" rows="2" @bind="PrescriptionViewModel.NewDrugNotes"></textarea>
                            </div>
                        </div>
                        @if (_showPrescriptionValidationError)
                        {
                            <p class="rx-error" role="alert">Frequency, duration and reason are required.</p>
                        }
                    }
                    else
                    {
                        <p class="rx-state">Select an item</p>
                    }
                    @if (!string.IsNullOrEmpty(_prescriptionStatusMessage))
                    {
                        <p class="@(_prescriptionStatusIsSuccess ? "rx-success" : "rx-error")" role="status">@_prescriptionStatusMessage</p>
                    }
                </section>
            </div>
            <footer class="rx-footer">
                <button type="button" @onclick="ClosePrescriptionModal">Cancel</button>
                <button type="button" class="rx-save" @onclick="AddSinglePrescriptionDrug" disabled="@(PrescriptionViewModel.SelectedDrugToAdd == null || _isProductCatalogLoading)">@(_editingPrescriptionItem is null ? "Add Item" : "Save Changes")</button>
            </footer>
        </section>
    </div>
}

@* Payment calculator - follows Sales > New Sale payment workflow *@
@if (_billingCalculatorMethod is not null)
{
    <div class="modal-overlay" @onclick="CloseBillingPaymentCalculator">
        <div class="modal-container billing-payment-calculator" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-info billing-payment-calculator__header">
                <span class="billing-payment-calculator__method-icon">
                    <i class="@GetPaymentMethodIcon(_billingCalculatorMethod.POSPaymentTypeName ?? string.Empty)"></i>
                </span>
                <div class="billing-payment-calculator__method">
                    <small>Payment Method</small>
                    <h3>@(_billingCalculatorMethod.POSPaymentTypeName ?? "Payment")</h3>
                </div>
                <button type="button"
                        class="billing-payment-calculator__close"
                        aria-label="Close payment calculator"
                        @onclick="CloseBillingPaymentCalculator">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="billing-payment-calculator__summary">
                <div><span>@(_isOutstandingPaymentMode ? "Total to Settle" : "Total Payable")</span><strong>RM @PaymentTotalPayable.ToString("N2")</strong></div>
                <div><span>Already Paid</span><strong>RM @BillingPaidExcludingCalculatorMethod.ToString("N2")</strong></div>
                <div><span>Remaining</span><strong>RM @BillingCalculatorRemaining.ToString("N2")</strong></div>
            </div>

            <div class="billing-payment-calculator__display">
                <span class="billing-payment-calculator__amount-label">Payment Amount</span>
                <div class="billing-payment-calculator__amount-value">
                    <span>RM</span>
                    <strong>@BillingCalculatorAmount.ToString("N2")</strong>
                </div>
            </div>

            <button type="button"
                    class="billing-payment-calculator__exact"
                    @onclick="UseBillingExactAmount">
                <i class="bi bi-check2-circle"></i>
                <span>Pay Remaining | RM @BillingCalculatorRemaining.ToString("N2")</span>
            </button>

            <div class="billing-payment-calculator__keypad">
                @foreach (var key in BillingKeypadKeys)
                {
                    <button type="button" @onclick="() => PressBillingCalculatorKey(key)">@key</button>
                }
                <button type="button" @onclick="ClearBillingCalculator">Clear</button>
                <button type="button" @onclick="BillingCalculatorZero">0</button>
                <button type="button" @onclick="BackspaceBillingCalculator"><i class="bi bi-backspace"></i></button>
                <button type="button" class="double-zero" @onclick="BillingCalculatorDoubleZero">00</button>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" @onclick="CloseBillingPaymentCalculator">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button type="button"
                        class="btn-modal-confirm"
                        disabled="@(BillingCalculatorAmount <= 0)"
                        @onclick="ConfirmBillingPaymentAmount">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Use RM @BillingCalculatorAmount.ToString("N2")</span>
                </button>
            </div>
        </div>
    </div>
}

