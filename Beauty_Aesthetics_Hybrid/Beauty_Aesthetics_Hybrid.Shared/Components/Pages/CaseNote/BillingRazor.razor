    private async Task PrintReceiptAndClose()
    {
        if (_isProcessingPayment)
        {
            return;
        }

        var printer = PrinterSelectionService.GetSelectedPrinter();
        if (printer is null)
        {
            Feedback.Warning(
                "No receipt printer is selected. Configure one in General Setup > Hardware Control > Printer.",
                "Printer not configured");
            return;
        }

        if (string.IsNullOrWhiteSpace(_completedSaleDocumentId))
        {
            Feedback.Error(
                "The completed sales document ID is missing.",
                "Receipt unavailable");
            return;
        }

        _isProcessingPayment = true;
        var completed = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var completedDocumentTypeId =
                AppState.LastCompletedTransaction?.DocumentTypeId == 52 ? 52 : 5;
            var saleResult = await CashSalesService.LoadTransactionAsync(
                _completedSaleDocumentId,
                completedDocumentTypeId);

            if (!saleResult.Success || saleResult.Value is null)
            {
                Feedback.Error(
                    saleResult.ErrorMessage ?? "Unable to load the completed sale for printing.",
                    "Receipt print failed");
                return;
            }

            var transaction = saleResult.Value;
            var receiptData = await BuildPhysicalReceiptDataAsync(transaction);

            var printResult = await ReceiptPrinterService.PrintAsync(
                printer,
                receiptData);

            if (!printResult.Success)
            {
                Feedback.Error(
                    string.IsNullOrWhiteSpace(printResult.Error)
                        ? "The receipt printer did not complete the print job."
                        : printResult.Error,
                    "Receipt print failed");
                return;
            }

            Feedback.Success(
                string.IsNullOrWhiteSpace(transaction.InvoiceNumber)
                    ? $"Receipt printed to {printer.Name}."
                    : $"Receipt {transaction.InvoiceNumber} printed to {printer.Name}.",
                "Receipt printed",
                2400);

            completed = true;
        }
        catch (Exception ex)
        {
            Feedback.Error(
                $"Unable to print receipt: {ex.Message}",
                "Receipt print failed");
        }
        finally
        {
            _isProcessingPayment = false;
            if (completed)
            {
                _showPaymentSummaryModal = false;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<ReceiptData> BuildPhysicalReceiptDataAsync(Transaction transaction)
    {
        // Match + New Sales and Senang: print every saved receipt line, including
        // Member Credit rows (POSPaymentTypeID = -10), while normal payment logic
        // continues to use transaction.Payments only.
        var receiptPayments = transaction.ReceiptPayments.Count > 0
            ? transaction.ReceiptPayments
            : transaction.Payments;

        var paidAmount = receiptPayments.Count > 0
            ? receiptPayments.Sum(payment => payment.Amount)
            : AmountReceived ?? transaction.Amount;
        var changeAmount = receiptPayments
            .Where(payment => payment.ChangeAmount > 0m)
            .Sum(payment => payment.ChangeAmount);
        if (changeAmount <= 0m)
        {
            changeAmount = Math.Max(0m, paidAmount - transaction.Amount);
        }

        var payments = receiptPayments.Count > 0
            ? receiptPayments
                .Where(payment => payment.Amount > 0m)
                .Select(payment => new ReceiptPaymentLine
                {
                    Method = payment.PaymentTypeId == -10 &&
                             !string.IsNullOrWhiteSpace(payment.SourceDocumentLineId)
                        ? $"Member Credit ({payment.SourceDocumentLineId})"
                        : payment.PaymentMethod,
                    Amount = payment.Amount
                })
                .ToList()
            : new List<ReceiptPaymentLine>
            {
                new()
                {
                    Method = PaymentMethodDisplay,
                    Amount = AmountReceived ?? transaction.Amount
                }
            };

        var taxSummary = transaction.Items
            .Where(item => !string.IsNullOrWhiteSpace(item.TaxCodeId))
            .GroupBy(item => new { item.TaxCodeId, item.TaxPercentage })
            .Select(group => new TaxSummaryLine
            {
                TaxCode = $"{group.Key.TaxCodeId} {group.Key.TaxPercentage * 100:0.#}%",
                Amount = group.Sum(item => CalculateBillingLineAmounts(
                    item.UnitPrice,
                    Math.Max(1, item.Quantity),
                    item.Discount,
                    item.TaxPercentage,
                    item.IsTaxInclusive).BeforeTax),
                Tax = group.Sum(item => item.TaxAmount != 0m
                    ? item.TaxAmount
                    : CalculateBillingLineAmounts(
                        item.UnitPrice,
                        Math.Max(1, item.Quantity),
                        item.Discount,
                        item.TaxPercentage,
                        item.IsTaxInclusive).Tax)
            })
            .ToList();
        var receiptTaxAmount = transaction.Tax;
        if (receiptTaxAmount == 0m)
        {
            receiptTaxAmount = taxSummary.Sum(line => line.Tax);
        }
        if (receiptTaxAmount == 0m)
        {
            receiptTaxAmount = TaxAmount;
        }

        Customer? fullCustomer = null;
        if (!string.IsNullOrWhiteSpace(transaction.AccountId))
        {
            var customerResult = await CustomerService.LoadCustomerAsync(transaction.AccountId);
            if (customerResult.Success)
            {
                fullCustomer = customerResult.Value;
            }
        }

        var branchId = string.IsNullOrWhiteSpace(transaction.BranchId)
            ? AppState.SelectedBranchID
            : transaction.BranchId;
        System.Text.Json.Nodes.JsonObject? branchRecord = null;
        if (!string.IsNullOrWhiteSpace(branchId))
        {
            var branchResult = await BranchAC.LoadRecordAsync(branchId);
            if (branchResult.Success)
            {
                branchRecord = branchResult.Value;
            }
        }

        return new ReceiptData
        {
            CompanyName = ReceiptBranding.AppTitle,
            LogoUrl = ReceiptBranding.LogoUrl,
            BranchName = AppState.CurrentBranch?.Name ?? transaction.Branch,
            OutletName = FirstNonEmpty(
                ReceiptRecordReader.Text(branchRecord, "OutletName"),
                AppState.CurrentBranch?.Name,
                transaction.Branch),
            Address1 = ReceiptRecordReader.Text(branchRecord, "Address1"),
            Address2 = ReceiptRecordReader.Text(branchRecord, "Address2"),
            Address3 = ReceiptRecordReader.Text(branchRecord, "Address3"),
            Phone = ReceiptRecordReader.Text(branchRecord, "Phone", "Contact"),
            Email = ReceiptRecordReader.Text(branchRecord, "Email"),
            CoRegistrationNo = ReceiptRecordReader.Text(
                branchRecord,
                "CoRegistrationNo",
                "CompanyRegistrationNo",
                "RegistrationNo"),
            TIN = ReceiptRecordReader.Text(branchRecord, "TIN", "TaxIdentificationNumber"),
            ReceiptNo = string.IsNullOrWhiteSpace(transaction.InvoiceNumber)
                ? _completedReceiptNumber
                : transaction.InvoiceNumber,
            DateTimeOfSale = transaction.Date,
            ReferenceNumber = transaction.ReferenceNumber,
            CustomerID = transaction.AccountId,
            CustomerName = transaction.CustomerName,
            CustomerAddress1 = fullCustomer?.Address1 ?? string.Empty,
            CustomerAddress2 = fullCustomer?.Address2 ?? string.Empty,
            CustomerAddress3 = fullCustomer?.Address3 ?? string.Empty,
            CustomerCity = fullCustomer?.City ?? string.Empty,
            CustomerPostcode = fullCustomer?.Postcode ?? string.Empty,
            CustomerState = fullCustomer?.State ?? string.Empty,
            CustomerCountry = fullCustomer?.Country ?? string.Empty,
            CustomerPhone = FirstNonEmpty(fullCustomer?.ContactNumber1, transaction.CustomerContact),
            CashierName = string.IsNullOrWhiteSpace(transaction.CreatedBy)
                ? SelectedCollector
                : transaction.CreatedBy,
            CurrencyName = FirstNonEmpty(transaction.CurrencyName, "MYR"),
            Items = transaction.Items.Select(item => new ReceiptLineItem
            {
                Name = item.Name,
                Quantity = item.Quantity,
                Discount = item.Discount,
                LineTotal = item.TotalPrice,
                Remarks = string.Equals(item.Description, item.Name, StringComparison.OrdinalIgnoreCase)
                    ? string.Empty
                    : item.Description
            }).ToList(),
            Payments = payments,
            TaxSummary = taxSummary,
            Subtotal = transaction.Subtotal,
            TaxAmount = receiptTaxAmount,
            TotalBeforeTax_ServiceCharge = transaction.ServiceChargeAmount,
            RoundingAmount = transaction.RoundingAmount,
            GrandTotal = transaction.Amount,
            PaidAmount = paidAmount,
            ChangeAmount = changeAmount,
            EInvoiceQrUrl = _eInvoiceUrl
        };
    }

    private async Task EmailReceiptAndClose()
    {
