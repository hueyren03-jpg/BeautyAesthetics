    private async Task ConfirmPaymentAsync()
    {
        if (IsAppointmentPaymentLocked)
        {
            Feedback.Info(
                "This appointment has already been paid. Another payment cannot be created.",
                "Appointment paid",
                3200);
            _showConfirmPaymentModal = false;
            return;
        }

        SynchronizeBillingPaymentTotals();

        if (AmountReceived is null || AmountReceived < TotalPayable)
        {
            Feedback.Warning(
                $"Add RM {Math.Max(0m, TotalPayable - (AmountReceived ?? 0m)):N2} more before completing the sale.",
                "Payment incomplete");
            return;
        }

        _paymentValidationError = null;
        _isProcessingPayment = true;
        var feedbackId = Feedback.Loading("Completing the sale...", "Saving sale");
        await InvokeAsync(StateHasChanged);

        try
        {
            var transaction = BuildBillingTransaction();
            var isMemberCreditRedemption =
                transaction.DocumentTypeId == 52 ||
                transaction.Items.Any(item => item.ActivityTypeId == 6);

            var result = await CashSalesService.CreateTransactionAsync(transaction);

            if (!result.Success || result.Value is null)
            {
                if (isMemberCreditRedemption &&
                    !string.IsNullOrWhiteSpace(_billingCustomerId))
                {
                    await LoadCustomerBalancesAsync(_billingCustomerId);
                }

                _paymentValidationError = result.ErrorMessage ?? "Unable to complete the sale.";
                Feedback.Fail(
                    feedbackId,
                    _paymentValidationError,
                    isMemberCreditRedemption
                        ? "Redemption not completed"
                        : "Sale not completed");
                return;
            }

            var completedTransaction = result.Value;

            // Keep Appointment Billing in the same completed-sale flow as + New Sales:
            // reload the saved backend transaction so receipt rows include system
            // payments such as Member Credit (POSPaymentTypeID = -10).
            if (!string.IsNullOrWhiteSpace(completedTransaction.DocumentId))
            {
                var completedResult = await CashSalesService.LoadTransactionAsync(
                    completedTransaction.DocumentId,
                    completedTransaction.DocumentTypeId == 52 ? 52 : 5);

                if (completedResult.Success && completedResult.Value is not null)
                {
                    if (string.IsNullOrWhiteSpace(completedResult.Value.InvoiceNumber))
                    {
                        completedResult.Value.InvoiceNumber = completedTransaction.InvoiceNumber;
                    }

                    if (string.IsNullOrWhiteSpace(completedResult.Value.CustomerName))
                    {
                        completedResult.Value.CustomerName = transaction.CustomerName;
                    }

                    completedTransaction = completedResult.Value;
                }
            }

            _completedSaleDocumentId = completedTransaction.DocumentId;
            _completedReceiptNumber = completedTransaction.InvoiceNumber;

            // The sale already exists at this point. Lock payment immediately so
            // a failed appointment-status update can never trigger a second charge
            // from the same Billing session.
            _paymentCommitted = true;
            _appointmentSaleExists = !string.IsNullOrWhiteSpace(AppointmentId);
            BillingStatusText = "Paid";

            AppState.LastSaleDocumentId = completedTransaction.DocumentId;
            AppState.LastReceiptNo = completedTransaction.InvoiceNumber;
            AppState.LastPaidAmount = AmountReceived ?? TotalPayable;
            AppState.LastPaymentMethod = PaymentMethodDisplay;
            AppState.LastCompletedTransaction = completedTransaction;
            AppState.LastPaymentReturnUrl = PatientContext.WithCustomer("/case-notes");

            _showConfirmPaymentModal = false;

            var appointmentUpdated = await MarkBillingAppointmentPaidAsync();
            if (!appointmentUpdated)
            {
                Feedback.Resolve(
                    feedbackId,
                    $"Sale {completedTransaction.InvoiceNumber} was saved, but the appointment status could not be updated automatically.",
                    "Sale saved");
                Feedback.Warning(
                    _appointmentBillingError ??
                    "The sale is saved and this bill is locked. Check the appointment status before leaving.",
                    "Appointment status not updated",
                    5000);
                return;
            }

            Feedback.Resolve(
                feedbackId,
                $"Sale {completedTransaction.InvoiceNumber} completed and the appointment was marked Paid.",
                "Sale completed");

            NavigationManager.NavigateTo("/complete-sales");
        }
        catch (Exception ex)
        {
            _paymentValidationError = $"Unable to complete the sale: {ex.Message}";
            Feedback.Fail(
                feedbackId,
                _paymentValidationError,
                "Sale not completed");
        }
        finally
        {
            _isProcessingPayment = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Transaction BuildBillingTransaction()
    {
        var branchId = string.IsNullOrWhiteSpace(AppState.SelectedBranchID)
            ? "HQ"
            : AppState.SelectedBranchID!;
        var branchGroupId = AppState.CurrentBranch?.GroupId ?? string.Empty;

        var transaction = new Transaction
        {
            AccountId = _billingCustomerId,
            BranchId = branchId,
            GroupId = branchGroupId,
            Date = DateTime.Now,
            CustomerName = PatientName,
            CustomerContact = PatientPhone == "-" ? string.Empty : PatientPhone,
            ReferenceNumber = AppointmentId?.Trim() ?? string.Empty,
            Branch = AppState.CurrentBranch?.Name ?? branchId,
            Type = MemberCreditItems.Count > 0 && PrescriptionItems.Count == 0 && ServiceItems.Count == 0
                ? "Member Credit"
                : PrescriptionItems.Count > 0 && ServiceItems.Count == 0 && MemberCreditItems.Count == 0
                    ? "Product"
                    : ServiceItems.Count > 0 && PrescriptionItems.Count == 0 && MemberCreditItems.Count == 0
                        ? "Service"
                        : "Mixed",
            ItemCount = PrescriptionItems.Sum(item => item.Quantity) +
                        ServiceItems.Sum(item => item.Quantity) +
                        MemberCreditItems.Sum(item => item.Quantity),
            Amount = TotalPayable,
            Subtotal = SubtotalBeforeTax,
            Tax = TaxAmount,
            Discount = DiscountTotal,
            RoundingAmount = RoundingAmount,
            PaymentTypeId = BillingPayments.FirstOrDefault()?.PaymentTypeId ?? 0,
            PaymentMethod = PaymentMethodDisplay,
            Status = "Paid",
            Notes = BuildBillingPaymentNotes(),
            CreatedBy = SelectedCollector,
            Items = BuildBillingTransactionItems(),
            Payments = BuildBillingTransactionPayments()
        };

        return transaction;
    }

