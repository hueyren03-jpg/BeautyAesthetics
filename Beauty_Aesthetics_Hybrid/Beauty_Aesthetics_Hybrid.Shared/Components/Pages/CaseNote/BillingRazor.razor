    private async Task ReloadPointHistoryAsync()
    {
        var customerId = _billingCustomerId?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(customerId))
        {
            return;
        }

        var branchId = AppState.SelectedBranchID?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(branchId))
        {
            branchId = BranchSession.CurrentBranch?.Id?.Trim() ?? string.Empty;
        }

        var requestVersion = ++_pointHistoryRequestVersion;
        _isPointHistoryLoading = true;
        _pointHistoryError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await PointHistoryService.LoadHistoryAsync(
                customerId,
                branchId,
                _pointHistoryFrom,
                _pointHistoryTo);

            if (requestVersion != _pointHistoryRequestVersion ||
                !string.Equals(customerId, _billingCustomerId, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            if (!result.Success || result.Value is null)
            {
                _pointHistorySnapshot = null;
                _pointHistoryError = result.ErrorMessage ?? "Unable to load point history.";
                return;
            }

            _pointHistorySnapshot = result.Value;
            CustomerPointBalance = result.Value.CurrentPointBalance;

            Console.WriteLine(
                $"[Point Step 14] UI PASS | Source=Billing | Customer={customerId} | " +
                $"Entries={result.Value.Entries.Count} | CurrentBalance={result.Value.CurrentPointBalance:0.##}");
        }
        catch (Exception ex)
        {
            if (requestVersion == _pointHistoryRequestVersion)
            {
                _pointHistorySnapshot = null;
                _pointHistoryError = $"Unable to load point history: {ex.Message}";
            }
        }
        finally
        {
            if (requestVersion == _pointHistoryRequestVersion)
            {
                _isPointHistoryLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

