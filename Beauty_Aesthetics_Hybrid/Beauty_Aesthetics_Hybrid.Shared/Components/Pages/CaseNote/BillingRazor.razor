    private void SetDiscountType(bool isPercentage)
    {
        _isPercentageDiscount = isPercentage;
        _discountError = null;
    }

    private void QuickApplyDiscount(string value, bool isPercentage)
    {
        _discountValue = value;
        _isPercentageDiscount = isPercentage;
        _discountError = null;
    }

    private void HandleDiscountEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ApplyDiscount();
        }
    }

    private void ApplyDiscount()
    {
        if (_selectedDiscountItem == null) return;
        _discountError = null;

        if (decimal.TryParse(_discountValue, out var val))
        {
            if (_selectedDiscountItem is BillingItem pItem)
            {
                var gross = pItem.UnitPrice * pItem.Quantity;
                var newDiscount = val;
                
                if (_isPercentageDiscount)
                {
                    newDiscount = gross * (val / 100m);
                }

                if (newDiscount > gross)
                {
                    _discountError = $"Discount cannot exceed item total (RM {gross:N2})";
                    Feedback.Warning(_discountError, "Discount not applied");
                    return;
                }

                // Update list
                var idx = PrescriptionItems.IndexOf(pItem);
                if (idx >= 0)
                {
                    PrescriptionItems[idx] = pItem with { Discount = newDiscount };
                }
            }
            else if (_selectedDiscountItem is BillingService sItem)
            {
                var gross = sItem.UnitPrice * sItem.Quantity;
                var newDiscount = val;

                if (_isPercentageDiscount)
                {
                    newDiscount = gross * (val / 100m);
                }

                if (newDiscount > gross)
                {
                    _discountError = $"Discount cannot exceed service total (RM {gross:N2})";
                    Feedback.Warning(_discountError, "Discount not applied");
                    return;
                }

                var idx = ServiceItems.IndexOf(sItem);
                if (idx >= 0)
                {
                    ServiceItems[idx] = sItem with { Discount = newDiscount };
                }
            }
            else if (_selectedDiscountItem == BillDiscountToken)
            {
                // Calculate gross based on Subtotal (items + services) - existing item discounts
                // Effectively we are discounting the "Subtotal after item discounts"
                // OR we can discount the raw Subtotal. 
                // Let's discount the (Subtotal - ItemDiscounts) to avoid double dipping logic, 
                // but usually "Bill Discount" is on the running total.
                
                var runningTotal = PrescriptionItems.Sum(i => i.LineTotal) + ServiceItems.Sum(s => s.LineTotal);
                // Note: LineTotal already subtracts Item Discount. 
                // So runningTotal is (Gross - ItemDiscounts).
                
                var newDiscount = val;

                if (_isPercentageDiscount)
                {
                    newDiscount = runningTotal * (val / 100m);
                }

                if (newDiscount > runningTotal)
                {
                    _discountError = $"Discount cannot exceed current total (RM {runningTotal:N2})";
                    Feedback.Warning(_discountError, "Discount not applied");
                    return;
                }

                BillDiscount = newDiscount;
            }
        }

        CloseDiscountModal();
        Feedback.Success("Discount applied successfully.", "Discount applied", 2200);
    }

    private sealed class PaymentMethodGroup
    {
        public PaymentMethodGroup(string key, string label, string icon, string? description, params PaymentSplit[] methods)
        {
            Key = key;
            Label = label;
            Icon = icon;
            Description = description;
            Methods = methods.ToList();
        }

        public string Key { get; }
        public string Label { get; }
        public string Icon { get; }
        public string? Description { get; }
        public List<PaymentSplit> Methods { get; }
        public bool IsExpanded { get; set; }

        public decimal GroupTotal => Methods
            .Where(p => p.Amount.HasValue && p.Amount.Value > 0)
            .Sum(p => p.Amount!.Value);
    }

    private sealed class PaymentSplit
    {
        public PaymentSplit(int paymentTypeId, string methodLabel, string financialAccountId)
        {
            PaymentTypeId = paymentTypeId;
            MethodLabel = methodLabel;
            FinancialAccountId = financialAccountId;
        }

        public int PaymentTypeId { get; }
        public string MethodLabel { get; }
        public string FinancialAccountId { get; }
        public string AmountText { get; set; } = string.Empty;
        public decimal? Amount { get; set; }
    }

    private record BillingItem(string Name, int Quantity, decimal UnitPrice, decimal Discount, 
        string? Frequency = null, string? Duration = null, string? Reason = null, string? Notes = null,
        string SourceId = "", string Sku = "", decimal? AvailableStock = null)
    {
        public decimal LineTotal => Math.Max(0m, UnitPrice * Quantity - Discount);
    }

    private record BillingService(
        string Name,
        string Staff,
        int Quantity,
        decimal UnitPrice,
        decimal Discount,
        string SourceId = "",
        string Sku = "",
        string Description = "",
        string Category = "",
        string Duration = "",
        string UnitOfMeasureId = "",
        string TaxCode = "",
        bool IsTaxInclusive = false)
    {
        public decimal LineTotal => Math.Max(0m, UnitPrice * Quantity - Discount);
    }

