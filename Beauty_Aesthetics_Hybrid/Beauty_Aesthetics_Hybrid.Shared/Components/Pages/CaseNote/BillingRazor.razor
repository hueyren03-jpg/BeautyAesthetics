    private async Task ReloadRedeemableCreditsAsync()
    {
        if (string.IsNullOrWhiteSpace(_billingCustomerId))
        {
            return;
        }

        _isRedeemableCreditsLoading = true;
        _redeemableCreditsError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await MemberCreditWalletService.LoadWalletAsync(
                _billingCustomerId,
                DateTime.Today,
                AppState.SelectedBranchID,
                AppState.CurrentBranch?.GroupId);

            if (!result.Success || result.Value is null)
            {
                _redeemableCredits.Clear();
                CustomerCreditBalance = null;
                _redeemableCreditsError =
                    result.ErrorMessage ??
                    "Unable to load redeemable Member Credit accounts.";
                return;
            }

            _redeemableCredits = result.Value.Accounts.ToList();
            CustomerCreditBalance = result.Value.TotalAvailable;
        }
        catch (Exception ex)
        {
            _redeemableCredits.Clear();
            CustomerCreditBalance = null;
            _redeemableCreditsError =
                $"Unable to load redeemable Member Credit accounts: {ex.Message}";
        }
        finally
        {
            _isRedeemableCreditsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadCreditRedemptionHistoryAsync(RedeemableCreditDTO credit)
    {
        var accountId = credit.ARAPOutstandingID?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(accountId))
        {
            return;
        }

        var requestVersion = ++_creditHistoryRequestVersion;
        _selectedHistoryCreditId = accountId;
        _creditRedemptionHistory.Clear();
        _creditHistoryError = null;
        _isCreditHistoryLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await MemberCreditWalletService.LoadHistoryAsync(accountId);

            if (requestVersion != _creditHistoryRequestVersion ||
                !string.Equals(
                    _selectedHistoryCreditId,
                    accountId,
                    StringComparison.OrdinalIgnoreCase))
            {
                Console.WriteLine(
                    $"[Member Credit History] STALE RESPONSE IGNORED | Requested={accountId} | Selected={_selectedHistoryCreditId}");
                return;
            }

            if (!result.Success || result.Value is null)
            {
                _creditHistoryError =
                    result.ErrorMessage ?? "Unable to load redemption history.";
                return;
            }

            _creditRedemptionHistory = result.Value.ToList();
        }
        catch (Exception ex)
        {
            if (requestVersion == _creditHistoryRequestVersion &&
                string.Equals(
                    _selectedHistoryCreditId,
                    accountId,
                    StringComparison.OrdinalIgnoreCase))
            {
                _creditHistoryError =
                    $"Unable to load redemption history: {ex.Message}";
            }
        }
        finally
        {
            if (requestVersion == _creditHistoryRequestVersion &&
                string.Equals(
                    _selectedHistoryCreditId,
                    accountId,
                    StringComparison.OrdinalIgnoreCase))
            {
                _isCreditHistoryLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

