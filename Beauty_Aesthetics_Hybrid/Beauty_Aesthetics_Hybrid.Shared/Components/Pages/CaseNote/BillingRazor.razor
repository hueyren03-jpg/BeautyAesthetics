    private void EditPrescriptionItem(BillingItem item)
    {
        if (_isDeleteMode) return; // Disable edit in delete mode

        _editingPrescriptionItem = item;
        
        var drug = PrescriptionViewModel.Drugs.FirstOrDefault(candidate =>
            (!string.IsNullOrWhiteSpace(item.SourceId) && string.Equals(candidate.InventoryId, item.SourceId, StringComparison.OrdinalIgnoreCase)) ||
            (string.IsNullOrWhiteSpace(item.SourceId) && candidate.Name.Equals(item.Name, StringComparison.OrdinalIgnoreCase)));
        if (drug != null)
        {
            PrescriptionViewModel.SelectedDrugToAdd = drug;
        }

        // Pre-fill form
        PrescriptionViewModel.NewDrugQuantity = item.Quantity;
        PrescriptionViewModel.NewDrugFrequency = item.Frequency ?? string.Empty;
        PrescriptionViewModel.NewDrugDuration = item.Duration ?? string.Empty;
        PrescriptionViewModel.NewDrugReason = item.Reason ?? string.Empty;
        PrescriptionViewModel.NewDrugNotes = item.Notes ?? string.Empty;

        // Show modal
        _showPrescriptionModal = true;
        Feedback.Info($"Editing {item.Name}.", "Edit prescription item", 2000);
    }

    private async Task AddSinglePrescriptionDrug()
    {
        var drug = PrescriptionViewModel.SelectedDrugToAdd;
        var requestedQuantity = PrescriptionViewModel.NewDrugQuantity;

        if (drug is null)
        {
            Feedback.Warning("Select an inventory item first.", "Prescription item not saved");
            return;
        }

        if (requestedQuantity < 1 || requestedQuantity != Math.Truncate(requestedQuantity))
        {
            Feedback.Warning("Quantity must be a whole number of at least 1.", "Prescription item not saved");
            return;
        }

        if (drug.StockQuantity.HasValue && requestedQuantity > drug.StockQuantity.Value)
        {
            Feedback.Warning($"Only {drug.StockQuantity.Value:N0} unit(s) are available.", "Insufficient stock");
            return;
        }

        // 1. Validate
        if (string.IsNullOrWhiteSpace(PrescriptionViewModel.NewDrugFrequency) ||
            string.IsNullOrWhiteSpace(PrescriptionViewModel.NewDrugDuration) ||
            string.IsNullOrWhiteSpace(PrescriptionViewModel.NewDrugReason))
        {
            _showPrescriptionValidationError = true;
            Feedback.Warning("Frequency, duration and reason are required.", "Prescription item not saved");
            return;
        }

        // 2. Add or Update
        if (drug != null)
        {
             var taxRate = await GstTaxRateService.GetRateForTaxCodeAsync(drug.TaxCode);
             var newItem = new BillingItem(
                  drug.Name,
                  (int)requestedQuantity,
                  drug.Price,
                  _editingPrescriptionItem?.Discount ?? 0m,
                  PrescriptionViewModel.NewDrugFrequency,
                  PrescriptionViewModel.NewDrugDuration,
                  PrescriptionViewModel.NewDrugReason,
                  PrescriptionViewModel.NewDrugNotes,
                  drug.InventoryId,
                  drug.DrugCode,
                  drug.StockQuantity,
                  drug.TaxCode,
                  drug.IsTaxInclusive,
                  taxRate,
                  _editingPrescriptionItem?.CashDiscountId ?? string.Empty,
                  _editingPrescriptionItem?.DiscountMemo ?? string.Empty
              );

             if (_editingPrescriptionItem != null)
             {
                 // Update existing item
                 var index = PrescriptionItems.IndexOf(_editingPrescriptionItem);
                 if (index != -1)
                 {
                     PrescriptionItems[index] = newItem;
                 }
             }
             else
             {
                 // Add new item
                 PrescriptionItems.Add(newItem);
             }
             
             Feedback.Success(
                 _editingPrescriptionItem != null ? $"{drug.Name} updated." : $"{drug.Name} added.",
                 _editingPrescriptionItem != null ? "Prescription item updated" : "Prescription item added",
                 2200);
             StateHasChanged();
        }

        // 3. Close Modal & Reset
        ClosePrescriptionModal();
    }

