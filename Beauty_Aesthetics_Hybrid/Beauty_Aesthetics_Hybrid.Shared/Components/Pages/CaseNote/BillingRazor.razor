    private record BillingMemberCredit(
        string Name,
        int Quantity,
        decimal UnitPrice,
        decimal Discount,
        string SourceId,
        string Sku = "",
        string TaxCode = "",
        bool IsTaxInclusive = false,
        decimal TaxRate = 0m,
        string CashDiscountId = "",
        string DiscountMemo = "")
    {
        public decimal LineTotal => Math.Max(0m, UnitPrice * Quantity - Discount);
        public decimal LineTaxAmount => CalculateBillingLineAmounts(
            UnitPrice, Quantity, Discount, TaxRate, IsTaxInclusive).Tax;
        public decimal LineTotalAfterTax
        {
            get
            {
                var amounts = CalculateBillingLineAmounts(
                    UnitPrice, Quantity, Discount, TaxRate, IsTaxInclusive);
                return Math.Max(0m, amounts.BeforeTax + amounts.Tax);
            }
        }
    }

    private sealed record BillingTaxLine(
        decimal UnitPrice,
        decimal Quantity,
        decimal Discount,
        decimal TaxRate,
        bool IsTaxInclusive,
        bool IsPackageRedemption = false);

    private sealed record BillingTotals(
        decimal SubtotalBeforeTax,
        decimal TaxAmount,
        decimal RoundingAmount,
        decimal TotalAfterTax);
}

