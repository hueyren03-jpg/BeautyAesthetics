    private decimal LineDiscountTotal =>
        PrescriptionItems.Sum(i => Math.Clamp(i.Discount, 0m, i.UnitPrice * Math.Max(1, i.Quantity))) +
        ServiceItems.Sum(s => Math.Clamp(s.Discount, 0m, s.UnitPrice * Math.Max(1, s.Quantity))) +
        MemberCreditItems.Sum(c => Math.Clamp(c.Discount, 0m, c.UnitPrice * Math.Max(1, c.Quantity)));

    private decimal DiscountTotal => LineDiscountTotal + BillDiscount;

    private decimal GrossSubtotal =>
        PrescriptionItems.Sum(i => i.UnitPrice * Math.Max(1, i.Quantity)) +
        ServiceItems.Sum(s => s.UnitPrice * Math.Max(1, s.Quantity)) +
        MemberCreditItems.Sum(c => c.UnitPrice * Math.Max(1, c.Quantity));

