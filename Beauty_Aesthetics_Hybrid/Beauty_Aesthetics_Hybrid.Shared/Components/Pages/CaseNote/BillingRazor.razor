    private async Task LoadBillingPatientAsync(bool force)
    {
        // Appointment billing must always use the appointment's customer. A
        // customer left in the shared context or query string may belong to a
        // previously opened sale and would display that customer's balances.
        var requestedKey = !string.IsNullOrWhiteSpace(_billingAppointment?.CustomerId)
            ? _billingAppointment.CustomerId.Trim()
            : !string.IsNullOrWhiteSpace(CustomerId)
                ? CustomerId.Trim()
                : PatientContext.CustomerId?.Trim();

        if (!force &&
            !string.IsNullOrWhiteSpace(requestedKey) &&
            string.Equals(_loadedBillingCustomerKey, requestedKey, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var result = await PatientContext.LoadAsync(requestedKey);
        if (result.Success && result.Value is not null)
        {
            if (!string.Equals(_billingCustomerId, result.Value.SystemID, StringComparison.OrdinalIgnoreCase)) ClearBillingPackages();
            PatientName = Beauty_Aesthetics_WebPos.Components.Services.Clinical.ClinicalPatientContext.GetDisplayName(result.Value);
            PatientBirthday = result.Value.DateOfBirth?.ToString("dd/MM/yyyy") ?? "-";
            PatientPhone = string.IsNullOrWhiteSpace(result.Value.ContactNumber1) ? "-" : result.Value.ContactNumber1;
            _billingCustomerId = result.Value.SystemID ?? string.Empty;
            _loadedBillingCustomerKey = _billingCustomerId;

            BillingPayments.Clear();
            SynchronizeBillingPaymentTotals();

            await Task.WhenAll(
                LoadCustomerBalancesAsync(_billingCustomerId),
                LoadPaymentMethodsAsync());
        }
        else
        {
            ClearBillingPackages();
            _billingCustomerId = string.Empty;
            _loadedBillingCustomerKey = requestedKey;
            await LoadCustomerBalancesAsync(null);
            Feedback.Error(result.ErrorMessage ?? "Unable to load the appointment patient.", "Patient not loaded");
        }
    }

    private async Task LoadBillingStaffAsync()
    {
        _isStaffLoading = true;
        _staffLoadError = null;

        try
        {
            var branchId = string.IsNullOrWhiteSpace(AppState.SelectedBranchID)
                ? "HQ"
                : AppState.SelectedBranchID!;

            var result = await EmployeeService.GetActiveEmployeesByBranchAsync(branchId);
            if (!result.Success || result.Value is null)
            {
                CollectorOptions = new List<Employee>();
                SelectedCollectorId = string.Empty;
                SelectedCollector = string.Empty;
                _staffLoadError = result.ErrorMessage ?? "Unable to load active staff.";
                Feedback.Error(_staffLoadError, "Staff not loaded");
                return;
            }

            CollectorOptions = result.Value
                .Where(employee =>
                    string.Equals(employee.Status, "Active", StringComparison.OrdinalIgnoreCase) &&
                    !string.IsNullOrWhiteSpace(employee.Code) &&
                    !string.IsNullOrWhiteSpace(employee.Name))
                .OrderBy(employee => employee.Name)
                .ToList();

            var selectedStillAvailable = CollectorOptions.FirstOrDefault(employee =>
                string.Equals(employee.Code, SelectedCollectorId, StringComparison.OrdinalIgnoreCase));

            var defaultStaff = selectedStillAvailable
                ?? CollectorOptions.FirstOrDefault(employee => employee.IsCashier)
                ?? CollectorOptions.FirstOrDefault(employee => employee.IsServiceStaff)
                ?? CollectorOptions.FirstOrDefault();

            if (defaultStaff is not null)
            {
                SelectCollector(defaultStaff, closeDropdown: false);
            }
            else
            {
                SelectedCollectorId = string.Empty;
                SelectedCollector = string.Empty;
            }
        }
        catch (Exception ex)
        {
            CollectorOptions = new List<Employee>();
            SelectedCollectorId = string.Empty;
            SelectedCollector = string.Empty;
            _staffLoadError = $"Unable to load active staff: {ex.Message}";
            Feedback.Error(_staffLoadError, "Staff not loaded");
        }
        finally
        {
            _isStaffLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPaymentMethodsAsync()
    {
        _isPaymentMethodsLoading = true;
        _paymentMethodsError = null;

        try
        {
            var branchId = string.IsNullOrWhiteSpace(BranchSession.CurrentBranch?.Id)
                ? "HQ"
                : BranchSession.CurrentBranch.Id;
            var groupId = string.IsNullOrWhiteSpace(BranchSession.CurrentBranch?.GroupId)
                ? branchId
                : BranchSession.CurrentBranch.GroupId;

            var result = await CashSalesService.LoadPaymentTypesAsync(
                branchId,
                groupId,
                _billingCustomerId);

            if (!result.Success || result.Value is null)
            {
                AvailablePaymentMethods = new List<CashSalesPaymentTypeDTO>();
                SelectedPaymentTypeId = 0;
                SelectedPaymentMethod = string.Empty;
                _paymentMethodsError = result.ErrorMessage ?? "Unable to load payment methods.";
                Feedback.Error(_paymentMethodsError, "Payment methods not loaded");
                return;
            }

            AvailablePaymentMethods = result.Value
                .Where(method => method.POSPaymentTypeID is not (0 or -5) &&
                                 !string.IsNullOrWhiteSpace(method.POSPaymentTypeName))
                .ToList();

            var validPaymentIds = AvailablePaymentMethods
                .Select(method => method.POSPaymentTypeID)
                .ToHashSet();

            BillingPayments = BillingPayments
                .Where(payment => validPaymentIds.Contains(payment.PaymentTypeId))
                .ToList();

            _outstandingSettlementPayments.RemoveAll(payment =>
                !validPaymentIds.Contains(payment.PaymentTypeId) ||
                payment.PaymentTypeId == -10);

            SynchronizeBillingPaymentTotals();
        }
        catch (Exception ex)
        {
            AvailablePaymentMethods = new List<CashSalesPaymentTypeDTO>();
            SelectedPaymentTypeId = 0;
            SelectedPaymentMethod = string.Empty;
            _paymentMethodsError = $"Unable to load payment methods: {ex.Message}";
            Feedback.Error(_paymentMethodsError, "Payment methods not loaded");
        }
        finally
        {
            _isPaymentMethodsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string GetPaymentGroupKey(CashSalesPaymentTypeDTO method)
    {
        if (!string.IsNullOrWhiteSpace(method.Grouping))
            return method.Grouping.Trim().ToLowerInvariant();

        var name = method.POSPaymentTypeName ?? string.Empty;
        if (name.Contains("cash", StringComparison.OrdinalIgnoreCase)) return "cash";
        if (name.Contains("card", StringComparison.OrdinalIgnoreCase)) return "card";
        if (name.Contains("bank", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("fpx", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("transfer", StringComparison.OrdinalIgnoreCase)) return "bank";
        if (name.Contains("wallet", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("pay", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("tng", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("touch", StringComparison.OrdinalIgnoreCase)) return "ewallet";
        return "other";
    }

    private static string GetPaymentGroupDescription(string key) => key switch
    {
        "cash" => "Counter collection",
        "card" => "Debit and credit card methods",
        "ewallet" => "Electronic wallet methods",
        "bank" => "FPX and bank transfer methods",
        _ => "Other configured payment methods"
    };

    private static string GetPaymentMethodIcon(string name)
    {
        if (name.Contains("cash", StringComparison.OrdinalIgnoreCase)) return "bi bi-cash-stack";
        if (name.Contains("card", StringComparison.OrdinalIgnoreCase)) return "bi bi-credit-card-2-front";
        if (name.Contains("bank", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("fpx", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("transfer", StringComparison.OrdinalIgnoreCase)) return "bi bi-bank";
        if (name.Contains("wallet", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("pay", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("tng", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("touch", StringComparison.OrdinalIgnoreCase)) return "bi bi-phone";
        return "bi bi-wallet2";
    }

    private static string GetPaymentMethodDescription(CashSalesPaymentTypeDTO method)
    {
        if (!string.IsNullOrWhiteSpace(method.Grouping))
            return method.Grouping;

        return GetPaymentGroupDescription(GetPaymentGroupKey(method));
    }

