@page "/billing"
@using Beauty_Aesthetics_WebPos.Components.Layout
@layout EmptyLayout
@using Microsoft.AspNetCore.Components
@using Beauty_Aesthetics_WebPos.Components.ViewModels
@using Beauty_Aesthetics_WebPos.Components.Models.Employee
@using Beauty_Aesthetics_WebPos.Components.Models
@using Beauty_Aesthetics_WebPos.Components.Services.Printing
@using Beauty_Aesthetics_WebPos.Models.DTOs
@using System.Linq
@using System.Text.RegularExpressions
@inject NavigationManager NavigationManager
@inject AppFeedbackService Feedback
@inject Beauty_Aesthetics_WebPos.Components.Services.Clinical.ClinicalPatientContext PatientContext
@inject Beauty_Aesthetics_WebPos.Components.Services.Customers.ICustomerService CustomerService
@inject Beauty_Aesthetics_WebPos.Components.Services.Inventory.IProductInventoryService ProductInventoryService
@inject Beauty_Aesthetics_WebPos.Components.Services.Inventory.IServiceItemService ServiceItemService
@inject Beauty_Aesthetics_WebPos.Components.Services.Employees.IEmployeeService EmployeeService
@inject Beauty_Aesthetics_WebPos.Components.Services.Sales.ICashSalesService CashSalesService
@inject Beauty_Aesthetics_WebPos.Components.Services.Files.IFileDownloadService FileDownloadService
@inject Beauty_Aesthetics_WebPos.Components.Services.Printing.IPrinterSelectionService PrinterSelectionService
@inject Beauty_Aesthetics_WebPos.Components.Services.Printing.IReceiptPrinterService ReceiptPrinterService
@inject Beauty_Aesthetics_WebPos.Components.Services.Inventory.ProductImageService ProductImageService
@inject Beauty_Aesthetics_WebPos.Components.Services.AppState AppState
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Billing - Beauty Aesthetics</PageTitle>

<div class="billing-page">
<button class="billing-close-btn" @onclick="CloseBilling" aria-label="Close billing and return to case notes">
        <i class="bi bi-x-lg"></i>
    </button>
    <button type="button"
            class="billing-patient-drawer-btn"
            @onclick="TogglePatientDrawer"
            title="View Patient Information"
            aria-label="View Patient Information"
            aria-expanded="@_isPatientDrawerOpen">
        <i class="bi bi-person-vcard"></i>
    </button>
    <div class="main-layout">
        <!-- Main Content Area -->
        <main class="content-area">
            <!-- Patient Info Card - same structure as CaseNotePage -->
                        @if (_isPatientDrawerOpen)
            {
                <button type="button"
                        class="patient-drawer-backdrop"
                        @onclick="ClosePatientDrawer"
                        aria-label="Close Patient Information"></button>
            }

            <div class="info-card patient-drawer @( _isPatientInfoCollapsed ? "collapsed" : string.Empty ) @(_isPatientDrawerOpen ? "open" : string.Empty)">
                <div class="info-card-header" @onclick="TogglePatientInfo">
                    <div class="info-card-title">
                        <i class="bi bi-person-badge"></i>
                        <span>Patient Information</span>
                    </div>
                    <button class="btn-toggle-info" title="@(_isPatientInfoCollapsed ? "Expand" : "Collapse")">
                        <i class="bi @(_isPatientInfoCollapsed ? "bi-chevron-down" : "bi-chevron-up")"></i>
                    </button>
                    <button type="button"
                            class="patient-drawer-close"
                            @onclick="ClosePatientDrawer"
                            @onclick:stopPropagation="true"
                            title="Close Patient Information"
                            aria-label="Close Patient Information">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="info-card-content">
                    <div class="info-grid">
                        <div class="info-item">
                            <i class="bi bi-person"></i>
                            <div class="info-content">
                                <span class="info-label">Name</span>
                                <span class="info-value">@PatientName</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="bi bi-calendar-heart"></i>
                            <div class="info-content">
                                <span class="info-label">Birthday</span>
                                <span class="info-value">@PatientBirthday</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="bi bi-telephone"></i>
                            <div class="info-content">
                                <span class="info-label">Phone</span>
                                <span class="info-value">@PatientPhone</span>
                            </div>
                        </div>
                    </div>

                    <!-- Wallet / Points Row inside patient info, collapsible -->
                    <div class="wallet-strip" style="margin-top: 10px;">
                        <div class="wallet-card cash-wallet">
                            <div class="wallet-card-header">
                                <i class="bi bi-cash-coin"></i>
                                <span>Cash Wallet</span>
                            </div>
                            <div class="wallet-amount">@FormatMoneyBalance(CashWalletAmount)</div>
                            <div class="wallet-footer">@BalanceFooter(CashWalletAmount, "Available balance")</div>
                        </div>

                        <div class="wallet-card credit-voucher">
                            <div class="wallet-card-header">
                                <i class="bi bi-ticket-perforated"></i>
                                <span>Credit Voucher</span>
                            </div>
                            <div class="wallet-amount">@FormatMoneyBalance(CreditVoucherAmount)</div>
                            <div class="wallet-footer">@BalanceFooter(CreditVoucherAmount, "Voucher balance")</div>
                        </div>

                        <div class="wallet-card beauti-points">
                            <div class="wallet-card-header">
                                <div class="wallet-header-main">
                                    <i class="bi bi-stars"></i>
                                    <span>Beauty Points</span>
                                </div>
                                <span class="wallet-info-icon" data-tooltip="RM 1.00 = 1 point">
                                    <i class="bi bi-info-circle"></i>
                                </span>
                            </div>
                            <div class="wallet-amount">@FormatPointBalance(BeautiPoints)</div>
                            <div class="wallet-footer">@FormatPointValue()</div>
                        </div>
                        <div class="wallet-card loyalty-points">
                            <div class="wallet-card-header">
                                <i class="bi bi-gift"></i>
                                <span>Loyalty Points</span>
                            </div>
                            <div class="wallet-amount">@FormatPointBalance(LoyaltyPoints)</div>
                            <div class="wallet-footer">@(LoyaltyTier ?? "Unavailable")</div>
                        </div>

                        <div class="wallet-card outstanding-balance">
                            <div class="wallet-card-header">
                                <i class="bi bi-currency-exchange"></i>
                                <span>Outstanding Balance</span>
                            </div>
                            <div class="wallet-amount">@FormatMoneyBalance(PreviousOutstandingAmount)</div>
                            <div class="wallet-footer">@(PreviousOutstandingAmount.HasValue ? "Previous balance owed" : "Unavailable")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Billing Card -->
            <div class="billing-card">
                <!-- Billing Header -->
                <div class="billing-header">
                    <div class="billing-header-left">
                        <div class="billing-title-row">
                            <i class="bi bi-wallet2"></i>
                            <h2>@(_billingStep == "payment" ? "Payment" : "Billing")</h2>
                        </div>
                    </div>
                    <div class="billing-header-right">
                        <div class="billing-status @BillingStatusCss">
                            <span class="status-dot"></span>
                            <span>@BillingStatusText</span>
                        </div>
                    </div>
                </div>

                <!-- Billing Content -->
                <div class="billing-content @(_billingStep == "payment" ? "billing-content--payment-step" : "billing-content--summary-step")">
                    @if (_billingStep == "summary")
                    {
                    <!-- Left: Items -->
                    <div class="billing-left">
                        <div class="billing-section">
                            <div class="section-header">
                                <h3>Prescription Items</h3>
                                <div class="header-actions" style="display: flex; gap: 8px;">
                                    @if (_isDeleteMode)
                                    {
                                        <button class="btn-delete-confirm" @onclick="DeleteSelectedItems" disabled="@(!_selectedItemsToDelete.Any())">
                                            Confirm Delete (@_selectedItemsToDelete.Count)
                                        </button>
                                        <button class="btn-delete-cancel" @onclick="ToggleDeleteMode">
                                            Cancel
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-delete-mode" @onclick="ToggleDeleteMode" title="Delete Items">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <button type="button"
                                                class="btn-add-prescription"
                                                @onclick="OpenPrescriptionModal">
                                            <i class="bi bi-plus-lg"></i>
                                            <span>Add Item</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="table-wrapper">
                                <table class="billing-table">
                                    <thead>
                                        <tr>
                                            @if (_isDeleteMode)
                                            {
                                                <th class="col-checkbox" style="width: 40px;"></th>
                                            }
                                            <th>Item</th>
                                            <th>Qty</th>
                                            <th>Unit Price</th>
                                            <th>Discount</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (PrescriptionItems.Count == 0)
                                        {
                                            <tr class="empty-row"><td colspan="@(_isDeleteMode ? 6 : 5)">No prescription items added.</td></tr>
                                        }
                                        @foreach (var item in PrescriptionItems)
                                        {
                                            <tr @onclick="@(() => { if (_isDeleteMode) ToggleItemSelection(item); })"
                                                class="@(_isDeleteMode ? "row-clickable" : "")">
                                                @if (_isDeleteMode)
                                                {
                                                    <td>
                                                        <input type="checkbox" 
                                                               class="delete-checkbox"
                                                               checked="@_selectedItemsToDelete.Contains(item)" 
                                                               @onchange="() => ToggleItemSelection(item)"
                                                               @onclick:stopPropagation="true" />
                                                    </td>
                                                }
                                                <td>
                                                    <span class="clickable-item-name" @onclick="() => EditPrescriptionItem(item)" style="cursor: pointer;">
                                                        @item.Name
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(item.Sku))
                                                    {
                                                        <small class="billing-line-code">@item.Sku</small>
                                                    }
                                                </td>
                                                <td>@item.Quantity</td>
                                                <td>RM @item.UnitPrice.ToString("N2")</td>
                                                <td>
                                                    <button class="btn-discount-cell" @onclick="() => OpenDiscountModal(item)">
                                                        @if (item.Discount > 0)
                                                        {
                                                            <span class="discount-active">-RM @item.Discount.ToString("N2")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="discount-empty">Add Discount</span>
                                                        }
                                                    </button>
                                                </td>
                                                <td>RM @item.LineTotal.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="billing-section">
                            <div class="section-header">
                                <h3>Services</h3>
                                <div class="header-actions" style="display: flex; gap: 8px;">
                                    @if (_isServiceDeleteMode)
                                    {
                                        <button class="btn-delete-confirm" @onclick="DeleteSelectedServiceItems" disabled="@(!_selectedServiceItemsToDelete.Any())">
                                            Confirm Delete (@_selectedServiceItemsToDelete.Count)
                                        </button>
                                        <button class="btn-delete-cancel" @onclick="ToggleServiceDeleteMode">
                                            Cancel
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-delete-mode" @onclick="ToggleServiceDeleteMode" title="Delete Items">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <button type="button"
                                                class="btn-add-prescription btn-add-service"
                                                @onclick="OpenServicePickerModal">
                                            <i class="bi bi-plus-lg"></i>
                                            <span>Service</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="table-wrapper">
                                <table class="billing-table">
                                    <thead>
                                        <tr>
                                            @if (_isServiceDeleteMode)
                                            {
                                                <th style="width: 40px;"></th>
                                            }
                                            <th>Service</th>
                                            <th>Staff</th>
                                            <th>Qty</th>
                                            <th>Unit Price</th>
                                            <th>Discount</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (ServiceItems.Count == 0)
                                        {
                                            <tr class="empty-row"><td colspan="@(_isServiceDeleteMode ? 7 : 6)">No services added.</td></tr>
                                        }
                                        @foreach (var service in ServiceItems)
                                        {
                                            <tr @onclick="@(() => { if (_isServiceDeleteMode) ToggleServiceItemSelection(service); })"
                                                class="@(_isServiceDeleteMode ? "row-clickable" : "")">
                                                @if (_isServiceDeleteMode)
                                                {
                                                    <td>
                                                        <input type="checkbox" 
                                                               class="delete-checkbox"
                                                               checked="@_selectedServiceItemsToDelete.Contains(service)"
                                                               @onchange="@(() => ToggleServiceItemSelection(service))"
                                                               @onclick:stopPropagation="true" />
                                                    </td>
                                                }
                                                <td>
                                                    <span>@service.Name</span>
                                                    @if (!string.IsNullOrWhiteSpace(service.Sku))
                                                    {
                                                        <small class="billing-line-code">@service.Sku</small>
                                                    }
                                                </td>
                                                <td>@service.Staff</td>
                                                <td>@service.Quantity</td>
                                                <td>RM @service.UnitPrice.ToString("N2")</td>
                                                <td>
                                                    <button class="btn-discount-cell" @onclick="() => OpenDiscountModal(service)">
                                                        @if (service.Discount > 0)
                                                        {
                                                            <span class="discount-active">-RM @service.Discount.ToString("N2")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="discount-empty">Add Discount</span>
                                                        }
                                                    </button>
                                                </td>
                                                <td>RM @service.LineTotal.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="billing-section mc-section">
                            <div class="section-header">
                                <h3>MC / Medical Certificate</h3>
                            </div>
                            <div class="mc-body">
                                <p class="mc-description">Prepare and share the medical certificate based on the services above.</p>
                                <div class="mc-actions">
                                    <button class="btn-mc-action btn-mc-print" type="button">
                                        <i class="bi bi-printer"></i>
                                        <span>Print MC</span>
                                    </button>
                                    <button class="btn-mc-action btn-mc-email" type="button">
                                        <i class="bi bi-envelope"></i>
                                        <span>Email MC</span>
                                    </button>
                                    <button class="btn-mc-action btn-mc-whatsapp" type="button">
                                        <i class="bi bi-whatsapp"></i>
                                        <span>WhatsApp MC</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    }

                    <!-- Right: Summary / Payment -->
                    <div class="billing-right @(_billingStep == "payment" ? "billing-right--payment-step" : string.Empty)">
                        @if (_billingStep == "summary")
                        {
                        <div class="billing-section">
                            <div class="section-header">
                                <h3>Summary</h3>
                            </div>
                            <div class="summary-list">
                                <div class="summary-row">
                                    <span>Subtotal</span>
                                    <span>RM @Subtotal.ToString("N2")</span>
                                </div>
                                <div class="summary-row">
                                    <span>Discounts / Vouchers</span>
                                    <span>-RM @DiscountTotal.ToString("N2")</span>
                                </div>
                                <div class="summary-row">
                                    <span>Tax</span>
                                    <span>RM @TaxAmount.ToString("N2")</span>
                                </div>
                                <div class="summary-row">
                                    <span>Bill Discount</span>
                                    <button class="btn-summary-discount" @onclick="() => OpenDiscountModal(BillDiscountToken)">
                                        @if (BillDiscount > 0)
                                        {
                                            <span class="discount-value discount-active">
                                                <i class="bi bi-tag-fill"></i> -RM @BillDiscount.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="discount-placeholder">
                                                <i class="bi bi-plus-circle-dotted"></i> Add Discount
                                            </span>
                                        }
                                    </button>
                                </div>
                                <div class="summary-divider"></div>
                                <div class="summary-row total-row">
                                    <span>Total Payable</span>
                                    <span>RM @TotalPayable.ToString("N2")</span>
                                </div>
                            </div>
                        </div>


                        <div class="billing-next-step">
                            <button type="button" class="btn-proceed-payment" @onclick="GoToPayment">
                                <span>Proceed to Payment</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                        }

                        @if (_billingStep == "payment")
                        {
                        <div class="billing-payment-page">
                            <div class="payment-step-header">
                                <button type="button" class="btn-back-to-billing" @onclick="BackToBilling">
                                    <i class="bi bi-arrow-left"></i>
                                    <span>Back to Billing</span>
                                </button>
                                <div class="payment-step-heading">
                                    <span class="payment-step-kicker">Step 2 of 2</span>
                                    <h3>Complete Payment</h3>
                                    <p>Select how the customer is paying, apply available balances if needed, then confirm the amount received.</p>
                                </div>
                            </div>

                            <div class="payment-checkout-grid">
                                <div class="payment-checkout-main">
                                    <section class="payment-panel">
                                        <div class="payment-panel-heading">
                                            <div class="payment-panel-icon"><i class="bi bi-credit-card-2-front"></i></div>
                                            <div>
                                                <h4>Payment Method</h4>
                                                <p>Choose the primary payment method.</p>
                                            </div>
                                        </div>

                                        @if (_isPaymentMethodsLoading)
                                        {
                                            <div class="payment-method-loading">
                                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                <span>Loading payment methods...</span>
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(_paymentMethodsError))
                                        {
                                            <div class="payment-method-error">
                                                <span>@_paymentMethodsError</span>
                                                <button type="button" @onclick="LoadPaymentMethodsAsync">Retry</button>
                                            </div>
                                        }
                                        else if (AvailablePaymentMethods.Count == 0)
                                        {
                                            <div class="payment-method-empty">No payment methods are available for this branch.</div>
                                        }
                                        else
                                        {
                                            <div class="payment-method-card-grid" role="group" aria-label="Payment method">
                                                @foreach (var method in AvailablePaymentMethods)
                                                {
                                                    var methodName = method.POSPaymentTypeName ?? $"Payment {method.POSPaymentTypeID}";
                                                    var allocation = BillingPaymentFor(method.POSPaymentTypeID);
                                                    var isSelected = allocation?.Amount is > 0;
                                                    <button type="button"
                                                            class="payment-method-card @(isSelected ? "active" : string.Empty)"
                                                            aria-pressed="@isSelected"
                                                            @onclick="() => OpenBillingPaymentCalculator(method)">
                                                        <span class="payment-method-card__icon"><i class="@GetPaymentMethodIcon(methodName)"></i></span>
                                                        <span class="payment-method-card__copy">
                                                            <strong>@methodName</strong>
                                                            <small>@GetPaymentMethodDescription(method)</small>
                                                        </span>
                                                        <span class="payment-method-card__check"><i class="bi bi-check-lg"></i></span>
                                                    </button>
                                                }
                                            </div>
                                        }

                                        <div class="payment-split-strip">
                                            <div>
                                                <span class="payment-split-strip__label">Need more than one method?</span>
                                                @if (SelectedPaymentSplits.Any())
                                                {
                                                    <div class="payment-split-badges">
                                                        @foreach (var split in SelectedPaymentSplits)
                                                        {
                                                            <span class="payment-multi-badge">
                                                                <span>@split.MethodLabel</span>
                                                                <strong>RM @split.Amount!.Value.ToString("N2")</strong>
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="payment-split-strip__hint">Split the amount across cash, card, e-wallet or bank transfer.</span>
                                                }
                                            </div>
                                            <button type="button" class="btn-multi-payment" @onclick="OpenMultiPaymentModal">
                                                <i class="bi bi-distribute-horizontal"></i>
                                                <span>Configure split</span>
                                            </button>
                                        </div>
                                    </section>

                                    <section class="payment-panel">
                                        <div class="payment-panel-heading">
                                            <div class="payment-panel-icon"><i class="bi bi-person-check"></i></div>
                                            <div>
                                                <h4>Collected By</h4>
                                                <p>Assign the staff member receiving this payment.</p>
                                            </div>
                                        </div>
                                        <div class="payment-field-block">
                                            <label class="payment-field-label">Staff</label>
                                            <div class="custom-dropdown-wrapper form-dropdown payment-collector-dropdown">
                                                <div class="custom-dropdown-trigger @(_isCollectorDropdownOpen ? "open" : "") @(_isStaffLoading ? "disabled" : "")"
                                                     @onclick="ToggleCollectorDropdown">
                                                    <span>@(_isStaffLoading ? "Loading staff..." : string.IsNullOrWhiteSpace(SelectedCollector) ? "Select staff" : SelectedCollector)</span>
                                                    @if (_isStaffLoading)
                                                    {
                                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-chevron-down dropdown-arrow"></i>
                                                    }
                                                </div>
                                                @if (_isCollectorDropdownOpen && !_isStaffLoading)
                                                {
                                                    <div class="custom-dropdown-menu">
                                                        @if (!string.IsNullOrWhiteSpace(_staffLoadError))
                                                        {
                                                            <div class="dropdown-item payment-staff-state">
                                                                <span>@_staffLoadError</span>
                                                                <button type="button" class="payment-staff-retry" @onclick="LoadBillingStaffAsync">Retry</button>
                                                            </div>
                                                        }
                                                        else if (CollectorOptions.Count == 0)
                                                        {
                                                            <div class="dropdown-item payment-staff-state">No active staff found for this branch.</div>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var staff in CollectorOptions)
                                                            {
                                                                <button type="button"
                                                                        class="dropdown-item payment-staff-option @(SelectedCollectorId == staff.Code ? "selected" : string.Empty)"
                                                                        @onclick="() => SelectCollector(staff)">
                                                                    <span class="payment-staff-option__avatar">@GetStaffInitials(staff.Name)</span>
                                                                    <span class="payment-staff-option__copy">
                                                                        <strong>@staff.Name</strong>
                                                                        <small>@GetStaffSecondaryText(staff)</small>
                                                                    </span>
                                                                    @if (SelectedCollectorId == staff.Code)
                                                                    {
                                                                        <i class="bi bi-check-lg payment-staff-option__check"></i>
                                                                    }
                                                                </button>
                                                            }
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(SelectedCollectorId))
                                            {
                                                <small class="payment-field-help">Employee ID: @SelectedCollectorId</small>
                                            }
                                        </div>
                                    </section>

                                    <section class="payment-panel">
                                        <div class="payment-panel-heading payment-panel-heading--spread">
                                            <div class="payment-panel-heading__main">
                                                <div class="payment-panel-icon"><i class="bi bi-wallet2"></i></div>
                                                <div>
                                                    <h4>Wallet & Points</h4>
                                                    <p>Optional balances available for this customer.</p>
                                                </div>
                                            </div>
                                            <span class="payment-optional-badge">Optional</span>
                                        </div>

                                        <div class="payment-balance-grid">
                                            <label class="payment-balance-card @(UseCashWallet ? "active" : string.Empty) @((!CashWalletAmount.HasValue || CashWalletAmount.Value <= 0) ? "disabled" : string.Empty)">
                                                <input type="checkbox" @bind="UseCashWallet" disabled="@(!CashWalletAmount.HasValue || CashWalletAmount.Value <= 0)" />
                                                <span class="payment-balance-card__icon"><i class="bi bi-cash-coin"></i></span>
                                                <span class="payment-balance-card__copy">
                                                    <strong>Cash Wallet</strong>
                                                    <small>@FormatMoneyBalance(CashWalletAmount)</small>
                                                </span>
                                                <span class="payment-balance-card__check"><i class="bi bi-check"></i></span>
                                            </label>
                                            <label class="payment-balance-card @(UseCreditVoucher ? "active" : string.Empty) @((!CreditVoucherAmount.HasValue || CreditVoucherAmount.Value <= 0) ? "disabled" : string.Empty)">
                                                <input type="checkbox" @bind="UseCreditVoucher" disabled="@(!CreditVoucherAmount.HasValue || CreditVoucherAmount.Value <= 0)" />
                                                <span class="payment-balance-card__icon"><i class="bi bi-ticket-perforated"></i></span>
                                                <span class="payment-balance-card__copy">
                                                    <strong>Credit Voucher</strong>
                                                    <small>@FormatMoneyBalance(CreditVoucherAmount)</small>
                                                </span>
                                                <span class="payment-balance-card__check"><i class="bi bi-check"></i></span>
                                            </label>
                                            <label class="payment-balance-card @(UseBeautiPoints ? "active" : string.Empty) @((!BeautiPoints.HasValue || BeautiPoints.Value <= 0) ? "disabled" : string.Empty)">
                                                <input type="checkbox" @bind="UseBeautiPoints" disabled="@(!BeautiPoints.HasValue || BeautiPoints.Value <= 0)" />
                                                <span class="payment-balance-card__icon"><i class="bi bi-stars"></i></span>
                                                <span class="payment-balance-card__copy">
                                                    <strong>Beauty Points</strong>
                                                    <small>@FormatPointBalance(BeautiPoints)</small>
                                                </span>
                                                <span class="payment-balance-card__check"><i class="bi bi-check"></i></span>
                                            </label>
                                            <label class="payment-balance-card @(UseLoyaltyPoints ? "active" : string.Empty) @((!LoyaltyPoints.HasValue || LoyaltyPoints.Value <= 0) ? "disabled" : string.Empty)">
                                                <input type="checkbox" @bind="UseLoyaltyPoints" disabled="@(!LoyaltyPoints.HasValue || LoyaltyPoints.Value <= 0)" />
                                                <span class="payment-balance-card__icon"><i class="bi bi-gift"></i></span>
                                                <span class="payment-balance-card__copy">
                                                    <strong>Loyalty Points</strong>
                                                    <small>@FormatPointBalance(LoyaltyPoints)</small>
                                                </span>
                                                <span class="payment-balance-card__check"><i class="bi bi-check"></i></span>
                                            </label>
                                        </div>
                                    </section>
                                </div>

                                <aside class="payment-review-card">
                                    <div class="payment-review-card__header">
                                        <div>
                                            <span>Payment Summary</span>
                                            <small>Review before confirming</small>
                                        </div>
                                        <span class="payment-review-status @BillingStatusCss">@BillingStatusText</span>
                                    </div>

                                    <div class="payment-review-total">
                                        <span>Total Payable</span>
                                        <strong>RM @TotalPayable.ToString("N2")</strong>
                                    </div>

                                    <div class="payment-review-breakdown">
                                        <div><span>Subtotal</span><strong>RM @Subtotal.ToString("N2")</strong></div>
                                        <div><span>Discounts</span><strong>-RM @DiscountTotal.ToString("N2")</strong></div>
                                        <div><span>MC Coverage</span><strong>-RM @McCoverage.ToString("N2")</strong></div>
                                        <div><span>Tax</span><strong>RM @TaxAmount.ToString("N2")</strong></div>
                                    </div>

                                    <div class="payment-review-divider"></div>

                                    <div class="payment-selected-method">
                                        <span class="payment-selected-method__icon"><i class="bi bi-credit-card-2-front"></i></span>
                                        <div>
                                            <small>Payment method</small>
                                            <strong>@PaymentMethodDisplay</strong>
                                        </div>
                                    </div>

                                    <div class="payment-amount-entry">
                                        <label for="billing-amount-received">Amount Received</label>
                                        <div class="payment-amount-input-wrap">
                                            <span>RM</span>
                                            <input id="billing-amount-received"
                                                   class="payment-input payment-input--amount"
                                                   type="text"
                                                   inputmode="decimal"
                                                   placeholder="0.00"
                                                   value="@AmountReceivedText"
                                                   readonly
                                                   title="Amount received is calculated from the selected payment method amount(s)." />
                                        </div>
                                    </div>

                                    <div class="payment-result-grid">
                                        <div class="payment-result-box">
                                            <span>Outstanding</span>
                                            <strong class="@(OutstandingAmount > 0 ? "is-due" : string.Empty)">RM @OutstandingAmount.ToString("N2")</strong>
                                        </div>
                                        <div class="payment-result-box">
                                            <span>Change</span>
                                            <strong class="@(ChangeAmount > 0 ? "is-change" : string.Empty)">RM @ChangeAmount.ToString("N2")</strong>
                                        </div>
                                    </div>

                                    <button type="button"
                                            class="payment-confirm-button"
                                            disabled="@(_isProcessingPayment || !SelectedPaymentSplits.Any() || MultiPaymentTotal < TotalPayable)"
                                            @onclick="OnConfirmPaymentClicked">
                                        <span>
                                            <small>Confirm payment</small>
                                            <strong>RM @TotalPayable.ToString("N2")</strong>
                                        </span>
                                        <i class="bi bi-arrow-right-circle-fill"></i>
                                    </button>

                                    <div class="payment-security-note">
                                        <i class="bi bi-shield-check"></i>
                                        <span>Confirm only after the payment amount has been received.</span>
                                    </div>
                                </aside>
                            </div>
                        </div>
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

@if (_showPrescriptionModal)
{
    <div class="modal-overlay" @onclick="ClosePrescriptionModal">
        <div class="modal-container billing-prescription-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-info">
                <i class="bi bi-capsule"></i>
                <h3>Add Prescription Item</h3>
            </div>
            <div class="modal-body prescription-modal-body">
                <div class="prescription-layout-grid">
                    <!-- Left Panel: Search & List -->
                    <div class="prescription-left-panel">
                        <!-- Search Bar -->
                        <div class="service-search-bar">
                            <i class="bi bi-search"></i>
                            <input class="service-search-input"
                                   type="text"
                                   placeholder="Search by name or code"
                                   value="@PrescriptionViewModel.SearchTerm"
                                   @oninput="HandlePrescriptionSearch" />
                        </div>

                        <!-- Category Filter Dropdown -->
                        <div class="filter-dropdown-container">
                            <button class="btn-filter-dropdown" @onclick="ToggleCategoryDropdown">
                                <span>@(string.IsNullOrEmpty(PrescriptionViewModel.SelectedCategory) ? "All Categories" : PrescriptionViewModel.SelectedCategory)</span>
                                <i class="bi bi-chevron-down"></i>
                            </button>
                            <div class="filter-dropdown-menu @(_showCategoryDropdown ? "show" : "")">
                                <div class="filter-dropdown-item @(string.IsNullOrEmpty(PrescriptionViewModel.SelectedCategory) ? "active" : "")"
                                     @onclick="() => SetDrugCategory(string.Empty)">
                                    All Categories
                                </div>
                                @foreach (var cat in PrescriptionViewModel.AvailableCategories)
                                {
                                    <div class="filter-dropdown-item @(PrescriptionViewModel.SelectedCategory == cat ? "active" : "")"
                                         @onclick="() => SetDrugCategory(cat)">
                                        @cat
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Inventory product list -->
                        <div class="drug-selection-list">
                            @if (_isProductCatalogLoading)
                            {
                                <div class="catalog-state"><span class="spinner-border spinner-border-sm"></span> Loading inventory items...</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_productCatalogError))
                            {
                                <div class="catalog-state catalog-state-error">
                                    <span>@_productCatalogError</span>
                                    <button type="button" @onclick="LoadProductCatalogAsync">Retry</button>
                                </div>
                            }
                            else if (!PrescriptionViewModel.FilteredDrugs.Any())
                            {
                                <div class="catalog-state">No inventory items found.</div>
                            }
                            else
                            {
                                @foreach (var drug in PrescriptionViewModel.FilteredDrugs)
                                {
                                    var isOutOfStock = drug.StockQuantity.HasValue && drug.StockQuantity.Value <= 0;
                                    <div class="drug-selection-row @(PrescriptionViewModel.SelectedDrugToAdd?.InventoryId == drug.InventoryId ? "selected" : "") @(isOutOfStock ? "disabled" : "")"
                                         @onclick="() => SelectDrug(drug)">
                                        <div class="drug-icon">
                                            @if (!string.IsNullOrWhiteSpace(ResolveCatalogImage(drug.InventoryId, drug.ImagePath, drug.ImageFileName)))
                                            {
                                                <img src="@ResolveCatalogImage(drug.InventoryId, drug.ImagePath, drug.ImageFileName)" alt="" loading="lazy" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-box-seam"></i>
                                            }
                                        </div>
                                        <div class="drug-info">
                                            <h4>@drug.Name</h4>
                                            <div class="drug-meta">
                                                <span>@drug.DrugCode</span>
                                                <span class="dot">•</span>
                                                <span>@drug.Category</span>
                                                <span class="dot">•</span>
                                                <span>@(drug.StockQuantity.HasValue ? $"Stock {drug.StockQuantity.Value:N0}" : "Stock unavailable")</span>
                                            </div>
                                        </div>
                                        <div class="drug-list-price">RM @drug.Price.ToString("N2")</div>
                                        <div class="drug-action">
                                            @if (PrescriptionViewModel.SelectedDrugToAdd?.InventoryId == drug.InventoryId)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>


                    </div>

                    <!-- Right Panel: Form -->
                    <div class="prescription-right-panel">
                        @if (PrescriptionViewModel.SelectedDrugToAdd != null)
                        {
                            <div class="prescription-form-panel">
                                <div class="selected-drug-summary">
                                    <div class="drug-name-row">
                                        <div class="drug-title-block">
                                            <div class="label-with-action">
                                                <span class="field-label">Selected Item</span>
                                                <button class="btn-inline-action btn-inline-clear"
                                                        type="button"
                                                        title="Clear selected drug"
                                                        aria-label="Clear selected drug"
                                                        @onclick="CancelPrescriptionDrugSelection">
                                                    <i class="bi bi-x-circle"></i>
                                                    <span>Clear</span>
                                                </button>
                                            </div>
                                            <h4>@PrescriptionViewModel.SelectedDrugToAdd.Name</h4>
                                            <p>SKU: @PrescriptionViewModel.SelectedDrugToAdd.DrugCode · RM @PrescriptionViewModel.SelectedDrugToAdd.Price.ToString("N2")</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="prescription-form-grid">
                                    <div class="form-row">
                                        <label class="form-label">Dosage</label>
                                        <input type="number"
                                               class="form-control"
                                               step="0.01"
                                               min="0"
                                               @bind="PrescriptionViewModel.NewDrugQuantity" />
                                    </div>
                                    <div class="form-row">
                                        <div class="form-label-row">
                                            <div class="label-with-action">
                                                <label class="form-label">Frequency</label>
                                                <button class="btn-inline-action"
                                                        type="button"
                                                        title="@(_manualFrequency ? "Switch to dropdown" : "Switch to manual entry")"
                                                        @onclick="ToggleManualFrequency">
                                                    <i class="bi @(_manualFrequency ? "bi-list-check" : "bi-pencil-square")"></i>
                                                    <span>Edit</span>
                                                </button>
                                            </div>
                                        </div>
                                        @if (_manualFrequency)
                                        {
                                            <input class="form-control"
                                                   type="text"
                                                   @bind="PrescriptionViewModel.NewDrugFrequency"
                                                   placeholder="Enter frequency" />
                                        }
                                        else
                                        {
                                            <div class="custom-dropdown-wrapper form-dropdown">
                                                <div class="custom-dropdown-trigger @(_isFrequencyDropdownOpen ? "open" : "")" @onclick="ToggleFrequencyDropdown">
                                                    <span>@(string.IsNullOrEmpty(PrescriptionViewModel.NewDrugFrequency) ? "- SELECT FREQUENCY -" : PrescriptionViewModel.NewDrugFrequency)</span>
                                                    <i class="bi bi-chevron-down dropdown-arrow"></i>
                                                </div>
                                                @if (_isFrequencyDropdownOpen)
                                                {
                                                    <div class="custom-dropdown-menu">
                                                        @foreach (var freq in PrescriptionViewModel.FrequencyOptions)
                                                        {
                                                            <div class="dropdown-item @(PrescriptionViewModel.NewDrugFrequency == freq ? "selected" : "")" @onclick="@(() => SelectFrequency(freq))">
                                                                @freq
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="form-row">
                                        <div class="form-label-row">
                                            <div class="label-with-action">
                                                <label class="form-label">Duration</label>
                                                <button class="btn-inline-action"
                                                        type="button"
                                                        title="@(_manualDuration ? "Switch to dropdown" : "Switch to manual entry")"
                                                        @onclick="ToggleManualDuration">
                                                    <i class="bi @(_manualDuration ? "bi-list-check" : "bi-pencil-square")"></i>
                                                    <span>Edit</span>
                                                </button>
                                            </div>
                                        </div>
                                        @if (_manualDuration)
                                        {
                                            <input class="form-control"
                                                   type="text"
                                                   @bind="PrescriptionViewModel.NewDrugDuration"
                                                   placeholder="Enter duration" />
                                        }
                                        else
                                        {
                                            <div class="custom-dropdown-wrapper form-dropdown">
                                                <div class="custom-dropdown-trigger @(_isDurationDropdownOpen ? "open" : "")" @onclick="ToggleDurationDropdown">
                                                    <span>@(string.IsNullOrEmpty(PrescriptionViewModel.NewDrugDuration) ? "- SELECT -" : PrescriptionViewModel.NewDrugDuration)</span>
                                                    <i class="bi bi-chevron-down dropdown-arrow"></i>
                                                </div>
                                                @if (_isDurationDropdownOpen)
                                                {
                                                    <div class="custom-dropdown-menu">
                                                        @foreach (var duration in PrescriptionViewModel.DurationOptions)
                                                        {
                                                            <div class="dropdown-item @(PrescriptionViewModel.NewDrugDuration == duration ? "selected" : "")" @onclick="@(() => SelectDuration(duration))">
                                                                @duration
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="form-row">
                                        <div class="form-label-row">
                                            <div class="label-with-action">
                                                <label class="form-label">Reason</label>
                                                <button class="btn-inline-action"
                                                        type="button"
                                                        title="@(_manualReason ? "Switch to dropdown" : "Switch to manual entry")"
                                                        @onclick="ToggleManualReason">
                                                    <i class="bi @(_manualReason ? "bi-list-check" : "bi-pencil-square")"></i>
                                                    <span>Edit</span>
                                                </button>
                                            </div>
                                        </div>
                                        @if (_manualReason)
                                        {
                                            <input class="form-control"
                                                   type="text"
                                                   @bind="PrescriptionViewModel.NewDrugReason"
                                                   placeholder="Enter reason" />
                                        }
                                        else
                                        {
                                            <div class="custom-dropdown-wrapper form-dropdown">
                                                <div class="custom-dropdown-trigger @(_isReasonDropdownOpen ? "open" : "")" @onclick="ToggleReasonDropdown">
                                                    <span>@(string.IsNullOrEmpty(PrescriptionViewModel.NewDrugReason) ? "- SELECT REASON -" : PrescriptionViewModel.NewDrugReason)</span>
                                                    <i class="bi bi-chevron-down dropdown-arrow"></i>
                                                </div>
                                                @if (_isReasonDropdownOpen)
                                                {
                                                    <div class="custom-dropdown-menu">
                                                        @foreach (var reason in PrescriptionViewModel.ReasonOptions)
                                                        {
                                                            <div class="dropdown-item @(PrescriptionViewModel.NewDrugReason == reason ? "selected" : "")" @onclick="@(() => SelectReason(reason))">
                                                                @reason
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="form-row">
                                        <label class="form-label">Notes</label>
                                        <textarea class="form-control form-textarea"
                                                  rows="3"
                                                  @bind="PrescriptionViewModel.NewDrugNotes"
                                                  placeholder="Add notes"></textarea>
                                    </div>
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="prescription-placeholder">
                                <div class="placeholder-content">
                                    <i class="bi bi-capsule-pill"></i>
                                    <p>Select an inventory item to enter prescription details</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>



                @if (!string.IsNullOrEmpty(_prescriptionStatusMessage))
                {
                    <div class="status-message @(_prescriptionStatusIsSuccess ? "status-success" : "status-error")">
                        <i class="bi @(_prescriptionStatusIsSuccess ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
                        <span>@_prescriptionStatusMessage</span>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" type="button" @onclick="ClosePrescriptionModal">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-confirm" type="button" @onclick="AddSinglePrescriptionDrug" disabled="@(PrescriptionViewModel.SelectedDrugToAdd == null || _isProductCatalogLoading)">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add Item</span>
                </button>
            </div>
        </div>
    </div>
}

@* Payment calculator - follows Sales > New Sale payment workflow *@
@if (_billingCalculatorMethod is not null)
{
    <div class="modal-overlay" @onclick="CloseBillingPaymentCalculator">
        <div class="modal-container billing-payment-calculator" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-info billing-payment-calculator__header">
                <span class="billing-payment-calculator__method-icon">
                    <i class="@GetPaymentMethodIcon(_billingCalculatorMethod.POSPaymentTypeName ?? string.Empty)"></i>
                </span>
                <div class="billing-payment-calculator__method">
                    <small>Payment Method</small>
                    <h3>@(_billingCalculatorMethod.POSPaymentTypeName ?? "Payment")</h3>
                </div>
                <button type="button"
                        class="billing-payment-calculator__close"
                        aria-label="Close payment calculator"
                        @onclick="CloseBillingPaymentCalculator">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="billing-payment-calculator__summary">
                <div><span>Total Payable</span><strong>RM @TotalPayable.ToString("N2")</strong></div>
                <div><span>Already Paid</span><strong>RM @BillingPaidExcludingCalculatorMethod.ToString("N2")</strong></div>
                <div><span>Remaining</span><strong>RM @BillingCalculatorRemaining.ToString("N2")</strong></div>
            </div>

            <div class="billing-payment-calculator__display">
                <span>RM</span>
                <strong>@BillingCalculatorAmount.ToString("N2")</strong>
            </div>

            <button type="button"
                    class="billing-payment-calculator__exact"
                    @onclick="UseBillingExactAmount">
                <i class="bi bi-check2-circle"></i>
                <span>Pay Remaining | RM @BillingCalculatorRemaining.ToString("N2")</span>
            </button>

            <div class="billing-payment-calculator__keypad">
                @foreach (var key in BillingKeypadKeys)
                {
                    <button type="button" @onclick="() => PressBillingCalculatorKey(key)">@key</button>
                }
                <button type="button" @onclick="ClearBillingCalculator">Clear</button>
                <button type="button" @onclick="BillingCalculatorZero">0</button>
                <button type="button" @onclick="BackspaceBillingCalculator"><i class="bi bi-backspace"></i></button>
                <button type="button" class="double-zero" @onclick="BillingCalculatorDoubleZero">00</button>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" @onclick="CloseBillingPaymentCalculator">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button type="button"
                        class="btn-modal-confirm"
                        disabled="@(BillingCalculatorAmount <= 0)"
                        @onclick="ConfirmBillingPaymentAmount">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Use RM @BillingCalculatorAmount.ToString("N2")</span>
                </button>
            </div>
        </div>
    </div>
}

@* Payment confirmation & post-payment option modals *@
@if (_showConfirmPaymentModal)
{
    <div class="modal-overlay" @onclick="CloseConfirmPaymentModal">
        <div class="modal-container billing-confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-info">
                <i class="bi bi-credit-card"></i>
                <h3>Confirm Payment</h3>
            </div>
            <div class="modal-body">
                <p>Complete this payment using <strong>@PaymentMethodDisplay</strong>?</p>
                <div class="payment-summary-box">
                    <div class="summary-detail-row">
                        <span class="summary-label">Total Payable:</span>
                        <strong class="summary-value">RM @TotalPayable.ToString("N2")</strong>
                    </div>
                    <div class="summary-detail-row">
                        <span class="summary-label">Amount Received:</span>
                        <strong class="summary-value">RM @(AmountReceived?.ToString("N2") ?? "0.00")</strong>
                    </div>
                    @if (ChangeAmount > 0)
                    {
                        <div class="summary-detail-row highlight-change">
                            <span class="summary-label">Change:</span>
                            <strong class="summary-value change-amount">RM @ChangeAmount.ToString("N2")</strong>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CloseConfirmPaymentModal">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-confirm" @onclick="ConfirmPaymentAsync">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Complete Payment</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_showPaymentSummaryModal)
{
    <div class="modal-overlay">
        <div class="modal-container billing-confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-info">
                <i class="bi bi-check-circle-fill"></i>
                <h3>Payment Successful</h3>
            </div>
            <div class="modal-body">
                <p>Payment has been completed successfully!</p>
                
                <div class="payment-summary-box">
                    <div class="summary-detail-row">
                        <span class="summary-label">Total Payable:</span>
                        <strong class="summary-value">RM @TotalPayable.ToString("N2")</strong>
                    </div>
                    <div class="summary-detail-row">
                        <span class="summary-label">Amount Received:</span>
                        <strong class="summary-value">RM @(AmountReceived?.ToString("N2") ?? "0.00")</strong>
                    </div>
                    @if (ChangeAmount > 0)
                    {
                        <div class="summary-detail-row highlight-change">
                            <span class="summary-label">Change:</span>
                            <strong class="summary-value change-amount">RM @ChangeAmount.ToString("N2")</strong>
                        </div>
                    }
                </div>

                <div class="receipt-options">
                    <p class="receipt-options-label">Would you like a receipt?</p>
                    <div class="receipt-buttons">
                        <button class="btn-receipt-option" @onclick="PrintReceiptAndClose" disabled="@_isProcessingPayment">
                            <i class="bi bi-printer"></i>
                            <span>Print Receipt</span>
                        </button>
                        <button class="btn-receipt-option" @onclick="DownloadReceiptPdfAndClose" disabled="@_isProcessingPayment">
                            <i class="bi bi-download"></i>
                            <span>Download PDF Receipt</span>
                        </button>
                        <button class="btn-receipt-option" @onclick="EmailReceiptAndClose" disabled="@_isProcessingPayment">
                            <i class="bi bi-envelope"></i>
                            <span>Email Receipt</span>
                        </button>
                    </div>
                </div>

                @if (_isProcessingPayment)
                {
                    <div class="modal-processing">
                        <i class="bi bi-arrow-repeat spinner"></i>
                        <span>Processing...</span>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-modal-confirm" @onclick="ClosePaymentSummaryModal" disabled="@_isProcessingPayment">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Done (No Receipt)</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_showInsufficientAmountModal)
{
    <div class="modal-overlay" @onclick="CloseInsufficientAmountModal">
        <div class="modal-container billing-confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <h3>Insufficient Amount</h3>
            </div>
            <div class="modal-body">
                <p>The amount received is not enough to complete this payment.</p>
                <div class="amount-comparison">
                    <div class="amount-row">
                        <span>Total Payable:</span>
                        <strong>RM @TotalPayable.ToString("N2")</strong>
                    </div>
                    <div class="amount-row">
                        <span>Amount Received:</span>
                        <strong>RM @(AmountReceived?.ToString("N2") ?? "0.00")</strong>
                    </div>
                    <div class="amount-row shortage">
                        <span>Shortage:</span>
