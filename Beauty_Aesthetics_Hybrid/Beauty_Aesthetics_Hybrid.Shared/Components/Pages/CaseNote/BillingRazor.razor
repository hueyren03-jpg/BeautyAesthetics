    private async Task LoadProductCatalogAsync()
    {
        _isProductCatalogLoading = true;
        _productCatalogError = null;
        try
        {
            var branchId = string.IsNullOrWhiteSpace(AppState.SelectedBranchID) ? "HQ" : AppState.SelectedBranchID!;
            var result = await ProductInventoryService.LoadProductsAsync(branchId);
            if (!result.Success || result.Value is null)
            {
                PrescriptionViewModel.ReplaceDrugs([]);
                _productCatalogError = result.ErrorMessage ?? "Unable to load inventory items.";
                return;
            }

            var products = result.Value
                .Where(product => product.IsActive)
                .OrderBy(product => product.Type)
                .Select((product, index) => new CaseNotePrescriptionViewModel.Drug(
                    index + 1,
                    product.Type,
                    product.Sku,
                    product.Category,
                    product.Remarks,
                    string.Empty,
                    product.ConversionFactor,
                    product.MasterAccountId,
                    product.Price,
                    product.StockQuantity,
                    product.IsActive,
                    product.ImagePath,
                    product.ImageFileName,
                    product.TaxCode,
                    product.IsTaxInclusive))
                .ToList();

            PrescriptionViewModel.ReplaceDrugs(products);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load billing inventory catalog: {ex.Message}");
            PrescriptionViewModel.ReplaceDrugs([]);
            _productCatalogError = "Unable to load inventory items.";
        }
        finally
        {
            _isProductCatalogLoading = false;
        }
    }

