    private void ApplyBillDiscountToTransactionItems(List<TransactionItem> items)
    {
        if (BillDiscount <= 0m || items.Count == 0)
        {
            return;
        }

        var eligible = items
            .Select(item => new
            {
                Item = item,
                NetBeforeBillDiscount = Math.Max(0m, item.UnitPrice * Math.Max(1, item.Quantity) - item.Discount)
            })
            .Where(entry => !entry.Item.IsPackageRedemption && entry.NetBeforeBillDiscount > 0m)
            .ToList();

        if (eligible.Count == 0)
        {
            return;
        }

        var remainingBase = eligible.Sum(entry => entry.NetBeforeBillDiscount);
        var remainingDiscount = Math.Min(BillDiscount, remainingBase);

        for (var index = 0; index < eligible.Count; index++)
        {
            var entry = eligible[index];
            var allocation = index == eligible.Count - 1 || remainingBase <= 0m
                ? remainingDiscount
                : Math.Round(
                    remainingDiscount * entry.NetBeforeBillDiscount / remainingBase,
                    2,
                    MidpointRounding.AwayFromZero);

            allocation = Math.Clamp(allocation, 0m, entry.NetBeforeBillDiscount);
            entry.Item.Discount += allocation;
            var adjustedAmounts = CalculateBillingLineAmounts(
                entry.Item.UnitPrice,
                Math.Max(1, entry.Item.Quantity),
                entry.Item.Discount,
                entry.Item.TaxPercentage,
                entry.Item.IsTaxInclusive);
            entry.Item.TaxAmount = adjustedAmounts.Tax;
            entry.Item.TotalPrice = Math.Max(
                0m,
                adjustedAmounts.BeforeTax + adjustedAmounts.Tax);

            if (string.IsNullOrWhiteSpace(entry.Item.CashDiscountId))
            {
                entry.Item.CashDiscountId = BillDiscountCashDiscountId;
            }

            if (!string.IsNullOrWhiteSpace(BillDiscountMemo) &&
                !entry.Item.DiscountMemo.Contains(BillDiscountMemo, StringComparison.OrdinalIgnoreCase))
            {
                entry.Item.DiscountMemo = string.IsNullOrWhiteSpace(entry.Item.DiscountMemo)
                    ? BillDiscountMemo
                    : $"{entry.Item.DiscountMemo}; {BillDiscountMemo}";
            }

            remainingDiscount -= allocation;
            remainingBase -= entry.NetBeforeBillDiscount;
        }
    }

    private BillingTotals CalculateBillingTotals()
    {
        var lines = new List<BillingTaxLine>();

        lines.AddRange(PrescriptionItems.Select(item => new BillingTaxLine(
            item.UnitPrice,
            Math.Max(1, item.Quantity),
            Math.Clamp(item.Discount, 0m, item.UnitPrice * Math.Max(1, item.Quantity)),
            item.TaxRate,
            item.IsTaxInclusive)));

        lines.AddRange(ServiceItems.Select(item => new BillingTaxLine(
            item.UnitPrice,
            Math.Max(1, item.Quantity),
            Math.Clamp(item.Discount, 0m, item.UnitPrice * Math.Max(1, item.Quantity)),
            item.TaxRate,
            item.IsTaxInclusive)));

        lines.AddRange(MemberCreditItems.Select(item => new BillingTaxLine(
            item.UnitPrice,
            Math.Max(1, item.Quantity),
            Math.Clamp(item.Discount, 0m, item.UnitPrice * Math.Max(1, item.Quantity)),
            item.TaxRate,
            item.IsTaxInclusive)));

        lines.AddRange(BillingPackageItems.Select(item => new BillingTaxLine(
            item.UnitPrice, Math.Max(1, item.Quantity), item.Discount, item.TaxPercentage, item.IsTaxInclusive, item.IsPackageRedemption)));

        if (lines.Count == 0)
        {
            return new BillingTotals(0m, 0m, 0m, 0m);
        }

        var netBeforeBillDiscount = lines
            .Select(line => line.IsPackageRedemption ? 0m : Math.Max(0m, line.UnitPrice * line.Quantity - line.Discount))
            .ToArray();
        var remainingBase = netBeforeBillDiscount.Sum();
        var remainingBillDiscount = Math.Min(Math.Max(0m, BillDiscount), remainingBase);
        var lastDiscountLine = Array.FindLastIndex(netBeforeBillDiscount, value => value > 0m);

        decimal subtotalBeforeTax = 0m;
        decimal totalTax = 0m;

        for (var index = 0; index < lines.Count; index++)
        {
            var line = lines[index];
            var lineBase = netBeforeBillDiscount[index];
            var billAllocation = index == lastDiscountLine || remainingBase <= 0m
                ? remainingBillDiscount
                : Math.Round(
                    remainingBillDiscount * lineBase / remainingBase,
                    2,
                    MidpointRounding.AwayFromZero);

            billAllocation = Math.Clamp(billAllocation, 0m, lineBase);
            var combinedDiscount = Math.Clamp(
                line.Discount + billAllocation,
                0m,
                line.UnitPrice * line.Quantity);

            Beauty_Aesthetics_WebPos.Components.Services.Tax.OrderLineTaxCalculator.ComputeLineAmounts(
                line.UnitPrice,
                line.Quantity,
                combinedDiscount,
                line.TaxRate,
                line.IsTaxInclusive,
                out var beforeTax,
                out var tax);

            subtotalBeforeTax += beforeTax;
            totalTax += tax;
            remainingBillDiscount -= billAllocation;
            remainingBase -= lineBase;
        }

        subtotalBeforeTax = Math.Round(subtotalBeforeTax, 2, MidpointRounding.AwayFromZero);
        totalTax = Math.Round(totalTax, 2, MidpointRounding.AwayFromZero);
        var beforeRounding = subtotalBeforeTax + totalTax;
        var cashDue = Math.Max(0m, beforeRounding - BillingPackageCoveredAmount);
        var roundedCash = Math.Round(cashDue * 20m, MidpointRounding.AwayFromZero) / 20m;
        var rounding = Math.Round(roundedCash - cashDue, 2, MidpointRounding.AwayFromZero);
        var roundedTotal = beforeRounding + rounding;

        return new BillingTotals(subtotalBeforeTax, totalTax, rounding, roundedTotal);
    }

    private List<TransactionPayment> BuildBillingTransactionPayments() =>
        BillingPayments
            .Where(payment => payment.PaymentTypeId != 0 && payment.Amount > 0m)
            .Select(payment => new TransactionPayment
            {
                PaymentTypeId = payment.PaymentTypeId,
                PaymentMethod = payment.PaymentMethod,
                Amount = payment.Amount,
                FinancialAccountId = payment.FinancialAccountId,
                BankName = payment.BankName
            })
            .ToList();

    private string BuildBillingPaymentNotes()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(AppointmentId))
            parts.Add($"Appointment {AppointmentId.Trim()}");
        if (BillDiscount > 0m) parts.Add($"Bill Discount RM {BillDiscount:N2}");
        if (!string.IsNullOrWhiteSpace(SelectedCollectorId)) parts.Add($"Collector {SelectedCollector} ({SelectedCollectorId})");
        return string.Join(" | ", parts);
    }

    private static string BuildPrescriptionLineDescription(BillingItem item)
    {
        var details = new[] { item.Frequency, item.Duration, item.Reason }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var suffix = string.Join(" · ", details);
        return string.IsNullOrWhiteSpace(suffix) ? item.Name : $"{item.Name} - {suffix}";
    }

