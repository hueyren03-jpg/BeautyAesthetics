@if (_showRedeemableCredits)
{
    <div class="modal-overlay billing-wallet-overlay" @onclick="CloseRedeemableCredits">
        <div class="modal-container billing-service-modal billing-credit-dialog credit-wallet-dialog billing-wallet-dialog @(!string.IsNullOrWhiteSpace(_selectedHistoryCreditId) ? "has-credit-history" : string.Empty)"
             role="dialog" aria-modal="true" aria-labelledby="billing-member-credit-title" @onclick:stopPropagation="true">
            <BillingWalletFormHeader Title="Member Credit" TitleId="billing-member-credit-title" Icon="bi-credit-card-2-front" OnClose="CloseRedeemableCredits" />
            <div class="modal-body">
                @if (_isRedeemableCreditsLoading)
                {
                    <div class="catalog-state">
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Loading accounts...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_redeemableCreditsError))
                {
                    <div class="catalog-state catalog-state-error">
                        <span>@_redeemableCreditsError</span>
                        <button type="button" @onclick="ReloadRedeemableCreditsAsync">Retry</button>
                    </div>
                }
                else if (_redeemableCredits.Count == 0)
                {
                    <div class="catalog-state">
                        <i class="bi bi-wallet"></i>
                        <strong>No redeemable Member Credit</strong>
                    </div>
                }
                else
                {
                    <div class="billing-credit-account-toolbar">
                        <label class="billing-credit-account-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" aria-label="Search credit accounts" placeholder="Search account or member type" @bind="_billingCreditAccountSearch" @bind:event="oninput" /></label>
                        <span>@_redeemableCredits.Count accounts</span>
                    </div>
                    <div class="billing-credit-total-row"><span>Available Credit</span><strong>RM @(_redeemableCredits.Sum(x => x.NetBalanceAfterUtilised).ToString("N2"))</strong></div>
                    @if (!FilteredBillingCreditAccounts.Any())
                    {
                        <div class="catalog-state billing-credit-no-results">No matching accounts.</div>
                    }
                    <div class="table-wrapper billing-credit-table-wrap billing-credit-desktop">
                        <table class="billing-table billing-credit-table">
                            <thead>
                                <tr>
                                    <th>Account</th>
                                    <th>Purchase</th>
                                    <th>Expiry</th>
                                    <th>Balance</th>
                                    <th><span class="visually-hidden">History</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var credit in FilteredBillingCreditAccounts)
                                {
                                    <tr>
                                        <td><strong>@credit.ARAPOutstandingID</strong><small>@(string.IsNullOrWhiteSpace(credit.MemberTypeID) ? "—" : credit.MemberTypeID)</small><span class="billing-credit-status">Redeemable</span></td>
                                        <td><strong>@(string.IsNullOrWhiteSpace(credit.ItemDescription) ? "—" : credit.ItemDescription)</strong><small>@(string.IsNullOrWhiteSpace(credit.DisplayCode) ? "—" : credit.DisplayCode)</small><small>@FormatRedeemableCreditDate(credit.FinancialDate)</small></td>
                                        <td>@FormatRedeemableCreditDate(credit.DueDate)</td>
                                        <td><strong>RM @credit.NetBalanceAfterUtilised.ToString("N2")</strong><small>Original RM @credit.TotalAmount.ToString("N2")</small></td>
                                        <td>
                                            <button type="button"
                                                    class="billing-credit-history-btn"
                                                    aria-label="@($"History for {credit.ARAPOutstandingID}")"
                                                    @onclick="() => LoadCreditRedemptionHistoryAsync(credit)">
                                                <i class="bi bi-clock-history" aria-hidden="true"></i> History
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="billing-credit-mobile-list" aria-label="Member Credit accounts">
                        @foreach (var credit in FilteredBillingCreditAccounts)
                        {
                            <article class="billing-credit-mobile-card">
                                <div class="billing-credit-mobile-card__header">
                                    <div>
                                        <strong>@credit.ARAPOutstandingID</strong>
                                        <span>@(string.IsNullOrWhiteSpace(credit.DisplayCode) ? "No document" : credit.DisplayCode)</span>
                                    </div>
                                    <span class="billing-credit-mobile-balance">RM @credit.NetBalanceAfterUtilised.ToString("N2")</span>
                                </div>
                                <dl>
                                    <div><dt>Purchase</dt><dd>@FormatRedeemableCreditDate(credit.FinancialDate)</dd></div>
                                    <div><dt>Expiry</dt><dd>@FormatRedeemableCreditDate(credit.DueDate)</dd></div>
                                    <div><dt>Member Type</dt><dd>@(string.IsNullOrWhiteSpace(credit.MemberTypeID) ? "—" : credit.MemberTypeID)</dd></div>
                                    <div><dt>Purchased Via</dt><dd>@(string.IsNullOrWhiteSpace(credit.ItemDescription) ? "—" : credit.ItemDescription)</dd></div>
                                    <div><dt>Original</dt><dd>RM @credit.TotalAmount.ToString("N2")</dd></div>
                                    <div><dt>Status</dt><dd><span class="billing-credit-status">Redeemable</span></dd></div>
                                </dl>
                                <button type="button"
                                        class="billing-credit-history-btn"
                                        aria-label="@($"History for {credit.ARAPOutstandingID}")"
                                        @onclick="() => LoadCreditRedemptionHistoryAsync(credit)">
                                    <i class="bi bi-clock-history"></i>
                                    <span>History</span>
                                </button>
                            </article>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_selectedHistoryCreditId))
                    {
                        <section class="billing-credit-history">
                            <div class="billing-credit-history__header">
                                <div>
                                    <strong>Redemption History</strong>
                                    <span>@_selectedHistoryCreditId</span>
                                </div>
                                <button type="button"
                                        class="billing-credit-history__close"
                                        title="Back to Member Credit accounts"
                                        aria-label="Back to Member Credit accounts"
                                        @onclick="CloseCreditRedemptionHistory">
                                    <i class="bi bi-arrow-left"></i><span>Back</span>
                                </button>
                            </div>

                            @if (_isCreditHistoryLoading)
