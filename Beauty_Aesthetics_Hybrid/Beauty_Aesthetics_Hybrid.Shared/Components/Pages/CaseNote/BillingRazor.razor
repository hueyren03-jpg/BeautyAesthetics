<AppErrorPopup Title="Billing request failed"
               Message="@BillingErrorMessage"
               OnDismiss="DismissBillingError" />

@code {
    [SupplyParameterFromQuery(Name = "customerId")]
    public string? CustomerId { get; set; }

    private string? BillingErrorMessage => new[]
    {
        AmountReceivedError,
        _showPrescriptionValidationError ? "Please fill in prescription frequency, duration, and reason." : null,
        _paymentValidationError,
        _paymentMethodsError,
        _multiPaymentError,
        _postPaymentEmailError,
        _discountError
    }.FirstOrDefault(message => !string.IsNullOrWhiteSpace(message));

    private void DismissBillingError()
    {
        AmountReceivedError = null;
        _showPrescriptionValidationError = false;
        _paymentValidationError = null;
        _paymentMethodsError = null;
        _multiPaymentError = string.Empty;
        _postPaymentEmailError = string.Empty;
        _discountError = string.Empty;
    }

    private string PatientName { get; set; } = "-";
    private string PatientBirthday { get; set; } = "-";
    private string PatientPhone { get; set; } = "-";
    private string _billingCustomerId = string.Empty;

    private bool _isPatientInfoCollapsed = false;
    private bool _isPatientDrawerOpen = false;
    private string _billingStep = "summary";

    private string VisitDate { get; set; } = DateTime.Now.ToString("dd/MM/yyyy");
    private string DoctorName { get; set; } = "Dr. Example";

    private string BillingStatusText { get; set; } = "Unpaid";
    private string BillingStatusCss => string.Equals(BillingStatusText, "Paid", StringComparison.OrdinalIgnoreCase)
        ? "status-paid"
        : "status-unpaid";

    private decimal? CashWalletAmount { get; set; }
    private decimal? CreditVoucherAmount { get; set; }
    private decimal? BeautiPoints { get; set; }
    private decimal? BeautiPointsValue { get; set; }

    // These values are intentionally unset until their API fields are supplied.
    private decimal? LoyaltyPoints { get; set; }
    private string? LoyaltyTier { get; set; }
    private decimal? PreviousOutstandingAmount { get; set; }
    private bool _isCustomerBalanceLoading;

    private string FormatMoneyBalance(decimal? value) => value.HasValue ? $"RM {value.Value:N2}" : "—";
    private string FormatPointBalance(decimal? value) => value.HasValue ? $"{value.Value:N0} pts" : "—";
    private string BalanceFooter(decimal? value, string loadedText) => _isCustomerBalanceLoading
        ? "Loading..."
        : value.HasValue ? loadedText : "Unavailable";
    private string FormatPointValue() => _isCustomerBalanceLoading
        ? "Loading..."
        : BeautiPointsValue.HasValue
            ? $"≈ RM {BeautiPointsValue.Value:N2}"
            : "Unavailable";

    private List<BillingItem> PrescriptionItems { get; set; } = new();
    private List<BillingService> ServiceItems { get; set; } = new();

    // MC / insurance and summary values
    private decimal McCoverage { get; set; } = 150.00m;   // e.g. MC pays RM150
    private decimal BillDiscount { get; set; } = 0m;
    private readonly object BillDiscountToken = new();

    private decimal DiscountTotal =>
        PrescriptionItems.Sum(i => i.Discount) +
        ServiceItems.Sum(s => s.Discount) +
        BillDiscount;

    private decimal Subtotal =>
        PrescriptionItems.Sum(i => i.LineTotal + i.Discount) +
        ServiceItems.Sum(s => s.LineTotal + s.Discount);

    private decimal TaxRate { get; set; } = 0.06m; // 6% SST/GST example
    private decimal TaxAmount => Math.Round((Subtotal - McCoverage - DiscountTotal) * TaxRate, 2);

    private decimal TotalPayable =>
        Math.Max(0m, Subtotal - McCoverage - DiscountTotal + TaxAmount);

    private decimal TotalAmount => TotalPayable;
    private decimal OutstandingAmount => Math.Max(0m, TotalPayable - (AmountReceived ?? 0m));

    private int SelectedPaymentTypeId { get; set; }
    private string SelectedPaymentMethod { get; set; } = string.Empty;
    private List<CashSalesPaymentTypeDTO> AvailablePaymentMethods { get; set; } = new();
    private bool _isPaymentMethodsLoading;
    private string? _paymentMethodsError;
    private string _completedSaleDocumentId = string.Empty;
    private string _completedReceiptNumber = string.Empty;
    private string _invoiceDownloadUrl = string.Empty;
    private string _eInvoiceUrl = string.Empty;
    private string SelectedCollectorId { get; set; } = string.Empty;
    private string SelectedCollector { get; set; } = string.Empty;
    private List<Employee> CollectorOptions { get; set; } = new();
    private bool _isStaffLoading;
    private string? _staffLoadError;
    private bool UseCashWallet { get; set; }
    private bool UseCreditVoucher { get; set; }
    private bool UseBeautiPoints { get; set; }
    private bool UseLoyaltyPoints { get; set; }

    private string AmountReceivedText { get; set; } = string.Empty;
    private decimal? AmountReceived { get; set; }
    private string? AmountReceivedError { get; set; }
    private CancellationTokenSource? _amountInputCts;

    // Same payment calculator behavior as Sales > New Sale.
    private CashSalesPaymentTypeDTO? _billingCalculatorMethod;
    private string _billingCalculatorDigits = string.Empty;
    private static readonly string[] BillingKeypadKeys = ["1", "2", "3", "4", "5", "6", "7", "8", "9"];

    private decimal ChangeAmount => Math.Max(0m, (AmountReceived ?? 0m) - TotalPayable);

    // Prescription modal state
    private CaseNotePrescriptionViewModel PrescriptionViewModel { get; set; } = CreateBillingPrescriptionViewModel();
    private bool _showPrescriptionModal;
    private bool _showPrescriptionValidationError;
    private bool _manualFrequency;
    private bool _manualDuration;
    private bool _manualReason;

    private static CaseNotePrescriptionViewModel CreateBillingPrescriptionViewModel()
    {
        var viewModel = new CaseNotePrescriptionViewModel();
        viewModel.ReplaceDrugs([]);
        return viewModel;
    }

    private string _prescriptionStatusMessage = string.Empty;
    private bool _prescriptionStatusIsSuccess;

    // Modal & post-payment state
    private bool _showConfirmPaymentModal;
    private bool _showPaymentSummaryModal;
    private bool _showInsufficientAmountModal;
    private bool _showPostPaymentModal;
    private bool _isProcessingPayment;
    private string? _paymentValidationError;
    private string _postPaymentEmail = string.Empty;
    private string? _postPaymentEmailError;

    // Multi-payment state
    private bool _showMultiPaymentModal;
    private string? _multiPaymentError;

    // Discount Modal state
    private bool _showDiscountModal;
    private object? _selectedDiscountItem; // BillingItem or BillingService
    private string _discountValue = string.Empty;
    private bool _isPercentageDiscount; // true = %, false = RM
    private string? _discountError;

    // Service picker modal state
    private bool _showServicePickerModal;

    private List<PaymentMethodGroup> PaymentMethodGroups { get; set; } = new();

    private IEnumerable<PaymentSplit> AllPaymentSplits =>
        PaymentMethodGroups.SelectMany(g => g.Methods);

    private IEnumerable<PaymentSplit> SelectedPaymentSplits =>
        AllPaymentSplits
            .Where(p => p.Amount.HasValue && p.Amount.Value > 0)
            .ToList();

    private decimal MultiPaymentTotal => SelectedPaymentSplits.Sum(p => p.Amount!.Value);
    private decimal MultiPaymentRemaining => TotalPayable - MultiPaymentTotal;

    private PaymentSplit? BillingPaymentFor(int paymentTypeId) =>
        AllPaymentSplits.FirstOrDefault(payment => payment.PaymentTypeId == paymentTypeId);

    private decimal BillingPaidExcludingCalculatorMethod =>
        _billingCalculatorMethod is null
            ? MultiPaymentTotal
            : SelectedPaymentSplits
                .Where(payment => payment.PaymentTypeId != _billingCalculatorMethod.POSPaymentTypeID)
                .Sum(payment => payment.Amount ?? 0m);

    private decimal BillingCalculatorRemaining =>
        Math.Max(0m, TotalPayable - BillingPaidExcludingCalculatorMethod);

    private decimal BillingCalculatorAmount =>
        decimal.TryParse(_billingCalculatorDigits, out var cents)
            ? cents / 100m
            : 0m;



    private List<ServiceViewModel.ServiceItem> ServiceCatalog { get; set; } = new();
    private bool _isProductCatalogLoading;
    private bool _isServiceCatalogLoading;
    private string? _loadingServiceId;
    private string? _productCatalogError;
    private string? _serviceCatalogError;

    private string _serviceSearchQuery = string.Empty;
    private string _selectedServiceCategory = "All";

    private List<string> ServiceCategories => ServiceCatalog
        .Select(s => s.Category)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct()
        .OrderBy(c => c)
        .Prepend("All")
        .ToList();

    private IEnumerable<ServiceViewModel.ServiceItem> FilteredServiceCatalog => ServiceCatalog
        .Where(s => s.IsActive &&
                    !string.Equals(s.Status, "Inactive", StringComparison.OrdinalIgnoreCase) &&
                    (_selectedServiceCategory == "All" || s.Category == _selectedServiceCategory) &&
                    (string.IsNullOrWhiteSpace(_serviceSearchQuery) ||
                     s.ServiceName.Contains(_serviceSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                     s.Sku.Contains(_serviceSearchQuery, StringComparison.OrdinalIgnoreCase)));

    private async Task LoadBillingCatalogsAsync()
    {
        await Task.WhenAll(LoadProductCatalogAsync(), LoadServiceCatalogAsync());
    }

    private async Task LoadProductCatalogAsync()
    {
        _isProductCatalogLoading = true;
        _productCatalogError = null;
        try
        {
            var branchId = string.IsNullOrWhiteSpace(AppState.SelectedBranchID) ? "HQ" : AppState.SelectedBranchID!;
            var result = await ProductInventoryService.LoadProductsAsync(branchId);
            if (!result.Success || result.Value is null)
            {
                PrescriptionViewModel.ReplaceDrugs([]);
                _productCatalogError = result.ErrorMessage ?? "Unable to load inventory items.";
                return;
            }

            var products = result.Value
                .Where(product => product.IsActive)
                .OrderBy(product => product.Type)
                .Select((product, index) => new CaseNotePrescriptionViewModel.Drug(
                    index + 1,
                    product.Type,
                    product.Sku,
                    product.Category,
                    product.Remarks,
                    string.Empty,
                    product.ConversionFactor,
                    product.MasterAccountId,
                    product.Price,
                    product.StockQuantity,
                    product.IsActive,
                    product.ImagePath,
                    product.ImageFileName))
                .ToList();

            PrescriptionViewModel.ReplaceDrugs(products);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load billing inventory catalog: {ex.Message}");
            PrescriptionViewModel.ReplaceDrugs([]);
            _productCatalogError = "Unable to load inventory items.";
        }
        finally
        {
            _isProductCatalogLoading = false;
        }
    }

    private async Task LoadServiceCatalogAsync()
    {
        _isServiceCatalogLoading = true;
        _serviceCatalogError = null;
        try
        {
            var branchId = string.IsNullOrWhiteSpace(AppState.SelectedBranchID) ? "HQ" : AppState.SelectedBranchID!;
            var result = await ServiceItemService.LoadServiceItemsAsync(branchId);
            if (!result.Success || result.Value is null)
            {
                ServiceCatalog = new List<ServiceViewModel.ServiceItem>();
                _serviceCatalogError = result.ErrorMessage ?? "Unable to load services.";
                return;
            }

            ServiceCatalog = result.Value
                .Where(service => service.IsActive &&
                                  !string.Equals(service.Status, "Inactive", StringComparison.OrdinalIgnoreCase))
                .OrderBy(service => service.ServiceName)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load billing service catalog: {ex.Message}");
            ServiceCatalog = new List<ServiceViewModel.ServiceItem>();
            _serviceCatalogError = "Unable to load services.";
        }
        finally
        {
            _isServiceCatalogLoading = false;
        }
    }

    private string ResolveCatalogImage(string? recordId, string? imagePath, string? imageFileName) =>
        ProductImageService.ResolveImageUrl(recordId, imagePath, imageFileName);

    private void UpdateServiceSearch(ChangeEventArgs e)
    {
        _serviceSearchQuery = e.Value?.ToString() ?? string.Empty;
    }

    private void SetServiceCategory(string category)
    {
        _selectedServiceCategory = category;
    }

    private async Task OpenServicePickerModal()
    {
        _serviceSearchQuery = string.Empty;
        _selectedServiceCategory = "All";
        _showServicePickerModal = true;
        if (ServiceCatalog.Count == 0 && !_isServiceCatalogLoading)
        {
            await LoadServiceCatalogAsync();
        }
    }

    private void CloseServicePickerModal()
    {
        _showServicePickerModal = false;
    }

    private async Task AddServiceFromCatalogAsync(ServiceViewModel.ServiceItem svc)
    {
        var serviceId = svc.MasterAccountId?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(serviceId))
        {
            Feedback.Warning("The selected service has no inventory record ID.", "Service not added");
            return;
        }

        if (!string.IsNullOrWhiteSpace(_loadingServiceId))
        {
            return;
        }

        _loadingServiceId = serviceId;
        await InvokeAsync(StateHasChanged);

        try
        {
            var detailResult = await ServiceItemService.LoadServiceAsync(serviceId);
            if (!detailResult.Success || detailResult.Value is null)
            {
                Feedback.Error(
                    detailResult.ErrorMessage ?? "Unable to load the selected service.",
                    "Service not added");
                return;
            }

            var detail = detailResult.Value;
            if (!detail.IsActive ||
                string.Equals(detail.Status, "Inactive", StringComparison.OrdinalIgnoreCase))
            {
                Feedback.Warning($"{detail.ServiceName} is inactive.", "Service unavailable");
                return;
            }

            if (!IsServiceAvailableNow(detail, out var availabilityMessage))
            {
                Feedback.Warning(availabilityMessage, "Service unavailable");
                return;
            }

            var existing = ServiceItems.FirstOrDefault(item =>
                string.Equals(item.SourceId, serviceId, StringComparison.OrdinalIgnoreCase));

            if (existing is not null)
            {
                var idx = ServiceItems.IndexOf(existing);
                ServiceItems[idx] = existing with { Quantity = existing.Quantity + 1 };
            }
            else
            {
                var serviceStaff = CollectorOptions.FirstOrDefault(employee => employee.IsServiceStaff);
                ServiceItems.Add(new BillingService(
                    detail.ServiceName,
                    serviceStaff?.Name ?? "Unassigned",
                    1,
                    detail.Price,
                    0m,
                    serviceId,
                    detail.Sku,
                    detail.Description,
                    detail.Category,
                    detail.DurationSpend,
                    detail.UnitOfMeasureId,
                    detail.TaxCode,
                    detail.IsTaxInclusive));
            }

            _showServicePickerModal = false;
            Feedback.Success($"{detail.ServiceName} added to billing.", "Service added", 2200);
        }
        catch (Exception ex)
        {
            Feedback.Error($"Unable to add service: {ex.Message}", "Service not added");
        }
        finally
        {
            _loadingServiceId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool IsServiceAvailableNow(
        ServiceViewModel.ServiceItem service,
        out string message)
    {
        var now = DateTime.Now;

        if (service.AvailableDateFrom.HasValue &&
            now.Date < service.AvailableDateFrom.Value.Date)
        {
            message = $"{service.ServiceName} is only available from {service.AvailableDateFrom.Value:dd/MM/yyyy}.";
            return false;
        }

        if (service.AvailableDateTo.HasValue &&
            now.Date > service.AvailableDateTo.Value.Date)
        {
            message = $"{service.ServiceName} is no longer available.";
            return false;
        }

        if (service.AvailableTimeFrom.HasValue &&
            now.TimeOfDay < service.AvailableTimeFrom.Value)
        {
            message = $"{service.ServiceName} is available from {service.AvailableTimeFrom.Value:hh\\:mm}.";
            return false;
        }

        if (service.AvailableTimeTo.HasValue &&
            now.TimeOfDay > service.AvailableTimeTo.Value)
        {
            message = $"{service.ServiceName} is only available until {service.AvailableTimeTo.Value:hh\\:mm}.";
            return false;
        }

        message = string.Empty;
        return true;
    }

