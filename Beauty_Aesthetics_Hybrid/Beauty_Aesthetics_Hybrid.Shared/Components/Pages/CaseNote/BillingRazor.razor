    private async Task AddServiceFromCatalogAsync(ServiceViewModel.ServiceItem svc)
    {
        var serviceId = svc.MasterAccountId?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(serviceId))
        {
            Feedback.Warning("The selected service has no inventory record ID.", "Service not added");
            return;
        }

        if (!string.IsNullOrWhiteSpace(_loadingServiceId))
        {
            return;
        }

        _loadingServiceId = serviceId;
        await InvokeAsync(StateHasChanged);

        try
        {
            var detailResult = await ServiceItemService.LoadServiceAsync(serviceId);
            if (!detailResult.Success || detailResult.Value is null)
            {
                Feedback.Error(
                    detailResult.ErrorMessage ?? "Unable to load the selected service.",
                    "Service not added");
                return;
            }

            var detail = detailResult.Value;
            var taxRate = await GstTaxRateService.GetRateForTaxCodeAsync(detail.TaxCode);
            if (!detail.IsActive ||
                string.Equals(detail.Status, "Inactive", StringComparison.OrdinalIgnoreCase))
            {
                Feedback.Warning($"{detail.ServiceName} is inactive.", "Service unavailable");
                return;
            }

            if (!IsServiceAvailableNow(detail, out var availabilityMessage))
            {
                Feedback.Warning(availabilityMessage, "Service unavailable");
                return;
            }

            var existing = ServiceItems.FirstOrDefault(item =>
                string.Equals(item.SourceId, serviceId, StringComparison.OrdinalIgnoreCase));

            if (existing is not null)
            {
                var idx = ServiceItems.IndexOf(existing);
                ServiceItems[idx] = existing with { Quantity = existing.Quantity + 1 };
            }
            else
            {
                var serviceStaff = CollectorOptions.FirstOrDefault(employee => employee.IsServiceStaff);
                ServiceItems.Add(new BillingService(
                    detail.ServiceName,
                    serviceStaff?.Name ?? "Unassigned",
                    1,
                    detail.Price,
                    0m,
                    serviceId,
                    detail.Sku,
                    detail.Description,
                    detail.Category,
                    detail.DurationSpend,
                    detail.UnitOfMeasureId,
                    detail.TaxCode,
                    detail.IsTaxInclusive,
                    taxRate));
            }

            _showServicePickerModal = false;
            Feedback.Success($"{detail.ServiceName} added to billing.", "Service added", 2200);
        }
        catch (Exception ex)
        {
            Feedback.Error($"Unable to add service: {ex.Message}", "Service not added");
        }
        finally
        {
            _loadingServiceId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool IsServiceAvailableNow(
        ServiceViewModel.ServiceItem service,
        out string message)
    {
        var now = DateTime.Now;

        if (service.AvailableDateFrom.HasValue &&
            now.Date < service.AvailableDateFrom.Value.Date)
        {
            message = $"{service.ServiceName} is only available from {service.AvailableDateFrom.Value:dd/MM/yyyy}.";
            return false;
        }

        if (service.AvailableDateTo.HasValue &&
            now.Date > service.AvailableDateTo.Value.Date)
        {
            message = $"{service.ServiceName} is no longer available.";
            return false;
        }

        if (service.AvailableTimeFrom.HasValue &&
            now.TimeOfDay < service.AvailableTimeFrom.Value)
        {
            message = $"{service.ServiceName} is available from {service.AvailableTimeFrom.Value:hh\\:mm}.";
            return false;
        }

        if (service.AvailableTimeTo.HasValue &&
            now.TimeOfDay > service.AvailableTimeTo.Value)
        {
            message = $"{service.ServiceName} is only available until {service.AvailableTimeTo.Value:hh\\:mm}.";
            return false;
        }

        message = string.Empty;
        return true;
    }

