            {
                Feedback.Error(
                    result.ErrorMessage ?? "Unable to generate the receipt PDF.",
                    "Receipt unavailable");
                return;
            }

            var receiptPdf = result.Value.Trim();

            var safeDocumentId = Regex.Replace(
                string.IsNullOrWhiteSpace(_completedSaleDocumentId)
                    ? "Receipt"
