    private async Task HandleAmountInputDebounced(ChangeEventArgs args)
    {
        // Cancel any pending debounce operation
        _amountInputCts?.Cancel();
        _amountInputCts?.Dispose();

        var cts = new CancellationTokenSource();
        _amountInputCts = cts;
        var token = cts.Token;
        var currentText = args.Value?.ToString() ?? string.Empty;

        try
        {
            // Simple debounce to avoid excessive parsing while typing
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        // Empty input: clear amount & error
        if (string.IsNullOrWhiteSpace(currentText))
        {
            AmountReceivedText = string.Empty;
            AmountReceived = null;
            AmountReceivedError = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Validate numeric with up to 2 decimal places
        var pattern = @"^[0-9]+(\.[0-9]{0,2})?$";
        if (!Regex.IsMatch(currentText.Trim(), pattern))
        {
            AmountReceivedText = currentText;
            AmountReceived = null;
            AmountReceivedError = "请输入有效金额（只允许数字和最多两位小数）";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!decimal.TryParse(currentText, out var parsed))
        {
            AmountReceivedText = currentText;
            AmountReceived = null;
            AmountReceivedError = "金额格式不正确，请重试";
            await InvokeAsync(StateHasChanged);
            return;
        }

        AmountReceivedText = currentText;
        AmountReceived = parsed;
        AmountReceivedError = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnConfirmPaymentClicked()
    {
        _paymentValidationError = null;

        if (_isOutstandingPaymentMode)
        {
            if (_isPaymentMethodsLoading)
            {
                _paymentValidationError = "Payment methods are still loading.";
                Feedback.Warning(_paymentValidationError, "Payment not ready");
                return;
            }

            if (ActiveBillingPayments.Count == 0)
            {
                _paymentValidationError =
                    "Select at least one regular payment method before continuing.";
                Feedback.Warning(
                    _paymentValidationError,
                    "Payment method required");
                return;
            }

            SynchronizeBillingPaymentTotals();

            if (BillingPaidAmount < PaymentTotalPayable)
            {
                Feedback.Warning(
                    $"Add RM {(PaymentTotalPayable - BillingPaidAmount):N2} more before continuing.",
                    "Payment incomplete");
                return;
            }

            var outstandingPayments = ActiveBillingPayments
                .Where(payment => payment.Amount > 0m)
                .ToList();

            if (outstandingPayments.Count == 0 ||
                outstandingPayments.Any(payment => payment.PaymentTypeId == -10))
            {
                Feedback.Warning(
                    "Outstanding settlement requires one or more regular payment methods.",
                    "Payment method required");
                return;
            }

            if (Math.Abs(BillingPaidAmount - PaymentTotalPayable) > 0.009m)
            {
                Feedback.Warning(
                    BillingPaidAmount > PaymentTotalPayable
                        ? $"Outstanding payment exceeds the selected amount by RM {(BillingPaidAmount - PaymentTotalPayable):N2}."
                        : $"Add RM {(PaymentTotalPayable - BillingPaidAmount):N2} more before continuing.",
                    BillingPaidAmount > PaymentTotalPayable
                        ? "Payment amount too high"
                        : "Payment incomplete");
                return;
            }

            var outstandingPayment = outstandingPayments[0];
            var branchId = BranchSession.CurrentBranch?.Id?.Trim() ?? string.Empty;
            var groupId = BranchSession.CurrentBranch?.GroupId?.Trim();
            if (string.IsNullOrWhiteSpace(groupId))
            {
                groupId = branchId;
            }

            if (string.IsNullOrWhiteSpace(branchId) ||
                string.IsNullOrWhiteSpace(groupId))
            {
                Feedback.Error(
                    "The working branch/group is unavailable for Outstanding settlement.",
                    "Branch required");
                return;
            }

            _isProcessingPayment = true;
            var feedbackId = Feedback.Loading(
                "Saving Outstanding settlement...",
                "Outstanding payment");
            await InvokeAsync(StateHasChanged);

            try
            {
                Console.WriteLine(
                    $"[Outstanding Step 5] BILLING SAVE START | Customer={_billingCustomerId} | " +
                    $"Branch={branchId} | Group={groupId} | " +
                    $"Documents={_outstandingSettlementSelections.Count} | " +
                    $"Amount={PaymentTotalPayable:N2} | Methods={outstandingPayments.Count} | " +
                    $"Split={string.Join(" + ", outstandingPayments.Select(payment => $"{payment.PaymentMethod}:{payment.Amount:N2}"))}");

                var result = await OutstandingBalanceService.CreateSettlementAsync(
                    new OutstandingSettlementSaveRequestDTO
                    {
                        CustomerID = _billingCustomerId,
                        CustomerName = PatientName,
                        BranchID = branchId,
                        GroupID = groupId,
                        FinancialAccountID =
                            outstandingPayment.FinancialAccountId,
                        FinancialAccountName =
                            outstandingPayment.BankName,
                        Payments = outstandingPayments
                            .Select(payment => new OutstandingSettlementPaymentDTO
                            {
                                PaymentTypeID = payment.PaymentTypeId,
                                PaymentMethod = payment.PaymentMethod,
                                FinancialAccountID = payment.FinancialAccountId,
                                FinancialAccountName = payment.BankName,
                                Amount = payment.Amount
                            })
                            .ToList(),
                        ExpectedOutstandingAmounts = new Dictionary<string, decimal>(
                            _outstandingSettlementExpectedBalances,
                            StringComparer.OrdinalIgnoreCase),
                        SelectedAmounts = new Dictionary<string, decimal>(
                            _outstandingSettlementSelections,
                            StringComparer.OrdinalIgnoreCase)
                    });

                if (!result.Success || result.Value is null)
                {
                    _paymentValidationError =
                        result.ErrorMessage ??
                        "Unable to save Outstanding settlement.";

                    Console.WriteLine(
                        $"[Outstanding Step 9] BILLING SAVE BLOCKED / REFRESH | Customer={_billingCustomerId} | " +
                        $"Error={_paymentValidationError}");

                    var isStaleOutstanding =
                        _paymentValidationError.Contains("changed from", StringComparison.OrdinalIgnoreCase) ||
                        _paymentValidationError.Contains("no longer available", StringComparison.OrdinalIgnoreCase) ||
                        _paymentValidationError.Contains("now has only", StringComparison.OrdinalIgnoreCase) ||
                        _paymentValidationError.Contains("latest balance", StringComparison.OrdinalIgnoreCase);

                    _outstandingSettlementPayments.Clear();
                    _billingCalculatorMethod = null;
                    _billingCalculatorDigits = string.Empty;
                    _isOutstandingPaymentMode = false;
                    _billingStep = "summary";

                    await LoadCustomerBalancesAsync(_billingCustomerId);
                    _showOutstandingSettlement = true;
                    SynchronizeBillingPaymentTotals();

                    Feedback.Fail(
                        feedbackId,
                        _paymentValidationError,
                        isStaleOutstanding
                            ? "Outstanding changed — review latest balance"
                            : "Outstanding payment failed");
                    return;
                }

                var saved = result.Value;

                Console.WriteLine(
                    $"[Outstanding Step 5] BILLING SAVE COMPLETE | Id={saved.Id} | " +
                    $"DisplayCode={saved.DisplayCode} | " +
                    $"Amount={saved.TotalAllocatedAmount:N2} | " +
                    $"Documents={saved.SettledDocumentCount}");

                // Match Senang Retail: route a successful AR Receipt payment
                // to the common Payment Successful page with receipt printing.
                var paymentMethodDisplay = string.Join(
                    ", ",
                    outstandingPayments.Select(payment => payment.PaymentMethod));

                var outstandingReceipt = new Transaction
                {
                    DocumentId = saved.Id,
                    DocumentTypeId = 11,
                    AccountId = _billingCustomerId,
                    BranchId = branchId,
                    GroupId = groupId,
                    Date = DateTime.Now,
                    InvoiceNumber = saved.DisplayCode,
                    CustomerName = PatientName,
                    CustomerContact = PatientPhone == "-" ? string.Empty : PatientPhone,
                    Branch = BranchSession.CurrentBranch?.Name ?? branchId,
                    Type = "Outstanding Payment",
                    ItemCount = 1,
                    Amount = saved.TotalAllocatedAmount,
                    Subtotal = saved.TotalAllocatedAmount,
                    Tax = 0m,
                    Discount = 0m,
                    CurrencyName = "MYR",
                    PaymentMethod = paymentMethodDisplay,
                    Status = "Paid",
                    Items = new List<TransactionItem>
                    {
                        new()
                        {
                            Name = "Outstanding Payment",
                            Description = $"{saved.SettledDocumentCount} outstanding document(s)",
                            Category = "Outstanding",
                            Quantity = 1,
                            UnitPrice = saved.TotalAllocatedAmount,
                            TotalPrice = saved.TotalAllocatedAmount
                        }
                    },
                    Payments = outstandingPayments
                        .Select(payment => new TransactionPayment
                        {
                            PaymentTypeId = payment.PaymentTypeId,
                            PaymentMethod = payment.PaymentMethod,
                            Amount = payment.Amount,
                            FinancialAccountId = payment.FinancialAccountId,
                            BankName = payment.BankName
                        })
                        .ToList()
                };
                outstandingReceipt.ReceiptPayments = outstandingReceipt.Payments
                    .Select(payment => new TransactionPayment
                    {
                        PaymentTypeId = payment.PaymentTypeId,
                        PaymentMethod = payment.PaymentMethod,
                        Amount = payment.Amount,
                        FinancialAccountId = payment.FinancialAccountId,
                        BankName = payment.BankName
                    })
                    .ToList();

                AppState.LastSaleDocumentId = saved.Id;
                AppState.LastReceiptNo = saved.DisplayCode;
                AppState.LastPaidAmount = saved.TotalAllocatedAmount;
                AppState.LastPaymentMethod = paymentMethodDisplay;
                AppState.LastCompletedTransaction = outstandingReceipt;
                AppState.LastPaymentReturnUrl = PatientContext.WithCustomer("/case-notes");
                AppState.IsOutstandingPaymentMode = true;

                _outstandingSettlementSelections.Clear();
                _outstandingSettlementExpectedBalances.Clear();
                _outstandingSettlementPayments.Clear();
                _isOutstandingPaymentMode = false;
                _billingCalculatorMethod = null;
                _billingCalculatorDigits = string.Empty;
                _billingStep = "summary";
                SynchronizeBillingPaymentTotals();

                if (saved.VerificationPassed)
                {
                    Feedback.Resolve(
                        feedbackId,
                        string.IsNullOrWhiteSpace(saved.DisplayCode)
                            ? $"Outstanding payment of RM {saved.TotalAllocatedAmount:N2} completed and verified successfully."
                            : $"Outstanding payment {saved.DisplayCode} completed and verified successfully.",
                        "Outstanding payment successful");
                }
                else
                {
                    Feedback.Resolve(
                        feedbackId,
                        string.IsNullOrWhiteSpace(saved.DisplayCode)
                            ? $"Outstanding payment of RM {saved.TotalAllocatedAmount:N2} was saved."
                            : $"Outstanding payment {saved.DisplayCode} was saved.",
                        "Outstanding payment saved");

                    Feedback.Warning(
                        string.IsNullOrWhiteSpace(saved.VerificationMessage)
                            ? "The AR Receipt was saved, but the latest Outstanding balance could not be fully verified. Refresh Outstanding before taking any further action."
                            : saved.VerificationMessage,
                        "Outstanding verification pending",
                        6000);
                }

                Console.WriteLine(
                    $"[Outstanding Step 11] BILLING UI RESULT | Receipt={saved.DisplayCode} | " +
                    $"Verified={saved.VerificationPassed} | " +
                    $"CustomerOutstanding={(saved.VerifiedCustomerOutstanding.HasValue ? saved.VerifiedCustomerOutstanding.Value.ToString("N2") : "unavailable")}");

                NavigationManager.NavigateTo("/complete-sales");
            }
            catch (Exception ex)
            {
                _paymentValidationError =
                    $"Unable to confirm the Outstanding payment. {ex.Message} Refresh Outstanding before retrying.";

                Console.WriteLine(
                    $"[Outstanding] BILLING SAVE EXCEPTION | Customer={_billingCustomerId} | Error={ex}");

                Feedback.Fail(
                    feedbackId,
                    _paymentValidationError,
                    "Outstanding payment failed");
            }
            finally
            {
                _isProcessingPayment = false;
                await InvokeAsync(StateHasChanged);
            }

            return;
        }

        if (IsAppointmentPaymentLocked)
        {
            _paymentValidationError = "This appointment has already been paid.";
            Feedback.Info(
                "This appointment has already been paid. Another payment cannot be created.",
                "Appointment paid",
                3200);
            return;
        }

        if (_isPaymentMethodsLoading && !CanCompleteBillingWithoutTender)
        {
            _paymentValidationError = "Payment methods are still loading.";
            Feedback.Warning(_paymentValidationError, "Payment not ready");
            return;
        }

        if (BillingPayments.Count == 0 && !CanCompleteBillingWithoutTender)
        {
            _paymentValidationError = "Select a payment method and enter an amount before confirming.";
            Feedback.Warning(_paymentValidationError, "Payment method required");
            return;
        }

        SynchronizeBillingPaymentTotals();

        if (HasBillingPointRedemption &&
            BillingPayments.Any(payment => payment.PaymentTypeId == -10))
        {
            BillingPayments.RemoveAll(payment => payment.PaymentTypeId == -10);
            SynchronizeBillingPaymentTotals();

            Console.WriteLine(
                $"[Point Step 8] BLOCKED | Source=Billing | Customer={_billingCustomerId} | " +
                $"Reason=StaleMemberCreditTenderRemoved");

            Feedback.Warning(
                "Member Credit cannot be combined with point redemption. The Member Credit payment was removed.",
                "Payment method not allowed");
            return;
        }

        if (BillingPaidAmount < BillingAmountDue)
        {
            _showInsufficientAmountModal = true;
            Feedback.Warning(
                $"Add RM {(BillingAmountDue - BillingPaidAmount):N2} more before completing the sale.",
                "Payment incomplete");
            return;
        }

        if (PrescriptionItems.Count == 0 && ServiceItems.Count == 0 && MemberCreditItems.Count == 0 && BillingPackageItems.Count == 0)
        {
            _paymentValidationError = "Add at least one billing item, service, or Member Credit before payment.";
            Feedback.Warning(_paymentValidationError, "Billing is empty");
            return;
        }

        _showConfirmPaymentModal = true;
    }

