    private async Task OnSplitAmountInput(PaymentSplit split, ChangeEventArgs args)
    {
        var text = args.Value?.ToString() ?? string.Empty;
        split.AmountText = text;
        split.Amount = null;

        if (string.IsNullOrWhiteSpace(text))
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var trimmed = text.Trim();
        var pattern = @"^[0-9]+(\.[0-9]{0,2})?$";
        if (!Regex.IsMatch(trimmed, pattern))
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (decimal.TryParse(trimmed, out var parsed))
        {
            split.Amount = parsed;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void TogglePaymentGroup(PaymentMethodGroup group)
    {
        var index = PaymentMethodGroups.FindIndex(g => g.Key == group.Key);
        if (index < 0)
        {
            group.IsExpanded = !group.IsExpanded;
            return;
        }

        var newState = !PaymentMethodGroups[index].IsExpanded;
        var rowStart = (index / 2) * 2;
        var rowEnd = Math.Min(rowStart + 1, PaymentMethodGroups.Count - 1);

        for (var i = rowStart; i <= rowEnd; i++)
        {
            PaymentMethodGroups[i].IsExpanded = newState;
        }
    }

