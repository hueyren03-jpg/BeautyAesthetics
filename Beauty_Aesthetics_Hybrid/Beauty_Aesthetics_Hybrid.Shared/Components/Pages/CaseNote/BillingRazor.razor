    private async Task ConfirmOutstandingSelection(
        IReadOnlyDictionary<string, decimal> selections)
    {
        var selectedTotal = Math.Round(
            selections.Values.Sum(),
            2,
            MidpointRounding.AwayFromZero);

        if (selectedTotal <= 0m)
        {
            Feedback.Warning(
                "Select at least one outstanding document and settlement amount.",
                "Outstanding required");
            return;
        }

        _outstandingSettlementSelections = new Dictionary<string, decimal>(
            selections,
            StringComparer.OrdinalIgnoreCase);
        _outstandingSettlementExpectedBalances = new Dictionary<string, decimal>(
            StringComparer.OrdinalIgnoreCase);

        foreach (var document in _outstandingDocuments)
        {
            var key = BillingOutstandingDocumentSelectionKey(document);
            if (selections.ContainsKey(key))
            {
                _outstandingSettlementExpectedBalances[key] = Math.Round(
                    Math.Max(0m, document.RemainingAmount),
                    2,
                    MidpointRounding.AwayFromZero);
            }
        }

        Console.WriteLine(
            $"[Outstanding Step 9] BILLING SNAPSHOT | Customer={_billingCustomerId} | " +
            $"Documents={_outstandingSettlementExpectedBalances.Count} | " +
            $"Balances={string.Join(", ", _outstandingSettlementExpectedBalances.Select(pair => $"{pair.Key}:{pair.Value:N2}"))}");

        _outstandingSettlementPayments.Clear();
        _billingCalculatorMethod = null;
        _billingCalculatorDigits = string.Empty;
        _isOutstandingPaymentMode = true;

        await LoadPaymentMethodsAsync();

        if (!VisibleBillingPaymentMethods.Any())
        {
            _isOutstandingPaymentMode = false;
            Feedback.Error(
                "No regular payment methods are available for Outstanding settlement.",
                "Payment method unavailable");
            return;
        }

        _showOutstandingSettlement = false;
        _billingStep = "payment";
        _isPaymentMethodDropdownOpen = false;
        _isCollectorDropdownOpen = false;
        _isPatientDrawerOpen = false;
        SynchronizeBillingPaymentTotals();

        Console.WriteLine(
            $"[Outstanding Step 4] BILLING PAYMENT MODE | Customer={_billingCustomerId} | " +
            $"Documents={_outstandingSettlementSelections.Count} | Amount={selectedTotal:N2} | " +
            $"RegularMethods={VisibleBillingPaymentMethods.Count()} | MemberCreditExcluded=True");

        Feedback.Info(
            $"RM {selectedTotal:N2} selected. Choose one or more payment methods.",
            "Outstanding payment",
            2800);

        await InvokeAsync(StateHasChanged);
    }

