    private async Task LoadCustomerBalancesAsync(string? customerId)
    {
        CustomerOutstandingBalance = null;
        _outstandingDocuments.Clear();
        _outstandingDocumentsError = null;
        _isOutstandingDocumentsLoading = false;
        _showOutstandingSettlement = false;
        _outstandingSettlementSelections.Clear();
        CustomerPointBalance = null;
        CustomerPackageBalance = null;
        CustomerCreditBalance = null;
        _redeemableCredits.Clear();
        _redeemableCreditsError = null;

        if (string.IsNullOrWhiteSpace(customerId))
        {
            return;
        }

        _isCustomerBalanceLoading = true;
        try
        {
            var workingBranchId = AppState.SelectedBranchID?.Trim() ?? string.Empty;
            var workingGroupId = AppState.CurrentBranch?.GroupId?.Trim();
            if (string.IsNullOrWhiteSpace(workingGroupId))
            {
                workingGroupId = workingBranchId;
            }

            var memberBalanceTask = CustomerService.GetBalanceSummaryAsync(customerId);
            var otherBalanceTask = OutstandingBalanceService.LoadSummaryAsync(
                customerId,
                DateTime.UtcNow);
            var outstandingDocumentsTask = OutstandingBalanceService.LoadDocumentsAsync(
                customerId,
                workingGroupId ?? string.Empty);
            var redeemableCreditTask = MemberCreditWalletService.LoadWalletAsync(
                customerId,
                DateTime.Today,
                AppState.SelectedBranchID,
                AppState.CurrentBranch?.GroupId);

            await Task.WhenAll(
                memberBalanceTask,
                otherBalanceTask,
                outstandingDocumentsTask,
                redeemableCreditTask);

            var memberBalance = await memberBalanceTask;
            var otherBalance = await otherBalanceTask;
            var detailedOutstanding = await outstandingDocumentsTask;
            var redeemableCredit = await redeemableCreditTask;

            if (memberBalance.Success && memberBalance.Value is not null)
            {
                CustomerPointBalance = memberBalance.Value.PointBalance;
                CustomerPackageBalance = memberBalance.Value.PackageBalance;
                CustomerCreditBalance = memberBalance.Value.CreditBalance;
            }

            if (otherBalance.Success && otherBalance.Value is not null)
            {
                CustomerOutstandingBalance = otherBalance.Value.Outstanding;
            }

            if (detailedOutstanding.Success && detailedOutstanding.Value is not null)
            {
                _outstandingDocuments = detailedOutstanding.Value.ToList();
                _outstandingDocumentsError = null;
            }
            else
            {
                _outstandingDocuments.Clear();
                _outstandingDocumentsError =
                    detailedOutstanding.ErrorMessage ??
                    "Outstanding documents are unavailable.";

                Console.WriteLine(
                    $"[Outstanding Step 2] DETAIL LOAD FAILED | " +
                    $"Customer={customerId} | Error={_outstandingDocumentsError}");
            }

            if (redeemableCredit.Success && redeemableCredit.Value is not null)
            {
                _redeemableCredits = redeemableCredit.Value.Accounts.ToList();
                CustomerCreditBalance = redeemableCredit.Value.TotalAvailable;
                _redeemableCreditsError = null;
            }
            else
            {
                _redeemableCredits.Clear();
                CustomerCreditBalance = null;
                _redeemableCreditsError =
                    redeemableCredit.ErrorMessage ??
                    "Redeemable Member Credit accounts are unavailable.";
            }

            if (!memberBalance.Success && !otherBalance.Success)
            {
                Feedback.Error(
                    memberBalance.ErrorMessage
                    ?? otherBalance.ErrorMessage
                    ?? "Unable to load customer balances.",
                    "Balances not loaded");
            }
            else if (!memberBalance.Success)
            {
                Feedback.Warning(
                    memberBalance.ErrorMessage ?? "Point, package and credit balances are unavailable.",
                    "Some balances unavailable");
            }
            else if (!otherBalance.Success)
            {
                Feedback.Warning(
                    otherBalance.ErrorMessage ?? "Outstanding balance is unavailable.",
                    "Some balances unavailable");
            }
        }
        finally
        {
            _isCustomerBalanceLoading = false;
        }
    }

    private async Task OpenOutstandingSettlementAsync()
    {
        if (string.IsNullOrWhiteSpace(_billingCustomerId))
        {
            Feedback.Warning(
                "Select a valid customer before viewing outstanding documents.",
                "Customer required");
            return;
        }

        _showOutstandingSettlement = true;
        await ReloadOutstandingDocumentsAsync();
    }

    private async Task ReloadOutstandingDocumentsAsync()
    {
        var customerId = _billingCustomerId?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(customerId))
        {
            return;
        }

        var workingBranchId = AppState.SelectedBranchID?.Trim() ?? string.Empty;
        var workingGroupId = AppState.CurrentBranch?.GroupId?.Trim();
        if (string.IsNullOrWhiteSpace(workingGroupId))
        {
            workingGroupId = workingBranchId;
        }

        _isOutstandingDocumentsLoading = true;
        _outstandingDocumentsError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await OutstandingBalanceService.LoadDocumentsAsync(
                customerId,
                workingGroupId ?? string.Empty);

            if (!string.Equals(
                    customerId,
                    _billingCustomerId,
                    StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            if (!result.Success || result.Value is null)
            {
                _outstandingDocuments.Clear();
                _outstandingDocumentsError =
                    result.ErrorMessage ??
                    "Unable to load outstanding documents.";
                return;
            }

            _outstandingDocuments = result.Value.ToList();
        }
        catch (Exception ex)
        {
            if (string.Equals(
                    customerId,
                    _billingCustomerId,
                    StringComparison.OrdinalIgnoreCase))
            {
                _outstandingDocuments.Clear();
                _outstandingDocumentsError =
                    $"Unable to load outstanding documents: {ex.Message}";
            }
        }
        finally
        {
            if (string.Equals(
                    customerId,
                    _billingCustomerId,
                    StringComparison.OrdinalIgnoreCase))
            {
                _isOutstandingDocumentsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

