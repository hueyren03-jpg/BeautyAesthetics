    private async Task LoadProductCatalogAsync()
    {
        _isProductCatalogLoading = true;
        _productCatalogError = null;
        try
        {
            var branchId = string.IsNullOrWhiteSpace(AppState.SelectedBranchID) ? "HQ" : AppState.SelectedBranchID!;
            var result = await ProductInventoryService.LoadProductsAsync(branchId);
            if (!result.Success || result.Value is null)
            {
                PrescriptionViewModel.ReplaceDrugs([]);
                _productCatalogError = result.ErrorMessage ?? "Unable to load inventory items.";
                return;
            }

            var products = result.Value
                .Where(product => product.IsActive)
                .OrderBy(product => product.Type)
                .Select((product, index) => new CaseNotePrescriptionViewModel.Drug(
                    index + 1,
                    product.Type,
                    product.Sku,
                    product.Category,
                    product.Remarks,
                    string.Empty,
                    product.ConversionFactor,
                    product.MasterAccountId,
                    product.Price,
                    product.StockQuantity,
                    product.IsActive,
                    product.ImagePath,
                    product.ImageFileName,
                    product.TaxCode,
                    product.IsTaxInclusive))
                .ToList();

            PrescriptionViewModel.ReplaceDrugs(products);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load billing inventory catalog: {ex.Message}");
            PrescriptionViewModel.ReplaceDrugs([]);
            _productCatalogError = "Unable to load inventory items.";
        }
        finally
        {
            _isProductCatalogLoading = false;
        }
    }

    private async Task LoadServiceCatalogAsync()
    {
        _isServiceCatalogLoading = true;
        _serviceCatalogError = null;
        try
        {
            var branchId = string.IsNullOrWhiteSpace(AppState.SelectedBranchID) ? "HQ" : AppState.SelectedBranchID!;
            var result = await ServiceItemService.LoadServiceItemsAsync(branchId);
            if (!result.Success || result.Value is null)
            {
                ServiceCatalog = new List<ServiceViewModel.ServiceItem>();
                _serviceCatalogError = result.ErrorMessage ?? "Unable to load services.";
                return;
            }

            ServiceCatalog = result.Value
                .Where(service => service.IsActive &&
                                  !string.Equals(service.Status, "Inactive", StringComparison.OrdinalIgnoreCase))
                .OrderBy(service => service.ServiceName)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load billing service catalog: {ex.Message}");
            ServiceCatalog = new List<ServiceViewModel.ServiceItem>();
            _serviceCatalogError = "Unable to load services.";
        }
        finally
        {
            _isServiceCatalogLoading = false;
        }
    }

    private async Task LoadMemberCreditCatalogAsync()
    {
        _isMemberCreditCatalogLoading = true;
        _memberCreditCatalogError = null;

        try
        {
            var branchId = string.IsNullOrWhiteSpace(AppState.SelectedBranchID) ? "HQ" : AppState.SelectedBranchID!;
            var result = await MemberCreditService.LoadMemberCreditsAsync(branchId);
            if (!result.Success || result.Value is null)
            {
                MemberCreditCatalog = new List<MembershipViewModel.MemberCredit>();
                _memberCreditCatalogError = result.ErrorMessage ?? "Unable to load member credit.";
                return;
            }

            // Match Senang Retail checkout: the branch-scoped Inventory/LoadProxy response
            // is the purchase catalog. Do not full-load/filter every Top Up before display.
            MemberCreditCatalog = result.Value
                .Where(item => !string.IsNullOrWhiteSpace(item.MasterAccountId))
                .OrderBy(item => item.Name)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load billing member credit catalog: {ex.Message}");
            MemberCreditCatalog = new List<MembershipViewModel.MemberCredit>();
            _memberCreditCatalogError = "Unable to load member credit.";
        }
        finally
        {
            _isMemberCreditCatalogLoading = false;
        }
    }

