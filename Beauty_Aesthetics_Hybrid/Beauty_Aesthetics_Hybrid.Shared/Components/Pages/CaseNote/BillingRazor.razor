    private async Task HandleAmountInputDebounced(ChangeEventArgs args)
    {
        // Cancel any pending debounce operation
        _amountInputCts?.Cancel();
        _amountInputCts?.Dispose();

        var cts = new CancellationTokenSource();
        _amountInputCts = cts;
        var token = cts.Token;
        var currentText = args.Value?.ToString() ?? string.Empty;

        try
        {
            // Simple debounce to avoid excessive parsing while typing
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        // Empty input: clear amount & error
        if (string.IsNullOrWhiteSpace(currentText))
        {
            AmountReceivedText = string.Empty;
            AmountReceived = null;
            AmountReceivedError = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Validate numeric with up to 2 decimal places
        var pattern = @"^[0-9]+(\.[0-9]{0,2})?$";
        if (!Regex.IsMatch(currentText.Trim(), pattern))
        {
            AmountReceivedText = currentText;
            AmountReceived = null;
            AmountReceivedError = "请输入有效金额（只允许数字和最多两位小数）";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!decimal.TryParse(currentText, out var parsed))
        {
            AmountReceivedText = currentText;
            AmountReceived = null;
            AmountReceivedError = "金额格式不正确，请重试";
            await InvokeAsync(StateHasChanged);
            return;
        }

        AmountReceivedText = currentText;
        AmountReceived = parsed;
        AmountReceivedError = null;
        await InvokeAsync(StateHasChanged);
    }

    private void OnConfirmPaymentClicked()
    {
        _paymentValidationError = null;

        if (IsAppointmentPaymentLocked)
        {
            _paymentValidationError = "This appointment has already been paid.";
            Feedback.Info(
                "This appointment has already been paid. Another payment cannot be created.",
                "Appointment paid",
                3200);
            return;
        }

        if (_isPaymentMethodsLoading)
        {
            _paymentValidationError = "Payment methods are still loading.";
            Feedback.Warning(_paymentValidationError, "Payment not ready");
            return;
        }

        if (BillingPayments.Count == 0)
        {
            _paymentValidationError = "Select a payment method and enter an amount before confirming.";
            Feedback.Warning(_paymentValidationError, "Payment method required");
            return;
        }

        SynchronizeBillingPaymentTotals();

        if (BillingPaidAmount < TotalPayable)
        {
            _showInsufficientAmountModal = true;
            Feedback.Warning(
                $"Add RM {(TotalPayable - BillingPaidAmount):N2} more before completing the sale.",
                "Payment incomplete");
            return;
        }

        if (PrescriptionItems.Count == 0 && ServiceItems.Count == 0 && MemberCreditItems.Count == 0)
        {
            _paymentValidationError = "Add at least one billing item, service, or Member Credit before payment.";
            Feedback.Warning(_paymentValidationError, "Billing is empty");
            return;
        }

        _showConfirmPaymentModal = true;
    }

