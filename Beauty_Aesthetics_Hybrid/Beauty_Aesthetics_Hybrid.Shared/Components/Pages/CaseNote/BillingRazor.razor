    private async Task SendInvoiceEmailAsync()
    {
        _postPaymentEmailError = null;

        if (string.IsNullOrWhiteSpace(_postPaymentEmail))
        {
            _postPaymentEmailError = "Please enter an email address.";
            Feedback.Warning(_postPaymentEmailError, "Invoice not emailed");
            return;
        }

        if (!IsValidEmail(_postPaymentEmail))
        {
            _postPaymentEmailError = "Please enter a valid email address.";
