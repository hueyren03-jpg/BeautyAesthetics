    private void AppendPrescriptionToBilling(CaseNotePrescriptionViewModel.Prescription prescription)
    {
        foreach (var drug in prescription.Drugs)
        {
            var qty = (int)Math.Max(1, Math.Round(drug.Quantity));
            var existing = PrescriptionItems.FirstOrDefault(i => i.Name.Equals(drug.Drug.Name, StringComparison.OrdinalIgnoreCase));

            if (existing != null)
            {
                var index = PrescriptionItems.IndexOf(existing);
                PrescriptionItems[index] = existing with { Quantity = existing.Quantity + qty };
            }
            else
            {
                PrescriptionItems.Add(new BillingItem(drug.Drug.Name, qty, 0m, 0m));
            }
        }
    }

    private void SubmitPrescriptionToState(string prescriptionNumber)
    {
        var saved = PrescriptionViewModel.Prescriptions.LastOrDefault(p => p.PrescriptionNumber == prescriptionNumber);
        if (saved != null)
        {
            AppendPrescriptionToBilling(saved);
        }
    }

    private async Task SubmitPrescriptionFromModal()
    {
        if (!PrescriptionViewModel.SelectedDrugs.Any())
        {
            _prescriptionStatusMessage = "Add at least one drug before saving.";
            _prescriptionStatusIsSuccess = false;
            return;
        }

        var prescriptionNumber = PrescriptionViewModel.SubmitPrescription();

        if (prescriptionNumber.StartsWith("Error", StringComparison.OrdinalIgnoreCase))
        {
            _prescriptionStatusMessage = prescriptionNumber;
            _prescriptionStatusIsSuccess = false;
            return;
        }

        SubmitPrescriptionToState(prescriptionNumber);
        _prescriptionStatusMessage = $"Prescription {prescriptionNumber} saved.";
        _prescriptionStatusIsSuccess = true;

        await Task.Delay(500);
        ClosePrescriptionModal();
        StateHasChanged();
    }

