    private bool HasBillingPointRedemption =>
        PrescriptionItems.Any(item => item.Points > 0m) ||
        ServiceItems.Any(item => item.Points > 0m);

    private bool IsFullyPointRedeemedBillingSale =>
        !_isOutstandingPaymentMode &&
        HasBillingPointRedemption &&
        TotalPayable <= 0.009m;

    private decimal BillingPointsAllocated(object? except = null) =>
        Math.Round(
            PrescriptionItems
                .Where(item => !ReferenceEquals(item, except) && item.Points > 0m)
                .Sum(item => item.Points) +
            ServiceItems
                .Where(item => !ReferenceEquals(item, except) && item.Points > 0m)
                .Sum(item => item.Points),
            2,
            MidpointRounding.AwayFromZero);

    private static decimal RequiredBillingPointsFor(BillingItem item) =>
        Math.Round(
            Math.Max(0m, item.PointToRedeem) * Math.Max(1, item.Quantity),
            2,
            MidpointRounding.AwayFromZero);

    private static decimal RequiredBillingPointsFor(BillingService item) =>
        Math.Round(
            Math.Max(0m, item.PointToRedeem) * Math.Max(1, item.Quantity),
            2,
            MidpointRounding.AwayFromZero);

    private async Task<bool> RevalidateBillingPointRedemptionsAsync(bool showFeedback = true)
    {
        var pointProducts = PrescriptionItems
            .Where(item => item.Points > 0m)
            .ToList();
        var pointServices = ServiceItems
            .Where(item => item.Points > 0m)
            .ToList();

        if (pointProducts.Count == 0 && pointServices.Count == 0)
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(_billingCustomerId))
        {
            if (showFeedback)
            {
                Feedback.Warning("Select a valid customer before using points.", "Customer required");
            }
            return false;
        }

        foreach (var item in pointProducts)
        {
            if (!item.AllowPointRedemption ||
                item.PointToRedeem <= 0m ||
                Math.Abs(RequiredBillingPointsFor(item) - item.Points) > 0.009m ||
                Math.Abs(item.UnitPrice) > 0.009m ||
                Math.Abs(item.Discount) > 0.009m ||
                Math.Abs(item.LineTaxAmount) > 0.009m)
            {
                if (showFeedback)
                {
                    Feedback.Warning(
                        $"{item.Name} has an invalid point-redemption state. Remove and apply points again.",
                        "Points need updating");
                }
                return false;
            }
        }

        foreach (var item in pointServices)
        {
            if (!item.AllowPointRedemption ||
                item.PointToRedeem <= 0m ||
                Math.Abs(RequiredBillingPointsFor(item) - item.Points) > 0.009m ||
                Math.Abs(item.UnitPrice) > 0.009m ||
                Math.Abs(item.Discount) > 0.009m ||
                Math.Abs(item.LineTaxAmount) > 0.009m)
            {
                if (showFeedback)
                {
                    Feedback.Warning(
                        $"{item.Name} has an invalid point-redemption state. Remove and apply points again.",
                        "Points need updating");
                }
                return false;
            }
        }

        var balanceResult = await CustomerService.GetBalanceSummaryAsync(_billingCustomerId);
        if (!balanceResult.Success || balanceResult.Value is null)
        {
            if (showFeedback)
            {
                Feedback.Error(
                    balanceResult.ErrorMessage ?? "Unable to recheck the latest point balance.",
                    "Point balance unavailable");
            }
            return false;
        }

        CustomerPointBalance = balanceResult.Value.PointBalance;

        var totalRequired = Math.Round(
            pointProducts.Sum(item => Math.Max(0m, item.Points)) +
            pointServices.Sum(item => Math.Max(0m, item.Points)),
            2,
            MidpointRounding.AwayFromZero);
        var latestBalance = Math.Max(0m, balanceResult.Value.PointBalance);

        Console.WriteLine(
            $"[Point Step 10] FINAL REVALIDATION | Source=Billing | Customer={_billingCustomerId} | " +
            $"LatestBalance={latestBalance:0.##} | Required={totalRequired:0.##} | " +
            $"Lines={pointProducts.Count + pointServices.Count}");

        if (totalRequired - latestBalance > 0.009m)
        {
            Console.WriteLine(
                $"[Point Step 10] BLOCKED | Source=Billing | Customer={_billingCustomerId} | " +
                $"LatestBalance={latestBalance:0.##} | Required={totalRequired:0.##}");

            if (showFeedback)
            {
                Feedback.Warning(
                    $"The latest point balance is {latestBalance:0.##} pts, but this bill requires {totalRequired:0.##} pts. Remove or adjust point redemption before continuing.",
                    "Point balance changed");
            }
            return false;
        }

        Console.WriteLine(
            $"[Point Step 10] PASS | Source=Billing | Customer={_billingCustomerId} | " +
            $"LatestBalance={latestBalance:0.##} | Required={totalRequired:0.##} | " +
            $"RemainingAfterSave={Math.Max(0m, latestBalance - totalRequired):0.##}");

        return true;
    }

