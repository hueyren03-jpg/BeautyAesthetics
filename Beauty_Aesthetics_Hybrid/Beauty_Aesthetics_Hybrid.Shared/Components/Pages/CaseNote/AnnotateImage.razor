    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            
            // Validate file type
            if (!file.ContentType.StartsWith("image/"))
            {
                SetAnnotationError("Please select an image file");
                return;
            }
            
            // Limit file size to 5MB
            const int maxFileSize = 5 * 1024 * 1024;
            if (file.Size > maxFileSize)
            {
                SetAnnotationError("Image size must be less than 5MB");
                return;
            }
            
            // Read the file as base64
            using var stream = file.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var dataUrl = $"data:{file.ContentType};base64,{base64}";
            
            // If in before-after mode and configuring a side, set that side's image
            if (ViewModel.CanvasBackground == "before-after" && _configuringSide != null)
            {
                var imageName = Path.GetFileNameWithoutExtension(file.Name);
                var newImage = new AnnotateImageViewModel.AnnotationImage(imageName, "Uploaded", dataUrl, dataUrl);
                
                if (_configuringSide == "before")
                {
                    ViewModel.SetBeforeImage(newImage);
                }
                else if (_configuringSide == "after")
                {
                    ViewModel.SetAfterImage(newImage);
                }
                
                _configuringSide = null;
                Feedback.Success($"{imageName} uploaded to the comparison.", "Image uploaded", 2200);
                StateHasChanged();
                Console.WriteLine($"Image uploaded: {imageName}, size: {file.Size / 1024} KB");
                return;
            }
            
            // Add image to the list (standard mode)
            var imageName2 = Path.GetFileNameWithoutExtension(file.Name);
            ViewModel.AddImage(imageName2, "Uploaded", dataUrl, dataUrl);
            Feedback.Success($"{imageName2} uploaded to the annotation library.", "Image uploaded", 2200);
            
            // Close modal and select the new image
            await CloseAddImageModal();
            var newImage2 = ViewModel.Images.First();
            ViewModel.SelectImage(newImage2);
            StateHasChanged();
            
            Console.WriteLine($"Image uploaded: {imageName2}, size: {file.Size / 1024} KB");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading image: {ex.Message}");
            SetAnnotationError($"Failed to upload image: {ex.Message}");
        }
    }
    
