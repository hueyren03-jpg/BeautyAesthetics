    private async Task StartCamera()
    {
        try
        {
            // Wait a bit for DOM to be ready
            await Task.Delay(200);
            
            // Check if camera functions exist and load script if needed
            var hasStartCamera = await JS.InvokeAsync<bool>("eval", "typeof startCamera !== 'undefined'");
            if (!hasStartCamera)
            {
                // Load script if not loaded
                await JS.InvokeVoidAsync("eval", @"
                    if (!window.cameraScriptLoaded) {
                        return new Promise((resolve) => {
                            const script = document.createElement('script');
                            script.src = '_content/Beauty_Aesthetics_Hybrid.Shared/js/camera-capture.js';
                            script.onload = () => { 
                                window.cameraScriptLoaded = true; 
                                resolve(true);
                            };
                            script.onerror = () => { 
                                console.error('Failed to load camera script');
                                resolve(false);
                            };
                            document.body.appendChild(script);
                        });
                    } else {
                        return true;
                    }
                ");
                
                // Wait a bit more and verify
                await Task.Delay(300);
                hasStartCamera = await JS.InvokeAsync<bool>("eval", "typeof startCamera !== 'undefined'");
                if (!hasStartCamera)
                {
                    throw new Exception("Camera script failed to load");
                }
            }
            
            await JS.InvokeVoidAsync("startCamera");
            _isCameraActive = true;
            Feedback.Success("Camera is ready.", "Camera started", 1800);
            Console.WriteLine("Camera started successfully");
        }
        catch (JSException jsEx)
        {
            Console.WriteLine($"JavaScript error starting camera: {jsEx.Message}");
            SetAnnotationError("Failed to access camera. Please ensure camera permissions are granted and try again.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting camera: {ex.Message}");
            SetAnnotationError($"Failed to access camera: {ex.Message}");
        }
    }
    
