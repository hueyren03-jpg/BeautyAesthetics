    private async Task UpdateJavaScriptStateAsync()
    {
        const int maxRetries = 3;
        const int retryDelayMs = 100;
        
        Console.WriteLine("Starting JavaScript state synchronization...");
        
        for (int attempt = 0; attempt < maxRetries; attempt++)
        {
            try
            {
                Console.WriteLine($"State sync attempt {attempt + 1}/{maxRetries}");
                
                // Check if canvas is ready before invoking JS functions
                var isReady = await JS.InvokeAsync<bool>("isCanvasReady");
                
                if (!isReady)
                {
                    // Canvas not ready, wait and retry
                    Console.WriteLine($"Canvas not ready on attempt {attempt + 1}, waiting...");
                    
                    if (attempt < maxRetries - 1)
                    {
                        await Task.Delay(retryDelayMs * (attempt + 1)); // Exponential backoff
                        continue;
                    }
                    else
                    {
                        // Max retries reached, canvas still not ready
                        Console.WriteLine("Canvas not ready after maximum retries");
                        Console.Error.WriteLine("[ERROR] State synchronization failed - Canvas not ready after retries");
                        
                        // Graceful degradation - don't show error to user, just log
                        return;
                    }
                }
                
                Console.WriteLine("Canvas ready, updating state...");
                
                // Canvas is ready, update all state synchronously
                await JS.InvokeVoidAsync("setAnnotationTool", ViewModel.ActiveTool);
                await JS.InvokeVoidAsync("setAnnotationColor", ViewModel.SelectedColor);
                await JS.InvokeVoidAsync("setAnnotationThickness", ViewModel.LineThickness);
                await JS.InvokeVoidAsync("setAnnotationFontSize", ViewModel.FontSize);
                await JS.InvokeVoidAsync("setAnnotationBold", ViewModel.IsBold);
                await JS.InvokeVoidAsync("setAnnotationItalic", ViewModel.IsItalic);
                await JS.InvokeVoidAsync("setAnnotationUnderline", ViewModel.IsUnderline);
                
                Console.WriteLine("JavaScript state synchronized successfully");
                
                // Success, exit retry loop
                return;
            }
            catch (JSException jsEx)
            {
                // JavaScript error occurred
                Console.WriteLine($"JavaScript error during state update (attempt {attempt + 1}/{maxRetries}): {jsEx.Message}");
                Console.Error.WriteLine($"[ERROR] State sync attempt {attempt + 1} failed - JSException: {jsEx.Message}");
                
                if (attempt < maxRetries - 1)
                {
                    await Task.Delay(retryDelayMs * (attempt + 1)); // Exponential backoff
                }
                else
                {
                    // Max retries reached, log final error
                    Console.WriteLine($"Failed to update JavaScript state after {maxRetries} attempts: {jsEx.Message}");
                    Console.Error.WriteLine($"[ERROR] State synchronization failed after {maxRetries} attempts - JSException: {jsEx.Message}");
                    
                    // Graceful degradation - state is maintained in ViewModel
                    // Don't show error to user as this is non-critical
                }
            }
            catch (InvalidOperationException invOpEx)
            {
                // JavaScript runtime not available or function not found
                Console.WriteLine($"JavaScript function not available (attempt {attempt + 1}/{maxRetries}): {invOpEx.Message}");
                Console.Error.WriteLine($"[ERROR] State sync attempt {attempt + 1} failed - Function not available: {invOpEx.Message}");
                
                if (attempt < maxRetries - 1)
                {
                    await Task.Delay(retryDelayMs * (attempt + 1)); // Exponential backoff
                }
                else
                {
                    // Max retries reached
                    Console.WriteLine($"JavaScript functions not available after {maxRetries} attempts");
                    Console.Error.WriteLine($"[ERROR] State synchronization failed - Functions not available after {maxRetries} attempts");
                    
                    // Graceful degradation
                }
            }
            catch (Exception ex)
            {
                // Unexpected error
                Console.WriteLine($"Unexpected error during state update: {ex.GetType().Name} - {ex.Message}");
                Console.Error.WriteLine($"[ERROR] State synchronization failed - Unexpected error: {ex.GetType().Name} - {ex.Message}");
                
                // Don't retry on unexpected errors
                return;
            }
        }
    }

