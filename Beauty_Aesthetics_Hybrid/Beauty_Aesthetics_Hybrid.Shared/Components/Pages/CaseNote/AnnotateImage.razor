    private async Task ResetCapture()
    {
        // Store previous state to trigger OnAfterRender video restoration
        _previousCapturedImageDataUrl = _capturedImageDataUrl;
        
        // Clear captured image first
        _capturedImageDataUrl = null;
        _flipHorizontal = false;
        _flipVertical = false;
        
        // Force state update to switch UI back to video view
        StateHasChanged();
        
        // Wait longer for Blazor to re-render the video element
        await Task.Delay(350);
        
        // Reset camera to restore video feed
        try
        {
            // First verify and restore video stream
            var videoRestored = await JS.InvokeAsync<bool>("eval", @"
                (function() {
                    const video = document.getElementById('cameraVideo');
                    if (!video) {
                        return false;
                    }
                    
                    // Make absolutely sure video is visible
                    video.style.display = 'block';
                    video.style.visibility = 'visible';
                    video.style.opacity = '1';
                    video.style.width = '100%';
                    video.style.height = '100%';
                    
                    // Check if video has a stream
                    if (!video.srcObject) {
                        return false;
                    }
                    
                    const stream = video.srcObject;
                    const tracks = stream.getTracks();
                    const hasActiveTrack = tracks.some(track => track.readyState === 'live' && track.enabled);
                    
                    if (!hasActiveTrack) {
                        return false;
                    }
                    
                    // Try to play the video
                    if (video.paused) {
                        const playPromise = video.play();
                        if (playPromise) {
                            playPromise.catch(err => {
                                console.warn('Play error:', err);
                            });
                        }
                    }
                    
                    // Check if video has dimensions (means it's receiving data)
                    if (video.videoWidth > 0 && video.videoHeight > 0) {
                        return true;
                    }
                    
                    // Wait a bit more for video to have dimensions
                    // Return a promise that will be awaited properly
                    return new Promise((resolve) => {
                        let attempts = 0;
                        const checkDimensions = () => {
                            if (video.videoWidth > 0 && video.videoHeight > 0) {
                                resolve(true);
                            } else if (attempts < 20) {
                                attempts++;
                                setTimeout(checkDimensions, 50);
                            } else {
                                resolve(false);
                            }
                        };
                        checkDimensions();
                    });
                })();
            ");
            
            // If video wasn't restored, restart camera completely
            if (!videoRestored)
            {
                Console.WriteLine("Video not restored, restarting camera...");
                if (_isCameraActive)
                {
                    // Stop current camera first
                    await StopCamera();
                    await Task.Delay(200);
                }
                // Restart camera
                await StartCamera();
            }
            else
            {
                // Call resetCamera to reset flip states
                await JS.InvokeVoidAsync("resetCamera");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resetting camera: {ex.Message}");
            // If reset fails, try to restart camera
            if (_isCameraActive)
            {
                await StopCamera();
                await Task.Delay(200);
                await StartCamera();
            }
        }
    }
    
