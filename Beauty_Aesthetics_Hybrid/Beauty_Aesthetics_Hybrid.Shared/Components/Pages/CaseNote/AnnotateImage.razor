    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load camera capture script
            await JS.InvokeVoidAsync("eval", @"
                if (!document.querySelector('script[src=""_content/Beauty_Aesthetics_Hybrid.Shared/js/camera-capture.js""]')) {
                    const script = document.createElement('script');
                    script.src = '_content/Beauty_Aesthetics_Hybrid.Shared/js/camera-capture.js';
                    script.async = true;
                    document.body.appendChild(script);
                }
            ");
            
            // Create reference to this component for JavaScript callbacks
            _dotNetRef = DotNetObjectReference.Create(this);
            
            // Set up listener for text formatting changes from JavaScript
            await JS.InvokeVoidAsync("setupTextFormattingListener", _dotNetRef);
            
            // Initialize the resizer functionality (Fabric.js is in external file)
            await InitializeResizerAsync();
        }
        
        // Initialize camera when camera view is shown
        if (_showCameraCapture && _showAddImageModal && !_isCameraActive)
        {
            await Task.Delay(300); // Wait for DOM elements to be rendered
            await StartCamera();
        }
        
        // Ensure video plays when UI switches back from captured image to live feed (after Retake)
        if (_showCameraCapture && _showAddImageModal && _isCameraActive && 
            string.IsNullOrEmpty(_capturedImageDataUrl) && 
            !string.IsNullOrEmpty(_previousCapturedImageDataUrl))
        {
            // Wait a bit for video element to be in DOM after Blazor renders
            await Task.Delay(250);
            
            // Ensure video is visible and playing
            try
            {
                var videoReady = await JS.InvokeAsync<bool>("eval", @"
                    (function() {
                        const video = document.getElementById('cameraVideo');
                        if (!video || !video.srcObject) {
                            return false;
                        }
                        
                        // Make absolutely sure video is visible
                        video.style.display = 'block';
                        video.style.visibility = 'visible';
                        video.style.opacity = '1';
                        video.style.width = '100%';
                        video.style.height = '100%';
                        
                        // Check if stream is active
                        const stream = video.srcObject;
                        const tracks = stream.getTracks();
                        const hasActiveTrack = tracks.some(track => track.readyState === 'live' && track.enabled);
                        
                        if (!hasActiveTrack) {
                            return false;
                        }
                        
                        // Play if paused
                        if (video.paused && video.readyState >= 2) {
                            video.play().catch(err => console.warn('Play error in OnAfterRender:', err));
                        }
                        
                        return true;
                    })();
                ");
                
                if (!videoReady)
                {
                    // Video not ready, try to restart camera
                    Console.WriteLine("Video not ready after retake, restarting camera...");
                    if (_isCameraActive)
                    {
                        await StopCamera();
                        await Task.Delay(200);
                        await StartCamera();
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error ensuring video plays in OnAfterRender: {ex.Message}");
            }
        }
        
        // Handle canvas initialization for before-after mode
        if (ViewModel.CanvasBackground == "before-after")
        {
            // Initialize canvas in before-after mode even without images (so structure is ready)
            // The canvas can be used for drawing even before images are loaded
            if (!_canvasInitialized)
            {
                // Small delay to ensure DOM elements are rendered
                await Task.Delay(100);
                await InitializeCanvasAsync();
            }
        }
        // Handle canvas initialization when image is selected (standard mode)
        else if (ViewModel.SelectedImage != null)
        {
            // Check if image changed (new selection or first selection)
            if (_previousSelectedImage != ViewModel.SelectedImage)
            {
                // Dispose previous canvas if it exists
                if (_canvasInitialized)
                {
                    await DisposeCanvasAsync();
                }
                
                // Initialize canvas for new image
                await InitializeCanvasAsync();
                
                // Track the current image
                _previousSelectedImage = ViewModel.SelectedImage;
            }
        }
        else if (_previousSelectedImage != null)
        {
            // Image was deselected, dispose canvas
            if (_canvasInitialized)
            {
                await DisposeCanvasAsync();
            }
            _previousSelectedImage = null;
        }
    }

    private async Task InitializeResizerAsync()
    {
        await JS.InvokeVoidAsync("eval", @"
            (function() {
                function initializeResizer() {
                    const resizer = document.querySelector('.panel-resizer');
                    const leftPanel = document.querySelector('.annotate-sidebar');
                    const container = document.querySelector('.annotate-container');

                    if (!resizer || !leftPanel || !container) {
                        setTimeout(initializeResizer, 100);
                        return;
                    }

                    let isResizing = false;

                    resizer.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        isResizing = true;
                        document.body.style.cursor = 'col-resize';
                        document.body.style.userSelect = 'none';
                    });

                    document.addEventListener('mousemove', function(e) {
                        if (!isResizing) return;

                        const containerRect = container.getBoundingClientRect();
                        const mouseX = e.clientX - containerRect.left;
                        let leftWidth = Math.max(250, Math.min(500, mouseX));
                        leftPanel.style.width = leftWidth + 'px';
                        
                        // Trigger canvas resize when sidebar is resized
                        if (typeof window.resizeFabricCanvas === 'function') {
                            window.resizeFabricCanvas();
                        }
                    });

                    document.addEventListener('mouseup', function() {
                        if (isResizing) {
                            isResizing = false;
                            document.body.style.cursor = '';
                            document.body.style.userSelect = '';
                            
                            // Final resize trigger when mouse is released
                            if (typeof window.resizeFabricCanvas === 'function') {
                                window.resizeFabricCanvas();
                            }
                        }
                    });
                }

                // Initialize resizer
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initializeResizer);
                } else {
                    initializeResizer();
                }
            })();
        ");
    }

    private async Task InitializeCanvasAsync()
    {
        try
        {
            Console.WriteLine("Initializing canvas for selected image...");
            ViewModel.ClearError();
            
            // Call JavaScript initialization function
            var result = await JS.InvokeAsync<object>("initializeFabricCanvas");
            
            // Mark canvas as initialized
            _canvasInitialized = true;
            
            Console.WriteLine("Canvas initialized successfully");
            
            // Set up listener for canvas content changes to track unsaved changes
            if (_dotNetRef != null)
            {
                await JS.InvokeVoidAsync("setupCanvasChangeListener", _dotNetRef);
                Console.WriteLine("Canvas change listener set up successfully");
            }
            
            // Trigger re-render to hide loading spinner
            StateHasChanged();
            
            // Update JavaScript state with current ViewModel settings
            await UpdateJavaScriptStateAsync();
        }
        catch (JSException jsEx)
        {
            Console.WriteLine($"JavaScript error during canvas initialization: {jsEx.Message}");
            Console.Error.WriteLine($"[ERROR] Canvas initialization failed - JSException: {jsEx.Message}");
            _canvasInitialized = false;
            
            // User-facing error message
            SetAnnotationError("Failed to initialize drawing canvas. Please refresh the page and try again.");
            
            // Trigger re-render to show error
            StateHasChanged();
        }
        catch (InvalidOperationException invOpEx)
        {
            Console.WriteLine($"Canvas initialization function not available: {invOpEx.Message}");
            Console.Error.WriteLine($"[ERROR] Canvas initialization failed - Function not available: {invOpEx.Message}");
            _canvasInitialized = false;
            
            // User-facing error message
            SetAnnotationError("Drawing tools are not available. Please ensure JavaScript is enabled and refresh the page.");
            
            // Trigger re-render to show error
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unexpected error during canvas initialization: {ex.Message}");
            Console.Error.WriteLine($"[ERROR] Canvas initialization failed - Unexpected error: {ex.GetType().Name} - {ex.Message}");
            _canvasInitialized = false;
            
            // User-facing error message
            SetAnnotationError("An unexpected error occurred while initializing the drawing canvas. Please try again.");
            
            // Trigger re-render to show error
            StateHasChanged();
        }
    }

    private async Task DisposeCanvasAsync()
    {
        try
        {
            Console.WriteLine("Disposing canvas...");
            
            // Call JavaScript disposal function
            await JS.InvokeVoidAsync("disposeFabricCanvas");
            
            // Mark canvas as not initialized
            _canvasInitialized = false;
            
            Console.WriteLine("Canvas disposed successfully");
            
            // Trigger re-render
            StateHasChanged();
        }
        catch (JSException jsEx)
        {
            Console.WriteLine($"JavaScript error during canvas disposal: {jsEx.Message}");
            _canvasInitialized = false;
            StateHasChanged();
        }
        catch (InvalidOperationException invOpEx)
        {
            Console.WriteLine($"Canvas disposal function not available: {invOpEx.Message}");
            _canvasInitialized = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unexpected error during canvas disposal: {ex.Message}");
            _canvasInitialized = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Stop camera if active
        if (_isCameraActive)
        {
            await StopCamera();
        }
        
        // Dispose DotNetObjectReference
        _dotNetRef?.Dispose();
        
        // Dispose debounce timers
        _colorDebounceTimer?.Dispose();
        _thicknessDebounceTimer?.Dispose();
        _fontSizeDebounceTimer?.Dispose();
        
        // Dispose canvas when component is disposed
        if (_canvasInitialized)
        {
            await DisposeCanvasAsync();
        }
    }
}

