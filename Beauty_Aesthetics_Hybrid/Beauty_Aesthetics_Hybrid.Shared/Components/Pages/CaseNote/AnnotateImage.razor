    private void DiscardChanges()
    {
        _showUnsavedChangesModal = false;
        _hasUnsavedChanges = false;
        
        // Handle navigation
        if (_pendingNavigation != null)
        {
            var targetUrl = _pendingNavigation;
            _pendingNavigation = null;
            NavigationManager.NavigateTo(targetUrl);
        }
        // Handle image selection
        else if (_pendingImageSelection != null)
        {
            var targetImage = _pendingImageSelection;
            _pendingImageSelection = null;
            ViewModel.SelectImage(targetImage);
            StateHasChanged();
        }
        // Handle add new image
        else if (_pendingAddNewImage)
        {
            _pendingAddNewImage = false;
            // Show add image modal
            _showAddImageModal = true;
            StateHasChanged();
        }
    }

