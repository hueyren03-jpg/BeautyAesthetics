    // Debounced color update
    private Task DebouncedColorUpdateAsync()
    {
        // Cancel previous timer if exists
        _colorDebounceTimer?.Dispose();
        
        // Create new timer that fires after debounce delay
        _colorDebounceTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                try
                {
                    Console.WriteLine($"Updating color to: {ViewModel.SelectedColor}");
                    var isReady = await JS.InvokeAsync<bool>("isCanvasReady");
                    if (isReady)
                    {
                        await JS.InvokeVoidAsync("setAnnotationColor", ViewModel.SelectedColor);
                        Console.WriteLine("Color updated successfully");
                    }
                    else
                    {
                        Console.WriteLine("Canvas not ready for color update");
                    }
                }
                catch (JSException jsEx)
                {
                    Console.WriteLine($"JavaScript error updating color: {jsEx.Message}");
                    Console.Error.WriteLine($"[ERROR] Color update failed - JSException: {jsEx.Message}");
                    // Graceful degradation - color is stored in ViewModel
                }
                catch (InvalidOperationException invOpEx)
                {
                    Console.WriteLine($"Color update function not available: {invOpEx.Message}");
                    Console.Error.WriteLine($"[ERROR] Color update failed - Function not available: {invOpEx.Message}");
                    // Graceful degradation
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Unexpected error updating color: {ex.GetType().Name} - {ex.Message}");
                    Console.Error.WriteLine($"[ERROR] Color update failed - Unexpected error: {ex.GetType().Name} - {ex.Message}");
                }
                finally
                {
                    _colorDebounceTimer?.Dispose();
                }
            });
        }, null, DebounceDelayMs, Timeout.Infinite);
        
        return Task.CompletedTask;
    }

