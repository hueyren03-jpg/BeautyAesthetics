@page "/annotate-image"
@using Beauty_Aesthetics_WebPos.Components.Layout
@layout EmptyLayout
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject AppFeedbackService Feedback
@implements IAsyncDisposable
<PageTitle>Annotation Images</PageTitle>

<div class="annotate-container" 
     tabindex="0" 
     @onkeydown="HandleKeyDown">
    <!-- Left Sidebar - Image Library -->
    <aside class="annotate-sidebar">
        <div class="sidebar-header">
            <h2 class="sidebar-title">Annotation Images</h2>
            <button type="button" class="btn-icon" @onclick="HandleAddNewImage" title="Add New Image">
                <i class="bi bi-plus-lg icon"></i>
            </button>
        </div>
        
        @if (_configuringSide != null)
        {
            <div class="selection-mode-banner">
                <i class="bi bi-hand-index"></i>
                <span>Select image for <strong>@(_configuringSide == "before" ? "Before" : "After")</strong></span>
                <button type="button" class="btn-cancel-selection" @onclick="CancelImageSelection" title="Cancel">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        }
        
        <div class="search-container">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input 
                    type="text" 
                    class="search-input" 
                    placeholder="Search images..." 
                    @bind="ViewModel.SearchTerm" 
                    @bind:event="oninput" />
            </div>
        </div>
        
        <div class="image-list">
            @foreach (var image in ViewModel.FilteredImages)
            {
                <button 
                    type="button" 
                    class="image-card @(ViewModel.SelectedImage == image ? "image-card-active" : string.Empty)" 
                    @onclick="() => HandleSelectImage(image)">
                    <div class="image-thumbnail">
                        <img src="@image.ThumbnailUrl" alt="@image.Name" />
                    </div>
                    <div class="image-info">
                        <div class="image-name">@image.Name</div>
                        <div class="image-category">@image.Category</div>
                    </div>
                </button>
            }
            @if (!ViewModel.FilteredImages.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-image empty-icon"></i>
                    <p>No images found</p>
                </div>
            }
        </div>
    </aside>

    <!-- Resizer -->
    <div class="panel-resizer" title="Drag to resize"></div>

    <!-- Main Content - Canvas Area -->
    <main class="annotate-main">
        <!-- Top Toolbar -->
        <header class="annotate-toolbar">
            <div class="toolbar-left">
                <!-- Select Tool (Unselect) -->
                <button 
                    type="button" 
                    class="tool-btn @(string.IsNullOrEmpty(ViewModel.ActiveTool) ? "tool-btn-active" : string.Empty)" 
                    @onclick="UnselectTool"
                    title="Select (Deselect all tools)">
                    <i class="bi bi-cursor"></i>
                </button>
                
                <div class="toolbar-divider"></div>
                
                <!-- Drawing Tools -->
                <button 
                    type="button" 
                    class="tool-btn @(ViewModel.ActiveTool == "pencil" ? "tool-btn-active" : string.Empty)" 
                    @onclick='() => SelectToolAsync("pencil")'
                    title="Pen">
                    <i class="bi bi-pen"></i>
                </button>
                <button 
                    type="button" 
                    class="tool-btn @(ViewModel.ActiveTool == "brush" ? "tool-btn-active" : string.Empty)" 
                    @onclick='() => SelectToolAsync("brush")'
                    title="Brush">
                    <i class="bi bi-brush"></i>
                </button>
                <button 
                    type="button" 
                    class="tool-btn @(ViewModel.ActiveTool == "text" ? "tool-btn-active" : string.Empty)" 
                    @onclick='() => SelectToolAsync("text")'
                    title="Text">
                    <i class="bi bi-fonts"></i>
                </button>
                <button 
                    type="button" 
                    class="tool-btn @(ViewModel.ActiveTool == "eraser" ? "tool-btn-active" : string.Empty)" 
                    @onclick='() => SelectToolAsync("eraser")'
                    title="Eraser">
                    <i class="bi bi-eraser"></i>
                </button>
                
                <div class="toolbar-divider"></div>
                
                <!-- Text Formatting -->
                <button 
                    type="button" 
                    class="tool-btn @(ViewModel.IsBold ? "tool-btn-active" : string.Empty)" 
                    @onclick="ToggleBoldAsync"
                    title="Bold">
                    <i class="bi bi-type-bold"></i>
                </button>
                <button 
                    type="button" 
                    class="tool-btn @(ViewModel.IsItalic ? "tool-btn-active" : string.Empty)" 
                    @onclick="ToggleItalicAsync"
                    title="Italic">
                    <i class="bi bi-type-italic"></i>
                </button>
                <button 
                    type="button" 
                    class="tool-btn @(ViewModel.IsUnderline ? "tool-btn-active" : string.Empty)" 
                    @onclick="ToggleUnderlineAsync"
                    title="Underline">
                    <i class="bi bi-type-underline"></i>
                </button>
                
                <div class="toolbar-divider"></div>
                
                <!-- Color Picker with Palette -->
                <div class="color-picker-container" @onclick:stopPropagation="true">
                    <button type="button" 
                            class="color-current-btn" 
                            @onclick="ToggleColorPalette"
                            @onclick:stopPropagation="true"
                            title="Text Color">
                        <i class="bi bi-palette"></i>
                        <div class="color-current-indicator" style="background: @ViewModel.SelectedColor"></div>
                    </button>
                    
                    @if (_showColorPalette)
                    {
                        <div class="color-palette-dropdown" @onclick:stopPropagation="true">
                            <!-- Color Grid -->
                            <div class="color-palette-grid">
                                @foreach (var row in _colorPalette)
                                {
                                    <div class="color-row">
                                        @foreach (var color in row)
                                        {
                                            <button type="button"
                                                    class="color-swatch @(ViewModel.SelectedColor?.ToLower() == color.ToLower() ? "color-swatch-active" : "")"
                                                    style="background: @color"
                                                    @onclick="() => SelectPaletteColor(color)"
                                                    title="@color">
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            
                            <!-- Custom Colors Section -->
                            <div class="custom-colors-section">
                                <div class="custom-colors-header">
                                    <span>CUSTOM</span>
                                    <button type="button" 
                                            class="btn-add-custom"
                                            @onclick="OpenCustomColorPicker"
                                            title="Add custom color">
                                        <i class="bi bi-plus-circle"></i>
                                    </button>
                                </div>
                                <div class="custom-colors-row">
                                    @if (_customColors.Any())
                                    {
                                        @foreach (var color in _customColors)
                                        {
                                            <button type="button"
                                                    class="color-swatch @(ViewModel.SelectedColor?.ToLower() == color.ToLower() ? "color-swatch-active" : "")"
                                                    style="background: @color"
                                                    @onclick="() => SelectPaletteColor(color)"
                                                    title="@color">
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="no-custom-colors">No custom colors yet</span>
                                    }
                                </div>
                            </div>
                            
                            <!-- Hidden color input -->
                            <input type="color" 
                                   @ref="_customColorInput"
                                   class="hidden-color-input"
                                   value="@ViewModel.SelectedColor"
                                   @onchange="OnCustomColorSelected" />
                        </div>
                    }
                </div>
                
                <!-- Desktop Controls (Inline Sliders) -->
                <div class="desktop-controls">
                    <!-- Thickness Slider -->
                    <div class="slider-control">
                        <label class="control-label">Thickness:</label>
                        <input 
                            type="range" 
                            class="range-slider" 
                            @bind="ViewModel.LineThickness" 
                            @bind:event="oninput"
                            min="1" 
                            max="20" 
                            title="Line Thickness" />
                        <span class="control-value">@ViewModel.LineThickness</span>
                        <div class="thickness-preview" title="@GetThicknessTooltip()">
                            <div class="thickness-indicator" 
                                 style="width: @GetThicknessPreviewSize()px; height: @GetThicknessPreviewSize()px; background: @GetThicknessPreviewColor();">
                            </div>
                        </div>
                    </div>
                    
                    <!-- Font Size Slider -->
                    <div class="slider-control">
                        <label class="control-label">Font Size:</label>
                        <input 
                            type="range" 
                            class="range-slider" 
                            @bind="ViewModel.FontSize" 
                            @bind:event="oninput"
                            min="8" 
                            max="48" 
                            title="Font Size" />
                        <span class="control-value">@ViewModel.FontSize</span>
                    </div>
                </div>

                <!-- Mobile/Tablet Controls (Dropdowns) -->
                <div class="mobile-controls">
                    <!-- Thickness Dropdown -->
                    <div class="dropdown-container" @onclick:stopPropagation="true">
                        <button type="button" 
                                class="tool-btn @(_showThicknessDropdown ? "tool-btn-active" : "")" 
                                @onclick="ToggleThicknessDropdown"
                                title="Line Thickness">
                            <i class="bi bi-border-width"></i>
                        </button>
                        
                        @if (_showThicknessDropdown)
                        {
                            <div class="toolbar-dropdown">
                                <div class="dropdown-header">Thickness</div>
                                <div class="slider-wrapper">
                                    <input type="range" 
                                           class="range-slider" 
                                           @bind="ViewModel.LineThickness" 
                                           @bind:event="oninput"
                                           min="1" 
                                           max="20" />
                                    <div class="thickness-preview-large">
                                        <div class="thickness-dot" 
                                             style="width: @(ViewModel.LineThickness)px; height: @(ViewModel.LineThickness)px; background: @ViewModel.SelectedColor">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Font Size Dropdown -->
                    <div class="dropdown-container" @onclick:stopPropagation="true">
                        <button type="button" 
                                class="tool-btn @(_showFontSizeDropdown ? "tool-btn-active" : "")" 
                                @onclick="ToggleFontSizeDropdown"
                                title="Font Size">
                            <i class="bi bi-type"></i>
                        </button>
                        
                        @if (_showFontSizeDropdown)
                        {
                            <div class="toolbar-dropdown">
                                <div class="dropdown-header">Font Size</div>
                                <div class="slider-wrapper">
                                    <input type="range" 
                                           class="range-slider" 
                                           @bind="ViewModel.FontSize" 
                                           @bind:event="oninput"
                                           min="8" 
                                           max="48" />
                                    <span class="value-display">@ViewModel.FontSize px</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <div class="toolbar-right">
                <!-- Undo/Redo/Reset -->
                <button 
                    type="button" 
                    class="tool-btn" 
                    @onclick="HandleUndo"
                    title="Undo (Ctrl+Z)">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
                <button 
                    type="button" 
                    class="tool-btn" 
                    @onclick="HandleRedo"
                    title="Redo (Ctrl+Y)">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button 
                    type="button" 
                    class="tool-btn tool-btn-text" 
                    @onclick="HandleReset"
                    title="Reset Canvas">
                    Reset
                </button>
            </div>
        </header>

        <!-- Canvas Area -->
        <div class="canvas-container" @onclick="CloseColorPalette">
            @if (ViewModel.SelectedImage is not null || 
                 ViewModel.CanvasBackground == "before-after" || 
                 ViewModel.CanvasBackground == "notepad" || 
                 ViewModel.CanvasBackground == "blank")
            {
                <div class="canvas-wrapper">
                    <!-- Background Toggle -->
                    <div class="background-controls">
                        <button 
                            type="button" 
                            class="bg-btn @(ViewModel.CanvasBackground == "image" ? "bg-btn-active" : string.Empty)" 
                            @onclick='() => SetBackgroundAsync("image")'>
                            Image
                        </button>
                        <button 
                            type="button" 
                            class="bg-btn @(ViewModel.CanvasBackground == "notepad" ? "bg-btn-active" : string.Empty)" 
                            @onclick='() => SetBackgroundAsync("notepad")'>
                            <i class="bi bi-journal-text"></i> Notepad
                        </button>
                        <button 
                            type="button" 
                            class="bg-btn @(ViewModel.CanvasBackground == "blank" ? "bg-btn-active" : string.Empty)" 
                            @onclick='() => SetBackgroundAsync("blank")'>
                            <i class="bi bi-file-earmark"></i> Blank Page
                        </button>
                        <button 
                            type="button" 
                            class="bg-btn @(ViewModel.CanvasBackground == "before-after" ? "bg-btn-active" : string.Empty)" 
                            @onclick='() => SetBackgroundAsync("before-after")'>
                            <i class="bi bi-images"></i> Before/After
                        </button>
                    </div>

                    <!-- Canvas -->
                    @if (ViewModel.CanvasBackground == "before-after")
                    {
                        <!-- Before/After Image Selection Controls (Outside Canvas) -->
                        <div class="before-after-controls">
                            <div class="before-after-control-section">
                                <h4>Before Image</h4>
                                @if (ViewModel.BeforeImage != null)
                                {
                                    <div class="selected-image-info">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>@ViewModel.BeforeImage.Name</span>
                                        <button type="button" class="btn-change-image" @onclick="() => ShowChangeImageOptions(true)" title="Change image">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="image-selection-buttons">
                                        <button type="button" class="btn-select-image" @onclick="SelectBeforeFromLibrary">
                                            <i class="bi bi-folder"></i> From Library
                                        </button>
                                        <button type="button" class="btn-select-image" @onclick="UploadBeforeImage">
                                            <i class="bi bi-upload"></i> Upload
                                        </button>
                                    </div>
                                }
                            </div>
                            <div class="before-after-control-section">
                                <h4>After Image</h4>
                                @if (ViewModel.AfterImage != null)
                                {
                                    <div class="selected-image-info">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>@ViewModel.AfterImage.Name</span>
                                        <button type="button" class="btn-change-image" @onclick="() => ShowChangeImageOptions(false)" title="Change image">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="image-selection-buttons">
                                        <button type="button" class="btn-select-image" @onclick="SelectAfterFromLibrary">
                                            <i class="bi bi-folder"></i> From Library
                                        </button>
                                        <button type="button" class="btn-select-image" @onclick="UploadAfterImage">
                                            <i class="bi bi-upload"></i> Upload
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <!-- Before/After Mode Canvas -->
                        <div class="canvas canvas-bg-before-after" id="canvasWrapper">
                            @if (!_canvasInitialized)
                            {
                                <div class="canvas-loading">
                                    <div class="loading-spinner"></div>
                                    <p>Loading canvas...</p>
                                </div>
                            }
                            <div class="before-after-container">
                                <div class="before-section">
                                    @if (ViewModel.BeforeImage != null)
                                    {
                                        <img 
                                            src="@ViewModel.BeforeImage.ImageUrl" 
                                            alt="@ViewModel.BeforeImage.Name" 
                                            class="canvas-image" 
                                            id="beforeImage" />
                                    }
                                    else
                                    {
                                        <div class="image-placeholder">
                                            <div class="placeholder-content">
                                                <i class="bi bi-image"></i>
                                                <p>Before Image</p>
                                                <p class="placeholder-hint">Select image using controls above</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="after-section">
                                    @if (ViewModel.AfterImage != null)
                                    {
                                        <img 
                                            src="@ViewModel.AfterImage.ImageUrl" 
                                            alt="@ViewModel.AfterImage.Name" 
                                            class="canvas-image" 
                                            id="afterImage" />
                                    }
                                    else
                                    {
                                        <div class="image-placeholder">
                                            <div class="placeholder-content">
                                                <i class="bi bi-image"></i>
                                                <p>After Image</p>
                                                <p class="placeholder-hint">Select image using controls above</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <!-- HTML5 Canvas for Drawing (Fabric.js handles all annotations) -->
                            <canvas id="drawingCanvas" class="drawing-canvas"></canvas>
                        </div>
                    }
                    else if (ViewModel.SelectedImage is not null)
                    {
                        <!-- Standard Single Image Mode -->
                        <div class="canvas @($"canvas-bg-{ViewModel.CanvasBackground}")" 
                             id="canvasWrapper">
                            @if (!_canvasInitialized)
                            {
                                <div class="canvas-loading">
                                    <div class="loading-spinner"></div>
                                    <p>Loading canvas...</p>
                                </div>
                            }
                            @if (ViewModel.CanvasBackground == "image")
                            {
                                <img 
                                    src="@ViewModel.SelectedImage.ImageUrl" 
                                    alt="@ViewModel.SelectedImage.Name" 
                                    class="canvas-image" 
                                    id="backgroundImage" />
                            }
                            
                            <!-- HTML5 Canvas for Drawing (Fabric.js handles all annotations) -->
                            <canvas id="drawingCanvas" class="drawing-canvas"></canvas>
                        </div>
                    }
                    else if (ViewModel.CanvasBackground == "notepad" || ViewModel.CanvasBackground == "blank")
                    {
                        <!-- Notepad/Blank Page Mode (No image required) -->
                        <div class="canvas @($"canvas-bg-{ViewModel.CanvasBackground}")" 
                             id="canvasWrapper">
                            @if (!_canvasInitialized)
                            {
                                <div class="canvas-loading">
                                    <div class="loading-spinner"></div>
                                    <p>Loading canvas...</p>
                                </div>
                            }
                            
                            <!-- HTML5 Canvas for Drawing (Fabric.js handles all annotations) -->
                            <canvas id="drawingCanvas" class="drawing-canvas"></canvas>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="canvas-empty">
                    <i class="bi bi-palette empty-icon-large"></i>
                    <h3>Select an Image to Start Annotating</h3>
                    <p>Choose an annotation image from the library on the left</p>
                </div>
            }
        </div>

        <!-- Bottom Action Bar -->
        <footer class="action-bar">
            <div class="action-info">
                @if (ViewModel.CanvasBackground == "before-after")
                {
                    @if (ViewModel.BeforeImage is not null || ViewModel.AfterImage is not null)
                    {
                        <span class="info-text">
                            @if (ViewModel.BeforeImage is not null && ViewModel.AfterImage is not null)
                            {
                                <text><strong>Before/After Comparison</strong> - @ViewModel.BeforeImage.Name &amp; @ViewModel.AfterImage.Name</text>
                            }
                            else if (ViewModel.BeforeImage is not null)
                            {
                                <text><strong>Before/After</strong> - Before: @ViewModel.BeforeImage.Name</text>
                            }
                            else if (ViewModel.AfterImage is not null)
                            {
                                <text><strong>Before/After</strong> - After: @ViewModel.AfterImage.Name</text>
                            }
                        </span>
                    }
                }
                else if (ViewModel.SelectedImage is not null)
                {
                    <span class="info-text">
                        <strong>@ViewModel.SelectedImage.Name</strong> - @ViewModel.SelectedImage.Category
                    </span>
                }
            </div>
            <div class="action-buttons">
                <button 
                    type="button"
                    class="btn-cancel-icon" 
                    @onclick="NavigateBack"
                    title="Back to home"
                    aria-label="Back to home">
                    <i class="bi bi-x-lg"></i>
                </button>
                <button 
                    type="button" 
                    class="btn-insert-icon" 
                    @onclick="InsertAnnotation" 
                    disabled="@(ViewModel.CanvasBackground == "before-after" ? (ViewModel.BeforeImage is null && ViewModel.AfterImage is null) : ViewModel.SelectedImage is null)"
                    title="Insert into case notes"
                    aria-label="Insert into case notes">
                    <i class="bi bi-check-lg"></i>
                </button>
            </div>
        </footer>

        @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
        {
            <div class="status-message @ViewModel.StatusMessageType">
                @ViewModel.StatusMessage
            </div>
        }
    </main>
</div>

<!-- Unsaved Changes Warning Modal -->
@if (_showUnsavedChangesModal)
{
    <div class="modal-overlay" @onclick:stopPropagation="true">
        <div class="modal-container unsaved-changes-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-warning">
                <i class="bi bi-exclamation-circle-fill"></i>
                <h3>Unsaved Annotations</h3>
            </div>
            <div class="modal-body">
                <p>You have unsaved annotations on this image.</p>
                <p class="modal-warning">If you leave now, your annotations will be lost.</p>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-discard" @onclick="DiscardChanges">
                    <i class="bi bi-x-circle"></i>
                    <span>Discard Annotations</span>
                </button>
                <button class="btn-modal-continue" @onclick="ContinueEditing">
                    <i class="bi bi-pencil-square"></i>
                    <span>Continue Editing</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Add Image Modal -->
@if (_showAddImageModal)
{
    <div class="modal-overlay" @onclick="() => CloseAddImageModal()">
        <div class="modal-container add-image-modal" @onclick:stopPropagation="true">
            @if (!_showCameraCapture)
            {
                <!-- Option Selection View -->
                <div class="modal-header">
                    <i class="bi bi-plus-circle-fill"></i>
                    <h3>Add New Image</h3>
                </div>
                <div class="modal-body">
                    <p>Choose how you want to add a new image:</p>
                    <div class="add-image-options">
                        <button class="option-card" @onclick="ShowUploadOption">
                            <i class="bi bi-upload"></i>
                            <span class="option-title">Upload from PC</span>
                            <span class="option-desc">Select an image file from your computer</span>
                        </button>
                        <button class="option-card" @onclick="ShowCameraOption">
                            <i class="bi bi-camera-fill"></i>
                            <span class="option-title">Take Picture</span>
                            <span class="option-desc">Use your device camera to capture an image</span>
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-modal-cancel" @onclick="() => CloseAddImageModal()">
                        <i class="bi bi-x-lg"></i>
                        Cancel
                    </button>
                </div>
            }
            else
            {
                <!-- Camera Capture View -->
                <div class="modal-header camera-header">
                    <i class="bi bi-camera-fill"></i>
                    <h3>Take Picture</h3>
                </div>
                <div class="modal-body camera-body">
                    @if (string.IsNullOrEmpty(_capturedImageDataUrl))
                    {
                        <!-- Live Camera Feed -->
                        <div class="camera-container">
                            <video id="cameraVideo" autoplay playsinline class="camera-video"></video>
                            <canvas id="cameraCanvas" class="camera-canvas" style="display: none;"></canvas>
                        </div>
                        <div class="camera-controls">
                            <button class="btn-camera-control" @onclick="FlipHorizontal" title="Flip Horizontal">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Flip H</span>
                            </button>
                            <button class="btn-camera-control" @onclick="FlipVertical" title="Flip Vertical">
                                <i class="bi bi-arrow-down-up"></i>
                                <span>Flip V</span>
                            </button>
                            <button class="btn-camera-capture" @onclick="CaptureImage" title="Capture">
                                <i class="bi bi-camera-fill"></i>
                                <span>Capture</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- Captured Image Preview -->
                        <div class="capture-preview-container">
                            <img src="@_capturedImageDataUrl" alt="Captured" class="capture-preview" />
                        </div>
                        <div class="capture-actions">
                            <button class="btn-capture-reset" @onclick="ResetCapture">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                <span>Retake</span>
                            </button>
                            <button class="btn-capture-confirm" @onclick="ConfirmCameraImage">
                                <i class="bi bi-check-lg"></i>
                                <span>Use This Image</span>
                            </button>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn-modal-cancel" @onclick="() => CloseAddImageModal()">
                        <i class="bi bi-x-lg"></i>
                        Cancel
                    </button>
                </div>
            }
        </div>
    </div>
}

<!-- Hidden file input for image upload -->
<InputFile id="imageFileInput" OnChange="HandleImageUpload" accept="image/*" style="display: none;" />

<!-- Change Image Options Modal -->
@if (_showChangeImageModal)
{
    <div class="modal-overlay" @onclick="CloseChangeImageModal">
        <div class="modal-container change-image-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
