                                                <i class="bi bi-capsule"></i>
                                                <div>
                                                    <div class="new-drug-name">@(drugItem.Drug != null ? drugItem.Drug.Name : drugItem.DrugName)</div>
                                                    <div class="new-drug-meta">
                                                        <span class="drug-meta-item">Drug Code: @(drugItem.Drug != null ? drugItem.Drug.DrugCode : drugItem.DrugCode)</span>
                                                        @if (!string.IsNullOrEmpty(drugItem.Category) || (drugItem.Drug != null && !string.IsNullOrEmpty(drugItem.Drug.Category)))
                                                        {
                                                            <span class="drug-meta-item">Category: @(drugItem.Drug != null ? drugItem.Drug.Category : drugItem.Category)</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <button class="btn-remove-new-drug" @onclick="() => RemoveDrugFromNewPrescription(drugItem)" title="Remove">
