                                            <div class="new-drug-field">
                                                <div class="form-label-row">
                                                    <label>Reason</label>
                                                    <button class="btn-toggle-input" 
                                                            @onclick="() => { drugItem.ManualReason = !drugItem.ManualReason; StateHasChanged(); }"
                                                            title="@(drugItem.ManualReason ? "Switch to dropdown" : "Switch to manual entry")"
                                                            type="button">
                                                        <i class="bi @(drugItem.ManualReason ? "bi-list-check" : "bi-pencil-square")"></i>
                                                    </button>
                                                </div>
                                                @if (drugItem.ManualReason)
                                                {
                                                    <input 
                                                        type="text" 
                                                        class="form-control-small" 
                                                        @bind="drugItem.Reason" 
                                                        placeholder="Enter reason manually" />
                                                }
                                                else
                                                {
                                                    <select class="form-control-small" @bind="drugItem.Reason">
                                                        <option value="">- Select -</option>
                                                        @foreach (var reason in ViewModel.ReasonOptions)
                                                        {
                                                            <option value="@reason">@reason</option>
                                                        }
                                                    </select>
                                                }
                                            </div>
                                            <div class="new-drug-field full-width">
                                                <label>Notes</label>
                                                <input type="text" 
                                                       class="form-control-small" 
                                                       @bind="drugItem.Notes" 
                                                       placeholder="Optional notes" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <div class="modal-footer-prescription">
                <button class="btn-cancel-edit" @onclick="CloseAddPrescriptionModal">
                    <i class="bi bi-x-circle"></i>
                    Cancel
                </button>
                <button class="btn-save-edit" @onclick="SaveNewPrescription" disabled="@(!_newPrescriptionDrugs.Any())">
                    <i class="bi bi-check-circle"></i>
                    Create Prescription
                </button>
            </div>
        </div>
    </div>
}

<!-- Signature Modal -->
@if (_showSignatureModal)
{
    <div class="signature-modal-overlay">
        <div class="signature-modal-container" @onclick:stopPropagation="true">
            <div class="signature-modal-header">
                <h3 class="signature-modal-title">
                    <i class="bi bi-pen"></i>
                    Doctor's Signature Required
                </h3>
            </div>

            <div class="signature-modal-body">
                <p class="signature-instruction">
                    <i class="bi bi-info-circle"></i>
                    Please sign below to complete the prescription. Signature is required.
                </p>
                <div class="signature-canvas-wrapper">
                    <canvas 
                        id="signatureCanvas" 
                        width="800" 
                        height="300"
                        @ref="_signatureCanvas"
                        @onmousedown="StartDrawing"
                        @onmousemove="Draw"
                        @onmouseup="StopDrawing"
                        @onmouseleave="StopDrawing"
                        @ontouchstart="StartDrawingTouch"
                        @ontouchmove="DrawTouch"
                        @ontouchend="StopDrawing">
                    </canvas>
                </div>
            </div>

            <div class="signature-modal-footer">
                <button class="btn-signature-clear" @onclick="ClearSignature">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Clear</span>
                </button>
                <button class="btn-signature-save" @onclick="SaveSignature" disabled="@(string.IsNullOrWhiteSpace(_tempSignatureDataUrl))">
                    <i class="bi bi-check-circle"></i>
                    <span>Save & Continue</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Print Confirmation Modal -->
@if (_showPrintConfirmationModal && _lastSubmittedPrescription != null)
{
    <div class="modal-overlay">
        <div class="modal-container print-confirmation-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <i class="bi bi-printer"></i>
                <h3>Prescription Submitted Successfully</h3>
            </div>
            <div class="modal-body">
                <p style="margin-bottom: 16px;">
                    Prescription <strong>@_lastSubmittedPrescription.PrescriptionNumber</strong> has been submitted successfully!
                </p>
                <p style="margin-bottom: 0; color: #64748b;">
                    Would you like to print the prescription now?
                </p>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="ClosePrintConfirmationModal">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-print" @onclick="PrintPrescriptionAndClose">
                    <i class="bi bi-printer"></i>
                    <span>Print</span>
                </button>
            </div>
        </div>
    </div>
}

<AppErrorPopup Title="Prescription is incomplete"
               Message="@(_showValidationError ? "Please fill in all required fields." : null)"
               OnDismiss="@(() => _showValidationError = false)" />

@code {
    private CaseNotePrescriptionViewModel ViewModel { get; set; } = new();
    private string _mobilePanel = "catalog";

    
    // Mutable class for editing drugs in new prescription
    private class EditableDrugItem
    {
        public int Id { get; set; }
        public Drug? Drug { get; set; } // Nullable for custom drugs
        public string DrugName { get; set; } = string.Empty; // For custom drugs
        public string DrugCode { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Indication { get; set; } = string.Empty;
        public string Restriction { get; set; } = string.Empty;
        public string Dosage { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1.00m;
        public string Frequency { get; set; } = string.Empty;
        public string Duration { get; set; } = string.Empty;
        public string Reason { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
        public bool IsCustom { get; set; } = false; // True if manually created
        
        // Manual input mode toggles
        public bool ManualFrequency { get; set; } = false;
        public bool ManualDuration { get; set; } = false;
        public bool ManualReason { get; set; } = false;
        
        public Drug GetDrug()
        {
            if (Drug != null) return Drug;
            // Create a temporary drug for custom entries
            return new Drug(0, DrugName, DrugCode, Category, Indication, Restriction, Dosage);
        }
        
        public SelectedDrug ToSelectedDrug() => new SelectedDrug(Id, GetDrug(), Quantity, Frequency, Duration, Reason, Notes);
    }

    protected override void OnInitialized()
    {
        Console.WriteLine($"OnInitialized - Drug count: {ViewModel.Drugs.Count}");
        Console.WriteLine($"OnInitialized - Filtered drugs count: {ViewModel.FilteredDrugs.Count()}");
        
        ViewModel.PropertyChanged += (sender, args) => 
        {
            Console.WriteLine($"Property changed: {args.PropertyName}");
            
            // Reset to first page when search or filter changes
            if (args.PropertyName == nameof(ViewModel.SearchTerm) || 
                args.PropertyName == nameof(ViewModel.SelectedCategory) ||
                args.PropertyName == nameof(ViewModel.FilteredDrugs))
            {
                _currentPage = 1;
            }
            
            InvokeAsync(StateHasChanged);
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize the resizer after the component has rendered
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    const resizer = document.querySelector('.panel-resizer');
                    const leftPanel = document.querySelector('.drug-list-panel');
                    const rightPanel = document.querySelector('.selected-drugs-panel');
                    const container = document.querySelector('.prescription-content');

                    if (!resizer || !leftPanel || !rightPanel || !container) return;

                    let isResizing = false;

                    resizer.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        isResizing = true;
                        document.body.style.cursor = 'col-resize';
                        document.body.style.userSelect = 'none';
                    });

                    document.addEventListener('mousemove', function(e) {
                        if (!isResizing) return;

                        const containerRect = container.getBoundingClientRect();
                        const containerWidth = containerRect.width;
                        const mouseX = e.clientX - containerRect.left;

                        let leftPercentage = (mouseX / containerWidth) * 100;
                        leftPercentage = Math.max(35, Math.min(80, leftPercentage));

                        leftPanel.style.width = leftPercentage + '%';
                        rightPanel.style.flex = '1';
                    });

                    document.addEventListener('mouseup', function() {
                        if (isResizing) {
                            isResizing = false;
                            document.body.style.cursor = '';
                            document.body.style.userSelect = '';
                        }
                    });
                })();
            ");
        }
        
        // Initialize signature canvas when signature modal is shown
        if (_showSignatureModal && !_canvasInitialized)
        {
            await Task.Delay(100); // Small delay to ensure canvas is rendered
            await InitializeSignatureCanvas();
            StateHasChanged();
        }
    }

    private void HandleDrugClick(Drug drug)
    {
        Console.WriteLine($"Drug clicked: {drug.Name}");
        ViewModel.SelectDrugToAdd(drug);
        _mobilePanel = "selected";
        _showValidationError = false; // Reset validation error
        
        // Reset to first page when search/filter changes
        _currentPage = 1;
        
        StateHasChanged();
    }

    private string _statusMessage = string.Empty;
    private bool _isSuccess = false;
    private bool _showValidationError = false;
    private int _textSizeLevel = 1; // 0 = Small, 1 = Normal, 2 = Large
    private Prescription? _lastSubmittedPrescription = null;
    private bool _showPrintConfirmationModal = false;
    private bool _showSignatureModal = false;
    private string _signatureDataUrl = string.Empty;
    private string _tempSignatureDataUrl = string.Empty;
    private bool _canvasInitialized = false;
    private ElementReference _signatureCanvas;
    private bool _isDrawing = false;
    private double _lastX = 0;
    private double _lastY = 0;
    
    // Pagination
    private int _currentPage = 1;
    private const int _itemsPerPage = 10;
    
    // Manual input mode toggles
    private bool _manualFrequency = false;
    private bool _manualDuration = false;
    private bool _manualReason = false;
    
    // Edit Prescription Modal
    private bool _showEditPrescriptionModal = false;
    private bool _showAddPrescriptionModal = false;
    private Prescription? _editingPrescription = null;
    private string _editingPrescriptionNumber = string.Empty;
    private DateTime _editingPrescriptionDate = DateTime.Now;
    private string _editingPrescriptionType = "Standard";
    private string _editingPrescriptionStatus = "Submitted";
    
    // Add Prescription Modal
    private string _newPrescriptionNumber = string.Empty;
    private DateTime _newPrescriptionDate = DateTime.Now;
    private string _newPrescriptionType = "Standard";
    private string _newPrescriptionStatus = "Submitted";
    private string _drugSearchForAdd = string.Empty;
    private bool _useSearchDrug = true; // Toggle between search and create
    private List<EditableDrugItem> _newPrescriptionDrugs = new();
    
    // Custom drug fields
    private string _newCustomDrugName = string.Empty;
    private string _newCustomDrugCode = string.Empty;
    private string _newCustomDrugCategory = string.Empty;
    private string _newCustomDrugIndication = string.Empty;
    private string _newCustomDrugRestriction = string.Empty;
    private string _newCustomDrugDosage = string.Empty;

    private void HandleAddDrug()
    {
        // Validate required fields
        if (string.IsNullOrEmpty(ViewModel.NewDrugFrequency) || 
            string.IsNullOrEmpty(ViewModel.NewDrugDuration) || 
            string.IsNullOrEmpty(ViewModel.NewDrugReason))
        {
            _showValidationError = true;
            StateHasChanged();
            return;
        }

        _showValidationError = false;
        ViewModel.AddSelectedDrug();
        _mobilePanel = "selected";
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        var prescriptionNumber = ViewModel.SubmitPrescription();
        
        if (prescriptionNumber.StartsWith("Error"))
        {
            _statusMessage = prescriptionNumber;
            _isSuccess = false;
            _lastSubmittedPrescription = null;
            _showPrintConfirmationModal = false;
            _showSignatureModal = false;
        }
        else
        {
            // Get the last submitted prescription
            _lastSubmittedPrescription = ViewModel.Prescriptions
                .FirstOrDefault(p => p.PrescriptionNumber == prescriptionNumber);
            
            _statusMessage = $"Prescription {prescriptionNumber} submitted successfully!";
            _isSuccess = true;
            
            // Show signature modal first
            _showSignatureModal = true;
            _signatureDataUrl = string.Empty;
            _canvasInitialized = false;
            
            // Clear message after 3 seconds
            await Task.Delay(3000);
            _statusMessage = string.Empty;
        }
        
        StateHasChanged();
    }
    
    private void ClosePrintConfirmationModal()
    {
        _showPrintConfirmationModal = false;
        StateHasChanged();
    }
    
    private async Task PrintPrescriptionAndClose()
    {
        if (_lastSubmittedPrescription != null)
        {
            await PrintPrescription();
        }
        _showPrintConfirmationModal = false;
        StateHasChanged();
    }
    
    // Signature Modal Functions
    private async Task InitializeSignatureCanvas()
    {
        try
        {
            await JS.InvokeVoidAsync("initializeSignatureCanvas");
            _canvasInitialized = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing signature canvas: {ex.Message}");
        }
    }
    
    private async Task SaveSignature()
    {
        _tempSignatureDataUrl = await JS.InvokeAsync<string>("getSignatureDataUrl");
        
        if (!string.IsNullOrWhiteSpace(_tempSignatureDataUrl))
        {
            _signatureDataUrl = _tempSignatureDataUrl;
            _showSignatureModal = false;
            _canvasInitialized = false;
            _tempSignatureDataUrl = string.Empty;
            
            // Show print confirmation modal after signature is saved
            _showPrintConfirmationModal = true;
        }
        // If no signature, don't proceed - signature is required
        
        StateHasChanged();
    }
    
    private async Task ClearSignature()
    {
        await JS.InvokeVoidAsync("clearSignatureCanvas");
        _tempSignatureDataUrl = string.Empty;
        StateHasChanged();
    }
    
    private async Task StartDrawing(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        _isDrawing = true;
        var coords = await JS.InvokeAsync<CanvasCoordinates>("getCanvasCoordinates", e.ClientX, e.ClientY);
        _lastX = coords.X;
        _lastY = coords.Y;
    }
    
    private async Task Draw(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (_isDrawing)
        {
            var coords = await JS.InvokeAsync<CanvasCoordinates>("getCanvasCoordinates", e.ClientX, e.ClientY);
            await JS.InvokeVoidAsync("drawSignature", coords.X, coords.Y, _lastX, _lastY);
            _lastX = coords.X;
            _lastY = coords.Y;
            
            // Check signature after drawing
            await Task.Delay(100);
            _tempSignatureDataUrl = await JS.InvokeAsync<string>("getSignatureDataUrl");
            StateHasChanged();
        }
    }
    
    private async Task StopDrawing()
    {
        _isDrawing = false;
        // Final check for signature when drawing stops
        await Task.Delay(100);
        _tempSignatureDataUrl = await JS.InvokeAsync<string>("getSignatureDataUrl");
        StateHasChanged();
    }
    
    private async Task StartDrawingTouch(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            _isDrawing = true;
            var touch = e.Touches[0];
            var coords = await JS.InvokeAsync<CanvasCoordinates>("getCanvasCoordinates", touch.ClientX, touch.ClientY);
            _lastX = coords.X;
            _lastY = coords.Y;
        }
    }
    
    private async Task DrawTouch(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        if (_isDrawing && e.Touches.Length > 0)
        {
            var touch = e.Touches[0];
            var coords = await JS.InvokeAsync<CanvasCoordinates>("getCanvasCoordinates", touch.ClientX, touch.ClientY);
            await JS.InvokeVoidAsync("drawSignature", coords.X, coords.Y, _lastX, _lastY);
            _lastX = coords.X;
            _lastY = coords.Y;
            
            // Check signature after drawing
            await Task.Delay(100);
            _tempSignatureDataUrl = await JS.InvokeAsync<string>("getSignatureDataUrl");
            StateHasChanged();
        }
    }
    
    private class BoundingClientRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
    }
    
    private class CanvasCoordinates
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    private void CancelDrugSelection()
    {
        ViewModel.SelectedDrugToAdd = null;
        _showValidationError = false;
        _manualFrequency = false;
        _manualDuration = false;
        _manualReason = false;
        if (!ViewModel.SelectedDrugs.Any())
        {
            _mobilePanel = "catalog";
        }
        StateHasChanged();
    }

    private void IncreaseTextSize()
    {
        if (_textSizeLevel < 2)
        {
            _textSizeLevel++;
            StateHasChanged();
        }
    }

    private void DecreaseTextSize()
    {
        if (_textSizeLevel > 0)
        {
            _textSizeLevel--;
            StateHasChanged();
        }
    }

    private string GetTextSizeClass()
    {
        return _textSizeLevel switch
        {
            0 => "text-size-small",
            2 => "text-size-large",
            _ => "text-size-normal"
        };
    }

    private string GetTextSizeLabel()
    {
        return _textSizeLevel switch
        {
            0 => "Small",
            2 => "Large",
            _ => "Normal"
        };
    }
    
    // Pagination Methods
    private IEnumerable<Drug> GetPaginatedDrugs()
    {
        var filtered = ViewModel.FilteredDrugs.ToList();
        var startIndex = (_currentPage - 1) * _itemsPerPage;
        return filtered.Skip(startIndex).Take(_itemsPerPage);
    }
    
    private int GetTotalPages()
    {
        var totalDrugs = ViewModel.FilteredDrugs.Count();
        return (int)Math.Ceiling((double)totalDrugs / _itemsPerPage);
    }
    
    private void GoToNextPage()
    {
        if (_currentPage < GetTotalPages())
        {
            _currentPage++;
            StateHasChanged();
        }
    }
    
    private void GoToPage(int page)
    {
        if (page >= 1 && page <= GetTotalPages())
        {
            _currentPage = page;
            StateHasChanged();
        }
    }
    
    private void GoToPreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            StateHasChanged();
        }
    }
    
    
    private void EditPrescription(Prescription prescription)
    {
        _editingPrescription = prescription;
        _editingPrescriptionNumber = prescription.PrescriptionNumber;
        _editingPrescriptionDate = prescription.Date;
        _editingPrescriptionType = prescription.Type;
        _editingPrescriptionStatus = prescription.Status;
        _showEditPrescriptionModal = true;
        StateHasChanged();
    }
    
    private void CloseEditPrescriptionModal()
    {
        _showEditPrescriptionModal = false;
        _editingPrescription = null;
        StateHasChanged();
    }
    
    private void SaveEditedPrescription()
    {
        if (_editingPrescription == null) return;
        
        ViewModel.UpdatePrescription(
            _editingPrescription.Id,
            _editingPrescriptionDate,
            _editingPrescriptionType,
            _editingPrescriptionStatus,
            _editingPrescription.Drugs
        );
        
        _statusMessage = $"Prescription {_editingPrescriptionNumber} updated successfully!";
        _isSuccess = true;
        
        CloseEditPrescriptionModal();
        
        // Clear message after 3 seconds
        Task.Delay(3000).ContinueWith(_ =>
        {
            _statusMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        });
        
        StateHasChanged();
    }
    
    private void DeletePrescription(Prescription prescription)
    {
        ViewModel.RemovePrescription(prescription.Id);
        _statusMessage = $"Prescription {prescription.PrescriptionNumber} deleted successfully!";
        _isSuccess = true;
        
        // Clear message after 3 seconds
        Task.Delay(3000).ContinueWith(_ =>
        {
            _statusMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        });
        
        StateHasChanged();
    }
    
    private void RemoveDrugFromEdit(SelectedDrug drug)
    {
        if (_editingPrescription == null) return;
        
        var updatedDrugs = _editingPrescription.Drugs.Where(d => d.Id != drug.Id).ToList();
        
        // Re-number remaining drugs
        for (int i = 0; i < updatedDrugs.Count; i++)
        {
            var updatedDrug = updatedDrugs[i] with { Id = i + 1 };
            updatedDrugs[i] = updatedDrug;
        }
        
        _editingPrescription = _editingPrescription with { Drugs = updatedDrugs };
        StateHasChanged();
    }
    
    // Add Prescription Methods
    private void OpenAddPrescriptionModal()
    {
        _newPrescriptionNumber = string.Empty;
        _newPrescriptionDate = DateTime.Now;
        _newPrescriptionType = "Standard";
        _newPrescriptionStatus = "Submitted";
        _drugSearchForAdd = string.Empty;
        _newPrescriptionDrugs = new();
        _showAddPrescriptionModal = true;
        StateHasChanged();
    }
    
    private void CloseAddPrescriptionModal()
    {
        _showAddPrescriptionModal = false;
        _newPrescriptionDrugs = new();
        _drugSearchForAdd = string.Empty;
        _useSearchDrug = true;
        _newCustomDrugName = string.Empty;
        _newCustomDrugCode = string.Empty;
        _newCustomDrugCategory = string.Empty;
        _newCustomDrugIndication = string.Empty;
        _newCustomDrugRestriction = string.Empty;
        _newCustomDrugDosage = string.Empty;
        StateHasChanged();
    }
    
    private void AddDrugToNewPrescription(Drug drug)
    {
        // Check if drug already added
        if (_newPrescriptionDrugs.Any(d => d.Drug?.Id == drug.Id))
        {
            return; // Already added
        }
        
        var editableDrug = new EditableDrugItem
        {
            Id = _newPrescriptionDrugs.Count + 1,
            Drug = drug,
            DrugName = drug.Name,
            DrugCode = drug.DrugCode,
            Category = drug.Category,
            Indication = drug.Indication,
            Restriction = drug.Restrictions,
            Dosage = drug.Dosage,
            Quantity = 1.00m,
            Frequency = string.Empty,
            Duration = string.Empty,
            Reason = string.Empty,
            Notes = string.Empty,
            IsCustom = false
        };
        
        _newPrescriptionDrugs.Add(editableDrug);
        _drugSearchForAdd = string.Empty; // Clear search
        StateHasChanged();
    }
    
    private void AddCustomDrugToNewPrescription()
    {
        if (string.IsNullOrWhiteSpace(_newCustomDrugName) || string.IsNullOrWhiteSpace(_newCustomDrugCode))
        {
            return;
        }
        
        var editableDrug = new EditableDrugItem
        {
            Id = _newPrescriptionDrugs.Count + 1,
            Drug = null,
            DrugName = _newCustomDrugName,
            DrugCode = _newCustomDrugCode,
            Category = _newCustomDrugCategory,
            Indication = _newCustomDrugIndication,
            Restriction = _newCustomDrugRestriction,
            Dosage = _newCustomDrugDosage,
            Quantity = 1.00m,
            Frequency = string.Empty,
            Duration = string.Empty,
            Reason = string.Empty,
            Notes = string.Empty,
            IsCustom = true
        };
        
        _newPrescriptionDrugs.Add(editableDrug);
        
        // Clear custom drug fields
        _newCustomDrugName = string.Empty;
        _newCustomDrugCode = string.Empty;
        _newCustomDrugCategory = string.Empty;
        _newCustomDrugIndication = string.Empty;
        _newCustomDrugRestriction = string.Empty;
        _newCustomDrugDosage = string.Empty;
        
        StateHasChanged();
    }
    
    private void RemoveDrugFromNewPrescription(EditableDrugItem drug)
    {
        _newPrescriptionDrugs.Remove(drug);
        
        // Re-number remaining drugs
        for (int i = 0; i < _newPrescriptionDrugs.Count; i++)
        {
            _newPrescriptionDrugs[i].Id = i + 1;
        }
        
        StateHasChanged();
    }
    
    private void SaveNewPrescription()
    {
        if (!_newPrescriptionDrugs.Any())
        {
            return;
        }
        
        // Generate prescription number if empty
        var prescriptionNumber = string.IsNullOrWhiteSpace(_newPrescriptionNumber)
            ? $"RX-{DateTime.Now:yyyyMMdd}-{ViewModel.Prescriptions.Count + 1:000}"
            : _newPrescriptionNumber;
        
        // Convert EditableDrugItem to SelectedDrug
        var selectedDrugs = _newPrescriptionDrugs.Select(d => d.ToSelectedDrug()).ToList();
        
        ViewModel.CreatePrescription(
            prescriptionNumber,
            _newPrescriptionDate,
            _newPrescriptionType,
            _newPrescriptionStatus,
            selectedDrugs
        );
        
        _statusMessage = $"Prescription {prescriptionNumber} created successfully!";
        _isSuccess = true;
        
        CloseAddPrescriptionModal();
        
        // Clear message after 3 seconds
        Task.Delay(3000).ContinueWith(_ =>
        {
            _statusMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        });
        
        StateHasChanged();
    }
    
    // Print and PDF Generation
    private async Task PrintPrescription()
    {
        if (_lastSubmittedPrescription == null) return;
        
        var prescriptionHtml = GeneratePrescriptionHTML(_lastSubmittedPrescription);
        
        await JS.InvokeVoidAsync("printPrescription", prescriptionHtml, _lastSubmittedPrescription.PrescriptionNumber);
    }
    
    private async Task GeneratePDFPrescription()
    {
        if (_lastSubmittedPrescription == null) return;
        
        var prescriptionHtml = GeneratePrescriptionHTML(_lastSubmittedPrescription);
        var fileName = $"{_lastSubmittedPrescription.PrescriptionNumber}_Prescription.pdf";
        
        await JS.InvokeVoidAsync("generatePrescriptionPDF", prescriptionHtml, fileName);
    }
    
    private string GeneratePrescriptionHTML(Prescription prescription)
    {
        var html = new System.Text.StringBuilder();
        
        // Helper function to escape HTML
        string EscapeHtml(string? text) => System.Net.WebUtility.HtmlEncode(text ?? string.Empty);
        
        html.AppendLine("<!DOCTYPE html>");
        html.AppendLine("<html>");
        html.AppendLine("<head>");
        html.AppendLine("<meta charset='UTF-8'>");
        html.AppendLine("<title>Prescription - " + EscapeHtml(prescription.PrescriptionNumber) + "</title>");
        html.AppendLine("<style>");
        html.AppendLine("@media print {");
        html.AppendLine("  @page { size: A4; margin: 20mm; }");
        html.AppendLine("  body { margin: 0; padding: 0; }");
        html.AppendLine("}");
        html.AppendLine("body { font-family: 'Times New Roman', Times, serif; padding: 20px; color: #000; }");
        html.AppendLine(".prescription-header { text-align: center; border-bottom: 2px solid #000; padding-bottom: 15px; margin-bottom: 20px; }");
        html.AppendLine(".prescription-header h1 { margin: 0 0 5px 0; font-size: 24px; font-weight: bold; }");
        html.AppendLine(".prescription-header h2 { margin: 0; font-size: 18px; font-weight: normal; }");
        html.AppendLine(".prescription-info { margin-bottom: 20px; }");
        html.AppendLine(".prescription-info table { width: 100%; border-collapse: collapse; }");
        html.AppendLine(".prescription-info td { padding: 5px 0; }");
        html.AppendLine(".prescription-info td.label { font-weight: bold; width: 150px; }");
        html.AppendLine(".drugs-section { margin-top: 30px; }");
        html.AppendLine(".drug-table { width: 100%; border-collapse: collapse; margin-top: 20px; }");
        html.AppendLine(".drug-table th { background: #f1f5f9; padding: 12px; text-align: left; border: 1px solid #ddd; font-weight: bold; }");
        html.AppendLine(".drug-table td { padding: 10px 12px; border: 1px solid #ddd; }");
        html.AppendLine(".drug-table tr:nth-child(even) { background: #f9fafb; }");
        html.AppendLine("</style>");
        html.AppendLine("</head>");
        html.AppendLine("<body>");
        
        // Header
        html.AppendLine("<div class='prescription-header'>");
        html.AppendLine("<h1>PRESCRIPTION</h1>");
        html.AppendLine("<h2>Beauty Aesthetics Clinic</h2>");
        html.AppendLine("</div>");
        
        // Prescription Information
        html.AppendLine("<div class='prescription-info'>");
        html.AppendLine("<table>");
        html.AppendLine("<tr><td class='label'>Prescription Number:</td><td>" + EscapeHtml(prescription.PrescriptionNumber) + "</td></tr>");
        html.AppendLine("<tr><td class='label'>Date:</td><td>" + EscapeHtml(prescription.Date.ToString("MMMM dd, yyyy 'at' hh:mm tt")) + "</td></tr>");
        html.AppendLine("</table>");
        html.AppendLine("</div>");
        
        // Drugs Section - Simplified Table
        html.AppendLine("<div class='drugs-section'>");
        html.AppendLine("<h3 style='margin-bottom: 15px;'>Prescribed Medications</h3>");
        html.AppendLine("<table class='drug-table'>");
        html.AppendLine("<thead>");
        html.AppendLine("<tr>");
        html.AppendLine("<th>Name</th>");
        html.AppendLine("<th>Drug Code</th>");
        html.AppendLine("<th>Dosage</th>");
        html.AppendLine("<th>Frequency</th>");
        html.AppendLine("<th>Duration</th>");
        html.AppendLine("<th>Reason</th>");
        html.AppendLine("</tr>");
        html.AppendLine("</thead>");
        html.AppendLine("<tbody>");
        
        foreach (var drug in prescription.Drugs)
        {
            html.AppendLine("<tr>");
            html.AppendLine("<td>" + EscapeHtml(drug.Drug.Name) + "</td>");
            html.AppendLine("<td>" + EscapeHtml(drug.Drug.DrugCode) + "</td>");
            html.AppendLine("<td>" + EscapeHtml(drug.Drug.Dosage ?? "-") + "</td>");
            html.AppendLine("<td>" + EscapeHtml(drug.Frequency) + "</td>");
            html.AppendLine("<td>" + EscapeHtml(drug.Duration) + "</td>");
            html.AppendLine("<td>" + EscapeHtml(drug.Reason) + "</td>");
            html.AppendLine("</tr>");
        }
        
        html.AppendLine("</tbody>");
        html.AppendLine("</table>");
        html.AppendLine("</div>");
        
        // Footer with Signature
        html.AppendLine("<div style='margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd;'>");
        if (!string.IsNullOrEmpty(_signatureDataUrl))
        {
            html.AppendLine("<div style='margin-top: 20px;'>");
            html.AppendLine("<img src='" + EscapeHtml(_signatureDataUrl) + "' style='max-width: 200px; max-height: 80px; margin-bottom: 10px;' alt='Doctor Signature' />");
            html.AppendLine("</div>");
        }
        else
        {
            html.AppendLine("<div style='border-top: 1px solid #000; width: 200px; margin-top: 50px;'></div>");
        }
        html.AppendLine("<div style='margin-top: 5px; font-size: 12px;'>Physician Signature</div>");
        html.AppendLine("</div>");
        
        html.AppendLine("</body>");
        html.AppendLine("</html>");
        
        return html.ToString();
    }
