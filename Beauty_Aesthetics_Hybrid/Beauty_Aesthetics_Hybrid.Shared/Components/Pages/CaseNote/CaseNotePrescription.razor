                                                    <div class="drug-detail-item">
                                                        <label>Restriction</label>
                                                        <div class="drug-detail-value">@(string.IsNullOrEmpty(drugItem.Restriction) ? "N/A" : drugItem.Restriction)</div>
                                                    </div>
                                                    <div class="drug-detail-item">
                                                        <label>Dosage</label>
                                                        <div class="drug-detail-value">@(string.IsNullOrEmpty(drugItem.Dosage) ? "N/A" : drugItem.Dosage)</div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="drug-details-section">
                                                <div class="drug-details-grid">
                                                    <div class="drug-detail-item">
                                                        <label>Indication</label>
                                                        <div class="drug-detail-value">@drugItem.Drug.Indication</div>
                                                    </div>
                                                    <div class="drug-detail-item">
                                                        <label>Restriction</label>
                                                        <div class="drug-detail-value">@drugItem.Drug.Restrictions</div>
                                                    </div>
                                                    <div class="drug-detail-item">
                                                        <label>Dosage</label>
