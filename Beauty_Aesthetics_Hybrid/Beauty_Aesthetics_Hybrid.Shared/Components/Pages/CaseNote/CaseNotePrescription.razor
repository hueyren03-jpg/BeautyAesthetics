@page "/case-note-prescription"
@using Beauty_Aesthetics_WebPos.Components.Layout
@layout EmptyLayout
@using Beauty_Aesthetics_WebPos.Components.ViewModels
@using static Beauty_Aesthetics_WebPos.Components.ViewModels.CaseNotePrescriptionViewModel
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS

<PageTitle>Prescription</PageTitle>

<div class="prescription-container">
    <header class="prescription-mobile-header">
        <a href="/case-notes" aria-label="Back to Case Notes"><i class="bi bi-arrow-left"></i></a>
        <h1>Prescription</h1>
        <a href="/prescription-builder" aria-label="Manage Prescriptions"><i class="bi bi-clipboard-check"></i></a>
    </header>
    <nav class="prescription-mobile-tabs" aria-label="Prescription sections">
        <button type="button" class="@(_mobilePanel == "catalog" ? "active" : "")" @onclick='() => _mobilePanel = "catalog"'>
            <i class="bi bi-search"></i><span>Catalog</span>
        </button>
        <button type="button" class="@(_mobilePanel == "selected" ? "active" : "")" @onclick='() => _mobilePanel = "selected"'>
            <i class="bi bi-clipboard2-pulse"></i><span>Prescription</span>
            @if (ViewModel.SelectedDrugs.Any()) { <b>@ViewModel.SelectedDrugs.Count</b> }
        </button>
    </nav>

    <div class="prescription-content mobile-panel-@_mobilePanel">
        <!-- Left Panel - Drug Search & List -->
        <div class="drug-list-panel">
            <!-- Search Bar -->
            <div class="search-section">
                <div class="search-box-large">
                    <i class="bi bi-search search-icon"></i>
                    <input 
                        type="text" 
                        class="search-input-large" 
                        @bind="ViewModel.SearchTerm" 
                        @bind:event="oninput" 
                        placeholder="Search treatments or products..." />
                    @if (!string.IsNullOrWhiteSpace(ViewModel.SearchTerm))
                    {
                        <button class="search-clear-btn" @onclick="() => ViewModel.SearchTerm = string.Empty">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>
                
                <!-- Category Filter -->
                <div class="category-filter-section">
                    <label class="filter-label">Category:</label>
                    <div class="custom-dropdown-wrapper">
                        <div class="custom-dropdown-trigger @(_isCategoryDropdownOpen ? "open" : "")" @onclick="ToggleCategoryDropdown">
                            <span>@(string.IsNullOrEmpty(ViewModel.SelectedCategory) ? "All Categories" : ViewModel.SelectedCategory)</span>
                            <i class="bi bi-chevron-down dropdown-arrow"></i>
                        </div>
                        @if (_isCategoryDropdownOpen)
                        {
                            <div class="custom-dropdown-menu">
                                <div class="dropdown-item @(string.IsNullOrEmpty(ViewModel.SelectedCategory) ? "selected" : "")" 
                                     @onclick="@(() => SelectCategory(""))">
                                    All Categories
                                </div>
                                @if (ViewModel.AvailableCategories != null)
                                {
                                    @foreach (var category in ViewModel.AvailableCategories)
                                    {
                                        <div class="dropdown-item @(ViewModel.SelectedCategory == category ? "selected" : "")" 
                                             @onclick="@(() => SelectCategory(category))">
                                            @category
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                    
                    <!-- Text Size Control -->
                    <div class="text-size-control">
                        <label class="filter-label">Text Size:</label>
                        <div class="text-size-buttons">
                            <button class="btn-text-size" 
                                    @onclick="DecreaseTextSize"
                                    disabled="@(_textSizeLevel <= 0)"
                                    title="Decrease text size">
                                <i class="bi bi-type"></i>
                                <i class="bi bi-dash-lg"></i>
                            </button>
                            <span class="text-size-indicator">@GetTextSizeLabel()</span>
                            <button class="btn-text-size" 
                                    @onclick="IncreaseTextSize"
                                    disabled="@(_textSizeLevel >= 2)"
                                    title="Increase text size">
                                <i class="bi bi-type"></i>
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Manage Prescriptions Button -->
                    <a href="/prescription-builder" class="btn-manage-prescriptions" title="Manage Prescriptions">
                        <i class="bi bi-clipboard-check"></i>
                        <span>Manage Prescriptions</span>
                    </a>
                </div>
            </div>

            <!-- Treatment / Product List Table -->
            <div class="drug-table-wrapper">
                @* Debug: @ViewModel.FilteredDrugs.Count() drugs found *@
                <table class="drug-table @GetTextSizeClass()">
                    <thead>
                        <tr>
                            <th class="col-drug">Treatments / Products</th>
                            <th class="col-indication">Indication</th>
                            <th class="col-restriction">Restriction</th>
                            <th class="col-dosage">Dosage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var drug in GetPaginatedDrugs())
                        {
                            <tr class="drug-row @(ViewModel.SelectedDrugToAdd?.Id == drug.Id ? "selected" : "")" 
                                @onclick="@(() => HandleDrugClick(drug))">
                                <td class="col-drug">
                                    <div class="drug-info-cell">
                                        @if (ViewModel.SelectedDrugToAdd?.Id == drug.Id)
                                        {
                                            <i class="bi bi-circle-fill selected-dot"></i>
                                        }
                                        <div class="drug-details">
                                            <div class="drug-name-row">@drug.Name</div>
                                            <div class="drug-meta-row">
                                                <span class="meta-label">Drug Code:</span>
                                                <span class="meta-value">@drug.DrugCode</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(drug.Category))
                                            {
                                                <div class="drug-meta-row">
                                                    <span class="meta-label">Category:</span>
                                                    <span class="meta-value">@drug.Category</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="col-indication">
                                    <div class="cell-content">@drug.Indication</div>
                                </td>
                                <td class="col-restriction">
                                    <div class="cell-content">@drug.Restrictions</div>
                                </td>
                                <td class="col-dosage">
                                    <div class="cell-content">@drug.Dosage</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                
                <!-- Pagination Controls -->
                @if (GetTotalPages() > 1)
                {
                    <div class="pagination-container">
                        <div class="pagination-info">
                            <span>Showing @((_currentPage - 1) * _itemsPerPage + 1) - @(Math.Min(_currentPage * _itemsPerPage, ViewModel.FilteredDrugs.Count())) of @ViewModel.FilteredDrugs.Count() treatments/products</span>
                        </div>
                        <div class="pagination-controls">
                            <button class="btn-pagination" 
                                    @onclick="GoToPreviousPage" 
                                    disabled="@(_currentPage == 1)"
                                    title="Previous Page">
                                <i class="bi bi-chevron-left"></i>
                                <span>Previous</span>
                            </button>
                            <div class="page-numbers">
                                @for (int i = 1; i <= GetTotalPages(); i++)
                                {
                                    var pageNum = i;
                                    @if (i == 1 || i == GetTotalPages() || (i >= _currentPage - 1 && i <= _currentPage + 1))
                                    {
                                        <button class="btn-page-number @(i == _currentPage ? "active" : "")" 
                                                @onclick="() => GoToPage(pageNum)">
                                            @i
                                        </button>
                                    }
                                    else if (i == _currentPage - 2 || i == _currentPage + 2)
                                    {
                                        <span class="page-ellipsis">...</span>
                                    }
                                }
                            </div>
                            <button class="btn-pagination" 
                                    @onclick="GoToNextPage" 
                                    disabled="@(_currentPage >= GetTotalPages())"
                                    title="Next Page">
                                <span>Next</span>
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Resizer -->
        <div class="panel-resizer">
            <div class="resizer-handle"></div>
        </div>

        <!-- Right Panel - Prescription Details -->
        <div class="selected-drugs-panel">
            <div class="right-panel-content">
                @if (ViewModel.SelectedDrugToAdd != null)
                {
                    <div class="add-drug-form">
                        <div class="selected-drug-header">
                            <i class="bi bi-circle-fill header-dot"></i>
                            <div class="header-info">
                                <h4>@ViewModel.SelectedDrugToAdd.Name</h4>
                                <p>Drug Code: @ViewModel.SelectedDrugToAdd.DrugCode</p>
                            </div>
                            <button class="btn-cancel-selection" 
                                    @onclick="CancelDrugSelection"
                                    title="Cancel">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="form-container">
                            <div class="form-row">
                                <label class="form-label">Dosage</label>
                                <input 
                                    type="number" 
                                    class="form-control" 
                                    @bind="ViewModel.NewDrugQuantity" 
                                    step="0.01" 
                                    min="0" 
                                    placeholder="1.00" />
                            </div>

                            <div class="form-row">
                                <div class="form-label-row">
                                    <label class="form-label">Frequency</label>
                                    <button class="btn-toggle-input" 
                                            @onclick="() => { _manualFrequency = !_manualFrequency; StateHasChanged(); }"
                                            title="@(_manualFrequency ? "Switch to dropdown" : "Switch to manual entry")"
                                            type="button">
                                        <i class="bi @(_manualFrequency ? "bi-list-check" : "bi-pencil-square")"></i>
                                    </button>
                                </div>
                                @if (_manualFrequency)
                                {
                                    <input 
                                        type="text" 
                                        class="form-control" 
                                        @bind="ViewModel.NewDrugFrequency" 
                                        placeholder="Enter frequency manually" />
                                }
                                else
                                {
                                    <select class="form-control" @bind="ViewModel.NewDrugFrequency">
                                        <option value="">- SELECT FREQUENCY -</option>
                                        @foreach (var freq in ViewModel.FrequencyOptions)
                                        {
                                            <option value="@freq">@freq</option>
                                        }
                                    </select>
                                }
                            </div>

                            <div class="form-row">
                                <div class="form-label-row">
                                    <label class="form-label">Duration</label>
                                    <button class="btn-toggle-input" 
                                            @onclick="() => { _manualDuration = !_manualDuration; StateHasChanged(); }"
                                            title="@(_manualDuration ? "Switch to dropdown" : "Switch to manual entry")"
                                            type="button">
                                        <i class="bi @(_manualDuration ? "bi-list-check" : "bi-pencil-square")"></i>
                                    </button>
                                </div>
                                @if (_manualDuration)
                                {
                                    <input 
                                        type="text" 
                                        class="form-control" 
                                        @bind="ViewModel.NewDrugDuration" 
                                        placeholder="Enter duration manually" />
                                }
                                else
                                {
                                    <select class="form-control" @bind="ViewModel.NewDrugDuration">
                                        <option value="">- SELECT -</option>
                                        @foreach (var duration in ViewModel.DurationOptions)
                                        {
                                            <option value="@duration">@duration</option>
                                        }
                                    </select>
                                }
                            </div>

                            <div class="form-row">
                                <div class="form-label-row">
                                    <label class="form-label">Reason</label>
                                    <button class="btn-toggle-input" 
                                            @onclick="() => { _manualReason = !_manualReason; StateHasChanged(); }"
                                            title="@(_manualReason ? "Switch to dropdown" : "Switch to manual entry")"
                                            type="button">
                                        <i class="bi @(_manualReason ? "bi-list-check" : "bi-pencil-square")"></i>
                                    </button>
                                </div>
                                @if (_manualReason)
                                {
                                    <input 
                                        type="text" 
                                        class="form-control" 
                                        @bind="ViewModel.NewDrugReason" 
                                        placeholder="Enter reason manually" />
                                }
                                else
                                {
                                    <select class="form-control" @bind="ViewModel.NewDrugReason">
                                        <option value="">- SELECT REASON -</option>
                                        @foreach (var reason in ViewModel.ReasonOptions)
                                        {
                                            <option value="@reason">@reason</option>
                                        }
                                    </select>
                                }
                            </div>

                            <div class="form-row">
                                <label class="form-label">Notes</label>
                                <textarea 
                                    class="form-control form-textarea" 
                                    @bind="ViewModel.NewDrugNotes" 
                                    rows="3" 
                                    placeholder="Add notes"></textarea>
                            </div>
                        </div>

                        <button 
                            class="btn-confirm" 
                            @onclick="HandleAddDrug"
                            disabled="@(string.IsNullOrEmpty(ViewModel.NewDrugFrequency) || string.IsNullOrEmpty(ViewModel.NewDrugDuration) || string.IsNullOrEmpty(ViewModel.NewDrugReason))">
                            <i class="bi bi-check-circle-fill"></i>
                            Confirm & Add
                        </button>
                    </div>
                }
                else if (!ViewModel.SelectedDrugs.Any())
                {
                    <div class="empty-state-right">
                        <i class="bi bi-arrow-left-circle"></i>
                        <h3>Select a Treatment or Product</h3>
                        <p>Click on any treatment or product from the left to specify usage details</p>
                    </div>
                }

                @if (ViewModel.SelectedDrugs.Any())
                {
                    <div class="selected-drugs-list">
                    @foreach (var selected in ViewModel.SelectedDrugs)
                    {
                        <div class="prescription-item">
                            <div class="item-header">
                                <div class="item-number">@selected.Id</div>
                                <div class="item-info">
                                    <h4>@selected.Drug.Name</h4>
                                    <span class="item-code">@selected.Drug.DrugCode</span>
                                </div>
                                <button class="btn-remove-small" @onclick="() => ViewModel.RemoveSelectedDrug(selected)" title="Remove">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="item-details">
                                <div class="detail-row">
                                    <i class="bi bi-capsule"></i>
                                    <span class="detail-label">Qty:</span>
                                    <span class="detail-value">@selected.Quantity</span>
                                </div>
                                <div class="detail-row">
                                    <i class="bi bi-arrow-repeat"></i>
                                    <span class="detail-label">Frequency:</span>
                                    <span class="detail-value">@selected.Frequency</span>
                                </div>
                                <div class="detail-row">
                                    <i class="bi bi-calendar-range"></i>
                                    <span class="detail-label">Duration:</span>
                                    <span class="detail-value">@selected.Duration</span>
                                </div>
                                <div class="detail-row full">
                                    <i class="bi bi-file-medical"></i>
                                    <span class="detail-label">Reason:</span>
                                    <span class="detail-value">@selected.Reason</span>
                                </div>
                                @if (!string.IsNullOrEmpty(selected.Notes))
                                {
                                    <div class="detail-row full">
                                        <i class="bi bi-sticky"></i>
                                        <span class="detail-label">Notes:</span>
                                        <span class="detail-value">@selected.Notes</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    </div>
                }
            </div>

            <!-- Footer Actions in Right Panel -->
            <div class="right-panel-footer">
                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <div class="status-message @(_isSuccess ? "status-success" : "status-error")">
                        <i class="bi @(_isSuccess ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
                        <span>@_statusMessage</span>
                    </div>
                }
                <a href="/case-notes" class="btn-close-footer">
                    <i class="bi bi-x-lg"></i>
                </a>
                <button class="btn-submit" 
                        @onclick="HandleSubmit"
                        disabled="@(!ViewModel.SelectedDrugs.Any())">
                    <i class="bi bi-send-fill"></i>
                    Submit Prescription
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Prescription Modal -->
@if (_showEditPrescriptionModal && _editingPrescription != null)
{
    <div class="modal-overlay" @onclick="CloseEditPrescriptionModal">
        <div class="modal-content-edit-prescription" @onclick:stopPropagation="true">
            <div class="modal-header-prescription">
                <h3>
                    <i class="bi bi-pencil-square"></i>
                    Edit Prescription: @_editingPrescription.PrescriptionNumber
                </h3>
                <button class="btn-close-modal" @onclick="CloseEditPrescriptionModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            
            <div class="modal-body-edit-prescription">
                <div class="edit-prescription-form">
                    <div class="form-row">
                        <label class="form-label">Prescription Number</label>
                        <input type="text" 
                               class="form-control" 
                               @bind="_editingPrescriptionNumber" 
                               readonly />
                    </div>
                    
                    <div class="form-row">
                        <label class="form-label">Date</label>
                        <input type="datetime-local" 
                               class="form-control" 
                               value="@_editingPrescriptionDate.ToString("yyyy-MM-ddTHH:mm")"
                               @onchange="@((ChangeEventArgs e) => {
                                   if (DateTime.TryParse(e.Value?.ToString(), out var date))
                                   {
                                       _editingPrescriptionDate = date;
                                   }
                               })" />
                    </div>
                    
                    <div class="form-row">
                        <label class="form-label">Type</label>
                        <select class="form-control" @bind="_editingPrescriptionType">
                            <option value="Standard">Standard</option>
                            <option value="Emergency">Emergency</option>
                            <option value="Repeat">Repeat</option>
                        </select>
                    </div>
                    
                    <div class="form-row">
                        <label class="form-label">Status</label>
                        <select class="form-control" @bind="_editingPrescriptionStatus">
                            <option value="Submitted">Submitted</option>
                            <option value="Dispensed">Dispensed</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                    
                    <div class="form-row">
                        <label class="form-label">Drugs (@_editingPrescription.Drugs.Count)</label>
                        <div class="edit-drugs-list">
                            @foreach (var drug in _editingPrescription.Drugs)
                            {
                                <div class="edit-drug-item">
                                    <div class="edit-drug-info">
                                        <i class="bi bi-capsule"></i>
                                        <div>
                                            <div class="edit-drug-name">@drug.Drug.Name</div>
                                            <div class="edit-drug-details">
                                                Qty: @drug.Quantity | @drug.Frequency | @drug.Duration
                                            </div>
                                        </div>
                                    </div>
                                    <button class="btn-remove-drug-edit" 
                                            @onclick="() => RemoveDrugFromEdit(drug)"
                                            title="Remove">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer-prescription">
                <button class="btn-cancel-edit" @onclick="CloseEditPrescriptionModal">
                    <i class="bi bi-x-circle"></i>
                    Cancel
                </button>
                <button class="btn-save-edit" @onclick="SaveEditedPrescription">
                    <i class="bi bi-check-circle"></i>
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

<!-- Add Prescription Modal -->
@if (_showAddPrescriptionModal)
{
    <div class="modal-overlay" @onclick="CloseAddPrescriptionModal">
        <div class="modal-content-add-prescription" @onclick:stopPropagation="true">
            <div class="modal-header-prescription">
                <h3>
                    <i class="bi bi-plus-circle"></i>
                    Add New Prescription
                </h3>
                <button class="btn-close-modal" @onclick="CloseAddPrescriptionModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            
            <div class="modal-body-add-prescription">
                <div class="add-prescription-form">
                    <!-- Prescription Basic Information Section -->
                    <div class="prescription-info-section">
                        <h4 class="section-title">
                            <i class="bi bi-info-circle"></i>
                            Prescription Information
                        </h4>
                        <div class="prescription-info-grid">
                            <div class="prescription-info-field">
                                <label class="form-label">Prescription Number</label>
                                <input type="text" 
                                       class="form-control" 
                                       @bind="_newPrescriptionNumber" 
                                       placeholder="Auto-generated if empty" />
                                <small class="form-hint">Leave empty to auto-generate (RX-YYYYMMDD-XXX)</small>
                            </div>
                            
                            <div class="prescription-info-field">
                                <label class="form-label">Date</label>
                                <input type="datetime-local" 
                                       class="form-control" 
                                       value="@_newPrescriptionDate.ToString("yyyy-MM-ddTHH:mm")"
                                       @onchange="@((ChangeEventArgs e) => {
                                           if (DateTime.TryParse(e.Value?.ToString(), out var date))
                                           {
                                               _newPrescriptionDate = date;
                                           }
                                       })" />
                            </div>
                            
                            <div class="prescription-info-field">
                                <label class="form-label">Type</label>
                                <select class="form-control" @bind="_newPrescriptionType">
                                    <option value="Standard">Standard</option>
                                    <option value="Emergency">Emergency</option>
                                    <option value="Repeat">Repeat</option>
                                </select>
                            </div>
                            
                            <div class="prescription-info-field">
                                <label class="form-label">Status</label>
                                <select class="form-control" @bind="_newPrescriptionStatus">
                                    <option value="Submitted">Submitted</option>
                                    <option value="Dispensed">Dispensed</option>
                                    <option value="Cancelled">Cancelled</option>
                                    <option value="Completed">Completed</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Add Drugs Section -->
                    <div class="add-drugs-section">
                        <h4 class="section-title">
                            <i class="bi bi-capsule"></i>
                            Add Drugs
                        </h4>
                        <div class="add-drug-options">
                            <div class="drug-add-tabs">
                                <button class="drug-tab-btn @(_useSearchDrug ? "active" : "")" 
                                        @onclick="() => { _useSearchDrug = true; StateHasChanged(); }">
                                    <i class="bi bi-search"></i>
                                    Search Existing Drug
                                </button>
                                <button class="drug-tab-btn @(!_useSearchDrug ? "active" : "")" 
                                        @onclick="() => { _useSearchDrug = false; StateHasChanged(); }">
                                    <i class="bi bi-plus-circle"></i>
                                    Create New Drug
                                </button>
                            </div>
                            
                            @if (_useSearchDrug)
                            {
                                <div class="add-drug-search-section">
                                    <div class="drug-search-box">
                                        <i class="bi bi-search"></i>
                                        <input type="text" 
                                               class="drug-search-input" 
                                               @bind="_drugSearchForAdd" 
                                               @bind:event="oninput"
                                               placeholder="Search drugs to add..." />
                                        @if (!string.IsNullOrWhiteSpace(_drugSearchForAdd))
                                        {
                                            <button class="search-clear-btn-small" @onclick="() => _drugSearchForAdd = string.Empty">
                                                <i class="bi bi-x-circle-fill"></i>
                                            </button>
                                        }
                                    </div>
                                    
                                    @if (!string.IsNullOrWhiteSpace(_drugSearchForAdd))
                                    {
                                        <div class="drug-search-results">
                                            @foreach (var drug in ViewModel.Drugs.Where(d => 
                                                d.Name.Contains(_drugSearchForAdd, StringComparison.OrdinalIgnoreCase) ||
                                                d.DrugCode.Contains(_drugSearchForAdd, StringComparison.OrdinalIgnoreCase)).Take(5))
                                            {
                                                <button class="drug-search-result-item" @onclick="() => AddDrugToNewPrescription(drug)">
                                                    <i class="bi bi-capsule"></i>
                                                    <div class="drug-result-info">
                                                        <div class="drug-result-name">@drug.Name</div>
                                                        <div class="drug-result-code">@drug.DrugCode</div>
                                                    </div>
                                                    <i class="bi bi-plus-circle"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="create-drug-form">
                                    <div class="create-drug-grid">
                                        <div class="create-drug-field">
                                            <label>Drug Name *</label>
                                            <input type="text" 
                                                   class="form-control" 
                                                   @bind="_newCustomDrugName" 
                                                   placeholder="Enter drug name" />
                                        </div>
                                        <div class="create-drug-field">
                                            <label>Drug Code *</label>
                                            <input type="text" 
                                                   class="form-control" 
                                                   @bind="_newCustomDrugCode" 
                                                   placeholder="Enter drug code" />
                                        </div>
                                        <div class="create-drug-field">
                                            <label>Category</label>
                                            <div class="custom-dropdown-wrapper form-dropdown">
