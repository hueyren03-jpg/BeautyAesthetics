    private async Task ConfirmDelete()
    {
        if (_followUpToDelete.HasValue)
        {
            ViewModel.DeleteFollowUp(_followUpToDelete.Value);
            
            // If deleting the currently viewed follow-up, clear editor
            if (_currentlyViewingFollowUpId == _followUpToDelete.Value)
            {
                _currentlyViewingFollowUpId = null;
                if (_isEditorReady)
                {
                    await JS.InvokeVoidAsync("clearEditor");
                }
            }
            
            _statusMessage = "Follow-up deleted successfully!";
            _isSuccess = true;
            Feedback.Success(_statusMessage, "Follow-up deleted");
        }
        
        // Close modal immediately
        _showDeleteModal = false;
        _followUpToDelete = null;
        StateHasChanged();
        
        // Auto-hide success message after delay (in background)
        _hideMessageCts?.Cancel();
        _hideMessageCts?.Dispose();
        _hideMessageCts = new CancellationTokenSource();
        
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(3000, _hideMessageCts.Token);
                _statusMessage = "";
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException) { }
        });
    }

