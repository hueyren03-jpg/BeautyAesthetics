    private async Task SaveFollowUp()
    {
        if (!_isEditorReady || ViewModel.SelectedPatient == null)
        {
            _statusMessage = ViewModel.SelectedPatient == null ? "Please select a patient" : "Editor not ready";
            _isSuccess = false;
            Feedback.Warning(_statusMessage, "Follow-up not saved");
            StateHasChanged();
            return;
        }

        _isSaving = true;
        _showSavingOverlay = true;
        _statusMessage = "";
        
        // Immediate UI feedback - don't wait for StateHasChanged
        await InvokeAsync(StateHasChanged);

        try
        {
            // Get content asynchronously
            var content = await JS.InvokeAsync<string>("getEditorContent");
            
            // Validate content early
            if (string.IsNullOrWhiteSpace(content))
            {
                _statusMessage = "Please write some follow-up notes";
                _isSuccess = false;
                Feedback.Warning(_statusMessage, "Follow-up not saved");
                _isSaving = false;
                _showSavingOverlay = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Process save operation in background without blocking UI
            var isUpdate = _currentlyViewingFollowUpId.HasValue;
            var followUpId = _currentlyViewingFollowUpId;
            
            // Offload heavy processing to Task.Run to avoid blocking UI thread
            await Task.Run(() =>
            {
                if (isUpdate && followUpId.HasValue)
                {
                    ViewModel.UpdateFollowUp(followUpId.Value, content);
                }
                else
                {
                    ViewModel.SaveFollowUp(content);
                }
            });
            
            // Update UI state after save completes
            _hasUnsavedChanges = false;
            _lastSavedContent = content;
            _currentlyViewingFollowUpId = null;
            _isSuccess = true;
            _statusMessage = isUpdate ? "Follow-up updated successfully!" : "Follow-up saved successfully!";
            Feedback.Success(
                _statusMessage,
                isUpdate ? "Follow-up updated" : "Follow-up saved");
            
            // Clear editor for new follow-ups (non-blocking)
            if (!isUpdate)
            {
                _ = JS.InvokeVoidAsync("clearEditor");
            }

            // Auto-hide message after delay
            _hideMessageCts?.Cancel();
            _hideMessageCts?.Dispose();
            _hideMessageCts = new CancellationTokenSource();
            
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(3000, _hideMessageCts.Token);
                    _statusMessage = "";
                    await InvokeAsync(StateHasChanged);
                }
                catch (TaskCanceledException) { }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BLAZOR] Error saving follow-up: {ex.Message}");
            _statusMessage = "Failed to save follow-up. Please try again.";
            _isSuccess = false;
            Feedback.Error(_statusMessage, "Follow-up not saved");
        }
        finally
        {
            _isSaving = false;
            _showSavingOverlay = false;
            await InvokeAsync(StateHasChanged);
        }
    }

