    private async Task CheckForPendingAnnotationImage()
    {
        if (!_isEditorReady) return;
        
        try
        {
            Console.WriteLine("[BLAZOR] Checking for pending annotation image...");
            var pendingImage = await JS.InvokeAsync<string>("localStorage.getItem", "pendingAnnotationImage");
            
            if (!string.IsNullOrEmpty(pendingImage))
            {
                Console.WriteLine($"[BLAZOR] Found pending image, size: {pendingImage.Length} characters");
                
                // Insert image into editor
                var insertSuccess = await JS.InvokeAsync<bool>("insertImageFromBase64", pendingImage);
                
                if (insertSuccess)
                {
                    // Clear from localStorage
                    await JS.InvokeVoidAsync("localStorage.removeItem", "pendingAnnotationImage");
                    
                    _statusMessage = "Annotated image inserted successfully!";
                    _isSuccess = true;
                    Console.WriteLine("[BLAZOR] ✓ Annotated image inserted successfully");
                    
                    // Auto-hide success message after 3 seconds
                    _hideMessageCts?.Cancel();
                    _hideMessageCts?.Dispose();
                    _hideMessageCts = new CancellationTokenSource();
                    
                    try
                    {
                        await Task.Delay(3000, _hideMessageCts.Token);
                        _statusMessage = "";
                        StateHasChanged();
                    }
                    catch (TaskCanceledException) { }
                }
                else
                {
                    Console.WriteLine("[BLAZOR] ✗ Failed to insert image into editor");
                    _statusMessage = "Failed to insert image. Please try again.";
                    _isSuccess = false;
                }
            }
            else
            {
                Console.WriteLine("[BLAZOR] No pending annotation image found");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BLAZOR] ✗ Error checking for pending image: {ex.Message}");
            Console.Error.WriteLine($"[ERROR] Pending image check failed: {ex.GetType().Name} - {ex.Message}");
        }
    }

