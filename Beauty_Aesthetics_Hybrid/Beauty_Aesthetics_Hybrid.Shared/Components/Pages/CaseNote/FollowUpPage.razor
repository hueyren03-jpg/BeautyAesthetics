    private List<string> GetFilteredEmojis()
    {
        if (string.IsNullOrWhiteSpace(_emojiSearchQuery))
        {
            return _emojiList;
        }
        
        // Filter emojis based on common categories and search patterns
        var query = _emojiSearchQuery.ToLower().Trim();
        
        // Simple category-based filtering
        var categoryMap = new Dictionary<string, List<string>>
        {
            { "smile", new List<string> { "😀", "😃", "😄", "😁", "😊", "🙂", "😇" } },
            { "happy", new List<string> { "😀", "😃", "😄", "😁", "😊", "😍", "🥰", "😘" } },
            { "love", new List<string> { "😍", "🥰", "😘", "❤️", "💕", "💖", "💗", "💓", "💞" } },
            { "heart", new List<string> { "❤️", "🧡", "💛", "💚", "💙", "💜", "🖤", "🤍", "💔" } },
            { "sad", new List<string> { "😢", "😭", "😔", "😞", "😟", "🥺" } },
            { "hand", new List<string> { "👍", "👎", "👌", "✌️", "🤞", "🤝", "👏", "🙌", "🙏" } },
            { "fire", new List<string> { "🔥" } },
            { "star", new List<string> { "⭐", "🌟", "✨" } },
            { "weather", new List<string> { "☀️", "🌤️", "⛅", "🌥️", "☁️", "🌧️", "⛈️", "❄️" } }
        };

        foreach (var category in categoryMap)
        {
            if (query.Contains(category.Key))
            {
                return category.Value.Intersect(_emojiList).ToList();
            }
        }
        
        return _emojiList;
    }

