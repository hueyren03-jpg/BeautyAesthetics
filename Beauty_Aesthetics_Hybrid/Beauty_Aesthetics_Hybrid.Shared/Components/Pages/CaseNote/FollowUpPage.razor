@page "/follow-up"
@using Beauty_Aesthetics_WebPos.Components.Layout
@layout EmptyLayout
@using Beauty_Aesthetics_WebPos.Components.ViewModels
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject FollowUpPageViewModel ViewModel
@inject AppFeedbackService Feedback
@implements IAsyncDisposable

<PageTitle>Follow Up - Beauty Aesthetics</PageTitle>

<div class="case-notes-page">
    @if (_isPageInitializing)
    {
        <div class="case-note-page-loading" role="status" aria-live="polite">
            <div class="case-note-page-loading__content">
                <span class="spinner-border" aria-hidden="true"></span>
                <span>Loading follow up...</span>
            </div>
        </div>
    }
    <!-- Mobile Top Header (only visible in portrait mode) -->
    <header class="mobile-header">
        <button class="btn-back-arrow" @onclick="NavigateToAppointments" title="Back to Appointments" aria-label="Back to Appointments">
            <i class="bi bi-arrow-left"></i>
        </button>
        <div class="header-title">
            <h2>Follow Up</h2>
        </div>
        <div class="mobile-header-actions">
            <button type="button"
                    class="btn-patient-drawer"
                    @onclick="TogglePatientDrawer"
                    title="View Patient Information"
                    aria-label="View Patient Information"
                    aria-expanded="@_isPatientDrawerOpen">
                <i class="bi bi-person-vcard"></i>
            </button>
            <button class="btn-history" @onclick="NavigateToHistory" title="View Follow Up History" aria-label="View Follow Up History">
                <i class="bi bi-clock-history"></i>
            </button>
        </div>
    </header>

    <!-- Main Layout -->
    <div class="main-layout">
        <!-- Sidebar - Follow Up History -->
        <aside class="sidebar @(_isSidebarCollapsed ? "collapsed" : "")">
            <div class="sidebar-header">
                <button class="btn-back-arrow" @onclick="NavigateToAppointments" title="Back to Appointments" aria-label="Back to Appointments">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <div class="sidebar-title">
                    <i class="bi bi-calendar-check"></i>
                    <h2>Follow Up History</h2>
                </div>
                <button class="btn-toggle-sidebar" @onclick="ToggleSidebar" title="@(_isSidebarCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
                    <i class="bi @(_isSidebarCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
                </button>
            </div>
            
            <!-- Search and Filter Section -->
            <div class="search-filter-section">
                <!-- Search Box -->
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" 
                           class="search-input" 
                           @bind="ViewModel.SearchQuery" 
                           @bind:event="oninput"
                           placeholder="Search by patient, content, or date..." />
                    @if (!string.IsNullOrWhiteSpace(ViewModel.SearchQuery))
                    {
                        <button class="search-clear-btn" @onclick="() => ViewModel.SearchQuery = string.Empty" title="Clear search">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>
                
                <!-- Date Filter Dropdown -->
                <div class="date-filter-wrapper">
                    <div class="date-filter @(_isDateFilterOpen ? "open" : "")" @onclick="ToggleDateFilter">
                        <i class="bi bi-calendar-range"></i>
                        <span class="date-filter-label">@GetDateFilterLabel()</span>
                        <i class="bi bi-chevron-down filter-arrow"></i>
                    </div>
                    
                    @if (_isDateFilterOpen)
                    {
                        <div class="date-filter-dropdown" @onclick:stopPropagation="true">
                            <div class="filter-option @(ViewModel.DateFilter == "all" ? "selected" : "")" 
                                 @onclick="@(() => SelectDateFilter("all"))">
                                <i class="bi bi-calendar-week"></i>
                                <span>All Dates</span>
                                @if (ViewModel.DateFilter == "all")
                                {
                                    <i class="bi bi-check-circle-fill check-icon"></i>
                                }
                            </div>
                            <div class="filter-option @(ViewModel.DateFilter == "today" ? "selected" : "")" 
                                 @onclick="@(() => SelectDateFilter("today"))">
                                <i class="bi bi-calendar-day"></i>
                                <span>Today</span>
                                @if (ViewModel.DateFilter == "today")
                                {
                                    <i class="bi bi-check-circle-fill check-icon"></i>
                                }
                            </div>
                            <div class="filter-option @(ViewModel.DateFilter == "yesterday" ? "selected" : "")" 
                                 @onclick="@(() => SelectDateFilter("yesterday"))">
                                <i class="bi bi-calendar-minus"></i>
                                <span>Yesterday</span>
                                @if (ViewModel.DateFilter == "yesterday")
                                {
                                    <i class="bi bi-check-circle-fill check-icon"></i>
                                }
                            </div>
                            <div class="filter-divider"></div>
                            <div class="filter-option @(ViewModel.DateFilter == "last7days" ? "selected" : "")" 
                                 @onclick="@(() => SelectDateFilter("last7days"))">
                                <i class="bi bi-calendar-range"></i>
                                <span>Last 7 Days</span>
                                @if (ViewModel.DateFilter == "last7days")
                                {
                                    <i class="bi bi-check-circle-fill check-icon"></i>
                                }
                            </div>
                            <div class="filter-option @(ViewModel.DateFilter == "last30days" ? "selected" : "")" 
                                 @onclick="@(() => SelectDateFilter("last30days"))">
                                <i class="bi bi-calendar-range"></i>
                                <span>Last 30 Days</span>
                                @if (ViewModel.DateFilter == "last30days")
                                {
                                    <i class="bi bi-check-circle-fill check-icon"></i>
                                }
                            </div>
                            <div class="filter-divider"></div>
                            <div class="filter-option @(ViewModel.DateFilter == "thisMonth" ? "selected" : "")" 
                                 @onclick="@(() => SelectDateFilter("thisMonth"))">
                                <i class="bi bi-calendar-month"></i>
                                <span>This Month</span>
                                @if (ViewModel.DateFilter == "thisMonth")
                                {
                                    <i class="bi bi-check-circle-fill check-icon"></i>
                                }
                            </div>
                            <div class="filter-option @(ViewModel.DateFilter == "lastMonth" ? "selected" : "")" 
                                 @onclick="@(() => SelectDateFilter("lastMonth"))">
                                <i class="bi bi-calendar-month"></i>
                                <span>Last Month</span>
                                @if (ViewModel.DateFilter == "lastMonth")
                                {
                                    <i class="bi bi-check-circle-fill check-icon"></i>
                                }
                            </div>
                            <div class="filter-divider"></div>
                            <div class="filter-option custom-option @(ViewModel.DateFilter == "custom" ? "selected" : "")" 
                                 @onclick="@(() => SelectDateFilter("custom"))">
                                <i class="bi bi-calendar2-range"></i>
                                <span>Custom Range</span>
                                @if (ViewModel.DateFilter == "custom")
                                {
                                    <i class="bi bi-check-circle-fill check-icon"></i>
                                }
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Custom Date Range -->
                @if (ViewModel.IsCustomDateRange)
                {
                    <div class="custom-date-range">
                        <div class="date-input-group">
                            <label>From:</label>
                            <input type="date" 
                                   class="date-input" 
                                   @bind="ViewModel.CustomStartDate" />
                        </div>
                        <div class="date-input-group">
                            <label>To:</label>
                            <input type="date" 
                                   class="date-input" 
                                   @bind="ViewModel.CustomEndDate" />
                        </div>
                    </div>
                }
                
                <!-- Clear Filters Button -->
                @if (!string.IsNullOrWhiteSpace(ViewModel.SearchQuery) || ViewModel.DateFilter != "all")
                {
                    <button class="btn-clear-filters" @onclick="() => ViewModel.ClearFilters()" title="Clear all filters">
                        <i class="bi bi-x-circle"></i>
                        <span>Clear Filters</span>
                    </button>
                }
            </div>
            
            <div class="sidebar-content">
                @if (ViewModel.FilteredFollowUpHistory.Any())
                {
                    @foreach (var followUp in ViewModel.FilteredFollowUpHistory)
                    {
                        <div class="history-card @(_currentlyViewingFollowUpId == followUp.Id ? "active" : "") @(followUp.IsPinned ? "pinned" : "")" 
                             @onclick="() => ViewFollowUp(followUp)">
                            <div class="history-card-header">
                                <span class="history-date">
                                    <i class="bi bi-calendar3"></i>
                                    @followUp.Date.ToString("MMM dd, yyyy")
                                </span>
                                <div class="history-card-actions">
                                    <button class="btn-pin @(followUp.IsPinned ? "pinned" : "")" 
                                            @onclick="() => TogglePin(followUp.Id)" 
                                            @onclick:stopPropagation="true" 
                                            title="@(followUp.IsPinned ? "Unpin" : "Pin to top")">
                                        <i class="bi @(followUp.IsPinned ? "bi-pin-fill" : "bi-pin")"></i>
                                    </button>
                                    <button class="btn-delete" @onclick="() => DeleteFollowUp(followUp.Id)" 
                                            @onclick:stopPropagation="true" title="Delete">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(followUp.ImageUrl))
                            {
                                <div class="history-image-preview">
                                    <img src="@followUp.ImageUrl" alt="Follow up preview" />
                                </div>
                            }

                            <p class="history-preview">@followUp.Preview</p>
                            <span class="history-patient">@followUp.PatientName</span>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        @if (!string.IsNullOrWhiteSpace(ViewModel.SearchQuery) || ViewModel.DateFilter != "all")
                        {
                            <i class="bi bi-search"></i>
                            <p>No follow-ups match your filters</p>
                            <button class="btn-reset-filters" @onclick="() => ViewModel.ClearFilters()">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                <span>Reset Filters</span>
                            </button>
                        }
                        else
                        {
                            <i class="bi bi-inbox"></i>
                            <p>No follow-up records yet</p>
                        }
                    </div>
                }
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="content-area">
            <!-- Patient Info Card - Collapsible -->
            @if (ViewModel.SelectedPatient != null)
            {
                @if (_isPatientDrawerOpen)
                {
                    <button type="button"
                            class="patient-drawer-backdrop"
                            @onclick="ClosePatientDrawer"
                            aria-label="Close Patient Information"></button>
                }

                <div class="info-card patient-drawer @(_isPatientInfoCollapsed ? "collapsed" : "") @(_isPatientDrawerOpen ? "open" : "")">
                    <div class="info-card-header" @onclick="TogglePatientInfo">
                        <div class="info-card-title">
                            <i class="bi bi-person-badge"></i>
                            <span>Patient Information</span>
                        </div>
                        <button class="btn-toggle-info" title="@(_isPatientInfoCollapsed ? "Expand" : "Collapse")">
                            <i class="bi @(_isPatientInfoCollapsed ? "bi-chevron-down" : "bi-chevron-up")"></i>
                        </button>
                        <button type="button"
                                class="patient-drawer-close"
                                @onclick="ClosePatientDrawer"
                                @onclick:stopPropagation="true"
                                title="Close Patient Information"
                                aria-label="Close Patient Information">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <div class="info-card-content">
                        <div class="info-grid">
                            <div class="info-item">
                                <i class="bi bi-person"></i>
                                <div class="info-content">
                                    <span class="info-label">Name</span>
                                    <span class="info-value">@ViewModel.SelectedPatient.Name</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-calendar-heart"></i>
                                <div class="info-content">
                                    <span class="info-label">Birthday</span>
                                    <span class="info-value">@ViewModel.SelectedPatient.Birthday.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-telephone"></i>
                                <div class="info-content">
                                    <span class="info-label">Phone</span>
                                    <span class="info-value">@ViewModel.SelectedPatient.Phone</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Editor Card -->
            <div class="editor-card">
                <!-- Tab Navigation Row -->
                <div class="tab-navigation-row">
                    <div class="tab-group">
                        <button class="tab-btn"
                                @onclick='() => NavigateToCaseNotes()'>
                            <i class="bi bi-journal-text"></i>
                            <span>Case Notes</span>
                        </button>
                        <button class="tab-btn active">
                            <i class="bi bi-calendar-check"></i>
                            <span>Follow Up</span>
                        </button>
                        <button class="tab-btn"
                                @onclick='() => NavigateToDocuments()'>
                            <i class="bi bi-files"></i>
                            <span>Documents</span>
                        </button>
                        <button class="tab-btn"
                                @onclick='() => NavigateToBilling()'>
                            <i class="bi bi-wallet2"></i>
                            <span>Billing</span>
                        </button>
                    </div>
                </div>

                <div class="editor-container" @key="@("editor-" + _editorKey)">
                    @if (_showEmojiPicker)
                    {
                        <div class="emoji-picker-overlay" @onclick="CloseEmojiPicker">
                            <div class="emoji-picker" @onclick:stopPropagation="true">
                                <div class="emoji-picker-header">
                                    <div class="emoji-picker-title">
                                        <i class="bi bi-emoji-smile"></i>
                                        <span>Choose an Emoji</span>
                                    </div>
                                    <button class="btn-close-emoji" @onclick="ToggleEmojiPicker" title="Close">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                                <div class="emoji-picker-search">
                                    <i class="bi bi-search"></i>
                                    <input type="text" 
                                           placeholder="Search emojis (smile, heart, hand, star, etc.)..." 
                                           @bind="_emojiSearchQuery" 
                                           @bind:event="oninput"
                                           class="emoji-search-input"
                                           autofocus />
                                </div>
                                <div class="emoji-picker-body">
                                    @{
                                        var filteredEmojis = GetFilteredEmojis();
                                        if (filteredEmojis.Any())
                                        {
                                            foreach (var emoji in filteredEmojis)
                                            {
                                                <button class="emoji-item" @onclick="() => InsertEmoji(emoji)" title="@emoji">
                                                    @emoji
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="emoji-picker-empty">
                                                <i class="bi bi-emoji-frown"></i>
                                                <p>No emojis found. Try: smile, heart, hand, star, fire, weather</p>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div id="editor" class="quill-editor"></div>
                </div>

                <div class="editor-footer">
                    @if (!string.IsNullOrEmpty(_statusMessage))
                    {
                        <div class="status-badge @(_isSuccess ? "success" : "error")">
                            <i class="bi @(_isSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                            <span>@_statusMessage</span>
                        </div>
                    }
                    @if (_currentlyViewingFollowUpId.HasValue)
                    {
                        <button class="btn-new-note" @onclick="CreateNewFollowUp" disabled="@(_isSaving || !_isEditorReady)" title="Start a new follow-up">
                            <i class="bi bi-file-earmark-plus"></i>
                            <span>New Follow Up</span>
                        </button>
                    }
                    <button class="btn-save" @onclick="SaveFollowUp" disabled="@(_isSaving || !_isEditorReady)">
                        @if (_isSaving)
                        {
                            <span class="spinner"></span>
                            <span>Saving...</span>
                        }
                        else if (!_isEditorReady)
                        {
                            <span class="spinner"></span>
                            <span>Loading...</span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                            <span>@(_currentlyViewingFollowUpId.HasValue ? "Update Follow Up" : "Save Follow Up")</span>
                        }
                    </button>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Saving Indicator Modal -->
@if (_showSavingOverlay)
{
    <div class="modal-overlay saving-overlay">
        <div class="saving-modal" @onclick:stopPropagation="true">
            <div class="saving-spinner"></div>
            <div class="saving-text">
                <h3>Saving Follow Up...</h3>
                <p>Please wait while we securely save your follow-up record.</p>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_showDeleteModal)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <h3>Delete Follow Up</h3>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this follow-up record?</p>
                <p class="modal-warning">This action cannot be undone. All content and images will be permanently removed.</p>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CancelDelete">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-delete" @onclick="ConfirmDelete">
                    <i class="bi bi-trash3-fill"></i>
                    <span>Delete Follow Up</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Unsaved Changes Warning Modal -->
@if (_showUnsavedChangesModal)
{
    <div class="modal-overlay" @onclick:stopPropagation="true">
        <div class="modal-container unsaved-changes-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-warning">
                <i class="bi bi-exclamation-circle-fill"></i>
                <h3>Unsaved Changes</h3>
            </div>
            <div class="modal-body">
                <p>You have unsaved changes in your follow-up record.</p>
                <p class="modal-warning">If you leave now, your changes will be lost.</p>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-discard" @onclick="DiscardChanges">
                    <i class="bi bi-x-circle"></i>
                    <span>Discard Changes</span>
                </button>
                <button class="btn-modal-continue" @onclick="ContinueEditing">
                    <i class="bi bi-pencil-square"></i>
                    <span>Continue Editing</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- New Follow Up Confirmation Modal -->
@if (_showNewFollowUpConfirmModal)
{
    <div class="modal-overlay" @onclick="CancelNewFollowUp">
        <div class="modal-container new-note-confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-info">
                <i class="bi bi-file-earmark-plus-fill"></i>
                <h3>Start New Follow Up</h3>
            </div>
            <div class="modal-body">
                <p>You have @(_hasUnsavedChanges ? "unsaved changes" : "content") in the current follow-up.</p>
                <p class="modal-warning">Starting a new follow-up will clear the current content. This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CancelNewFollowUp">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-confirm" @onclick="ConfirmNewFollowUp">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Start New Follow Up</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    // ===== VIEW MODELS & STATE =====
    // Injected via DI
    private DotNetObjectReference<FollowUpPage>? _dotNetRef;
    private IJSObjectReference? _moduleRef;
    
    // ===== UI STATE =====
    private bool _showEmojiPicker = false;
    private bool _isSidebarCollapsed = false;
    private bool _isPatientInfoCollapsed = false;
    private bool _isPatientDrawerOpen = false;
    private string _emojiSearchQuery = "";
    private bool _showDeleteModal = false;
    private int? _followUpToDelete = null;
    private bool _showUnsavedChangesModal = false;
    private bool _showNewFollowUpConfirmModal = false;
    private bool _showSavingOverlay = false;
    private string? _pendingLinkNavigation = null;
    private bool _hasUnsavedChanges = false;
    private string _lastSavedContent = "";
    private bool _isDateFilterOpen = false;
    
    // ===== EDITOR STATE =====
    private bool _isEditorReady = false;
    private bool _isSaving = false;
    private int? _currentlyViewingFollowUpId
    {
        get => ViewModel.CurrentlyViewingFollowUpId;
        set => ViewModel.CurrentlyViewingFollowUpId = value;
    }
    private List<string> _emojiList = new();
    private bool _isInitializing = false;
    private bool _isPageInitializing = true;
    private bool _hasRendered = false;
    private int _editorKey = 0;
    
    // ===== STATUS & FEEDBACK =====
    private string _statusMessage = "";
    private bool _isSuccess = false;
    private CancellationTokenSource? _hideMessageCts;

    protected override void OnInitialized()
    {
        Console.WriteLine("[BLAZOR] FollowUpPage OnInitialized called");
        
        // Reset editor state on initialization
        _isEditorReady = false;
        _isInitializing = false;
        _editorKey++; // Increment key to force fresh render
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("applyPortraitMode");
            }
            catch { /* ignore if JS not ready */ }
        }

        // Only initialize if editor isn't ready
        if (!_isEditorReady && !_isInitializing)
        {
            _isInitializing = true;
            Console.WriteLine($"[BLAZOR] Attempting to initialize editor (EditorKey: {_editorKey})");
            
            try
            {
                // Create DotNet reference if not exists
                if (_dotNetRef == null)
                {
                    _dotNetRef = DotNetObjectReference.Create(this);
                    Console.WriteLine("[BLAZOR] Created DotNetObjectReference");
                }
                
                // Delay to ensure DOM is fully ready after Blazor render
                await Task.Delay(100);
                
                // Always try to initialize - let JavaScript handle checking if it exists
                Console.WriteLine("[BLAZOR] Calling initializeQuillEditor...");
                var success = await JS.InvokeAsync<bool>("initializeQuillEditor");
                
                if (success)
                {
                    Console.WriteLine("[BLAZOR] ✓ Quill editor initialized successfully");
                    
                    // Get emoji list if not loaded
                    if (!_emojiList.Any())
                    {
                        _emojiList = await JS.InvokeAsync<List<string>>("getEmojiList");
                        Console.WriteLine($"[BLAZOR] ✓ Loaded {_emojiList.Count} emojis");
                    }

                    // Setup event listeners
                    await SetupEventListeners();

                    _isEditorReady = true;
                    _hasRendered = true;
                    Console.WriteLine("[BLAZOR] ✓ Editor is ready!");
                    
                    // Load pre-selected follow-up note if any (e.g. navigated from Follow Up History page)
                    if (ViewModel.CurrentlyViewingFollowUpId.HasValue)
                    {
                        var followUp = ViewModel.FollowUpHistory.FirstOrDefault(f => f.Id == ViewModel.CurrentlyViewingFollowUpId.Value);
                        if (followUp != null)
                        {
                            await JS.InvokeVoidAsync("setEditorContent", followUp.Content);
                            _lastSavedContent = followUp.Content;
                            _hasUnsavedChanges = false;
                            Console.WriteLine($"[BLAZOR] Loaded pre-selected follow-up note ID: {followUp.Id}");
                        }
                    }
                    
                    // Check for pending annotation image from AnnotateImage page
                    await CheckForPendingAnnotationImage();
                    
                    StateHasChanged();
                }
                else
                {
                    Console.WriteLine("[BLAZOR] ✗ Failed to initialize editor - returned false");
                    _statusMessage = "Failed to initialize editor. Please refresh the page.";
                    _isSuccess = false;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[BLAZOR] ✗ Error initializing editor: {ex.Message}");
                Console.WriteLine($"[BLAZOR] Stack trace: {ex.StackTrace}");
                _statusMessage = "Failed to initialize editor. Please refresh the page.";
                _isSuccess = false;
                StateHasChanged();
            }
            finally
            {
                _isInitializing = false;
                _isPageInitializing = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task SetupEventListeners()
    {
        try
        {
            // Create a module to avoid eval
            _moduleRef = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Beauty_Aesthetics_Hybrid.Shared/js/case-notes-interop.js");
            await _moduleRef.InvokeVoidAsync("setupEventListeners", _dotNetRef);
