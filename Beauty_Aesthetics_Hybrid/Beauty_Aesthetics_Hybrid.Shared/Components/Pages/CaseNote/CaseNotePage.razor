    public async ValueTask DisposeAsync()
    {
        _hideMessageCts?.Cancel();
        _hideMessageCts?.Dispose();
        
        try
        {
            // Clean up event listeners
            if (_moduleRef != null)
            {
                await _moduleRef.InvokeVoidAsync("removeEventListeners");
            }
            else
            {
                await JS.InvokeVoidAsync("removeCaseNotePageListeners");
            }
            
            await JS.InvokeVoidAsync("removeEditorEventListeners");
            await JS.InvokeVoidAsync("disposeQuillEditor");
        }
        catch { /* Ignore errors during disposal */ }
        
        _dotNetRef?.Dispose();
        
        try
        {
            if (_moduleRef != null)
            {
                await _moduleRef.DisposeAsync();
            }
        }
        catch { /* Ignore errors during disposal - circuit may be disconnected */ }
    }
