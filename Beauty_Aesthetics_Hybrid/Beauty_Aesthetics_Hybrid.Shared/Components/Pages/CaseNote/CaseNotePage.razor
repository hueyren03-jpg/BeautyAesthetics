    private async Task DiscardChanges()
    {
        _showUnsavedChangesModal = false;
        _hasUnsavedChanges = false;
        _lastSavedContent = "";
        
        // Handle tab navigation
        if (_pendingTabNavigation != null)
        {
            var targetTab = _pendingTabNavigation;
            _pendingTabNavigation = null;
            await OnTabChange(targetTab);
        }
        // Handle link navigation
        else if (_pendingLinkNavigation != null)
        {
            var targetUrl = _pendingLinkNavigation;
            _pendingLinkNavigation = null;
            NavigationManager.NavigateTo(targetUrl);
        }
        // Handle note navigation
        else if (_pendingNoteNavigation != null)
        {
            var targetNote = _pendingNoteNavigation;
            _pendingNoteNavigation = null;
            await ViewNote(targetNote);
        }
    }

