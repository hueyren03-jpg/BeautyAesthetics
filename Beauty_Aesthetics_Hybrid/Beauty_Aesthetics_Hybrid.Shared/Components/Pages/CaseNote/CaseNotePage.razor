    private async Task OnTabChange(string newTab)
    {
        var oldTab = ViewModel.ActiveTab;
        
        // Check for unsaved changes when leaving case-notes tab
        if (oldTab == "case-notes" && newTab != "case-notes" && _hasUnsavedChanges)
        {
            _pendingTabNavigation = newTab;
            _showUnsavedChangesModal = true;
            StateHasChanged();
            return;
        }
        
        // Proceed with tab change
        ViewModel.SelectTab(newTab);
        
        // If switching away from case-notes, mark editor as not ready
        if (oldTab == "case-notes" && newTab != "case-notes")
        {
            Console.WriteLine("[BLAZOR] Switching away from case-notes tab");
            _isEditorReady = false;
            _hasUnsavedChanges = false;
            _lastSavedContent = "";
        }
        
        // If switching back to case-notes, reset and increment key to force re-render
        if (oldTab != "case-notes" && newTab == "case-notes")
        {
            Console.WriteLine("[BLAZOR] Switching back to case-notes tab - resetting editor");
            _isEditorReady = false;
            _isInitializing = false;
            _editorKey++; // Force new DOM element
        }
        
        StateHasChanged();
        await Task.CompletedTask; // Ensure async signature is valid
    }
    
