    private async Task SaveNote()
    {
        if (!_isEditorReady || ViewModel.SelectedPatient == null)
        {
            _statusMessage = ViewModel.SelectedPatient == null ? "Please select a patient" : "Editor not ready";
            _isSuccess = false;
            Feedback.Warning(_statusMessage, "Case note not saved");
            StateHasChanged();
            return;
        }

        _isSaving = true;
        _showSavingOverlay = true;
        _statusMessage = "";
        
        // Immediate UI feedback - don't wait for StateHasChanged
        await InvokeAsync(StateHasChanged);

        try
        {
            // Get content asynchronously
            var content = await JS.InvokeAsync<string>("getEditorContent");
            
            // Validate content early
            if (string.IsNullOrWhiteSpace(content))
            {
                _statusMessage = "Please write some notes";
                _isSuccess = false;
                Feedback.Warning(_statusMessage, "Case note not saved");
                _isSaving = false;
                _showSavingOverlay = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Process save operation in background without blocking UI
            var isUpdate = _currentlyViewingNoteId.HasValue;
            var noteId = _currentlyViewingNoteId;
            
            // Offload heavy processing to Task.Run to avoid blocking UI thread
            await Task.Run(() =>
            {
                if (isUpdate && noteId.HasValue)
                {
                    ViewModel.UpdateNote(noteId.Value, content);
                }
                else
                {
                    ViewModel.SaveNote(content);
                }
            });
            
            // Update UI state after save completes
            _hasUnsavedChanges = false;
            _lastSavedContent = content;
            _currentlyViewingNoteId = null;
            _isSuccess = true;
            _statusMessage = isUpdate ? "Note updated successfully!" : "Note saved successfully!";
            Feedback.Success(
                _statusMessage,
                isUpdate ? "Case note updated" : "Case note saved");
            
            // Clear editor for new notes (non-blocking)
            if (!isUpdate)
            {
                _ = JS.InvokeVoidAsync("clearEditor");
            }

            // Auto-hide message after delay
            _hideMessageCts?.Cancel();
            _hideMessageCts?.Dispose();
            _hideMessageCts = new CancellationTokenSource();
            
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(3000, _hideMessageCts.Token);
                    _statusMessage = "";
                    await InvokeAsync(StateHasChanged);
                }
                catch (TaskCanceledException) { }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BLAZOR] Error saving note: {ex.Message}");
            _statusMessage = "Error saving note. Please try again.";
            _isSuccess = false;
            Feedback.Error(_statusMessage, "Case note not saved");
        }
        finally
        {
            _isSaving = false;
            _showSavingOverlay = false;
            await InvokeAsync(StateHasChanged);
        }
    }

