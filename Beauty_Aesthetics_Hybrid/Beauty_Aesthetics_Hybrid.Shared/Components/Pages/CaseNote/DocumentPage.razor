    private void SaveEditedContent()
    {
        if (_documentToEdit == null || 
            string.IsNullOrWhiteSpace(_editingDocumentTitle) ||
            _editingDocumentContent == null)
            return;
        
        try
        {
            var updatedDoc = _documentToEdit with 
            { 
                Title = _editingDocumentTitle.Trim(),
                Content = _editingDocumentContent,
                LastUpdated = DateTime.Now
            };
            ViewModel.UpdateDocument(_documentToEdit.Id, updatedDoc);
            
            CloseEditContentModal();
            StateHasChanged();
        }
        catch (Exception ex)
