    private string FormatAppointmentTime(TimeOnly time)
    {
        return time.ToString("hh:mm tt");
    }

    private int GetHour12(TimeOnly time)
    {
        int hour = time.Hour % 12;
        return hour == 0 ? 12 : hour;
    }

    private void SetAppointmentHour(int hour)
    {
        bool isPM = _templateDocument.NextAppointmentTime.Hour >= 12;
        int hour24 = hour == 12 ? (isPM ? 12 : 0) : (isPM ? hour + 12 : hour);
        _templateDocument.NextAppointmentTime = new TimeOnly(hour24, _templateDocument.NextAppointmentTime.Minute);
        StateHasChanged();
    }

    private void SetAppointmentMinute(int minute)
    {
        _templateDocument.NextAppointmentTime = new TimeOnly(_templateDocument.NextAppointmentTime.Hour, minute);
        StateHasChanged();
    }

    private void SetAppointmentPeriod(bool isAM)
    {
        int currentHour = _templateDocument.NextAppointmentTime.Hour;
        int hour12 = currentHour % 12;
        int newHour = isAM ? hour12 : (hour12 + 12);
        if (hour12 == 0 && isAM) newHour = 0;
        if (hour12 == 0 && !isAM) newHour = 12;
        _templateDocument.NextAppointmentTime = new TimeOnly(newHour, _templateDocument.NextAppointmentTime.Minute);
        StateHasChanged();
    }

    private IEnumerable<(int Id, string Name, string Category, string Description)> FilteredTemplates
    {
        get
        {
            var filtered = _templates.AsEnumerable();
            
            // Exclude deleted templates
            filtered = filtered.Where(t => !_deletedSystemTemplateIds.Contains(t.Id));
            
            // Category filter
            if (_selectedTemplateCategory != null)
            {
                filtered = filtered.Where(t => t.Category == _selectedTemplateCategory);
            }
            
            // Search query filter
            if (!string.IsNullOrWhiteSpace(_templateSearchQuery))
            {
                var query = _templateSearchQuery.ToLower();
                filtered = filtered.Where(t => 
                    t.Name.ToLower().Contains(query) ||
                    t.Category.ToLower().Contains(query) ||
                    t.Description.ToLower().Contains(query));
            }
            
            // Sort: Custom templates (ID >= 1000) first, then system templates (ID < 1000)
            // Within each group, sort by name alphabetically
            return filtered
                .OrderByDescending(t => IsCustomTemplate(t.Id)) // Custom templates (true) come before system (false)
                .ThenBy(t => t.Name); // Then sort alphabetically by name
        }
    }
    
