                    <div class="form-group">
                        <label>Treatment Notes</label>
                        <textarea class="form-textarea" @bind="_templateDocument.TreatmentNotes" rows="4" placeholder="Detailed procedure notes, patient response, complications..."></textarea>
                    </div>
                    <div class="form-group">
                        <label>Post-Treatment Instructions</label>
                        <textarea class="form-textarea" @bind="_templateDocument.FollowUpInstructions" rows="3" placeholder="Post-treatment care, restrictions, follow-up timeline..."></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Next Appointment Date</label>
                            <input type="date" class="form-input" @bind="_templateDocument.NextAppointmentDate" />
                        </div>
                        <div class="form-group">
                            <label>Time</label>
                            <div class="custom-time-picker" @onclick:stopPropagation="true">
                                <button type="button" class="time-display-btn" @onclick="() => ToggleAppointmentTimePicker()">
                                    <i class="bi bi-clock"></i>
                                    <span>@FormatAppointmentTime(_templateDocument.NextAppointmentTime)</span>
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                                
                                @if (_showAppointmentTimePicker)
                                {
                                    <div class="time-picker-dropdown" @onclick:stopPropagation="true">
                                        <div class="time-picker-header">
                                            <span>Select Time</span>
                                            <button type="button" class="btn-close-picker" @onclick="() => _showAppointmentTimePicker = false">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                        <div class="time-picker-body">
                                            <div class="time-column">
                                                <label class="column-label">Hour</label>
                                                <div class="time-options">
                                                    @for (int h = 1; h <= 12; h++)
                                                    {
                                                        var hour = h;
                                                        var isSelected = GetHour12(_templateDocument.NextAppointmentTime) == hour;
                                                        <button type="button" 
                                                                class="time-option @(isSelected ? "selected" : "")"
                                                                @onclick="() => SetAppointmentHour(hour)">
                                                            @hour.ToString("00")
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="time-column">
                                                <label class="column-label">Minute</label>
                                                <div class="time-options">
                                                    @foreach (var min in new[] { 0, 15, 30, 45 })
                                                    {
                                                        var minute = min;
                                                        var isSelected = _templateDocument.NextAppointmentTime.Minute == minute;
                                                        <button type="button" 
                                                                class="time-option @(isSelected ? "selected" : "")"
                                                                @onclick="() => SetAppointmentMinute(minute)">
                                                            @minute.ToString("00")
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="time-column">
                                                <label class="column-label">Period</label>
                                                <div class="time-options">
                                                    <button type="button" 
                                                            class="time-option period-option @(_templateDocument.NextAppointmentTime.Hour < 12 ? "selected" : "")"
                                                            @onclick="() => SetAppointmentPeriod(true)">
                                                        AM
                                                    </button>
                                                    <button type="button" 
                                                            class="time-option period-option @(_templateDocument.NextAppointmentTime.Hour >= 12 ? "selected" : "")"
                                                            @onclick="() => SetAppointmentPeriod(false)">
                                                        PM
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (_selectedTemplate.Value.Name.Contains("Consent"))
                {
                    <div class="form-group">
                        <label>Patient Name <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_templateDocument.PatientName" placeholder="Enter patient full name" />
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Date <span class="required">*</span></label>
                            <input type="date" class="form-input" @bind="_templateDocument.Date" />
                        </div>
                        <div class="form-group">
                            <label>Witness Name</label>
                            <input type="text" class="form-input" @bind="_templateDocument.WitnessName" placeholder="Witness name (optional)" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Procedure <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_templateDocument.Procedure" placeholder="Procedure name (e.g., Botox Injection, Dermal Filler)" />
                    </div>
                    <div class="form-group">
                        <label>Benefits</label>
                        <textarea class="form-textarea" @bind="_templateDocument.Benefits" rows="3" placeholder="Expected benefits of the procedure..."></textarea>
                    </div>
                    <div class="form-group">
                        <label>Risks</label>
                        <textarea class="form-textarea" @bind="_templateDocument.Risks" rows="3" placeholder="Potential risks and complications..."></textarea>
                    </div>
                    <div class="form-group">
                        <label>Alternatives</label>
                        <textarea class="form-textarea" @bind="_templateDocument.Alternatives" rows="2" placeholder="Alternative treatment options..."></textarea>
                    </div>
                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="_templateDocument.ConsentGiven" />
                            <span>Patient has been informed and consents to the procedure</span>
                        </label>
                    </div>
                }
                else if (_selectedTemplate.Value.Name.Contains("Prescription"))
                {
                    <div class="form-group">
                        <label>Patient Name <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_templateDocument.PatientName" placeholder="Enter patient full name" />
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Date <span class="required">*</span></label>
                            <input type="date" class="form-input" @bind="_templateDocument.Date" />
                        </div>
                        <div class="form-group">
                            <label>Quantity</label>
                            <input type="number" class="form-input" @bind="_templateDocument.Quantity" min="1" placeholder="Quantity" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Medication <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_templateDocument.Medication" placeholder="Medication name (e.g., Paracetamol 500mg)" />
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Dosage <span class="required">*</span></label>
                            <input type="text" class="form-input" @bind="_templateDocument.Dosage" placeholder="e.g., 500mg" />
                        </div>
                        <div class="form-group">
                            <label>Frequency <span class="required">*</span></label>
                            <input type="text" class="form-input" @bind="_templateDocument.Frequency" placeholder="e.g., Three times daily" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Duration <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_templateDocument.Duration" placeholder="e.g., 7 days" />
                    </div>
                    <div class="form-group">
                        <label>Indication</label>
                        <input type="text" class="form-input" @bind="_templateDocument.Indication" placeholder="Reason for prescription" />
                    </div>
                    <div class="form-group">
                        <label>Instructions</label>
                        <textarea class="form-textarea" @bind="_templateDocument.Instructions" rows="3" placeholder="Special instructions (e.g., Take with meals, Avoid alcohol)"></textarea>
                    </div>
                }
                else if (_selectedTemplate.Value.Name.Contains("Skin Assessment"))
                {
                    <div class="form-group">
                        <label>Patient Name <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_templateDocument.PatientName" placeholder="Enter patient full name" />
                    </div>
                    <div class="form-group">
                        <label>Date <span class="required">*</span></label>
                        <input type="date" class="form-input" @bind="_templateDocument.Date" />
                    </div>
                    <div class="form-group">
                        <label>Skin Condition Assessment</label>
                        <textarea class="form-textarea" @bind="_templateDocument.PhysicalExamination" rows="4" placeholder="Skin type, Fitzpatrick classification, concerns, current condition..."></textarea>
                    </div>
                    <div class="form-group">
                        <label>Assessment</label>
                        <textarea class="form-textarea" @bind="_templateDocument.Assessment" rows="3" placeholder="Clinical assessment and findings..."></textarea>
                    </div>
                    <div class="form-group">
                        <label>Treatment Recommendations</label>
                        <textarea class="form-textarea" @bind="_templateDocument.Plan" rows="3" placeholder="Recommended treatments and skincare regimen..."></textarea>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Patient Name <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_templateDocument.PatientName" placeholder="Enter patient full name" />
                    </div>
                    <div class="form-group">
                        <label>Date <span class="required">*</span></label>
                        <input type="date" class="form-input" @bind="_templateDocument.Date" />
                    </div>
                    <div class="form-group">
                        <label>Document Content</label>
                        <textarea class="form-textarea" @bind="_templateDocument.Content" rows="8" placeholder="Enter document content..."></textarea>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="() => { CloseTemplateDocumentModal(); _showAppointmentTimePicker = false; }">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-back" @onclick="BackToTemplateSelection">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back</span>
                </button>
                <button class="btn-modal-confirm" @onclick="SaveTemplateDocument">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@(_isEditingDocument ? "Update Document" : "Save Document")</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- View Document Modal -->
@if (_showViewModal && _documentToView != null)
{
    <div class="modal-overlay" @onclick="CloseViewModal">
        <div class="view-modal-container" @onclick:stopPropagation="true">
            <div class="view-modal-header">
                <div class="view-modal-header-left">
                    <i class="bi @GetDocumentIcon(_documentToView.Type)"></i>
                    <div>
                        <h3>@_documentToView.Title</h3>
                        <span class="view-modal-subtitle">@_documentToView.Type</span>
                    </div>
                </div>
                <button class="btn-close-view-modal" @onclick="CloseViewModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="view-modal-body">
                <!-- Document Metadata -->
                <div class="document-metadata">
                    <div class="metadata-item">
                        <i class="bi bi-calendar3"></i>
                        <div>
                            <span class="metadata-label">Created Date</span>
                            <span class="metadata-value">@_documentToView.CreatedDate.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div class="metadata-item">
                        <i class="bi bi-clock-history"></i>
                        <div>
                            <span class="metadata-label">Last Updated</span>
                            <span class="metadata-value">@_documentToView.LastUpdated.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div class="metadata-item">
                        <i class="bi bi-person"></i>
                        <div>
                            <span class="metadata-label">Uploaded By</span>
                            <span class="metadata-value">@_documentToView.UploadedBy</span>
                        </div>
                    </div>
                </div>

                <!-- Document Content Preview -->
                <div class="document-preview">
                    @if (!string.IsNullOrEmpty(_documentToView.FilePath))
                    {
                        <!-- File Preview -->
                        @if (IsPdfFile(_documentToView.FilePath))
                        {
                            <div class="preview-pdf">
                                <iframe src="@_documentToView.FilePath" class="pdf-viewer" title="PDF Preview"></iframe>
                                <p class="preview-note">PDF Preview - Use download button if preview doesn't load</p>
                            </div>
                        }
                        else if (IsImageFile(_documentToView.FilePath))
                        {
                            <div class="preview-image">
                                <img src="@_documentToView.FilePath" alt="@_documentToView.Title" class="image-viewer" />
                            </div>
                        }
                        else if (IsDocxFile(_documentToView.FilePath))
                        {
                            <div class="preview-file">
                                <i class="bi bi-file-earmark-word" style="font-size: 64px; color: #1173d4;"></i>
                                <p><strong>@_documentToView.Title</strong></p>
                                <p class="preview-note">This is a Word document (.docx). Please download to view and edit.</p>
                            </div>
                        }
                        else if (IsExcelFile(_documentToView.FilePath))
                        {
                            <div class="preview-file">
                                <i class="bi bi-file-earmark-excel" style="font-size: 64px; color: #10b981;"></i>
                                <p><strong>@_documentToView.Title</strong></p>
                                <p class="preview-note">This is an Excel file (.xls/.xlsx). Please download to view and edit.</p>
                            </div>
                        }
                        else
                        {
                            <div class="preview-file">
                                <i class="bi bi-file-earmark" style="font-size: 64px; color: #94a3b8;"></i>
                                <p><strong>@_documentToView.Title</strong></p>
                                <p class="preview-note">This file type cannot be previewed. Please download to view.</p>
                            </div>
                        }
                    }
                    else if (!string.IsNullOrEmpty(_documentToView.Content))
                    {
                        <!-- Enhanced Document Preview with Professional Styling -->
                        <div class="preview-content-wrapper">
                            <div class="preview-document-container">
                                <div class="preview-paper-effect">
                                    <div class="preview-content-display">
                                        @((MarkupString)_documentToView.Content)
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="preview-empty">
                            <i class="bi bi-file-earmark-text" style="font-size: 64px; color: #94a3b8;"></i>
                            <p>No content available for this document.</p>
                        </div>
                    }
                </div>
            </div>
            <div class="view-modal-footer">
                <button class="btn-modal-print" @onclick="async () => await PrintDocument(_documentToView)">
                    <i class="bi bi-printer"></i>
                    <span>Print / Save PDF</span>
                </button>
                <button class="btn-modal-close" @onclick="CloseViewModal">
                    <i class="bi bi-x-circle"></i>
                    <span>Close</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Manage Document Types Modal -->
@if (_showManageDocumentTypesModal)
{
    <div class="modal-overlay">
        <div class="modal-container manage-types-modal">
            <div class="modal-header modal-header-add">
                <div class="modal-header-content">
                    <i class="bi bi-tags"></i>
                    <h3>Manage Document Types</h3>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseManageDocumentTypesModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="manage-types-content">
                    <!-- Add New Type Section -->
                    <div class="add-type-section">
                        <h4 class="section-subtitle">Add New Document Type</h4>
                        <div class="form-row">
                            <div class="input-wrapper">
                                <input type="text" 
                                       class="form-input @(string.IsNullOrEmpty(_addTypeError) ? "" : "input-error")" 
                                       placeholder="Enter new document type name..." 
                                       value="@_newDocumentTypeName"
                                       @oninput="HandleAddTypeInput"
                                       @onkeypress="HandleTypeNameKeyPress" />
                            </div>
                            <button class="btn-add-type" @onclick="AddDocumentType" disabled="@(string.IsNullOrWhiteSpace(_newDocumentTypeName) || !string.IsNullOrEmpty(_addTypeError))">
                                <i class="bi bi-plus-lg"></i>
                                <span>Add</span>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Document Types List -->
                    <div class="types-list-section">
                        <h4 class="section-subtitle">Document Types</h4>
                        <div class="types-list">
                            @foreach (var docType in _documentTypes.OrderBy(t => t))
                            {
                                var type = docType;
                                var isEditing = _editingDocumentTypeOriginal == type;
                                <div class="type-item">
                                    @if (isEditing)
                                    {
                                        <div class="type-edit-wrapper">
                                            <input type="text" 
                                                   class="form-input type-edit-input @(string.IsNullOrEmpty(_editTypeError) ? "" : "input-error")" 
                                                   value="@(_editingDocumentType ?? "")"
                                                   @oninput="HandleEditTypeInput"
                                                   @onkeypress="HandleEditTypeKeyPress"
                                                   @onfocusout="() => { if (string.IsNullOrWhiteSpace(_editingDocumentType)) CancelEditDocumentType(); }" />
                                        </div>
                                        <div class="type-item-actions">
                                            <button class="btn-type-action btn-save-type" @onclick="() => SaveDocumentType(_editingDocumentTypeOriginal ?? type)" disabled="@(!string.IsNullOrEmpty(_editTypeError))" title="Save">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button class="btn-type-action btn-cancel-type" @onclick="CancelEditDocumentType" title="Cancel">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="type-name">@type</span>
                                        <div class="type-item-actions">
                                            <button class="btn-type-action btn-edit-type" @onclick="() => StartEditDocumentType(type)" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn-type-action btn-delete-type" @onclick="() => ShowDeleteDocumentTypeConfirmation(type)" title="Delete">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            @if (!_documentTypes.Any())
                            {
                                <div class="empty-types">
                                    <i class="bi bi-inbox"></i>
                                    <p>No document types found</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-confirm" @onclick="CloseManageDocumentTypesModal">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Done</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Document Type Confirmation Modal -->
@if (_showDeleteDocumentTypeModal && !string.IsNullOrEmpty(_documentTypeToDelete))
{
    <div class="modal-overlay" @onclick="CancelDeleteDocumentType">
        <div class="modal-container delete-document-type-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <h3>Delete Document Type</h3>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the document type <strong>"@_documentTypeToDelete"</strong>?</p>
                @{
                    var documentsUsingType = ViewModel.Documents.Count(d => 
                        d.Type.Equals(_documentTypeToDelete, StringComparison.OrdinalIgnoreCase));
                }
                @if (documentsUsingType > 0)
                {
                    <div class="delete-warning" style="margin-top: 12px; padding: 12px; background: #fee2e2; border: 1px solid #ef4444; border-radius: 6px; color: #dc2626; display: flex; gap: 8px;">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size: 18px;"></i>
                        <div>
                            <p style="margin: 0; font-weight: 600;">Cannot delete this document type.</p>
                            <p style="margin: 4px 0 0 0;">There @(documentsUsingType == 1 ? "is" : "are") @documentsUsingType document@(documentsUsingType == 1 ? "" : "s") still using this type. Please update or remove those documents before deleting.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="delete-info" style="margin-top: 12px; padding: 12px; background: #f0f9ff; border: 1px solid #1173d4; border-radius: 6px; color: #0c4a6e; display: flex; gap: 8px;">
                        <i class="bi bi-info-circle-fill" style="font-size: 18px;"></i>
                        <span>No documents are currently using this type.</span>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CancelDeleteDocumentType">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-delete" @onclick="ConfirmDeleteDocumentType" disabled="@(documentsUsingType > 0)" title="@(documentsUsingType > 0 ? "Cannot delete while documents use this type" : null)">
                    <i class="bi bi-trash3-fill"></i>
                    <span>Delete Type</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Uploaded File Modal -->
@if (_showEditUploadedFileModal && _documentToEdit != null)
{
    <div class="modal-overlay" @onclick="CloseEditUploadedFileModal">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-add">
                <i class="bi bi-file-earmark"></i>
                <h3>Edit Uploaded File</h3>
            </div>
            <div class="modal-body">
                <p>This document is an uploaded file (@(_documentToEdit.FilePath?.Contains("pdf") == true ? "PDF" : _documentToEdit.FilePath?.Contains("word") == true || _documentToEdit.FilePath?.Contains("docx") == true ? "Word" : _documentToEdit.FilePath?.Contains("excel") == true || _documentToEdit.FilePath?.Contains("spreadsheetml") == true || _documentToEdit.FilePath?.Contains(".xls") == true ? "Excel" : _documentToEdit.FilePath?.Contains("image") == true ? "Image" : "File")).</p>
                <p style="margin-top: 12px; color: #64748b;">Uploaded files (PDF, Word, Excel, Images) cannot be edited directly in the system.</p>
                <div style="margin-top: 20px; padding: 12px; background: #f0f9ff; border: 1px solid #1173d4; border-radius: 6px;">
                    <p style="margin: 0; font-weight: 600; color: #0c4a6e;">Suggested Actions:</p>
                    <ul style="margin: 8px 0 0 20px; color: #0c4a6e;">
                        <li>Download the file, edit it locally, then upload a new version</li>
                        <li>Delete this document and create a new one from a template</li>
                        <li>Use external software (Word, Excel, PDF editor) to edit the file</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-confirm" @onclick="CloseEditUploadedFileModal" style="margin-left: auto;">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Close</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Document Content Modal -->
@if (_showEditContentModal && _documentToEdit != null)
{
    <div class="modal-overlay" @onclick="CloseEditContentModal">
        <div class="modal-container" @onclick:stopPropagation="true" style="max-width: 900px; max-height: 90vh;">
            <div class="modal-header modal-header-add">
                <i class="bi bi-pencil-square"></i>
                <h3>Edit Document</h3>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Document Title <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="_editingDocumentTitle" placeholder="Enter document title" />
                </div>
                <div class="form-group">
                    <label>Document Content</label>
                    <textarea class="form-textarea" @bind="_editingDocumentContent" rows="15" style="font-family: monospace; font-size: 12px;" placeholder="Document content (HTML)"></textarea>
                    <small class="form-hint">You can edit the HTML content directly. Changes will be saved when you click Save.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CloseEditContentModal">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-confirm" @onclick="SaveEditedContent">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Save Changes</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_showDeleteModal && _documentToDelete.HasValue)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <h3>Delete Document</h3>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this document?</p>
                <p class="modal-warning">This action cannot be undone. All content and files will be permanently removed.</p>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CancelDelete">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-delete" @onclick="ConfirmDelete">
                    <i class="bi bi-trash3-fill"></i>
                    <span>Delete Document</span>
                </button>
            </div>
        </div>
    </div>
}

