    private void EditTemplate((int Id, string Name, string Category, string Description) template)
    {
        if (!IsCustomTemplate(template.Id))
        {
            // System templates cannot be edited
            return;
        }
        
        // Get the custom template from the ViewModel
        var customTemplate = _templateViewModel.GetTemplate(template.Id);
        if (customTemplate == null)
        {
            return;
        }
        
        // Load the template into the ViewModel for editing
        _templateViewModel.EditTemplate(customTemplate);
        
        // Clear selection and close modals
        _selectedTemplate = null;
        CloseTemplateSelectionModal();
        
        // Navigate to template builder
        NavigationManager.NavigateTo("/templates/builder");
    }
    
