    private void ShowDeleteTemplateConfirmation((int Id, string Name, string Category, string Description) template)
    {
        _templateToDelete = template;
        _showDeleteTemplateModal = true;
        StateHasChanged();
    }
    
    private void CancelDeleteTemplate()
    {
        _showDeleteTemplateModal = false;
        _templateToDelete = null;
        StateHasChanged();
    }
    
    private async Task ConfirmDeleteTemplate()
    {
        if (!_templateToDelete.HasValue)
        {
            CancelDeleteTemplate();
            return;
        }
        
        var template = _templateToDelete.Value;
        
        if (IsCustomTemplate(template.Id))
        {
            // Delete custom template from ViewModel
            _templateViewModel.DeleteTemplate(template.Id);
            
            // Remove from templates list immediately
            _templates.RemoveAll(t => t.Id == template.Id);
            
            // Auto-save to localStorage
            await _templateViewModel.SaveTemplatesToStorageAsync();
        }
        else
        {
            // For system templates, just hide them by adding to deleted list
            if (!_deletedSystemTemplateIds.Contains(template.Id))
            {
                _deletedSystemTemplateIds.Add(template.Id);
                
                // Remove from templates list
                _templates.RemoveAll(t => t.Id == template.Id);
            }
        }
        
        // Close delete modal and refresh
        CancelDeleteTemplate();
        StateHasChanged(); // Trigger UI update
    }

    private string MapTemplateToDocumentType(string templateName)
    {
        if (templateName.Contains("Consultation") || templateName.Contains("Follow-up") || templateName.Contains("Post-Treatment Review"))
            return "Treatment Note";
        if (templateName.Contains("Treatment") || templateName.Contains("Botox") || templateName.Contains("Dermal Filler") || 
            templateName.Contains("Laser") || templateName.Contains("Chemical Peel") || templateName.Contains("Microneedling") ||
            templateName.Contains("Skin Treatment"))
            return "Treatment Note";
        if (templateName.Contains("Consent"))
            return "Consent Form";
        if (templateName.Contains("Prescription"))
            return "Prescription";
        if (templateName.Contains("Medical Certificate"))
            return "Other";
        if (templateName.Contains("Assessment"))
            return "Treatment Note";
        return "Other";
    }

