    // ===== DOCUMENT PREVIEW METHODS =====
    private bool HasPreviewableFile(DocumentViewModel.Document doc)
    {
        return !string.IsNullOrEmpty(doc.Content) && 
               (doc.Content.Contains("data:image/") || 
                doc.Content.Contains("data:application/pdf") || 
                doc.Content.Contains("data:application/msword") || 
                doc.Content.Contains("data:application/vnd.openxmlformats-officedocument") ||
                doc.Content.Contains("data:application/vnd.ms-excel") ||
                doc.Content.Contains("data:application/vnd.openxmlformats-officedocument.spreadsheetml"));
    }

    private void PreviewDocument(DocumentViewModel.Document doc)
    {
        try
        {
            _documentToPreview = doc;
            _previewFileDataUrl = doc.Content;
            
            // Extract content type from data URL
            if (!string.IsNullOrEmpty(doc.Content) && doc.Content.Contains(";"))
            {
                var contentTypePart = doc.Content.Split(';').FirstOrDefault();
                if (contentTypePart?.StartsWith("data:") == true)
                {
                    _previewFileContentType = contentTypePart.Substring(5); // Remove "data:" prefix
                }
            }
            else
            {
                _previewFileContentType = null;
            }
            
            _showPreviewModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error opening preview: {ex.Message}");
            // Show error message to user
            JS.InvokeVoidAsync("alert", "Error opening preview. Please try downloading the file instead.");
        }
    }

    private void ClosePreviewModal()
    {
        _showPreviewModal = false;
        _documentToPreview = null;
        _previewFileDataUrl = null;
        _previewFileContentType = null;
        StateHasChanged();
    }

    private async Task OpenInNewTab(DocumentViewModel.Document doc)
    {
        try
        {
            if (!string.IsNullOrEmpty(doc.Content))
            {
                await JS.InvokeVoidAsync("open", doc.Content, "_blank");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error opening file in new tab: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Error opening file in new tab. Please try downloading instead.");
        }
    }

    private void EditDocument(DocumentViewModel.Document doc)
    {
        _documentToEdit = doc;
        _isEditingDocument = true;
        
        // Check if document has uploaded file (can't edit those directly)
        if (!string.IsNullOrEmpty(doc.FilePath) && string.IsNullOrEmpty(doc.Content))
        {
            // This is an uploaded file - show message
            _showEditUploadedFileModal = true;
            StateHasChanged();
            return;
        }
        
        // Check if document was created from a template
        if (doc.TemplateId.HasValue)
        {
            // Ensure custom templates are loaded before searching
            LoadCustomTemplates();
            
            // Find the template in the templates list
            var template = _templates.FirstOrDefault(t => t.Id == doc.TemplateId.Value);
            if (template != default)
            {
                _selectedTemplate = template;
                
                // Parse content back to template document model
                ParseDocumentContentToTemplateModel(doc);
                
                // Open template document modal for editing (not template builder)
                _showTemplateDocumentModal = true;
                _showTemplateSelectionModal = false;
                StateHasChanged();
                return;
            }
            else
            {
                // Template not found in _templates list, try to get it directly from ViewModel
                if (IsCustomTemplate(doc.TemplateId.Value))
                {
                    var customTemplate = _templateViewModel.GetTemplate(doc.TemplateId.Value);
                    if (customTemplate != null)
                    {
                        // Convert CustomTemplate to template tuple format
                        _selectedTemplate = (customTemplate.Id, customTemplate.Name, customTemplate.Category, customTemplate.Description);
                        
                        // Parse content back to template document model
                        ParseDocumentContentToTemplateModel(doc);
                        
                        // Open template document modal for editing
                        _showTemplateDocumentModal = true;
                        _showTemplateSelectionModal = false;
                        StateHasChanged();
                        return;
                    }
                }
            }
        }
        
        // If document has HTML content but no template, allow basic editing
        if (!string.IsNullOrEmpty(doc.Content))
        {
            _editingDocumentContent = doc.Content;
            _editingDocumentTitle = doc.Title;
            _showEditContentModal = true;
            StateHasChanged();
            return;
        }
        
        // Fallback: show message
        _showEditUploadedFileModal = true;
        StateHasChanged();
    }
    
