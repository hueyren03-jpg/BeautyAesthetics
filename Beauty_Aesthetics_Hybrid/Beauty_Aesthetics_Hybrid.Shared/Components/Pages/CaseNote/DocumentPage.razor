    private async Task AddDocumentType()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_newDocumentTypeName))
            {
                _addTypeError = "Document type name cannot be empty.";
                StateHasChanged();
                return;
            }

            var trimmedName = _newDocumentTypeName.Trim();
            
            // Check for duplicate names (case-insensitive comparison)
            if (_documentTypes.Any(t => t.Equals(trimmedName, StringComparison.OrdinalIgnoreCase)))
            {
                _addTypeError = "This document type already exists (case-insensitive).";
                StateHasChanged();
                return;
            }

            // Use ViewModel method which handles case-insensitive check and trimming
            _templateViewModel.AddDocumentType(trimmedName);
            ViewModel.InitializeSelectedTypes(_templateViewModel.DocumentTypes);
            await _templateViewModel.SaveDocumentTypesToStorageAsync();
            _newDocumentTypeName = "";
            _addTypeError = "";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _addTypeError = $"Error adding document type: {ex.Message}";
            StateHasChanged();
        }
    }
    
    private void HandleTypeNameKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newDocumentTypeName))
        {
            AddDocumentType();
        }
    }
    
    private void StartEditDocumentType(string type)
    {
        _editingDocumentType = type;
        _editingDocumentTypeOriginal = type;
        _editTypeError = null;
        StateHasChanged();
    }
    
    private async Task SaveDocumentType(string oldType)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_editingDocumentType) || string.IsNullOrEmpty(_editingDocumentTypeOriginal))
                return;
            
            var newType = _editingDocumentType.Trim();
            oldType = _editingDocumentTypeOriginal; // Use original name
            
            // Check if new name already exists (and it's not the same as old name)
            if (newType != oldType && _documentTypes.Contains(newType, StringComparer.OrdinalIgnoreCase))
            {
                _editTypeError = "This document type already exists.";
                StateHasChanged();
                return;
            }
            
            // Update the type via ViewModel
            _templateViewModel.UpdateDocumentType(oldType, newType);
            
            // Auto-save to localStorage
            await _templateViewModel.SaveDocumentTypesToStorageAsync();
            
            // Update all documents using this type (case-insensitive comparison)
            foreach (var doc in ViewModel.Documents.Where(d => 
                d.Type.Equals(oldType, StringComparison.OrdinalIgnoreCase)).ToList())
            {
                var updatedDoc = doc with { Type = newType };
                ViewModel.UpdateDocument(doc.Id, updatedDoc);
            }
            
            // Update selected types if needed
            if (ViewModel.SelectedTypes.Contains(oldType))
            {
                var newSelectedTypes = new HashSet<string>(ViewModel.SelectedTypes);
                newSelectedTypes.Remove(oldType);
                newSelectedTypes.Add(newType);
                ViewModel.SelectedTypes = newSelectedTypes;
            }
            
            CancelEditDocumentType();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _editTypeError = $"Error saving document type: {ex.Message}";
            StateHasChanged();
        }
    }
    
    private void CancelEditDocumentType()
    {
        _editingDocumentType = null;
        _editingDocumentTypeOriginal = null;
        _editTypeError = null;
        StateHasChanged();
    }
    
    private void HandleEditTypeKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrEmpty(_editingDocumentTypeOriginal))
        {
            SaveDocumentType(_editingDocumentTypeOriginal);
        }
        else if (e.Key == "Escape")
        {
            CancelEditDocumentType();
        }
    }
    
    private void ShowDeleteDocumentTypeConfirmation(string type)
    {
        _documentTypeToDelete = type;
        _deleteDocumentTypeError = null;
        _showDeleteDocumentTypeModal = true;
        StateHasChanged();
    }
    
    private void CancelDeleteDocumentType()
    {
        _showDeleteDocumentTypeModal = false;
        _documentTypeToDelete = null;
        _deleteDocumentTypeError = null;
        StateHasChanged();
    }
    
    private async Task ConfirmDeleteDocumentType()
    {
        if (string.IsNullOrEmpty(_documentTypeToDelete))
        {
            CancelDeleteDocumentType();
            return;
        }
        
        var typeToDelete = _documentTypeToDelete;
        
        // Check if any documents are using this type (case-insensitive comparison)
        var documentsUsingType = ViewModel.Documents.Where(d => 
            d.Type.Equals(typeToDelete, StringComparison.OrdinalIgnoreCase)).ToList();
        
        if (documentsUsingType.Count > 0)
        {
            // Prevent deletion - show error message
            _deleteDocumentTypeError = $"Cannot delete document type. There {(documentsUsingType.Count == 1 ? "is" : "are")} {documentsUsingType.Count} document{(documentsUsingType.Count == 1 ? "" : "s")} still using this type. Please update or remove those documents before deleting.";
            StateHasChanged();
            return;
        }
        
        // Remove from selected types
        var newSelectedTypes = new HashSet<string>(ViewModel.SelectedTypes);
        newSelectedTypes.Remove(typeToDelete);
        ViewModel.SelectedTypes = newSelectedTypes;
        
        // Remove from document types list via ViewModel
        _templateViewModel.RemoveDocumentType(typeToDelete);
        
        // Auto-save to localStorage
        await _templateViewModel.SaveDocumentTypesToStorageAsync();
        
        // If "All Types" was selected and this was the last type, clear selection
        if (ViewModel.ShowAllTypes && !_documentTypes.Any())
        {
            ViewModel.ShowAllTypes = false;
        }
        
        CancelDeleteDocumentType();
        StateHasChanged();
    }

