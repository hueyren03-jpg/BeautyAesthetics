    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            // Validate file type
            var allowedTypes = new[] { 
                "application/pdf", 
                "image/jpeg", 
                "image/jpg", 
                "image/png", 
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                "application/vnd.ms-excel", // .xls (old Excel)
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" // .xlsx (new Excel)
            };
            if (!allowedTypes.Contains(file.ContentType))
            {
                Console.WriteLine($"Invalid file type: {file.ContentType}");
                await JS.InvokeVoidAsync("alert", $"Invalid file type. Supported formats: PDF, JPG, PNG, DOCX, XLS, XLSX");
                return;
            }

            // Validate file size (10MB max for PDF/DOCX, 5MB for images)
            const int maxFileSizeImages = 5 * 1024 * 1024; // 5MB
            const int maxFileSizeDocuments = 10 * 1024 * 1024; // 10MB
            
            if (file.ContentType.StartsWith("image/") && file.Size > maxFileSizeImages)
            {
                Console.WriteLine($"Image file too large: {file.Size / 1024} KB");
                await JS.InvokeVoidAsync("alert", $"Image file too large. Maximum size: 5MB");
                return;
            }
            
            if ((file.ContentType.Contains("pdf") || file.ContentType.Contains("word") || file.ContentType.Contains("excel") || file.ContentType.Contains("spreadsheetml")) && file.Size > maxFileSizeDocuments)
            {
                Console.WriteLine($"Document file too large: {file.Size / 1024} KB");
                await JS.InvokeVoidAsync("alert", $"Document file too large. Maximum size: 10MB");
                return;
            }

            // Read file and convert to base64 data URL
            using var stream = file.OpenReadStream(maxAllowedSize: maxFileSizeDocuments);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var fileBytes = memoryStream.ToArray();
            var base64String = Convert.ToBase64String(fileBytes);
            var dataUrl = $"data:{file.ContentType};base64,{base64String}";

            // Store file information
            _uploadedFileName = file.Name;
            _uploadedFileDataUrl = dataUrl;
            _uploadedFileContentType = file.ContentType;
            
            Console.WriteLine($"File uploaded: {_uploadedFileName}, size: {file.Size / 1024} KB, type: {file.ContentType}");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling file upload: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Error uploading file: {ex.Message}");
        }
    }

    private void SaveNewDocument()
    {
        // Clear previous validation errors
        _showValidationError = false;
        _validationErrorMessage = "";
        
        // Validate document title
        if (string.IsNullOrWhiteSpace(_newDocument.Title))
        {
            _showValidationError = true;
            _validationErrorMessage = "Document title is required. Please enter a document title.";
            StateHasChanged();
            return;
        }

        // Validate file upload
        if (string.IsNullOrEmpty(_uploadedFileDataUrl))
        {
            _showValidationError = true;
            _validationErrorMessage = "Please upload a file. A file is required to create a document.";
            StateHasChanged();
            return;
        }

        var nextId = ViewModel.Documents.Any() ? ViewModel.Documents.Max(d => d.Id) + 1 : 1;
        
        // Save file path if file was uploaded
        string? filePath = null;
        if (!string.IsNullOrEmpty(_uploadedFileDataUrl))
        {
            filePath = _uploadedFileDataUrl;
        }
        
        var newDoc = new DocumentViewModel.Document(
            nextId,
            _newDocument.Title,
            _newDocument.Type,
            DateTime.Now,
            DateTime.Now,
            "Current User",
            filePath,
            null, // No HTML content for uploaded files
            null  // No template ID for uploaded files
        );

        ViewModel.AddDocument(newDoc);
        CloseAddModal();
        StateHasChanged();
    }

