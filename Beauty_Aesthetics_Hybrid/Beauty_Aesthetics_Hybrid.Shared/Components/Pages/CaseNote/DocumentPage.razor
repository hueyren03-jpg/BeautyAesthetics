@page "/documents"
@using Beauty_Aesthetics_WebPos.Components.Layout
@layout EmptyLayout
@using Beauty_Aesthetics_WebPos.Components.ViewModels
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.ComponentModel
@inject NavigationManager NavigationManager
@inject DocumentTemplateViewModel TemplateViewModel
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Documents - Beauty Aesthetics</PageTitle>

<div class="document-page">
    <!-- Header -->
    <!-- Header -->
    <header class="document-header">
        <div class="header-left">
            <div class="header-title-wrapper">
                <i class="bi bi-files header-icon"></i>
                <h1 class="header-title">Patient Documents</h1>
            </div>
            <a href="/case-notes" class="btn-close-mobile">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
        
        <div class="search-box">
            <i class="bi bi-search search-icon"></i>
            <input 
                type="text" 
                class="search-input" 
                placeholder="Search documents..." 
                value="@ViewModel.SearchQuery"
                @oninput="HandleSearchInput" />
        </div>

        <div class="header-right">
            <button class="btn-create" @onclick="ShowAddDocumentModal">
                <i class="bi bi-plus-lg"></i>
                <span>Add Document</span>
            </button>
            <button class="btn-create btn-create-template" @onclick="ShowTemplateSelectionModal">
                <i class="bi bi-file-text"></i>
                <span>Add from Template</span>
            </button>
            <button class="btn-create btn-create-custom" @onclick="CreateNewTemplate">
                <i class="bi bi-gear"></i>
                <span>Create Template</span>
            </button>
            <button class="btn-create btn-manage-types" @onclick="ShowManageDocumentTypesModal">
                <i class="bi bi-tags"></i>
                <span>Manage Types</span>
            </button>
            <a href="/case-notes" class="btn-close-header">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Filters Sidebar -->
        <aside class="sidebar @(_isSidebarCollapsed ? "collapsed" : "")">
            <div class="sidebar-header">
                <h2 class="sidebar-title">Filters</h2>
                <button class="btn-toggle-sidebar" @onclick="ToggleSidebar" title="@(_isSidebarCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
                    <i class="bi @(_isSidebarCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
                </button>
            </div>
            @if (!_isSidebarCollapsed)
            {
                <div class="sidebar-content">
                    <!-- Document Type Filter -->
                    <div class="filter-section">
                        <h3 class="filter-section-title">Document Type</h3>
                        <div class="filter-options">
                            <label class="filter-checkbox">
                                <input type="checkbox" 
                                       checked="@ViewModel.ShowAllTypes"
                                       @onchange="e => ToggleAllTypes((bool)e.Value!)" />
                                <span>All Types</span>
                            </label>
                            @foreach (var docType in _documentTypes)
                            {
                                <label class="filter-checkbox">
                                    <input type="checkbox" 
                                           checked="@(!ViewModel.ShowAllTypes && ViewModel.SelectedTypes.Contains(docType))"
                                           @onchange="e => ToggleType(docType, (bool)e.Value!)" />
                                    <span>@docType</span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- Date Filter -->
                    <div class="filter-section">
                        <h3 class="filter-section-title">Date</h3>
                        <div class="filter-options date-filter-options">
                            <div class="date-filter-row">
                                <label class="date-filter-label">Filter by</label>
                                <div class="custom-dropdown-wrapper form-dropdown">
                                    <div class="custom-dropdown-trigger @(_isDateFilterFieldDropdownOpen ? "open" : "")" @onclick="ToggleDateFilterFieldDropdown">
                                        <span>@(ViewModel.DateFilterField == "CreatedDate" ? "Created Date" : "Last Updated")</span>
                                        <i class="bi bi-chevron-down dropdown-arrow"></i>
                                    </div>
                                    @if (_isDateFilterFieldDropdownOpen)
                                    {
                                        <div class="custom-dropdown-menu">
                                            <div class="dropdown-item @(ViewModel.DateFilterField == "CreatedDate" ? "selected" : "")" @onclick='@(() => SelectDateFilterField("CreatedDate"))'>
                                                Created Date
                                            </div>
                                            <div class="dropdown-item @(ViewModel.DateFilterField == "LastUpdated" ? "selected" : "")" @onclick='@(() => SelectDateFilterField("LastUpdated"))'>
                                                Last Updated
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="date-filter-row">
                                <label class="date-filter-label">Range</label>
                                <div class="date-preset-buttons">
                                    <button type="button"
                                            class="date-preset-btn @(ViewModel.DateFilterPreset == "All" ? "active" : string.Empty)"
                                            @onclick='() => ViewModel.DateFilterPreset = "All"'>
                                        All
                                    </button>
                                    <button type="button"
                                            class="date-preset-btn @(ViewModel.DateFilterPreset == "ThisWeek" ? "active" : string.Empty)"
                                            @onclick='() => ViewModel.DateFilterPreset = "ThisWeek"'>
                                        This week
                                    </button>
                                    <button type="button"
                                            class="date-preset-btn @(ViewModel.DateFilterPreset == "ThisMonth" ? "active" : string.Empty)"
                                            @onclick='() => ViewModel.DateFilterPreset = "ThisMonth"'>
                                        This month
                                    </button>
                                    <button type="button"
                                            class="date-preset-btn @(ViewModel.DateFilterPreset == "Custom" ? "active" : string.Empty)"
                                            @onclick='() => ViewModel.DateFilterPreset = "Custom"'>
                                        Custom
                                    </button>
                                </div>
                            </div>

                            @if (ViewModel.DateFilterPreset == "Custom")
                            {
                                <div class="date-filter-row date-range-row">
                                    <label class="date-filter-label">From</label>
                                    <input type="date"
                                           class="date-filter-input"
                                           value="@(ViewModel.CustomDateFrom.HasValue ? ViewModel.CustomDateFrom.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                           @onchange="e => ViewModel.CustomDateFrom = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : System.DateTime.Parse(e.Value!.ToString()!)" />
                                </div>
                                <div class="date-filter-row date-range-row">
                                    <label class="date-filter-label">To</label>
                                    <input type="date"
                                           class="date-filter-input"
                                           value="@(ViewModel.CustomDateTo.HasValue ? ViewModel.CustomDateTo.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                           @onchange="e => ViewModel.CustomDateTo = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : System.DateTime.Parse(e.Value!.ToString()!)" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </aside>

        <!-- Documents List -->
        <main class="documents-list">
            @if (ViewModel.FilteredDocuments.Any())
            {
                <div class="documents-table">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Document Title</th>
                                <th>Type</th>
                                <th>
                                    <button class="btn-sort-header @(ViewModel.SortBy == "CreatedDate" ? "active" : "")" 
                                            @onclick='() => SetSortOrder("CreatedDate")' 
                                            title="@(ViewModel.SortBy == "CreatedDate" && ViewModel.SortAscending ? "Sort Descending" : "Sort Ascending")">
                                        Created Date
                                        <i class="bi @(ViewModel.SortBy == "CreatedDate" ? (ViewModel.SortAscending ? "bi-arrow-up" : "bi-arrow-down") : "bi-arrows-vertical")"></i>
                                    </button>
                                </th>
                                <th>
                                    <button class="btn-sort-header @(ViewModel.SortBy == "LastUpdated" ? "active" : "")" 
                                            @onclick='() => SetSortOrder("LastUpdated")' 
                                            title="@(ViewModel.SortBy == "LastUpdated" && ViewModel.SortAscending ? "Sort Descending" : "Sort Ascending")">
                                        Last Updated
                                        <i class="bi @(ViewModel.SortBy == "LastUpdated" ? (ViewModel.SortAscending ? "bi-arrow-up" : "bi-arrow-down") : "bi-arrows-vertical")"></i>
                                    </button>
                                </th>
                                <th>Uploaded By</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in ViewModel.PaginatedDocuments)
                            {
                                <tr class="@(doc.Id == _selectedDocumentId ? "selected" : "")" 
                                    @onclick="() => SelectDocument(doc.Id)">
                                    <td>
                                        <div class="document-title-cell">
                                            <i class="bi @GetDocumentIcon(doc.Type)"></i>
                                            <span>@doc.Title</span>
                                        </div>
                                    </td>
                                    <td><span class="document-type-badge">@doc.Type</span></td>
                                    <td>@doc.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    <td>@doc.LastUpdated.ToString("MMM dd, yyyy")</td>
                                    <td>@doc.UploadedBy</td>
                                    <td>
                                        <div class="document-actions" @onclick:stopPropagation="true">
                                            <button class="btn-action btn-view" @onclick="() => ViewDocument(doc)" title="View">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            @if (HasPreviewableFile(doc))
                                            {
                                                <button class="btn-action btn-preview" @onclick="() => PreviewDocument(doc)" title="Preview File">
                                                    <i class="bi bi-file-earmark-pdf"></i>
                                                </button>
                                            }
                                            <button class="btn-action btn-edit" @onclick="() => EditDocument(doc)" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn-action btn-download" @onclick="async () => await DownloadDocument(doc)" title="Download">
                                                <i class="bi bi-download"></i>
                                            </button>
                                            <button class="btn-action btn-delete" @onclick="() => DeleteDocument(doc.Id)" title="Delete">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    
                    <!-- Pagination Controls -->
                    @if (ViewModel.TotalPages > 1)
                    {
                        <div class="pagination-container">
                            <div class="pagination-info">
                                <span>Showing @((ViewModel.CurrentPage - 1) * ViewModel.ItemsPerPage + 1) - @(Math.Min(ViewModel.CurrentPage * ViewModel.ItemsPerPage, ViewModel.TotalDocuments)) of @ViewModel.TotalDocuments documents</span>
                            </div>
                            <div class="pagination-controls">
                                <button class="btn-pagination" 
                                        @onclick="GoToPreviousPage" 
                                        disabled="@(ViewModel.CurrentPage == 1)"
                                        title="Previous Page">
                                    <i class="bi bi-chevron-left"></i>
                                    <span>Previous</span>
                                </button>
                                <div class="page-numbers">
                                    @for (int i = 1; i <= ViewModel.TotalPages; i++)
                                    {
                                        var pageNum = i;
                                        @if (i == 1 || i == ViewModel.TotalPages || (i >= ViewModel.CurrentPage - 1 && i <= ViewModel.CurrentPage + 1))
                                        {
                                            <button class="btn-page-number @(i == ViewModel.CurrentPage ? "active" : "")" 
                                                    @onclick="() => GoToPage(pageNum)">
                                                @i
                                            </button>
                                        }
                                        else if (i == ViewModel.CurrentPage - 2 || i == ViewModel.CurrentPage + 2)
                                        {
                                            <span class="page-ellipsis">...</span>
                                        }
                                    }
                                </div>
                                <button class="btn-pagination" 
                                        @onclick="GoToNextPage" 
                                        disabled="@(ViewModel.CurrentPage == ViewModel.TotalPages)"
                                        title="Next Page">
                                    <span>Next</span>
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-inbox empty-icon"></i>
                    <h3>No documents found</h3>
                    <p>Try adjusting your search or filter criteria, or add a new document</p>
                </div>
            }
        </main>
    </div>
</div>

<!-- Add Document Modal -->
@if (_showAddModal)
{
    <div class="modal-overlay">
        <div class="modal-container add-document-modal">
            <div class="modal-header modal-header-add">
                <div class="modal-header-content">
                    <i class="bi bi-file-earmark-plus"></i>
                    <h3>Add New Document</h3>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseAddModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Document Title <span class="required">*</span></label>
                    <input type="text" class="form-input @(_showValidationError && string.IsNullOrWhiteSpace(_newDocument.Title) ? "input-error" : "")" @bind="_newDocument.Title" placeholder="Enter document title" />
                </div>
                <div class="form-group">
                    <label>Document Type</label>
                    <select class="form-select" @bind="_newDocument.Type">
                        @foreach (var type in _documentTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Upload File <span class="required">*</span></label>
                    <div class="file-upload-wrapper @(_showValidationError && string.IsNullOrEmpty(_uploadedFileDataUrl) ? "input-error" : "")">
                        <InputFile OnChange="HandleFileUpload" class="form-file-input" accept=".pdf,.jpg,.jpeg,.png,.docx,.xls,.xlsx" />
                    </div>
                    @if (!string.IsNullOrEmpty(_uploadedFileName))
                    {
                        <div class="uploaded-file-info">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@_uploadedFileName</span>
                        </div>
                    }
                    <small class="form-hint">Supported formats: PDF, JPG, PNG, DOCX, XLS, XLSX (Max 10MB)</small>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CloseAddModal">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-confirm" @onclick="SaveNewDocument">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Create Document</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Template Selection Modal -->
@if (_showTemplateSelectionModal)
{
    <div class="modal-overlay">
        <div class="modal-container template-selection-modal">
            <div class="modal-header modal-header-add">
                <div class="modal-header-content">
                    <i class="bi bi-file-text"></i>
                    <div>
                        <h3>Select Template</h3>
                        <p class="modal-subtitle">Choose a template to create a document or manage templates</p>
                    </div>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseTemplateSelectionModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="template-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" 
                           class="template-search-input" 
                           placeholder="Search templates..." 
                           @bind="_templateSearchQuery" 
                           @bind:event="oninput" />
                </div>
                <div class="template-category-filters">
                    <button type="button" 
                            class="category-filter-btn @(_selectedTemplateCategory == null ? "active" : "")" 
                            @onclick="() => ToggleTemplateCategory(null)">
                        All
                    </button>
                    @foreach (var category in AvailableTemplateCategories)
                    {
                        var cat = category;
                        <button type="button" 
                                class="category-filter-btn @(_selectedTemplateCategory == cat ? "active" : "")" 
                                @onclick="() => ToggleTemplateCategory(cat)">
                            @cat
                        </button>
                    }
                </div>
                <div class="templates-grid">
                    @if (FilteredTemplates.Any())
                    {
                        @foreach (var template in FilteredTemplates)
                        {
                            var isCustom = IsCustomTemplate(template.Id);
                            <div class="template-card @(_selectedTemplate?.Id == template.Id ? "selected" : "")">
                                <div class="template-card-content" @onclick="() => SelectTemplate(template)">
                                    <div class="template-card-header">
                                        <div class="template-card-icon">
                                            <i class="bi @GetTemplateIcon(template.Name)"></i>
                                        </div>
                                        @if (isCustom)
                                        {
                                            <span class="template-badge custom-badge" title="Custom Template">
                                                <i class="bi bi-star-fill"></i>
                                                Custom
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="template-badge system-badge" title="System Template">
                                                <i class="bi bi-shield-check"></i>
                                                System
                                            </span>
                                        }
                                    </div>
                                    <h4 class="template-card-title">@template.Name</h4>
                                    <p class="template-card-desc">@template.Description</p>
                                    <div class="template-card-footer">
                                        <span class="template-card-category">@template.Category</span>
                                    </div>
                                </div>
                                <div class="template-card-actions" @onclick:stopPropagation="true">
                                    @if (isCustom)
                                    {
                                        <button class="btn-template-action btn-edit-template" 
                                                @onclick="() => EditTemplate(template)" 
                                                title="Edit Template">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    }
                                    <button class="btn-template-action btn-delete-template" 
                                            @onclick="() => ShowDeleteTemplateConfirmation(template)" 
                                            title="Delete Template">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="template-empty">
                            <i class="bi bi-inbox"></i>
                            <p>No templates found</p>
                            <small>Try adjusting your search or filter criteria</small>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CloseTemplateSelectionModal">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-confirm" @onclick="ProceedWithTemplate" disabled="@(_selectedTemplate == null)">
                    <i class="bi bi-arrow-right"></i>
                    <span>Continue</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Template Confirmation Modal -->
@if (_showDeleteTemplateModal && _templateToDelete.HasValue)
{
    <div class="modal-overlay" @onclick="CancelDeleteTemplate">
        <div class="modal-container delete-template-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <h3>Delete Template</h3>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the template <strong>"@_templateToDelete.Value.Name"</strong>?</p>
                @if (!IsCustomTemplate(_templateToDelete.Value.Id))
                {
                    <div class="delete-warning-system" style="margin-top: 12px; padding: 12px; background: #fef3c7; border: 1px solid #f59e0b; border-radius: 6px; color: #92400e;">
                        <i class="bi bi-info-circle-fill" style="margin-right: 8px;"></i>
                        <span>This is a system template. It will be removed from your template list but can be restored if needed.</span>
                    </div>
                }
                else
                {
                    <div class="delete-warning" style="margin-top: 12px; padding: 12px; background: #fee2e2; border: 1px solid #ef4444; border-radius: 6px; color: #dc2626;">
                        <i class="bi bi-exclamation-triangle-fill" style="margin-right: 8px;"></i>
                        <span>This action cannot be undone. All template data will be permanently deleted.</span>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" @onclick="CancelDeleteTemplate">
                    <i class="bi bi-x-circle"></i>
                    <span>Cancel</span>
                </button>
                <button class="btn-modal-delete" @onclick="ConfirmDeleteTemplate">
                    <i class="bi bi-trash3-fill"></i>
                    <span>Delete Template</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Template-Based Document Creation Modal -->
@if (_showTemplateDocumentModal && _selectedTemplate != null)
{
    <div class="modal-overlay">
        <div class="modal-container template-document-modal">
            <div class="modal-header modal-header-add">
                <i class="bi bi-file-text"></i>
                <div>
                    <h3>@(_isEditingDocument ? "Edit Document" : "Create Document from Template")</h3>
                    <span class="template-subtitle">@_selectedTemplate.Value.Name</span>
                </div>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Document Title <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="_templateDocument.Title" placeholder="Enter document title" />
                </div>
                @if (IsCustomTemplate(_selectedTemplate.Value.Id))
                {
                    var customTemplate = _templateViewModel.GetTemplate(_selectedTemplate.Value.Id);
                    if (customTemplate != null)
                    {
                        foreach (var field in customTemplate.Fields.OrderBy(f => f.Order))
                        {
                            <div class="form-group">
                                <label>
                                    @field.Label
                                    @if (field.IsRequired)
                                    {
                                        <span class="required">*</span>
                                    }
                                </label>
                                @if (!string.IsNullOrEmpty(field.HelpText))
                                {
                                    <small class="field-help-text" style="display: block; color: #64748b; font-size: 12px; margin-bottom: 4px;">@field.HelpText</small>
                                }
                                @switch (field.Type)
                                {
                                    case DocumentTemplateViewModel.FieldType.Text:
                                    case DocumentTemplateViewModel.FieldType.Email:
                                    case DocumentTemplateViewModel.FieldType.Phone:
                                        <input type="@GetInputType(field.Type)" 
                                               class="form-input" 
                                               value="@(_customTemplateFieldValues.ContainsKey(field.Id) ? _customTemplateFieldValues[field.Id] : "")" 
                                               @onchange="@((ChangeEventArgs e) => _customTemplateFieldValues[field.Id] = e.Value?.ToString() ?? "")"
                                               placeholder="@(field.Placeholder ?? $"Enter {field.Label.ToLower()}")"
                                               required="@field.IsRequired" />
                                        break;
                                        
                                    case DocumentTemplateViewModel.FieldType.TextArea:
                                        <textarea class="form-textarea" 
                                                  value="@(_customTemplateFieldValues.ContainsKey(field.Id) ? _customTemplateFieldValues[field.Id] : "")" 
                                                  @oninput="@((ChangeEventArgs e) => _customTemplateFieldValues[field.Id] = e.Value?.ToString() ?? "")"
                                                  rows="3" 
                                                  placeholder="@(field.Placeholder ?? $"Enter {field.Label.ToLower()}")"
                                                  required="@field.IsRequired"></textarea>
                                        break;
                                        
                                    case DocumentTemplateViewModel.FieldType.Number:
                                        <input type="number" 
                                               class="form-input" 
                                               value="@(_customTemplateFieldValues.ContainsKey(field.Id) ? _customTemplateFieldValues[field.Id] : "")"
                                               @onchange="@((ChangeEventArgs e) => _customTemplateFieldValues[field.Id] = e.Value?.ToString() ?? "")"
                                               placeholder="@(field.Placeholder ?? $"Enter {field.Label.ToLower()}")"
                                               required="@field.IsRequired" />
                                        break;
                                        
                                    case DocumentTemplateViewModel.FieldType.Date:
                                        <input type="date" 
                                               class="form-input" 
                                               value="@(_customTemplateFieldValues.ContainsKey(field.Id) ? _customTemplateFieldValues[field.Id] : "")"
                                               @onchange="@((ChangeEventArgs e) => _customTemplateFieldValues[field.Id] = e.Value?.ToString() ?? "")"
                                               required="@field.IsRequired" />
                                        break;
                                        
                                    case DocumentTemplateViewModel.FieldType.Time:
                                        <div class="custom-time-picker" @onclick:stopPropagation="true">
                                            @{
                                                var timeFieldKey = $"time_{field.Id}";
                                                var timeValue = _customTemplateFieldValues.ContainsKey(field.Id) ? _customTemplateFieldValues[field.Id] : "";
                                                var currentTime = ParseTimeValue(timeValue);
                                                var showTimePicker = _openTimePickers.Contains(timeFieldKey);
                                            }
                                            <button type="button" class="time-display-btn" @onclick="() => ToggleCustomTimePicker(timeFieldKey)">
                                                <i class="bi bi-clock"></i>
                                                <span>@(string.IsNullOrWhiteSpace(timeValue) ? "Select Time" : FormatTimeForField(currentTime))</span>
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                            
                                            @if (showTimePicker)
                                            {
                                                <div class="time-picker-dropdown" @onclick:stopPropagation="true">
                                                    <div class="time-picker-header">
                                                        <span>Select @field.Label</span>
                                                        <button type="button" class="btn-close-picker" @onclick="() => ToggleCustomTimePicker(timeFieldKey)">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </div>
                                                    <div class="time-picker-body">
                                                        <div class="time-column">
                                                            <label class="column-label">Hour</label>
                                                            <div class="time-options">
