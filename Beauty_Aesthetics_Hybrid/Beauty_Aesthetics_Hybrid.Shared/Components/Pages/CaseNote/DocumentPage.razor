    private async Task DownloadDocument(DocumentViewModel.Document doc)
    {
        try
        {
            // Determine file name and extension
            var fileName = SanitizeFileName(doc.Title);
            var extension = GetFileExtension(doc);
            
            // If document has a file path (uploaded file) and it's already a PDF
            if (!string.IsNullOrEmpty(doc.FilePath) && IsPdfFile(doc.FilePath))
            {
                // Download the PDF file directly
                await JS.InvokeVoidAsync("downloadDocumentFile", $"{fileName}.pdf", doc.FilePath);
            }
            // If document has a file path (uploaded file) but not PDF - download as is
            else if (!string.IsNullOrEmpty(doc.FilePath))
            {
                // Download the file
                await JS.InvokeVoidAsync("downloadDocumentFile", $"{fileName}{extension}", doc.FilePath);
            }
            // If document has HTML content - download as PDF using print dialog
            else if (!string.IsNullOrEmpty(doc.Content))
            {
                // Create a complete HTML document with proper structure for PDF
                var htmlDocument = GenerateDocumentHTML(doc);
                
                // Open print dialog to save as PDF
                var pdfFileName = $"{fileName}.pdf";
                await JS.InvokeVoidAsync("downloadDocumentAsPDF", htmlDocument, pdfFileName);
            }
            else
            {
                // No content or file to download
                await JS.InvokeVoidAsync("alert", "This document has no content or file to download.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading document: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Error downloading document: {ex.Message}");
        }
    }
    
    private async Task PrintDocument(DocumentViewModel.Document doc)
    {
        try
        {
            // If document has HTML content - print it
            if (!string.IsNullOrEmpty(doc.Content))
            {
                // Create a complete HTML document with proper structure for printing
                var htmlDocument = GenerateDocumentHTML(doc);
                
                // Open print dialog
                await JS.InvokeVoidAsync("printDocument", htmlDocument, doc.Title);
            }
            else if (!string.IsNullOrEmpty(doc.FilePath) && IsPdfFile(doc.FilePath))
            {
                // For PDF files, open in new tab to print
                await JS.InvokeVoidAsync("window.open", doc.FilePath, "_blank");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "This document cannot be printed directly. Please download it first.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing document: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Error printing document: {ex.Message}");
        }
    }
    
    private string GenerateDocumentHTML(DocumentViewModel.Document doc)
    {
        var html = new System.Text.StringBuilder();
        
        html.AppendLine("<!DOCTYPE html>");
        html.AppendLine("<html lang=\"en\">");
        html.AppendLine("<head>");
        html.AppendLine("<meta charset=\"UTF-8\">");
        html.AppendLine("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">");
        html.AppendLine($"<title>{System.Net.WebUtility.HtmlEncode(doc.Title)}</title>");
        html.AppendLine("<style>");
        html.AppendLine("@page { size: A4; margin: 0.75in; }");
        html.AppendLine("@media print {");
        html.AppendLine("  body { margin: 0; padding: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }");
        html.AppendLine("  * { box-sizing: border-box; }");
        html.AppendLine("}");
        html.AppendLine("body {");
        html.AppendLine("  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;");
        html.AppendLine("  line-height: 1.65;");
        html.AppendLine("  color: #1e293b;");
        html.AppendLine("  max-width: 8.5in;");
        html.AppendLine("  margin: 0 auto;");
        html.AppendLine("  padding: 0;");
        html.AppendLine("  background: #fff;");
        html.AppendLine("}");
        html.AppendLine("h1, h2, h3, h4 { color: #0f172a; margin-top: 24px; margin-bottom: 12px; font-weight: 700; }");
        html.AppendLine("h1 { font-size: 32px; letter-spacing: -0.8px; }");
        html.AppendLine("h2 { font-size: 24px; }");
        html.AppendLine("h3 { font-size: 18px; }");
        html.AppendLine("table { width: 100%; border-collapse: collapse; margin: 12px 0; }");
        html.AppendLine("table th, table td { padding: 12px; text-align: left; }");
        html.AppendLine("table th { background: #f8fafc; font-weight: 600; color: #475569; }");
        html.AppendLine("</style>");
        html.AppendLine("</head>");
        html.AppendLine("<body>");
        html.AppendLine(doc.Content);
        html.AppendLine("</body>");
        html.AppendLine("</html>");
        
        return html.ToString();
    }
    
    private string SanitizeFileName(string fileName)
    {
        // Remove invalid characters from file name
        var invalidChars = Path.GetInvalidFileNameChars();
        var sanitized = string.Join("_", fileName.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));
        return sanitized.Trim();
    }
    
    private string GetFileExtension(DocumentViewModel.Document doc)
    {
        if (string.IsNullOrEmpty(doc.FilePath))
            return "";
        
        // Try to determine extension from MIME type in data URL first
        if (doc.FilePath.StartsWith("data:"))
        {
            var mimeMatch = System.Text.RegularExpressions.Regex.Match(doc.FilePath, @"data:([^;]+)");
            if (mimeMatch.Success)
            {
                var mimeType = mimeMatch.Groups[1].Value;
                return mimeType switch
                {
                    "application/pdf" => ".pdf",
                    "image/jpeg" => ".jpg",
                    "image/jpg" => ".jpg",
                    "image/png" => ".png",
                    "image/gif" => ".gif",
                    "application/msword" => ".doc",
                    "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => ".docx",
                    "application/vnd.ms-excel" => ".xls",
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => ".xlsx",
                    _ => ".bin"
                };
            }
        }
        
        // Extract extension from file path if it's a regular path
        if (doc.FilePath.Contains(".") && !doc.FilePath.StartsWith("data:"))
        {
            var extension = Path.GetExtension(doc.FilePath);
            if (!string.IsNullOrEmpty(extension))
                return extension;
        }
        
        return "";
    }
    
    private bool IsPdfFile(string filePath)
    {
        if (string.IsNullOrEmpty(filePath))
            return false;
        
        return filePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ||
               filePath.Contains("application/pdf", StringComparison.OrdinalIgnoreCase);
    }
    
    private bool IsImageFile(string filePath)
    {
        if (string.IsNullOrEmpty(filePath))
            return false;
        
        return filePath.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase) ||
               filePath.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
               filePath.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
               filePath.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
               filePath.EndsWith(".gif", StringComparison.OrdinalIgnoreCase) ||
               filePath.Contains("image/jpeg", StringComparison.OrdinalIgnoreCase) ||
               filePath.Contains("image/jpg", StringComparison.OrdinalIgnoreCase) ||
               filePath.Contains("image/png", StringComparison.OrdinalIgnoreCase) ||
               filePath.Contains("image/gif", StringComparison.OrdinalIgnoreCase);
    }
    
    private bool IsDocxFile(string filePath)
    {
        if (string.IsNullOrEmpty(filePath))
            return false;
        
        return filePath.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) ||
               filePath.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) ||
               filePath.Contains("application/vnd.openxmlformats-officedocument.wordprocessingml.document", StringComparison.OrdinalIgnoreCase) ||
               filePath.Contains("application/msword", StringComparison.OrdinalIgnoreCase);
    }
    
    private bool IsExcelFile(string filePath)
    {
        if (string.IsNullOrEmpty(filePath))
            return false;
        
        return filePath.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ||
               filePath.EndsWith(".xls", StringComparison.OrdinalIgnoreCase) ||
               filePath.Contains("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", StringComparison.OrdinalIgnoreCase) ||
               filePath.Contains("application/vnd.ms-excel", StringComparison.OrdinalIgnoreCase);
    }
    
    // Custom time picker methods for template fields
    private void ToggleCustomTimePicker(string fieldKey)
    {
        if (_openTimePickers.Contains(fieldKey))
        {
            _openTimePickers.Remove(fieldKey);
        }
        else
        {
            // Close other time pickers
            _openTimePickers.Clear();
            _openTimePickers.Add(fieldKey);
        }
        StateHasChanged();
    }
    
    private TimeOnly ParseTimeValue(string timeValue)
    {
        if (string.IsNullOrWhiteSpace(timeValue))
            return new TimeOnly(9, 0);
        
        // Try parsing as HH:mm format
        if (TimeOnly.TryParse(timeValue, out var time))
            return time;
        
        // Try parsing as HH:mm:ss format
        if (TimeOnly.TryParseExact(timeValue, "HH:mm:ss", out var time2))
            return time2;
        
        return new TimeOnly(9, 0);
    }
    
    private string FormatTimeForField(TimeOnly time)
    {
        return time.ToString("hh:mm tt");
    }
    
    private int GetHour12ForField(TimeOnly time)
    {
        int hour = time.Hour % 12;
        return hour == 0 ? 12 : hour;
    }
    
    private void SetCustomTimeHour(string fieldKey, int fieldId, int hour)
    {
        var currentTime = ParseTimeValue(_customTemplateFieldValues.ContainsKey(fieldId) ? _customTemplateFieldValues[fieldId] : "");
        bool isPM = currentTime.Hour >= 12;
        int hour24 = hour == 12 ? (isPM ? 12 : 0) : (isPM ? hour + 12 : hour);
        var newTime = new TimeOnly(hour24, currentTime.Minute);
        _customTemplateFieldValues[fieldId] = newTime.ToString("HH:mm");
        StateHasChanged();
    }
    
    private void SetCustomTimeMinute(string fieldKey, int fieldId, int minute)
    {
        var currentTime = ParseTimeValue(_customTemplateFieldValues.ContainsKey(fieldId) ? _customTemplateFieldValues[fieldId] : "");
        var newTime = new TimeOnly(currentTime.Hour, minute);
        _customTemplateFieldValues[fieldId] = newTime.ToString("HH:mm");
        StateHasChanged();
    }
    
    private void SetCustomTimePeriod(string fieldKey, int fieldId, bool isAM)
    {
        var currentTime = ParseTimeValue(_customTemplateFieldValues.ContainsKey(fieldId) ? _customTemplateFieldValues[fieldId] : "");
        int currentHour12 = currentTime.Hour % 12;
        int newHour = isAM ? currentHour12 : (currentHour12 + 12);
        if (currentHour12 == 0 && isAM) newHour = 0;
        if (currentHour12 == 0 && !isAM) newHour = 12;
        var newTime = new TimeOnly(newHour, currentTime.Minute);
        _customTemplateFieldValues[fieldId] = newTime.ToString("HH:mm");
        StateHasChanged();
    }
    
    // DateTime field methods
    private (string Date, string Time) ParseDateTimeValue(string dateTimeValue)
    {
        if (string.IsNullOrWhiteSpace(dateTimeValue))
            return ("", "");
        
        // Try parsing as datetime-local format (YYYY-MM-DDTHH:mm)
        if (DateTime.TryParse(dateTimeValue, out var dateTime))
        {
            return (dateTime.ToString("yyyy-MM-dd"), dateTime.ToString("HH:mm"));
        }
        
        // Try parsing as separate date and time
        var parts = dateTimeValue.Split('T');
        if (parts.Length == 2)
        {
            return (parts[0], parts[1]);
        }
        
        return ("", "");
    }
    
    private void SetCustomDateTimeDate(string fieldKey, int fieldId, string dateValue)
    {
        var currentValue = _customTemplateFieldValues.ContainsKey(fieldId) ? _customTemplateFieldValues[fieldId] : "";
        var (_, timePart) = ParseDateTimeValue(currentValue);
        
        if (string.IsNullOrWhiteSpace(dateValue))
        {
            if (!string.IsNullOrWhiteSpace(timePart))
            {
                _customTemplateFieldValues[fieldId] = $"T{timePart}";
            }
            else
            {
                _customTemplateFieldValues.Remove(fieldId);
            }
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(timePart))
            {
                _customTemplateFieldValues[fieldId] = $"{dateValue}T{timePart}";
            }
            else
            {
                _customTemplateFieldValues[fieldId] = $"{dateValue}T09:00";
            }
        }
        StateHasChanged();
    }
    
    private void SetCustomDateTimeHour(string fieldKey, int fieldId, int hour)
    {
        var currentValue = _customTemplateFieldValues.ContainsKey(fieldId) ? _customTemplateFieldValues[fieldId] : "";
        var (datePart, timePart) = ParseDateTimeValue(currentValue);
        var currentTime = ParseTimeValue(timePart);
        
        bool isPM = currentTime.Hour >= 12;
        int hour24 = hour == 12 ? (isPM ? 12 : 0) : (isPM ? hour + 12 : hour);
        var newTime = new TimeOnly(hour24, currentTime.Minute);
        
        UpdateDateTimeValue(fieldId, datePart, newTime.ToString("HH:mm"));
    }
    
    private void SetCustomDateTimeMinute(string fieldKey, int fieldId, int minute)
    {
        var currentValue = _customTemplateFieldValues.ContainsKey(fieldId) ? _customTemplateFieldValues[fieldId] : "";
        var (datePart, timePart) = ParseDateTimeValue(currentValue);
        var currentTime = ParseTimeValue(timePart);
        var newTime = new TimeOnly(currentTime.Hour, minute);
        UpdateDateTimeValue(fieldId, datePart, newTime.ToString("HH:mm"));
    }
    
    private void SetCustomDateTimePeriod(string fieldKey, int fieldId, bool isAM)
    {
        var currentValue = _customTemplateFieldValues.ContainsKey(fieldId) ? _customTemplateFieldValues[fieldId] : "";
        var (datePart, timePart) = ParseDateTimeValue(currentValue);
        var currentTime = ParseTimeValue(timePart);
        
        int currentHour12 = currentTime.Hour % 12;
        int newHour = isAM ? currentHour12 : (currentHour12 + 12);
        if (currentHour12 == 0 && isAM) newHour = 0;
        if (currentHour12 == 0 && !isAM) newHour = 12;
        var newTime = new TimeOnly(newHour, currentTime.Minute);
        
        UpdateDateTimeValue(fieldId, datePart, newTime.ToString("HH:mm"));
    }
    
    private void UpdateDateTimeValue(int fieldId, string datePart, string timePart)
    {
        if (string.IsNullOrWhiteSpace(datePart))
        {
            // If no date, store just time with T prefix
            _customTemplateFieldValues[fieldId] = $"T{timePart}";
        }
        else
        {
            // Store as datetime format: YYYY-MM-DDTHH:mm
            _customTemplateFieldValues[fieldId] = $"{datePart}T{timePart}";
        }
        StateHasChanged();
    }


