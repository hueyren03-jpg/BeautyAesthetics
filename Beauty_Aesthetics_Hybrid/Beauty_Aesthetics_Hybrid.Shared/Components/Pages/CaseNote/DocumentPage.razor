    private bool _showValidationError = false;
    private string _validationErrorMessage = "";
    
    // Template deletion state
    private bool _showDeleteTemplateModal = false;
    private (int Id, string Name, string Category, string Description)? _templateToDelete = null;
    
    // Track deleted system templates (can't actually delete them, so we hide them)
    private HashSet<int> _deletedSystemTemplateIds = new();
    
    // Available template categories - use managed document types
    private List<string> AvailableTemplateCategories
    {
        get
        {
            return _documentTypes
                .OrderBy(c => c)
                .ToList();
        }
    }

    // ===== MODELS =====
    // Document model is now in DocumentViewModel

    // Mutable class for form binding
    public class NewDocumentModel
    {
        public string Title { get; set; } = "";
        public string Type { get; set; } = "Treatment Note";
    }

    // Template document form model
    public class TemplateDocumentModel
    {
        // Common Fields
        public string Title { get; set; } = "";
        public string PatientName { get; set; } = "";
        public string PatientId { get; set; } = "";
        public DateTime Date { get; set; } = DateTime.Now;
        public string DoctorName { get; set; } = "Dr. Sarah Lee";
        public string ClinicName { get; set; } = "Beauty Aesthetics Clinic";
        
        // Consultation/Treatment Fields
        public string ChiefComplaint { get; set; } = "";
        public string MedicalHistory { get; set; } = "";
        public string Allergies { get; set; } = "";
        public string CurrentMedications { get; set; } = "";
        public string PhysicalExamination { get; set; } = "";
        public string Assessment { get; set; } = "";
        public string Plan { get; set; } = "";
        public string TreatmentPerformed { get; set; } = "";
        public string TreatmentArea { get; set; } = "";
        public string TreatmentNotes { get; set; } = "";
        public string FollowUpInstructions { get; set; } = "";
        public DateTime? NextAppointment { get; set; } = null;
        
        // Helper properties for appointment date/time selection
        public DateTime? NextAppointmentDate { get; set; } = null;
        public TimeOnly NextAppointmentTime { get; set; } = new TimeOnly(9, 0); // Default to 9:00 AM
        
        // Consent Form Fields
        public string Procedure { get; set; } = "";
        public string Risks { get; set; } = "";
        public string Benefits { get; set; } = "";
        public string Alternatives { get; set; } = "";
        public bool ConsentGiven { get; set; } = false;
        public string WitnessName { get; set; } = "";
        
        // Prescription Fields
        public string Medication { get; set; } = "";
        public string Dosage { get; set; } = "";
        public string Frequency { get; set; } = "";
        public string Duration { get; set; } = "";
        public string Instructions { get; set; } = "";
        public string Indication { get; set; } = "";
        public int Quantity { get; set; } = 1;
        
        // Medical Certificate Fields
        public string CertificateType { get; set; } = "Day Off";
        public DateTime? StartDate { get; set; } = null;
        public DateTime? EndDate { get; set; } = null;
        public string Reason { get; set; } = "";
        public string Diagnosis { get; set; } = "";
        
        // General Content
        public string Content { get; set; } = "";
        public string Notes { get; set; } = "";
    }

    // ===== COMPUTED PROPERTIES =====
    // All computed properties are now in DocumentViewModel

    // ===== INITIALIZATION =====
    protected override async Task OnInitializedAsync()
    {
        // Initialize ViewModel with mock data
        ViewModel.InitializeMockData();
        
        // Set all types as selected by default
        ViewModel.InitializeSelectedTypes(_documentTypes);
        
        // Subscribe to ViewModel property changes
        _viewModelPropertyChangedHandler = (sender, args) => 
        {
            InvokeAsync(StateHasChanged);
        };
        ViewModel.PropertyChanged += _viewModelPropertyChangedHandler;
        
        // Load templates and document types from localStorage
        await _templateViewModel.InitializeAsync();
        
        LoadCustomTemplates();
        _templateViewModel.PropertyChanged += OnTemplateViewModelChanged;
    }

    private void OnTemplateViewModelChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(DocumentTemplateViewModel.CustomTemplates))
        {
            InvokeAsync(() =>
            {
                try
                {
                    LoadCustomTemplates();
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    // Log error but don't crash
                    Console.WriteLine($"Error loading custom templates: {ex.Message}");
                }
            });
        }
        else if (e.PropertyName == nameof(DocumentTemplateViewModel.DocumentTypes))
        {
            InvokeAsync(() =>
            {
                try
                {
                    // Update selected types if needed
                    ViewModel.InitializeSelectedTypes(_documentTypes);
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error updating document types: {ex.Message}");
                }
            });
        }
    }

    private void LoadCustomTemplates()
    {
        try
        {
            var customTemplateIds = _templateViewModel.CustomTemplates.Select(t => t.Id).ToHashSet();
            
            // Remove existing custom templates by their actual IDs
            _templates.RemoveAll(t => customTemplateIds.Contains(t.Id));
            
            var customTemplates = _templateViewModel.CustomTemplates
                .Select(t => (t.Id, t.Name, t.Category, t.Description))
                .ToList();
            
            _templates.AddRange(customTemplates);
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading custom templates: {ex.Message}");
        }
    }

    private bool IsCustomTemplate(int templateId)
    {
        return _templateViewModel.CustomTemplates.Any(t => t.Id == templateId);
    }

    public void Dispose()
    {
        if (_viewModelPropertyChangedHandler != null)
        {
            ViewModel.PropertyChanged -= _viewModelPropertyChangedHandler;
        }
        _templateViewModel.PropertyChanged -= OnTemplateViewModelChanged;
    }

    // InitializeMockData is now in DocumentViewModel

    // ===== METHODS =====
    // ===== PAGINATION METHODS =====
    private void GoToPage(int page)
    {
        ViewModel.GoToPage(page);
    }
    
    private void GoToNextPage()
    {
        ViewModel.GoToNextPage();
    }
    
    private void GoToPreviousPage()
    {
        ViewModel.GoToPreviousPage();
    }

    private void ToggleAllTypes(bool isChecked)
    {
        ViewModel.ToggleAllTypes(isChecked);
        if (!isChecked)
        {
            ViewModel.InitializeSelectedTypes(_documentTypes);
        }
    }

    private void ToggleType(string type, bool isSelected)
    {
        ViewModel.ToggleType(type, isSelected);
    }

    private void SetSortOrder(string sortBy)
    {
        ViewModel.SetSortOrder(sortBy);
    }
    
    private void HandleSearchInput(ChangeEventArgs e)
    {
        try
        {
            var searchValue = e.Value?.ToString()?.Trim() ?? "";
            // Sanitize search input to prevent potential issues
            ViewModel.SearchQuery = System.Web.HttpUtility.HtmlEncode(searchValue);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling search input: {ex.Message}");
            ViewModel.SearchQuery = "";
        }
    }

    private void SelectDocument(int docId)
    {
        _selectedDocumentId = docId == _selectedDocumentId ? null : docId;
    }

    private void ShowAddDocumentModal()
    {
        _newDocument = new NewDocumentModel { Title = "", Type = "Treatment Note" };
        _uploadedFileName = null;
        _uploadedFileDataUrl = null;
        _uploadedFileContentType = null;
        _showValidationError = false;
        _validationErrorMessage = "";
        _showAddModal = true;
    }

    private void CloseAddModal()
    {
        _showAddModal = false;
        _newDocument = new NewDocumentModel { Title = "", Type = "Treatment Note" };
        _uploadedFileName = null;
        _uploadedFileDataUrl = null;
        _uploadedFileContentType = null;
        _showValidationError = false;
        _validationErrorMessage = "";
    }

    // Template Selection Methods
    private void ShowTemplateSelectionModal()
    {
        // Reload custom templates when opening the modal to ensure we see the latest
        LoadCustomTemplates();
        _showTemplateSelectionModal = true;
        _selectedTemplate = null;
        _templateSearchQuery = "";
        _selectedTemplateCategory = null; // Reset category filter
        _showAppointmentTimePicker = false; // Close time picker if open
        StateHasChanged();
    }

    private void CloseTemplateSelectionModal()
    {
        _showTemplateSelectionModal = false;
        _selectedTemplate = null;
        _templateSearchQuery = "";
        _selectedTemplateCategory = null; // Reset category filter
        _showAppointmentTimePicker = false; // Close time picker if open
    }

    private void SelectTemplate((int Id, string Name, string Category, string Description) template)
    {
        _selectedTemplate = template;
        StateHasChanged();
    }

    private void ProceedWithTemplate()
    {
        if (_selectedTemplate == null) return;
        
        _showTemplateSelectionModal = false;
        _showTemplateDocumentModal = true;
        
        // Only initialize if not editing (preserve existing data when editing)
        if (!_isEditingDocument)
        {
            // Initialize template document with default values
            _templateDocument = new TemplateDocumentModel
            {
                Title = _selectedTemplate.Value.Name,
                Date = DateTime.Now,
                NextAppointmentDate = null,
                NextAppointmentTime = new TimeOnly(9, 0)
            };
            
            // Initialize custom template field values if it's a custom template
            if (IsCustomTemplate(_selectedTemplate.Value.Id))
            {
                var customTemplate = _templateViewModel.GetTemplate(_selectedTemplate.Value.Id);
                if (customTemplate != null)
                {
                    _customTemplateFieldValues = new Dictionary<int, string>();
                    foreach (var field in customTemplate.Fields)
                    {
                        _customTemplateFieldValues[field.Id] = field.DefaultValue ?? "";
                    }
                }
            }
        }
        
        _showAppointmentTimePicker = false; // Ensure time picker is closed when opening new template
        StateHasChanged();
    }
    
    private string GetInputType(DocumentTemplateViewModel.FieldType fieldType)
    {
        return fieldType switch
        {
            DocumentTemplateViewModel.FieldType.Email => "email",
            DocumentTemplateViewModel.FieldType.Phone => "tel",
            _ => "text"
        };
    }

    private void CloseTemplateDocumentModal()
    {
        _showTemplateDocumentModal = false;
        if (!_isEditingDocument)
        {
            _selectedTemplate = null;
        }
        _showAppointmentTimePicker = false; // Close time picker
        _openTimePickers.Clear(); // Close all custom time pickers
        _templateDocument = new TemplateDocumentModel
        {
            NextAppointmentDate = null,
            NextAppointmentTime = new TimeOnly(9, 0)
        };
        _customTemplateFieldValues.Clear(); // Clear custom template field values
        _showValidationError = false; // Clear validation error
        _validationErrorMessage = "";
        _isEditingDocument = false;
        _documentToEdit = null;
    }

    private void CloseValidationError()
    {
        _showValidationError = false;
        _validationErrorMessage = "";
        StateHasChanged();
    }

    private void BackToTemplateSelection()
    {
        _showTemplateDocumentModal = false;
        _showTemplateSelectionModal = true;
        _showAppointmentTimePicker = false; // Close time picker
        _showValidationError = false; // Clear validation error
        _validationErrorMessage = "";
    }

    private void SaveTemplateDocument()
    {
        // Clear previous validation errors
        _showValidationError = false;
        _validationErrorMessage = "";
        
        // Validate document title
        if (string.IsNullOrWhiteSpace(_templateDocument.Title))
        {
            _showValidationError = true;
            _validationErrorMessage = "Document title is required.";
            StateHasChanged();
            return;
        }
        
        if (_selectedTemplate == null)
        {
            _showValidationError = true;
            _validationErrorMessage = "Please select a template.";
            StateHasChanged();
            return;
        }

        // Validate required fields based on template type
        if (IsCustomTemplate(_selectedTemplate.Value.Id))
        {
            // Validate custom template required fields
            var customTemplate = _templateViewModel.GetTemplate(_selectedTemplate.Value.Id);
            if (customTemplate != null)
            {
                var missingFields = new List<string>();
                foreach (var field in customTemplate.Fields.Where(f => f.IsRequired))
                {
                    if (!_customTemplateFieldValues.ContainsKey(field.Id) || 
                        string.IsNullOrWhiteSpace(_customTemplateFieldValues[field.Id]))
                    {
                        missingFields.Add(field.Label);
                    }
                }
                
                if (missingFields.Any())
                {
                    _showValidationError = true;
                    _validationErrorMessage = $"Please fill in the required fields: {string.Join(", ", missingFields)}";
                    StateHasChanged();
                    return;
                }
            }
        }
        else
        {
            // Validate system template required fields based on template name
            var missingFields = new List<string>();
            
            if (_selectedTemplate.Value.Name.Contains("Initial Consultation") || 
                _selectedTemplate.Value.Name.Contains("Pre-Treatment Consultation"))
            {
                if (string.IsNullOrWhiteSpace(_templateDocument.PatientName))
                    missingFields.Add("Patient Name");
                if (string.IsNullOrWhiteSpace(_templateDocument.ChiefComplaint))
                    missingFields.Add("Chief Complaint");
            }
            else if (_selectedTemplate.Value.Name.Contains("Follow-up") || 
                     _selectedTemplate.Value.Name.Contains("Post-Treatment Review"))
            {
                if (string.IsNullOrWhiteSpace(_templateDocument.PatientName))
                    missingFields.Add("Patient Name");
            }
            else if (_selectedTemplate.Value.Name.Contains("Botox"))
            {
                if (string.IsNullOrWhiteSpace(_templateDocument.PatientName))
                    missingFields.Add("Patient Name");
                if (string.IsNullOrWhiteSpace(_templateDocument.TreatmentArea))
                    missingFields.Add("Treatment Area");
            }
            else if (_selectedTemplate.Value.Name.Contains("Dermal Filler") || 
                     _selectedTemplate.Value.Name.Contains("Laser") || 
                     _selectedTemplate.Value.Name.Contains("Chemical Peel") || 
                     _selectedTemplate.Value.Name.Contains("Microneedling") || 
                     _selectedTemplate.Value.Name.Contains("Skin Treatment"))
            {
                if (string.IsNullOrWhiteSpace(_templateDocument.PatientName))
                    missingFields.Add("Patient Name");
                if (string.IsNullOrWhiteSpace(_templateDocument.TreatmentPerformed))
                    missingFields.Add("Treatment Performed");
            }
            else if (_selectedTemplate.Value.Name.Contains("Consent"))
            {
                if (string.IsNullOrWhiteSpace(_templateDocument.PatientName))
                    missingFields.Add("Patient Name");
                if (string.IsNullOrWhiteSpace(_templateDocument.Procedure))
                    missingFields.Add("Procedure");
            }
            else if (_selectedTemplate.Value.Name.Contains("Prescription"))
            {
                if (string.IsNullOrWhiteSpace(_templateDocument.PatientName))
                    missingFields.Add("Patient Name");
                if (string.IsNullOrWhiteSpace(_templateDocument.Medication))
                    missingFields.Add("Medication");
                if (string.IsNullOrWhiteSpace(_templateDocument.Dosage))
                    missingFields.Add("Dosage");
                if (string.IsNullOrWhiteSpace(_templateDocument.Frequency))
                    missingFields.Add("Frequency");
                if (string.IsNullOrWhiteSpace(_templateDocument.Duration))
                    missingFields.Add("Duration");
            }
            else if (_selectedTemplate.Value.Name.Contains("Medical Certificate"))
            {
                if (string.IsNullOrWhiteSpace(_templateDocument.PatientName))
                    missingFields.Add("Patient Name");
                if (string.IsNullOrWhiteSpace(_templateDocument.Diagnosis))
                    missingFields.Add("Diagnosis");
                if (string.IsNullOrWhiteSpace(_templateDocument.Reason))
                    missingFields.Add("Reason");
                if (_templateDocument.CertificateType == "Day Off")
                {
                    if (!_templateDocument.StartDate.HasValue)
                        missingFields.Add("Start Date");
                    if (!_templateDocument.EndDate.HasValue)
                        missingFields.Add("End Date");
                }
            }
            else if (_selectedTemplate.Value.Name.Contains("Skin Assessment"))
            {
                if (string.IsNullOrWhiteSpace(_templateDocument.PatientName))
                    missingFields.Add("Patient Name");
            }
            
            if (missingFields.Any())
            {
                _showValidationError = true;
                _validationErrorMessage = $"Please fill in the required fields: {string.Join(", ", missingFields)}";
                StateHasChanged();
                return;
            }
        }

        // All validations passed, proceed with saving
        string content;
        
        // Check if it's a custom template
        if (IsCustomTemplate(_selectedTemplate.Value.Id))
        {
            // Build content from custom template fields
            content = BuildContentFromCustomTemplate(_selectedTemplate.Value.Id);
        }
        else
        {
            // Combine appointment date and time if both are provided
            if (_templateDocument.NextAppointmentDate.HasValue)
            {
                _templateDocument.NextAppointment = _templateDocument.NextAppointmentDate.Value.Date
                    .AddHours(_templateDocument.NextAppointmentTime.Hour)
                    .AddMinutes(_templateDocument.NextAppointmentTime.Minute);
            }

            // Build content from template form fields (system templates)
            content = BuildContentFromTemplate(_templateDocument, _selectedTemplate.Value.Name);
        }

        // Map template to document type
        var documentType = MapTemplateToDocumentType(_selectedTemplate.Value.Name);

        if (_isEditingDocument && _documentToEdit != null)
        {
            // Update existing document
            var updatedDoc = _documentToEdit with 
            { 
                Title = _templateDocument.Title,
                Type = documentType,
                Content = content,
                LastUpdated = DateTime.Now,
                TemplateId = _selectedTemplate?.Id ?? _documentToEdit.TemplateId // Preserve template ID
            };
            ViewModel.UpdateDocument(_documentToEdit.Id, updatedDoc);
        }
        else
        {
            // Add new document
            var nextId = ViewModel.Documents.Any() ? ViewModel.Documents.Max(d => d.Id) + 1 : 1;
            var newDoc = new DocumentViewModel.Document(
                nextId,
                _templateDocument.Title,
                documentType,
                DateTime.Now,
                DateTime.Now,
                "Current User",
                null,
                content,
                _selectedTemplate?.Id // Store template ID for editing
            );

            ViewModel.AddDocument(newDoc);
        }
        
        // Reset editing state
        _isEditingDocument = false;
        _documentToEdit = null;
        _showAppointmentTimePicker = false; // Close time picker
        _showValidationError = false; // Clear validation error
        CloseTemplateDocumentModal();
        StateHasChanged();
    }
    
    private string BuildContentFromCustomTemplate(int templateId)
    {
        var template = _templateViewModel.GetTemplate(templateId);
        if (template == null) return "";

        var content = new System.Text.StringBuilder();
        
        // Enhanced print-friendly CSS with professional styling
        content.AppendLine("<style>");
        content.AppendLine("@page { size: A4; margin: 0.75in; }");
        content.AppendLine("@media print {");
        content.AppendLine("  body { margin: 0; padding: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }");
        content.AppendLine("  .document-container { box-shadow: none !important; padding: 0 !important; }");
        content.AppendLine("  .page-break { page-break-after: always; }");
        content.AppendLine("  .no-print { display: none !important; }");
        content.AppendLine("}");
        content.AppendLine("@media screen {");
        content.AppendLine("  body { background: #f3f4f6; padding: 40px 20px; }");
        content.AppendLine("  .document-container { border-radius: 4px; }");
        content.AppendLine("}");
        content.AppendLine("* { box-sizing: border-box; }");
        content.AppendLine("</style>");
        
        // Professional document container with modern styling
        content.AppendLine("<div class='document-container' style='font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif; line-height: 1.5; color: #111827; max-width: 8.5in; margin: 0 auto; padding: 40px 36px; background: #ffffff; font-size: 12px;'>");
        
        // Plain header without strong colors
        content.AppendLine("<div style='text-align: center; padding-bottom: 18px; margin-bottom: 28px; border-bottom: 1px solid #e5e7eb;'>");
        content.AppendLine($"<div style='margin: 0 0 4px 0; color: #6b7280; font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em;'>{System.Net.WebUtility.HtmlEncode(_templateDocument.ClinicName)}</div>");
        content.AppendLine($"<h1 style='margin: 0; color: #111827; font-size: 18px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase;'>{System.Net.WebUtility.HtmlEncode(template.Name)}</h1>");
        content.AppendLine("</div>");
        
        // Organize fields into logical sections - PRESERVE ORDER
        var fields = template.Fields.OrderBy(f => f.Order).ToList();
        
        // Extract patient/contact information fields - KEEP ORIGINAL ORDER
        var identificationFields = fields.Where(f => 
            f.Label.ToLower().Contains("name") || 
            f.Label.ToLower().Contains("patient") ||
            f.Label.ToLower().Contains("id") ||
            f.Label.ToLower().Contains("contact") ||
            f.Label.ToLower().Contains("phone") ||
            f.Label.ToLower().Contains("email") ||
            f.Label.ToLower().Contains("address") ||
            f.Label.ToLower().Contains("date") ||
            f.Label.ToLower().Contains("time") ||
            f.Label.ToLower().Contains("physician") ||
            f.Label.ToLower().Contains("doctor") ||
            f.Label.ToLower().Contains("provider") ||
            f.Type == DocumentTemplateViewModel.FieldType.Date ||
            f.Type == DocumentTemplateViewModel.FieldType.DateTime ||
            f.Type == DocumentTemplateViewModel.FieldType.Time
        ).OrderBy(f => f.Order).ToList(); // Sort by Order to maintain template field order
        
        // Render identification section if we have any identification fields - modern card-style layout
        if (identificationFields.Any())
        {
            content.AppendLine("<div style='margin-bottom: 28px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 16px 18px;'>");
            content.AppendLine("<h3 style='color: #111827; font-size: 11px; font-weight: 600; margin: 0 0 12px 0; padding-bottom: 8px; border-bottom: 1px solid #e5e7eb; text-transform: uppercase; letter-spacing: 0.12em;'>Patient Information</h3>");
            content.AppendLine("<table style='width: 100%; border-collapse: collapse;'>");
            
            foreach (var field in identificationFields)
            {
                var fieldValue = _customTemplateFieldValues.ContainsKey(field.Id) 
                    ? _customTemplateFieldValues[field.Id] 
                    : "";
                
                if (string.IsNullOrWhiteSpace(fieldValue) && !field.IsRequired)
                    continue;
                
                var displayValue = FormatFieldValueForDisplay(field, fieldValue);
                content.AppendLine("<tr>");
                content.AppendLine($"<td style='padding: 6px 12px 6px 0; font-weight: 500; color: #4b5563; width: 38%; vertical-align: top; font-size: 11px;'>{System.Net.WebUtility.HtmlEncode(field.Label)}</td>");
                content.AppendLine($"<td style='padding: 6px 0; color: #111827; font-size: 11px; font-weight: 500;'>{displayValue}</td>");
                content.AppendLine("</tr>");
            }
            
            content.AppendLine("</table>");
            content.AppendLine("</div>");
            
            // Remove identification fields from remaining fields
            fields = fields.Except(identificationFields).ToList();
        }
        
        // Group remaining fields by type for better organization
        var textAreaFields = fields.Where(f => f.Type == DocumentTemplateViewModel.FieldType.TextArea).ToList();
        var otherFields = fields.Except(textAreaFields).ToList();
        
        // Render other non-textarea fields as a single plain "Details" section (single column)
        if (otherFields.Any())
        {
            content.AppendLine("<div style='margin-bottom: 24px; border-top: 1px solid #e5e7eb; padding-top: 12px;'>");
            content.AppendLine("<h3 style='color: #111827; font-size: 11px; font-weight: 600; margin: 0 0 8px 0; text-transform: uppercase; letter-spacing: 0.1em;'>Details</h3>");
            content.AppendLine("<table style='width: 100%; border-collapse: collapse;'>");

            foreach (var field in otherFields)
            {
                var fieldValue = _customTemplateFieldValues.ContainsKey(field.Id) 
                    ? _customTemplateFieldValues[field.Id] 
                    : "";
                
                if (string.IsNullOrWhiteSpace(fieldValue) && !field.IsRequired)
                    continue;
                
                var displayValue = FormatFieldValueForDisplay(field, fieldValue);

                content.AppendLine("<tr>");
                content.AppendLine($"<td style='padding: 6px 12px 6px 0; font-weight: 500; color: #4b5563; width: 38%; vertical-align: top; font-size: 11px;'>{System.Net.WebUtility.HtmlEncode(field.Label)}</td>");
                content.AppendLine($"<td style='padding: 6px 0; color: #111827; font-size: 11px; font-weight: 500;'>{displayValue}</td>");
                content.AppendLine("</tr>");
            }

            content.AppendLine("</table>");
            content.AppendLine("</div>");
        }
        
        // Render textarea fields (longer content) with plain professional styling
        if (textAreaFields.Any())
        {
            foreach (var field in textAreaFields)
            {
                var fieldValue = _customTemplateFieldValues.ContainsKey(field.Id) 
                    ? _customTemplateFieldValues[field.Id] 
                    : "";
                
                if (string.IsNullOrWhiteSpace(fieldValue) && !field.IsRequired)
                    continue;
                
                content.AppendLine("<div style='margin-bottom: 20px;'>");
                content.AppendLine($"<div style='margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px solid #e5e7eb;'>");
                content.AppendLine($"<label style='color: #111827; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; display: block;'>{System.Net.WebUtility.HtmlEncode(field.Label)}");
                if (field.IsRequired)
                {
                    content.AppendLine($"<span style='color: #ef4444; margin-left: 4px;'>*</span>");
                }
                content.AppendLine("</label>");
                content.AppendLine("</div>");
                
                // For TextArea, preserve line breaks and format with professional styling
                var textAreaValue = fieldValue ?? "";
                if (string.IsNullOrWhiteSpace(textAreaValue))
                {
                    content.AppendLine($"<div style='background: #f9fafb; padding: 14px 16px; border-radius: 4px; border: 1px solid #e5e7eb; min-height: 64px;'>");
                    content.AppendLine($"<p style='margin: 0; color: #9ca3af; font-size: 11px; line-height: 1.5; font-style: italic;'>No information provided</p>");
                }
                else
                {
                    content.AppendLine($"<div style='background: #ffffff; padding: 14px 16px; border-radius: 4px; border: 1px solid #e5e7eb;'>");
                    content.AppendLine($"<div style='margin: 0; color: #111827; font-size: 12px; line-height: 1.6; white-space: pre-wrap; word-wrap: break-word;'>{System.Net.WebUtility.HtmlEncode(textAreaValue)}</div>");
                }
                content.AppendLine("</div>");
                
                if (!string.IsNullOrWhiteSpace(field.HelpText))
                {
                    content.AppendLine($"<p style='margin: 10px 0 0 0; color: #94a3b8; font-size: 11px; font-style: italic; line-height: 1.5;'>{System.Net.WebUtility.HtmlEncode(field.HelpText)}</p>");
                }
                
                content.AppendLine("</div>");
            }
        }
        
        // Professional footer with modern styling
        content.AppendLine("<div style='margin-top: 60px; padding-top: 24px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;'>");
        content.AppendLine("<div style='flex: 1;'>");
        content.AppendLine($"<p style='margin: 0; color: #64748b; font-size: 11px; font-weight: 500;'>{System.Net.WebUtility.HtmlEncode(_templateDocument.ClinicName)}</p>");
        content.AppendLine("</div>");
        content.AppendLine("<div style='flex: 1; text-align: right;'>");
        content.AppendLine($"<p style='margin: 0; color: #94a3b8; font-size: 11px; font-style: italic;'>Generated on {DateTime.Now:MMMM dd, yyyy} at {DateTime.Now:hh:mm tt}</p>");
        content.AppendLine("</div>");
        content.AppendLine("</div>");
        
        content.AppendLine("</div>");
        
        return content.ToString();
    }
    
    private string FormatFieldValueForDisplay(DocumentTemplateViewModel.TemplateField field, string fieldValue)
    {
        if (string.IsNullOrWhiteSpace(fieldValue))
            return "<span style='color: #9ca3af; font-style: italic;'>—</span>";
        
        // Auto-detect phone numbers based on label (safety feature)
        // If field label contains "phone" but type is Number, treat it as Phone
        if (field.Type == DocumentTemplateViewModel.FieldType.Number && 
            field.Label.ToLower().Contains("phone"))
        {
            // Don't format phone numbers with thousand separators
            return System.Net.WebUtility.HtmlEncode(fieldValue);
        }
        
        // Auto-detect email based on label
        if (field.Type == DocumentTemplateViewModel.FieldType.Text && 
            field.Label.ToLower().Contains("email"))
        {
            return System.Net.WebUtility.HtmlEncode(fieldValue);
        }
        
        switch (field.Type)
        {
            case DocumentTemplateViewModel.FieldType.Date:
                if (DateTime.TryParse(fieldValue, out var dateValue))
                {
                    return System.Net.WebUtility.HtmlEncode(dateValue.ToString("MMM dd, yyyy"));
                }
                return System.Net.WebUtility.HtmlEncode(fieldValue);
                
            case DocumentTemplateViewModel.FieldType.Time:
                if (TimeOnly.TryParse(fieldValue, out var timeOnlyValue))
                {
                    return System.Net.WebUtility.HtmlEncode(timeOnlyValue.ToString("hh:mm tt"));
                }
                else if (DateTime.TryParse(fieldValue, out var timeDateTimeValue))
                {
                    return System.Net.WebUtility.HtmlEncode(timeDateTimeValue.ToString("hh:mm tt"));
                }
                return System.Net.WebUtility.HtmlEncode(fieldValue);
                
            case DocumentTemplateViewModel.FieldType.DateTime:
                if (DateTime.TryParse(fieldValue, out var dateTimeValue))
                {
                    return System.Net.WebUtility.HtmlEncode(dateTimeValue.ToString("MMMM dd, yyyy 'at' hh:mm tt"));
                }
                else
                {
                    var (datePart, timePart) = ParseDateTimeValue(fieldValue);
                    if (!string.IsNullOrWhiteSpace(datePart) && !string.IsNullOrWhiteSpace(timePart))
                    {
                        if (DateTime.TryParse($"{datePart} {timePart}", out var combinedDateTime))
                        {
                            return System.Net.WebUtility.HtmlEncode(combinedDateTime.ToString("MMMM dd, yyyy 'at' hh:mm tt"));
                        }
                        else
                        {
                            var formattedDate = "";
                            var formattedTime = "";
                            
                            if (DateTime.TryParse(datePart, out var parsedDate))
                            {
                                formattedDate = parsedDate.ToString("MMMM dd, yyyy");
                            }
                            else
                            {
                                formattedDate = datePart;
                            }
                            
                            if (TimeOnly.TryParse(timePart, out var parsedTime))
                            {
                                formattedTime = parsedTime.ToString("hh:mm tt");
                            }
                            else
                            {
                                formattedTime = timePart;
                            }
                            
                            return System.Net.WebUtility.HtmlEncode($"{formattedDate} at {formattedTime}");
                        }
                    }
                }
                return System.Net.WebUtility.HtmlEncode(fieldValue);
                
            case DocumentTemplateViewModel.FieldType.TextArea:
                // For TextArea, return as-is (will be encoded in the rendering)
                return fieldValue;
                
            case DocumentTemplateViewModel.FieldType.Checkbox:
                if (field.Options != null && field.Options.Any())
                {
                    // Multiple checkboxes (checkbox group) - display as comma-separated list
                    var selectedOptions = fieldValue.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
                    if (selectedOptions.Any())
                    {
                        // Display as simple comma-separated text for consistency
                        return System.Net.WebUtility.HtmlEncode(string.Join(", ", selectedOptions));
                    }
                    return "<span style='color: #9ca3af; font-style: italic; font-size: 14px;'>No options selected</span>";
                }
                else
                {
                    // Single checkbox (Yes/No) - display as simple text
                    var isChecked = fieldValue == "true";
                    return System.Net.WebUtility.HtmlEncode(isChecked ? "Yes" : "No");
                }
            
            case DocumentTemplateViewModel.FieldType.Dropdown:
            case DocumentTemplateViewModel.FieldType.Radio:
                // Display selected option as plain text for consistency
                return System.Net.WebUtility.HtmlEncode(fieldValue);
            
            case DocumentTemplateViewModel.FieldType.Email:
                // Format email as a link (styled as text)
                return $"<span style='color: #1173d4; text-decoration: none;'>{System.Net.WebUtility.HtmlEncode(fieldValue)}</span>";
            
            case DocumentTemplateViewModel.FieldType.Phone:
                // Format phone number - keep as-is, no thousand separators
                return System.Net.WebUtility.HtmlEncode(fieldValue);
            
            case DocumentTemplateViewModel.FieldType.Number:
                // Format number with thousand separators for readability
                // Remove any existing formatting first
                var cleanNumber = fieldValue.Replace(",", "").Replace(" ", "").Trim();
                if (decimal.TryParse(cleanNumber, out var numValue))
                {
                    // Use a more readable format - add thousand separators but display as plain text
                    var formatted = numValue.ToString("N0");
                    return System.Net.WebUtility.HtmlEncode(formatted);
                }
                return System.Net.WebUtility.HtmlEncode(fieldValue);
                
            default:
                return System.Net.WebUtility.HtmlEncode(fieldValue);
        }
    }

