        }
    }
    
    private void ParseDocumentContentToTemplateModel(DocumentViewModel.Document doc)
    {
        // Reset template document model
        _templateDocument = new TemplateDocumentModel();
        _customTemplateFieldValues.Clear();
        
        if (string.IsNullOrEmpty(doc.Content))
        {
            _templateDocument.Title = doc.Title;
            _templateDocument.Date = doc.CreatedDate;
            return;
        }
        
        _templateDocument.Title = doc.Title;
        _templateDocument.Date = doc.CreatedDate;
        
        if (doc.TemplateId.HasValue && IsCustomTemplate(doc.TemplateId.Value))
        {
            // Parse custom template fields from HTML
            var customTemplate = _templateViewModel.GetTemplate(doc.TemplateId.Value);
            if (customTemplate != null)
            {
                foreach (var field in customTemplate.Fields.OrderBy(f => f.Order))
                {
                    // Extract field value from HTML - support multiple patterns
                    var escapedLabel = System.Text.RegularExpressions.Regex.Escape(field.Label);
                    
                    // Try multiple patterns to match different HTML structures
                    string value = "";
                    System.Text.RegularExpressions.Match match;
                    
                    // Pattern 1: Table row format (Patient Information section)
                    // <td>Label:</td><td>value</td>
                    var tablePattern = $@"<td[^>]*>{escapedLabel}\s*:?\s*</td>\s*<td[^>]*>(.*?)</td>";
                    match = System.Text.RegularExpressions.Regex.Match(
                        doc.Content,
                        tablePattern,
                        System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline
                    );
                    
                    if (match.Success)
                    {
                        value = System.Net.WebUtility.HtmlDecode(match.Groups[1].Value.Trim());
                    }
                    else
                    {
                        // Pattern 2: Strong label followed by paragraph
                        // <strong>Label:</strong></div><p>value</p>
                        var strongPattern = $@"<strong[^>]*>{escapedLabel}\s*:?\s*(?:<span[^>]*>\*</span>)?\s*</strong>.*?<p[^>]*>(.*?)</p>";
                        match = System.Text.RegularExpressions.Regex.Match(
                            doc.Content,
                            strongPattern,
                            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline
                        );
                        
                        if (match.Success)
                        {
                            value = System.Net.WebUtility.HtmlDecode(match.Groups[1].Value.Trim());
                        }
                        else
                        {
                            // Pattern 3: H4 heading followed by div/p (TextArea fields)
                            // <h4>Label</h4>...<p>value</p>
                            var h4Pattern = $@"<h4[^>]*>{escapedLabel}\s*:?\s*(?:<span[^>]*>\*</span>)?\s*</h4>.*?<p[^>]*>(.*?)</p>";
                            match = System.Text.RegularExpressions.Regex.Match(
                                doc.Content,
                                h4Pattern,
                                System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline
                            );
                            
                            if (match.Success)
                            {
                                value = System.Net.WebUtility.HtmlDecode(match.Groups[1].Value.Trim());
                            }
                        }
                    }
                    
                    if (!string.IsNullOrEmpty(value))
                    {
                        
                        // Handle special cases for checkbox
                        if (field.Type == DocumentTemplateViewModel.FieldType.Checkbox)
                        {
                            if (field.Options == null || !field.Options.Any())
                            {
                                // Single checkbox shows "Yes" or "No"
                                value = value.Contains("Yes") ? "true" : "false";
                            }
                            // For checkbox groups, value is already comma-separated, no conversion needed
                        }
                        else if (field.Type == DocumentTemplateViewModel.FieldType.Date)
                        {
                            // Extract date from formatted string like "MMMM dd, yyyy" or "MMM dd, yyyy"
                            if (DateTime.TryParse(value, out var dateVal))
                            {
                                value = dateVal.ToString("yyyy-MM-dd");
                            }
                        }
                        else if (field.Type == DocumentTemplateViewModel.FieldType.Time)
                        {
                            // Extract time from formatted string like "hh:mm tt"
                            if (TimeOnly.TryParse(value, out var timeVal))
                            {
                                value = timeVal.ToString("HH:mm");
                            }
                        }
                        else if (field.Type == DocumentTemplateViewModel.FieldType.DateTime)
                        {
                            // Extract datetime from formatted string
                            if (DateTime.TryParse(value, out var dtVal))
                            {
                                value = dtVal.ToString("yyyy-MM-ddTHH:mm");
                            }
                        }
                        else if (field.Type == DocumentTemplateViewModel.FieldType.Number)
                        {
                            // Remove thousand separators (commas) from formatted numbers
                            value = value.Replace(",", "");
                            // Extract number value
                            var numberMatch = System.Text.RegularExpressions.Regex.Match(value, @"[\d.]+");
                            if (numberMatch.Success)
                            {
                                value = numberMatch.Value;
                            }
                        }
                    }
                    
                    // If value is still empty and field not found, use default value
                    if (string.IsNullOrEmpty(value))
                    {
                        value = field.DefaultValue ?? "";
                    }
                    
                    // Always set the value in dictionary (even if empty) to prevent KeyNotFoundException
                    _customTemplateFieldValues[field.Id] = value;
                }
            }
        }
        else if (!string.IsNullOrEmpty(doc.Content))
        {
            // Parse system template fields from HTML
            // Extract Patient Name
            var patientNameMatch = System.Text.RegularExpressions.Regex.Match(
                doc.Content,
                @"Patient Name[^:]*:</td><td[^>]*>([^<]+)</td>",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase
            );
            if (patientNameMatch.Success)
            {
                _templateDocument.PatientName = System.Net.WebUtility.HtmlDecode(patientNameMatch.Groups[1].Value.Trim());
            }
            
            // Extract Patient ID
            var patientIdMatch = System.Text.RegularExpressions.Regex.Match(
                doc.Content,
                @"Patient ID[^:]*:</td><td[^>]*>([^<]+)</td>",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase
            );
            if (patientIdMatch.Success)
            {
                _templateDocument.PatientId = System.Net.WebUtility.HtmlDecode(patientIdMatch.Groups[1].Value.Trim());
            }
            
            // Extract Date
