    private static string EncodeReceiptText(string? value) =>
        System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(value) ? "-" : value);

    private void StartAnotherSale()
    {
        currentOrder = new();
        savedSale = null;
        RefreshPendingOrders();
        stage = SaleStage.PendingOrders;
    }

    private void GoToSalesDashboard() => NavigationManager.NavigateTo("/sales");

    private static string CustomerName(Customer x) => $"{x.FirstName} {x.LastName}".Trim();
    private static string CustomerMeta(Customer x) => string.Join(" | ", new[] { x.ContactNumber1, x.Email }.Where(v => !string.IsNullOrWhiteSpace(v)));
    private static string CustomerMembership(Customer x) => string.IsNullOrWhiteSpace(x.MembershipType) ? "Standard" : x.MembershipType;

    private static string CustomerInitials(Customer x) => GetCustomerInitials(CustomerName(x));

    private static string GetCustomerInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : string.Concat(parts.Take(2).Select(v => char.ToUpperInvariant(v[0])));
    }

    private static string TypeIcon(string type) => type.ToLowerInvariant() switch
    {
        "service" => "bi-stars",
        "package" => "bi-box2-heart",
        _ => "bi-bag"
    };

    private const string EmptyItemImage = "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=";
    private static string ItemImage(string type, string? value) => string.IsNullOrWhiteSpace(value) ? EmptyItemImage : value.Trim();

    private static string PaymentIcon(string? value)
    {
        var v = value?.ToLowerInvariant() ?? "";
        if (v.Contains("cash")) return "bi-cash-stack";
        if (v.Contains("bank") || v.Contains("transfer")) return "bi-bank";
        if (v.Contains("card")) return "bi-credit-card-2-front";
        if (v.Contains("wallet")) return "bi-wallet2";
        if (v.Contains("voucher")) return "bi-ticket-perforated";
        if (v.Contains("point")) return "bi-stars";
        return "bi-credit-card";
    }

