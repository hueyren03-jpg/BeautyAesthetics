@code {
    private enum SaleStage
    {
        PendingOrders,
        CustomerSelection,
        Cart,
        Payment,
        Complete
    }

    private SaleStage stage = SaleStage.PendingOrders;
    private PendingOrder currentOrder = new();
    private List<PendingOrder> pendingOrders = new();
    private PendingOrder? orderToDelete;
    private string pendingSearchText = string.Empty;

    private Transaction? savedSale;
    private List<Customer> customers = new();
    private List<Customer> defaultCustomers = new();
    private List<CashSalesPaymentTypeDTO> paymentTypes = new();
    private List<CatalogItem> catalog = new();

    private bool isAddingNewCustomer;

    private string selectedType = string.Empty;
    private string searchText = string.Empty;
    private string customerSearchText = string.Empty;
    private bool isChangingCustomerForExistingOrder;

    private bool isCustomerSearchLoading;
    private bool isLoading = true;
    private bool isSaving;
    private string message = string.Empty;
    private int customerSearchRequestVersion;
    private CancellationTokenSource? customerSearchCts;

    private CatalogItem? editingCatalogItem;
    private TransactionItem? editingCartItem;
    private int draftQuantity = 1;
    private decimal draftDiscount;

    private CashSalesPaymentTypeDTO? calculatorMethod;
    private bool mobileCartOpen;
    private string calculatorDigits = string.Empty;

    private decimal PaidAmount => currentOrder.Payments.Sum(payment => payment.Amount);
    private decimal Remaining => Math.Max(0, currentOrder.Total - PaidAmount);
    private decimal Change => Math.Max(0, PaidAmount - currentOrder.Total);
    private decimal PaidExcludingCalculatorMethod => calculatorMethod is null
        ? PaidAmount
        : currentOrder.Payments.Where(payment => payment.PaymentTypeId != calculatorMethod.POSPaymentTypeID).Sum(payment => payment.Amount);
    private decimal CalculatorRemaining => Math.Max(0, currentOrder.Total - PaidExcludingCalculatorMethod);
    private decimal DraftTotal => editingCatalogItem is null ? 0 : Math.Max(0, editingCatalogItem.Price * Math.Max(1, draftQuantity) - draftDiscount);
    private decimal CalculatorAmount => decimal.TryParse(calculatorDigits, out var cents) ? cents / 100m : 0;

    private string ReceiptNumber => string.IsNullOrWhiteSpace(savedSale?.InvoiceNumber) ? currentOrder.OrderNumber : savedSale.InvoiceNumber;
    private DateTime ReceiptDate => savedSale?.Date is { Year: > 1 } value ? value : DateTime.Now;
    private string ReceiptCustomer => string.IsNullOrWhiteSpace(savedSale?.CustomerName) ? currentOrder.CustomerName : savedSale.CustomerName;
    private string ReceiptBranch => string.IsNullOrWhiteSpace(savedSale?.Branch) ? currentOrder.BranchName : savedSale.Branch;

    private static readonly string[] KeypadKeys = ["1", "2", "3", "4", "5", "6", "7", "8", "9"];
    private IEnumerable<string> ItemTypes => catalog.Select(x => x.Type).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);

    private IEnumerable<CatalogItem> FilteredItems => catalog
        .Where(x => string.IsNullOrWhiteSpace(selectedType) || x.Type.Equals(selectedType, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(searchText) || x.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) || x.Sku.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<Customer> FilteredCustomers => customers.Where(x =>
        string.IsNullOrWhiteSpace(customerSearchText) ||
        CustomerName(x).Contains(customerSearchText, StringComparison.OrdinalIgnoreCase) ||
        x.ContactNumber1.Contains(customerSearchText, StringComparison.OrdinalIgnoreCase) ||
        x.Email.Contains(customerSearchText, StringComparison.OrdinalIgnoreCase) ||
        x.MembershipType.Contains(customerSearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<PendingOrder> FilteredPendingOrders => pendingOrders.Where(o =>
        string.IsNullOrWhiteSpace(pendingSearchText) ||
        o.OrderNumber.Contains(pendingSearchText, StringComparison.OrdinalIgnoreCase) ||
        o.CustomerName.Contains(pendingSearchText, StringComparison.OrdinalIgnoreCase) ||
        o.CustomerContact.Contains(pendingSearchText, StringComparison.OrdinalIgnoreCase) ||
        o.MembershipType.Contains(pendingSearchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        PendingOrderService.OnOrdersChanged += HandlePendingOrdersChanged;
        await LoadWorkspaceAsync();
        RefreshPendingOrders();
        isLoading = false;
    }

    private void HandlePendingOrdersChanged()
    {
        InvokeAsync(() =>
        {
            RefreshPendingOrders();
            StateHasChanged();
        });
    }

    private void RefreshPendingOrders()
    {
        pendingOrders = PendingOrderService.GetAll().ToList();
    }

    private async Task LoadWorkspaceAsync()
    {
        await BranchSession.InitializeAsync();

        var branch = BranchSession.CurrentBranch;
        var branchId = branch?.Id ?? "HQ";

        var paymentTask = CashSalesService.LoadPaymentTypesAsync();
        var customerTask = CustomerService.SearchCustomersAsync(string.Empty);
        var productTask = ProductInventoryService.LoadProductsAsync(branchId);
        var serviceTask = ServiceItemService.LoadServiceItemsAsync(branchId);

        await Task.WhenAll(paymentTask, customerTask, productTask, serviceTask);

        var paymentResult = await paymentTask;
        var customerResult = await customerTask;
        var productResult = await productTask;
        var serviceResult = await serviceTask;

        if (paymentResult.Success && paymentResult.Value is not null)
            paymentTypes = paymentResult.Value.ToList();

        if (customerResult.Success && customerResult.Value is not null)
        {
            customers = customerResult.Value.Where(x => !string.IsNullOrWhiteSpace(x.SystemID)).OrderBy(CustomerName).ToList();
            defaultCustomers = customers.ToList();
        }

        var services = serviceResult.Success && serviceResult.Value is not null
            ? serviceResult.Value.Where(x => !string.Equals(x.Status, "Inactive", StringComparison.OrdinalIgnoreCase)).ToList()
            : new List<ServiceViewModel.ServiceItem>();

        catalog.Clear();

        if (productResult.Success && productResult.Value is not null)
        {
            catalog.AddRange(productResult.Value
                .Where(x => !string.IsNullOrWhiteSpace(x.MasterAccountId))
                .Select(x => new CatalogItem(x.MasterAccountId, x.Type, x.Sku, "Product", x.Price, ProductImageService.ResolveImageUrl(x.MasterAccountId, x.ImagePath, x.ImageFileName))));
        }

        catalog.AddRange(services
            .Where(x => !string.IsNullOrWhiteSpace(x.MasterAccountId))
            .Select(x => new CatalogItem(x.MasterAccountId!, x.ServiceName, x.Sku, "Service", x.Price, ProductImageService.ResolveImageUrl(x.MasterAccountId, x.ImagePath, x.ImageFileName))));

        if (services.Count > 0)
        {
            var packageResult = await PackageService.LoadPackagesAsync(services, branchId);
            if (packageResult.Success && packageResult.Value is not null)
            {
                catalog.AddRange(packageResult.Value
                    .Where(x => !string.IsNullOrWhiteSpace(x.MasterAccountId) && !string.Equals(x.Status, "Inactive", StringComparison.OrdinalIgnoreCase))
                    .Select(x => new CatalogItem(x.MasterAccountId, x.Name, x.Sku, "Package", x.Price, ProductImageService.ResolveImageUrl(x.MasterAccountId, x.ImagePath, x.ImageFileName))));
            }
        }

        catalog = catalog
            .GroupBy(x => x.Id, StringComparer.OrdinalIgnoreCase)
            .Select(x => x.First())
            .OrderBy(x => x.Type)
            .ThenBy(x => x.Name)
            .ToList();
    }

    // ========================================= STAGE TRANSITIONS & ACTIONS =========================================

    private void StartNewOrderCustomerSelection()
    {
        isChangingCustomerForExistingOrder = false;
        isAddingNewCustomer = false;
        customerSearchText = string.Empty;
        customers = defaultCustomers.ToList();
        stage = SaleStage.CustomerSelection;
    }

    private void OpenChangeCustomerSelection()
    {
        isChangingCustomerForExistingOrder = true;
        isAddingNewCustomer = false;
        customerSearchText = string.Empty;
        customers = defaultCustomers.ToList();
        stage = SaleStage.CustomerSelection;
    }

    private void CancelCustomerSelection()
    {
        isAddingNewCustomer = false;
        if (isChangingCustomerForExistingOrder)
        {
            stage = SaleStage.Cart;
        }
        else
        {
            stage = SaleStage.PendingOrders;
        }
    }

    private void SelectCustomer(Customer customer)
    {
        var branch = BranchSession.CurrentBranch;
        var branchId = branch?.Id ?? "HQ";
        var branchName = branch?.DisplayName ?? "HQ Outlet";

        if (isChangingCustomerForExistingOrder)
        {
            currentOrder.AccountId = customer.SystemID ?? string.Empty;
            currentOrder.CustomerName = CustomerName(customer);
            currentOrder.CustomerContact = customer.ContactNumber1 ?? string.Empty;
            currentOrder.CustomerEmail = customer.Email ?? string.Empty;
            currentOrder.MembershipType = CustomerMembership(customer);
            PendingOrderService.SaveOrUpdate(currentOrder);
        }
        else
        {
            currentOrder = PendingOrderService.Create(customer, branchId, branchName);
        }

        stage = SaleStage.Cart;
    }

    private void SelectWalkInCustomer()
    {
        var branch = BranchSession.CurrentBranch;
        var branchId = branch?.Id ?? "HQ";
        var branchName = branch?.DisplayName ?? "HQ Outlet";

        if (isChangingCustomerForExistingOrder)
        {
            currentOrder.AccountId = string.Empty;
            currentOrder.CustomerName = "Walk-in Customer";
            currentOrder.CustomerContact = string.Empty;
            currentOrder.CustomerEmail = string.Empty;
            currentOrder.MembershipType = "Standard";
            PendingOrderService.SaveOrUpdate(currentOrder);
        }
        else
        {
            currentOrder = PendingOrderService.Create(null, branchId, branchName);
        }

        stage = SaleStage.Cart;
    }

    private void HandleCustomerCreatedFromComponent(Customer customer)
    {
        if (customer is not null)
        {
            customers.Insert(0, customer);
            defaultCustomers.Insert(0, customer);
            isAddingNewCustomer = false;
            message = $"Customer {CustomerName(customer)} created successfully!";
            SelectCustomer(customer);
        }
    }

    private void ResumeOrder(PendingOrder order)
    {
        currentOrder = order.Clone();
        stage = SaleStage.Cart;
    }

    private void HoldCurrentOrder()
    {
        PendingOrderService.SaveOrUpdate(currentOrder);
        RefreshPendingOrders();
        stage = SaleStage.PendingOrders;
    }

    private void BackToPendingOrdersFromCart()
    {
        if (currentOrder.Items.Any())
        {
            PendingOrderService.SaveOrUpdate(currentOrder);
            RefreshPendingOrders();
        }
        stage = SaleStage.PendingOrders;
    }

    private void RequestDeleteOrder(PendingOrder order)
    {
        orderToDelete = order;
    }

    private void CancelDeleteOrder()
    {
        orderToDelete = null;
    }

    private void ConfirmDeleteOrder()
    {
        if (orderToDelete != null)
        {
            PendingOrderService.Delete(orderToDelete.Id);
            RefreshPendingOrders();
            orderToDelete = null;
        }
    }

    private void UpdatePendingSearch(ChangeEventArgs e)
    {
        pendingSearchText = e.Value?.ToString() ?? string.Empty;
    }

    // ========================================= ITEM & CART METHODS =========================================

    private void OpenItemEditor(CatalogItem item)
    {
        editingCatalogItem = item;
        editingCartItem = null;
        draftQuantity = 1;
        draftDiscount = 0;
    }

    private void EditCartItem(TransactionItem item)
    {
        editingCartItem = item;
        editingCatalogItem = catalog.FirstOrDefault(x => x.Id == item.InventoryId) ??
            new CatalogItem(item.InventoryId, item.Name, string.Empty, item.Category, item.UnitPrice, ItemImage(item.Category, item.ImageUrl));
        draftQuantity = item.Quantity;
        draftDiscount = item.Discount;
    }

    private void CloseItemEditor()
    {
        editingCatalogItem = null;
        editingCartItem = null;
    }

    private void ConfirmItem()
    {
        if (editingCatalogItem is null) return;
        var quantity = Math.Max(1, draftQuantity);
        var discount = Math.Clamp(draftDiscount, 0, editingCatalogItem.Price * quantity);

        if (editingCartItem is null)
        {
            var existing = currentOrder.Items.FirstOrDefault(i =>
                string.Equals(i.InventoryId, editingCatalogItem.Id, StringComparison.OrdinalIgnoreCase) && i.Discount == 0 && discount == 0);

            if (existing is not null)
            {
                existing.Quantity += quantity;
                existing.TotalPrice = existing.Quantity * existing.UnitPrice;
            }
            else
            {
                currentOrder.Items.Add(new TransactionItem
                {
                    InventoryId = editingCatalogItem.Id,
                    Name = editingCatalogItem.Name,
                    Category = editingCatalogItem.Type,
                    ImageUrl = editingCatalogItem.ImageUrl,
                    Quantity = quantity,
                    UnitPrice = editingCatalogItem.Price,
                    Discount = discount,
                    TotalPrice = editingCatalogItem.Price * quantity - discount
                });
            }
        }
        else
        {
            editingCartItem.Quantity = quantity;
            editingCartItem.Discount = discount;
            editingCartItem.TotalPrice = editingCartItem.UnitPrice * quantity - discount;
        }

        PendingOrderService.SaveOrUpdate(currentOrder);
        CloseItemEditor();
    }

    private void ChangeCartItemQuantity(TransactionItem item, int delta)
    {
        var newQty = item.Quantity + delta;
        if (newQty <= 0)
        {
            RemoveItem(item);
            return;
        }
        item.Quantity = newQty;
        item.TotalPrice = Math.Max(0, item.Quantity * item.UnitPrice - item.Discount);
        PendingOrderService.SaveOrUpdate(currentOrder);
    }

    private void RemoveItem(TransactionItem item)
    {
        currentOrder.Items.Remove(item);
        PendingOrderService.SaveOrUpdate(currentOrder);
    }

    private async Task ClearCartAsync()
    {
        if (!currentOrder.Items.Any()) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Clear all items from this cart?")) return;

        currentOrder.Items.Clear();
        currentOrder.Payments.Clear();
        PendingOrderService.SaveOrUpdate(currentOrder);
    }

    private void SelectType(string type) => selectedType = type;
    private void UpdateSearch(ChangeEventArgs e) => searchText = e.Value?.ToString() ?? string.Empty;

    private async Task UpdateCustomerSearch(ChangeEventArgs e)
    {
        customerSearchText = e.Value?.ToString() ?? string.Empty;
        var keyword = customerSearchText.Trim();
        var requestVersion = ++customerSearchRequestVersion;

        customerSearchCts?.Cancel();
        customerSearchCts?.Dispose();
        customerSearchCts = null;

        if (string.IsNullOrWhiteSpace(keyword))
        {
            customers = defaultCustomers.ToList();
            isCustomerSearchLoading = false;
            return;
        }

        var cts = new CancellationTokenSource();
        customerSearchCts = cts;

        try
        {
            await Task.Delay(350, cts.Token);
            isCustomerSearchLoading = true;
            await InvokeAsync(StateHasChanged);

            var result = await CustomerService.SearchCustomersAsync(keyword, cts.Token);
            if (cts.IsCancellationRequested || requestVersion != customerSearchRequestVersion)
            {
                return;
            }

            customers = result.Success && result.Value is not null
                ? result.Value.Where(x => !string.IsNullOrWhiteSpace(x.SystemID)).OrderBy(CustomerName).ToList()
                : new List<Customer>();

            if (!result.Success)
            {
                message = result.ErrorMessage ?? "Unable to search customers.";
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (requestVersion == customerSearchRequestVersion)
            {
                isCustomerSearchLoading = false;
                customerSearchCts = null;
                await InvokeAsync(StateHasChanged);
            }

            cts.Dispose();
        }
    }

    // ========================================= PAYMENT & COMPLETE =========================================

    private void ContinueToPayment()
    {
        if (!currentOrder.Items.Any())
        {
            message = "Please add at least one item before proceeding to payment.";
            return;
        }

        PendingOrderService.SaveOrUpdate(currentOrder);
        stage = SaleStage.Payment;
    }

    private void BackToCart() => stage = SaleStage.Cart;

    private void OpenCalculator(CashSalesPaymentTypeDTO method)
    {
        calculatorMethod = method;
        var existing = PaymentFor(method.POSPaymentTypeID);
        calculatorDigits = existing is null ? string.Empty : ((long)Math.Round(existing.Amount * 100)).ToString();
    }

    private void EditPayment(TransactionPayment payment)
    {
        var method = paymentTypes.FirstOrDefault(item => item.POSPaymentTypeID == payment.PaymentTypeId);
        if (method is not null) OpenCalculator(method);
    }

    private void RemovePayment(TransactionPayment payment)
    {
        currentOrder.Payments.Remove(payment);
        PendingOrderService.SaveOrUpdate(currentOrder);
    }

    private TransactionPayment? PaymentFor(int paymentTypeId) =>
        currentOrder.Payments.FirstOrDefault(payment => payment.PaymentTypeId == paymentTypeId);

    private void CloseCalculator() => calculatorMethod = null;
    private void OpenMobileCart() => mobileCartOpen = true;
    private void CloseMobileCart() => mobileCartOpen = false;

    private void PressKey(string key)
    {
        if (calculatorDigits.Length < 11) calculatorDigits = (calculatorDigits + key).TrimStart('0');
    }

    private void PressZero() => PressKey("0");
    private void PressDoubleZero() => PressKey("00");
    private void ClearCalculator() => calculatorDigits = string.Empty;
    private void BackspaceCalculator()
    {
        if (calculatorDigits.Length > 0) calculatorDigits = calculatorDigits[..^1];
    }

    private void UseExactAmount() => calculatorDigits = ((long)Math.Round(CalculatorRemaining * 100)).ToString();

    private void ConfirmPaymentAmount()
    {
        if (calculatorMethod is null || CalculatorAmount <= 0) return;
        var payment = PaymentFor(calculatorMethod.POSPaymentTypeID);
        if (payment is null)
        {
            payment = new TransactionPayment { PaymentTypeId = calculatorMethod.POSPaymentTypeID };
            currentOrder.Payments.Add(payment);
        }
        payment.PaymentMethod = calculatorMethod.POSPaymentTypeName ?? "Payment";
        payment.Amount = CalculatorAmount;
        PendingOrderService.SaveOrUpdate(currentOrder);
        calculatorMethod = null;
    }

    private async Task SaveSale()
    {
        if (isSaving) return;
        if (Remaining > 0)
        {
            message = $"Add MYR {Remaining:N2} more before completing the sale.";
            return;
        }

        isSaving = true;
        try
        {
            var saleTransaction = new Transaction
            {
                AccountId = currentOrder.AccountId,
                CustomerName = currentOrder.CustomerName,
                CustomerContact = currentOrder.CustomerContact,
                CustomerEmail = currentOrder.CustomerEmail,
                BranchId = currentOrder.BranchId,
                Branch = currentOrder.BranchName,
                Date = DateTime.Today,
                Status = "Paid",
                Notes = currentOrder.Notes,
                Items = currentOrder.Items.Select(i => new TransactionItem
                {
                    InventoryId = i.InventoryId,
                    Name = i.Name,
                    Category = i.Category,
                    ImageUrl = i.ImageUrl,
                    Quantity = i.Quantity,
                    UnitPrice = i.UnitPrice,
                    Discount = i.Discount,
                    TotalPrice = i.TotalPrice
                }).ToList(),
                Payments = currentOrder.Payments.Select(p => new TransactionPayment
                {
                    PaymentTypeId = p.PaymentTypeId,
                    PaymentMethod = p.PaymentMethod,
                    Amount = p.Amount
                }).ToList(),
                Subtotal = currentOrder.Subtotal,
                Discount = currentOrder.Discount,
                Tax = 0,
                Amount = currentOrder.Total,
                ItemCount = currentOrder.ItemCount,
                Type = currentOrder.Items.Select(x => x.Category).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1
                    ? currentOrder.Items[0].Category
                    : "Mixed"
            };

            var firstPayment = currentOrder.Payments.FirstOrDefault();
            saleTransaction.PaymentTypeId = firstPayment?.PaymentTypeId ?? 0;
            saleTransaction.PaymentMethod = string.Join(" + ", currentOrder.Payments.Select(p => p.PaymentMethod).Distinct(StringComparer.OrdinalIgnoreCase));

            var result = await CashSalesService.CreateTransactionAsync(saleTransaction);
            if (!result.Success)
            {
                message = result.ErrorMessage ?? "Unable to save the transaction.";
                return;
            }

            savedSale = result.Value ?? saleTransaction;
            if (string.IsNullOrWhiteSpace(savedSale.CustomerName)) savedSale.CustomerName = currentOrder.CustomerName;
            if (savedSale.Amount <= 0) savedSale.Amount = currentOrder.Total;

            // Remove completed order from pending orders list
            PendingOrderService.Delete(currentOrder.Id);
            RefreshPendingOrders();

            stage = SaleStage.Complete;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task PrintReceipt()
    {
        if (savedSale is null) return;

        var itemRows = string.Join(string.Empty, currentOrder.Items.Select(item => $"""
            <tr>
                <td><strong>{EncodeReceiptText(item.Name)}</strong><small>{EncodeReceiptText(item.Category)}</small></td>
                <td class="number">{Math.Max(1, item.Quantity)}</td>
                <td class="number">{item.UnitPrice:N2}</td>
                <td class="number">{item.Discount:N2}</td>
                <td class="number">{item.TotalPrice:N2}</td>
            </tr>
            """));

        var receiptPayments = currentOrder.Payments.Count > 0
            ? currentOrder.Payments
            : [new TransactionPayment { PaymentMethod = savedSale.PaymentMethod, Amount = savedSale.Amount }];

        var paymentRows = string.Join(string.Empty, receiptPayments.Select(payment => $"""
            <div class="line"><span>{EncodeReceiptText(payment.PaymentMethod)}</span><strong>MYR {payment.Amount:N2}</strong></div>
            """));

        var html = $$"""
            <!doctype html>
            <html>
            <head>
                <meta charset="utf-8">
                <title>Receipt {{EncodeReceiptText(ReceiptNumber)}}</title>
                <style>
                    * { box-sizing: border-box; }
                    body { margin: 0; padding: 18px; color: #172033; font-family: Arial, sans-serif; font-size: 12px; }
                    .receipt { width: 100%; max-width: 390px; margin: 0 auto; }
                    .brand { text-align: center; padding-bottom: 14px; border-bottom: 2px solid #0759ad; }
                    .brand h1 { margin: 0; color: #064a94; font-size: 22px; }
                    .brand p { margin: 4px 0 0; color: #64748b; }
                    .label { margin: 11px 0 0; color: #64748b; font-size: 10px; font-weight: 700; letter-spacing: .08em; }
                    .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 14px; padding: 14px 0; }
                    .meta span { display: block; color: #64748b; font-size: 10px; text-transform: uppercase; }
                    .meta strong { display: block; margin-top: 2px; overflow-wrap: anywhere; }
                    table { width: 100%; border-collapse: collapse; }
                    th { padding: 8px 4px; border-block: 1px solid #cbd5e1; color: #475569; font-size: 10px; text-align: left; }
                    td { padding: 9px 4px; border-bottom: 1px solid #e2e8f0; vertical-align: top; }
                    td small { display: block; margin-top: 2px; color: #64748b; }
                    .number { text-align: right; white-space: nowrap; }
                    .totals { margin: 12px 0 0 auto; width: 74%; }
                    .line { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; }
                    .line.total { margin-top: 5px; padding-top: 9px; border-top: 2px solid #0759ad; color: #064a94; font-size: 15px; }
                    .payments { margin-top: 14px; padding: 11px; border-radius: 6px; background: #eff6ff; }
                    .change { color: #087552; }
                    footer { margin-top: 18px; color: #64748b; text-align: center; font-size: 10px; }
                    @media print { body { padding: 0; } }
                </style>
            </head>
            <body>
                <main class="receipt">
                    <header class="brand"><h1>Beauty Aesthetics</h1><p>Clinic Management</p><div class="label">OFFICIAL RECEIPT</div></header>
                    <section class="meta">
                        <div><span>Receipt No.</span><strong>{{EncodeReceiptText(ReceiptNumber)}}</strong></div>
                        <div><span>Date</span><strong>{{ReceiptDate:dd/MM/yyyy hh:mm tt}}</strong></div>
                        <div><span>Customer</span><strong>{{EncodeReceiptText(ReceiptCustomer)}}</strong></div>
                        <div><span>Branch</span><strong>{{EncodeReceiptText(ReceiptBranch)}}</strong></div>
                    </section>
                    <table>
                        <thead><tr><th>Item</th><th class="number">Qty</th><th class="number">Price</th><th class="number">Disc.</th><th class="number">Total</th></tr></thead>
                        <tbody>{{itemRows}}</tbody>
                    </table>
                    <section class="totals">
                        <div class="line"><span>Subtotal</span><strong>MYR {{currentOrder.Subtotal:N2}}</strong></div>
                        <div class="line"><span>Discount</span><strong>- MYR {{currentOrder.Discount:N2}}</strong></div>
                        <div class="line total"><span>Total</span><strong>MYR {{currentOrder.Total:N2}}</strong></div>
