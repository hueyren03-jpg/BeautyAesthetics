    private void DeleteSelectedReturnedStocks()
    {
        if (!SelectedReturnedStocksForDeletion.Any())
        {
            return;
        }

        foreach (var item in SelectedReturnedStocksForDeletion.ToList())
        {
            ReturnedStockList.Remove(item);

            if (SelectedReturnedStock == item)
            {
                SelectedReturnedStock = null;
            }

            SelectedReturnedStocksForPrint.Remove(item);
        }

        SelectedReturnedStocksForDeletion.Clear();
        IsReturnedStockDeleteMode = false;

        var remainingCount = FilteredReturnedStock.Count();
        var totalPages = Math.Max(1, (int)Math.Ceiling(remainingCount / 5.0));

        if (GINCurrentPage > totalPages)
        {
            GINCurrentPage = totalPages;
        }
    }

