    private IEnumerable<ReturnedStockItem> FilteredReturnedStock
    {
        get
        {
            var returnedStock = ReturnedStockList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(GINSearchQuery))
            {
                var search = GINSearchQuery.Trim();
                returnedStock = returnedStock.Where(r =>
                    (r.ReturnedStockNo?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    r.DateIssued.ToString("dd/MM/yyyy").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (r.IssuedBy?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.IssuedTo?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.Status?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.Reason?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    r.Quantity.ToString().Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    r.Amount.ToString("N2").Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            // Apply multiple filters
            foreach (var filter in ActiveGINFilters)
            {
                returnedStock = ApplyGINFilter(returnedStock, filter);
            }

            if (!string.IsNullOrEmpty(GINSortColumn))
            {
                returnedStock = GINSortColumn switch
                {
                    "ReturnedStockNo" => GINSortAscending ? returnedStock.OrderBy(r => r.ReturnedStockNo) : returnedStock.OrderByDescending(r => r.ReturnedStockNo),
                    "DateIssued" => GINSortAscending ? returnedStock.OrderBy(r => r.DateIssued) : returnedStock.OrderByDescending(r => r.DateIssued),
                    "IssuedBy" => GINSortAscending ? returnedStock.OrderBy(r => r.IssuedBy) : returnedStock.OrderByDescending(r => r.IssuedBy),
                    "IssuedTo" => GINSortAscending ? returnedStock.OrderBy(r => r.IssuedTo) : returnedStock.OrderByDescending(r => r.IssuedTo),
                    "Quantity" => GINSortAscending ? returnedStock.OrderBy(r => r.Quantity) : returnedStock.OrderByDescending(r => r.Quantity),
                    "Amount" => GINSortAscending ? returnedStock.OrderBy(r => r.Amount) : returnedStock.OrderByDescending(r => r.Amount),
                    _ => returnedStock
                };
            }

            return returnedStock;
        }
    }

