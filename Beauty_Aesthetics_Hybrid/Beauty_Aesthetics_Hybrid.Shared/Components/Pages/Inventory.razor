                        @if (SelectedGinDetails.Products.Any())
                        {
                            <div class="inventory-view-table-card">
                                <table class="inventory-view-table">
                                    <thead>
                                        <tr>
                                            <th>Product Name</th>
                                            <th>SKU</th>
                                            <th class="text-right">Quantity</th>
                                            <th class="text-right">Unit Price</th>
                                            <th class="text-right">Line Amount</th>
