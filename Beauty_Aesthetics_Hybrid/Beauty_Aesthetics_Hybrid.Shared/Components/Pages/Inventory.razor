    private async Task HandleAddCategory()
    {
        if (IsCategorySaving)
        {
            return;
        }

        var categoryName = NewCategoryName.Trim();
        var externalCode = NewCategoryExternalCode.Trim();

        if (string.IsNullOrWhiteSpace(categoryName))
        {
            CategoryApiError = "Category name is required.";
            return;
        }

        IsCategorySaving = true;
        CategoryApiError = null;

        try
        {
            var result = await InventoryOptionService.CreateCategoryAsync(categoryName, externalCode);
            if (!result.Success)
            {
                CategoryApiError = result.ErrorMessage ?? "Unable to create category.";
                return;
            }

            var displayCode = string.IsNullOrWhiteSpace(externalCode)
                ? result.Value?.Id ?? "-"
                : externalCode;

            Categories.Insert(0, new CategoryItem(result.Value?.Id ?? string.Empty, categoryName, displayCode));
            CategoriesCurrentPage = 1;
            CloseAddCategoryForm(force: true);
        }
        finally
        {
            IsCategorySaving = false;
        }
    }

