    private IEnumerable<ReturnedStockItem> ApplyGINFilter(IEnumerable<ReturnedStockItem> items, MultiTableFilter.FilterData filter)
    {
        if(filter.Column=="DateIssued"){var start=filter.StartDate?.Date??DateTime.MinValue.Date;var end=filter.EndDate?.Date??DateTime.MaxValue.Date;return items.Where(x=>x.DateIssued.Date>=start&&x.DateIssued.Date<=end);}
        return filter.Column switch { "ReturnedStockNo"=>items.Where(x=>TextMatches(x.ReturnedStockNo,filter)), "IssuedBy"=>items.Where(x=>TextMatches(x.IssuedBy,filter)), "IssuedTo"=>items.Where(x=>TextMatches(x.IssuedTo,filter)), "Quantity"=>items.Where(x=>InRange(x.Quantity,filter)), "Amount"=>items.Where(x=>InRange(x.Amount,filter)), "Status"=>items.Where(x=>TextMatches(x.Status,filter)), "Reason"=>items.Where(x=>TextMatches(x.Reason,filter)), _=>items };
    }

    private static bool TextMatches(string? source, MultiTableFilter.FilterData filter)
    {
        if(string.IsNullOrWhiteSpace(source)) return false;
        if(filter.Values.Count>0) return filter.Values.Any(v=>string.Equals(source.Trim(),v.Trim(),StringComparison.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(filter.Value)||source.Contains(filter.Value.Trim(),StringComparison.OrdinalIgnoreCase);
    }

    private static bool InRange(decimal? value, MultiTableFilter.FilterData filter) =>
        value.HasValue && (!filter.MinValue.HasValue||value.Value>=filter.MinValue.Value) && (!filter.MaxValue.HasValue||value.Value<=filter.MaxValue.Value);
    private static bool ContainsFilterValue(string? source, string value) =>
        !string.IsNullOrWhiteSpace(source) &&
        source.Contains(value.Trim(), StringComparison.OrdinalIgnoreCase);

