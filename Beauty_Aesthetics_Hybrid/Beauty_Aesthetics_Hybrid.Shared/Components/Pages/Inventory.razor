    private List<StockTransferProduct> TransferSelectionProducts { get; set; } = new();
    private bool IsTransferProductApiLoading { get; set; }

    private IEnumerable<StockTransferProduct> FilteredTransferProducts
    {
        get
        {
            var products = TransferSelectionProducts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(TransferProductSearch))
            {
                products = products.Where(p =>
                    p.ProductName.Contains(TransferProductSearch, StringComparison.OrdinalIgnoreCase) ||
                    p.Sku.Contains(TransferProductSearch, StringComparison.OrdinalIgnoreCase));
            }

            return products;
        }
    }

    private IEnumerable<StockTransferProduct> FilteredStockProducts
    {
        get
        {
            var products = StockTransferProducts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(StockTransferSearchQuery))
            {
                var search = StockTransferSearchQuery.Trim();
                products = products.Where(p =>
                    (p.ProductName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.Sku?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.Uom1?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.StockStatus?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    p.Price.ToString("N2").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (p.StockCount?.ToString() ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            // Apply multiple filters
            foreach (var filter in ActiveStockTransferFilters)
            {
                products = ApplyStockTransferFilter(products, filter);
            }

            if (!string.IsNullOrEmpty(StockTransferSortColumn))
            {
                products = StockTransferSortColumn switch
                {
                    "ProductName" => StockTransferSortAscending ? products.OrderBy(p => p.ProductName) : products.OrderByDescending(p => p.ProductName),
                    "Sku" => StockTransferSortAscending ? products.OrderBy(p => p.Sku) : products.OrderByDescending(p => p.Sku),
                    "Price" => StockTransferSortAscending ? products.OrderBy(p => p.Price) : products.OrderByDescending(p => p.Price),
                    "Uom1" => StockTransferSortAscending ? products.OrderBy(p => p.Uom1) : products.OrderByDescending(p => p.Uom1),
                    "StockCount" => StockTransferSortAscending ? products.OrderBy(p => p.StockCount) : products.OrderByDescending(p => p.StockCount),
                    "StockStatus" => StockTransferSortAscending ? products.OrderBy(p => p.StockStatus) : products.OrderByDescending(p => p.StockStatus),
                    _ => products
                };
            }

            return products;
        }
    }

    private void HandleStockTransferFiltersApplied(List<MultiTableFilter.FilterData> filters)
    {
        ActiveStockTransferFilters = filters;
        StockTransferCurrentPage = 1;
        StateHasChanged();
    }

