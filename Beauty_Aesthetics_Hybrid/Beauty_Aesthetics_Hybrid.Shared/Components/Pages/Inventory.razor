                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Issued To / Recipient</span>
                                <span class="inventory-view-field__value">@SelectedGinDetails.IssuedTo</span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Total Quantity</span>
                                <span class="inventory-view-field__value font-bold">@SelectedGinDetails.Quantity @SelectedGinDetails.Uom</span>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SelectedGinDetails.Reason))
                    {
                        <div class="inventory-view-section">
                            <h3 class="inventory-view-section__title"><i class="bi bi-card-text"></i> Issue Reason / Notes</h3>
                            <div class="inventory-view-remarks">
                                <p>@SelectedGinDetails.Reason</p>
                            </div>
                        </div>
