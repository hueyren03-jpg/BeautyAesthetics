    protected override async Task OnInitializedAsync()
    {
        if (string.Equals(RequestedTab, "GRN", StringComparison.OrdinalIgnoreCase))
        {
            ActiveTab = "GRN";
        }

        // Document histories are branch-scoped, so branch IDs must exist first.
        await LoadStockTransferBranchesAsync();

        await Task.WhenAll(
            LoadProductsAsync(),
            LoadStockTransfersAsync(),
            LoadGRNsAsync(),
            LoadPendingStockReceiptsAsync(),
            LoadCategoriesAsync());

        ReconcileStockTransferStatuses();
    }

    private async Task LoadCategoriesAsync()
    {
        CategoryApiError = null;

        var result = await InventoryOptionService.GetCategoriesAsync();
        if (!result.Success || result.Value is null)
        {
            CategoryApiError = result.ErrorMessage ?? "Unable to load categories.";
            Categories = [];
            return;
        }

        Categories = result.Value
            .Where(category => !string.IsNullOrWhiteSpace(category.SupportingTableName))
            .Select(category => new CategoryItem(
                category.SupportingTableID ?? string.Empty,
                category.SupportingTableName!.Trim(),
                string.IsNullOrWhiteSpace(category.TextField)
                    ? (string.IsNullOrWhiteSpace(category.SupportingTableID) ? "-" : category.SupportingTableID)
                    : category.TextField))
            .ToList();

        CategoriesCurrentPage = 1;
    }
    private async Task LoadProductsAsync()
    {
        IsProductApiLoading = true;
        ProductApiError = null;

        try
        {
            var result = await ProductInventoryService.LoadProductsAsync(InventoryBranchId);
            if (!result.Success || result.Value is null)
            {
                ProductApiError = result.ErrorMessage ?? "Unable to load products.";
                InventoryItems = [];
                return;
            }

            InventoryItems = result.Value.ToList();
            StockTransferProducts = InventoryItems.Select(ToStockTransferProduct).ToList();
            StockTransferCurrentPage = 1;
            ProductsCurrentPage = 1;
        }
        finally
        {
            IsProductApiLoading = false;
        }
    }

    private async Task LoadStockTransferBranchesAsync()
    {
        IsStockTransferBranchApiLoading = true;
        StockTransferBranchApiError = null;

        try
        {
            var result = await BranchLookupService.LoadBranchesAsync();
            if (!result.Success || result.Value is null)
            {
                StockTransferBranches = [];
                StockTransferBranchApiError = result.ErrorMessage ?? "Unable to load branches.";
                return;
            }

            StockTransferBranches = result.Value.ToList();
            if (StockTransferBranches.Count == 0)
            {
                StockTransferBranchApiError = "No active branches are available for stock transfer.";
            }
        }
        finally
        {
            IsStockTransferBranchApiLoading = false;
        }
    }

    private IReadOnlyList<string> GetInventoryBranchIds()
    {
        return StockTransferBranches
            .Select(branch => branch.Id)
            .Append(InventoryBranchId)
            .Where(branchId => !string.IsNullOrWhiteSpace(branchId))
            .Select(branchId => branchId.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static bool IsSameBranch(string? left, string? right) =>
        !string.IsNullOrWhiteSpace(left) &&
        !string.IsNullOrWhiteSpace(right) &&
        string.Equals(left.Trim(), right.Trim(), StringComparison.OrdinalIgnoreCase);

    private bool IsTransferVisibleToCurrentBranch(TransferHistoryItem transfer)
    {
        var sourceBranch = string.IsNullOrWhiteSpace(transfer.FromBranchId)
            ? transfer.IssuedBy
            : transfer.FromBranchId;
        var destinationBranch = string.IsNullOrWhiteSpace(transfer.ToBranchId)
            ? transfer.IssuedTo
            : transfer.ToBranchId;

        return IsSameBranch(sourceBranch, InventoryBranchId) ||
               IsSameBranch(destinationBranch, InventoryBranchId);
    }

    private async Task LoadStockTransfersAsync()
    {
        IsStockTransferApiLoading = true;
        StockTransferApiError = null;
        TransferHistory = [];

        try
        {
            var results = await Task.WhenAll(
                GetInventoryBranchIds().Select(branchId => StockTransferSvc.LoadTransfersAsync(branchId)));
            var successfulResults = results
                .Where(result => result.Success && result.Value is not null)
                .ToList();

            if (successfulResults.Count == 0)
            {
                StockTransferApiError = results
                    .Select(result => result.ErrorMessage)
                    .FirstOrDefault(message => !string.IsNullOrWhiteSpace(message))
                    ?? "Unable to load stock transfers.";
                return;
            }

            TransferHistory = successfulResults
                .SelectMany(result => result.Value!)
                .Select(ToTransferHistoryItem)
                .Where(IsTransferVisibleToCurrentBranch)
                .GroupBy(
                    item => !string.IsNullOrWhiteSpace(item.DocumentId)
                        ? $"id:{item.DocumentId.Trim()}"
                        : $"code:{item.TransferNo.Trim()}",
                    StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderByDescending(item => item.DateIssued)
                .ToList();
            ReconcileStockTransferStatuses();
            StockTransferHistoryCurrentPage = 1;
            SelectedTransferHistoryItem = null;
            SelectedTransferHistoryDetails = null;
        }
        finally
        {
            IsStockTransferApiLoading = false;
        }
    }

    private static TransferHistoryItem ToTransferHistoryItem(StockTransferViewModel transfer)
    {
        return new TransferHistoryItem
        {
            DocumentId = transfer.DocumentId,
            TransferNo = transfer.DisplayCode,
            DateIssued = transfer.Date,
            FromBranchId = transfer.FromBranchId,
            ToBranchId = transfer.ToBranchId,
            IssuedBy = string.IsNullOrWhiteSpace(transfer.FromBranchName)
                ? transfer.FromBranchId
                : transfer.FromBranchName,
            IssuedTo = string.IsNullOrWhiteSpace(transfer.ToBranchName)
                ? transfer.ToBranchId
                : transfer.ToBranchName,
        Status = NormalizeTransferStatus(transfer.Status),
            Notes = transfer.Remarks,
            Products = transfer.Lines.Select(line => new TransferProductLine
            {
                InventoryMovementId = line.InventoryMovementId,
                InventoryId = line.InventoryId,
                ProductName = line.ProductName,
                Sku = line.Sku,
                Quantity = (int)Math.Max(0, line.Quantity),
                Uom = line.UnitOfMeasurementId
            }).ToList()
    };
}

private static string NormalizeTransferStatus(string? status)
{
    if (string.IsNullOrWhiteSpace(status) ||
        string.Equals(status, "Pending", StringComparison.OrdinalIgnoreCase))
    {
        return "In Transit";
    }

    return status.Trim();
}

private static StockTransferProduct ToStockTransferProduct(InventoryViewModel.InventoryItem item)
    {
        var stockCount = item.StockQuantity;
        var reorderLevel = ParseStockDecimal(item.LowAlertCount);
        var stockStatus = !stockCount.HasValue
            ? "Not loaded"
            : stockCount.Value <= 0
                ? "Out of Stock"
                : reorderLevel > 0 && stockCount.Value <= reorderLevel
                    ? "Low Stock"
                    : "In Stock";

        return new StockTransferProduct
        {
            MasterAccountId = item.MasterAccountId,
            ProductName = item.Type,
            Sku = item.Sku,
            Price = item.Price,
            Uom1 = NormalizeStockUom(item.StockUom1),
            Uom2 = NormalizeStockUom(item.StockUom2),
            StockCount = stockCount,
            StockStatus = stockStatus
        };
    }

    private static decimal ParseStockDecimal(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return 0;
        }

        var numeric = new string(value.Trim()
            .TakeWhile(character => char.IsDigit(character) || character is '.' or '-')
            .ToArray());
        return decimal.TryParse(numeric, out var parsed) ? parsed : 0;
    }

    private static string FormatStockCount(decimal? value) =>
        value.HasValue ? value.Value.ToString("0.##") : "-";
    private static string NormalizeStockUom(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Trim() == "-")
        {
            return "UNIT";
        }

        var trimmed = value.Trim().TrimStart('-').Trim();
        var firstSpace = trimmed.IndexOf(' ');
        return firstSpace > 0 && int.TryParse(trimmed[..firstSpace], out _)
            ? trimmed[(firstSpace + 1)..].Trim()
            : trimmed;
    }
    private async Task LoadGRNsAsync()
    {
        IsGRNApiLoading = true;
        GRNApiError = null;
        GRNs = [];
        GRNsForTransferReconciliation = [];

        try
        {
            var results = await Task.WhenAll(GetInventoryBranchIds().Select(async branchId => new
            {
                BranchId = branchId,
                Result = await StockGrnService.LoadGrnsAsync(branchId)
            }));
            var successfulResults = results
                .Where(load => load.Result.Success && load.Result.Value is not null)
                .ToList();

            if (successfulResults.Count == 0)
            {
                GRNApiError = results
                    .Select(load => load.Result.ErrorMessage)
                    .FirstOrDefault(message => !string.IsNullOrWhiteSpace(message))
                    ?? "Unable to load GRN records.";
                return;
            }

            GRNsForTransferReconciliation = successfulResults
                .SelectMany(load => load.Result.Value!.Select(record =>
                {
                    var item = ToGRNItem(record);
                    if (string.IsNullOrWhiteSpace(item.DOCBranch))
                    {
                        item.DOCBranch = load.BranchId;
                    }

                    return item;
                }))
                .GroupBy(
                    item => !string.IsNullOrWhiteSpace(item.DocumentId)
                        ? $"id:{item.DocumentId.Trim()}"
                        : $"code:{item.DOCBranch.Trim()}:{item.DOCNo.Trim()}",
                    StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderByDescending(item => item.Date)
                .ToList();

            // The table is branch-owned. Cross-branch GRNs are retained only for
            // matching an outgoing transfer to the destination receipt generated by the API.
            GRNs = GRNsForTransferReconciliation
                .Where(item => IsSameBranch(item.DOCBranch, InventoryBranchId))
                .ToList();
            ReconcileStockTransferStatuses();
            GRNCurrentPage = 1;
            SelectedGRN = null;
            SelectedGRNsForDeletion.Clear();
            SelectedGRNsForPrint.Clear();
        }
        finally
        {
            IsGRNApiLoading = false;
        }
    }

    private async Task LoadPendingStockReceiptsAsync()
    {
        IsPendingStockReceiptsLoading = true;
        PendingStockReceiptError = null;

        try
        {
            var result = await PendingStockReceiptService.LoadPendingAsync(InventoryBranchId);
            if (!result.Success || result.Value is null)
            {
                PendingStockReceipts = new();
                PendingStockReceiptError = result.ErrorMessage ?? "Unable to load incoming stock transfers.";
                return;
            }

        PendingStockReceipts = result.Value
            .Where(receipt => string.IsNullOrWhiteSpace(receipt.DestinationBranchId) ||
                              IsSameBranch(receipt.DestinationBranchId, InventoryBranchId))
            .Where(receipt => !WasAcceptedLocally(receipt))
            .ToList();
        }
        finally
        {
            IsPendingStockReceiptsLoading = false;
        }
    }

    private async Task TogglePendingStockReceiptDetailsAsync(PendingStockReceiptViewModel receipt)
    {
        receipt.IsExpanded = !receipt.IsExpanded;
        if (!receipt.IsExpanded || receipt.DetailsLoaded)
        {
            return;
        }

        if (!await EnsurePendingStockReceiptDetailsAsync(receipt))
        {
            receipt.IsExpanded = false;
        }
    }

    private async Task<bool> EnsurePendingStockReceiptDetailsAsync(PendingStockReceiptViewModel receipt)
    {
        if (receipt.DetailsLoaded)
        {
            return true;
        }

        PendingStockReceiptError = null;
        var result = await PendingStockReceiptService.LoadDetailsAsync(receipt.DocumentId);
        if (!result.Success || result.Value is null)
        {
            PendingStockReceiptError = result.ErrorMessage ?? "Unable to load the stock transfer items.";
            return false;
        }

        receipt.Lines = result.Value;
        receipt.DetailsLoaded = true;
        return true;
    }

    private async Task AcceptPendingStockReceiptAsync(PendingStockReceiptViewModel receipt)
    {
        if (!await JSRuntime.InvokeAsync<bool>(
                "confirm",
                $"Accept {receipt.DisplayCode} into branch {InventoryBranchId}? This will update stock balances."))
        {
            return;
        }

        AcceptingStockReceiptDocumentId = receipt.DocumentId;
        PendingStockReceiptError = null;

        try
        {
            if (!await EnsurePendingStockReceiptDetailsAsync(receipt))
            {
                return;
            }

            var sourceTransfer = await ResolveSourceTransferAsync(receipt);
            var grnKeysBeforeAcceptance = GRNsForTransferReconciliation
                .Select(GetGrnKey)
                .Where(key => !string.IsNullOrWhiteSpace(key))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var result = await PendingStockReceiptService.AcceptAsync(receipt.DocumentId);
        if (!result.Success)
        {
            PendingStockReceiptError = result.ErrorMessage ?? "Unable to accept the incoming stock transfer.";
            return;
        }

        RememberAcceptedStockReceipt(receipt, sourceTransfer);
        PendingStockReceipts.RemoveAll(item =>
            SameDocumentKey(item.DocumentId, receipt.DocumentId) ||
            SameDocumentKey(item.DisplayCode, receipt.DisplayCode));
        MarkSourceTransferReceived(sourceTransfer);
        ReconcileStockTransferStatuses();
        StateHasChanged();

        await RefreshInventoryAfterAcceptanceAsync(
            receipt,
            sourceTransfer,
            grnKeysBeforeAcceptance,
            result.Value);
        }
        finally
        {
            AcceptingStockReceiptDocumentId = null;
        }
    }

    private static GRNItem ToGRNItem(StockGrnViewModel grn)
    {
        return new GRNItem
        {
            DocumentId = grn.DocumentId,
            DOCBranch = grn.BranchId,
            Date = grn.Date,
            DOCNo = grn.DisplayCode,
            Name = string.IsNullOrWhiteSpace(grn.ItemName) ? grn.AccountName : grn.ItemName,
            SupplierName = grn.AccountName,
            SupplierAccountId = grn.AccountId,
            PONo = grn.PODisplayCode,
            PODocumentId = grn.PODocumentId,
            ReferenceNumber = grn.ReferenceNumber,
            PaymentTermName = grn.PaymentTermName,
            CurrencyId = grn.TransactionCurrencyId,
            CreatedByDocumentId = grn.CreatedByDocumentId,
            CreatedByDocumentDisplayCode = grn.CreatedByDocumentDisplayCode,
            VerifyStatus = grn.VerifyStatus,
            TaxAmount = grn.TaxAmount,
            Amount = grn.Amount,
            IsLocked = grn.IsLocked,
            IsVoid = grn.IsVoid
        };
    }

    private async Task<TransferHistoryItem?> ResolveSourceTransferAsync(PendingStockReceiptViewModel receipt)
    {
        var destinationBranch = string.IsNullOrWhiteSpace(receipt.DestinationBranchId)
            ? InventoryBranchId
            : receipt.DestinationBranchId;
        var receiptMovementIds = receipt.Lines
            .Select(line => line.InventoryMovementId)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var candidates = TransferHistory
            .Where(transfer =>
                SameDocumentKey(transfer.ToBranchId, destinationBranch) ||
                SameDocumentKey(transfer.IssuedTo, destinationBranch))
            .OrderBy(transfer => Math.Abs((transfer.DateIssued.Date - receipt.FinancialDate.Date).TotalDays))
            .Take(12)
            .ToList();

        foreach (var candidate in candidates)
        {
            if (candidate.Products.Count == 0 ||
                (receiptMovementIds.Count > 0 && candidate.Products.All(line => string.IsNullOrWhiteSpace(line.InventoryMovementId))))
            {
                var details = await StockTransferSvc.LoadTransferAsync(candidate.DocumentId);
                if (details.Success && details.Value is not null)
                {
                    var loaded = ToTransferHistoryItem(details.Value);
                    candidate.FromBranchId = loaded.FromBranchId;
                    candidate.ToBranchId = loaded.ToBranchId;
                    candidate.Products = loaded.Products;
                }
            }

            if (receiptMovementIds.Count > 0 && candidate.Products.Any(line =>
                    !string.IsNullOrWhiteSpace(line.InventoryMovementId) &&
                    receiptMovementIds.Contains(line.InventoryMovementId)))
            {
                return candidate;
            }
        }

        var fallbackMatches = candidates
            .Where(candidate => ReceiptLinesMatchTransfer(receipt.Lines, candidate.Products))
            .ToList();
        return fallbackMatches.Count == 1 ? fallbackMatches[0] : null;
    }

    private static bool ReceiptLinesMatchTransfer(
        IReadOnlyList<PendingStockReceiptLineViewModel> receiptLines,
        IReadOnlyList<TransferProductLine> transferLines)
    {
        if (receiptLines.Count == 0 || transferLines.Count == 0 || receiptLines.Count != transferLines.Count)
        {
            return false;
        }

        return receiptLines.All(receiptLine => transferLines.Any(transferLine =>
            (SameDocumentKey(receiptLine.ItemId, transferLine.InventoryId) ||
             SameDocumentKey(receiptLine.ItemCode, transferLine.Sku)) &&
            Math.Abs(receiptLine.Quantity - transferLine.Quantity) < 0.001m));
    }

    private async Task<bool> RefreshInventoryAfterAcceptanceAsync(
        PendingStockReceiptViewModel acceptedReceipt,
        TransferHistoryItem? sourceTransfer,
        ISet<string> grnKeysBeforeAcceptance,
        string? acceptedDocumentReference)
    {
        var destinationBranch = string.IsNullOrWhiteSpace(acceptedReceipt.DestinationBranchId)
            ? InventoryBranchId
            : acceptedReceipt.DestinationBranchId;
        var retryDelays = new[] { 0, 500, 1000, 1500, 2500, 4000 };

        foreach (var retryDelay in retryDelays)
        {
            if (retryDelay > 0)
            {
                await Task.Delay(retryDelay);
            }

        await Task.WhenAll(
            LoadPendingStockReceiptsAsync(),
            LoadGRNsAsync(),
            LoadStockTransfersAsync(),
            LoadProductsAsync());

        MarkSourceTransferReceived(sourceTransfer);

            GRNItem? persistedAcceptedGrn = null;
            if (IsLikelyDocumentReference(acceptedDocumentReference))
            {
                var acceptedGrnResult = await StockGrnService.LoadGrnAsync(acceptedDocumentReference!);
                if (acceptedGrnResult.Success &&
                    acceptedGrnResult.Value is not null &&
                    !string.IsNullOrWhiteSpace(acceptedGrnResult.Value.DocumentId))
                {
                    persistedAcceptedGrn = ToGRNItem(acceptedGrnResult.Value);
                    MergeAcceptedGrn(
                        persistedAcceptedGrn,
                        acceptedReceipt,
                        sourceTransfer);
                }
            }

            GRNItem? destinationMatch = null;
            var destinationGrnsResult = await StockGrnService.LoadGrnsAsync(destinationBranch);
            if (destinationGrnsResult.Success && destinationGrnsResult.Value is not null)
            {
                destinationMatch = destinationGrnsResult.Value
                    .Select(record =>
                    {
                        var item = ToGRNItem(record);
                        if (string.IsNullOrWhiteSpace(item.DOCBranch))
                        {
                            item.DOCBranch = destinationBranch;
                        }

                        return item;
                    })
                    .FirstOrDefault(item =>
                        !grnKeysBeforeAcceptance.Contains(GetGrnKey(item)) &&
                        IsAcceptedTransferGrn(item, acceptedReceipt, sourceTransfer));
            }

        var matchingNewGrn = persistedAcceptedGrn ?? destinationMatch ??
            GRNsForTransferReconciliation.FirstOrDefault(item =>
                !grnKeysBeforeAcceptance.Contains(GetGrnKey(item)) &&
                IsAcceptedTransferGrn(item, acceptedReceipt, sourceTransfer));

            if (matchingNewGrn is not null)
            {
            MergeAcceptedGrn(matchingNewGrn, acceptedReceipt, sourceTransfer);
            MarkSourceTransferReceived(sourceTransfer);
            ReconcileStockTransferStatuses();
            return true;
        }
        }

        return false;
    }

    private static string GetGrnKey(GRNItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.DocumentId))
        {
            return $"id:{item.DocumentId.Trim()}";
        }

        return string.IsNullOrWhiteSpace(item.DOCNo)
            ? string.Empty
            : $"code:{item.DOCBranch.Trim()}:{item.DOCNo.Trim()}";
    }

    private static bool IsAcceptedTransferGrn(
        GRNItem grn,
        PendingStockReceiptViewModel receipt,
        TransferHistoryItem? sourceTransfer)
    {
        var destinationBranch = receipt.DestinationBranchId;
        if (!string.IsNullOrWhiteSpace(destinationBranch) && !IsSameBranch(grn.DOCBranch, destinationBranch))
        {
            return false;
        }

        if (sourceTransfer is null)
        {
            return true;
        }

        var hasSourceReference =
            !string.IsNullOrWhiteSpace(grn.CreatedByDocumentId) ||
            !string.IsNullOrWhiteSpace(grn.CreatedByDocumentDisplayCode) ||
            !string.IsNullOrWhiteSpace(grn.PODocumentId) ||
            !string.IsNullOrWhiteSpace(grn.PONo);
        if (!hasSourceReference)
        {
            return true;
        }

        return SameDocumentKey(grn.CreatedByDocumentId, sourceTransfer.DocumentId) ||
               SameDocumentKey(grn.CreatedByDocumentDisplayCode, sourceTransfer.TransferNo) ||
               SameDocumentKey(grn.PODocumentId, sourceTransfer.DocumentId) ||
               SameDocumentKey(grn.PONo, sourceTransfer.TransferNo);
    }

    private void MergeAcceptedGrn(
        GRNItem acceptedGrn,
        PendingStockReceiptViewModel acceptedReceipt,
        TransferHistoryItem? sourceTransfer)
    {
        acceptedGrn.DOCBranch = string.IsNullOrWhiteSpace(acceptedGrn.DOCBranch)
            ? (string.IsNullOrWhiteSpace(acceptedReceipt.DestinationBranchId)
                ? InventoryBranchId
                : acceptedReceipt.DestinationBranchId)
            : acceptedGrn.DOCBranch;

        if (sourceTransfer is not null)
        {
            acceptedGrn.CreatedByDocumentId = string.IsNullOrWhiteSpace(acceptedGrn.CreatedByDocumentId)
                ? sourceTransfer.DocumentId
                : acceptedGrn.CreatedByDocumentId;
            acceptedGrn.CreatedByDocumentDisplayCode = string.IsNullOrWhiteSpace(acceptedGrn.CreatedByDocumentDisplayCode)
                ? sourceTransfer.TransferNo
                : acceptedGrn.CreatedByDocumentDisplayCode;
        }

        GRNsForTransferReconciliation.RemoveAll(item =>
            SameDocumentKey(item.DocumentId, acceptedGrn.DocumentId) ||
            SameDocumentKey(item.DOCNo, acceptedGrn.DOCNo));
        GRNsForTransferReconciliation.Add(acceptedGrn);

        if (IsSameBranch(acceptedGrn.DOCBranch, InventoryBranchId))
        {
            GRNs.RemoveAll(item =>
                SameDocumentKey(item.DocumentId, acceptedGrn.DocumentId) ||
                SameDocumentKey(item.DOCNo, acceptedGrn.DOCNo));
            GRNs.Add(acceptedGrn);
        }
    }

    private void MarkSourceTransferReceived(TransferHistoryItem? sourceTransfer)
    {
        if (sourceTransfer is null)
        {
            return;
        }

        foreach (var item in TransferHistory.Where(item =>
                     SameDocumentKey(item.DocumentId, sourceTransfer.DocumentId) ||
                     SameDocumentKey(item.TransferNo, sourceTransfer.TransferNo)))
        {
            item.Status = "Received";
        }
    }

    private static bool IsLikelyDocumentReference(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length > 160 || value.Any(char.IsWhiteSpace))
        {
            return false;
        }

        return !value.Contains("success", StringComparison.OrdinalIgnoreCase);
    }

private void ReconcileStockTransferStatuses()
{
    var receivedDocumentKeys = new HashSet<string>(
        AcceptedStockReceiptKeys,
        StringComparer.OrdinalIgnoreCase);
        foreach (var grn in GRNsForTransferReconciliation.Where(item => !item.IsVoid))
        {
            AddDocumentKey(receivedDocumentKeys, grn.CreatedByDocumentId);
            AddDocumentKey(receivedDocumentKeys, grn.CreatedByDocumentDisplayCode);
            AddDocumentKey(receivedDocumentKeys, grn.PODocumentId);
            AddDocumentKey(receivedDocumentKeys, grn.PONo);
        }

        foreach (var transfer in TransferHistory)
        {
            if (receivedDocumentKeys.Contains(transfer.DocumentId) ||
                receivedDocumentKeys.Contains(transfer.TransferNo))
            {
                transfer.Status = "Received";
            }
        }
    }

    private static void AddDocumentKey(ISet<string> keys, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            keys.Add(value.Trim());
        }
    }

    private static bool SameDocumentKey(string? left, string? right) =>
        !string.IsNullOrWhiteSpace(left) &&
        !string.IsNullOrWhiteSpace(right) &&
        string.Equals(left.Trim(), right.Trim(), StringComparison.OrdinalIgnoreCase);

    private void RememberAcceptedStockReceipt(
        PendingStockReceiptViewModel receipt,
        TransferHistoryItem? sourceTransfer)
    {
        AddDocumentKey(AcceptedStockReceiptKeys, receipt.DocumentId);
        AddDocumentKey(AcceptedStockReceiptKeys, receipt.DisplayCode);

        if (sourceTransfer is not null)
        {
            AddDocumentKey(AcceptedStockReceiptKeys, sourceTransfer.DocumentId);
            AddDocumentKey(AcceptedStockReceiptKeys, sourceTransfer.TransferNo);
        }

        foreach (var line in receipt.Lines)
        {
            AddDocumentKey(AcceptedStockMovementIds, line.InventoryMovementId);
        }
    }

    private bool WasAcceptedLocally(PendingStockReceiptViewModel receipt)
    {
        if (AcceptedStockReceiptKeys.Any(key =>
                SameDocumentKey(key, receipt.DocumentId) ||
                SameDocumentKey(key, receipt.DisplayCode)))
        {
            return true;
        }

        return receipt.Lines.Any(line =>
            !string.IsNullOrWhiteSpace(line.InventoryMovementId) &&
            AcceptedStockMovementIds.Contains(line.InventoryMovementId));
    }


    

