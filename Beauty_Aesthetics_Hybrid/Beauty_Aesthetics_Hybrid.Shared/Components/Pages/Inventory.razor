    private static string GetProductStockDisplay(InventoryViewModel.InventoryItem item)
    {
        return GetProductStockDisplay(item.StockQuantity, item.StockUom1);
    }

    private static string GetProductStockDisplay(EditProductModel item) =>
        GetProductStockDisplay(item.StockQuantity, item.StockUom1);

    private static string GetProductStockDisplay(decimal? stockQuantity, string? stockUom)
    {
        if (!stockQuantity.HasValue)
        {
            return DisplayProductValue(stockUom);
        }

        var uom = NormalizeStockUom(stockUom);
        var quantity = stockQuantity.Value.ToString("0.##");
        return string.IsNullOrWhiteSpace(uom) || uom == "-" ? quantity : $"{quantity} {uom}";
    }

    private static string GetProductStockStatus(InventoryViewModel.InventoryItem item)
    {
        if (!item.StockQuantity.HasValue)
        {
            return "Not Loaded";
        }

        var reorderLevel = ParseStockDecimal(item.LowAlertCount);
        if (item.StockQuantity.Value <= 0)
        {
            return "Out of Stock";
        }

        return reorderLevel > 0 && item.StockQuantity.Value <= reorderLevel
            ? "Low Stock"
            : "In Stock";
    }

    private static string GetProductStockStatusClass(InventoryViewModel.InventoryItem item) =>
        GetProductStockStatus(item) switch
        {
            "In Stock" => "available",
            "Low Stock" => "low",
            "Out of Stock" => "out",
            _ => "unknown"
        };
    private static int GetProductStockStatusSortOrder(InventoryViewModel.InventoryItem item) =>
        GetProductStockStatus(item) switch
        {
            "In Stock" => 0,
            "Low Stock" => 1,
            "Out of Stock" => 2,
            _ => 3
        };
