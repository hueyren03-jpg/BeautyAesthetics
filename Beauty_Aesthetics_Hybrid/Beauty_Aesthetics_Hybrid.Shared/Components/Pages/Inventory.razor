                             {
                                 <button class="tab-btn stock-transfer__btn-with-text stock-transfer__btn-with-text--light" @onclick="ActivatePrintMode">
                                     <i class="bi bi-printer"></i> <span>Print</span>
                                 </button>
                             }
                             else
                             {
                                 <button class="tab-btn inventory__btn inventory__btn--success" @onclick="ConfirmPrint" disabled="@(!SelectedPurchaseOrdersForPrint.Any())">
                                     <i class="bi bi-check-circle"></i> Confirm Print
                                 </button>
                                 <button class="tab-btn inventory__btn inventory__btn--secondary" @onclick="CancelPrintMode">
                                     Cancel
                                 </button>
                             }
                         </div>
                         <div class="inventory__search-container">
                             <input class="inventory__search"
                                    type="search"
                                    placeholder="Search..."
                                    value="@PurchaseOrderSearch"
                                    @oninput="OnPurchaseOrderSearchChanged" />
                             <i class="bi bi-search inventory__search-icon"></i>
                         </div>
                     </div>
                     <div class="purchase-orders__filter">
                         <AdvancedInventoryFilter Columns="@PurchaseOrderFilterColumns" OnApply="@HandlePurchaseOrderFiltersApplied" OnClear="@HandlePurchaseOrderFiltersCleared" ModuleName="Purchase Orders" ResultCount="@FilteredPurchaseOrders.Count()" />
                     </div>
                 </div>

                 <div class="inventory__table-wrapper">
                     <table class="inventory__table purchase-orders__table resizable-table inventory-mobile-compact-table inventory-mobile-compact-table--po @(IsPrintModeActive ? "inventory-mobile-compact-table--selecting" : string.Empty)">
                         <thead>
                             <tr>
                                 @if (IsPrintModeActive)
                                 {
                                     <th class="purchase-orders__checkbox-col">
                                         Select
                                     </th>
                                 }
                                 <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "PoNo")' @onclick='() => TogglePurchaseOrderSort("PoNo")'>
                                     PO No.<span class="resize-handle"></span>
                                 </th>
                                 <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "Date")' @onclick='() => TogglePurchaseOrderSort("Date")'>
                                     Date<span class="resize-handle"></span>
                                 </th>
                                 <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "Branch")' @onclick='() => TogglePurchaseOrderSort("Branch")'>
                                     Branch<span class="resize-handle"></span>
                                 </th>
                                 <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "Supplier")' @onclick='() => TogglePurchaseOrderSort("Supplier")'>
                                     Supplier<span class="resize-handle"></span>
                                 </th>
                                 <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "Status")' @onclick='() => TogglePurchaseOrderSort("Status")'>
                                    Status<span class="resize-handle"></span>
                                </th>
                                <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "Remarks")' @onclick='() => TogglePurchaseOrderSort("Remarks")'>
                                    Remarks<span class="resize-handle"></span>
                                </th>
                                @if (!IsPrintModeActive)
                                {
                                    <th class="inventory-row-actions-column">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var po in PaginatedPurchaseOrders)
                            {
                                <tr @onclick="() => OpenPurchaseOrderDetails(po)" class="@GetPurchaseOrderRowClass(po)">
                                    @if (IsPrintModeActive)
                                    {
                                        <td class="purchase-orders__checkbox-col" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   checked="@SelectedPurchaseOrdersForPrint.Contains(po)"
                                                   @onchange="() => TogglePurchaseOrderForPrintSelection(po)" />
                                        </td>
                                    }
                                    <td>@po.PoNo</td>
                                    <td>@po.Date.ToString("dd/MM/yyyy")</td>
                                    <td><span class="inventory-branch-chip">@po.Branch</span></td>
                                    <td>@po.Vendor</td>

                                    <td>
                                        <span class="purchase-orders__status purchase-orders__status--@po.Status.ToLower().Replace(" ", "-")">
                                            @po.Status
                                        </span>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(po.Remarks) ? "-" : po.Remarks)</td>
                                    @if (!IsPrintModeActive)
                                    {
                                        <td class="inventory-row-actions-column" @onclick:stopPropagation="true">
                                            <button type="button" class="product-row-action" title="View purchase order" aria-label="View purchase order" @onclick="() => ShowPurchaseOrderDetails(po)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button type="button" class="product-row-action" title="Edit purchase order" aria-label="Edit purchase order" @onclick="() => ShowEditPurchaseOrderForm(po)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination CurrentPage="@PurchaseOrdersCurrentPage"
                            ItemsPerPage="5"
                            TotalItems="@FilteredPurchaseOrders.Count()"
                            OnPageChanged="@HandlePurchaseOrdersPageChanged" />
                <div class="pagination-summary">
                    Total items: @FilteredPurchaseOrders.Count()
                </div>
            </div>
        }


        @* Add Purchase Order Modal *@
        @if (IsAddPurchaseOrderFormVisible)
        {
            <div class="po-modal-overlay" @onclick="CloseAddPurchaseOrderForm">
                <div class="po-modal" @onclick:stopPropagation="true">
                    <div class="po-modal__header">
                        <div class="po-modal__title">
                            <i class="bi bi-cart-plus"></i>
                            <h2>@(EditingPurchaseOrder is null ? "Add New Purchase Order" : "Edit Purchase Order")</h2>
                        </div>
                        <div class="po-modal__actions">
                            <button type="button" class="po-modal__btn po-modal__btn--save" @onclick="HandleSavePurchaseOrder">
                                Save
                            </button>
                            <button type="button" class="po-modal__btn po-modal__btn--cancel" @onclick="CloseAddPurchaseOrderForm">
                                Cancel
                            </button>
                        </div>
                    </div>
                    <div class="po-modal__body">
                        <form class="po-form" @onsubmit:preventDefault>
                            <div class="inventory__form-row">
                                <div class="inventory__form-group">
                                    <label>PO No.</label>
                                    <input type="text" @bind="NewPurchaseOrder.PoNo" required />
                                </div>
                                <div class="inventory__form-group">
                                    <label>Date</label>
                                    <input type="date" @bind="NewPurchaseOrder.Date" required />
                                </div>
                            </div>
                            <div class="inventory__form-row">
                                <div class="inventory__form-group">
                                    <label>Branch</label>
                                    <input type="text" @bind="NewPurchaseOrder.Branch" required />
                                </div>
                                <div class="inventory__form-group">
                                    <label>Vendor</label>
                                    <select @bind="NewPurchaseOrder.Vendor" required>
                                        <option value="">Select Vendor</option>
                                        @foreach (var supplier in Suppliers)
                                        {
                                            <option value="@supplier.Name">@supplier.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="inventory__form-row">
                                <div class="inventory__form-group">
                                    <label>PO Type</label>
                                    <select @bind="NewPurchaseOrder.PoType" required>
                                        <option value="">Select PO Type</option>
                                        <option value="Standard">Standard</option>
                                        <option value="Express">Express</option>
                                        <option value="Urgent">Urgent</option>
                                        <option value="Bulk">Bulk</option>
                                    </select>
                                </div>
                                <div class="inventory__form-group">
                                    <label>Product</label>
                                    <select @bind="NewPurchaseOrder.Product" required>
                                        <option value="">Select Product</option>
                                        @foreach (var item in ViewModel.Items)
                                        {
                                            <option value="@item.Type">@item.Type</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="inventory__form-row">
                                <div class="inventory__form-group">
                                    <label>Quantity (UOM2)</label>
                                    <input type="text" @bind="NewPurchaseOrder.Quantity" placeholder="e.g., 10 boxes" required />
                                </div>
                                <div class="inventory__form-group">
                                    <label>Payment Term</label>
                                    <select @bind="NewPurchaseOrder.PaymentTerm" required>
                                        <option value="">Select Payment Term</option>
                                        <option value="Cash">Cash</option>
                                        <option value="Net 30">Net 30</option>
                                        <option value="Net 60">Net 60</option>
                                        <option value="Net 90">Net 90</option>
                                        <option value="COD">COD (Cash on Delivery)</option>
                                        <option value="Credit Card">Credit Card</option>
                                    </select>
                                </div>
                            </div>
                            <div class="inventory__form-row">
                                <div class="inventory__form-group">
                                    <label>Expected Delivery</label>
                                    <input type="date" @bind="NewPurchaseOrder.ExpectedDelivery" required />
                                </div>
                                <div class="inventory__form-group">
                                    <label>Status</label>
                                    <select @bind="NewPurchaseOrder.Status" required>
                                        <option value="Pending">Pending</option>
                                        <option value="Approved">Approved</option>
                                        <option value="Received">Received</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </div>
                            </div>
                            <div class="inventory__form-group">
                                <label>Remarks</label>
                                <textarea @bind="NewPurchaseOrder.Remarks" rows="3" placeholder="Enter remarks..."></textarea>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* View Purchase Order Details Modal *@
        @if (IsPurchaseOrderDetailsVisible && SelectedPurchaseOrder != null)
        {
            <div class="inventory-view-modal-overlay" @onclick="ClosePurchaseOrderDetails">
                <div class="inventory-view-modal" @onclick:stopPropagation="true">
                    <div class="inventory-view-modal__header">
                        <div class="inventory-view-modal__header-left">
                            <div class="inventory-view-modal__icon"><i class="bi bi-receipt"></i></div>
                            <div class="inventory-view-modal__title-group">
                                <h2>Purchase Order Details</h2>
                                <p class="inventory-view-modal__subtitle">Supplier order and delivery information</p>
                            </div>
                        </div>
                        <div class="inventory-view-modal__header-right">
                            <span class="inventory-view-badge inventory-view-badge--@SelectedPurchaseOrder.Status.ToLower().Replace(" ", "-")">@SelectedPurchaseOrder.Status</span>
                            <button type="button" class="inventory-view-modal__close" @onclick="ClosePurchaseOrderDetails" aria-label="Close"><i class="bi bi-x-lg"></i></button>
                        </div>
                    </div>
                    <div class="inventory-view-modal__body">
                        <div class="inventory-view-hero">
                            <div class="inventory-view-hero__item">
                                <span class="inventory-view-hero__label">PO NUMBER</span>
                                <strong class="inventory-view-hero__value">@SelectedPurchaseOrder.PoNo</strong>
                            </div>
                            <div class="inventory-view-hero__divider"></div>
                            <div class="inventory-view-hero__item">
                                <span class="inventory-view-hero__label">ORDER DATE</span>
                                <span class="inventory-view-hero__text"><i class="bi bi-calendar3"></i> @SelectedPurchaseOrder.Date.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="inventory-view-hero__divider"></div>
                            <div class="inventory-view-hero__item">
                                <span class="inventory-view-hero__label">EXPECTED DELIVERY</span>
                                <span class="inventory-view-hero__text"><i class="bi bi-truck"></i> @SelectedPurchaseOrder.ExpectedDelivery.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        <div class="inventory-view-section">
                            <h3 class="inventory-view-section__title"><i class="bi bi-building"></i> Order & Supplier Information</h3>
                            <div class="inventory-view-grid inventory-view-grid--3">
                                <div class="inventory-view-field">
                                    <span class="inventory-view-field__label">Branch</span>
                                    <span class="inventory-view-field__value">@SelectedPurchaseOrder.Branch</span>
                                </div>
                                <div class="inventory-view-field">
                                    <span class="inventory-view-field__label">Supplier / Vendor</span>
                                    <span class="inventory-view-field__value">@SelectedPurchaseOrder.Vendor</span>
                                </div>
                                <div class="inventory-view-field">
                                    <span class="inventory-view-field__label">PO Type</span>
                                    <span class="inventory-view-field__value">@SelectedPurchaseOrder.PoType</span>
                                </div>
                                <div class="inventory-view-field">
                                    <span class="inventory-view-field__label">Payment Term</span>
                                    <span class="inventory-view-field__value">@SelectedPurchaseOrder.PaymentTerm</span>
                                </div>
                                <div class="inventory-view-field">
                                    <span class="inventory-view-field__label">Status</span>
                                    <span class="inventory-view-field__value">
                                        <span class="inventory-view-badge inventory-view-badge--@SelectedPurchaseOrder.Status.ToLower().Replace(" ", "-")">@SelectedPurchaseOrder.Status</span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="inventory-view-section">
                            <h3 class="inventory-view-section__title"><i class="bi bi-box-seam"></i> Item Details</h3>
                            <div class="inventory-view-grid inventory-view-grid--2">
                                <div class="inventory-view-field">
                                    <span class="inventory-view-field__label">Product</span>
                                    <span class="inventory-view-field__value">@SelectedPurchaseOrder.Product</span>
                                </div>
                                <div class="inventory-view-field">
                                    <span class="inventory-view-field__label">Quantity</span>
                                    <span class="inventory-view-field__value font-bold" style="color: #164CA6;">@SelectedPurchaseOrder.Quantity</span>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(SelectedPurchaseOrder.Remarks))
                        {
                            <div class="inventory-view-section">
                                <h3 class="inventory-view-section__title"><i class="bi bi-chat-left-text"></i> Remarks</h3>
                                <div class="inventory-view-remarks">
                                    <p>@SelectedPurchaseOrder.Remarks</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="inventory-view-modal__footer">
                        <button type="button" class="btn-view-secondary" @onclick="ClosePurchaseOrderDetails">Close</button>
                        <button type="button" class="btn-view-primary" @onclick="() => ShowEditPurchaseOrderForm(SelectedPurchaseOrder)">
                            <i class="bi bi-pencil"></i><span>Edit Purchase Order</span>
                        </button>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == "StockRequest")
        {
            <p>Stock Request content will be displayed here.</p>
        }
        else if (ActiveTab == "TransferOrders")
        {
            <div class="stock-transfer">
                <div class="stock-transfer__header">
                    <div class="inventory__toolbar-primary inventory__toolbar-primary--left">
                        <div class="stock-transfer__actions">
                            <button class="tab-btn stock-transfer__action-btn" title="Create Stock Transfer" @onclick="ShowAddTransferForm">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            @if (!IsTransferHistoryPrintModeActive)
                            {
                                <button class="tab-btn stock-transfer__btn-with-text stock-transfer__btn-with-text--light" title="Print transfers" @onclick="ActivateTransferHistoryPrintMode">
                                    <i class="bi bi-printer"></i>
                                    <span>Print</span>
                                </button>
                            }
                            else
                            {
                                <button class="tab-btn stock-transfer__btn-with-text" title="Confirm print" @onclick="PrintTransferHistory" disabled="@(!SelectedTransferHistoryReferencesForPrint.Any())">
                                    <i class="bi bi-check-circle"></i>
                                    <span>Confirm Print</span>
                                </button>
                                <button class="tab-btn stock-transfer__btn-with-text" title="Cancel print" @onclick="CancelTransferHistoryPrintMode">
                                    <i class="bi bi-x-circle"></i>
                                    <span>Cancel</span>
                                </button>
                            }
                        </div>
                        <div class="inventory__search-container">
                            <input class="inventory__search"
                                   type="search"
                                   placeholder="Search reference, branch or status..."
                                   @bind="TransferHistorySearch"
                                   @bind:event="oninput" />
                            <i class="bi bi-search inventory__search-icon"></i>
                        </div>
                    </div>
                    <AdvancedInventoryFilter Columns="@TransferHistoryMultiFilterColumns" OnApply="@HandleTransferHistoryMultiFiltersApplied" OnClear="@HandleTransferHistoryMultiFiltersCleared" ModuleName="Stock Transfer History" ResultCount="@FilteredCombinedHistory.Count()" />
                </div>

                @if (IsStockTransferApiLoading)
                {
                    <div class="inventory__api-message" role="status">Loading stock transfers...</div>
                }

                @if (IsTransferHistoryPrintModeActive)
                {
                    <div class="inventory__delete-bar">
                        <div class="inventory__delete-info">
                            <span>@SelectedTransferHistoryReferencesForPrint.Count transfer(s) selected for print</span>
                        </div>
                    </div>
                }

                <!-- Stock transfer document history. Product lines are shown in transfer details. -->
                <div class="inventory__table-wrapper table-scroll">
                    <div class="table-scroll__inner">
                        <table class="stock-transfer__table resizable-table inventory-mobile-compact-table inventory-mobile-compact-table--stock @(IsTransferHistoryPrintModeActive ? "purchase-orders__table" : string.Empty)">
                            <thead>
                                <tr>
                                    @if (IsTransferHistoryPrintModeActive)
                                    {
                                        <th class="purchase-orders__checkbox-col">Select</th>
                                    }
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "ReferenceNo")' @onclick='() => ToggleTransferHistorySort("ReferenceNo")'>
                                        Reference No<span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "Type")' @onclick='() => ToggleTransferHistorySort("Type")'>
                                        Type<span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "Date")' @onclick='() => ToggleTransferHistorySort("Date")'>
                                        Date<span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "From")' @onclick='() => ToggleTransferHistorySort("From")'>
                                        From<span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "To")' @onclick='() => ToggleTransferHistorySort("To")'>
                                        To<span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "Status")' @onclick='() => ToggleTransferHistorySort("Status")'>
                                        Status<span class="resize-handle"></span>
                                    </th>
                                    @if (!IsTransferHistoryPrintModeActive)
                                    {
                                        <th class="inventory-row-actions-column">Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (!PaginatedCombinedHistory.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="inventory__empty-state">No stock transfer history found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var history in PaginatedCombinedHistory)
                                    {
                                        <tr @onclick="() => HandleTransferHistoryRowClickAsync(history)" class="@GetTransferHistoryRowClass(history)">
                                            @if (IsTransferHistoryPrintModeActive)
                                            {
                                                <td class="purchase-orders__checkbox-col" @onclick:stopPropagation="true">
                                                    <input type="checkbox"
                                                           checked="@SelectedTransferHistoryReferencesForPrint.Contains(history.ReferenceNo)"
                                                           @onchange="() => ToggleTransferHistoryPrintSelection(history.ReferenceNo)" />
                                                </td>
                                            }
                                            <td>@history.ReferenceNo</td>
                                            <td>@history.Type</td>
                                            <td>@history.Date.ToString("dd/MM/yyyy")</td>
                                            <td>@history.From</td>
                                            <td>@history.To</td>
                                            <td>
                                                <span class="stock-transfer__status stock-transfer__status--@history.Status.ToLowerInvariant().Replace(" ", "-")">
                                                    @history.Status
                                                </span>
                                            </td>
                                            @if (!IsTransferHistoryPrintModeActive)
                                            {
                                                <td class="inventory-row-actions-column" @onclick:stopPropagation="true">
                                                    <button type="button" class="product-row-action" title="View transfer details" aria-label="View transfer details" @onclick="() => ShowTransferHistoryDetailsAsync(history)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <Pagination CurrentPage="@StockTransferHistoryCurrentPage"
                            ItemsPerPage="5"
                            TotalItems="@FilteredCombinedHistory.Count()"
                            OnPageChanged="@HandleStockTransferHistoryPageChanged" />
                <div class="pagination-summary">
                    Total items: @FilteredCombinedHistory.Count()
                </div>

                <!-- Restock Modal -->
                @if (ShowRestockModalWindow)
                {
                    <div class="restock-modal-overlay" @onclick="CloseRestockModal">
                        <div class="restock-modal" @onclick:stopPropagation="true">
                            <div class="restock-modal__header">
                                <div class="restock-modal__title">
                                    <i class="bi bi-box-arrow-in-down"></i>
                                    <h2>Restock</h2>
                                </div>
                                <div class="restock-modal__actions">
                                    <button type="button" class="restock-modal__btn restock-modal__btn--save" @onclick="HandleRestock">
                                        Save
                                    </button>
                                    <button type="button" class="restock-modal__btn restock-modal__btn--cancel" @onclick="CloseRestockModal">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                            <div class="restock-modal__body">

                                <form class="restock-form" @onsubmit:preventDefault>
                                    <!-- Branch Restock Form -->
                                    <div class="stock-transfer__form-section">
                                        <h3>Branch Restock Details</h3>
                                        <div class="inventory__form-row">
                                            <div class="inventory__form-group">
                                                <label>Restock Number</label>
                                                <input type="text" @bind="NewRestock.RestockNo" readonly />
                                            </div>
                                            <div class="inventory__form-group">
                                                <label>Date</label>
                                                <input type="date" @bind="NewRestock.RestockDate" required />
                                            </div>
                                        </div>
                                        <div class="inventory__form-row">
                                            <div class="inventory__form-group">
                                                <label>From Branch (Current)</label>
                                                <input type="text" value="@CurrentBranch" readonly />
                                            </div>
                                            <div class="inventory__form-group">
                                                <label>To Branch</label>
                                                <select @bind="NewRestock.ToBranch" required>
                                                    <option value="">Select Branch</option>
                                                    @foreach (var branch in Branches)
                                                    {
                                                        if (branch != CurrentBranch)
                                                        {
                                                            <option value="@branch">@branch</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Product Selection Section -->
                                    <div class="stock-transfer__form-section">
                                        <h3>Select Products to Restock</h3>
                                        <div class="stock-transfer__product-search">
                                            <input type="text"
                                                   placeholder="Search products..."
                                                   @bind="RestockProductSearch"
                                                   @bind:event="oninput" />
                                            <i class="bi bi-search"></i>
                                        </div>
                                        <div class="stock-transfer__product-list">
                                            <table class="stock-transfer__selection-table">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 50px;">Select</th>
                                                        <th>Product Name</th>
                                                        <th>SKU</th>
                                                        <th>Current Stock</th>
                                                        <th>Restock Quantity</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var product in FilteredRestockProducts)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <input type="checkbox"
                                                                       checked="@NewRestock.SelectedProducts.ContainsKey(product.Sku)"
                                                                       @onchange="() => ToggleRestockProductSelection(product)" />
                                                            </td>
                                                            <td>@product.ProductName</td>
                                                            <td>@product.Sku</td>
                                                            <td>@FormatStockCount(product.StockCount) @product.Uom1</td>
                                                            <td>
                                                                @if (NewRestock.SelectedProducts.ContainsKey(product.Sku))
                                                                {
                                                                    <input type="number"
                                                                           min="1"
                                                                           @bind="NewRestock.SelectedProducts[product.Sku]"
                                                                           class="stock-transfer__quantity-input"
                                                                           required />
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
