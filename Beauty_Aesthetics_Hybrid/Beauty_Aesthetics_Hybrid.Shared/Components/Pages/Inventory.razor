                                </div>
                                <div class="returned-modal__actions">
                                    <button type="button" class="returned-modal__btn returned-modal__btn--save" @onclick="HandleEditReturnedStock">
                                        Save Changes
                                    </button>
                                    <button type="button" class="returned-modal__btn returned-modal__btn--cancel" @onclick="CloseEditReturnedStockModal">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                            <div class="returned-modal__body">
                                <form class="returned-form" @onsubmit:preventDefault>
                                    <div class="stock-transfer__form-section">
                                        <h3>Return Details</h3>
                                        <div class="inventory__form-row">
                                            <div class="inventory__form-group">
                                                <label>GIN No</label>
                                                <input type="text" @bind="EditReturnedStock.ReturnedStockNo" readonly />
                                            </div>
                                            <div class="inventory__form-group">
                                                <label>Date Issued</label>
                                                <input type="date" @bind="EditReturnedStock.DateIssued" required />
                                            </div>
                                        </div>
                                        <div class="inventory__form-row">
                                            <div class="inventory__form-group">
                                                <label>Issued By (Branch)</label>
                                                <select @bind="EditReturnedStock.IssuedBy" required>
                                                    <option value="">Select Branch</option>
                                                    <option value="Main Branch">Main Branch</option>
                                                    <option value="Branch A">Branch A</option>
                                                    <option value="Branch B">Branch B</option>
                                                    <option value="Branch C">Branch C</option>
                                                </select>
                                            </div>
                                            <div class="inventory__form-group">
                                                <label>Issued To (Supplier)</label>
                                                <select @bind="EditReturnedStock.IssuedTo" required>
                                                    <option value="">Select Supplier</option>
                                                    @foreach (var supplier in Suppliers)
                                                    {
                                                        <option value="@supplier.Name">@supplier.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="inventory__form-row">
                                            <div class="inventory__form-group">
                                                <label>Status</label>
                                                <select @bind="EditReturnedStock.Status" required>
                                                    <option value="Pending">Pending</option>
                                                    <option value="Completed">Completed</option>
                                                    <option value="In Progress">In Progress</option>
                                                    <option value="Cancelled">Cancelled</option>
                                                </select>
                                            </div>
                                            <div class="inventory__form-group">
                                                <label>UOM</label>
                                                <input type="text" @bind="EditReturnedStock.Uom" placeholder="e.g., Bottles" />
                                            </div>
                                        </div>
                                        <div class="inventory__form-row">
                                            <div class="inventory__form-group">
                                                <label>Total Quantity</label>
                                                <input type="number" min="0" @bind="EditReturnedStock.Quantity" />
                                            </div>
                                            <div class="inventory__form-group">
                                                <label>Total Amount (RM)</label>
                                                <input type="number" step="0.01" min="0" @bind="EditReturnedStock.Amount" />
                                            </div>
                                        </div>
                                        <div class="inventory__form-group">
                                            <label>Reason for Return</label>
                                            <textarea @bind="EditReturnedStock.Reason" rows="3" placeholder="Enter reason for return..."></textarea>
                                        </div>
                                    </div>

                                    <div class="stock-transfer__form-section">

                                        @if (EditReturnedStock.Products.Any())
                                        {
                                            <div class="stock-transfer__form-section">
                                                <h3>Returned Products</h3>
                                                <div class="stock-transfer__table-container">
                                                    <table class="stock-transfer__selection-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Product Name</th>
                                                                <th>SKU</th>
                                                                <th>Quantity</th>
                                                                <th>UOM</th>
                                                                <th>Unit Price (RM)</th>
                                                                <th>Line Amount (RM)</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var product in EditReturnedStock.Products)
                                                            {
                                                                <tr>
                                                                    <td>@product.ProductName</td>
                                                                    <td>@product.Sku</td>
                                                                    <td>@product.Quantity</td>
                                                                    <td>@product.Uom</td>
                                                                    <td>@product.UnitPrice.ToString("N2")</td>
                                                                    <td>@product.LineAmount.ToString("N2")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <p>No products recorded for this return.</p>
                                        }
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                <div class="inventory__table-wrapper table-scroll">
                    <div class="table-scroll__inner">
                        <table class="stock-transfer__table resizable-table inventory-mobile-compact-table inventory-mobile-compact-table--gin @((IsReturnedStockDeleteMode || IsReturnedStockPrintModeActive) ? "inventory-mobile-compact-table--selecting" : string.Empty) @(IsReturnedStockPrintModeActive ? "purchase-orders__table" : string.Empty)">
                            <thead>
                                <tr>
                                    @if (IsReturnedStockDeleteMode)
                                    {
                                        <th class="inventory__checkbox-col">
                                            <input type="checkbox"
                                                   checked="@IsAllReturnedStocksSelected"
                                                   @onchange="ToggleAllReturnedStocksSelection" />
                                        </th>
                                    }
                                    else if (IsReturnedStockPrintModeActive)
                                    {
                                        <th class="purchase-orders__checkbox-col">Select</th>
                                    }
                                    <th class='@GetSortHeaderClass(GINSortColumn, GINSortAscending, "ReturnedStockNo")' @onclick='() => ToggleGINSort("ReturnedStockNo")'>
                                        GIN No<span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetSortHeaderClass(GINSortColumn, GINSortAscending, "DateIssued")' @onclick='() => ToggleGINSort("DateIssued")'>
                                        Date Issued<span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetSortHeaderClass(GINSortColumn, GINSortAscending, "IssuedBy")' @onclick='() => ToggleGINSort("IssuedBy")'>
                                        Issued By<span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetSortHeaderClass(GINSortColumn, GINSortAscending, "IssuedTo")' @onclick='() => ToggleGINSort("IssuedTo")'>
                                        Issued To<span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetSortHeaderClass(GINSortColumn, GINSortAscending, "Quantity")' @onclick='() => ToggleGINSort("Quantity")'>
                                        Quantity (unit)<span class="resize-handle"></span>
                                    </th>
                                    <th class='@GetSortHeaderClass(GINSortColumn, GINSortAscending, "Amount")' @onclick='() => ToggleGINSort("Amount")'>
                                        Amount (RM)
                                    </th>
                                    @if (!IsReturnedStockDeleteMode && !IsReturnedStockPrintModeActive)
                                    {
                                        <th class="inventory-row-actions-column">Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (!PaginatedReturnedStock.Any())
                                {
                                    <tr>
                                        <td colspan="10" style="text-align: center; padding: 2rem; color: #6b7280;">
                                            No GIN records found. Click the + button to add a new GIN.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var returnedStock in PaginatedReturnedStock)
                                    {
                                        <tr @onclick="() => ToggleMobileGinRow(returnedStock)" class="@GetReturnedStockRowClass(returnedStock)">
                                            @if (IsReturnedStockDeleteMode)
                                            {
                                                <td class="inventory__checkbox-col" @onclick:stopPropagation="true">
                                                    <input type="checkbox"
                                                           checked="@SelectedReturnedStocksForDeletion.Contains(returnedStock)"
                                                           @onchange="() => ToggleReturnedStockForDeletion(returnedStock)" />
                                                </td>
                                            }
                                            else if (IsReturnedStockPrintModeActive)
                                            {
                                                <td class="purchase-orders__checkbox-col" @onclick:stopPropagation="true">
                                                    <input type="checkbox"
                                                           checked="@SelectedReturnedStocksForPrint.Contains(returnedStock)"
                                                           @onchange="() => ToggleReturnedStockForPrintSelection(returnedStock)" />
                                                </td>
                                            }
                                            <td>@returnedStock.ReturnedStockNo</td>
                                            <td>@returnedStock.DateIssued.ToString("dd/MM/yyyy")</td>
                                            <td><span class="inventory-branch-chip">@returnedStock.IssuedBy</span></td>
                                            <td>@returnedStock.IssuedTo</td>
                                            <td><span class="inventory-quantity-value">@returnedStock.Quantity @returnedStock.Uom</span></td>
                                            <td><span class="inventory-money-value">RM @returnedStock.Amount.ToString("N2")</span></td>
                                            @if (!IsReturnedStockDeleteMode && !IsReturnedStockPrintModeActive)
                                            {
                                                <td class="inventory-row-actions-column" @onclick:stopPropagation="true">
                                                    <button type="button" class="product-row-action" title="View GIN details" aria-label="View GIN details" @onclick="() => ShowGinDetails(returnedStock)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button type="button" class="product-row-action" title="Edit GIN" aria-label="Edit GIN" @onclick="() => EditReturnedStockFromRow(returnedStock)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                        @if (ExpandedMobileGinNo == returnedStock.ReturnedStockNo && !IsReturnedStockDeleteMode && !IsReturnedStockPrintModeActive)
                                        {
                                            <tr class="inventory-mobile-detail-row">
                                                <td colspan="7">
                                                    <div class="inventory-mobile-details">
                                                        <div class="inventory-mobile-detail"><span>GIN No</span><strong>@returnedStock.ReturnedStockNo</strong></div>
                                                        <div class="inventory-mobile-detail"><span>Date</span><strong>@returnedStock.DateIssued.ToString("dd/MM/yyyy")</strong></div>
                                                        <div class="inventory-mobile-detail"><span>Issued By</span><strong>@returnedStock.IssuedBy</strong></div>
                                                        <div class="inventory-mobile-detail"><span>Issued To</span><strong>@returnedStock.IssuedTo</strong></div>
                                                        <div class="inventory-mobile-detail"><span>Quantity</span><strong>@returnedStock.Quantity @returnedStock.Uom</strong></div>
                                                        <div class="inventory-mobile-detail"><span>Amount</span><strong>RM @returnedStock.Amount.ToString("N2")</strong></div>
                                                        <div class="inventory-mobile-detail"><span>Status</span><strong>@returnedStock.Status</strong></div>
                                                        <div class="inventory-mobile-detail inventory-mobile-detail--wide"><span>Reason</span><strong>@(string.IsNullOrWhiteSpace(returnedStock.Reason) ? "-" : returnedStock.Reason)</strong></div>
                                                        <div class="inventory-mobile-detail-actions">
                                                            <button type="button" @onclick:stopPropagation="true" @onclick="() => ShowGinDetails(returnedStock)">
                                                                <i class="bi bi-eye"></i><span>View Details</span>
                                                            </button>
                                                            <button type="button" @onclick:stopPropagation="true" @onclick="() => EditReturnedStockFromRow(returnedStock)">
                                                                <i class="bi bi-pencil"></i><span>Edit GIN</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <Pagination CurrentPage="@GINCurrentPage"
                            ItemsPerPage="5"
                            TotalItems="@FilteredReturnedStock.Count()"
                            OnPageChanged="@HandleGINPageChanged" />
                <div class="pagination-summary">
                    Total items: @FilteredReturnedStock.Count()
                </div>
            </div>
        }
        else if (ActiveTab == "GRN")
        {
            <div class="grn-section">
                <div class="inventory__toolbar">
                    <div class="inventory__toolbar-primary inventory__toolbar-primary--left">
                        <div class="stock-transfer__actions">
                            <button class="tab-btn stock-transfer__btn-with-text" title="Receive goods from a supplier purchase order" @onclick="ShowAddGRNForm">
                                <i class="bi bi-box-arrow-in-down"></i>
                                <span>Receive goods</span>
                            </button>
                            <button class="btn-delete" title="Delete GRN" @onclick="ToggleGRNDeleteMode">
                                <i class="bi bi-trash3"></i>
                            </button>
                            @if (!IsGRNPrintModeActive)
                            {
                                <button class="tab-btn stock-transfer__btn-with-text stock-transfer__btn-with-text--light" title="Print GRN" @onclick="ActivateGRNPrintMode">
                                    <i class="bi bi-printer"></i>
                                    <span>Print</span>
                                </button>
                            }
                            else
                            {
                                <button class="tab-btn stock-transfer__btn-with-text" title="Confirm Print" @onclick="ConfirmGRNPrint" disabled="@(!SelectedGRNsForPrint.Any())">
                                    <i class="bi bi-check-circle"></i>
                                    <span>Confirm Print</span>
                                </button>
                                <button class="tab-btn stock-transfer__btn-with-text" title="Cancel Print" @onclick="CancelGRNPrintMode">
                                    <i class="bi bi-x-circle"></i>
                                    <span>Cancel</span>
                                </button>
                            }
                            <button class="tab-btn stock-transfer__btn-with-text" title="Export GRN" @onclick="ExportGRN">
                                <i class="bi bi-download"></i>
                                <span>Export</span>
                            </button>
                            <button type="button"
                                    class="tab-btn stock-transfer__btn-with-text incoming-transfer-link"
                                    title="View incoming stock transfers"
                                    @onclick="OpenIncomingStockTransfers">
                                <i class="bi bi-box-arrow-in-down"></i>
                                <span>Incoming transfers</span>
                                @if (PendingStockReceipts.Count > 0)
                                {
                                    <span class="incoming-transfer-link__count">@PendingStockReceipts.Count</span>
                                }
                            </button>
                        </div>
                        <div class="inventory__search-container">
                            <input class="inventory__search"
                                   type="search"
                                   placeholder="Search..."
                                   value="@GRNSearchQuery"
                                   @oninput="OnGRNSearchChanged" />
                            <i class="bi bi-search inventory__search-icon"></i>
                        </div>
                    </div>
                    <AdvancedInventoryFilter Columns="@GRNFilterColumns" OnApply="@HandleGRNFiltersApplied" OnClear="@HandleGRNFiltersCleared" ModuleName="GRN" ResultCount="@FilteredGRNs.Count()" />
                </div>

                @if (IsGRNApiLoading)
                {
                    <div class="inventory__api-message" role="status">Loading GRN records...</div>
                }

                @if (IsGRNDeleteMode)
                {
                    <div class="inventory__delete-bar">
                        <button type="button" class="selected-delete-banner-close" @onclick="CancelGRNDeleteMode" title="Cancel delete mode">
                            <i class="bi bi-x-lg"></i>
                        </button>
                        <div class="inventory__delete-info">
                            <span>@SelectedGRNsForDeletion.Count item(s) selected</span>
                        </div>
                        <div class="inventory__delete-actions">
                            <button class="tab-btn" @onclick="CancelGRNDeleteMode">
                                Cancel
                            </button>
                            <button class="tab-btn tab-btn--danger"
                                    disabled="@(!SelectedGRNsForDeletion.Any())"
                                    @onclick='() => RequestSelectedDeleteConfirmation("grn", SelectedGRNsForDeletion.Count, "GRN record(s)")'>
                                Delete Selected
                            </button>
                        </div>
                    </div>
                }
                else if (IsGRNPrintModeActive)
                {
                    <div class="inventory__delete-bar">
                        <div class="inventory__delete-info">
                            <span>@SelectedGRNsForPrint.Count item(s) selected for print</span>
                        </div>
                    </div>
                }

                <div class="inventory__table-wrapper table-scroll">
                    <div class="table-scroll__inner">
                        <table class="inventory__table resizable-table inventory-mobile-compact-table inventory-mobile-compact-table--grn @((IsGRNDeleteMode || IsGRNPrintModeActive) ? "inventory-mobile-compact-table--selecting" : string.Empty) @(IsGRNPrintModeActive ? "purchase-orders__table" : string.Empty)">
                            <thead>
                                <tr>
                                    @if (IsGRNDeleteMode)
                                    {
                                        <th class="inventory__checkbox-col">
                                            <input type="checkbox"
                                                   checked="@IsAllGRNsSelected"
                                                   @onchange="ToggleAllGRNsSelection" />
                                        </th>
                                    }
                                    else if (IsGRNPrintModeActive)
                                    {
                                        <th class="purchase-orders__checkbox-col">Select</th>
                                    }
                                    @foreach (var column in GRNHeaderColumns)
                                    {
                                        <th class="@GetSortHeaderClass(GRNSortColumn, GRNSortAscending, column.Value)" @onclick="() => ToggleGRNSort(column.Value)">
                                            @column.Label <span class="resize-handle"></span>
                                        </th>
                                    }
                                    @if (!IsGRNDeleteMode && !IsGRNPrintModeActive)
                                    {
                                        <th class="inventory-row-actions-column">Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredGRNs.Any())
                                {
                                    <tr>
                                        <td colspan="7" style="text-align: center; padding: 2rem; color: #6b7280;">
                                            No supplier receipts found. Use Receive goods when a delivery arrives against an approved purchase order.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var grn in PaginatedGRNs)
                                    {
                                        <tr @onclick="() => ToggleMobileGrnRow(grn)" class="@GetGrnRowClass(grn)">
                                            @if (IsGRNDeleteMode)
                                            {
                                                <td class="inventory__checkbox-col" @onclick:stopPropagation="true">
                                                    <input type="checkbox"
                                                           checked="@SelectedGRNsForDeletion.Contains(grn)"
                                                           @onchange="() => ToggleGRNForDeletion(grn)" />
                                                </td>
                                            }
                                            else if (IsGRNPrintModeActive)
                                            {
                                                <td class="purchase-orders__checkbox-col" @onclick:stopPropagation="true">
                                                    <input type="checkbox"
                                                           checked="@SelectedGRNsForPrint.Contains(grn)"
                                                           @onchange="() => ToggleGRNForPrintSelection(grn)" />
                                                </td>
                                            }
                                            <td><span class="inventory-branch-chip">@grn.DOCBranch</span></td>
                                            <td>@grn.Date.ToString("dd/MM/yyyy")</td>
                                            <td>@grn.DOCNo</td>
                                            <td>@grn.SupplierName</td>
                                            <td class="inventory-plain-value">@grn.PONo</td>
                                            <td>@(string.IsNullOrWhiteSpace(grn.ReferenceNumber) ? "-" : grn.ReferenceNumber)</td>
                                            <td><span class="inventory-money-value">@DisplayGrnMoney(grn.TaxAmount, grn.CurrencyId)</span></td>
                                            <td><span class="inventory-money-value">@DisplayGrnMoney(grn.Amount, grn.CurrencyId)</span></td>
                                            <td><span class="inventory-status-badge">@grn.Status</span></td>
                                            @if (!IsGRNDeleteMode && !IsGRNPrintModeActive)
                                            {
                                                <td class="inventory-row-actions-column" @onclick:stopPropagation="true">
                                                    <button type="button" class="product-row-action" title="View GRN details" aria-label="View GRN details" @onclick="() => ShowGrnDetails(grn)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    @if (!grn.IsLocked && !grn.IsVoid)
                                                    {
                                                        <button type="button" class="product-row-action" title="Edit GRN" aria-label="Edit GRN" @onclick="() => EditGRNFromRow(grn)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="product-row-action" title="@(grn.IsVoid ? "GRN is voided" : "GRN is locked")" aria-label="GRN locked" disabled>
                                                            <i class="bi bi-lock"></i>
                                                        </button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                         @if (ExpandedMobileGrnNo == grn.DOCNo && !IsGRNDeleteMode && !IsGRNPrintModeActive)
                                         {
                                             <tr class="inventory-mobile-detail-row">
                                                  <td colspan="10">
                                                     <div class="inventory-mobile-details">
                                                         <div class="inventory-mobile-detail"><span>Branch</span><strong>@grn.DOCBranch</strong></div>
                                                         <div class="inventory-mobile-detail"><span>Date</span><strong>@grn.Date.ToString("dd/MM/yyyy")</strong></div>
                                                         <div class="inventory-mobile-detail"><span>DOC No</span><strong>@grn.DOCNo</strong></div>
                                                         <div class="inventory-mobile-detail"><span>PO No</span><strong>@grn.PONo</strong></div>
                                                         <div class="inventory-mobile-detail inventory-mobile-detail--wide"><span>Supplier</span><strong>@grn.SupplierName</strong></div>
                                                         <div class="inventory-mobile-detail"><span>Reference</span><strong>@(string.IsNullOrWhiteSpace(grn.ReferenceNumber) ? "-" : grn.ReferenceNumber)</strong></div>
                                                         <div class="inventory-mobile-detail"><span>Tax</span><strong>@DisplayGrnMoney(grn.TaxAmount, grn.CurrencyId)</strong></div>
                                                         <div class="inventory-mobile-detail"><span>Amount</span><strong>@DisplayGrnMoney(grn.Amount, grn.CurrencyId)</strong></div>
                                                         <div class="inventory-mobile-detail"><span>Status</span><strong>@grn.Status</strong></div>
                                                         <div class="inventory-mobile-detail-actions">
                                                             <button type="button" @onclick:stopPropagation="true" @onclick="() => ShowGrnDetails(grn)">
                                                                 <i class="bi bi-eye"></i><span>View Details</span>
                                                             </button>
                                                             @if (!grn.IsLocked && !grn.IsVoid)
                                                             {
                                                                 <button type="button" @onclick:stopPropagation="true" @onclick="() => EditGRNFromRow(grn)">
                                                                     <i class="bi bi-pencil"></i><span>Edit GRN</span>
                                                                 </button>
                                                             }
                                                             else
                                                             {
                                                                 <button type="button" disabled title="@(grn.IsVoid ? "GRN is voided" : "GRN is locked")">
                                                                     <i class="bi bi-lock"></i><span>@grn.Status</span>
                                                                 </button>
                                                             }
                                                         </div>
                                                     </div>
                                                 </td>
                                             </tr>
                                         }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <Pagination CurrentPage="@GRNCurrentPage"
                            ItemsPerPage="5"
                            TotalItems="@FilteredGRNs.Count()"
                            OnPageChanged="@HandleGRNPageChanged" />
                <div class="pagination-summary">
                    Total items: @FilteredGRNs.Count()
                </div>

                @* Add/Edit GRN Modal *@
                @if (IsAddGRNFormVisible)
                {
                    <div class="grn-modal-overlay" @onclick="CloseAddGRNForm">
                        <div class="grn-modal" @onclick:stopPropagation="true">
                            <div class="grn-modal__header">
                                <div class="grn-modal__title">
                                    <i class="bi @(IsGRNEditMode ? "bi-pencil-square" : "bi-box-arrow-in-down")"></i>
                                    <div>
                                        <h2>@(IsGRNEditMode ? "Edit Goods Receipt" : "Receive Goods")</h2>
                                        <p>@(IsGRNEditMode ? NewGRNDOCNo : "Against an approved purchase order")</p>
                                    </div>
                                </div>
                                <div class="grn-modal__actions">
                                    <button class="grn-modal__btn grn-modal__btn--save" @onclick="HandleSaveGRN" disabled="@IsGRNApiLoading">
                                        <i class="bi bi-check-lg"></i>
                                        @(IsGRNApiLoading ? "Saving..." : (IsGRNEditMode ? "Update receipt" : "Save receipt"))
                                    </button>
                                    <button class="grn-modal__btn grn-modal__btn--cancel" @onclick="CloseAddGRNForm">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                            <div class="grn-modal__body">
                                <form class="grn-form" @onsubmit:preventDefault>
                                    @if (!string.IsNullOrWhiteSpace(GRNApiError))
                                    {
                                        <div class="inventory__alert inventory__alert--error">@GRNApiError</div>
                                    }

                                    <section class="grn-form__section">
                                        <h3 class="grn-form__section-title">Purchase Order</h3>
                                        <p class="grn-form__helper">Choose the approved PO for this delivery. Supplier and system IDs are filled automatically.</p>
                                        <div class="grn-form__grid">
                                            <div class="grn-form__field grn-form__field--wide">
                                                <label for="grn-po">Purchase Order <span class="inventory__required">*</span></label>
                                                <select id="grn-po" value="@NewGRNPONo" @onchange="HandleGRNPurchaseOrderChanged" disabled="@IsGRNEditMode">
                                                    <option value="">Select approved PO</option>
                                                    @if (!string.IsNullOrWhiteSpace(NewGRNPONo) && !AvailableGRNPurchaseOrders.Any(po => po.PoNo == NewGRNPONo))
                                                    {
                                                        <option value="@NewGRNPONo">@NewGRNPONo</option>
                                                    }
                                                    @foreach (var po in AvailableGRNPurchaseOrders)
                                                    {
                                                        <option value="@po.PoNo">@po.PoNo — @po.Vendor</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="grn-form__field">
                                                <label>Supplier</label>
                                                <input value="@NewGRNSupplier" placeholder="Filled from PO" readonly />
                                            </div>
                                            <div class="grn-form__field">
                                                <label>PO Date</label>
                                                <input value="@(NewGRNPODate?.ToString("dd/MM/yyyy") ?? "—")" readonly />
                                            </div>
                                        </div>
                                    </section>

                                    <section class="grn-form__section">
                                        <h3 class="grn-form__section-title">Receipt Details</h3>
                                        <div class="grn-form__grid">
                                            <div class="grn-form__field">
                                                <label for="grn-branch">Receiving Branch <span class="inventory__required">*</span></label>
                                                <select id="grn-branch" @bind="NewGRNDOCBranch">
                                                    <option value="">Select branch</option>
                                                    @foreach (var branch in StockTransferBranches)
                                                    {
                                                        <option value="@branch.Id">@branch.DisplayName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="grn-form__field">
                                                <label for="grn-date">Receipt Date <span class="inventory__required">*</span></label>
                                                <input id="grn-date" type="date" @bind="NewGRNDate" />
                                            </div>
                                            <div class="grn-form__field grn-form__field--wide">
                                                <label for="grn-reference">Supplier Delivery Note / Invoice No.</label>
                                                <input id="grn-reference" @bind="NewGRNReference" placeholder="Optional supplier reference" />
                                            </div>
                                        </div>
                                    </section>

                                    <section class="grn-form__section">
                                        <h3 class="grn-form__section-title">Item Received</h3>
                                        <p class="grn-form__helper">The item comes from the selected PO. Staff only confirm the quantity and any batch or serial details.</p>
                                        <div class="grn-form__grid">
                                            <div class="grn-form__field grn-form__field--wide">
                                                <label>Item</label>
                                                <input value="@NewGRNName" placeholder="Select a purchase order first" readonly />
                                            </div>
                                            <div class="grn-form__field"><label>SKU</label><input value="@(string.IsNullOrWhiteSpace(NewGRNItemSku) ? "—" : NewGRNItemSku)" readonly /></div>
                                            <div class="grn-form__field"><label>UOM</label><input value="@(string.IsNullOrWhiteSpace(NewGRNUom) ? "—" : NewGRNUom)" readonly /></div>
                                            <div class="grn-form__field">
                                                <label for="grn-quantity">Quantity Received <span class="inventory__required">*</span></label>
                                                <input id="grn-quantity" type="number" min="0.01" step="0.01" @bind="NewGRNReceivedQuantity" />
                                            </div>
                                            <div class="grn-form__field"><label for="grn-batch">Batch No. <span class="grn-form__optional">Optional</span></label><input id="grn-batch" @bind="NewGRNBatchNumber" /></div>
                                            <div class="grn-form__field"><label for="grn-serial">Serial No. <span class="grn-form__optional">Optional</span></label><input id="grn-serial" @bind="NewGRNSerialNumber" /></div>
                                            <div class="grn-form__field grn-form__field--wide"><label for="grn-remarks">Remarks <span class="grn-form__optional">Optional</span></label><textarea id="grn-remarks" @bind="NewGRNRemarks" rows="2" placeholder="Damaged cartons, short delivery, or other notes"></textarea></div>
                                        </div>
                                        <div class="grn-form__system-note">
                                            <i class="bi bi-info-circle"></i>
                                            <span>Accounting fields and API document IDs are handled in the background from the PO and inventory setup.</span>
                                        </div>
                                    </section>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

