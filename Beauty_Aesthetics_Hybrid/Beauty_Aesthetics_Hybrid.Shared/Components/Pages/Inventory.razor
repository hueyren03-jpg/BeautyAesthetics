                                        @foreach (var line in SelectedGinDetails.Products)
                                        {
                                            <tr>
                                                <td class="font-medium">@line.ProductName</td>
                                                <td><code class="inventory-code-badge">@line.Sku</code></td>
                                                <td class="text-right font-bold" style="color: #164CA6;">@line.Quantity @line.Uom</td>
                                                <td class="text-right">RM @line.UnitPrice.ToString("N2")</td>
                                                <td class="text-right font-bold">RM @line.LineAmount.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="inventory-view-empty">
                                <i class="bi bi-box"></i>
                                <p>No item lines recorded for this GIN.</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="inventory-view-modal__footer">
                    <button type="button" class="btn-view-secondary" @onclick="CloseGinDetails">Close</button>
                </div>
            </div>
        </div>
    }

