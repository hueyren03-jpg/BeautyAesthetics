            htmlBuilder.AppendLine(".footer { margin-top: 48px; font-size: 12px; color: #6b7280; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 12px; }");
            htmlBuilder.AppendLine(".page-break { page-break-after: always; height: 40px; }");
            htmlBuilder.AppendLine("@@media print {");
            htmlBuilder.AppendLine("body { padding: 20px; }");
            htmlBuilder.AppendLine(".document { max-width: none; }");
            htmlBuilder.AppendLine(".page-break { height: 0; }");
            htmlBuilder.AppendLine("}");
            htmlBuilder.AppendLine("</style>");
            htmlBuilder.AppendLine("</head><body>");

            for (var index = 0; index < ginItems.Count; index++)
            {
                var gin = ginItems[index];
                var quantityDisplay = !string.IsNullOrWhiteSpace(gin.Uom)
                    ? $"{gin.Quantity} ({gin.Uom})"
                    : gin.Quantity.ToString();

                var productRows = gin.Products != null && gin.Products.Any()
                    ? string.Join(string.Empty, gin.Products.Select(p =>
                        $"<tr><td>{WebUtility.HtmlEncode(p.ProductName)}</td><td>{WebUtility.HtmlEncode(p.Sku)}</td><td>{p.Quantity}</td><td>{WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(p.Uom) ? "-" : p.Uom)}</td><td>{p.UnitPrice:N2}</td><td>{p.LineAmount:N2}</td></tr>"))
                    : "<tr><td colspan='6' style='text-align:center;'>No products recorded.</td></tr>";

                htmlBuilder.AppendLine("<div class='document'>");
                htmlBuilder.AppendLine($"<div class='brand'><div class='brand__name'>Beauty Aesthetics</div><div class='brand__details'><div>www.beautyaesthetics.example</div><div>+60 12-345 6789</div><div>support@@beautyaesthetics.example</div></div></div>");
                htmlBuilder.AppendLine("<div class='title'>Goods Issue Note</div><div class='divider'></div>");
                htmlBuilder.AppendLine("<div class='info-grid'>");
                htmlBuilder.AppendLine($"<div class='info-card'><div class='info-card__label'>GIN No.</div><div class='info-card__value'>{WebUtility.HtmlEncode(gin.ReturnedStockNo)}</div></div>");
                htmlBuilder.AppendLine($"<div class='info-card'><div class='info-card__label'>Date Issued</div><div class='info-card__value'>{gin.DateIssued:dd/MM/yyyy}</div></div>");
                htmlBuilder.AppendLine($"<div class='info-card'><div class='info-card__label'>Issued By</div><div class='info-card__value'>{WebUtility.HtmlEncode(gin.IssuedBy)}</div></div>");
                htmlBuilder.AppendLine($"<div class='info-card'><div class='info-card__label'>Issued To</div><div class='info-card__value'>{WebUtility.HtmlEncode(gin.IssuedTo)}</div></div>");
                htmlBuilder.AppendLine("</div>");

                htmlBuilder.AppendLine("<div class='section-heading'>Summary</div>");
                htmlBuilder.AppendLine("<table class='summary-table'><tbody>");
                htmlBuilder.AppendLine($"<tr><th>Quantity (unit)</th><td>{quantityDisplay}</td></tr>");
                htmlBuilder.AppendLine($"<tr><th>Amount (RM)</th><td>{gin.Amount:N2}</td></tr>");
                htmlBuilder.AppendLine("</tbody></table>");

                htmlBuilder.AppendLine("<div class='section-heading'>Products</div>");
                htmlBuilder.AppendLine("<table><thead><tr><th>Product Name</th><th>SKU</th><th>Quantity</th><th>UOM</th><th>Unit Price (RM)</th><th>Amount (RM)</th></tr></thead><tbody>");
                htmlBuilder.AppendLine(productRows);
                htmlBuilder.AppendLine("</tbody></table>");

                htmlBuilder.AppendLine("<div class='signature-section'>");
                htmlBuilder.AppendLine("<div class='signature-box'><div class='signature-line'></div><div class='signature-label'>Prepared By</div></div>");
                htmlBuilder.AppendLine("<div class='signature-box'><div class='signature-line'></div><div class='signature-label'>Checked By</div></div>");
                htmlBuilder.AppendLine("<div class='signature-box'><div class='signature-line'></div><div class='signature-label'>Approved By</div></div>");
                htmlBuilder.AppendLine("</div>");

                htmlBuilder.AppendLine($"<div class='footer'><div>Generated on: {generatedDate}</div><div>GIN Document â€¢ Confidential</div></div>");
                htmlBuilder.AppendLine("</div>");

                if (index < ginItems.Count - 1)
                {
                    htmlBuilder.AppendLine("<div class='page-break'></div>");
                }
            }

            htmlBuilder.AppendLine("</body></html>");

            await _inventoryModule.InvokeVoidAsync("printHtml", htmlBuilder.ToString());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing GIN batch: {ex.Message}");
        }
    }


    private async Task PrintTransferHistory()
    {
        try
        {
            await EnsureInventoryModuleAsync();

            if (_inventoryModule == null)
            {
                Console.WriteLine("Inventory interop module not loaded; unable to print transfer history.");
                return;
            }

            var historyItems = FilteredCombinedHistory.ToList();

            if (IsTransferHistoryPrintModeActive && SelectedTransferHistoryReferencesForPrint.Any())
            {
                historyItems = historyItems
                    .Where(h => SelectedTransferHistoryReferencesForPrint.Contains(h.ReferenceNo))
                    .ToList();
            }

            if (!historyItems.Any())
            {
                return;
            }

            var generatedDate = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
            var htmlBuilder = new StringBuilder();

            htmlBuilder.AppendLine("<!DOCTYPE html>");
            htmlBuilder.AppendLine("<html><head><title>Transfer History</title>");
            htmlBuilder.AppendLine("<style>");
            
            htmlBuilder.AppendLine(":root {");
            htmlBuilder.AppendLine("--primary: #2c3e50;");
            htmlBuilder.AppendLine("--accent: #728091;");
            htmlBuilder.AppendLine("--border: #d1d5db;");
            htmlBuilder.AppendLine("--text: #1f2937;");
            htmlBuilder.AppendLine("}");
            htmlBuilder.AppendLine("* { box-sizing: border-box; }");
            htmlBuilder.AppendLine("body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; padding: 40px; color: var(--text); background: #fff; }");
            htmlBuilder.AppendLine(".document { max-width: 1000px; margin: 0 auto; }");
            htmlBuilder.AppendLine(".brand { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }");
            htmlBuilder.AppendLine(".brand__name { font-size: 24px; font-weight: 700; color: var(--primary); }");
            htmlBuilder.AppendLine(".brand__details { text-align: right; font-size: 12px; color: #6b7280; }");
            htmlBuilder.AppendLine(".title { text-transform: uppercase; letter-spacing: 2px; color: var(--primary); font-weight: 600; margin-bottom: 8px; }");
            htmlBuilder.AppendLine(".subtitle { font-size: 13px; color: #6b7280; margin-bottom: 20px; }");
            htmlBuilder.AppendLine(".divider { height: 4px; background: linear-gradient(90deg, var(--primary), var(--accent)); margin-bottom: 24px; border-radius: 999px; }");
            htmlBuilder.AppendLine("table { width: 100%; border-collapse: collapse; margin-bottom: 24px; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }");
            htmlBuilder.AppendLine("thead { background: #f1f5f9; }");
            htmlBuilder.AppendLine("th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--border); font-size: 13px; }");
            htmlBuilder.AppendLine("th { font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--primary); }");
            htmlBuilder.AppendLine("tr:last-child td { border-bottom: none; }");
            htmlBuilder.AppendLine(".section-heading { font-size: 16px; font-weight: 600; color: var(--primary); margin: 24px 0 12px; text-transform: uppercase; letter-spacing: 1px; }");
            htmlBuilder.AppendLine(".status-pill { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 500; }");
            htmlBuilder.AppendLine(".status-pill.completed { background-color: #d1fae5; color: #065f46; }");
            htmlBuilder.AppendLine(".status-pill.pending { background-color: #fef3c7; color: #92400e; }");
            htmlBuilder.AppendLine(".status-pill.cancelled { background-color: #fee2e2; color: #b91c1c; }");
            htmlBuilder.AppendLine(".transfer-detail-section { margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border); }");
            htmlBuilder.AppendLine(".transfer-detail-header { font-size: 15px; font-weight: 600; margin-bottom: 4px; color: var(--primary); }");
            htmlBuilder.AppendLine(".transfer-detail-meta { font-size: 12px; color: #6b7280; margin-bottom: 12px; }");
            htmlBuilder.AppendLine(".transfer-items-title { font-size: 13px; font-weight: 600; margin: 0 0 6px; color: var(--text); }");
            htmlBuilder.AppendLine(".transfer-no-items { font-size: 12px; color: #9ca3af; font-style: italic; margin-bottom: 12px; }");
            htmlBuilder.AppendLine(".footer { margin-top: 32px; font-size: 12px; color: #6b7280; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 12px; }");
            htmlBuilder.AppendLine(".page-break { page-break-after: always; height: 40px; }");
            htmlBuilder.AppendLine("@@media print {");
            htmlBuilder.AppendLine("body { padding: 20px; }");
            htmlBuilder.AppendLine(".document { max-width: none; }");
            htmlBuilder.AppendLine(".page-break { height: 0; }");
            htmlBuilder.AppendLine("}");
            htmlBuilder.AppendLine("</style>");
            htmlBuilder.AppendLine("</head><body>");

            htmlBuilder.AppendLine("<div class='document'>");
            htmlBuilder.AppendLine("<div class='title'>Transfer History</div>");
            htmlBuilder.AppendLine($"<div class='subtitle'>Generated on {generatedDate}</div>");

            htmlBuilder.AppendLine("<table><thead><tr><th>Reference No</th><th>Type</th><th>Date</th><th>From</th><th>To</th><th>Status</th></tr></thead><tbody>");

            foreach (var item in historyItems)
            {
                var statusClass = item.Status?.Trim().ToLowerInvariant() switch
                {
                    "completed" => "completed",
                    "cancelled" => "cancelled",
                    _ => "pending"
                };

                htmlBuilder.AppendLine($"<tr><td>{CsvEscape(item.ReferenceNo)}</td><td>{CsvEscape(item.Type)}</td><td>{item.Date:dd/MM/yyyy}</td><td>{CsvEscape(item.From)}</td><td>{CsvEscape(item.To)}</td><td><span class='status-pill {statusClass}'>{CsvEscape(item.Status)}</span></td></tr>");
            }

            htmlBuilder.AppendLine("</tbody></table>");

            var transferLookup = TransferHistory
                .DistinctBy(t => t.TransferNo, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(t => t.TransferNo, t => t, StringComparer.OrdinalIgnoreCase);

            foreach (var item in historyItems)
            {
                transferLookup.TryGetValue(item.ReferenceNo, out var transfer);
                var products = transfer?.Products ?? new List<TransferProductLine>();

                htmlBuilder.AppendLine("<div class='transfer-detail-section'>");
                htmlBuilder.AppendLine($"<div class='transfer-detail-header'>Transfer {CsvEscape(item.ReferenceNo)}</div>");
                htmlBuilder.AppendLine($"<div class='transfer-detail-meta'>Date: {item.Date:dd/MM/yyyy} â€¢ From: {CsvEscape(item.From)} â€¢ To: {CsvEscape(item.To)} â€¢ Status: {CsvEscape(item.Status)}</div>");

                if (products.Any())
                {
                    htmlBuilder.AppendLine("<div class='transfer-items-title'>Items</div>");
                    htmlBuilder.AppendLine("<table><thead><tr><th>Product Name</th><th>SKU</th><th>Quantity</th><th>UOM</th></tr></thead><tbody>");

                    foreach (var line in products)
                    {
                        htmlBuilder.AppendLine($"<tr><td>{CsvEscape(line.ProductName)}</td><td>{CsvEscape(line.Sku)}</td><td>{line.Quantity}</td><td>{CsvEscape(line.Uom)}</td></tr>");
                    }

                    htmlBuilder.AppendLine("</tbody></table>");
                }
                else
                {
                    htmlBuilder.AppendLine("<div class='transfer-no-items'>No transfer item details recorded.</div>");
                }

                htmlBuilder.AppendLine("</div>");
            }

            htmlBuilder.AppendLine("<div class='footer'>Transfer history printout â€¢ Beauty Aesthetics</div>");
            htmlBuilder.AppendLine("</div>");
            htmlBuilder.AppendLine("</body></html>");

            await _inventoryModule.InvokeVoidAsync("printHtml", htmlBuilder.ToString());

            IsTransferHistoryPrintModeActive = false;
            SelectedTransferHistoryReferencesForPrint.Clear();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing transfer history: {ex.Message}");
        }
    }

    private IJSObjectReference? _inventoryModule;
    private bool _inventoryModuleLoadFailed;

    private async Task EnsureInventoryModuleAsync()
    {
        if (_inventoryModule != null || _inventoryModuleLoadFailed)
        {
            return;
        }

        try
        {
            _inventoryModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Beauty_Aesthetics_Hybrid.Shared/js/inventory.js");
        }
        catch (JSException ex)
        {
            _inventoryModuleLoadFailed = true;
            Console.WriteLine($"Error loading inventory interop module: {ex.Message}");
        }
        catch (JSDisconnectedException)
        {
            // Ignore - circuit is disconnected
        }
    }
}
