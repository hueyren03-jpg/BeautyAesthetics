    private IEnumerable<GRNItem> ApplyGRNFilter(IEnumerable<GRNItem> items, MultiTableFilter.FilterData filter)
    {
        if (filter.Column == "Date")
        {
            var start = filter.StartDate?.Date ?? DateTime.MinValue.Date;
            var end = filter.EndDate?.Date ?? DateTime.MaxValue.Date;
            return items.Where(x => x.Date.Date >= start && x.Date.Date <= end);
        }
        return filter.Column switch
        {
            "DOCBranch" => items.Where(x => TextMatches(x.DOCBranch, filter)),
            "DOCNo" => items.Where(x => TextMatches(x.DOCNo, filter)),
            "SupplierName" => items.Where(x => TextMatches(x.SupplierName, filter)),
            "PONo" => items.Where(x => TextMatches(x.PONo, filter)),
            "ReferenceNumber" => items.Where(x => TextMatches(x.ReferenceNumber, filter)),
            "TaxAmount" => items.Where(x => InRange(x.TaxAmount, filter)),
            "Amount" => items.Where(x => InRange(x.Amount, filter)),
            "Status" => items.Where(x => TextMatches(x.Status, filter)),
            _ => items
        };
    }

