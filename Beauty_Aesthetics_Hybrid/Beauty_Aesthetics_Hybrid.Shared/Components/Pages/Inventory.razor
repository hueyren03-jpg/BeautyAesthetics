    private void HandleAddReturnedStock()
    {
        // Calculate total amount and total quantity based on selected products and quantities
        decimal totalAmount = 0;
        int totalQuantity = 0;
        var uomDisplayList = new List<string>();
        var productDetails = new List<ReturnedStockProductLine>();

        foreach (var selectedProduct in NewReturnedStock.SelectedProducts)
        {
            var product = StockTransferProducts.FirstOrDefault(p => p.Sku == selectedProduct.Key);
            if (product != null)
            {
                var productInfo = selectedProduct.Value;
                var selectedUom = productInfo.SelectedUom == "UOM2" && !string.IsNullOrWhiteSpace(product.Uom2)
                    ? product.Uom2
                    : product.Uom1;

                var lineAmount = product.Price * productInfo.Quantity;
                totalAmount += lineAmount;
                totalQuantity += productInfo.Quantity;
                uomDisplayList.Add(selectedUom);

                productDetails.Add(new ReturnedStockProductLine
                {
                    ProductName = productInfo.ProductName,
                    Sku = productInfo.Sku,
                    Quantity = productInfo.Quantity,
                    Uom = selectedUom,
                    UnitPrice = product.Price,
                    LineAmount = lineAmount
                });
            }
        }

        // Create new GIN record
        var newReturnedStock = new ReturnedStockItem
        {
            ReturnedStockNo = NewReturnedStock.ReturnedStockNo,
            DateIssued = NewReturnedStock.DateIssued,
            IssuedBy = NewReturnedStock.IssuedBy,
            IssuedTo = NewReturnedStock.IssuedTo,
            Quantity = totalQuantity,
            Uom = string.Join(", ", uomDisplayList.Distinct()),
            Amount = totalAmount,
            Status = "Pending",
            Reason = NewReturnedStock.Reason,
            Products = productDetails
        };

        ReturnedStockList.Insert(0, newReturnedStock);
        ReturnedStockCounter++;

        // TODO: Update stock counts based on selected products and quantities
        // TODO: Save to database

        CloseAddReturnedStockModal();
    }

