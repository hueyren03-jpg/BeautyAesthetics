    private IEnumerable<StockTransferProduct> ApplyStockTransferFilter(IEnumerable<StockTransferProduct> items, MultiTableFilter.FilterData filter) =>
        filter.Column switch { "ProductName"=>items.Where(x=>TextMatches(x.ProductName,filter)), "Sku"=>items.Where(x=>TextMatches(x.Sku,filter)), "Price"=>items.Where(x=>InRange(x.Price,filter)), "Uom1"=>items.Where(x=>TextMatches(x.Uom1,filter)), "StockCount"=>items.Where(x=>InRange(x.StockCount,filter)), "StockStatus"=>items.Where(x=>TextMatches(x.StockStatus,filter)), _=>items };
    private string GetTransferLineUomType(TransferProductLine line)
    {
        if (line == null || string.IsNullOrWhiteSpace(line.Sku))
        {
            return string.Empty;
        }

        var product = StockTransferProducts.FirstOrDefault(p => p.Sku == line.Sku);
        if (product == null)
        {
            return string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(product.Uom1) &&
            string.Equals(product.Uom1, line.Uom, StringComparison.OrdinalIgnoreCase))
        {
            return "UOM1";
        }

        if (!string.IsNullOrWhiteSpace(product.Uom2) &&
            string.Equals(product.Uom2, line.Uom, StringComparison.OrdinalIgnoreCase))
        {
            return "UOM2";
        }

        return string.Empty;
    }

    private IEnumerable<CombinedHistoryItem> CombinedHistory
    {
        get
        {
            var combined = new List<CombinedHistoryItem>();

            // Add transfers
            foreach (var transfer in TransferHistory)
            {
                combined.Add(new CombinedHistoryItem
                {
                    ReferenceNo = transfer.TransferNo,
                    Type = "Branch Transfer",
                    Date = transfer.DateIssued,
                    From = transfer.IssuedBy,
                    To = transfer.IssuedTo,
                    Status = transfer.Status
                });
            }


            return combined.OrderByDescending(h => h.Date);
        }
    }

    private IEnumerable<string> CombinedHistoryTypes => CombinedHistory.Select(h => h.Type).Distinct(StringComparer.OrdinalIgnoreCase);
    private IEnumerable<string> CombinedHistoryStatuses => CombinedHistory.Select(h => h.Status).Distinct(StringComparer.OrdinalIgnoreCase);
    private IEnumerable<string> CombinedHistoryFroms => CombinedHistory.Select(h => h.From).Distinct(StringComparer.OrdinalIgnoreCase);
    private IEnumerable<string> CombinedHistoryTos => CombinedHistory.Select(h => h.To).Distinct(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<CombinedHistoryItem> FilteredCombinedHistory
    {
        get
        {
            var history = CombinedHistory.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(TransferHistorySearch))
            {
                var search = TransferHistorySearch.Trim();
                history = history.Where(item =>
                    (item.ReferenceNo ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (item.Type ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (item.From ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (item.To ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (item.Status ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            // Apply new MultiTableFilter filters first
            foreach (var filter in ActiveTransferHistoryFilters)
            {
                history = ApplyTransferHistoryFilter(history, filter);
            }

            // Apply existing filters (Type, Status, From, To dropdowns)
            if (!string.IsNullOrWhiteSpace(TransferTypeFilter) && TransferTypeFilter != "All")
            {
                history = history.Where(h => string.Equals(h.Type, TransferTypeFilter, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(TransferStatusFilter) && TransferStatusFilter != "All")
            {
                history = history.Where(h => string.Equals(h.Status, TransferStatusFilter, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(TransferFromFilter) && TransferFromFilter != "All")
            {
                history = history.Where(h => string.Equals(h.From, TransferFromFilter, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(TransferToFilter) && TransferToFilter != "All")
            {
                history = history.Where(h => string.Equals(h.To, TransferToFilter, StringComparison.OrdinalIgnoreCase));
            }
            // Date range from existing filters (keep for backward compatibility)
            if (TransferStartDate.HasValue)
            {
                var start = TransferStartDate.GetValueOrDefault().Date;
                history = history.Where(h => h.Date.Date >= start);
            }
            if (TransferEndDate.HasValue)
            {
                var end = TransferEndDate.GetValueOrDefault().Date;
                history = history.Where(h => h.Date.Date <= end);
            }

            if (!string.IsNullOrEmpty(TransferHistorySortColumn))
            {
                history = TransferHistorySortColumn switch
                {
                    "ReferenceNo" => TransferHistorySortAscending ? history.OrderBy(h => h.ReferenceNo) : history.OrderByDescending(h => h.ReferenceNo),
                    "Type" => TransferHistorySortAscending ? history.OrderBy(h => h.Type) : history.OrderByDescending(h => h.Type),
                    "Date" => TransferHistorySortAscending ? history.OrderBy(h => h.Date) : history.OrderByDescending(h => h.Date),
                    "From" => TransferHistorySortAscending ? history.OrderBy(h => h.From) : history.OrderByDescending(h => h.From),
                    "To" => TransferHistorySortAscending ? history.OrderBy(h => h.To) : history.OrderByDescending(h => h.To),
                    "Status" => TransferHistorySortAscending ? history.OrderBy(h => h.Status) : history.OrderByDescending(h => h.Status),
                    _ => history
                };
            }

            return history;
        }
    }



