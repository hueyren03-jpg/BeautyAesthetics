    private async Task ShowTransferHistoryDetailsAsync(CombinedHistoryItem history)
    {
        StockTransferApiError = null;
        SelectedTransferHistoryItem = history;
        var summary = TransferHistory.FirstOrDefault(transfer => transfer.TransferNo == history.ReferenceNo);
        if (summary is null)
        {
            StockTransferApiError = "Unable to find the selected stock transfer.";
            return;
        }

        SelectedTransferHistoryDetails = summary;
        IsTransferHistoryDetailsVisible = true;

        if (string.IsNullOrWhiteSpace(summary.DocumentId))
        {
            return;
        }

        var result = await StockTransferSvc.LoadTransferAsync(summary.DocumentId);
        if (!result.Success || result.Value is null)
        {
            StockTransferApiError = result.ErrorMessage ?? "Unable to load stock transfer details.";
            return;
        }

        var loaded = ToTransferHistoryItem(result.Value);
        var index = TransferHistory.IndexOf(summary);
        if (index >= 0)
        {
            TransferHistory[index] = loaded;
        }

        SelectedTransferHistoryDetails = loaded;
    }

