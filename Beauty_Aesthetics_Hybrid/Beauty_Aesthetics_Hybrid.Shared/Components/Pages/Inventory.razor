    private static string CsvEscape(string value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
        {
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        }
        return value;
    }

    private async Task PrintGRN(IEnumerable<GRNItem> itemsToPrint)
    {
        var grnItems = itemsToPrint.ToList();
        if (!grnItems.Any()) return;
        await EnsureInventoryModuleAsync();
        if (_inventoryModule == null) return;

        var htmlBuilder = new StringBuilder();
        htmlBuilder.AppendLine("<!DOCTYPE html><html><head><meta charset='utf-8'/><title>GRN Printout</title></head><body>");
        htmlBuilder.AppendLine("<h2>Goods Received Notes (GRN)</h2>");

        foreach (var grn in grnItems)
        {
            htmlBuilder.AppendLine("<div class='grn-card'>");
            htmlBuilder.AppendLine($"<div>GRN: {CsvEscape(grn.DOCNo)} | Branch: {CsvEscape(grn.DOCBranch)} | Date: {grn.Date:dd/MM/yyyy}</div>");
            htmlBuilder.AppendLine($"<div>Supplier: {CsvEscape(grn.SupplierName)} | PO No: {CsvEscape(grn.PONo)} | Reference: {CsvEscape(grn.ReferenceNumber)}</div>");
            htmlBuilder.AppendLine($"<div>Tax: {grn.TaxAmount:N2} | Total: {grn.Amount:N2} | Status: {grn.Status}</div>");
            htmlBuilder.AppendLine("</div>");
        }

        htmlBuilder.AppendLine("</body></html>");

        try
        {
            await _inventoryModule.InvokeVoidAsync("printHtml", htmlBuilder.ToString());
            IsGRNPrintModeActive = false;
            SelectedGRNsForPrint.Clear();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing GRN batch: {ex.Message}");
        }
    }


