    private async Task HandleSaveGRN()
    {
        GRNApiError = null;

        if (string.IsNullOrWhiteSpace(NewGRNPONo))
        {
            GRNApiError = "Select a purchase order.";
            return;
        }

        if (!IsGRNEditMode && !AvailableGRNPurchaseOrders.Any(po =>
                string.Equals(po.PoNo, NewGRNPONo, StringComparison.OrdinalIgnoreCase)))
        {
            GRNApiError = "Select an approved purchase order.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NewGRNName))
        {
            GRNApiError = "Select an inventory item.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NewGRNInventoryId))
        {
            GRNApiError = "The PO item is not linked to an inventory record. Ask an administrator to check the item setup.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NewGRNUom))
        {
            GRNApiError = "The PO item does not have a unit of measure. Ask an administrator to check the item setup.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NewGRNDOCBranch))
        {
            GRNApiError = "Select a receiving branch.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NewGRNTransactionCurrencyId) || NewGRNExchangeRate <= 0)
        {
            GRNApiError = "The PO has incomplete currency information. Ask an administrator to check the purchase order.";
            return;
        }

        if (NewGRNReceivedQuantity <= 0)
        {
            GRNApiError = "Received quantity must be greater than zero.";
            return;
        }

        IsGRNApiLoading = true;

        try
        {
            if (!IsGRNEditMode)
            {
                NewGRNPostingDate = NewGRNDate;
            }

            var grn = new StockGrnViewModel
            {
                DocumentId = SelectedGRN?.DocumentId ?? string.Empty,
                BranchId = NewGRNDOCBranch,
                Date = NewGRNDate,
                PostingDate = NewGRNPostingDate,
                IsPostingDateDifferent = NewGRNPostingDate.Date != NewGRNDate.Date,
                DisplayCode = NewGRNDOCNo,
                AccountId = NewGRNAccountId,
                AccountName = NewGRNSupplier,
                PODisplayCode = NewGRNPONo,
                PODocumentId = NewGRNPODocumentId,
                OrderBranchId = NewGRNOrderBranchId,
                PaymentTermId = NewGRNPaymentTermId,
                PaymentTermName = NewGRNPaymentTermName,
                ReferenceNumber = NewGRNReference,
                PODate = NewGRNPODate,
                Remarks = NewGRNRemarks,
                ItemName = NewGRNName,
                ItemSku = NewGRNItemSku,
                InventoryId = NewGRNInventoryId,
                Uom = NewGRNUom,
                OrderDocumentLineId = NewGRNOrderDocumentLineId,
                SourceDocumentLineId = NewGRNSourceDocumentLineId,
                InventoryTypeId = NewGRNInventoryTypeId,
                ReceivedQuantity = NewGRNReceivedQuantity,
                UnitPrice = NewGRNUnitPrice,
                Amount = CalculatedGRNAmount,
                TransactionCurrencyId = NewGRNTransactionCurrencyId,
                LocalCurrencyId = NewGRNLocalCurrencyId,
                ExchangeRate = NewGRNExchangeRate,
                TaxTypeId = NewGRNTaxTypeId,
                TaxCodeId = NewGRNTaxCodeId,
                GstTypeId = NewGRNGstTypeId,
                TaxPercentage = NewGRNTaxPercentage,
                TaxAmount = CalculatedGRNTaxAmount,
                RoundingAmount = NewGRNRoundingAmount,
                IsTaxInclusive = NewGRNIsTaxInclusive,
                BatchNumber = NewGRNBatchNumber,
                SerialNumber = NewGRNSerialNumber,
                StockActivityType = NewGRNStockActivityType
            };

            var result = IsGRNEditMode
                ? await StockGrnService.UpdateGrnAsync(grn)
                : await StockGrnService.CreateGrnAsync(grn);

            if (!result.Success)
            {
                GRNApiError = result.ErrorMessage ?? "Unable to save GRN.";
                return;
            }

            CloseAddGRNForm();
            await LoadGRNsAsync();
        }
        finally
        {
            IsGRNApiLoading = false;
        }
    }

