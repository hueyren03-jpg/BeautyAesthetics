@page "/inventory"
@using System
@using System.Threading.Tasks
@using Beauty_Aesthetics_WebPos
@using Beauty_Aesthetics_WebPos.Components.Layout
@layout MainLayout
@using Beauty_Aesthetics_WebPos.Components.ViewModels
@using Beauty_Aesthetics_WebPos.Components.Services.Inventory
@using Beauty_Aesthetics_WebPos.Components.Services.Branches
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using System.Text
@using System.Net
@using System.Linq
@using System.IO
@using System.Globalization
@using ClosedXML.Excel
@inject IJSRuntime JSRuntime
@inject IProductInventoryService ProductInventoryService
@inject IInventoryOptionService InventoryOptionService
@inject IStockGrnService StockGrnService
@inject IStockTransferService StockTransferSvc
@inject IInventoryPendingAcceptService PendingStockReceiptService
@inject IBranchLookupService BranchLookupService
@inject IBranchSessionService BranchSession
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<PageTitle>@L["Inventory"]</PageTitle>

<section class="inventory">
    <header class="inventory__header">
        <h1>
            @L["Inventory"]
            <i class="bi bi-info-circle"
               data-bs-toggle="tooltip"
               data-bs-placement="right"
               title="@L["TrackCurrentStock"]"></i>
            <div class="inventory__dropdown-container">
                <button class="inventory__dropdown-toggle" @onclick="ToggleImportExportDropdown" title="@L["ImportExportOptions"]">
                    <i class="bi bi-chevron-down @(ShowImportExportDropdown ? "rotated" : "")"></i>
                </button>
                @if (ShowImportExportDropdown)
                {
                    <div class="inventory__dropdown-backdrop" @onclick="CloseImportExportDropdown"></div>
                    <div class="inventory__dropdown-menu">
                        <button class="inventory__dropdown-btn" @onclick="ImportInventoryItems">
                            <i class="bi bi-upload"></i>
                            @L["ImportInventoryItem"]
                        </button>
                        <button class="inventory__dropdown-btn" @onclick="ExportInventoryItems">
                            <i class="bi bi-download"></i>
                            @L["ExportInventoryItem"]
                        </button>
                        <button class="inventory__dropdown-btn" @onclick="GetImportTemplate">
                            <i class="bi bi-file-earmark-text"></i>
                            @L["GetImportTemplate"]
                        </button>
                        <button class="inventory__dropdown-btn" @onclick="UpdateFromExcel">
                            <i class="bi bi-file-earmark-excel"></i>
                            @L["UpdateFromExcel"]
                        </button>
                    </div>
                }
            </div>
        </h1>
    </header>

    <InputFile id="inventoryImportFileInput"
               style="display:none"
               OnChange="HandleImportFileSelected"
               accept=".csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />

    <InputFile id="inventoryUpdateFileInput"
               style="display:none"
               OnChange="HandleUpdateFileSelected"
               accept=".csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />

    <nav class="inventory__menu desktop-view">
        <button class="inventory__menu-item @(ActiveTab == "Products" ? "active" : "")"
                @onclick='() => SetActiveTab("Products")'>
            @L["Products"]
        </button>
        <button class="inventory__menu-item @(ActiveTab == "InventoryOptions" ? "active" : "")"
                @onclick='() => SetActiveTab("InventoryOptions")'>
            @L["InventoryOptions"]
        </button>
        <button class="inventory__menu-item @(ActiveTab == "PurchaseOrders" ? "active" : "")"
                @onclick='() => SetActiveTab("PurchaseOrders")'>
            @L["PurchaseOrders"]
        </button>
        <button class="inventory__menu-item @(ActiveTab == "TransferOrders" ? "active" : "")"
                @onclick='() => SetActiveTab("TransferOrders")'>
            @L["StockTransfer"]
        </button>
        <button class="inventory__menu-item @(ActiveTab == "ReturnedStock" ? "active" : "")"
                @onclick='() => SetActiveTab("ReturnedStock")'>
            @L["GIN"]
        </button>
        <button class="inventory__menu-item @(ActiveTab == "GRN" ? "active" : "")"
                @onclick='() => SetActiveTab("GRN")'>
            @L["GRN"]
        </button>
    </nav>

    <div class="inventory__tab-selector-container mobile-view">
        <select class="inventory__tab-select" @onchange="OnTabSelectChanged" value="@ActiveTab">
            <option value="Products">@L["Products"]</option>
            <option value="InventoryOptions">@L["InventoryOptions"]</option>
            <option value="PurchaseOrders">@L["PurchaseOrders"]</option>
            <option value="TransferOrders">@L["StockTransfer"]</option>
            <option value="ReturnedStock">@L["GIN"]</option>
            <option value="GRN">@L["GRN"]</option>
        </select>
    </div>

    <div class="inventory__content">
        @if (ActiveTab == "Products")
        {
            <div class="inventory__toolbar">
                <div class="inventory__toolbar-primary">
                    <div class="inventory__action-buttons">
                        <button class="tab-btn inventory__action-btn" title="Add Product" @onclick="ShowAddProductForm">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                        <button class="btn-delete" title="Delete Products" @onclick="ToggleDeleteMode">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                    <div class="inventory__search-container">
                        <input class="inventory__search"
                               type="search"
                               placeholder="Search..."
                               value="@ProductSearchQuery"
                               @oninput="OnProductSearchChanged" />
                        <i class="bi bi-search inventory__search-icon"></i>
                    </div>
                </div>
                <AdvancedInventoryFilter Columns="@ProductFilterColumns" OnApply="@HandleProductFiltersApplied" OnClear="@HandleProductFiltersCleared" ModuleName="Products" ResultCount="@FilteredItems.Count()" />
            </div>

            @if (IsProductApiLoading)
            {
                <div class="inventory__api-message">Loading products...</div>
            }

            @if (IsDeleteMode)
            {
                <div class="inventory__delete-bar">
                    <button type="button" class="selected-delete-banner-close" @onclick="CancelDeleteMode" title="Cancel delete mode">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <div class="inventory__delete-info">
                        <span>@SelectedItemsForDeletion.Count item(s) selected</span>
                    </div>
                    <div class="inventory__delete-actions">
                        <button class="inventory__btn inventory__btn--secondary" @onclick="CancelDeleteMode">
                            Cancel
                        </button>
                        <button class="inventory__btn inventory__btn--danger" @onclick='() => RequestSelectedDeleteConfirmation("products", SelectedItemsForDeletion.Count, "product(s)")' disabled="@(!SelectedItemsForDeletion.Any())">
                            Delete Selected
                        </button>
                    </div>
                </div>
            }

            @if (ShowAddForm)
            {
                <div class="product-modal-overlay" @onclick="CloseAddProductForm">
                    <div class="product-modal" @onclick:stopPropagation="true">
                        <div class="product-modal__header">
                            <div class="product-modal__title">
                                <i class="bi bi-plus-circle"></i>
                                <h2>Add New Product</h2>
                            </div>
                            <div class="product-modal__actions">
                                <button type="button" class="product-modal__btn product-modal__btn--save" @onclick="HandleAddProduct">
                                    Save
                                </button>
                                <button type="button" class="product-modal__btn product-modal__btn--cancel" @onclick="CloseAddProductForm">
                                    Cancel
                                </button>
                            </div>
                        </div>
                        <div class="product-modal__body">
                            <form class="product-form" @onsubmit:preventDefault>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>SKU</label>
                                        <input type="text" @bind="NewProduct.Sku" required />
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Product Name</label>
                                        <input type="text" @bind="NewProduct.Type" required />
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Barcode</label>
                                        <input type="text" @bind="NewProduct.Barcode" required />
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Conversion Factor</label>
                                        <input type="text" @bind="NewProduct.ConversionFactor" placeholder="e.g., 1 box = 10 bottles" required />
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Price (MYR)</label>
                                        <input type="number" step="0.01" @bind="NewProduct.Price" required />
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Brand</label>
                                        <select @bind="NewProduct.Brand" required>
                                            <option value="">Select Brand</option>
                                            @foreach (var brand in Brands)
                                            {
                                                <option value="@brand.Name">@brand.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Category</label>
                                        <select @bind="NewProduct.Category" required>
                                            <option value="">Select Category</option>
                                            @foreach (var category in Categories)
                                            {
                                                <option value="@category.Name">@category.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Supplier</label>
                                        <select @bind="NewProduct.Supplier" required>
                                            <option value="">Select Supplier</option>
                                            @foreach (var supplier in Suppliers)
                                            {
                                                <option value="@supplier.Name">@supplier.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Locked</label>
                                        <select @bind="NewProduct.Locked">
                                            <option value="false">No</option>
                                            <option value="true">Yes</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Stock (UOM1)</label>
                                        <input type="text" @bind="NewProduct.StockUom1" placeholder="e.g., 240 bottles" required />
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Stock (UOM2)</label>
                                        <input type="text" @bind="NewProduct.StockUom2" placeholder="e.g., 24 boxes" required />
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Location</label>
                                        <input type="text" @bind="NewProduct.Location" required />
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Low Alert Count</label>
                                        <input type="text" @bind="NewProduct.LowAlertCount" placeholder="e.g., 50 bottles" required />
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Discount Cap</label>
                                        <input type="number" step="0.01" @bind="NewProduct.DiscountCap" required />
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @if (ShowEditForm && EditProduct != null)
            {
                <div class="product-modal-overlay" @onclick="CloseEditProductForm">
                    <div class="product-modal" @onclick:stopPropagation="true">
                        <div class="product-modal__header">
                            <div class="product-modal__title">
                                <i class="bi bi-pencil-square"></i>
                                <h2>Edit Product</h2>
                            </div>
                            <div class="product-modal__actions">
                                <button type="button" class="product-modal__btn product-modal__btn--save" @onclick="HandleEditProduct">
                                    Save
                                </button>
                                <button type="button" class="product-modal__btn product-modal__btn--cancel" @onclick="CloseEditProductForm">
                                    Cancel
                                </button>
                            </div>
                        </div>
                        <div class="product-modal__body">
                            <form class="product-form" @onsubmit:preventDefault>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Product Name</label>
                                        <input type="text" @bind="EditProduct.Type" required />
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>SKU</label>
                                        <input type="text" @bind="EditProduct.Sku" required />
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Barcode</label>
                                        <input type="text" @bind="EditProduct.Barcode" required />
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Price (MYR)</label>
                                        <input type="number" step="0.01" @bind="EditProduct.Price" required />
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Brand</label>
                                        <select @bind="EditProduct.Brand" required>
                                            <option value="">Select Brand</option>
                                            @foreach (var brand in Brands)
                                            {
                                                <option value="@brand.Name">@brand.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Category</label>
                                        <select @bind="EditProduct.Category" required>
                                            <option value="">Select Category</option>
                                            @foreach (var category in Categories)
                                            {
                                                <option value="@category.Name">@category.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Supplier</label>
                                        <select @bind="EditProduct.Supplier" required>
                                            <option value="">Select Supplier</option>
                                            @foreach (var supplier in Suppliers)
                                            {
                                                <option value="@supplier.Name">@supplier.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Conversion Factor</label>
                                        <input type="text" @bind="EditProduct.ConversionFactor" placeholder="e.g., 1 box = 10 bottles" required />
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>UOM 1</label>
                                        <input type="text" @bind="EditProduct.StockUom1" placeholder="e.g., UNIT" required />
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>UOM 2</label>
                                        <input type="text" @bind="EditProduct.StockUom2" placeholder="Optional secondary UOM" />
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Current Stock</label>
                                        <input class="inventory__readonly-field" type="text" value="@GetProductStockDisplay(EditProduct)" readonly />
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Location</label>
                                        <input type="text" @bind="EditProduct.Location" required />
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>Low Alert Count</label>
                                        <input type="text" @bind="EditProduct.LowAlertCount" placeholder="e.g., 50 bottles" required />
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Discount Cap</label>
                                        <input type="number" step="0.01" @bind="EditProduct.DiscountCap" required />
                                    </div>
                                </div>
                                <div class="inventory__form-row">
                                    <div class="inventory__form-group">
                                        <label>IsLocked</label>
                                        <select @bind="EditProduct.Locked">
                                            <option value="false">No</option>
                                            <option value="true">Yes</option>
                                        </select>
                                    </div>
                                    <div class="inventory__form-group">
                                        <label>Record ID</label>
                                        <input class="inventory__readonly-field" type="text" value="@DisplayProductValue(EditProduct.MasterAccountId)" readonly />
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            <div class="inventory__table-wrapper product-table-shell desktop-view">
                <table class="inventory__table inventory-products-desktop-table">
                    <colgroup>
                        @if (IsDeleteMode)
                        {
                            <col class="product-compact-col-select" />
                        }
                        <col class="product-compact-col-name" />
                        <col class="product-compact-col-sku" />
                        <col class="product-compact-col-category" />
                        <col class="product-compact-col-price" />
                        <col class="product-compact-col-stock" />
                        <col class="product-compact-col-status" />
                        <col class="product-compact-col-actions" />
                    </colgroup>
                    <thead>
                        <tr>
                            @if (IsDeleteMode)
                            {
                                <th class="inventory__checkbox-col">
                                    <input type="checkbox"
                                           checked="@IsAllSelected"
                                           @onchange="ToggleSelectAll" />
                                </th>
                            }
                            <th class='@GetSortHeaderClass(SortColumn, SortAscending, "Type")' @onclick='() => ToggleSort("Type")'>Product</th>
                            <th class='@GetSortHeaderClass(SortColumn, SortAscending, "Sku")' @onclick='() => ToggleSort("Sku")'>SKU</th>
                            <th class='@GetSortHeaderClass(SortColumn, SortAscending, "Category")' @onclick='() => ToggleSort("Category")'>Category</th>
                            <th class='@GetSortHeaderClass(SortColumn, SortAscending, "Price")' @onclick='() => ToggleSort("Price")'>Price</th>
                            <th class='@GetSortHeaderClass(SortColumn, SortAscending, "StockQuantity")' @onclick='() => ToggleSort("StockQuantity")'>Stock</th>
                            <th class='@GetSortHeaderClass(SortColumn, SortAscending, "StockStatus")' @onclick='() => ToggleSort("StockStatus")'>Stock Status</th>
                            <th class="product-actions-heading">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!PaginatedItems.Any())
                        {
                            <tr>
                                <td colspan="@(IsDeleteMode ? 8 : 7)" class="product-table-empty">
                                    No products found. Click the + button to add a new product.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in PaginatedItems)
                            {
                                <tr @onclick="() => HandleRowClick(item)" class="@(SelectedItem == item && !IsDeleteMode ? "selected" : string.Empty)">
                                    @if (IsDeleteMode)
                                    {
                                        <td class="inventory__checkbox-col" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   checked="@SelectedItemsForDeletion.Contains(item)"
                                                   @onchange="() => ToggleItemSelection(item)" />
                                        </td>
                                    }
                                    <td class="product-primary-cell">
                                        <strong title="@item.Type">@DisplayProductValue(item.Type)</strong>
                                        <span title="@item.Brand">@DisplayProductValue(item.Brand)</span>
                                    </td>
                                    <td class="product-ellipsis-cell" title="@item.Sku">@DisplayProductValue(item.Sku)</td>
                                    <td class="product-ellipsis-cell" title="@item.Category">@DisplayProductValue(item.Category)</td>
                                    <td class="product-price-cell">MYR @item.Price.ToString("N2")</td>
                                    <td class="product-stock-cell">@GetProductStockDisplay(item)</td>
                                    <td>
                                        <span class="product-stock-badge product-stock-badge--@GetProductStockStatusClass(item)">
                                            @GetProductStockStatus(item)
                                        </span>
                                    </td>
                                    <td class="product-row-actions" @onclick:stopPropagation="true">
                                        <button type="button" class="product-row-action" title="View product details" aria-label="View product details" @onclick="() => ShowProductDetails(item)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="product-row-action" title="Edit product" aria-label="Edit product" @onclick="() => EditProductFromTable(item)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="inventory__table-wrapper table-scroll mobile-view">
                <table class="inventory__table products__table resizable-table">
                    <colgroup>
                        @if (IsDeleteMode)
                        {
                            <col class="product-col-select" />
                        }
                        <col class="product-col-sku" />
                        <col class="product-col-name" />
                    </colgroup>
                    <thead>
                        <tr>
                            @if (IsDeleteMode)
                            {
                                <th class="inventory__checkbox-col">
                                    <input type="checkbox"
                                           checked="@IsAllSelected"
                                           @onchange="ToggleSelectAll" />
                                </th>
                            }
                            <th class='@GetSortHeaderClass(SortColumn, SortAscending, "Sku")' @onclick="@(() => ToggleSort("Sku"))">
                                SKU <span class="resize-handle"></span>
                            </th>
                            <th class='@GetSortHeaderClass(SortColumn, SortAscending, "Type")' @onclick="@(() => ToggleSort("Type"))">
                                Product Name <span class="resize-handle"></span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!PaginatedItems.Any())
                        {
                            <tr>
                                <td colspan="@(IsDeleteMode ? 3 : 2)" style="text-align: center; padding: 2rem; color: #6b7280;">
                                    No products found. Click the + button to add a new product.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in PaginatedItems)
                            {
                                <tr @onclick="() => OpenMobileProductDetails(item)" class="@(SelectedItem == item && !IsDeleteMode ? "selected" : string.Empty)">
                                    @if (IsDeleteMode)
                                    {
                                        <td class="inventory__checkbox-col" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   checked="@SelectedItemsForDeletion.Contains(item)"
                                                   @onchange="() => ToggleItemSelection(item)" />
                                        </td>
                                    }
                                    <td>@item.Sku</td>
                                    <td>@item.Type</td>
                                </tr>

                            }
                        }
                    </tbody>
                </table>
            </div>

            <Pagination CurrentPage="@ProductsCurrentPage"
                        ItemsPerPage="5"
                        TotalItems="@FilteredItems.Count()"
                        OnPageChanged="@HandleProductsPageChanged" />
            <div class="pagination-summary">
                Total items: @FilteredItems.Count()
            </div>

        }
        else if (ActiveTab == "InventoryOptions")
        {
            <div class="inventory-options">
                <div class="inventory-options__grid">
                    <!-- Brands Card -->
                    <div class="inventory-options__card">
                        <div class="inventory-options__card-header">
                            <h3>Brands</h3>
                            <div class="inventory-options__header-actions">
                                <button class="tab-btn stock-transfer__action-btn" @onclick="ShowAddBrandForm">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                                <button class="tab-btn stock-transfer__action-btn btn-delete" @onclick="ToggleBrandDeleteMode" title="Delete Brands">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                        <div class="inventory-options__card-body">
                            @if (IsBrandDeleteMode)
                            {
                                <div class="inventory-options__delete-bar">
                                    <button type="button" class="selected-delete-banner-close" @onclick="CancelBrandDeleteMode" title="Cancel delete mode">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <div class="inventory-options__delete-info">
                                        <span>@SelectedBrandsForDeletion.Count item(s) selected</span>
                                    </div>
                                    <div class="inventory-options__delete-actions">
                                        <button class="inventory__btn inventory__btn--secondary" @onclick="CancelBrandDeleteMode">
                                            Cancel
                                        </button>
                                        <button class="inventory__btn inventory__btn--danger" @onclick='() => RequestSelectedDeleteConfirmation("brands", SelectedBrandsForDeletion.Count, "brand(s)")' disabled="@(!SelectedBrandsForDeletion.Any())">
                                            Delete Selected
                                        </button>
                                    </div>
                                </div>
                            }
                            <div class="inventory-options__search">
                                <input type="text" placeholder="Search..." value="@BrandSearch" @oninput="(ChangeEventArgs e) => { BrandSearch = e.Value?.ToString() ?? string.Empty; BrandsCurrentPage = 1; }" />
                            </div>
                            <table class="inventory-options__table">
                                <thead>
                                    <tr>
                                        @if (IsBrandDeleteMode)
                                        {
                                            <th class="inventory-options__checkbox-col">
                                                <input type="checkbox" @onchange="ToggleSelectAllBrands" checked="@IsAllBrandsSelected" />
                                            </th>
                                        }
                                        <th class='@GetSortHeaderClass(BrandSortColumn, BrandSortAscending, "Name")' @onclick="@(() => ToggleBrandSort("Name"))">
                                            Name
                                        </th>
