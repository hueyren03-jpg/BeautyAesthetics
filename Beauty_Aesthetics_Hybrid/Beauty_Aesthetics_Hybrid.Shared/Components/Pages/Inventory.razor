    private async Task HandleEditCategory()
    {
        if (IsCategorySaving)
        {
            return;
        }

        var categoryId = EditCategoryId.Trim();
        var categoryName = EditCategoryName.Trim();
        var externalCode = EditCategoryExternalCode.Trim();

        if (string.IsNullOrWhiteSpace(categoryId))
        {
            CategoryApiError = "Category id is missing.";
            return;
        }

        if (string.IsNullOrWhiteSpace(categoryName))
        {
            CategoryApiError = "Category name is required.";
            return;
        }

        IsCategorySaving = true;
        CategoryApiError = null;

        try
