@page "/profile"
@namespace Beauty_Aesthetics_WebPos.Components.Pages
@using System.Globalization
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject AppFeedbackService Feedback

<div class="container py-4">
    <h1 class="mb-3">@L["Profile"]</h1>

    <div class="card shadow-sm" style="max-width: 560px;">
        <div class="card-body">
            <div class="mb-2 fw-semibold">@L["Language"]</div>
            <select class="form-select" @bind="selectedCulture">
                <option value="en">@L["English"]</option>
                <option value="zh-Hans">@L["Chinese"]</option>
                <option value="ms">@L["Malay"]</option>
            </select>

            <div class="mt-3 d-flex align-items-center gap-2">
                <button class="btn btn-primary" @onclick="SaveCulture">@L["Save"]</button>
            </div>
        </div>
    </div>
</div>

@code
{
    private string selectedCulture = GetSupportedCulture(CultureInfo.CurrentUICulture.Name);

    private static string GetSupportedCulture(string name)
    {
        if (name.StartsWith("zh", StringComparison.OrdinalIgnoreCase)) return "zh-Hans";
        if (name.StartsWith("ms", StringComparison.OrdinalIgnoreCase)) return "ms";
        return "en";
    }

    private void SaveCulture()
    {
        Feedback.Success(L["LanguageSaved"], "Language preference saved", 3000);
        var redirect = Uri.EscapeDataString(NavigationManager.Uri);
        NavigationManager.NavigateTo($"/culture/set?culture={Uri.EscapeDataString(selectedCulture)}&redirectUri={redirect}", forceLoad: true);
    }
}

