    private IEnumerable<PurchaseOrderItem> FilteredPurchaseOrders
    {
        get
        {
            var items = PurchaseOrders.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(PurchaseOrderSearch))
            {
                var search = PurchaseOrderSearch.Trim();
                items = items.Where(po =>
                    (po.PoNo?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    po.Date.ToString("dd/MM/yyyy").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (po.Branch?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (po.Vendor?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (po.PoType?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (po.Product?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (po.Quantity?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (po.PaymentTerm?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    po.ExpectedDelivery.ToString("dd/MM/yyyy").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (po.Status?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (po.Remarks?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            // Apply multiple filters
            foreach (var filter in ActivePurchaseOrderFilters)
            {
                items = ApplyPurchaseOrderFilter(items, filter);
            }

            if (!string.IsNullOrEmpty(PurchaseOrderSortColumn))
            {
                items = PurchaseOrderSortColumn switch
                {
                    "PoNo" => PurchaseOrderSortAscending ? items.OrderBy(po => po.PoNo) : items.OrderByDescending(po => po.PoNo),
                    "Date" => PurchaseOrderSortAscending ? items.OrderBy(po => po.Date) : items.OrderByDescending(po => po.Date),
                    "Branch" => PurchaseOrderSortAscending ? items.OrderBy(po => po.Branch) : items.OrderByDescending(po => po.Branch),
                    "Vendor" => PurchaseOrderSortAscending ? items.OrderBy(po => po.Vendor) : items.OrderByDescending(po => po.Vendor),
                    "PoType" => PurchaseOrderSortAscending ? items.OrderBy(po => po.PoType) : items.OrderByDescending(po => po.PoType),
                    "Product" => PurchaseOrderSortAscending ? items.OrderBy(po => po.Product) : items.OrderByDescending(po => po.Product),
                    "Quantity" => PurchaseOrderSortAscending ? items.OrderBy(po => po.Quantity) : items.OrderByDescending(po => po.Quantity),
                    "PaymentTerm" => PurchaseOrderSortAscending ? items.OrderBy(po => po.PaymentTerm) : items.OrderByDescending(po => po.PaymentTerm),
                    "ExpectedDelivery" => PurchaseOrderSortAscending ? items.OrderBy(po => po.ExpectedDelivery) : items.OrderByDescending(po => po.ExpectedDelivery),
                    "Status" => PurchaseOrderSortAscending ? items.OrderBy(po => po.Status) : items.OrderByDescending(po => po.Status),
                    _ => items
                };
            }
            return items;
        }
    }

    private void HandlePurchaseOrderFiltersApplied(List<MultiTableFilter.FilterData> filters)
    {
        ActivePurchaseOrderFilters = filters;
        PurchaseOrdersCurrentPage = 1;
        StateHasChanged();
    }

    private void HandlePurchaseOrderFiltersCleared()
    {
        ActivePurchaseOrderFilters.Clear();
        PurchaseOrdersCurrentPage = 1;
    }

    private IEnumerable<PurchaseOrderItem> ApplyPurchaseOrderFilter(IEnumerable<PurchaseOrderItem> items, MultiTableFilter.FilterData filter)
    {
        if (filter.Column == "Date") { var start=filter.StartDate?.Date??DateTime.MinValue.Date; var end=filter.EndDate?.Date??DateTime.MaxValue.Date; return items.Where(x=>x.Date.Date>=start&&x.Date.Date<=end); }
        return filter.Column switch { "PoNo"=>items.Where(x=>TextMatches(x.PoNo,filter)), "Branch"=>items.Where(x=>TextMatches(x.Branch,filter)), "Vendor"=>items.Where(x=>TextMatches(x.Vendor,filter)), "Product"=>items.Where(x=>TextMatches(x.Product,filter)), "Status"=>items.Where(x=>TextMatches(x.Status,filter)), "Remarks"=>items.Where(x=>TextMatches(x.Remarks,filter)), _=>items };
    }
