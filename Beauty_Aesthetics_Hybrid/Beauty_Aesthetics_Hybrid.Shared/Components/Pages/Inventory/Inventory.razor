                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">SKU Code</span>
                                <span class="inventory-view-field__value"><code class="inventory-code-badge">@DisplayProductValue(SelectedProductDetails.Sku)</code></span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Barcode</span>
                                <span class="inventory-view-field__value"><code class="inventory-code-badge">@DisplayProductValue(SelectedProductDetails.Barcode)</code></span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Brand</span>
                                <span class="inventory-view-field__value">@DisplayProductValue(SelectedProductDetails.Brand)</span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Category</span>
                                <span class="inventory-view-field__value">@DisplayProductValue(SelectedProductDetails.Category)</span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Supplier</span>
                                <span class="inventory-view-field__value">@DisplayProductValue(SelectedProductDetails.Supplier)</span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Location / Bin</span>
                                <span class="inventory-view-field__value">@DisplayProductValue(SelectedProductDetails.Location)</span>
                            </div>
                        </div>
                    </div>

                    <div class="inventory-view-section">
                        <h3 class="inventory-view-section__title"><i class="bi bi-sliders"></i> Stock Management & UOM</h3>
                        <div class="inventory-view-grid inventory-view-grid--3">
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Primary UOM (UOM1)</span>
                                <span class="inventory-view-field__value">@DisplayProductValue(SelectedProductDetails.StockUom1)</span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Secondary UOM (UOM2)</span>
                                <span class="inventory-view-field__value">@DisplayProductValue(SelectedProductDetails.StockUom2)</span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Conversion Factor</span>
                                <span class="inventory-view-field__value">@DisplayProductValue(SelectedProductDetails.ConversionFactor)</span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Low Stock Alert Count</span>
                                <span class="inventory-view-field__value" style="color: #b45309;">@DisplayProductValue(SelectedProductDetails.LowAlertCount)</span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Discount Cap</span>
                                <span class="inventory-view-field__value">MYR @SelectedProductDetails.DiscountCap.ToString("N2")</span>
                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Record ID</span>
                                <span class="inventory-view-field__value" style="color: #64748b; font-size: 0.82rem;">@DisplayProductValue(SelectedProductDetails.MasterAccountId)</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="inventory-view-modal__footer">
                    <button type="button" class="btn-view-secondary" @onclick="CloseProductDetails">Close</button>
                    <button type="button" class="btn-view-primary" @onclick="() => EditProductFromDetails(SelectedProductDetails)">
                        <i class="bi bi-pencil"></i><span>Edit Product</span>
                    </button>
                </div>
            </div>
        </div>
    }

    @* Inventory Option View Details Modal *@
