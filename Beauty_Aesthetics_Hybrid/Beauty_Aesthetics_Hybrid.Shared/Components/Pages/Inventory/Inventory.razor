    private void ProcessGRNBarcodeScan()
    {
        GRNBarcodeScanMessage = null;
        GRNBarcodeScanSucceeded = false;
        FocusGRNBarcodeAfterRender = false;
        FocusGRNQuantityAfterRender = false;
        FocusGRNPurchaseOrderAfterRender = false;

        var scannedCode = GRNBarcodeScanValue.Trim();
        if (string.IsNullOrWhiteSpace(scannedCode))
        {
            GRNBarcodeScanMessage = "Scan or enter a barcode or SKU.";
            FocusGRNBarcodeAfterRender = true;
            return;
        }

        var scannedItem = InventoryItems.FirstOrDefault(item =>
            (!string.IsNullOrWhiteSpace(item.Barcode) &&
             string.Equals(item.Barcode.Trim(), scannedCode, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(item.Sku) &&
             string.Equals(item.Sku.Trim(), scannedCode, StringComparison.OrdinalIgnoreCase)));

        if (scannedItem is null)
        {
            GRNBarcodeScanMessage = $"No product was found for {scannedCode}. Check the barcode in product setup.";
            GRNBarcodeScanValue = string.Empty;
            FocusGRNBarcodeAfterRender = true;
            return;
        }

        if (IsGRNScanWorkflowVisible)
        {
            StartGRNReceiptFromScannedItem(scannedItem);
            return;
        }

        if (string.IsNullOrWhiteSpace(NewGRNPONo))
        {
            GRNBarcodeScanMessage = "Start from Scan goods or select a purchase order.";
            return;
        }

        var purchaseOrder = PurchaseOrders.FirstOrDefault(po =>
            string.Equals(po.PoNo, NewGRNPONo, StringComparison.OrdinalIgnoreCase));
        var expectedItem = SelectedGRNInventoryProduct ?? InventoryItems.FirstOrDefault(item =>
            purchaseOrder is not null &&
            string.Equals(item.Type, purchaseOrder.Product, StringComparison.OrdinalIgnoreCase));

        var matchesExpectedItem = expectedItem is not null
            ? IsSameInventoryItem(expectedItem, scannedItem)
            : purchaseOrder is not null &&
              string.Equals(purchaseOrder.Product, scannedItem.Type, StringComparison.OrdinalIgnoreCase);

        if (!matchesExpectedItem)
        {
            var expectedName = expectedItem?.Type ?? purchaseOrder?.Product ?? NewGRNName;
            GRNBarcodeScanMessage = $"Wrong item scanned. This PO expects {expectedName}; you scanned {scannedItem.Type}.";
            GRNBarcodeScanValue = string.Empty;
            FocusGRNBarcodeAfterRender = true;
            return;
        }

        ApplyInventoryItemToGRN(scannedItem);
        GRNBarcodeScanValue = string.IsNullOrWhiteSpace(scannedItem.Barcode) ? scannedItem.Sku : scannedItem.Barcode;
        GRNBarcodeScanSucceeded = true;
        GRNBarcodeScanMessage = $"{scannedItem.Type} confirmed. Enter the received quantity.";
        FocusGRNQuantityAfterRender = true;
    }

    private void StartGRNReceiptFromScannedItem(InventoryViewModel.InventoryItem scannedItem)
    {
        var matchingOrders = PurchaseOrders
            .Where(IsPurchaseOrderAvailableForReceiving)
            .Where(order => string.Equals(
                order.Product?.Trim(),
                scannedItem.Type?.Trim(),
                StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (matchingOrders.Count == 0)
        {
            GRNBarcodeScanMessage = $"{scannedItem.Type} was found, but there is no approved purchase order available to receive it.";
            GRNBarcodeScanValue = string.Empty;
            FocusGRNBarcodeAfterRender = true;
            return;
        }

        GRNScannedInventoryId = scannedItem.MasterAccountId;
        ApplyInventoryItemToGRN(scannedItem);
        GRNBarcodeScanValue = string.IsNullOrWhiteSpace(scannedItem.Barcode)
            ? scannedItem.Sku
            : scannedItem.Barcode;
        GRNBarcodeScanSucceeded = true;
        IsGRNScanWorkflowVisible = false;
        IsAddGRNFormVisible = true;

        if (matchingOrders.Count == 1)
        {
            NewGRNPONo = matchingOrders[0].PoNo;
            ApplySelectedPurchaseOrder();
            ApplyInventoryItemToGRN(scannedItem);
            GRNBarcodeScanMessage = $"{scannedItem.Type} matched to {NewGRNPONo}.";
            FocusGRNQuantityAfterRender = true;
            return;
        }

        NewGRNPONo = string.Empty;
        NewGRNSupplier = string.Empty;
        NewGRNAccountId = string.Empty;
        GRNBarcodeScanMessage = $"{scannedItem.Type} was scanned. Select one of the {matchingOrders.Count} matching approved purchase orders.";
        FocusGRNPurchaseOrderAfterRender = true;
    }

    private static bool IsSameInventoryItem(
        InventoryViewModel.InventoryItem expectedItem,
        InventoryViewModel.InventoryItem scannedItem)
    {
        if (!string.IsNullOrWhiteSpace(expectedItem.MasterAccountId) &&
            !string.IsNullOrWhiteSpace(scannedItem.MasterAccountId))
        {
            return string.Equals(expectedItem.MasterAccountId, scannedItem.MasterAccountId, StringComparison.OrdinalIgnoreCase);
        }

        if (!string.IsNullOrWhiteSpace(expectedItem.Sku) && !string.IsNullOrWhiteSpace(scannedItem.Sku))
        {
            return string.Equals(expectedItem.Sku, scannedItem.Sku, StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(expectedItem.Barcode, scannedItem.Barcode, StringComparison.OrdinalIgnoreCase);
    }

    private void ApplyInventoryItemToGRN(InventoryViewModel.InventoryItem item)
    {
        NewGRNName = item.Type;
        NewGRNItemSku = item.Sku;
        NewGRNInventoryId = item.MasterAccountId;
        NewGRNUom = string.IsNullOrWhiteSpace(item.UnitOfMeasurementId)
            ? NormalizeStockUom(item.StockUom1)
            : item.UnitOfMeasurementId;
        NewGRNInventoryTypeId = item.InventoryTypeId;
        NewGRNUnitPrice = item.Price;
        if (string.IsNullOrWhiteSpace(NewGRNSupplier))
        {
            NewGRNSupplier = item.Supplier;
        }
        if (string.IsNullOrWhiteSpace(NewGRNAccountId))
        {
            NewGRNAccountId = item.SupplierAccountId;
        }
    }

    private async Task OpenGRNBarcodeScannerAsync()
    {
        if (!IsGRNScanWorkflowVisible)
        {
            GRNBarcodeScanSucceeded = false;
            GRNBarcodeScanMessage = "Open Scan goods before using the camera.";
            return;
        }

        GRNBarcodeScanMessage = null;
        GRNBarcodeScanSucceeded = false;
        FocusGRNBarcodeAfterRender = false;
        FocusGRNQuantityAfterRender = false;
        FocusGRNPurchaseOrderAfterRender = false;
        IsGRNBarcodeScannerVisible = true;
        IsGRNBarcodeScannerStarting = true;
        StartGRNBarcodeScannerAfterRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartGRNBarcodeScannerAsync()
    {
        await EnsureInventoryModuleAsync();
        if (_inventoryModule is null)
        {
            SetGRNBarcodeScannerError("Camera scanner could not be loaded. Use a handheld scanner or type the barcode.");
            return;
        }

        try
        {
            GRNBarcodeDotNetReference ??= DotNetObjectReference.Create(this);
            var error = await _inventoryModule.InvokeAsync<string?>(
                "startBarcodeScanner",
                GRNBarcodeVideoElement,
                GRNBarcodeDotNetReference);

            if (!string.IsNullOrWhiteSpace(error))
            {
                SetGRNBarcodeScannerError(error);
                return;
            }

            IsGRNBarcodeScannerStarting = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException)
        {
            SetGRNBarcodeScannerError("The camera connection was interrupted. Please try again.");
        }
        catch (JSException)
        {
            SetGRNBarcodeScannerError("Camera scanning is unavailable on this device. Use a handheld scanner or type the barcode.");
        }
    }

    private void SetGRNBarcodeScannerError(string message)
    {
        IsGRNBarcodeScannerVisible = false;
        IsGRNBarcodeScannerStarting = false;
        StartGRNBarcodeScannerAfterRender = false;
        GRNBarcodeScanSucceeded = false;
        GRNBarcodeScanMessage = message;
        FocusGRNBarcodeAfterRender = IsGRNScanWorkflowVisible;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CloseGRNBarcodeScannerAsync()
    {
        StartGRNBarcodeScannerAfterRender = false;
        IsGRNBarcodeScannerStarting = false;

        if (_inventoryModule is not null)
        {
            try
            {
                await _inventoryModule.InvokeVoidAsync("stopBarcodeScanner");
            }
            catch (JSDisconnectedException)
            {
                // The page is already disconnected.
            }
            catch (JSException)
            {
                // The scanner may already have stopped after detecting a barcode.
            }
        }

        IsGRNBarcodeScannerVisible = false;
        FocusGRNBarcodeAfterRender = IsGRNScanWorkflowVisible;
    }

    [JSInvokable("OnGrnBarcodeDetected")]
    public async Task OnGrnBarcodeDetected(string barcode)
    {
        IsGRNBarcodeScannerVisible = false;
        IsGRNBarcodeScannerStarting = false;
        StartGRNBarcodeScannerAfterRender = false;
        GRNBarcodeScanValue = barcode ?? string.Empty;
        ProcessGRNBarcodeScan();
        await InvokeAsync(StateHasChanged);
    }

    private string ResolveGRNBranchId(string branch)
    {
        var match = StockTransferBranches.FirstOrDefault(candidate =>
            string.Equals(candidate.Id, branch, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(candidate.Name, branch, StringComparison.OrdinalIgnoreCase));

        return match?.Id ?? (string.IsNullOrWhiteSpace(InventoryBranchId) ? "HQ" : InventoryBranchId);
    }

    private static void ParsePurchaseOrderQuantity(string value, out decimal quantity, out string uom)
    {
        quantity = 0m;
        uom = string.Empty;
        var parts = (value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 0)
        {
            decimal.TryParse(parts[0], out quantity);
        }

        if (parts.Length > 1)
        {
            uom = string.Join(" ", parts.Skip(1));
        }

    }

