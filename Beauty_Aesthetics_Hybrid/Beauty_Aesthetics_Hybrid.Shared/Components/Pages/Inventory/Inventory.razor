                            <thead>
                                <tr>
                                    @if (IsTransferHistoryPrintModeActive)
                                    {
                                        <th class="purchase-orders__checkbox-col">Select</th>
                                    }
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "ReferenceNo")' @onclick='() => ToggleTransferHistorySort("ReferenceNo")'>Transfer No. <span class="resize-handle"></span></th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "Date")' @onclick='() => ToggleTransferHistorySort("Date")'>Date <span class="resize-handle"></span></th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "From")' @onclick='() => ToggleTransferHistorySort("From")'>From Branch <span class="resize-handle"></span></th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "To")' @onclick='() => ToggleTransferHistorySort("To")'>To Branch <span class="resize-handle"></span></th>
                                    <th>Remarks <span class="resize-handle"></span></th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "TotalQuantity")' @onclick='() => ToggleTransferHistorySort("TotalQuantity")'>Total Qty <span class="resize-handle"></span></th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "TotalCost")' @onclick='() => ToggleTransferHistorySort("TotalCost")'>Total Cost <span class="resize-handle"></span></th>
                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "Status")' @onclick='() => ToggleTransferHistorySort("Status")'>Status <span class="resize-handle"></span></th>
                                    @if (!IsTransferHistoryPrintModeActive)
                                    {
                                        <th class="inventory-row-actions-column stock-row-actions-column">Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (!PaginatedCombinedHistory.Any())
                                {
                                    <tr><td colspan="10" class="inventory__empty-state">No stock transfer history found.</td></tr>
                                }
                                else
                                {
                                    @foreach (var history in PaginatedCombinedHistory)
                                    {
                                        <tr @onclick="() => HandleTransferHistoryRowClickAsync(history)" class="@GetTransferHistoryRowClass(history)">
                                            @if (IsTransferHistoryPrintModeActive)
                                            {
                                                <td class="purchase-orders__checkbox-col" @onclick:stopPropagation="true">
                                                    <input type="checkbox"
                                                           checked="@SelectedTransferHistoryReferencesForPrint.Contains(history.ReferenceNo)"
                                                           @onchange="() => ToggleTransferHistoryPrintSelection(history.ReferenceNo)" />
                                                </td>
                                            }
                                            <td><strong>@history.ReferenceNo</strong></td>
                                            <td>@history.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@history.From</td>
                                            <td>@history.To</td>
                                            <td>@(string.IsNullOrWhiteSpace(history.Remarks) ? "—" : history.Remarks)</td>
                                            <td>@(history.TotalQuantity > 0 ? history.TotalQuantity.ToString("0.##") : "—")</td>
                                            <td><span class="inventory-money-value">MYR @history.TotalCost.ToString("N2")</span></td>
                                            <td><span class="stock-transfer__status stock-transfer__status--@history.Status.ToLowerInvariant().Replace(" ", "-")">@history.Status</span></td>
                                            @if (!IsTransferHistoryPrintModeActive)
                                            {
                                                <td class="inventory-row-actions-column stock-row-actions-column" @onclick:stopPropagation="true">
                                                    <button type="button" class="product-row-action" title="View transfer details" @onclick="() => ShowTransferHistoryDetailsAsync(history)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <Pagination CurrentPage="@StockTransferHistoryCurrentPage"
                            ItemsPerPage="5"
                            TotalItems="@FilteredCombinedHistory.Count()"
                            OnPageChanged="@HandleStockTransferHistoryPageChanged" />
                <div class="pagination-summary">
                    Total items: @FilteredCombinedHistory.Count()
                </div>

                <!-- Restock Modal -->
                @if (ShowRestockModalWindow)
                {
                    <div class="restock-modal-overlay" @onclick="CloseRestockModal">
                        <div class="restock-modal" @onclick:stopPropagation="true">
                            <div class="restock-modal__header">
                                <div class="restock-modal__title">
                                    <i class="bi bi-box-arrow-in-down"></i>
                                    <h2>Restock</h2>
                                </div>
                                <div class="restock-modal__actions">
                                    <button type="button" class="restock-modal__btn restock-modal__btn--save" @onclick="HandleRestock">
                                        Save
                                    </button>
                                    <button type="button" class="restock-modal__btn restock-modal__btn--cancel" @onclick="CloseRestockModal">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                            <div class="restock-modal__body">

                                <form class="restock-form" @onsubmit:preventDefault>
                                    <!-- Branch Restock Form -->
                                    <div class="stock-transfer__form-section">
                                        <h3>Branch Restock Details</h3>
                                        <div class="inventory__form-row">
                                            <div class="inventory__form-group">
                                                <label>Restock Number</label>
                                                <input type="text" @bind="NewRestock.RestockNo" readonly />
                                            </div>
                                            <div class="inventory__form-group">
                                                <label>Date</label>
                                                <input type="date" @bind="NewRestock.RestockDate" required />
                                            </div>
                                        </div>
                                        <div class="inventory__form-row">
                                            <div class="inventory__form-group">
                                                <label>From Branch (Current)</label>
                                                <input type="text" value="@CurrentBranch" readonly />
                                            </div>
                                            <div class="inventory__form-group">
                                                <label>To Branch</label>
                                                <select @bind="NewRestock.ToBranch" required>
                                                    <option value="">Select Branch</option>
                                                    @foreach (var branch in Branches)
                                                    {
                                                        if (branch != CurrentBranch)
                                                        {
                                                            <option value="@branch">@branch</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Product Selection Section -->
                                    <div class="stock-transfer__form-section">
                                        <h3>Select Products to Restock</h3>
                                        <div class="stock-transfer__product-search">
                                            <input type="text"
                                                   placeholder="Search products..."
                                                   @bind="RestockProductSearch"
                                                   @bind:event="oninput" />
                                            <i class="bi bi-search"></i>
                                        </div>
                                        <div class="stock-transfer__product-list">
                                            <table class="stock-transfer__selection-table">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 50px;">Select</th>
                                                        <th>Product Name</th>
                                                        <th>SKU</th>
                                                        <th>Current Stock</th>
                                                        <th>Restock Quantity</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var product in FilteredRestockProducts)
                                                    {
                                                        var isSelected = NewRestock.SelectedProducts.ContainsKey(product.Sku);
                                                        <tr class="product-picker-row @(isSelected ? "product-picker-row--selected" : string.Empty)"
                                                            role="checkbox"
                                                            aria-label="@($"Select {product.ProductName}")"
                                                            aria-checked="@isSelected"
                                                            tabindex="0"
                                                            @onclick="() => ToggleRestockProductSelection(product)"
                                                            @onkeydown="args => HandleRestockProductRowKeyDown(args, product)">
                                                            <td @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                                <input type="checkbox"
                                                                       checked="@isSelected"
                                                                       @onchange="() => ToggleRestockProductSelection(product)" />
                                                            </td>
                                                            <td>
                                                                <div class="gin-product-option">
                                                                    <div class="gin-product-option__image">
                                                                        @if (HasInventoryImage(product.ImageUrl))
                                                                        {
                                                                            <img src="@product.ImageUrl" alt="" loading="lazy" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <i class="bi bi-box-seam"></i>
                                                                        }
                                                                    </div>
                                                                    <strong>@product.ProductName</strong>
                                                                </div>
                                                            </td>
                                                            <td>@product.Sku</td>
                                                            <td>@FormatStockCount(product.StockCount) @product.Uom1</td>
                                                            <td @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                                @if (isSelected)
                                                                {
                                                                    <input type="number"
                                                                           min="1"
                                                                           @bind="NewRestock.SelectedProducts[product.Sku]"
                                                                           class="stock-transfer__quantity-input"
                                                                           required />
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="stock-transfer__selection-summary">
                                            <strong>Selected Products:</strong> @NewRestock.SelectedProducts.Count
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                <!-- Stock Transfer Modal — mirrors SenangRetails Stock Transfer workflow -->
                @if (ShowAddTransferModal)
                {
                    <div class="transfer-modal-overlay" @onclick="CloseAddTransferModal">
                        <div class="transfer-modal"
                             role="dialog"
                             aria-modal="true"
                             aria-labelledby="stock-transfer-modal-title"
                             @onclick:stopPropagation="true">
                            <div class="transfer-modal__header">
                                <div class="transfer-modal__title">
                                    <i class="bi bi-arrow-left-right"></i>
                                    <div>
                                        <h2 id="stock-transfer-modal-title">Stock Transfer</h2>
                                        <p>Move stock between branches</p>
                                    </div>
                                </div>
                                <div class="transfer-modal__actions">
                                    <button type="button"
                                            class="transfer-modal__btn transfer-modal__btn--save"
                                            @onclick="HandleCreateTransfer"
                                            disabled="@(IsStockTransferSaving || NewTransfer.SelectedProducts.Count == 0)">
                                        @if (IsStockTransferSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                            <span>Saving...</span>
                                        }
                                        else
                                        {
                                            <span>Confirm Stock Transfer</span>
                                        }
                                    </button>
                                    <button type="button" class="transfer-modal__btn transfer-modal__btn--cancel" @onclick="CloseAddTransferModal">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                            <div class="transfer-modal__body">
                                <form class="transfer-form" @onsubmit:preventDefault>
                                    @if (!string.IsNullOrWhiteSpace(StockTransferApiError))
                                    {
                                        <div class="inventory__alert inventory__alert--error">@StockTransferApiError</div>
                                    }

                                    <div class="stock-transfer__form-section">
                                        <h3>Transfer Details</h3>
                                        <div class="inventory__form-row">
                                            <div class="inventory__form-group">
                                                <label>From Branch <span class="inventory__required">*</span></label>
                                                <select value="@NewTransfer.IssuedBy"
                                                        @onchange="HandleTransferSourceBranchChanged"
                                                        disabled="@(IsStockTransferBranchApiLoading || IsTransferProductApiLoading)"
                                                        required>
                                                    <option value="">Select origin branch</option>
                                                    @foreach (var branch in StockTransferBranches)
                                                    {
                                                        <option value="@branch.Id">@branch.DisplayName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="inventory__form-group">
                                                <label>To Branch <span class="inventory__required">*</span></label>
                                                <select @bind="NewTransfer.IssuedTo" disabled="@IsStockTransferBranchApiLoading" required>
                                                    <option value="">Select destination branch</option>
                                                    @foreach (var branch in StockTransferBranches)
                                                    {
                                                        <option value="@branch.Id">@branch.DisplayName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="inventory__form-group">
                                            <label>Remarks <span class="gin-optional">(optional)</span></label>
                                            <textarea @bind="NewTransfer.Notes" rows="2" placeholder="Remarks"></textarea>
                                        </div>
                                    </div>

                                    <div class="stock-transfer__form-section">
                                        <div class="gin-section-heading">
                                            <div>
                                                <h3>Add Product</h3>
                                                <p>Select products, then enter quantity and cost.</p>
                                            </div>
                                            <span>@NewTransferTotalSku selected</span>
                                        </div>
                                        <div class="stock-transfer__product-search">
                                            <input type="search"
                                                   placeholder="Search product name or SKU..."
                                                   @bind="TransferProductSearch"
                                                   @bind:event="oninput" />
                                            <i class="bi bi-search"></i>
                                        </div>
                                        <div class="stock-transfer__product-list">
                                            <table class="stock-transfer__selection-table product-picker-table">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 54px;">Select</th>
                                                        <th class="product-picker-table__image-heading">Image</th>
                                                        <th>Product</th>
                                                        <th>Qty</th>
                                                        <th>Cost (MYR)</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (!FilteredTransferProducts.Any())
                                                    {
                                                        <tr>
                                                            <td colspan="5" class="gin-product-table__empty">No matching products found.</td>
                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var product in FilteredTransferProducts)
                                                        {
                                                            var isSelected = NewTransfer.SelectedProducts.ContainsKey(product.Sku);
                                                            var isUnavailable = product.StockCount is null || product.StockCount <= 0;
                                                            <tr class="product-picker-row @(isSelected ? "product-picker-row--selected" : string.Empty) @(isUnavailable ? "product-picker-row--disabled" : string.Empty)"
                                                                @onclick="() => ToggleProductSelection(product)">
                                                                <td @onclick:stopPropagation="true">
                                                                    <input type="checkbox"
                                                                           checked="@isSelected"
                                                                           disabled="@isUnavailable"
                                                                           title="@GetStockSelectionTitle(product)"
                                                                           @onchange="() => ToggleProductSelection(product)" />
                                                                </td>
                                                                <td class="product-picker-table__image-cell">
                                                                    <img src="@GetProductPickerImage(product)" alt="@product.ProductName" loading="lazy" />
                                                                </td>
                                                                <td class="product-picker-table__product-cell">
                                                                    <strong>@product.ProductName</strong>
                                                                    <small>@product.Sku · Stock: @FormatStockCount(product.StockCount) @product.Uom1</small>
                                                                </td>
                                                                <td @onclick:stopPropagation="true">
                                                                    @if (isSelected)
                                                                    {
                                                                        <input type="number"
                                                                               min="1"
                                                                               max="@product.StockCount"
                                                                               class="stock-transfer__quantity-input"
                                                                               @bind="NewTransfer.SelectedProducts[product.Sku]"
                                                                               @bind:event="oninput" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">—</span>
                                                                    }
                                                                </td>
                                                                <td @onclick:stopPropagation="true">
                                                                    @if (isSelected)
                                                                    {
                                                                        <input type="number"
                                                                               min="0"
                                                                               step="0.01"
                                                                               class="stock-transfer__quantity-input"
                                                                               @bind="NewTransfer.SelectedCosts[product.Sku]"
                                                                               @bind:event="oninput" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">—</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="delivery-order-total summary-card-container">
                                            <div class="side-by-side summary-line">
                                                <span class="summary-text">Total SKU</span>
                                                <span class="summary-value">@NewTransferTotalSku</span>
                                            </div>
                                            <div class="side-by-side summary-line">
                                                <span class="summary-text">Total Quantity</span>
                                                <span class="summary-value">@NewTransferTotalQuantity</span>
                                            </div>
                                            <div class="side-by-side summary-total-line">
                                                <span class="summary-total-text">Total Cost</span>
                                                <span class="summary-total-value">MYR @NewTransferTotalCost.ToString("N2")</span>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }


                <!-- Transfer History Modal -->
                @if (ShowTransferHistory)
                {
                    <div class="inventory__modal-overlay" @onclick="CloseTransferHistory">
                        <div class="inventory__modal inventory__modal--large" @onclick:stopPropagation="true">
                            <div class="inventory__modal-header">
                                <h2>Transfer History</h2>
                                <button class="inventory__modal-close" @onclick="CloseTransferHistory">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="inventory__modal-body">
                                <div class="transfer-history__toolbar">
                                    <div class="transfer-history__actions">
                                        @if (!IsTransferHistoryPrintModeActive)
                                        {
                                            <button class="tab-btn stock-transfer__btn-with-text stock-transfer__btn-with-text--light" title="Print History" @onclick="ActivateTransferHistoryPrintMode">
                                                <i class="bi bi-printer"></i>
                                                <span>Print</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="tab-btn stock-transfer__btn-with-text" title="Confirm Print" @onclick="PrintTransferHistory" disabled="@(!SelectedTransferHistoryReferencesForPrint.Any())">
                                                <i class="bi bi-check-circle"></i>
                                                <span>Confirm Print</span>
                                            </button>
                                            <button class="tab-btn stock-transfer__btn-with-text" title="Cancel Print" @onclick="CancelTransferHistoryPrintMode">
                                                <i class="bi bi-x-circle"></i>
                                                <span>Cancel</span>
                                            </button>
                                        }
                                    </div>
                                    <AdvancedInventoryFilter Columns="@TransferHistoryMultiFilterColumns" OnApply="@HandleTransferHistoryMultiFiltersApplied" OnClear="@HandleTransferHistoryMultiFiltersCleared" ModuleName="Transfer History" ResultCount="@FilteredCombinedHistory.Count()" />
                                </div>

                                @if (IsTransferHistoryPrintModeActive)
                                {
                                    <div class="inventory__delete-bar">
                                        <div class="inventory__delete-info">
                                            <span>@SelectedTransferHistoryReferencesForPrint.Count item(s) selected for print</span>
                                        </div>
                                    </div>
                                }

                                <div class="inventory__table-wrapper table-scroll">
                                    <div class="table-scroll__inner">
                                        <table class="stock-transfer__table @(IsTransferHistoryPrintModeActive ? "purchase-orders__table" : string.Empty)">
                                            <thead>
                                                <tr>
                                                    @if (IsTransferHistoryPrintModeActive)
                                                    {
                                                        <th class="purchase-orders__checkbox-col">Select</th>
                                                    }
                                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "ReferenceNo")' @onclick='() => ToggleTransferHistorySort("ReferenceNo")'>
                                                        Reference No
                                                    </th>
                                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "Type")' @onclick='() => ToggleTransferHistorySort("Type")'>
                                                        Type
                                                    </th>
                                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "Date")' @onclick='() => ToggleTransferHistorySort("Date")'>
                                                        Date
                                                    </th>
                                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "From")' @onclick='() => ToggleTransferHistorySort("From")'>
                                                        From
                                                    </th>
                                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "To")' @onclick='() => ToggleTransferHistorySort("To")'>
                                                        To
                                                    </th>
                                                    <th class='@GetSortHeaderClass(TransferHistorySortColumn, TransferHistorySortAscending, "Status")' @onclick='() => ToggleTransferHistorySort("Status")'>
                                                        Status
                                                    </th>
                                                    @if (!IsTransferHistoryPrintModeActive)
                                                    {
                                                        <th class="inventory-row-actions-column">Actions</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var history in PaginatedCombinedHistory)
                                                {
                                                    <tr @onclick="() => HandleTransferHistoryRowClickAsync(history)" class="@GetTransferHistoryRowClass(history)">
                                                        @if (IsTransferHistoryPrintModeActive)
                                                        {
                                                            <td class="purchase-orders__checkbox-col" @onclick:stopPropagation="true">
                                                                <input type="checkbox"
                                                                       checked="@SelectedTransferHistoryReferencesForPrint.Contains(history.ReferenceNo)"
                                                                       @onchange="() => ToggleTransferHistoryPrintSelection(history.ReferenceNo)" />
                                                            </td>
                                                        }
                                                        <td>@history.ReferenceNo</td>
                                                        <td>@history.Type</td>
                                                        <td>@history.Date.ToString("dd/MM/yyyy")</td>
                                                        <td>@history.From</td>
                                                        <td>@history.To</td>
                                                        <td>
                                                            <span class="stock-transfer__status stock-transfer__status--@history.Status.ToLowerInvariant().Replace(" ", "-")">
                                                                @history.Status
                                                            </span>
                                                        </td>
                                                        @if (!IsTransferHistoryPrintModeActive)
                                                        {
                                                            <td class="inventory-row-actions-column" @onclick:stopPropagation="true">
                                                                <button type="button" class="product-row-action" title="View transfer details" aria-label="View transfer details" @onclick="() => ShowTransferHistoryDetailsAsync(history)">
                                                                    <i class="bi bi-eye"></i>
                                                                </button>
                                                            </td>
                                                        }

                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <Pagination CurrentPage="@StockTransferHistoryCurrentPage"
                                            ItemsPerPage="5"
                                            TotalItems="@FilteredCombinedHistory.Count()"
                                            OnPageChanged="@HandleStockTransferHistoryPageChanged" />
                                <div class="pagination-summary">
                                    Total items: @FilteredCombinedHistory.Count()
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (IsTransferHistoryDetailsVisible && SelectedTransferHistoryItem != null)
                {
                    <div class="inventory-view-modal-overlay" @onclick="CloseTransferHistoryDetails">
                        <div class="inventory-view-modal" @onclick:stopPropagation="true">
                            <div class="inventory-view-modal__header">
                                <div class="inventory-view-modal__header-left">
                                    <div class="inventory-view-modal__icon"><i class="bi bi-arrow-left-right"></i></div>
                                    <div class="inventory-view-modal__title-group">
                                        <h2>Stock Transfer Details</h2>
                                        <p class="inventory-view-modal__subtitle">Inter-branch inventory movement details</p>
                                    </div>
                                </div>
                                <div class="inventory-view-modal__header-right">
                                    <span class="inventory-view-badge inventory-view-badge--info">@SelectedTransferHistoryItem.Status</span>
                                    <button type="button" class="inventory-view-modal__close" @onclick="CloseTransferHistoryDetails" aria-label="Close"><i class="bi bi-x-lg"></i></button>
                                </div>
                            </div>
                            <div class="inventory-view-modal__body">
                                <div class="inventory-view-hero">
                                    <div class="inventory-view-hero__item">
                                        <span class="inventory-view-hero__label">REFERENCE NO</span>
                                        <strong class="inventory-view-hero__value">@SelectedTransferHistoryItem.ReferenceNo</strong>
                                    </div>
                                    <div class="inventory-view-hero__divider"></div>
                                    <div class="inventory-view-hero__item">
                                        <span class="inventory-view-hero__label">TRANSFER TYPE</span>
                                        <span class="inventory-view-hero__text"><i class="bi bi-tag"></i> @SelectedTransferHistoryItem.Type</span>
                                    </div>
                                    <div class="inventory-view-hero__divider"></div>
                                    <div class="inventory-view-hero__item">
                                        <span class="inventory-view-hero__label">DATE</span>
                                        <span class="inventory-view-hero__text"><i class="bi bi-calendar3"></i> @SelectedTransferHistoryItem.Date.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>

                                <div class="inventory-view-transfer-route">
                                    <div class="inventory-view-transfer-node">
                                        <span class="inventory-view-transfer-node__label"><i class="bi bi-box-arrow-in-right"></i> FROM SOURCE</span>
                                        <strong class="inventory-view-transfer-node__name">@SelectedTransferHistoryItem.From</strong>
                                    </div>
                                    <div class="inventory-view-transfer-arrow">
                                        <i class="bi bi-arrow-right"></i>
                                    </div>
                                    <div class="inventory-view-transfer-node">
                                        <span class="inventory-view-transfer-node__label"><i class="bi bi-box-arrow-up-right"></i> TO DESTINATION</span>
                                        <strong class="inventory-view-transfer-node__name">@SelectedTransferHistoryItem.To</strong>
                                    </div>
                                </div>

                                <div class="inventory-view-section">
                                    <h3 class="inventory-view-section__title"><i class="bi bi-boxes"></i> Transferred Items (@SelectedTransferHistoryProductLines.Count)</h3>
