    private IEnumerable<CombinedHistoryItem> ApplyTransferHistoryFilter(IEnumerable<CombinedHistoryItem> items, MultiTableFilter.FilterData filter)
    {
        if (filter.Column == "Date")
        {
            var start = filter.StartDate?.Date ?? DateTime.MinValue.Date;
            var end = filter.EndDate?.Date ?? DateTime.MaxValue.Date;
            return items.Where(item => item.Date.Date >= start && item.Date.Date <= end);
        }

        return filter.Column switch
        {
            "ReferenceNo" => items.Where(item => TextMatches(item.ReferenceNo, filter)),
            "From" => items.Where(item => TextMatches(item.From, filter)),
            "To" => items.Where(item => TextMatches(item.To, filter)),
            "Remarks" => items.Where(item => TextMatches(item.Remarks, filter)),
            "TotalCost" => items.Where(item => InRange(item.TotalCost, filter)),
            "Status" => items.Where(item => TextMatches(item.Status, filter)),
            _ => items
        };
    }

