                            <strong class="inventory-view-hero__value">@SelectedGrnDetails.Activity</strong>
                        </div>
                        <div class="inventory-view-hero__divider"></div>
                        <div class="inventory-view-hero__item">
                            <span class="inventory-view-hero__label">TOTAL COST</span>
                            <strong class="inventory-view-hero__price">MYR @SelectedGrnDetails.Amount.ToString("N2")</strong>
                        </div>
                    </div>

                    <div class="inventory-view-section">
                        <h3 class="inventory-view-section__title"><i class="bi bi-card-text"></i> Remarks</h3>
                        <div class="inventory-view-remarks">
                            <p>@(string.IsNullOrWhiteSpace(SelectedGrnDetails.Remarks) ? "—" : SelectedGrnDetails.Remarks)</p>
                        </div>
                    </div>

                    <div class="inventory-view-section">
                        <h3 class="inventory-view-section__title"><i class="bi bi-list-check"></i> Products (@SelectedGrnDetails.Products.Count)</h3>
                        @if (SelectedGrnDetails.Products.Any())
                        {
                            <div class="inventory-view-table-card">
                                <table class="inventory-view-table">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th>SKU</th>
                                            <th class="text-right">Qty</th>
                                            <th class="text-right">Cost</th>
                                            <th class="text-right">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in SelectedGrnDetails.Products)
                                        {
                                            <tr>
                                                <td class="font-medium">@line.ProductName</td>
                                                <td><code class="inventory-code-badge">@line.Sku</code></td>
                                                <td class="text-right">@line.Quantity @line.UnitOfMeasurementId</td>
                                                <td class="text-right">MYR @line.UnitCost.ToString("N2")</td>
                                                <td class="text-right font-bold">MYR @((line.Quantity * line.UnitCost).ToString("N2"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
