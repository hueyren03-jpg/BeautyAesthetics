    private IEnumerable<PurchaseOrderItem> AvailableGRNPurchaseOrders
    {
        get
        {
            var orders = PurchaseOrders.Where(po =>
                string.Equals(po.PoNo, NewGRNPONo, StringComparison.OrdinalIgnoreCase) ||
                IsPurchaseOrderAvailableForReceiving(po));

            if (string.IsNullOrWhiteSpace(GRNScannedInventoryId))
            {
                return orders;
            }

            var scannedItem = InventoryItems.FirstOrDefault(item =>
                string.Equals(item.MasterAccountId, GRNScannedInventoryId, StringComparison.OrdinalIgnoreCase));
            if (scannedItem is null)
            {
                return orders;
            }

            return orders.Where(po =>
                string.Equals(po.PoNo, NewGRNPONo, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(po.Product, scannedItem.Type, StringComparison.OrdinalIgnoreCase));
        }
    }

    private static bool IsPurchaseOrderAvailableForReceiving(PurchaseOrderItem purchaseOrder) =>
        string.Equals(purchaseOrder.Status, "Approved", StringComparison.OrdinalIgnoreCase) ||
        purchaseOrder.Status.Contains("Partial", StringComparison.OrdinalIgnoreCase);

