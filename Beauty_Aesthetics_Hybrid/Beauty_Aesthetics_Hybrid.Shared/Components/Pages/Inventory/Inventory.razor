                        <div class="inventory-view-modal__header-right">
                            <span class="inventory-view-badge inventory-view-badge--@SelectedPurchaseOrder.Status.ToLower().Replace(" ", "-")">@SelectedPurchaseOrder.Status</span>
                            <button type="button" class="inventory-view-modal__close" @onclick="ClosePurchaseOrderDetails" aria-label="Close"><i class="bi bi-x-lg"></i></button>
                        </div>
                    </div>
                    <div class="inventory-view-modal__body">
                        <div class="inventory-view-hero">
