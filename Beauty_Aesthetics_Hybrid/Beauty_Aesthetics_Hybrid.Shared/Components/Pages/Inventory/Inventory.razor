                            </div>
                            <div class="inventory-view-field">
                                <span class="inventory-view-field__label">Secondary UOM (UOM 2)</span>
                                <span class="inventory-view-field__value">@(string.IsNullOrWhiteSpace(SelectedStockDetails.Uom2) ? "-" : SelectedStockDetails.Uom2)</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="inventory-view-modal__footer">
                    <button type="button" class="btn-view-secondary" @onclick="CloseStockDetails">Close</button>
                </div>
            </div>
        </div>
