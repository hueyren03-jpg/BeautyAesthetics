                                 <button class="tab-btn inventory__btn inventory__btn--secondary" @onclick="CancelPrintMode">
                                     Cancel
                                 </button>
                             }
                         </div>
                         <div class="inventory__search-container">
                             <input class="inventory__search"
                                    type="search"
                                    placeholder="Search..."
                                    value="@PurchaseOrderSearch"
                                    @oninput="OnPurchaseOrderSearchChanged" />
                             <i class="bi bi-search inventory__search-icon"></i>
                         </div>
                     </div>
                     <div class="purchase-orders__filter">
                         <AdvancedInventoryFilter Columns="@PurchaseOrderFilterColumns" OnApply="@HandlePurchaseOrderFiltersApplied" OnClear="@HandlePurchaseOrderFiltersCleared" ModuleName="Purchase Orders" ResultCount="@FilteredPurchaseOrders.Count()" />
                     </div>
                 </div>

                 <div class="inventory__table-wrapper po-table-scroll">
