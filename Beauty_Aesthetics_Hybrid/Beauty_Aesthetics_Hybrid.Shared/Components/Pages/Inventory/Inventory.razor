    private IEnumerable<BrandItem> FilteredBrands
    {
        get
        {
            var items = string.IsNullOrWhiteSpace(BrandSearch)
                ? Brands.AsEnumerable()
                : Brands.Where(b => b.Name.Contains(BrandSearch, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(BrandSortColumn))
            {
                items = BrandSortColumn switch
                {
                    "Name" => BrandSortAscending ? items.OrderBy(b => b.Name) : items.OrderByDescending(b => b.Name),
                    "ProductCount" => BrandSortAscending ? items.OrderBy(b => b.ProductCount) : items.OrderByDescending(b => b.ProductCount),
                    _ => items
                };
            }
            return items;
        }
    }

