                            <div class="inventory-view-empty"><i class="bi bi-box"></i><p>No product lines were returned by the GIN LoadRecord API.</p></div>
                        }
                    </div>
                </div>
                <div class="inventory-view-modal__footer">
                    <button type="button" class="btn-view-secondary" @onclick="CloseGinDetails">Close</button>
                </div>
            </div>
        </div>
    }
    @* GRN / Stock In Details — LoadRecord is called only when opened *@
    @if (IsGrnDetailsVisible && SelectedGrnDetails != null)
    {
        <div class="inventory-view-modal-overlay" @onclick="CloseGrnDetails">
            <div class="inventory-view-modal" @onclick:stopPropagation="true">
                <div class="inventory-view-modal__header">
                    <div class="inventory-view-modal__header-left">
                        <div class="inventory-view-modal__icon"><i class="bi bi-box-arrow-in-down"></i></div>
                        <div class="inventory-view-modal__title-group">
                            <h2>Stock In / GRN</h2>
                            <p class="inventory-view-modal__subtitle">Goods Received Note</p>
                        </div>
                    </div>
                    <button type="button" class="inventory-view-modal__close" @onclick="CloseGrnDetails" aria-label="Close"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="inventory-view-modal__body">
                    <div class="inventory-view-hero">
                        <div class="inventory-view-hero__item">
                            <span class="inventory-view-hero__label">GRN</span>
                            <strong class="inventory-view-hero__value">@SelectedGrnDetails.DOCNo</strong>
                        </div>
                        <div class="inventory-view-hero__divider"></div>
                        <div class="inventory-view-hero__item">
                            <span class="inventory-view-hero__label">DATE</span>
                            <span class="inventory-view-hero__text">@SelectedGrnDetails.Date.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="inventory-view-hero__divider"></div>
