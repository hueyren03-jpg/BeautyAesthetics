    private async Task LoadStockTransfersAsync()
    {
        IsStockTransferApiLoading = true;
        StockTransferApiError = null;
        TransferHistory = [];

        try
        {
            var branchId = BranchSession.CurrentBranch?.Id?.Trim();
            if (string.IsNullOrWhiteSpace(branchId))
            {
                StockTransferApiError = "Select a working branch before loading stock transfer history.";
                return;
            }

            // SenangRetails loads Stock Transfer history for the active branch with one
            // Doc_StockTransfer/LoadProxy request. Do not query every branch and then
            // re-filter the combined rows on the client.
            var result = await StockTransferSvc.LoadTransfersAsync(branchId);
            if (!result.Success || result.Value is null)
            {
                StockTransferApiError = result.ErrorMessage ?? "Unable to load stock transfers.";
                return;
            }

            TransferHistory = result.Value
                .Select(ToTransferHistoryItem)
                .GroupBy(
                    item => !string.IsNullOrWhiteSpace(item.DocumentId)
                        ? $"id:{item.DocumentId.Trim()}"
                        : $"code:{item.TransferNo.Trim()}",
                    StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderByDescending(item => item.DateIssued)
                .ToList();

            ReconcileStockTransferStatuses();
            StockTransferHistoryCurrentPage = 1;
        }
        finally
        {
            IsStockTransferApiLoading = false;
        }
    }

    private static TransferHistoryItem ToTransferHistoryItem(StockTransferViewModel transfer)
    {
        return new TransferHistoryItem
        {
            DocumentId = transfer.DocumentId,
            TransferNo = transfer.DisplayCode,
            DateIssued = transfer.Date,
            FromBranchId = transfer.FromBranchId,
            ToBranchId = transfer.ToBranchId,
            IssuedBy = string.IsNullOrWhiteSpace(transfer.FromBranchName)
                ? transfer.FromBranchId
                : transfer.FromBranchName,
            IssuedTo = string.IsNullOrWhiteSpace(transfer.ToBranchName)
                ? transfer.ToBranchId
                : transfer.ToBranchName,
        Status = NormalizeTransferStatus(transfer.Status),
            Notes = transfer.Remarks,
            TotalAmount = transfer.TotalAmount,
            Products = transfer.Lines.Select(line => new TransferProductLine
            {
                InventoryMovementId = line.InventoryMovementId,
                InventoryId = line.InventoryId,
                ProductName = line.ProductName,
                Sku = line.Sku,
                Quantity = (int)Math.Max(0, line.Quantity),
                UnitCost = line.UnitCost,
                Uom = line.UnitOfMeasurementId
            }).ToList()
    };
}

private static string NormalizeTransferStatus(string? status)
{
    if (string.IsNullOrWhiteSpace(status)) return "In Transit";

    var value = status.Trim();
    if (value.Contains("draft", StringComparison.OrdinalIgnoreCase)) return "Draft";
    if (value.Contains("cancel", StringComparison.OrdinalIgnoreCase) ||
        value.Contains("void", StringComparison.OrdinalIgnoreCase)) return "Cancelled";
    if (value.Contains("receive", StringComparison.OrdinalIgnoreCase) ||
        value.Contains("accept", StringComparison.OrdinalIgnoreCase) ||
        value.Contains("complete", StringComparison.OrdinalIgnoreCase) ||
        value.Contains("closed", StringComparison.OrdinalIgnoreCase)) return "Completed";
    if (value.Contains("pending", StringComparison.OrdinalIgnoreCase) ||
        value.Contains("transit", StringComparison.OrdinalIgnoreCase) ||
        value.Contains("dispatch", StringComparison.OrdinalIgnoreCase) ||
        value.Contains("posted", StringComparison.OrdinalIgnoreCase) ||
        value.Contains("open", StringComparison.OrdinalIgnoreCase) ||
        value.Contains("new", StringComparison.OrdinalIgnoreCase)) return "In Transit";

    return value;
}

private StockTransferProduct ToStockTransferProduct(InventoryViewModel.InventoryItem item)
    {
        var stockCount = item.StockQuantity;
        var reorderLevel = ParseStockDecimal(item.LowAlertCount);
        var stockStatus = !stockCount.HasValue
            ? "Not loaded"
            : stockCount.Value <= 0
                ? "Out of Stock"
                : reorderLevel > 0 && stockCount.Value <= reorderLevel
                    ? "Low Stock"
                    : "In Stock";

        return new StockTransferProduct
        {
            MasterAccountId = item.MasterAccountId,
            ProductName = item.Type,
            Sku = item.Sku,
            Price = item.Price,
            Uom1 = NormalizeStockUom(item.StockUom1),
            Uom2 = NormalizeStockUom(item.StockUom2),
            UnitOfMeasurementId = item.UnitOfMeasurementId,
            SupplierAccountId = item.SupplierAccountId,
            SupplierName = item.Supplier,
            InventoryTypeId = item.InventoryTypeId,
            ImagePath = item.ImagePath,
            ImageFileName = item.ImageFileName,
            ImageUrl = ResolveProductImage(item),
            StockCount = stockCount,
            StockStatus = stockStatus
        };
    }

