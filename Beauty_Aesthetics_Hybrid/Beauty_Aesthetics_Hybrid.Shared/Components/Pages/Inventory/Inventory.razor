                            <strong class="inventory-view-hero__value">@DisplayProductValue(SelectedProductDetails.Type)</strong>
                        </div>
                        <div class="inventory-view-hero__divider"></div>
                        <div class="inventory-view-hero__item">
                            <span class="inventory-view-hero__label">UNIT PRICE</span>
                            <strong class="inventory-view-hero__price">MYR @SelectedProductDetails.Price.ToString("N2")</strong>
                        </div>
                        <div class="inventory-view-hero__divider"></div>
                        <div class="inventory-view-hero__item">
