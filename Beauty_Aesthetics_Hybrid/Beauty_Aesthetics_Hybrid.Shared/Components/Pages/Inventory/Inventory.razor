    private IEnumerable<GRNItem> FilteredGRNs
    {
        get
        {
            var grns = GRNs.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(GRNSearchQuery))
            {
                var search = GRNSearchQuery.Trim();
                grns = grns.Where(item =>
                    item.DOCNo.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    item.Date.ToString("dd/MM/yyyy").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    item.Activity.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    item.Remarks.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    item.Amount.ToString("N2").Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            grns = ApplyGRNFilters(grns);
            return GRNSortColumn switch
            {
                "DOCNo" => GRNSortAscending ? grns.OrderBy(item => item.DOCNo) : grns.OrderByDescending(item => item.DOCNo),
                "Date" => GRNSortAscending ? grns.OrderBy(item => item.Date) : grns.OrderByDescending(item => item.Date),
                "Activity" => GRNSortAscending ? grns.OrderBy(item => item.Activity) : grns.OrderByDescending(item => item.Activity),
                "Remarks" => GRNSortAscending ? grns.OrderBy(item => item.Remarks) : grns.OrderByDescending(item => item.Remarks),
                "Amount" => GRNSortAscending ? grns.OrderBy(item => item.Amount) : grns.OrderByDescending(item => item.Amount),
                _ => grns
            };
        }
    }

    private IEnumerable<GRNItem> ApplyGRNFilters(IEnumerable<GRNItem> items)
    {
        if (ActiveGRNFilters == null || !ActiveGRNFilters.Any()) return items;
        var result = items;
        foreach (var filter in ActiveGRNFilters)
        {
            result = ApplyGRNFilter(result, filter);
        }
        return result;
    }

