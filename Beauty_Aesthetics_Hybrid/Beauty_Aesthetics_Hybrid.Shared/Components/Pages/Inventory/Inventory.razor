                returnedStock = returnedStock.Where(item =>
                    item.ReturnedStockNo.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    item.DateIssued.ToString("dd/MM/yyyy").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    item.Purpose.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    item.Reason.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    item.Amount.ToString("N2").Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            foreach (var filter in ActiveGINFilters)
            {
                returnedStock = ApplyGINFilter(returnedStock, filter);
            }

            return GINSortColumn switch
            {
                "ReturnedStockNo" => GINSortAscending ? returnedStock.OrderBy(item => item.ReturnedStockNo) : returnedStock.OrderByDescending(item => item.ReturnedStockNo),
                "DateIssued" => GINSortAscending ? returnedStock.OrderBy(item => item.DateIssued) : returnedStock.OrderByDescending(item => item.DateIssued),
                "Purpose" => GINSortAscending ? returnedStock.OrderBy(item => item.Purpose) : returnedStock.OrderByDescending(item => item.Purpose),
                "Amount" => GINSortAscending ? returnedStock.OrderBy(item => item.Amount) : returnedStock.OrderByDescending(item => item.Amount),
                _ => returnedStock
            };
        }
    }

    private void HandleGINFiltersApplied(List<MultiTableFilter.FilterData> filters)
    {
        ActiveGINFilters = filters;
        GINCurrentPage = 1;
        StateHasChanged();
    }

    private void HandleGINFiltersCleared()
    {
        ActiveGINFilters.Clear();
        GINCurrentPage = 1;
    }

    private IEnumerable<ReturnedStockItem> ApplyGINFilter(IEnumerable<ReturnedStockItem> items, MultiTableFilter.FilterData filter)
    {
        if (filter.Column == "DateIssued")
        {
            var start = filter.StartDate?.Date ?? DateTime.MinValue.Date;
            var end = filter.EndDate?.Date ?? DateTime.MaxValue.Date;
            return items.Where(item => item.DateIssued.Date >= start && item.DateIssued.Date <= end);
        }

        return filter.Column switch
        {
            "ReturnedStockNo" => items.Where(item => TextMatches(item.ReturnedStockNo, filter)),
            "Purpose" => items.Where(item => TextMatches(item.Purpose, filter)),
            "Reason" => items.Where(item => TextMatches(item.Reason, filter)),
            "Amount" => items.Where(item => InRange(item.Amount, filter)),
            _ => items
        };
    }

    private static bool TextMatches(string? source, MultiTableFilter.FilterData filter)
    {
        if(string.IsNullOrWhiteSpace(source)) return false;
        if(filter.Values.Count>0) return filter.Values.Any(v=>string.Equals(source.Trim(),v.Trim(),StringComparison.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(filter.Value)||source.Contains(filter.Value.Trim(),StringComparison.OrdinalIgnoreCase);
    }

    private static bool InRange(decimal? value, MultiTableFilter.FilterData filter) =>
        value.HasValue && (!filter.MinValue.HasValue||value.Value>=filter.MinValue.Value) && (!filter.MaxValue.HasValue||value.Value<=filter.MaxValue.Value);
    private static bool ContainsFilterValue(string? source, string value) =>
        !string.IsNullOrWhiteSpace(source) &&
        source.Contains(value.Trim(), StringComparison.OrdinalIgnoreCase);

