                            <p class="inventory-view-modal__subtitle">Complete product specification and stock parameters</p>
                        </div>
                    </div>
                    <div class="inventory-view-modal__header-right">
                        <span class="inventory-view-badge @(SelectedProductDetails.Locked ? "inventory-view-badge--danger" : "inventory-view-badge--success")">
                            @(SelectedProductDetails.Locked ? "Locked" : "Active")
