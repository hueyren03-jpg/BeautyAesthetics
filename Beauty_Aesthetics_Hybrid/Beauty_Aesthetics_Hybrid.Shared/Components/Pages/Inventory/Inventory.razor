                                                    {
                                                        @foreach (var product in FilteredReturnedStockProducts)
                                                        {
                                                            var isSelected = NewReturnedStock.SelectedProducts.ContainsKey(product.MasterAccountId);
                                                            var cannotSelect = string.IsNullOrWhiteSpace(product.MasterAccountId) ||
