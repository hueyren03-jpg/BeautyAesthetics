                                <span class="inventory-view-hero__label">ORDER DATE</span>
                                <span class="inventory-view-hero__text"><i class="bi bi-calendar3"></i> @SelectedPurchaseOrder.Date.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="inventory-view-hero__divider"></div>
                            <div class="inventory-view-hero__item">
                                <span class="inventory-view-hero__label">EXPECTED DELIVERY</span>
                                <span class="inventory-view-hero__text"><i class="bi bi-truck"></i> @SelectedPurchaseOrder.ExpectedDelivery.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        <div class="inventory-view-section">
                            <h3 class="inventory-view-section__title"><i class="bi bi-building"></i> Order & Supplier Information</h3>
                            <div class="inventory-view-grid inventory-view-grid--3">
                                <div class="inventory-view-field">
                                    <span class="inventory-view-field__label">Branch</span>
                                    <span class="inventory-view-field__value">@SelectedPurchaseOrder.Branch</span>
                                </div>
                                <div class="inventory-view-field">
                                    <span class="inventory-view-field__label">Supplier / Vendor</span>
                                    <span class="inventory-view-field__value">@SelectedPurchaseOrder.Vendor</span>
