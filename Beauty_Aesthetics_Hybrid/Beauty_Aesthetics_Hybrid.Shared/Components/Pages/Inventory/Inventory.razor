    private void HandleGRNPurchaseOrderChanged(ChangeEventArgs args)
    {
        NewGRNPONo = args.Value?.ToString() ?? string.Empty;
        var scannedItem = InventoryItems.FirstOrDefault(item =>
            !string.IsNullOrWhiteSpace(GRNScannedInventoryId) &&
            string.Equals(item.MasterAccountId, GRNScannedInventoryId, StringComparison.OrdinalIgnoreCase));

        if (scannedItem is null)
        {
            GRNBarcodeScanValue = string.Empty;
            GRNBarcodeScanMessage = null;
            GRNBarcodeScanSucceeded = false;
        }

        ApplySelectedPurchaseOrder();

        if (scannedItem is not null && !string.IsNullOrWhiteSpace(NewGRNPONo))
        {
            ApplyInventoryItemToGRN(scannedItem);
            GRNBarcodeScanSucceeded = true;
            GRNBarcodeScanMessage = $"{scannedItem.Type} matched to {NewGRNPONo}.";
            FocusGRNQuantityAfterRender = true;
        }
    }

    private void ApplySelectedPurchaseOrder(bool preserveReceiptValues = false)
    {
        var purchaseOrder = PurchaseOrders.FirstOrDefault(po =>
            string.Equals(po.PoNo, NewGRNPONo, StringComparison.OrdinalIgnoreCase));
        if (purchaseOrder is null)
        {
            return;
        }

        NewGRNPODate = purchaseOrder.Date;
        NewGRNSupplier = purchaseOrder.Vendor;
        if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNPODocumentId))
        {
            NewGRNPODocumentId = purchaseOrder.DocumentId;
        }
        if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNOrderDocumentLineId))
        {
            NewGRNOrderDocumentLineId = purchaseOrder.OrderDocumentLineId;
        }
        if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNAccountId))
        {
            NewGRNAccountId = purchaseOrder.SupplierAccountId;
        }
        if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNPaymentTermId))
        {
            NewGRNPaymentTermId = purchaseOrder.PaymentTermId;
        }
        if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNPaymentTermName))
        {
            NewGRNPaymentTermName = purchaseOrder.PaymentTerm;
        }
        NewGRNDOCBranch = ResolveGRNBranchId(purchaseOrder.Branch);
        if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNOrderBranchId))
        {
            NewGRNOrderBranchId = NewGRNDOCBranch;
        }

        if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNName))
        {
            NewGRNName = purchaseOrder.Product;
        }

        if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNRemarks))
        {
            NewGRNRemarks = purchaseOrder.Remarks;
        }

        ParsePurchaseOrderQuantity(purchaseOrder.Quantity, out var orderedQuantity, out var uom);
        if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNUom))
        {
            NewGRNUom = uom;
        }

        var item = InventoryItems.FirstOrDefault(candidate =>
            string.Equals(candidate.Type, purchaseOrder.Product, StringComparison.OrdinalIgnoreCase));
        if (item is not null)
        {
            if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNItemSku))
            {
                NewGRNItemSku = item.Sku;
            }

            if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNInventoryId))
            {
                NewGRNInventoryId = item.MasterAccountId;
            }

            if (!preserveReceiptValues || string.IsNullOrWhiteSpace(NewGRNUom))
            {
                NewGRNUom = string.IsNullOrWhiteSpace(item.UnitOfMeasurementId)
                    ? NormalizeStockUom(item.StockUom1)
                    : item.UnitOfMeasurementId;
            }

            if (!preserveReceiptValues || NewGRNUnitPrice <= 0)
            {
                NewGRNUnitPrice = item.Price;
            }

            NewGRNInventoryTypeId = item.InventoryTypeId;
            if (string.IsNullOrWhiteSpace(NewGRNAccountId))
            {
                NewGRNAccountId = item.SupplierAccountId;
            }
        }

        if (!preserveReceiptValues || NewGRNReceivedQuantity <= 0)
        {
            NewGRNReceivedQuantity = orderedQuantity > 0 ? orderedQuantity : 1m;
        }

    }

