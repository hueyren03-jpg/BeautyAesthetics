    private async Task SetActiveTab(string tab)
    {
        ActiveTab = tab;
        SelectedItem = null;

        // A branch can be selected/changed outside this page after Inventory was first
        // rendered. Refresh branch-scoped history when its tab is opened so the table
        // cannot remain stuck with an earlier HQ/branch request.
        await BranchSession.InitializeAsync();

        switch (tab)
        {
            case "GRN":
                await LoadGRNsAsync();
                break;
            case "ReturnedStock":
                await LoadGINsAsync();
                break;
            case "TransferOrders":
                await Task.WhenAll(
                    LoadStockTransfersAsync(),
                    LoadPendingStockReceiptsAsync());
                ReconcileStockTransferStatuses();
                break;
        }
    }

