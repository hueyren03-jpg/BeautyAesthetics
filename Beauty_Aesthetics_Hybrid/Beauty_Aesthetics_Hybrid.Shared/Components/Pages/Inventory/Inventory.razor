                @if (IsTransferHistoryPrintModeActive)
                {
                    <div class="inventory__delete-bar">
                        <div class="inventory__delete-info">
                            <span>@SelectedTransferHistoryReferencesForPrint.Count transfer(s) selected for print</span>
