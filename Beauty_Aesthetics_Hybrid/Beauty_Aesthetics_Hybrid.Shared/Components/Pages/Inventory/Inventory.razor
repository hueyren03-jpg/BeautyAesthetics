    private async Task HandleProductImageSelectedAsync(IBrowserFile file, bool isEdit)
    {
        ProductImageError = null;

        if (file is null || !file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            ProductImageError = "Select a valid JPG, PNG or WEBP image.";
            return;
        }

        const long maxImageBytes = 5 * 1024 * 1024;
        if (file.Size > maxImageBytes)
        {
            ProductImageError = "Image must be 5 MB or smaller.";
            return;
        }

        IsProductImageUploading = true;
        try
        {
            await using var previewStream = file.OpenReadStream(maxImageBytes);
            using var previewBuffer = new MemoryStream();
            await previewStream.CopyToAsync(previewBuffer);
            var preview = $"data:{file.ContentType};base64,{Convert.ToBase64String(previewBuffer.ToArray())}";

            var upload = await FileUploadAC.UploadImageAsync(file, "Inventory");
            if (!upload.Success || string.IsNullOrWhiteSpace(upload.Value))
            {
                ProductImageError = upload.ErrorMessage ?? "Unable to upload the product image.";
                return;
            }

            var (imagePath, imageFileName) = SplitUploadedImageLocation(upload.Value);
            if (isEdit)
            {
                if (EditProduct is null) return;
                EditProduct.ImagePath = imagePath;
                EditProduct.ImageFileName = imageFileName;
                EditProductImagePreview = preview;
            }
            else
            {
                NewProduct.ImagePath = imagePath;
                NewProduct.ImageFileName = imageFileName;
                NewProductImagePreview = preview;
            }
        }
        catch (IOException)
        {
            ProductImageError = "The selected image could not be read. Please choose another file.";
        }
        catch (Exception)
        {
            ProductImageError = "The product image could not be uploaded. Please try again.";
        }
        finally
        {
            IsProductImageUploading = false;
        }
    }

    private static (string ImagePath, string ImageFileName) SplitUploadedImageLocation(string uploadedLocation)
    {
        var normalized = (uploadedLocation ?? string.Empty).Trim().Replace('\\', '/');
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return (string.Empty, string.Empty);
        }

        var queryIndex = normalized.IndexOfAny(['?', '#']);
        var locationWithoutQuery = queryIndex >= 0 ? normalized[..queryIndex] : normalized;
        var separatorIndex = locationWithoutQuery.LastIndexOf('/');
        return separatorIndex >= 0
            ? (normalized[..separatorIndex], locationWithoutQuery[(separatorIndex + 1)..])
            : (string.Empty, locationWithoutQuery);
    }

