    private async Task HandleAddReturnedStock()
    {
        if (IsGINSaving) return;
        GINApiError = ValidateGINForm();
        if (!string.IsNullOrWhiteSpace(GINApiError)) return;

        IsGINSaving = true;
        try
        {
            var gin = new StockGinViewModel
            {
                DocumentId = NewReturnedStock.DocumentId,
                DisplayCode = NewReturnedStock.ReturnedStockNo,
                BranchId = string.IsNullOrWhiteSpace(NewReturnedStock.BranchId) ? InventoryBranchId : NewReturnedStock.BranchId,
                Date = NewReturnedStock.DateIssued == default ? DateTime.Today : NewReturnedStock.DateIssued,
                IssueType = NewReturnedStock.IssueType,
                ReferenceNumber = string.Empty,
                Remarks = NewReturnedStock.Reason,
                Lines = NewReturnedStock.SelectedProducts.Values.Select(product => new StockGinLineViewModel
                {
                    DocumentLineId = product.DocumentLineId,
                    InventoryId = product.InventoryId,
                    ProductName = product.ProductName,
                    Sku = product.Sku,
                    Quantity = product.Quantity,
                    UnitOfMeasurementId = product.UomId,
                    InventoryTypeId = product.InventoryTypeId,
                    UnitCost = Math.Max(0, product.UnitCost)
                }).ToList()
            };

            var result = IsGINEditMode
                ? await StockGinService.UpdateGinAsync(gin)
                : await StockGinService.CreateGinAsync(gin);
            if (!result.Success)
            {
                GINApiError = result.ErrorMessage ?? $"Unable to {(IsGINEditMode ? "update" : "create")} GIN.";
                return;
            }

            CloseAddReturnedStockModal();
            await Task.WhenAll(LoadGINsAsync(), LoadProductsAsync());
        }
        finally
        {
            IsGINSaving = false;
        }
    }

    private string? ValidateGINForm()
    {
        if (string.IsNullOrWhiteSpace(NewReturnedStock.IssueType))
            return "Select a stock out action.";
        if (NewReturnedStock.SelectedProducts.Count == 0)
            return "Select at least one product.";
        if (NewReturnedStock.SelectedProducts.Values.Any(product => product.Quantity <= 0))
            return "Every selected product needs a quantity greater than zero.";
        if (NewReturnedStock.SelectedProducts.Values.Any(product => product.UnitCost < 0))
            return "Product cost cannot be negative.";

        foreach (var selected in NewReturnedStock.SelectedProducts.Values)
        {
            var product = FindGinProduct(selected.InventoryId, selected.Sku);
            if (product?.StockCount is null) continue;
            var available = GetGinMaximumQuantity(product);
            if (selected.Quantity > available)
            {
                return $"{selected.ProductName} only has {available} {selected.UomDisplay} available.";
            }
        }

        return null;
    }

    private int GetGinMaximumQuantity(StockTransferProduct product)
    {
        if (!product.StockCount.HasValue) return int.MaxValue;
        var available = Math.Max(0, product.StockCount.Value);
        if (IsGINEditMode && NewReturnedStock.SelectedProducts.TryGetValue(product.MasterAccountId, out var selected))
        {
            available += selected.OriginalQuantity;
        }
        return (int)Math.Floor(available);
    }

    private string? GetGinMaximumQuantityAttribute(StockTransferProduct product) =>
        product.StockCount.HasValue ? GetGinMaximumQuantity(product).ToString(CultureInfo.InvariantCulture) : null;

