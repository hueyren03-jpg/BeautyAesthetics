    private IEnumerable<InventoryViewModel.InventoryItem> FilteredInventoryItems
    {
        get
        {
            var items = InventoryItems.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                var search = SearchQuery.Trim();
                items = items.Where(i =>
                    (!string.IsNullOrEmpty(i.Type) && i.Type.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(i.Sku) && i.Sku.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(i.Brand) && i.Brand.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(i.Category) && i.Category.Contains(search, StringComparison.OrdinalIgnoreCase))
                );
            }
            return items;
        }
    }

    private async Task HandleEditProduct()
    {
        if (IsProductSaving)
        {
            return;
        }

        if (SelectedItem == null || EditProduct == null)
        {
            CloseEditProductForm();
            return;
        }

        IsProductSaving = true;
        ProductApiError = null;
        try
        {
            var updatedItem = ToInventoryItem(EditProduct);
            var result = await ProductInventoryService.UpdateProductAsync(updatedItem, InventoryBranchId);
            if (!result.Success)
            {
                ProductApiError = result.ErrorMessage ?? "Unable to update product.";
                return;
            }

            ProductImageService.RemoveImage(EditProduct.MasterAccountId);
            CloseEditProductForm();
            await LoadProductsAsync();
        }
        finally
        {
            IsProductSaving = false;
        }
    }

