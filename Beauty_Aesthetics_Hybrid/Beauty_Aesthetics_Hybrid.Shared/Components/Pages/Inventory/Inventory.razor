    private async Task HandleSaveGRN()
    {
        GRNApiError = null;

        if (string.IsNullOrWhiteSpace(NewGRNStockActivityType))
        {
            GRNApiError = "Select a stock in action.";
            return;
        }

        if (NewGRNSelectedProducts.Count == 0)
        {
            GRNApiError = "Select at least one product.";
            return;
        }

        if (NewGRNSelectedProducts.Values.Any(item => item.Quantity <= 0))
        {
            GRNApiError = "Every selected product needs a quantity greater than zero.";
            return;
        }

        if (NewGRNSelectedProducts.Values.Any(item => item.UnitCost < 0))
        {
            GRNApiError = "Product cost cannot be negative.";
            return;
        }

        IsGRNApiLoading = true;
        try
        {
            var branchId = string.IsNullOrWhiteSpace(NewGRNDOCBranch) ? InventoryBranchId : NewGRNDOCBranch;
            var total = NewGRNSelectedProducts.Values.Sum(item => item.Quantity * item.UnitCost);
            var grn = new StockGrnViewModel
            {
                DocumentId = SelectedGRN?.DocumentId ?? string.Empty,
                BranchId = branchId,
                Date = NewGRNDate == default ? DateTime.Today : NewGRNDate,
                PostingDate = NewGRNDate == default ? DateTime.Today : NewGRNDate,
                DisplayCode = NewGRNDOCNo,
                Remarks = NewGRNRemarks,
                StockActivityType = NewGRNStockActivityType,
                Amount = total,
                TransactionCurrencyId = "MYR",
                LocalCurrencyId = "MYR",
                ExchangeRate = 1m,
                Lines = NewGRNSelectedProducts.Values.Select(item => new StockGrnLineViewModel
                {
                    DocumentLineId = item.DocumentLineId,
                    InventoryId = item.InventoryId,
                    ProductName = item.ProductName,
                    Sku = item.Sku,
                    Quantity = item.Quantity,
                    UnitOfMeasurementId = item.UomId,
                    InventoryTypeId = item.InventoryTypeId,
                    UnitCost = item.UnitCost
                }).ToList()
            };

            var result = IsGRNEditMode
                ? await StockGrnService.UpdateGrnAsync(grn, branchId)
                : await StockGrnService.CreateGrnAsync(grn, branchId);

            if (!result.Success)
            {
                GRNApiError = result.ErrorMessage ?? "Unable to save Stock In / GRN.";
                return;
            }

            await CloseAddGRNForm();
            await Task.WhenAll(LoadGRNsAsync(), LoadProductsAsync());
        }
        finally
        {
            IsGRNApiLoading = false;
        }
    }

    private async Task EditGRNFromRow(GRNItem grn)
    {
        if (!CanEditGrn(grn))
        {
            GRNApiError = "Posted or automatically generated GRNs are view-only.";
            return;
        }

        ResetGRNForm();
        SelectedGRN = grn;
        IsGRNEditMode = true;
        IsGRNApiLoading = true;

        try
        {
            var result = await StockGrnService.LoadGrnAsync(grn.DocumentId);
            if (result.Success && result.Value is not null)
            {
                PopulateGRNForm(result.Value);
            }
            else
            {
                PopulateGRNForm(new StockGrnViewModel
                {
                    DocumentId = grn.DocumentId,
                    BranchId = grn.DOCBranch,
                    Date = grn.Date,
                    DisplayCode = grn.DOCNo,
                    AccountId = grn.SupplierAccountId,
                    AccountName = grn.SupplierName,
                    PODisplayCode = grn.PONo,
                    PODocumentId = grn.PODocumentId,
                    ReferenceNumber = grn.ReferenceNumber,
                    PaymentTermName = grn.PaymentTermName,
                    TransactionCurrencyId = grn.CurrencyId,
                    TaxAmount = grn.TaxAmount,
                    Amount = grn.Amount,
                    VerifyStatus = grn.VerifyStatus,
                    IsLocked = grn.IsLocked,
                    IsVoid = grn.IsVoid
                });
                GRNApiError = result.ErrorMessage ?? "Full GRN details could not be loaded.";
            }

            IsAddGRNFormVisible = true;
        }
        finally
        {
            IsGRNApiLoading = false;
        }
    }

