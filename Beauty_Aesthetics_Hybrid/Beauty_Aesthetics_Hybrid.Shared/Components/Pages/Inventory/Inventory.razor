                        {
                            <div class="inventory-view-empty"><i class="bi bi-box"></i><p>No product lines were returned by the GRN LoadRecord API.</p></div>
                        }
                    </div>
                </div>
                <div class="inventory-view-modal__footer">
                    <button type="button" class="btn-view-secondary" @onclick="CloseGrnDetails">Close</button>
                </div>
            </div>
        </div>
    }


