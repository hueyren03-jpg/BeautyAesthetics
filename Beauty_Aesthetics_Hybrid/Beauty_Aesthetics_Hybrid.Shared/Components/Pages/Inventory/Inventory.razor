                                     </button>
                                     <button type="submit" class="supplier-view-modal__btn supplier-view-modal__btn--save">
                                         <i class="bi bi-check-lg"></i>
                                         Save Changes
                                     </button>
                                 </div>
                             </form>
                         }
                     </div>
                 </div>
             </div>
