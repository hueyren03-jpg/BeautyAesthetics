                                                                        <input type="number"
                                                                               min="0"
                                                                               step="0.01"
                                                                               class="stock-transfer__quantity-input"
                                                                               @bind="NewReturnedStock.SelectedProducts[product.MasterAccountId].UnitCost"
                                                                               @bind:event="oninput" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">—</span>
                                                                    }
                                                                </td>
                                                            </tr>
