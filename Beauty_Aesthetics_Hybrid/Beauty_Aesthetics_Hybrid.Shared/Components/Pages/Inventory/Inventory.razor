                                                <td class="inventory-row-actions-column gin-row-actions-column" @onclick:stopPropagation="true">
                                                    <button type="button" class="product-row-action" title="View GIN details" @onclick="() => ShowGinDetails(returnedStock)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <Pagination CurrentPage="@GINCurrentPage"
                            ItemsPerPage="5"
                            TotalItems="@FilteredReturnedStock.Count()"
