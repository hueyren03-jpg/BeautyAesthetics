    private static decimal ParseStockDecimal(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return 0;
        }

        var numeric = new string(value.Trim()
            .TakeWhile(character => char.IsDigit(character) || character is '.' or '-')
            .ToArray());
        return decimal.TryParse(numeric, out var parsed) ? parsed : 0;
    }

    private static string FormatStockCount(decimal? value) =>
        value.HasValue ? value.Value.ToString("0.##") : "-";
    private static string NormalizeStockUom(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Trim() == "-")
        {
            return "UNIT";
        }

        var trimmed = value.Trim().TrimStart('-').Trim();
        var firstSpace = trimmed.IndexOf(' ');
        return firstSpace > 0 && int.TryParse(trimmed[..firstSpace], out _)
            ? trimmed[(firstSpace + 1)..].Trim()
            : trimmed;
    }

