    private async Task EditReturnedStockFromRow(ReturnedStockItem returnedStock)
    {
        if (!CanEditGin(returnedStock))
        {
            GINApiError = "Posted GIN records are view-only.";
            return;
        }

        if (string.IsNullOrWhiteSpace(returnedStock.DocumentId))
        {
            GINApiError = "This GIN has no API document ID and cannot be edited.";
            return;
        }

        SelectedReturnedStock = returnedStock;
        IsGINApiLoading = true;
        GINApiError = null;
        try
        {
            var result = await StockGinService.LoadGinAsync(returnedStock.DocumentId);
            if (!result.Success || result.Value is null)
            {
                GINApiError = result.ErrorMessage ?? "Unable to load the GIN for editing.";
                return;
            }

            var gin = result.Value;
            var form = new NewReturnedStockModel
            {
                DocumentId = gin.DocumentId,
                ReturnedStockNo = gin.DisplayCode,
                DateIssued = gin.Date,
                BranchId = string.IsNullOrWhiteSpace(gin.BranchId) ? InventoryBranchId : gin.BranchId,
                IssueType = gin.IssueType,
                AccountId = gin.AccountId,
                IssuedTo = gin.AccountName,
                ReferenceNumber = gin.ReferenceNumber,
                Reason = gin.Remarks
            };

            foreach (var line in gin.Lines)
            {
                var product = FindGinProduct(line.InventoryId, line.Sku);
                var key = string.IsNullOrWhiteSpace(line.InventoryId) ? product?.MasterAccountId : line.InventoryId;
                if (string.IsNullOrWhiteSpace(key)) continue;

                var quantity = (int)Math.Max(1, Math.Round(line.Quantity));
                form.SelectedProducts[key] = new GinSelectedProductInfo
                {
                    DocumentLineId = line.DocumentLineId,
                    InventoryId = key,
                    ProductName = string.IsNullOrWhiteSpace(line.ProductName) ? product?.ProductName ?? "Product" : line.ProductName,
                    Sku = string.IsNullOrWhiteSpace(line.Sku) ? product?.Sku ?? string.Empty : line.Sku,
                    Quantity = quantity,
                    OriginalQuantity = quantity,
                    UomId = string.IsNullOrWhiteSpace(line.UnitOfMeasurementId)
                        ? product?.UnitOfMeasurementId ?? product?.Uom1 ?? "UNIT"
                        : line.UnitOfMeasurementId,
                    UomDisplay = product?.Uom1 ?? line.UnitOfMeasurementId,
                    InventoryTypeId = line.InventoryTypeId,
                    UnitCost = line.UnitCost
                };
            }

            NewReturnedStock = form;
            IsGINEditMode = true;
            ShowAddReturnedStockModalWindow = true;
        }
        finally
        {
            IsGINApiLoading = false;
        }
    }

