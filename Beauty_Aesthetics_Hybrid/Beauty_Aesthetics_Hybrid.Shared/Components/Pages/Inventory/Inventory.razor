    protected override async Task OnInitializedAsync()
    {
        ActiveTab = RequestedTab?.Trim().ToLowerInvariant() switch
        {
            "grn" => "GRN",
            "returnedstock" => "ReturnedStock",
            "transferorders" => "TransferOrders",
            "purchaseorders" => "PurchaseOrders",
            "inventoryoptions" => "InventoryOptions",
            "products" => "Products",
            _ => ActiveTab
        };

        // GIN, GRN, product balance and transfer history are branch-scoped.
        // Initialize the persisted/current branch before issuing any inventory API request;
        // otherwise InventoryBranchId falls back to HQ and valid history can appear empty.
        await BranchSession.InitializeAsync();
        await LoadStockTransferBranchesAsync();

        await Task.WhenAll(
            LoadProductsAsync(),
            LoadStockTransfersAsync(),
            LoadGRNsAsync(),
            LoadGINsAsync(),
            LoadPendingStockReceiptsAsync(),
            LoadCategoriesAsync());

        ReconcileStockTransferStatuses();
    }

