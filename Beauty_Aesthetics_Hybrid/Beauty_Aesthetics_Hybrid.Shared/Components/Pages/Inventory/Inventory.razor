    @* GIN / Stock Out Details — LoadRecord is called only when opened *@
    @if (IsGinDetailsVisible && SelectedGinDetails != null)
    {
        <div class="inventory-view-modal-overlay" @onclick="CloseGinDetails">
            <div class="inventory-view-modal" @onclick:stopPropagation="true">
