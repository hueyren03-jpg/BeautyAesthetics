                                                <span class="summary-value">@GINSelectedTotalQuantity.ToString("0.##")</span>
                                            </div>
                                            <div class="side-by-side summary-total-line">
                                                <span class="summary-total-text">Total Cost</span>
                                                <span class="summary-total-value">MYR @GINSelectedTotalCost.ToString("N2")</span>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
