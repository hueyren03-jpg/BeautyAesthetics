                        <div class="inventory-view-modal__title-group">
                            <h2>Stock Out / GIN</h2>
                            <p class="inventory-view-modal__subtitle">Goods Issue Note</p>
                        </div>
                    </div>
                    <button type="button" class="inventory-view-modal__close" @onclick="CloseGinDetails" aria-label="Close"><i class="bi bi-x-lg"></i></button>
