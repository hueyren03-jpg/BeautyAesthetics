                                    </div>
                                </div>
                                <div class="grn-modal__actions">
                                    <button class="grn-modal__btn grn-modal__btn--save"
                                            @onclick="HandleSaveGRN"
                                            disabled="@(IsGRNApiLoading || NewGRNSelectedProducts.Count == 0)">
                                        <i class="bi bi-check-lg"></i>
                                        @(IsGRNApiLoading ? "Saving..." : "Confirm Stock In")
                                    </button>
                                    <button class="grn-modal__btn grn-modal__btn--cancel" @onclick="CloseAddGRNForm">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                            <div class="grn-modal__body">
                                <form class="grn-form" @onsubmit:preventDefault>
                                    @if (!string.IsNullOrWhiteSpace(GRNApiError))
                                    {
                                        <div class="inventory__alert inventory__alert--error">@GRNApiError</div>
                                    }

                                    <section class="grn-form__section">
                                        <h3 class="grn-form__section-title">Stock In Details</h3>
                                        <div class="grn-form__grid">
                                            <div class="grn-form__field">
                                                <label for="grn-action">Action <span class="inventory__required">*</span></label>
                                                <select id="grn-action" @bind="NewGRNStockActivityType">
                                                    @foreach (var action in GRNStockInActions)
                                                    {
                                                        <option value="@action">@action</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="grn-form__field grn-form__field--wide">
                                                <label for="grn-remarks">Remarks <span class="grn-form__optional">Optional</span></label>
                                                <textarea id="grn-remarks"
                                                          @bind="NewGRNRemarks"
                                                          rows="2"
                                                          placeholder="Remarks"></textarea>
                                            </div>
                                        </div>
                                    </section>

                                    <section class="grn-form__section">
                                        <div class="gin-section-heading">
                                            <div>
                                                <h3>Add Product</h3>
                                                <p>Select products, then enter quantity and cost.</p>
                                            </div>
                                            <span>@NewGRNTotalSku selected</span>
                                        </div>

                                        <div class="stock-transfer__product-search">
                                            <input type="search"
                                                   placeholder="Search product name or SKU..."
                                                   @bind="GRNItemProductSearch"
                                                   @bind:event="oninput" />
                                            <i class="bi bi-search"></i>
                                        </div>

                                        <div class="stock-transfer__product-list">
                                            <table class="stock-transfer__selection-table product-picker-table">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 54px;">Select</th>
                                                        <th class="product-picker-table__image-heading">Image</th>
                                                        <th>Product</th>
                                                        <th>Qty</th>
                                                        <th>Cost (MYR)</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (!FilteredGRNStockInProducts.Any())
                                                    {
                                                        <tr>
                                                            <td colspan="5" class="gin-product-table__empty">No matching products found.</td>
                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var product in FilteredGRNStockInProducts)
                                                        {
                                                            var isSelected = NewGRNSelectedProducts.ContainsKey(product.MasterAccountId);
                                                            var cannotSelect = string.IsNullOrWhiteSpace(product.MasterAccountId);
                                                            <tr class="product-picker-row @(isSelected ? "product-picker-row--selected" : string.Empty) @(cannotSelect ? "product-picker-row--disabled" : string.Empty)"
                                                                @onclick="() => ToggleGRNStockInProductSelection(product)">
                                                                <td @onclick:stopPropagation="true">
                                                                    <input type="checkbox"
                                                                           checked="@isSelected"
                                                                           disabled="@cannotSelect"
                                                                           @onchange="() => ToggleGRNStockInProductSelection(product)" />
                                                                </td>
                                                                <td class="product-picker-table__image-cell">
                                                                    <img src="@GetProductPickerImage(product)" alt="@product.ProductName" loading="lazy" />
                                                                </td>
                                                                <td class="product-picker-table__product-cell">
                                                                    <strong>@product.ProductName</strong>
                                                                    <small>@product.Sku · Stock: @FormatStockCount(product.StockCount) @product.Uom1</small>
                                                                </td>
                                                                <td @onclick:stopPropagation="true">
                                                                    @if (isSelected)
                                                                    {
                                                                        <input type="number"
                                                                               min="0.01"
                                                                               step="0.01"
                                                                               class="stock-transfer__quantity-input"
                                                                               @bind="NewGRNSelectedProducts[product.MasterAccountId].Quantity"
                                                                               @bind:event="oninput" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">—</span>
                                                                    }
                                                                </td>
                                                                <td @onclick:stopPropagation="true">
                                                                    @if (isSelected)
                                                                    {
                                                                        <input type="number"
                                                                               min="0"
                                                                               step="0.01"
                                                                               class="stock-transfer__quantity-input"
                                                                               @bind="NewGRNSelectedProducts[product.MasterAccountId].UnitCost"
                                                                               @bind:event="oninput" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">—</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="delivery-order-total summary-card-container">
                                            <div class="side-by-side summary-line">
                                                <span class="summary-text">Total SKU</span>
                                                <span class="summary-value">@NewGRNTotalSku</span>
                                            </div>
                                            <div class="side-by-side summary-line">
                                                <span class="summary-text">Total Quantity</span>
                                                <span class="summary-value">@NewGRNTotalQuantity.ToString("0.##")</span>
                                            </div>
                                            <div class="side-by-side summary-total-line">
                                                <span class="summary-total-text">Total Cost</span>
                                                <span class="summary-total-value">MYR @NewGRNTotalCost.ToString("N2")</span>
                                            </div>
                                        </div>
                                    </section>
                                </form>
                            </div>
                        </div>
                    </div>
                }


                @if (IsGRNBarcodeScannerVisible)
                {
                    <div class="grn-barcode-camera-overlay" @onclick="CloseGRNBarcodeScannerAsync">
                        <section class="grn-barcode-camera" role="dialog" aria-modal="true" aria-labelledby="grn-camera-title" @onclick:stopPropagation="true">
                            <header class="grn-barcode-camera__header">
                                <div>
                                    <span>GRN receiving</span>
                                    <h3 id="grn-camera-title">Scan received product</h3>
                                </div>
                                <button type="button" @onclick="CloseGRNBarcodeScannerAsync" aria-label="Close barcode scanner"><i class="bi bi-x-lg"></i></button>
                            </header>
                            <div class="grn-barcode-camera__viewport">
                                <video @ref="GRNBarcodeVideoElement" autoplay playsinline muted></video>
                                <div class="grn-barcode-camera__target" aria-hidden="true"><span></span></div>
                                @if (IsGRNBarcodeScannerStarting)
                                {
                                    <div class="grn-barcode-camera__loading"><span class="spinner-border spinner-border-sm"></span> Starting camera...</div>
                                }
                            </div>
                            <p><i class="bi bi-brightness-high"></i> Keep the product barcode inside the frame and hold the device steady.</p>
                            <button type="button" class="grn-barcode-camera__cancel" @onclick="CloseGRNBarcodeScannerAsync">Cancel scan</button>
                        </section>
                    </div>
                }
            </div>
        }
    </div>

    @* Product View Details Modal *@
    @if (IsProductDetailsVisible && SelectedProductDetails != null)
    {
        <div class="inventory-view-modal-overlay" @onclick="CloseProductDetails">
            <div class="inventory-view-modal" @onclick:stopPropagation="true">
