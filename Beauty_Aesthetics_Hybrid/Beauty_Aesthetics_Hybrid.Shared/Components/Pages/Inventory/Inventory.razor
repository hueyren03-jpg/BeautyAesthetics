    private async Task HandleCreateTransfer()
    {
        if (IsStockTransferSaving)
        {
            return;
        }

        StockTransferApiError = null;

        if (string.IsNullOrWhiteSpace(NewTransfer.IssuedBy))
        {
            StockTransferApiError = "Source branch is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NewTransfer.IssuedTo))
        {
            StockTransferApiError = "Destination branch is required.";
            return;
        }

        var sourceBranch = StockTransferBranches.FirstOrDefault(
            branch => string.Equals(branch.Id, NewTransfer.IssuedBy.Trim(), StringComparison.OrdinalIgnoreCase));
        var destinationBranch = StockTransferBranches.FirstOrDefault(
            branch => string.Equals(branch.Id, NewTransfer.IssuedTo.Trim(), StringComparison.OrdinalIgnoreCase));

        if (sourceBranch is null || destinationBranch is null)
        {
            StockTransferApiError = "Select valid source and destination branches from the list.";
            return;
        }

        if (string.Equals(sourceBranch.Id, destinationBranch.Id, StringComparison.OrdinalIgnoreCase))
        {
            StockTransferApiError = "Source and destination branches must be different.";
            return;
        }

        if (NewTransfer.SelectedProducts.Count == 0)
        {
            StockTransferApiError = "Select at least one product.";
            return;
        }

        var lines = new List<StockTransferLineViewModel>();
        foreach (var selectedProduct in NewTransfer.SelectedProducts)
        {
            var product = TransferSelectionProducts.FirstOrDefault(item => item.Sku == selectedProduct.Key);
            if (product is null || string.IsNullOrWhiteSpace(product.MasterAccountId))
            {
                StockTransferApiError = $"Inventory ID is missing for {selectedProduct.Key}.";
                return;
            }

            if (selectedProduct.Value <= 0)
            {
                StockTransferApiError = $"Quantity for {selectedProduct.Key} must be greater than zero.";
                return;
            }

            if (product.StockCount is null)
            {
                StockTransferApiError = $"Stock balance for {selectedProduct.Key} is not loaded. Refresh products before transferring.";
                return;
            }

            if (selectedProduct.Value > product.StockCount.Value)
            {
                StockTransferApiError = "Quantity for " + selectedProduct.Key + " cannot exceed available stock (" + product.StockCount.Value.ToString("0.##") + ").";
                return;
            }

            lines.Add(new StockTransferLineViewModel
            {
                InventoryId = product.MasterAccountId,
                Sku = product.Sku,
                ProductName = product.ProductName,
                Quantity = selectedProduct.Value,
                UnitCost = NewTransfer.SelectedCosts.TryGetValue(selectedProduct.Key, out var unitCost) ? Math.Max(0, unitCost) : Math.Max(0, product.Price),
                InventoryTypeId = product.InventoryTypeId,
                UnitOfMeasurementId = string.IsNullOrWhiteSpace(product.UnitOfMeasurementId)
                    ? (string.IsNullOrWhiteSpace(product.Uom1) ? "UNIT" : product.Uom1)
                    : product.UnitOfMeasurementId
            });
        }

        var transfer = new StockTransferViewModel
        {
            Date = NewTransfer.DateIssued,
            BranchId = sourceBranch.Id,
            FromBranchId = sourceBranch.Id,
            FromBranchName = sourceBranch.Name,
            ToBranchId = destinationBranch.Id,
            ToBranchName = destinationBranch.Name,
            Remarks = NewTransfer.Notes.Trim(),
            Lines = lines
        };

        IsStockTransferSaving = true;
        try
        {
            var result = await StockTransferSvc.CreateTransferAsync(transfer);
            if (!result.Success)
            {
                StockTransferApiError = result.ErrorMessage ?? "Unable to create stock transfer.";
                return;
            }

            CloseAddTransferModal();
            await Task.WhenAll(
                LoadStockTransfersAsync(),
                LoadPendingStockReceiptsAsync(),
                LoadProductsAsync());
            ReconcileStockTransferStatuses();
            StockTransferSuccessMessage = "Transfer created successfully and is now In Transit.";
            StockTransferHistoryCurrentPage = 1;
        }
        finally
        {
            IsStockTransferSaving = false;
        }
    }
