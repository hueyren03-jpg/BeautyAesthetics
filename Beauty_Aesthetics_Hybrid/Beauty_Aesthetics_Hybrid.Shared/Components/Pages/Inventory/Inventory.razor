                                     PO No.<span class="resize-handle"></span>
                                 </th>
                                 <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "Date")' @onclick='() => TogglePurchaseOrderSort("Date")'>
                                     Date<span class="resize-handle"></span>
                                 </th>
                                 <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "Branch")' @onclick='() => TogglePurchaseOrderSort("Branch")'>
                                     Branch<span class="resize-handle"></span>
                                 </th>
                                 <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "Supplier")' @onclick='() => TogglePurchaseOrderSort("Supplier")'>
                                     Supplier<span class="resize-handle"></span>
                                 </th>
                                 <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "Status")' @onclick='() => TogglePurchaseOrderSort("Status")'>
                                    Status<span class="resize-handle"></span>
                                </th>
                                <th class='@GetSortHeaderClass(PurchaseOrderSortColumn, PurchaseOrderSortAscending, "Remarks")' @onclick='() => TogglePurchaseOrderSort("Remarks")'>
                                    Remarks<span class="resize-handle"></span>
                                </th>
                                @if (!IsPrintModeActive)
                                {
                                    <th class="inventory-row-actions-column po-row-actions-column">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var po in PaginatedPurchaseOrders)
                            {
                                <tr @onclick="() => OpenPurchaseOrderDetails(po)" class="@GetPurchaseOrderRowClass(po)">
                                    @if (IsPrintModeActive)
                                    {
                                        <td class="purchase-orders__checkbox-col" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   checked="@SelectedPurchaseOrdersForPrint.Contains(po)"
                                                   @onchange="() => TogglePurchaseOrderForPrintSelection(po)" />
                                        </td>
                                    }
                                    <td>@po.PoNo</td>
                                    <td>@po.Date.ToString("dd/MM/yyyy")</td>
                                    <td><span class="inventory-branch-chip">@po.Branch</span></td>
                                    <td>@po.Vendor</td>

                                    <td>
                                        <span class="purchase-orders__status purchase-orders__status--@po.Status.ToLower().Replace(" ", "-")">
                                            @po.Status
                                        </span>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(po.Remarks) ? "-" : po.Remarks)</td>
                                    @if (!IsPrintModeActive)
                                    {
                                        <td class="inventory-row-actions-column po-row-actions-column" @onclick:stopPropagation="true">
                                            <div class="po-row-actions">
                                                <button type="button" class="product-row-action" title="View purchase order" aria-label="View purchase order" @onclick="() => ShowPurchaseOrderDetails(po)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button type="button" class="product-row-action" title="Edit purchase order" aria-label="Edit purchase order" @onclick="() => ShowEditPurchaseOrderForm(po)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination CurrentPage="@PurchaseOrdersCurrentPage"
                            ItemsPerPage="5"
                            TotalItems="@FilteredPurchaseOrders.Count()"
                            OnPageChanged="@HandlePurchaseOrdersPageChanged" />
                <div class="pagination-summary">
                    Total items: @FilteredPurchaseOrders.Count()
                </div>
            </div>
        }


        @* Add Purchase Order Modal *@
        @if (IsAddPurchaseOrderFormVisible)
        {
            <div class="po-modal-overlay" @onclick="CloseAddPurchaseOrderForm">
                <div class="po-modal" @onclick:stopPropagation="true">
                    <div class="po-modal__header">
                        <div class="po-modal__title">
                            <i class="bi bi-cart-plus"></i>
                            <h2>@(EditingPurchaseOrder is null ? "Add New Purchase Order" : "Edit Purchase Order")</h2>
                        </div>
                        <div class="po-modal__actions">
                            <button type="button" class="po-modal__btn po-modal__btn--save" @onclick="HandleSavePurchaseOrder">
                                Save
                            </button>
                            <button type="button" class="po-modal__btn po-modal__btn--cancel" @onclick="CloseAddPurchaseOrderForm">
                                Cancel
                            </button>
                        </div>
                    </div>
                    <div class="po-modal__body">
                        <form class="po-form" @onsubmit:preventDefault>
                            <div class="inventory__form-row">
                                <div class="inventory__form-group">
                                    <label>PO No.</label>
                                    <input type="text" @bind="NewPurchaseOrder.PoNo" required />
                                </div>
                                <div class="inventory__form-group">
                                    <label>Date</label>
                                    <input type="date" @bind="NewPurchaseOrder.Date" required />
                                </div>
                            </div>
                            <div class="inventory__form-row">
                                <div class="inventory__form-group">
                                    <label>Branch</label>
                                    <input type="text" @bind="NewPurchaseOrder.Branch" required />
                                </div>
                                <div class="inventory__form-group">
                                    <label>Vendor</label>
                                    <select @bind="NewPurchaseOrder.Vendor" required>
                                        <option value="">Select Vendor</option>
                                        @foreach (var supplier in Suppliers)
                                        {
                                            <option value="@supplier.Name">@supplier.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="inventory__form-row">
                                <div class="inventory__form-group">
                                    <label>PO Type</label>
                                    <select @bind="NewPurchaseOrder.PoType" required>
                                        <option value="">Select PO Type</option>
                                        <option value="Standard">Standard</option>
                                        <option value="Express">Express</option>
                                        <option value="Urgent">Urgent</option>
                                        <option value="Bulk">Bulk</option>
                                    </select>
                                </div>
                                <div class="inventory__form-group">
                                    <label>Product</label>
                                    <select @bind="NewPurchaseOrder.Product" required>
                                        <option value="">Select Product</option>
                                        @foreach (var item in InventoryItems)
                                        {
                                            <option value="@item.Type">@item.Type</option>
                                        }
                                    </select>
                                    @if (SelectedPurchaseOrderInventoryProduct is not null)
                                    {
                                        <div class="product-selection-preview">
                                            <div class="gin-product-option__image">
                                                @if (HasInventoryImage(SelectedPurchaseOrderInventoryProduct))
                                                {
                                                    <img src="@ResolveProductImage(SelectedPurchaseOrderInventoryProduct)" alt="" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-box-seam"></i>
                                                }
                                            </div>
                                            <div>
                                                <strong>@SelectedPurchaseOrderInventoryProduct.Type</strong>
                                                <span>@SelectedPurchaseOrderInventoryProduct.Sku</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="inventory__form-row">
                                <div class="inventory__form-group">
                                    <label>Quantity (UOM2)</label>
                                    <input type="text" @bind="NewPurchaseOrder.Quantity" placeholder="e.g., 10 boxes" required />
                                </div>
                                <div class="inventory__form-group">
                                    <label>Payment Term</label>
                                    <select @bind="NewPurchaseOrder.PaymentTerm" required>
                                        <option value="">Select Payment Term</option>
                                        <option value="Cash">Cash</option>
                                        <option value="Net 30">Net 30</option>
                                        <option value="Net 60">Net 60</option>
                                        <option value="Net 90">Net 90</option>
                                        <option value="COD">COD (Cash on Delivery)</option>
                                        <option value="Credit Card">Credit Card</option>
                                    </select>
                                </div>
                            </div>
                            <div class="inventory__form-row">
                                <div class="inventory__form-group">
                                    <label>Expected Delivery</label>
                                    <input type="date" @bind="NewPurchaseOrder.ExpectedDelivery" required />
                                </div>
                                <div class="inventory__form-group">
                                    <label>Status</label>
                                    <select @bind="NewPurchaseOrder.Status" required>
                                        <option value="Pending">Pending</option>
                                        <option value="Approved">Approved</option>
                                        <option value="Received">Received</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </div>
                            </div>
                            <div class="inventory__form-group">
                                <label>Remarks</label>
                                <textarea @bind="NewPurchaseOrder.Remarks" rows="3" placeholder="Enter remarks..."></textarea>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* View Purchase Order Details Modal *@
        @if (IsPurchaseOrderDetailsVisible && SelectedPurchaseOrder != null)
        {
            <div class="inventory-view-modal-overlay" @onclick="ClosePurchaseOrderDetails">
                <div class="inventory-view-modal" @onclick:stopPropagation="true">
                    <div class="inventory-view-modal__header">
                        <div class="inventory-view-modal__header-left">
                            <div class="inventory-view-modal__icon"><i class="bi bi-receipt"></i></div>
