    private async Task ConfirmDelete()
    {
        if (!SelectedItemsForDeletion.Any())
        {
            IsDeleteMode = false;
            return;
        }

        ProductApiError = null;
        var deletedItems = new List<InventoryViewModel.InventoryItem>();
        foreach (var item in SelectedItemsForDeletion.ToList())
        {
            var result = await ProductInventoryService.DeleteProductAsync(item);
            if (!result.Success)
            {
                ProductApiError = result.ErrorMessage ?? $"Unable to delete {item.Type}.";
                continue;
            }

            deletedItems.Add(item);

            if (SelectedItem != null && SelectedItem.Equals(item))
            {
                SelectedItem = null;
            }
        }

        foreach (var item in deletedItems)
        {
            InventoryItems.Remove(item);
        }

        SelectedItemsForDeletion.Clear();
        IsDeleteMode = false;

        var remainingCount = FilteredItems.Count();
        var totalPages = Math.Max(1, (int)Math.Ceiling(remainingCount / (double)ProductsPerPage));

        if (ProductsCurrentPage > totalPages)
        {
            ProductsCurrentPage = totalPages;
        }
    }

