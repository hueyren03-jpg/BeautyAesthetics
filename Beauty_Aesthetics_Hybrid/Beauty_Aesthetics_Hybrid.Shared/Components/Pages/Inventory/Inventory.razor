                                             <label class="supplier-view-details__label">Supplier Name</label>
                                             <span class="supplier-view-details__value">@SelectedSupplier.Name</span>
                                         </div>
                                     </div>

                                     <div class="supplier-view-details__card">
                                         <div class="supplier-view-details__icon">
                                             <i class="bi bi-telephone"></i>
                                         </div>
                                         <div class="supplier-view-details__content">
                                             <label class="supplier-view-details__label">Contact Number</label>
                                             <span class="supplier-view-details__value">@SelectedSupplier.ContactNumber</span>
                                         </div>
                                     </div>

                                     <div class="supplier-view-details__card">
                                         <div class="supplier-view-details__icon">
                                             <i class="bi bi-geo-alt"></i>
                                         </div>
                                         <div class="supplier-view-details__content">
                                             <label class="supplier-view-details__label">Address</label>
                                             <span class="supplier-view-details__value">@SelectedSupplier.Address</span>
                                         </div>
                                     </div>

                                     <div class="supplier-view-details__card supplier-view-details__card--full">
                                         <div class="supplier-view-details__icon">
                                             <i class="bi bi-file-text"></i>
                                         </div>
                                         <div class="supplier-view-details__content">
                                             <label class="supplier-view-details__label">Description</label>
                                             <textarea class="supplier-view-form__textarea" @bind="EditSupplierDescription" rows="4" placeholder="Enter supplier description..."></textarea>
                                         </div>
                                     </div>

                                     <div class="supplier-view-details__card supplier-view-details__card--highlight">
                                         <div class="supplier-view-details__icon supplier-view-details__icon--highlight">
                                             <i class="bi bi-box-seam"></i>
                                         </div>
                                         <div class="supplier-view-details__content">
                                             <label class="supplier-view-details__label">Products Assigned</label>
                                             <span class="supplier-view-details__value supplier-view-details__value--highlight">
                                                 @SelectedSupplier.ProductCount products
                                             </span>
                                         </div>
                                     </div>
                                 </div>
