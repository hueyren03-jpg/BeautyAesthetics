    public async ValueTask DisposeAsync()
    {
        if (_inventoryModule != null)
        {
            try
            {
                await _inventoryModule.InvokeVoidAsync("stopBarcodeScanner");
            }
            catch (JSDisconnectedException)
            {
                // Ignored on disconnect
            }
            catch (JSException)
            {
                // The scanner was not active or already stopped.
            }

            try
            {
                await _inventoryModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Ignored on disconnect
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error disposing inventory module: {ex.Message}");
            }
        }

        GRNBarcodeDotNetReference?.Dispose();
        GRNBarcodeDotNetReference = null;
    }

