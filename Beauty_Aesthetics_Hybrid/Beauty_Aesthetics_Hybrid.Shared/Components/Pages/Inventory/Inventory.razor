        else if (ActiveTab == "PurchaseOrders")
         {
             <div class="stock-transfer">
                 <div class="stock-transfer__header">
                     <div class="inventory__toolbar-primary">
                         <div class="purchase-orders__actions">
                             <button class="tab-btn stock-transfer__action-btn" @onclick="ShowAddPurchaseOrderForm">
                                 <i class="bi bi-plus-lg"></i>
                             </button>
                             @if (!IsPrintModeActive)
                             {
                                 <button class="tab-btn stock-transfer__btn-with-text stock-transfer__btn-with-text--light" @onclick="ActivatePrintMode">
                                     <i class="bi bi-printer"></i> <span>Print</span>
                                 </button>
                             }
                             else
                             {
                                 <button class="tab-btn inventory__btn inventory__btn--success" @onclick="ConfirmPrint" disabled="@(!SelectedPurchaseOrdersForPrint.Any())">
                                     <i class="bi bi-check-circle"></i> Confirm Print
