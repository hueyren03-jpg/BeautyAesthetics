    private async Task HandleAddCategory()
    {
        if (IsCategorySaving)
        {
            return;
        }

        var categoryName = NewCategoryName.Trim();
        var externalCode = NewCategoryExternalCode.Trim();

        if (string.IsNullOrWhiteSpace(categoryName))
        {
            CategoryApiError = "Category name is required.";
            return;
        }

        IsCategorySaving = true;
        CategoryApiError = null;

        try
        {
            var result = await InventoryOptionService.CreateCategoryAsync(categoryName, externalCode);
            if (!result.Success)
            {
                CategoryApiError = result.ErrorMessage ?? "Unable to create category.";
                return;
            }

            var displayCode = string.IsNullOrWhiteSpace(externalCode)
                ? result.Value?.Id ?? "-"
                : externalCode;

            Categories.Insert(0, new CategoryItem(result.Value?.Id ?? string.Empty, categoryName, displayCode));
            CategoriesCurrentPage = 1;
            CloseAddCategoryForm(force: true);
        }
        finally
        {
            IsCategorySaving = false;
        }
    }

    private void ShowEditCategoryForm(CategoryItem category)
    {
        if (string.IsNullOrWhiteSpace(category.Id))
        {
            CategoryApiError = "Category id is missing.";
            return;
        }

        IsEditCategoryFormVisible = true;
        EditCategoryId = category.Id;
        EditCategoryName = category.Name;
        EditCategoryExternalCode = category.ExternalCode == category.Id || category.ExternalCode == "-" ? string.Empty : category.ExternalCode;
        CategoryApiError = null;
    }

    private void CloseEditCategoryForm(bool force = false)
    {
        if (IsCategorySaving && !force)
        {
            return;
        }

        IsEditCategoryFormVisible = false;
        EditCategoryId = string.Empty;
        EditCategoryName = string.Empty;
        EditCategoryExternalCode = string.Empty;
        CategoryApiError = null;
    }

    private async Task HandleEditCategory()
    {
        if (IsCategorySaving)
        {
            return;
        }

        var categoryId = EditCategoryId.Trim();
        var categoryName = EditCategoryName.Trim();
        var externalCode = EditCategoryExternalCode.Trim();

        if (string.IsNullOrWhiteSpace(categoryId))
        {
            CategoryApiError = "Category id is missing.";
            return;
        }

        if (string.IsNullOrWhiteSpace(categoryName))
        {
            CategoryApiError = "Category name is required.";
            return;
        }

        IsCategorySaving = true;
        CategoryApiError = null;

        try
        {
            var result = await InventoryOptionService.UpdateCategoryAsync(categoryId, categoryName, externalCode);
            if (!result.Success)
            {
                CategoryApiError = result.ErrorMessage ?? "Unable to update category.";
                return;
            }

            CloseEditCategoryForm(force: true);
            await LoadCategoriesAsync();
        }
        finally
        {
            IsCategorySaving = false;
        }
    }
