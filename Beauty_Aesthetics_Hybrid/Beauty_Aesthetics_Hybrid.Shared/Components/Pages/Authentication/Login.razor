@page "/login"
@namespace Beauty_Aesthetics_WebPos.Components.Pages
@layout EmptyLayout
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject AppFeedbackService Feedback

<main class="login-page">
    <section class="login-shell" aria-labelledby="login-title">
        <div class="login-main">
            <div class="brand-panel">
                <div class="brand-mark" aria-hidden="true">
                    <i class="fa-solid fa-spa"></i>
                </div>
                <h1 id="login-title">Beauty Aesthetics</h1>
                <p class="brand-copy">Clinic Management</p>
            </div>

            <div class="login-card">
                <EditForm Model="loginModel" OnValidSubmit="SignInAsync">
                    <div class="login-form">
                        <label class="login-field">
                            <span>Email Address</span>
                            <div class="input-frame">
                                <i class="fa-regular fa-envelope"></i>
                                <input @bind="loginModel.Email"
                                       class="login-input"
                                       type="email"
                                       autocomplete="username"
                                       inputmode="email"
                                       disabled="@isSigningIn"
                                       placeholder="staff@beautyaesthetics.com" />
                            </div>
                        </label>

                        <label class="login-field">
                            <span>Password</span>
                            <div class="input-frame">
                                <i class="fa-solid fa-lock"></i>
                                <input @bind="loginModel.Password"
                                       class="login-input"
                                       type="@(showPassword ? "text" : "password")"
                                       autocomplete="current-password"
                                       disabled="@isSigningIn"
                                       placeholder="@PasswordPlaceholder" />
                                <button type="button"
                                        class="password-toggle"
                                        disabled="@isSigningIn"
                                        aria-label="@(showPassword ? "Hide password" : "Show password")"
                                        @onclick="TogglePassword">
                                    <i class="fa-regular @(showPassword ? "fa-eye-slash" : "fa-eye")"></i>
                                </button>
                            </div>
                        </label>

                        <div class="login-options">
                            <label class="remember-row">
                                <input @bind="loginModel.RememberMe"
                                       class="remember-checkbox"
                                       disabled="@isSigningIn"
                                       type="checkbox" />
                                <span>Remember me</span>
                            </label>
                            <button type="button"
                                    class="forgot-link"
                                    disabled="@isSigningIn"
                                    @onclick="ShowForgotPasswordInfo">Forgot password?</button>
                        </div>

                        <button type="submit" class="sign-in-button @(isSigningIn ? "loading" : null)" disabled="@isSigningIn">
                            @if (isSigningIn)
                            {
                                <span class="button-spinner" aria-hidden="true"></span>
                                <span>Signing in...</span>
                            }
                            else
                            {
                                <span>Sign In</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>

            <div class="secure-note">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Authorized staff only</span>
            </div>
        </div>

        <footer class="login-footer">
            <p>&copy; 2024 Beauty Aesthetics Clinic Management. Secure Professional Portal.</p>
            <div class="footer-links">
                <button type="button" @onclick='() => ShowLinkUnavailable("Privacy Policy")'>Privacy Policy</button>
                <button type="button" @onclick='() => ShowLinkUnavailable("Terms of Service")'>Terms of Service</button>
                <button type="button" @onclick='() => ShowLinkUnavailable("Support")'>Support</button>
            </div>
        </footer>
    </section>
</main>

<AppErrorPopup Title="Sign in failed" Message="@loginError" />

@code {
    private const string PasswordPlaceholder = "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022";
    private readonly LoginFormModel loginModel = new()
    {
        RememberMe = true
    };

    private bool showPassword;
    private bool isSigningIn;
    private string? loginError;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task SignInAsync()
    {
        if (isSigningIn)
        {
            return;
        }

        loginError = null;
        isSigningIn = true;
        var feedbackId = Feedback.Loading("Signing in securely...", "Signing in");

        try
        {
            var result = await AuthService.LoginAsync(loginModel.Email, loginModel.Password, loginModel.RememberMe);
            if (result.Success)
            {
                loginModel.Password = string.Empty;
                Feedback.Resolve(feedbackId, "Sign in successful. Welcome back.", "Signed in", 3000);
                Navigation.NavigateTo(GetSafeReturnUrl(), replace: true);
                return;
            }

            loginModel.Password = string.Empty;
            loginError = result.ErrorMessage ?? "Login failed. Please try again.";
            Feedback.Fail(feedbackId, loginError, "Sign in failed");
        }
        catch (Exception ex)
        {
            loginModel.Password = string.Empty;
            loginError = $"Login failed. {ex.Message}";
            Feedback.Fail(feedbackId, loginError, "Sign in failed");
        }
        finally
        {
            isSigningIn = false;
        }
    }

    private void ShowForgotPasswordInfo() =>
        Feedback.Info("Password recovery is not configured yet. Contact your administrator for access assistance.", "Forgot password");

    private void ShowLinkUnavailable(string name) =>
        Feedback.Info($"{name} is not available in the app yet.", name);

    private string GetSafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl) ||
            ReturnUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            ReturnUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            ReturnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            return "/";
        }

        return ReturnUrl.StartsWith("/", StringComparison.Ordinal) ? ReturnUrl : $"/{ReturnUrl}";
    }

    private sealed class LoginFormModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }
}
