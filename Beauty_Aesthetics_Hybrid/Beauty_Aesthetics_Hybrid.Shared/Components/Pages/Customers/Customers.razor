    void SetRating(int rating)
    {
        currentReview.Rating = rating;
    }

    async Task SaveReview()
    {
        if (string.IsNullOrWhiteSpace(currentReview.Author))
        {
            await ShowToast("Author name is required");
            return;
        }

        if (string.IsNullOrWhiteSpace(currentReview.Text))
        {
            await ShowToast("Review text is required");
            return;
        }

        if (isEditingReview)
        {
            var existing = reviews.FirstOrDefault(r => r.Id == currentReview.Id);
            if (existing != null)
            {
                existing.Author = currentReview.Author;
                existing.Rating = currentReview.Rating;
                existing.Text = currentReview.Text;
                DataService.UpdateReview(existing);
                await ShowToast("Review updated successfully!");
            }
        }
        else
        {
            currentReview.Id = reviews.Any() ? reviews.Max(r => r.Id) + 1 : 1;
            currentReview.Source = GoogleReview ? "google" : "internal";
            DataService.UpdateReview(currentReview);
            reviews.Insert(0, currentReview);
            replyText[currentReview.Id] = string.Empty;
            await ShowToast("Review added successfully!");
        }

        showReviewModal = false;
        reviews = DataService.GetReviews();
    }

    async Task DeleteReview(Models.Review review)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the review by {review.Author}?");
        if (confirmed)
        {
            reviews.Remove(review);
            replyText.Remove(review.Id);
            await ShowToast("Review deleted successfully!");
            StateHasChanged();
        }
    }

    async Task SaveReply(Models.Review review)
    {
        if (replyText.TryGetValue(review.Id, out var reply) && !string.IsNullOrWhiteSpace(reply))
        {
            review.Reply = reply;
            DataService.UpdateReview(review);
            await ShowToast("Reply saved successfully!");
            StateHasChanged();
        }
    }

