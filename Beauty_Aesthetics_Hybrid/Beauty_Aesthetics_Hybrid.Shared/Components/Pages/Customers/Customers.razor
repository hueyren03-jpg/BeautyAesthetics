                                <label><input type="checkbox" @bind="model.OptInNotifications" /> @L["Label_OptInNotifications"]</label>
                                <br /><br />
                                <label><input type="checkbox" @bind="model.OptInPromotions" /> @L["Label_OptInPromotions"]</label>
                            </div>
                        </div>
