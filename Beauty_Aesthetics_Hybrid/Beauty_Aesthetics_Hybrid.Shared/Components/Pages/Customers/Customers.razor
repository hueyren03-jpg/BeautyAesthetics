    async Task ConvertToCustomer(Models.Lead l)
    {
        bool ok = await JS.InvokeAsync<bool>("confirm", $"Convert lead '{l.Name}' to customer?");
        if (ok)
        {
            var c = new Models.Customer
            {
                FirstName = l.Name,
                ContactNumber1 = l.Phone,
                MembershipType = "Regular"
            };

            var createResult = await CustomerService.CreateCustomerAsync(c);
            if (!createResult.Success)
            {
                await ShowToast(createResult.ErrorMessage ?? "Unable to convert lead.");
                return;
            }

            DataService.DeleteLead(l);
            leads = DataService.GetLeads();
            await LoadCustomersFromApiAsync(showErrorToast: false);
            await ShowToast("Lead converted to customer successfully!");
        }
    }

