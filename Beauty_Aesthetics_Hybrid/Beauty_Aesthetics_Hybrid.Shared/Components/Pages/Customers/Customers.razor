                                    }
                                    <button class="btn btn-secondary btn-sm" type="button" @onclick="AddGuardian"><i class="bi bi-plus-lg"></i> @L["Btn_AddGuardian"]</button>
                                </div>
                            </div>
                        </div>

                        @* Notification & Marketing *@
                        <div class="panel">
                            <div class="panel-header" @onclick="() => ToggleSection(nameof(notificationOpen))">
                                <strong>@L["Sec_NotificationMarketing"]</strong>
                                <span class="chev">@(notificationOpen ? "▾" : "▸")</span>
                            </div>
