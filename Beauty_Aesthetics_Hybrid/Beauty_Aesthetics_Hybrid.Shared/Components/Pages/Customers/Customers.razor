    private async Task LoadCustomerForEditAsync(string customerId)
    {
        var result = await CustomerService.LoadCustomerAsync(customerId);
        if (!result.Success || result.Value is null)
        {
            await ShowToast(result.ErrorMessage ?? "Unable to load customer.");
            return;
        }

        await LoadFormLookupsAsync();
        EditCustomer(result.Value);
        await LoadConsultantsForBranchAsync(model.BranchId);
    }

    private async Task LoadCustomersFromApiAsync(
        bool showErrorToast = true,
        string? keyword = null,
        CancellationToken cancellationToken = default)
    {
        var searchKeyword = (keyword ?? string.Empty).Trim();
        var result = await CustomerService.SearchCustomersAsync(searchKeyword, cancellationToken);
        if (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        if (result.Success && result.Value is not null)
        {
            customers = result.Value.ToList();
            foreach (var customer in customers)
            {
                SynchronizeMembershipType(customer);
            }
            if (string.IsNullOrWhiteSpace(searchKeyword))
            {
                defaultCustomers = customers.ToList();
            }
            return;
        }

        customers = new List<Customer>();
        if (showErrorToast)
        {
            await ShowToast(result.ErrorMessage ?? "Unable to load customers.");
        }
    }

    void setFilterModal()
    {
        showFilterModal = !showFilterModal;
    }

    void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private void SelectFilterRating(int? rating)
    {
        filterRating = rating;
        showFilterModal = false;
    }

    private IEnumerable<Models.Review> FilteredReviews()
    {
        if (reviews == null) return Enumerable.Empty<Models.Review>();
        
        var query = reviews.AsEnumerable();
        
        // 1. Filter by Tab (Google vs Internal)
        if (GoogleReview)
        {
            query = query.Where(r => r.Source == "google");
        }
        else
        {
            query = query.Where(r => r.Source == "internal");
        }
        
        // 2. Filter by Search Term (Author or Text)
        if (!string.IsNullOrWhiteSpace(reviewsSearchTerm))
        {
            query = query.Where(r => 
                (r.Author ?? "").Contains(reviewsSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                (r.Text ?? "").Contains(reviewsSearchTerm, StringComparison.OrdinalIgnoreCase));
        }
        
        // 3. Filter by Rating
        if (filterRating.HasValue)
        {
            query = query.Where(r => r.Rating == filterRating.Value);
        }
        
        return query;
    }

    private static string CustomerValue(string? value, string fallback = "-") =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string CustomerAddress(Customer customer)
    {
        var parts = new[] { customer.Address1, customer.Address2, customer.Address3, customer.Postcode, customer.City, customer.State, customer.Country }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var address = string.Join(", ", parts);
        return string.IsNullOrWhiteSpace(address) ? "-" : address;
