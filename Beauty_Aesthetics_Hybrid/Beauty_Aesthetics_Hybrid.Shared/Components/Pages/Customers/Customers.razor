    // ========== CUSTOMERS METHODS ==========
    IEnumerable<Customer> FilteredCustomers()
    {
        IEnumerable<Customer> result = customers ?? Enumerable.Empty<Customer>();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            result = result.Where(MatchesCustomerSearch);
        }

        foreach (var filter in activeCustomerFilters)
        {
            result = ApplyCustomerFilter(result, filter);
        }

        return result;
    }

    private IEnumerable<Customer> CustomerFilterSource => defaultCustomers.Count > 0 ? defaultCustomers : customers;

    private List<MultiTableFilter.FilterColumn> CustomerFilterColumns => new()
    {
        new() { Value = "Status", Label = "Status", ControlType = "Chips", IsQuick = true, Options = CustomerCountOptions(CustomerFilterSource.Select(GetCustomerStatus)) },
        new() { Value = "Membership", Label = "Membership", ControlType = "MultiSelect", IsQuick = true, Options = CustomerCountOptions(CustomerFilterSource.Select(customer => customer.MembershipType)) },
        new() { Value = "Branch", Label = "Branch", ControlType = "MultiSelect", Options = CustomerBranchOptions() },
        new() { Value = "Vip", Label = "Customer Type", ControlType = "Chips", Options = CustomerCountOptions(CustomerFilterSource.Select(customer => customer.IsVip ? "VIP" : "Standard")) },
        new() { Value = "Gender", Label = "Gender", ControlType = "MultiSelect", Options = CustomerCountOptions(CustomerFilterSource.Select(customer => customer.Gender)) },
        new() { Value = "Source", Label = "Source", ControlType = "MultiSelect", IsAdvanced = true, Options = CustomerCountOptions(CustomerFilterSource.Select(customer => customer.Source)) }
    };

    private static List<MultiTableFilter.FilterOption> CustomerCountOptions(IEnumerable<string?> values) =>
        values.Where(value => !string.IsNullOrWhiteSpace(value))
            .GroupBy(value => value!.Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => group.Key)
            .Select(group => new MultiTableFilter.FilterOption { Value = group.Key, Label = group.Key, Count = group.Count() })
            .ToList();

    private List<MultiTableFilter.FilterOption> CustomerBranchOptions()
    {
        var source = CustomerFilterSource.Where(customer => !string.IsNullOrWhiteSpace(customer.BranchId)).ToList();
        return source.GroupBy(customer => customer.BranchId.Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => GetCustomerBranchName(group.Key))
            .Select(group => new MultiTableFilter.FilterOption
            {
                Value = group.Key,
                Label = GetCustomerBranchName(group.Key),
                Count = group.Count()
            })
            .ToList();
    }

    private string GetCustomerBranchName(string branchId) =>
        branches.FirstOrDefault(branch => string.Equals(branch.Id, branchId, StringComparison.OrdinalIgnoreCase))?.Name ?? branchId;

    private IEnumerable<Customer> ApplyCustomerFilter(IEnumerable<Customer> source, MultiTableFilter.FilterData filter) =>
        filter.Column switch
        {
            "Status" => source.Where(customer => CustomerTextMatches(GetCustomerStatus(customer), filter)),
            "Membership" => source.Where(customer => CustomerTextMatches(customer.MembershipType, filter)),
            "Branch" => source.Where(customer => CustomerTextMatches(customer.BranchId, filter)),
            "Vip" => source.Where(customer => CustomerTextMatches(customer.IsVip ? "VIP" : "Standard", filter)),
            "Gender" => source.Where(customer => CustomerTextMatches(customer.Gender, filter)),
            "Source" => source.Where(customer => CustomerTextMatches(customer.Source, filter)),
            _ => source
        };

    private static bool CustomerTextMatches(string? source, MultiTableFilter.FilterData filter)
    {
        if (string.IsNullOrWhiteSpace(source)) return false;
        if (filter.Values.Count > 0)
        {
            return filter.Values.Any(value => string.Equals(source.Trim(), value.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        return string.IsNullOrWhiteSpace(filter.Value) || source.Contains(filter.Value.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private void HandleCustomerFiltersApplied(List<MultiTableFilter.FilterData> filters)
    {
        activeCustomerFilters = filters;
        customerCurrentPage = 1;
    }

    private void HandleCustomerFiltersCleared()
    {
        activeCustomerFilters.Clear();
        customerCurrentPage = 1;
    }

    private async Task HandleCustomerSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        customerCurrentPage = 1;

        var keyword = searchTerm.Trim();
        var requestVersion = ++customerSearchRequestVersion;
        customerSearchCts?.Cancel();
        customerSearchCts?.Dispose();
        customerSearchCts = null;

        if (string.IsNullOrWhiteSpace(keyword))
        {
            customers = defaultCustomers.ToList();
            isCustomerSearchLoading = false;
            return;
        }

        var cts = new CancellationTokenSource();
        customerSearchCts = cts;

        try
        {
            await Task.Delay(350, cts.Token);
            if (cts.IsCancellationRequested || requestVersion != customerSearchRequestVersion)
            {
                return;
            }

            await SearchCustomersFromApiAsync(keyword, requestVersion, cts);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task HandleCustomerSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchCustomersFromApiAsync();
        }
        else if (e.Key == "Escape")
        {
            await ClearCustomerSearchAsync();
        }
    }

    private async Task SearchCustomersFromApiAsync()
    {
        var keyword = searchTerm.Trim();
        var requestVersion = ++customerSearchRequestVersion;
        customerSearchCts?.Cancel();
        customerSearchCts?.Dispose();
        customerSearchCts = null;

        if (string.IsNullOrWhiteSpace(keyword))
        {
            await ClearCustomerSearchAsync();
            return;
        }

        var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
        customerSearchCts = cts;

        await SearchCustomersFromApiAsync(keyword, requestVersion, cts);
    }

    private async Task SearchCustomersFromApiAsync(
        string keyword,
        int requestVersion,
        CancellationTokenSource cts)
    {
        isCustomerSearchLoading = true;

        try
        {
            var result = await CustomerService.SearchCustomersAsync(keyword, cts.Token);
            if (cts.IsCancellationRequested || requestVersion != customerSearchRequestVersion)
            {
                return;
            }

            if (result.Success && result.Value is not null)
            {
                customers = result.Value.ToList();
                customerCurrentPage = 1;
                return;
            }

            customers = new List<Customer>();
            await ShowToast(result.ErrorMessage ?? "Unable to search customers.");
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (requestVersion == customerSearchRequestVersion)
            {
                isCustomerSearchLoading = false;
                customerSearchCts = null;
                StateHasChanged();
            }
            cts.Dispose();
        }
    }

    private Task ClearCustomerSearchAsync()
    {
        customerSearchRequestVersion++;
        customerSearchCts?.Cancel();
        customerSearchCts?.Dispose();
        customerSearchCts = null;
        isCustomerSearchLoading = false;
        searchTerm = string.Empty;
        customers = defaultCustomers.ToList();
        customerCurrentPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        customerSearchCts?.Cancel();
        customerSearchCts?.Dispose();
    }

    private int CustomerTotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCustomers().Count() / (double)CustomerPageSize));

    private void PreviousCustomerPage()
    {
        if (customerCurrentPage > 1) customerCurrentPage--;
    }

    private void NextCustomerPage()
    {
        if (customerCurrentPage < CustomerTotalPages) customerCurrentPage++;
    }

    private bool MatchesCustomerSearch(Customer customer)
    {
        var keyword = searchTerm.Trim();
        return ContainsSearchText($"{customer.FirstName} {customer.LastName}", keyword)
            || ContainsSearchText(customer.Email, keyword)
            || ContainsSearchText(customer.ContactNumber1, keyword)
            || ContainsSearchText(customer.ContactNumber2, keyword)
            || ContainsSearchText(customer.SystemID, keyword)
            || ContainsSearchText(customer.ExternalCode, keyword)
            || ContainsSearchText(customer.IdentificationNumber, keyword)
            || ContainsSearchText(customer.MembershipType, keyword)
            || ContainsSearchText(customer.Source, keyword);
    }

    private static bool ContainsSearchText(string? value, string keyword)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Contains(keyword, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetCustomerStatus(Customer customer)
    {
        return string.IsNullOrWhiteSpace(customer.AccountStatus) ? "Active" : customer.AccountStatus;
    }

    private static string GetCustomerStatusBadgeClass(Customer customer)
    {
        return string.Equals(GetCustomerStatus(customer), "Inactive", StringComparison.OrdinalIgnoreCase)
            ? "customer-status-badge--inactive"
            : "customer-status-badge--active";
    }

    async Task ShowAddForm()
    {
        model = new Customer
        {
            Relationships = new List<ContactRelation>(),
            Guardians = new List<ContactRelation>()
        };
        editing = false;
        showForm = true;
        PreviewImageUrl = null;
        personalOpen = true;
        addressOpen = true;
        einvOpen = true;
        medicalOpen = false;
        employmentOpen = false;
        miscOpen = false;
        notificationOpen = false;
        branchEmployees = Array.Empty<CustomerEmployee>();
        await LoadFormLookupsAsync();
    }

    void Cancel()
    {
        PreviewImageUrl = null;
        if (OnCancel.HasDelegate)
        {
            OnCancel.InvokeAsync();
            return;
        }

        if (!string.IsNullOrWhiteSpace(EditCustomerId))
        {
            Navigation.NavigateTo("/customers");
            return;
        }

        showForm = false;
    }

    private async Task LoadFormLookupsAsync()
    {
        var branchResult = await BranchLookupService.LoadBranchesAsync();
        if (branchResult.Success && branchResult.Value is not null)
        {
            branches = branchResult.Value;
        }

        var membershipResult = await MembershipTypeService.GetAllAsync();
        if (membershipResult.Success && membershipResult.Value is not null)
        {
            membershipTypes = membershipResult.Value
                .Where(item => item.Active && !string.IsNullOrWhiteSpace(item.MemberTypeID))
                .ToList();
        }
    }

    private async Task HandleCustomerBranchChanged(ChangeEventArgs args)
    {
        model.BranchId = args.Value?.ToString() ?? string.Empty;
        model.ConsultantId = string.Empty;
        model.Consultant = string.Empty;
        await LoadConsultantsForBranchAsync(model.BranchId);
    }

    private async Task LoadConsultantsForBranchAsync(string branchId)
    {
        branchEmployees = Array.Empty<CustomerEmployee>();
        if (string.IsNullOrWhiteSpace(branchId))
        {
            return;
        }

        isConsultantsLoading = true;
        try
        {
            var branchResult = await EmployeeService.GetActiveEmployeesByBranchAsync(branchId);
            if (branchResult.Success && branchResult.Value is not null)
            {
                branchEmployees = branchResult.Value
                    .Where(employee => string.Equals(employee.Status, "Active", StringComparison.OrdinalIgnoreCase))
                    .OrderBy(employee => employee.Name)
                    .ToList();
            }

            // Some API environments return an empty branch-specific list even when
            // active employees exist. Keep the selected branch as the authority.
            if (branchEmployees.Count == 0)
            {
                var allEmployeesResult = await EmployeeService.GetAllEmployeesAsync();
                if (allEmployeesResult.Success && allEmployeesResult.Value is not null)
                {
                    branchEmployees = allEmployeesResult.Value
                        .Where(employee =>
                            string.Equals(employee.BranchId, branchId, StringComparison.OrdinalIgnoreCase) &&
                            string.Equals(employee.Status, "Active", StringComparison.OrdinalIgnoreCase))
                        .OrderBy(employee => employee.Name)
                        .ToList();
                }
            }
        }
        finally
        {
            isConsultantsLoading = false;
        }
    }

    private void HandleConsultantChanged(ChangeEventArgs args)
    {
        model.ConsultantId = args.Value?.ToString() ?? string.Empty;
        model.Consultant = branchEmployees
            .FirstOrDefault(employee => string.Equals(employee.Code, model.ConsultantId, StringComparison.OrdinalIgnoreCase))?.Name
            ?? string.Empty;
    }

    private void SynchronizeMembershipType(Customer customer)
    {
        if (membershipTypes.Count == 0)
        {
            return;
        }

        var membershipType = membershipTypes.FirstOrDefault(item =>
            string.Equals(item.MemberTypeID, customer.MembershipTypeId, StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.MemberTypeName, customer.MembershipType, StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.MemberTypeID, customer.MembershipType, StringComparison.OrdinalIgnoreCase));

        if (membershipType is null)
        {
            return;
        }

        customer.MembershipTypeId = membershipType.MemberTypeID ?? string.Empty;
        customer.MembershipType = membershipType.MemberTypeName ?? customer.MembershipType;
    }
    private void HandleMembershipTypeChanged(ChangeEventArgs args)
    {
        model.MembershipTypeId = args.Value?.ToString() ?? string.Empty;
        model.MembershipType = membershipTypes
            .FirstOrDefault(item => string.Equals(item.MemberTypeID, model.MembershipTypeId, StringComparison.OrdinalIgnoreCase))?.MemberTypeName
            ?? string.Empty;
    }
    async Task SaveCustomer()
    {
        if (string.IsNullOrWhiteSpace(model.FirstName))
        {
            await ShowToast("First name is required");
            return;
        }

        Customer? savedCustomer = null;
        if (!editing)
        {
            var createResult = await CustomerService.CreateCustomerAsync(model);
            if (!createResult.Success)
            {
                await ShowToast(createResult.ErrorMessage ?? "Unable to save customer.");
                return;
            }

            savedCustomer = createResult.Value ?? model;
            await ShowToast("Customer saved successfully!");
        }
        else
        {
            var updateResult = await CustomerService.UpdateCustomerAsync(model);
            if (!updateResult.Success)
            {
                await ShowToast(updateResult.ErrorMessage ?? "Unable to update customer.");
                return;
            }

            savedCustomer = updateResult.Value ?? model;
            await ShowToast("Customer updated successfully!");
        }

        PreviewImageUrl = null;
        if (OnCustomerCreated.HasDelegate && savedCustomer is not null)
        {
            await OnCustomerCreated.InvokeAsync(savedCustomer);
            return;
        }

        if (!string.IsNullOrWhiteSpace(EditCustomerId))
        {
            Navigation.NavigateTo("/customers");
            return;
        }

        await LoadCustomersFromApiAsync(showErrorToast: false);
        showForm = false;
    }

    void EditCustomer(Customer c)
    {
        model = new Customer
        {
            Id = c.Id, SystemID = c.SystemID, AccountStatus = c.AccountStatus, IsVip = c.IsVip, FirstName = c.FirstName, LastName = c.LastName,
            IdentificationNumber = c.IdentificationNumber, Email = c.Email, DateOfBirth = c.DateOfBirth,
            Gender = c.Gender, Salutation = c.Salutation, ContactNumber1 = c.ContactNumber1,
            ContactNumber2 = c.ContactNumber2, Consultant = c.Consultant, ConsultantId = c.ConsultantId, MembershipType = c.MembershipType, MembershipTypeId = c.MembershipTypeId, BranchId = c.BranchId,
            Source = c.Source, ExternalCode = c.ExternalCode, UseConsolidatedEInvoice = c.UseConsolidatedEInvoice,
            InvoiceIdentificationType = c.InvoiceIdentificationType, InvoiceIdentificationNumber = c.InvoiceIdentificationNumber,
            TaxIdentificationNumber = c.TaxIdentificationNumber, UseExistingIdentification = c.UseExistingIdentification,
