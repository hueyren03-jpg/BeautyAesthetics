                                <strong>@L["Sec_PersonalInfo"]</strong>
                                <span class="chev">@(personalOpen ? "▾" : "▸")</span>
                            </div>
                            <div class="panel-body @(personalOpen ? "open" : "")">
                                <div class="form-grid">
                                    <div><label>@L["Label_FirstName"]</label><InputText class="input" @bind-Value="model.FirstName" /></div>
                                    <div><label>@L["Label_LastName"]</label><InputText class="input" @bind-Value="model.LastName" /></div>
                                    <div><label>@L["Label_IDNumber"]</label><InputText class="input" @bind-Value="model.IdentificationNumber" /></div>
                                    <div><label>@L["Label_Email"]</label><InputText class="input" @bind-Value="model.Email" /></div>
                                    <div><label>@L["Label_DOB"]</label><InputDate @bind-Value="model.DateOfBirth" class="input" /></div>
                                    <div><label>@L["Label_Gender"]</label><select class="input" @bind="model.Gender">
                                        <option value="">@L["Opt_Select"]</option>
                                        <option value="Male">@L["Opt_Male"]</option>
                                        <option value="Female">@L["Opt_Female"]</option>
                                        <option value="Other">@L["Opt_Other"]</option>
                                    </select></div>
                                    <div><label>@L["Label_Salutation"]</label><InputText class="input" @bind-Value="model.Salutation" /></div>
                                    <div><label>@L["Label_Contact1"]</label><InputText class="input" @bind-Value="model.ContactNumber1" /></div>
                                    <div><label>@L["Label_Contact2"]</label><InputText class="input" @bind-Value="model.ContactNumber2" /></div>
                                    <div>
    <label>Branch</label>
    <select class="input" value="@model.BranchId" @onchange="HandleCustomerBranchChanged">
        <option value="">Select branch</option>
        @foreach (var branch in branches)
        {
            <option value="@branch.Id">@branch.DisplayName</option>
        }
    </select>
</div>
<div>
    <label>@L["Label_Consultant"]</label>
