    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(EditCustomerId))
            {
                await LoadCustomerForEditAsync(EditCustomerId);
                return;
            }

            if (IsDedicatedAddPage)
            {
                await ShowAddForm();
                return;
            }

            await LoadFormLookupsAsync();
            await LoadCustomersFromApiAsync();
            leads = DataService.GetLeads() ?? new List<Models.Lead>();
