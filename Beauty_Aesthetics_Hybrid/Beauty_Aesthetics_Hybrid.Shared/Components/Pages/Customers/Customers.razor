@if (!IsDedicatedEditPage && !IsDedicatedAddPage)
{
    <h1 class="page-title">@L["Title_CRM"]</h1>

    <div class="tab-navigation">
        <button class="tab-btn @(activeTab == "customers" ? "active" : "")" @onclick='() => SetActiveTab("customers")'>
            <i class="bi bi-people"></i> @L["Tab_Customers"]
            <span class="badge">@customers.Count</span>
        </button>
        <button class="tab-btn @(activeTab == "leads" ? "active" : "")" @onclick='() => SetActiveTab("leads")'>
            <i class="bi bi-clipboard-check"></i> @L["Tab_Leads"]
            <span class="badge">@leads.Count</span>
        </button>
        <button class="tab-btn @(activeTab == "reviews" ? "active" : "")" @onclick='() => SetActiveTab("reviews")'>
            <i class="bi bi-star"></i> @L["Tab_Reviews"]
            <span class="badge">@reviews.Count</span>
        </button>
        <button class="tab-btn @(activeTab == "reports" ? "active" : "")" @onclick='() => SetActiveTab("reports")'>
            <i class="bi bi-bar-chart"></i> @L["Tab_Reports"]
        </button>
    </div>
}

<div class="tab-content customer-page-loading-host">
    @if (isCustomerPageInitializing && !IsDedicatedEditPage && !IsDedicatedAddPage)
    {
        <div class="customer-page-loading" role="status" aria-live="polite">
            <div class="customer-page-loading__content">
                <span class="spinner-border" aria-hidden="true"></span>
                <span>Loading customers...</span>
            </div>
        </div>
    }
    @if (activeTab == "customers")
    {
        @* CUSTOMERS MODULE *@
        @if (!IsDedicatedEditPage && !IsDedicatedAddPage)
        {
            <div class="customers-toolbar">
                <div class="customers-toolbar-search">
                    <div class="customer-search-wrapper">
                        <input placeholder="@L["Placeholder_SearchName"]"
                               value="@searchTerm"
                               @oninput="HandleCustomerSearchInput"
                               @onkeydown="HandleCustomerSearchKeyDown"
                               class="input customer-search-input" />
                    </div>
                    <button class="btn btn-primary customer-search-action" type="button" disabled="@isCustomerSearchLoading" @onclick="SearchCustomersFromApiAsync">
                        <i class="bi @(isCustomerSearchLoading ? "bi-arrow-repeat" : "bi-search")"></i>
                        <span>@(isCustomerSearchLoading ? L["Msg_SearchingCustomers"] : L["Btn_Search"])</span>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="btn btn-cancel customer-search-clear" type="button" @onclick="ClearCustomerSearchAsync">@L["Btn_Clear"]</button>
                    }
                </div>

                <AdvancedInventoryFilter Columns="@CustomerFilterColumns"
                                         OnApply="@HandleCustomerFiltersApplied"
                                         OnClear="@HandleCustomerFiltersCleared"
                                         ModuleName="Customers"
                                         ContextLabel="Customer"
                                         ResultCount="@FilteredCustomers().Count()" />

                <div class="customers-toolbar-right">
                    <button class="btn btn-primary customer-add-btn" @onclick="ShowAddForm">
                        <i class="bi bi-plus-lg"></i> @L["Btn_AddNewCustomer"]
                    </button>
                </div>
            </div>
        }

        @if (!showForm)
        {
            var filteredCustomers = FilteredCustomers().ToList();
            var customerTotalPages = Math.Max(1, (int)Math.Ceiling(filteredCustomers.Count / (double)CustomerPageSize));
            var displayedCustomerPage = Math.Min(customerCurrentPage, customerTotalPages);
            var visibleCustomers = filteredCustomers.Skip((displayedCustomerPage - 1) * CustomerPageSize).Take(CustomerPageSize).ToList();

            @if (filteredCustomers.Count == 0)
            {
                <div class="card customer-empty-state">
                    @if (isCustomerSearchLoading)
                    {
                        <i class="bi bi-arrow-repeat"></i>
                        <strong>@L["Msg_SearchingCustomers"]</strong>
                    }
                    else
                    {
                        <i class="bi bi-search"></i>
                        <strong>@L["Msg_NoCustomersFound"]</strong>
                        <span>@L["Msg_TryDifferentCustomerSearch"]</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="btn btn-secondary" type="button" @onclick="ClearCustomerSearchAsync">@L["Btn_Clear"]</button>
                    }
                </div>
            }
            else
            {
                <div class="card customer-list-card">
                    <table class="data-table customer-table">
                        <thead>
                            <tr>
                                <th>@L["Col_Photo"]</th>
                                <th>@L["Col_Name"]</th>
                                <th class="hide-on-mobile">@L["Col_Membership"]</th>
                                <th class="hide-on-mobile customer-status-column">Status</th>
                                <th class="customer-actions-heading">@L["Col_Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in visibleCustomers)
                            {
                                <tr class="customer-row">
                                    <td class="customer-photo-cell">
                                        @if (!string.IsNullOrEmpty(c.PhotoPath))
                                        {
                                            <img src="@c.PhotoPath" alt="@L["Alt_CustomerPhoto"]" class="customer-avatar-list" />
                                        }
                                        else
                                        {
                                            <img src="/images/customers/default.png" alt="@L["Alt_Default"]" class="customer-avatar-list customer-avatar-default" />
                                        }
                                    </td>
                                    <td class="customer-name-cell">
                                        <span class="customer-list-name">@(c.FirstName) @(c.LastName)</span>
                                        <div class="customer-mobile-meta">
                                            @if (!string.IsNullOrWhiteSpace(c.ContactNumber1))
                                            {
                                                <span><i class="bi bi-telephone"></i><span>@c.ContactNumber1</span></span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(c.Email))
                                            {
                                                <span><i class="bi bi-envelope"></i><span>@c.Email</span></span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(c.MembershipType))
                                            {
                                                <span><i class="bi bi-person-badge"></i><span>@c.MembershipType</span></span>
                                            }
                                            <span class="customer-mobile-status @GetCustomerStatusBadgeClass(c)"><i class="bi bi-circle-fill"></i><span>@GetCustomerStatus(c)</span></span>
                                        </div>
                                    </td>
                                    <td class="hide-on-mobile">@c.MembershipType</td>
                                    <td class="hide-on-mobile customer-status-column">
                                        <span class="customer-status-badge @GetCustomerStatusBadgeClass(c)">@GetCustomerStatus(c)</span>
                                    </td>
                                    <td class="customer-actions-cell" @onclick:stopPropagation="true">
                                        <div class="action-buttons">
                                            <button type="button" class="btn-action" @onclick="() => ShowCustomerDetails(c)" title="@L["Tip_Details"]"><i class="bi bi-eye"></i></button>
                                            <button type="button" class="btn-action" @onclick="() => NavigateToEditCustomer(c)" title="@L["Tip_Edit"]"><i class="bi bi-pencil"></i></button>
                                            <button type="button" class="btn-action btn-action-deactivate" @onclick="() => ConfirmDelete(c)" title="Set customer inactive" aria-label="Set customer inactive"><i class="bi bi-person-dash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <nav class="customer-pagination" aria-label="Customer pages">
                    <button type="button" title="Previous page" disabled="@(displayedCustomerPage <= 1)" @onclick="PreviousCustomerPage"><i class="bi bi-chevron-left"></i></button>
                    <span>Page <strong>@displayedCustomerPage</strong> of <strong>@customerTotalPages</strong></span>
                    <button type="button" title="Next page" disabled="@(displayedCustomerPage >= customerTotalPages)" @onclick="NextCustomerPage"><i class="bi bi-chevron-right"></i></button>
                    <small>@filteredCustomers.Count records</small>
                </nav>
            }
        }
        else
        {
            <div class="form-section card @(IsDedicatedEditPage || IsDedicatedAddPage ? "customer-edit-page" : string.Empty)">
                <div class="desktop-view">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; width:100%;">
                        <h2 style="margin: 0; font-size: 20px; font-weight: 700; line-height: 1.3;">@(editing ? L["Title_EditCustomer"] : L["Title_NewCustomer"])</h2>
                        <div style="display:flex; gap:12px;">
                            <button class="btn multi-table-filter__trigger" type="button" @onclick="SaveCustomer"><i class="bi bi-check-lg"></i> @L["Btn_Save"]</button>
                            <button class="btn btn-cancel" type="button" @onclick="Cancel"><i class="bi bi-arrow-left"></i> @L["Btn_Back"]</button>
                        </div>
                    </div>
                </div>

                <div class="mobile-view" style="margin-bottom: 20px;">
                    <div style="display: flex; flex-direction: column; align-items: flex-start; width: 100%; gap: 8px;">
                        <button class="btn-back-nav" @onclick="Cancel">
                            <span class="back-arrow">&#8592;</span>
                            @L["Btn_Back"]
                        </button>
                        <h2 style="margin: 0; font-size: 20px; font-weight: 700; line-height: 1.3;">@(editing ? L["Title_EditCustomer"] : L["Title_NewCustomer"])</h2>
                    </div>
                </div>

                <EditForm Model="model" OnValidSubmit="SaveCustomer">
                    <div class="vip-box">
