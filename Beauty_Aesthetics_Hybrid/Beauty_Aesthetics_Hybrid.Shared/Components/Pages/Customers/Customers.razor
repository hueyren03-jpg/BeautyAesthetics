                                    <div><label>@L["Label_CurrentIllness"]</label><InputText class="input" @bind-Value="model.CurrentIllness" /></div>
                                    <div><label>@L["Label_CustomerTag"]</label><InputText class="input" @bind-Value="model.CustomerTag" /></div>
                                     <div><label>@L["Label_AlertAllergies"]</label><InputText class="input" @bind-Value="model.AlertAllergies" /></div>
                                </div>
                            </div>
                        </div>

                        @* Employment / Payment *@
                        <div class="panel">
                            <div class="panel-header" @onclick="() => ToggleSection(nameof(employmentOpen))">
