                                             <div><label>@L["Label_TIN"]</label><InputText class="input" @bind-Value="model.TaxIdentificationNumber" /></div>
                                            <div><label><input type="checkbox" @bind="model.UseExistingIdentification" /> @L["Label_UseExistingID"]</label></div>
                                        </div>
                                    </div>
