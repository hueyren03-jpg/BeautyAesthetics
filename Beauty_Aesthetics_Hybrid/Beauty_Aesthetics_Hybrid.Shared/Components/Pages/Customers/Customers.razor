                            <button class="btn btn-primary btn-lg" type="submit"><i class="bi bi-check-lg"></i> @L["Btn_Save"]</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        }
    }
    else if (activeTab == "leads")
    {
        @* LEADS MODULE *@
        <div class="leads-toolbar">
            <div class="leads-search-group">
                <input placeholder="@L["Placeholder_SearchLead"]" @bind="leadsSearchTerm" @bind:event="oninput" class="input leads-search-input" />
                <button class="btn btn-cancel btn-sm" @onclick="ClearLeadsSearch"><i class="bi bi-x-lg"></i> @L["Btn_Clear"]</button>
            </div>
            <div>
                <button class="btn btn-primary" @onclick="ShowAddLead"><i class="bi bi-plus-lg"></i> @L["Btn_RegisterLead"]</button>
            </div>
        </div>

        @if (showAddLead)
        {
            <div class="modal-backdrop" @onclick="HideAddLead"></div>
            <div style="display: block; position: fixed; z-index: 1000; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 95%; max-width: 500px;">
                <div class="modal-inner card" style="padding: 24px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                        <h3 style="margin: 0;">@(editingLead ? L["Title_EditLead"] : L["Title_NewLead"])</h3>
                        <button class="btn-close-modal" type="button" @onclick="HideAddLead">✕</button>
                    </div>
                    <EditForm Model="leadModel" OnValidSubmit="@(editingLead ? UpdateLead : AddLead)">
                        <div class="form-grid">
                            <div><label>@L["Label_Name"]</label><InputText @bind-Value="leadModel.Name" class="input" /></div>
                            <div><label>@L["Label_Contact"]</label><InputText @bind-Value="leadModel.Phone" class="input" /></div>
                            <div><label>@L["Label_Source"]</label><InputText @bind-Value="leadModel.Source" class="input" /></div>
                            <div><label>@L["Label_Outlet"]</label><InputText @bind-Value="leadModel.Outlet" class="input" /></div>
                            <div class="full"><label>@L["Label_Remarks"]</label><InputTextArea @bind-Value="leadModel.Remarks" class="input" /></div>
                            <div><label>@L["Label_AttendedBy"]</label><InputText @bind-Value="leadModel.AttendedBy" class="input" /></div>
                        </div>

                        <div class="form-actions" style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 12px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
                            <button class="btn btn-cancel" type="button" @onclick="HideAddLead">@L["Btn_Cancel"]</button>
                            <button class="btn btn-primary" type="submit">@L["Btn_Save"]</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <div class="card leads-table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 50px;"></th>
                        <th style="width: 20%;">@L["Col_Name"]</th>
                        <th class="hide-on-mobile" style="width: 15%;">@L["Col_Contact"]</th>
                        <th class="hide-on-mobile" style="width: 15%;">@L["Col_Source"]</th>
                        <th class="hide-on-mobile" style="width: 15%;">@L["Col_Outlet"]</th>
                        <th class="hide-on-mobile" style="width: 15%;">@L["Col_AttendedBy"]</th>
                        <th style="width: 170px;">@L["Col_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in FilteredLeads())
                    {
                        <tr>
                            <td>
                                <div style="width:40px; height:40px; border-radius:50%; background-color:#f0f7ff; display:flex; align-items:center; justify-content:center; color: #0d5cb5;">
                                    <i class="bi bi-person-lines-fill"></i>
                                </div>
                            </td>
                            <td>
                                <span class="lead-name">@l.Name</span>
                                <div class="lead-mobile-detail">
                                    @if (!string.IsNullOrWhiteSpace(l.Phone))
                                    {
                                        <span><i class="bi bi-telephone"></i> @l.Phone</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(l.Source))
                                    {
                                        <span><i class="bi bi-share"></i> @l.Source</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(l.Outlet))
                                    {
                                        <span><i class="bi bi-shop"></i> @l.Outlet</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(l.AttendedBy))
                                    {
                                        <span><i class="bi bi-person-check"></i> @l.AttendedBy</span>
                                    }
                                </div>
                            </td>
                            <td class="hide-on-mobile">@l.Phone</td>
                            <td class="hide-on-mobile">@(string.IsNullOrWhiteSpace(l.Source) ? "-" : l.Source)</td>
                            <td class="hide-on-mobile">@(string.IsNullOrWhiteSpace(l.Outlet) ? "-" : l.Outlet)</td>
                            <td class="hide-on-mobile">@(string.IsNullOrWhiteSpace(l.AttendedBy) ? "-" : l.AttendedBy)</td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-action" @onclick="() => EditLead(l)" title="@L["Tip_Edit"]"><i class="bi bi-pencil"></i></button>
                                    <button class="btn-action" @onclick="() => DeleteLead(l)" title="@L["Tip_Delete"]"><i class="bi bi-trash"></i></button>
                                    <button class="btn btn-primary btn-sm" @onclick="() => ConvertToCustomer(l)"><i class="bi bi-arrow-repeat"></i> @L["Btn_Convert"]</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="leads-mobile-list">
            <div class="leads-mobile-header">
                <span>@L["Col_Name"]</span>
                <span>@L["Col_Actions"]</span>
            </div>
            @foreach (var l in FilteredLeads())
            {
                <article class="lead-card-mobile">
                    <div class="lead-card-body">
                        <div class="lead-avatar-mobile">
                            <i class="bi bi-person"></i>
                        </div>
                        <div>
                            <h3 class="lead-card-title">@l.Name</h3>
                            <div class="lead-card-details">
                                @if (!string.IsNullOrWhiteSpace(l.Phone))
                                {
                                    <div class="lead-detail-row"><i class="bi bi-telephone"></i><span>@l.Phone</span></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(l.Source))
                                {
                                    <div class="lead-detail-row"><i class="bi bi-share"></i><span>@l.Source</span></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(l.Outlet))
                                {
                                    <div class="lead-detail-row"><i class="bi bi-shop"></i><span>@l.Outlet</span></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(l.AttendedBy))
                                {
                                    <div class="lead-detail-row"><i class="bi bi-person-badge"></i><span>@l.AttendedBy</span></div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="lead-mobile-actions">
                        <button class="lead-mobile-icon-btn" @onclick="() => EditLead(l)" title="@L["Tip_Edit"]"><i class="bi bi-pencil"></i></button>
                        <button class="lead-mobile-icon-btn delete" @onclick="() => DeleteLead(l)" title="@L["Tip_Delete"]"><i class="bi bi-trash"></i></button>
                        <button class="btn btn-primary btn-sm lead-mobile-convert" @onclick="() => ConvertToCustomer(l)"><i class="bi bi-arrow-repeat"></i> @L["Btn_Convert"]</button>
                    </div>
                </article>
            }
        </div>
    }
    else if (activeTab == "reviews")
    {
        @* REVIEWS MODULE *@
        <div>
            <div class="period-selector">
                <div>
                    <button @onclick='() => SwitchReviewTab("google")' class='@(GoogleReview ? "button-active" : "button-inactive")'>
                        <span>@L["Btn_GoogleReview"]</span>
                    </button>
                    <button @onclick='() => SwitchReviewTab("internal")' class="@(GoogleReview ? "button-inactive" : "button-active")">
                        <span>@L["Btn_InternalReview"]</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="reviews-controls">
            <div class="reviews-search-wrapper">
                <input placeholder="@L["Placeholder_SearchName"]" @bind="reviewsSearchTerm" @bind:event="oninput" class="input" />
                <div style="position: relative; display: inline-block;">
                    <button class="btn btn-secondary" @onclick="setFilterModal" title="@L["Tip_Filter"]">
                        <i class="bi bi-funnel"></i>
                        <span>@L["Btn_Filter"]</span>
                    </button>
                    @if (showFilterModal)
                    {
                        <div class="filter-popup card">
                            <h4 style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700;">Filter by Rating</h4>
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <button class="btn-filter-option @(filterRating == null ? "active" : "")" @onclick="() => SelectFilterRating(null)">
                                    All Ratings
                                </button>
                                @for (int i = 5; i >= 1; i--)
                                {
                                    int ratingValue = i;
                                    <button class="btn-filter-option @(filterRating == ratingValue ? "active" : "")" @onclick="() => SelectFilterRating(ratingValue)">
                                        @string.Concat(Enumerable.Range(0, ratingValue).Select(_ => "★")) (@ratingValue Star@(ratingValue > 1 ? "s" : ""))
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            @if (!GoogleReview) {
                <button class="btn btn-primary" @onclick="ShowAddReview"><i class="bi bi-plus-lg"></i> @L["Btn_AddReview"]</button>
            }
        </div>

        <div class="card-grid">
            @foreach (var r in FilteredReviews())
            {
                <div class="card review-card">
                    <div class="review-header">
                        <div class="review-name-container">
                            @if (r.Source == "google")
                            {
                                <i style="font-size: 32px; color: #ea4335;" class="bi bi-google d-flex gap-1 align-items-center"></i>
                            }
                            else
                            {
                                <i style="font-size: 32px; color: #0d5cb5;" class="bi bi-chat-left-text-fill d-flex gap-1 align-items-center"></i>
                            }
                            <div class="review-name">
                                <strong>@r.Author</strong>
                                <span class="stars">@string.Concat(Enumerable.Range(0, r.Rating).Select(i => "★"))</span>
                            </div>
                        </div>

                        <div class="review-info">
                            <strong>@L["Label_Date"]: 22/1/2026</strong>
                            <span class="time-small">@L["Label_Time"]: 10:24PM</span>
                        </div>
                    </div>

                    <div class="review-text">@r.Text</div>

                    <div class="reply">
                        @if (string.IsNullOrWhiteSpace(r.Reply))
                        {
                            <input placeholder="@L["Placeholder_WriteReply"]" @bind="replyText[r.Id]" class="input" style="margin-bottom: 8px;" />
                            <button class="btn btn-primary btn-sm" @onclick="() => SaveReply(r)"><i class="bi bi-reply"></i> @L["Btn_Reply"]</button>
                        }
                        else
                        {
                            @if (r.isEdittingReply)
                            {
                                <textarea class="input" rows="3" @bind="r.Reply" style="margin-bottom: 8px;">@r.Reply</textarea>
                                <button @onclick="() => SaveReplyEdit(r)" class="btn btn-primary btn-sm"> @L["Btn_Save"] </button>
                                <button @onclick="() => SaveReplyEdit(r)" class="btn btn-cancel btn-sm"> @L["Btn_Cancel"] </button>
                            }
                            else
                            {
                                <div class="reply-saved">
                                    <strong>@L["Label_Reply"]:</strong> @r.Reply
                                    <div class="review-rating">
                                        <button class="btn-action" @onclick="() => EditReply(r)" title="@L["Tip_Edit"]">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn-action" @onclick="() => DeleteReview(r)" title="@L["Tip_Delete"]">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        @if (!FilteredReviews().Any())
        {
            <div class="card" style="text-align: center; padding: 40px; color: #6b7280;">
                <p style="margin: 0;">@L["Msg_NoReviews"]</p>
            </div>
        }
    }
    else if (activeTab == "reports")
    {
        @* REPORTS MODULE *@
        <div class="card" style="padding: 40px; text-align: center;">
            <div style="max-width: 600px; margin: 0 auto;">
                <div style="font-size: 64px; margin-bottom: 24px; color: #0d5cb5;"><i class="bi bi-file-earmark-spreadsheet"></i></div>
                <h2 style="margin-bottom: 16px; color: #1f2937;">@L["Title_DataExport"]</h2>
                <p style="color: #6b7280; margin-bottom: 32px; line-height: 1.6;">
                    @L["Desc_Export"]
                </p>
                
                <div style="display: flex; flex-direction: column; gap: 16px; align-items: center;">
                    <button class="btn btn-primary btn-lg" @onclick="GenerateCsv">
                        <i class="bi bi-download"></i> @L["Btn_ExportCsv"]
                    </button>
                    
                    @if (!string.IsNullOrWhiteSpace(exportUrl))
                    {
                        <div style="padding: 20px; background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%); border-radius: 12px; width: 100%; border-left: 4px solid #10b981;">
                            <p style="margin: 0 0 12px 0; font-weight: 600; color: #065f46;"><i class="bi bi-check-circle-fill"></i> @L["Msg_ExportSuccess"]</p>
                            <a href="@exportUrl" target="_blank" style="color: #059669; font-weight: 600; text-decoration: underline;">
                                <i class="bi bi-file-earmark-arrow-down"></i> @L["Link_DownloadCsv"]
                            </a>
                        </div>
                    }
                </div>

                <div style="margin-top: 40px; padding-top: 32px; border-top: 2px solid #e5e7eb;">
                    <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px; color: #374151;">@L["Title_ExportIncludes"]</h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; text-align: left;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <i class="bi bi-check-circle-fill" style="color: #10b981;"></i>
                            <span style="color: #6b7280;">@L["Inc_CustomerInfo"]</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <i class="bi bi-check-circle-fill" style="color: #10b981;"></i>
                            <span style="color: #6b7280;">@L["Inc_ContactDetails"]</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <i class="bi bi-check-circle-fill" style="color: #10b981;"></i>
                            <span style="color: #6b7280;">@L["Inc_AddressInfo"]</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <i class="bi bi-check-circle-fill" style="color: #10b981;"></i>
                            <span style="color: #6b7280;">@L["Inc_Membership"]</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <i class="bi bi-check-circle-fill" style="color: #10b981;"></i>
                            <span style="color: #6b7280;">@L["Inc_SystemId"]</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <i class="bi bi-check-circle-fill" style="color: #10b981;"></i>
                            <span style="color: #6b7280;">@L["Inc_Notes"]</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* Add/Edit Review Modal *@
@if (showReviewModal)
{
    <div class="modal-backdrop" @onclick="HideReviewModal"></div>
    <div style="display: block; position: fixed; z-index: 1000; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 95%; max-width: 500px;">
        <div class="modal-inner card" style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="margin: 0;">@(isEditingReview ? L["Title_EditReview"] : L["Title_NewReview"])</h3>
                <button class="btn-close-modal" type="button" @onclick="HideReviewModal">✕</button>
            </div>
            <EditForm Model="currentReview" OnValidSubmit="SaveReview">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <label style="font-weight: 600; margin-bottom: 6px; display: block; color: var(--color-text-secondary);">@L["Label_Author"]</label>
                        <InputText @bind-Value="currentReview.Author" class="input" placeholder="Enter author name" />
                    </div>
                    <div>
                        <label style="font-weight: 600; margin-bottom: 6px; display: block; color: var(--color-text-secondary);">@L["Label_Rating"]</label>
                        <div class="stars-input" style="display: flex; gap: 6px; font-size: 28px; color: #fbbf24; cursor: pointer; user-select: none;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                int starValue = i;
                                <span @onclick="() => SetRating(starValue)">@(currentReview.Rating >= starValue ? "★" : "☆")</span>
                            }
                        </div>
                    </div>
                    <div>
                        <label style="font-weight: 600; margin-bottom: 6px; display: block; color: var(--color-text-secondary);">@L["Label_ReviewText"]</label>
                        <InputTextArea @bind-Value="currentReview.Text" class="input" rows="4" placeholder="Write review comments..." />
                    </div>
                </div>
                <div class="form-actions" style="margin-top: 24px; display: flex; justify-content: flex-end; gap: 12px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
                    <button class="btn btn-cancel" type="button" @onclick="HideReviewModal">@L["Btn_Cancel"]</button>
                    <button class="btn btn-primary" type="submit">@L["Btn_Save"]</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showDetailsModal && selectedCustomer != null)
{
    <div class="customer-profile-overlay" @onclick="CloseDetailsModal">
        <section class="customer-profile" @onclick:stopPropagation="true" aria-label="Customer details">
            <header class="customer-profile__titlebar">
                <h2>Customer Details</h2>
                <button type="button" @onclick="CloseDetailsModal" title="Close"><i class="bi bi-x-lg"></i></button>
            </header>

            <div class="customer-profile__body">
                <div class="customer-profile__breadcrumb">Customers <i class="bi bi-chevron-right"></i> <strong>@(selectedCustomer.FirstName) @(selectedCustomer.LastName)</strong></div>

                <section class="customer-profile__hero">
                    @if (!string.IsNullOrEmpty(selectedCustomer.PhotoPath))
                    {
                        <img src="@selectedCustomer.PhotoPath" alt="Customer photo" />
                    }
                    else
                    {
                        <img src="/images/customers/default.png" alt="Default customer" />
                    }
                    <div class="customer-profile__identity">
                        <h3>@(selectedCustomer.FirstName) @(selectedCustomer.LastName)</h3>
                        <span><i class="bi bi-award-fill"></i> @CustomerValue(selectedCustomer.MembershipType, "Member")</span>
                        @if (selectedCustomer.IsVip)
                        {
                            <span class="customer-profile__vip"><i class="bi bi-star-fill"></i> VIP Member</span>
                        }
                    </div>
                    <div class="customer-profile__hero-actions">
                        @if (!string.IsNullOrWhiteSpace(selectedCustomer.ContactNumber1))
                        {
                            <a href="tel:@selectedCustomer.ContactNumber1"><i class="bi bi-telephone"></i> Call</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedCustomer.Email))
                        {
                            <a href="mailto:@selectedCustomer.Email"><i class="bi bi-envelope"></i> Email</a>
                        }
                        <button type="button" class="primary" @onclick="() => EditCustomerFromDetails(selectedCustomer)"><i class="bi bi-pencil"></i> Edit</button>
                    </div>
                </section>

                <section class="customer-profile__section">
                    <h4>Customer Information</h4>
                    <div class="customer-profile__grid">
                        <div><span>Name</span><strong>@(selectedCustomer.FirstName) @(selectedCustomer.LastName)</strong></div>
                        <div><span>Membership Type</span><strong>@CustomerValue(selectedCustomer.MembershipType)</strong></div>
                        <div><span>Status</span><strong class="customer-profile__status @GetCustomerStatusBadgeClass(selectedCustomer)">@GetCustomerStatus(selectedCustomer)</strong></div>
                        <div><span>Source</span><strong>@CustomerValue(selectedCustomer.Source)</strong></div>
                        <div><span>System ID</span><strong>@CustomerValue(selectedCustomer.SystemID)</strong></div>
                        <div><span>Identification No.</span><strong>@CustomerValue(selectedCustomer.IdentificationNumber)</strong></div>
                        <div><span>Gender</span><strong>@CustomerValue(selectedCustomer.Gender)</strong></div>
                        <div><span>Date of Birth</span><strong>@(selectedCustomer.DateOfBirth?.ToString("dd/MM/yyyy") ?? "-")</strong></div>
                        <div><span>Branch</span><strong>@CustomerValue(selectedCustomer.BranchId)</strong></div>
                    </div>
                </section>

                <section class="customer-profile__section">
                    <h4>Contact &amp; Address</h4>
                    <div class="customer-profile__grid">
                        <div><span>Email</span><strong>@CustomerValue(selectedCustomer.Email)</strong></div>
                        <div><span>Primary Contact</span><strong>@CustomerValue(selectedCustomer.ContactNumber1)</strong></div>
                        <div><span>Secondary Contact</span><strong>@CustomerValue(selectedCustomer.ContactNumber2)</strong></div>
                        <div><span>Consultant</span><strong>@CustomerValue(selectedCustomer.Consultant)</strong></div>
                        <div class="wide"><span>Address</span><strong>@CustomerAddress(selectedCustomer)</strong></div>
                    </div>
                </section>

                <section class="customer-profile__section">
                    <h4>Medical &amp; Customer Profile</h4>
                    <div class="customer-profile__grid">
                        <div><span>Smoker</span><strong>@CustomerValue(selectedCustomer.Smoker)</strong></div>
                        <div><span>Allergies</span><strong>@CustomerValue(selectedCustomer.DrugAllergies)</strong></div>
                        <div><span>Current Illness</span><strong>@CustomerValue(selectedCustomer.CurrentIllness)</strong></div>
                        <div><span>Customer Tag</span><strong>@CustomerValue(selectedCustomer.CustomerTag)</strong></div>
                        <div><span>Occupation</span><strong>@CustomerValue(selectedCustomer.Occupation)</strong></div>
                        <div><span>Department</span><strong>@CustomerValue(selectedCustomer.Department)</strong></div>
                        <div><span>Employee No.</span><strong>@CustomerValue(selectedCustomer.EmployeeNo)</strong></div>
                        <div><span>Payment Origin</span><strong>@CustomerValue(selectedCustomer.PayeeOrigin)</strong></div>
                        <div><span>Race</span><strong>@CustomerValue(selectedCustomer.Race)</strong></div>
                        <div><span>Marital Status</span><strong>@CustomerValue(selectedCustomer.MaritalStatus)</strong></div>
                        <div><span>Preferred Language</span><strong>@CustomerValue(selectedCustomer.PreferredLanguage)</strong></div>
                        <div><span>Referrer</span><strong>@CustomerValue(selectedCustomer.Referrer)</strong></div>
                    </div>
                </section>

                <section class="customer-profile__section">
                    <h4>Member Balances</h4>
                    @if (isCustomerBalancesLoading)
                    {
                        <div class="customer-balance-state"><i class="bi bi-arrow-repeat"></i> Loading balances...</div>
                    }
                    else if (selectedCustomerBalances is not null)
                    {
                        <div class="customer-profile__grid">
                            <div><span>Package Balance</span><strong>RM @selectedCustomerBalances.Summary.PackageBalance.ToString("N2")</strong></div>
                            <div><span>Credit Balance</span><strong>RM @selectedCustomerBalances.Summary.CreditBalance.ToString("N2")</strong></div>
                            <div><span>Beauty Points</span><strong>@selectedCustomerBalances.Summary.PointBalance.ToString("N0") pts</strong></div>
                            <div><span>Point Rebate</span><strong>RM @selectedCustomerBalances.Summary.PointRebateBalance.ToString("N2")</strong></div>
                            <div><span>Voucher Balance</span><strong>RM @selectedCustomerBalances.Summary.VoucherBalance.ToString("N2")</strong></div>
                        </div>
                        @if (selectedCustomerBalances.Packages.Count > 0)
                        {
                            <div class="customer-balance-table-wrap"><table class="customer-balance-table"><thead><tr><th>Package</th><th>Balance</th><th>Expiry</th></tr></thead><tbody>
                            @foreach (var package in selectedCustomerBalances.Packages)
                            { <tr><td>@CustomerValue(package.PackageName, package.PackageCode ?? "-")</td><td>RM @package.NetBalanceAfterUtilised.ToString("N2")</td><td>@(package.ExpiryDate == DateTime.MinValue ? "-" : package.ExpiryDate.ToString("dd/MM/yyyy"))</td></tr> }
                            </tbody></table></div>
                        }
                        @if (selectedCustomerBalances.Credits.Count > 0)
                        {
                            <div class="customer-balance-table-wrap"><table class="customer-balance-table"><thead><tr><th>Credit</th><th>Balance</th><th>Due Date</th></tr></thead><tbody>
                            @foreach (var credit in selectedCustomerBalances.Credits)
                            { <tr><td>@CustomerValue(credit.ItemDescription, credit.DisplayCode ?? "-")</td><td>RM @credit.NetBalanceAfterUtilised.ToString("N2")</td><td>@(credit.DueDate == DateTime.MinValue ? "-" : credit.DueDate.ToString("dd/MM/yyyy"))</td></tr> }
                            </tbody></table></div>
                        }
                    }
                </section>
                <section class="customer-profile__section">
                    <h4>Preferences &amp; E-Invoice</h4>
                    <div class="customer-profile__grid">
                        <div><span>Notifications</span><strong>@(selectedCustomer.OptInNotifications ? "Enabled" : "Disabled")</strong></div>
                        <div><span>Promotions</span><strong>@(selectedCustomer.OptInPromotions ? "Enabled" : "Disabled")</strong></div>
                        <div><span>Consolidated E-Invoice</span><strong>@(selectedCustomer.UseConsolidatedEInvoice ? "Yes" : "No")</strong></div>
                        <div><span>Tax ID</span><strong>@CustomerValue(selectedCustomer.TaxIdentificationNumber)</strong></div>
                        <div class="wide"><span>Notes</span><strong>@CustomerValue(selectedCustomer.Notes)</strong></div>
                    </div>
                </section>
            </div>
        </section>
    </div>
}
