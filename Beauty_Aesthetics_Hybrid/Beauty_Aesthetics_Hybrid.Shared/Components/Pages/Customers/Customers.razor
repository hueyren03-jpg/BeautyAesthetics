    IEnumerable<Models.Lead> FilteredLeads()
    {
        if (leads == null) return Enumerable.Empty<Models.Lead>();
        if (string.IsNullOrWhiteSpace(leadsSearchTerm))
            return leads;

        return leads.Where(l =>
            (l.Name ?? "").Contains(leadsSearchTerm, StringComparison.OrdinalIgnoreCase) ||
            (l.Phone ?? "").Contains(leadsSearchTerm, StringComparison.OrdinalIgnoreCase)
        );
    }

