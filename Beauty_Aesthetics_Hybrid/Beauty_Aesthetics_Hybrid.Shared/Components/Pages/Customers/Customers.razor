    async Task ConfirmDelete(Customer c)
    {
        var customerName = $"{c.FirstName} {c.LastName}".Trim();
        if (string.IsNullOrWhiteSpace(customerName))
        {
            customerName = c.SystemID ?? "this customer";
        }

        bool ok = await JS.InvokeAsync<bool>(
            "confirm",
            $"Set customer '{customerName}' to inactive?");

        if (!ok)
        {
            return;
        }

        var result = await CustomerService.DeactivateCustomerAsync(c.Id);
        if (!result.Success)
        {
            await ShowToast(result.ErrorMessage ?? "Unable to hide customer.");
            return;
        }

        c.AccountStatus = "Inactive";
        var currentCustomer = customers.FirstOrDefault(customer => customer.Id == c.Id);
        if (currentCustomer is not null)
        {
            currentCustomer.AccountStatus = "Inactive";
        }

        var defaultCustomer = defaultCustomers.FirstOrDefault(customer => customer.Id == c.Id);
        if (defaultCustomer is not null)
        {
            defaultCustomer.AccountStatus = "Inactive";
        }

        if (selectedCustomer?.Id == c.Id)
        {
            CloseDetailsModal();
        }

        await ShowToast("Customer set to inactive.");
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        if (selectedFile is null)
        {
            return;
        }

        var upload = await FileUploadAC.UploadImageAsync(selectedFile, "Customers");
        if (!upload.Success || string.IsNullOrWhiteSpace(upload.Value))
        {
            await ShowToast(upload.ErrorMessage ?? "Unable to upload customer image.");
            return;
        }

        model.PhotoPath = upload.Value;
        PreviewImageUrl = upload.Value;
        await ShowToast("Customer image uploaded successfully.");
        await InvokeAsync(StateHasChanged);
    }

