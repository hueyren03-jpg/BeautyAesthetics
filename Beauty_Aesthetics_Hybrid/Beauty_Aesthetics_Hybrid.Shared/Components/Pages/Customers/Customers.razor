    private async Task ShowCustomerDetails(Customer customer)
    {
        selectedCustomer = customer;
        selectedCustomerBalances = null;
        customerBalanceError = null;
        isCustomerBalancesLoading = true;
        showDetailsModal = true;

        var customerId = customer.SystemID;
