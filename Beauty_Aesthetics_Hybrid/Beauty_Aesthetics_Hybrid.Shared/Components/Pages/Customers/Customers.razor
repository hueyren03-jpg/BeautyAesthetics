        <option value="">@(isConsultantsLoading ? "Loading staff..." : "Select consultant")</option>
        @foreach (var employee in branchEmployees)
        {
            <option value="@employee.Code">@employee.Name (@employee.Code)</option>
        }
    </select>
</div>
<div>
    <label>@L["Label_MembershipType"]</label>
    <select class="input" value="@model.MembershipTypeId" @onchange="HandleMembershipTypeChanged">
        <option value="">Select membership type</option>
        @foreach (var membershipType in membershipTypes)
        {
            <option value="@membershipType.MemberTypeID">@membershipType.MemberTypeName</option>
        }
    </select>
</div>
                                     <div><label>@L["Label_Source"]</label><InputText class="input" @bind-Value="model.Source" placeholder="@L["Placeholder_Source"]" /></div>
                                     <div><label>@L["Label_ExternalCode"]</label><InputText class="input" @bind-Value="model.ExternalCode" /></div>
                                    <div class="form-group">
                                        <label>@L["Label_ProfilePhoto"]</label>
                                        <InputFile OnChange="HandleFileSelected" accept="image/*" />
                                        @if (!string.IsNullOrEmpty(PreviewImageUrl))
                                        {
                                            <img src="@PreviewImageUrl" alt="@L["Alt_Preview"]" class="customer-photo" />
                                        }
                                        else if (!string.IsNullOrEmpty(model.PhotoPath))
                                        {
                                            <img src="@model.PhotoPath" alt="@L["Alt_CustomerPhoto"]" class="customer-photo" />
                                        }
                                        else
                                        {
                                            <img src="/images/customers/default.png" alt="@L["Alt_Default"]" class="customer-photo" />
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Address *@
                        <div class="panel">
                            <div class="panel-header" @onclick="() => ToggleSection(nameof(addressOpen))">
                                <strong>@L["Sec_Address"]</strong>
                                <span class="chev">@(addressOpen ? "▾" : "▸")</span>
                            </div>
                            <div class="panel-body @(addressOpen ? "open" : "")">
                                <div class="form-grid">
                                    <div><label>@L["Label_Address1"]</label><InputText class="input" @bind-Value="model.Address1" /></div>
                                    <div><label>@L["Label_Address2"]</label><InputText class="input" @bind-Value="model.Address2" /></div>
                                    <div><label>@L["Label_Address3"]</label><InputText class="input" @bind-Value="model.Address3" /></div>
                                    <div><label>@L["Label_Country"]</label><InputText class="input" @bind-Value="model.Country" /></div>
                                    <div><label>@L["Label_State"]</label><InputText class="input" @bind-Value="model.State" /></div>
                                    <div><label>@L["Label_City"]</label><InputText class="input" @bind-Value="model.City" /></div>
                                     <div><label>@L["Label_Postcode"]</label><InputText class="input" @bind-Value="model.Postcode" /></div>
                                </div>
                            </div>
                        </div>

                        @* E-Invoice *@
                        <div class="panel">
                            <div class="panel-header" @onclick="() => ToggleSection(nameof(einvOpen))">
