@page "/CustomerRating"
@namespace Beauty_Aesthetics_WebPos.Components.Pages
@using Beauty_Aesthetics_WebPos.Data
@using Beauty_Aesthetics_WebPos.Models
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject IRatingService RatingService

<div class="page">
    <div class="card">

        <!-- HEADER -->
        <div class="header">
            <div class="header-content">
                <div class="icon-container">
                    <span class="header-icon">⭐</span>
                </div>
                <h1>@L["RateYourExperience"]</h1>
                <p>@L["FeedbackImproveService"]</p>
            </div>
        </div>

        <!-- BODY -->
        <div class="body">

            <!-- RATING QUESTION -->
            <div class="question-section">
                <div class="question-text">✨ @L["HowRateExperience"] ✨</div>
            </div>

            <!-- STAR RATING -->
            <div class="stars-container">
                <div class="stars-wrapper">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var starNumber = i;
                        <div class="star-wrapper">
                            <span class="star @(rating >= i ? "filled" : "") @(hoverRating >= i ? "hover" : "")"
                                  @onclick="(() => OnRate(starNumber))"
                                  @onmouseover="(() => hoverRating = starNumber)"
                                  @onmouseout="(() => hoverRating = 0)">
                                ★
                            </span>
                            @if (i == 5)
                            {
                                <div class="star-label">@L["Excellent"]</div>
                            }
                            else if (i == 1)
                            {
                                <div class="star-label">@L["Poor"]</div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- RATING FEEDBACK MESSAGE -->
            @if (rating > 0 && !hasSubmitted)
            {
                <div class="feedback-container">
                    <div class="feedback-card @GetMessageClass()">
                        <div class="feedback-icon">
                            @GetFeedbackIcon()
                        </div>
                        <div class="feedback-content">
                            <div class="feedback-title">@GetFeedbackTitle()</div>
                            <div class="feedback-message">@MessageText</div>
                        </div>
                    </div>
                </div>
            }

            <!-- GOOGLE REVIEW SECTION (5 STARS) -->
            @if (rating == 5 && !hasSubmitted)
            {
                <div class="google-review-section">
                    <div class="section-header">
                        <span class="section-title">@L["SharePositiveExperience"]</span>
                        <span class="section-title">@L["YourReviewMakesDifference"]</span>
                    </div>

                    <div class="redirect-notice">
                        <span class="notice-icon">⏱️</span>
                        <span>@L["RedirectNotice"]</span>
                    </div>

                    <button class="btn btn-google" @onclick="RedirectToGoogleReview" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        <span class="btn-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20">
                                <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                                <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                                <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                                <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                            </svg>
                        </span>
                        <span class="btn-text">@L["WriteGoogleReview"]</span>
                    </button>
                </div>
            }

            <!-- COMMENT SECTION (1-4 STARS) -->
            @if (rating is > 0 and < 5 && !hasSubmitted)
            {
                <div class="comment-section">
                    <div class="comment-prompt">
                        @L["WhatDoBetter"]
                    </div>

                    <div class="textarea-wrapper">
                        <div class="textarea-header">
                            <span class="textarea-label">@L["YourComments"]</span>
                            <span class="char-count">@comment.Length/500</span>
                        </div>
                        <textarea @bind="comment"
                                  @oninput="(e) => OnCommentInput(e)"
                                  maxlength="500"
                                  placeholder="@L["ShareThoughts"]"
                                  disabled="@isSaving">
                                </textarea>
                        <div class="textarea-footer">
                            <span class="hint-text">@L["FeedbackConfidential"]</span>
                        </div>
                    </div>

                    <div class="btn-group">
                        <button class="btn btn-secondary" @onclick="ResetRating" disabled="@isSaving">
                            @L["Cancel"]
                        </button>
                        <button class="btn btn-primary" @onclick="Submit"
                                disabled="@(string.IsNullOrWhiteSpace(comment) || isSaving)">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <span class="btn-icon">➤</span>
                            }
                            <span class="btn-text">@L["SubmitFeedback"]</span>
                        </button>
                    </div>
                </div>
            }

            <!-- THANK YOU MESSAGE -->
            @if (hasSubmitted && rating != 5)
            {
                <div class="thank-you-section">
                    <div class="thank-you-card">
                        <div class="thank-you-icon">🎉</div>
                        <div class="thank-you-content">
                            <h3>@L["FeedbackSuccess"]</h3>
                            <p>@L["FeedbackImproveService"]</p>
                            <div class="thank-you-note">
                                <span class="note-icon">💡</span>
                                <span>@L["YourReviewMakesDifference"]</span>
                            </div>
                        </div>
                        <button class="btn btn-outline" @onclick="ResetForm">
                            @L["SubmitAnotherRating"]
                        </button>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<AppErrorPopup Title="Unable to submit rating" Message="@errorMessage" />

