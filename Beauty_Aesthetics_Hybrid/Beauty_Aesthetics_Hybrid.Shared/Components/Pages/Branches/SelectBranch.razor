@page "/select-branch"
@namespace Beauty_Aesthetics_WebPos.Components.Pages
@layout EmptyLayout
@inject IBranchSessionService BranchSession
@inject NavigationManager Navigation

<PageTitle>Select Branch</PageTitle>

<main class="branch-select-page">
    <section class="branch-select-panel" aria-labelledby="branch-select-title">
        <div class="branch-select-mark"><i class="bi bi-building"></i></div>
        <div class="branch-select-copy">
            <p class="branch-select-eyebrow">WORKING BRANCH</p>
            <h1 id="branch-select-title">Select your branch</h1>
            <p>Choose the branch you are working in. This selection is used across the whole app.</p>
        </div>

        @if (isLoading)
        {
            <div class="branch-select-state">Loading available branches...</div>
        }
        else if (!string.IsNullOrWhiteSpace(BranchSession.ErrorMessage))
        {
            <div class="branch-select-error">@BranchSession.ErrorMessage</div>
        }
        else
        {
            <div class="branch-select-list">
                @foreach (var branch in BranchSession.AvailableBranches)
                {
                    <button type="button" class="branch-choice" @onclick="() => ChooseBranchAsync(branch.Id)">
                        <span class="branch-choice-icon"><i class="bi bi-shop"></i></span>
                        <span class="branch-choice-text">
                            <strong>@branch.DisplayName</strong>
                            <small>@branch.Id</small>
                        </span>
                        <i class="bi bi-chevron-right"></i>
                    </button>
                }
            </div>
        }
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await BranchSession.InitializeAsync();
        isLoading = false;

        if (BranchSession.CurrentBranch is not null && BranchSession.AvailableBranches.Count == 1)
        {
            Navigation.NavigateTo(GetSafeReturnUrl(), replace: true);
        }
    }

    private async Task ChooseBranchAsync(string branchId)
    {
        if (await BranchSession.SelectAsync(branchId))
        {
            Navigation.NavigateTo(GetSafeReturnUrl(), replace: true);
        }
    }

    private string GetSafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl) ||
            !Uri.TryCreate(ReturnUrl, UriKind.Relative, out _) ||
            ReturnUrl.StartsWith("//", StringComparison.Ordinal) ||
            ReturnUrl.StartsWith("select-branch", StringComparison.OrdinalIgnoreCase))
        {
            return "/";
        }

        return ReturnUrl.StartsWith('/') ? ReturnUrl : $"/{ReturnUrl}";
    }
}
