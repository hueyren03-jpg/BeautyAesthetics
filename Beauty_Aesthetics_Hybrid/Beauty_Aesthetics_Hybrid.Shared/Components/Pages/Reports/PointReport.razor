@page "/PointReport"
@using System.Globalization
@using System.Text
@using Beauty_Aesthetics_WebPos.APIClient
@using Beauty_Aesthetics_WebPos.Components.Layout
@using Beauty_Aesthetics_WebPos.Components.Services
@using Beauty_Aesthetics_WebPos.Components.Services.Feedback
@using Beauty_Aesthetics_WebPos.Components.Services.Files
@using Beauty_Aesthetics_WebPos.Models.DTOs
@layout MainLayout
@inject WebDashboardAC WebDashboardAC
@inject AppState AppState
@inject AppFeedbackService Feedback
@inject IFileDownloadService FileDownloadService
@inject NavigationManager Navigation

<div class="point-report-page">
    <div class="point-report-header">
        <div class="point-report-heading">
            <button class="back-btn" @onclick="GoBack" title="Back to reports">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <div>
                <h2>Point Reporting</h2>
                <p>Live member point movements from the backend point ledger.</p>
            </div>
        </div>

        <div class="point-report-actions">
            <button class="secondary-btn" @onclick="ExportCsvAsync" disabled="@(isLoading || FilteredRows.Count == 0)">
                <i class="fa-solid fa-file-csv"></i>
                Export CSV
            </button>
            <button class="primary-btn" @onclick="LoadAsync" disabled="@isLoading">
                <i class="fa-solid fa-rotate @(isLoading ? "fa-spin" : "")"></i>
                @(isLoading ? "Loading..." : "Refresh")
            </button>
        </div>
    </div>

    <div class="point-report-filters">
        <div class="filter-field">
            <label>From</label>
            <input type="date" @bind="fromDate" />
        </div>
        <div class="filter-field">
            <label>To</label>
            <input type="date" @bind="toDate" />
        </div>
        <div class="filter-field search-field">
            <label>Search member / phone / invoice</label>
            <div class="search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       placeholder="Search..."
                       @bind="searchTerm"
                       @bind:event="oninput" />
            </div>
        </div>
        <button class="apply-btn" @onclick="LoadAsync" disabled="@isLoading">
            Apply
        </button>
    </div>

    <div class="point-report-context">
        <span><i class="fa-solid fa-code-branch"></i> Branch context: @(AppState.SelectedBranchID ?? "All")</span>
        <span><i class="fa-solid fa-database"></i> Source: Backend Point Ledger</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="report-message error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@errorMessage</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(infoMessage))
    {
        <div class="report-message info">
            <i class="fa-solid fa-circle-info"></i>
            <span>@infoMessage</span>
        </div>
    }

    <div class="summary-grid">
        <div class="summary-card">
            <span class="summary-label">Transactions</span>
            <strong>@FilteredRows.Count</strong>
        </div>
        <div class="summary-card">
            <span class="summary-label">Members</span>
            <strong>@FilteredRows.Select(x => x.CustomerId).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong>
        </div>
        <div class="summary-card earned">
            <span class="summary-label">Earned</span>
            <strong>@TotalEarned.ToString("0.##") pts</strong>
        </div>
        <div class="summary-card redeemed">
            <span class="summary-label">Redeemed</span>
            <strong>@TotalRedeemed.ToString("0.##") pts</strong>
        </div>
    </div>

    <div class="report-table-card">
        <div class="report-table-header">
            <div>
                <h3>Member Point Movement</h3>
                <p>@fromDate.ToString("dd/MM/yyyy") - @toDate.ToString("dd/MM/yyyy")</p>
            </div>
            <span class="record-count">@FilteredRows.Count record@(FilteredRows.Count == 1 ? "" : "s")</span>
        </div>

        @if (isLoading)
        {
            <div class="loading-state">
                <i class="fa-solid fa-spinner fa-spin"></i>
                <span>Loading point report...</span>
            </div>
        }
        else if (FilteredRows.Count == 0)
        {
            <div class="empty-state">
                <i class="fa-regular fa-clipboard"></i>
                <strong>No point movements found</strong>
                <span>Try a wider date range or clear the search.</span>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="point-table">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Phone</th>
                            <th>Invoice</th>
                            <th>Date</th>
                            <th class="number">Earned</th>
                            <th class="number">Redeemed</th>
                            <th class="number">Net</th>
                            <th class="number">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredRows)
                        {
                            <tr>
                                <td>
                                    <div class="member-cell">
                                        <strong>@DisplayMember(row)</strong>
                                        @if (!string.IsNullOrWhiteSpace(row.CustomerCode))
                                        {
                                            <span>@row.CustomerCode</span>
                                        }
                                    </div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "-" : row.Phone)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.InvoiceNumber) ? "-" : row.InvoiceNumber)</td>
                                <td>@row.FinancialDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="number earned-text">@(row.Movement > 0 ? row.Movement.ToString("0.##") : "-")</td>
                                <td class="number redeemed-text">@(row.Movement < 0 ? Math.Abs(row.Movement).ToString("0.##") : "-")</td>
                                <td class="number @(row.Movement < 0 ? "redeemed-text" : row.Movement > 0 ? "earned-text" : "")">
                                    @row.Movement.ToString("+0.##;-0.##;0")
                                </td>
                                <td class="number balance-text">@row.BalanceAfter.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private DateTime fromDate = DateTime.Today.AddMonths(-1);
    private DateTime toDate = DateTime.Today;
    private string searchTerm = string.Empty;
    private bool isLoading;
    private string? errorMessage;
    private string? infoMessage;
    private readonly List<PointReportRow> rows = new();

    private List<PointReportRow> FilteredRows
    {
        get
        {
            IEnumerable<PointReportRow> query = rows;

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(row =>
                    row.CustomerName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    row.CustomerCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    row.Phone.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    row.InvoiceNumber.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private decimal TotalEarned => FilteredRows.Where(x => x.Movement > 0m).Sum(x => x.Movement);
    private decimal TotalRedeemed => FilteredRows.Where(x => x.Movement < 0m).Sum(x => Math.Abs(x.Movement));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (fromDate.Date > toDate.Date)
        {
            errorMessage = "From date cannot be later than To date.";
            infoMessage = null;
            return;
        }

        isLoading = true;
        errorMessage = null;
        infoMessage = null;
        rows.Clear();

        try
        {
            var result = await WebDashboardAC.GetMemberPointBalanceDetailAsync(
                new MemberOtherBalanceDetailRequest
                {
                    Id = "All",
                    StartDate = fromDate.Date,
                    BalanceType = "Point"
                });

            if (!result.Success || result.Value is null)
            {
                errorMessage = result.IsUnauthorized
                    ? "You are not authorized to load the point report."
                    : result.ErrorMessage ?? "Unable to load point report.";
                return;
            }

            var endExclusive = toDate.Date.AddDays(1);

            foreach (var pair in result.Value)
            {
                var member = pair.Value;
                if (member?.Transactions is null)
                {
                    continue;
                }

                foreach (var transaction in member.Transactions)
                {
                    if (transaction.FinancialDate < fromDate.Date || transaction.FinancialDate >= endExclusive)
                    {
                        continue;
                    }

                    rows.Add(new PointReportRow
                    {
                        CustomerId = member.CustomerID,
                        CustomerCode = member.CustomerCode,
                        CustomerName = member.CustomerName,
                        Phone = member.Phone,
                        DocumentId = transaction.DocumentID,
                        InvoiceNumber = transaction.BillNo,
                        FinancialDate = transaction.FinancialDate,
                        Movement = transaction.Amount,
                        BalanceAfter = transaction.Balance
                    });
                }
            }

            var ordered = rows
                .OrderByDescending(x => x.FinancialDate)
                .ThenByDescending(x => x.InvoiceNumber, StringComparer.OrdinalIgnoreCase)
                .ToList();

            rows.Clear();
            rows.AddRange(ordered);

            Console.WriteLine(
                $"[Point Step 15] REPORT PASS | From={fromDate:yyyy-MM-dd} | To={toDate:yyyy-MM-dd} | " +
                $"Rows={rows.Count} | Members={rows.Select(x => x.CustomerId).Distinct(StringComparer.OrdinalIgnoreCase).Count()} | " +
                "Endpoint=/api/WebDashboard/GetMemberOtherBalanceDetail | Id=All | BalanceType=Point | Source=BackendPointLedger");

            if (rows.Count == 0)
            {
                infoMessage = "No point movements were returned for the selected date range.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load point report: {ex.Message}";
            Console.WriteLine($"[Point Step 15] REPORT FAIL | {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        var data = FilteredRows;
        if (data.Count == 0)
        {
            Feedback.Warning("There is no point report data to export.", "Export");
            return;
        }

        var csv = new StringBuilder();
        csv.AppendLine("Member,Customer Code,Phone,Invoice,Date,Earned,Redeemed,Net,Balance");

        foreach (var row in data)
        {
            var earned = row.Movement > 0m ? row.Movement : 0m;
            var redeemed = row.Movement < 0m ? Math.Abs(row.Movement) : 0m;

            csv.AppendLine(string.Join(",",
                Csv(DisplayMember(row)),
                Csv(row.CustomerCode),
                Csv(row.Phone),
                Csv(row.InvoiceNumber),
                Csv(row.FinancialDate.ToString("yyyy-MM-dd HH:mm:ss")),
                earned.ToString("0.##", CultureInfo.InvariantCulture),
                redeemed.ToString("0.##", CultureInfo.InvariantCulture),
                row.Movement.ToString("0.##", CultureInfo.InvariantCulture),
                row.BalanceAfter.ToString("0.##", CultureInfo.InvariantCulture)));
        }

        var bytes = Encoding.UTF8.GetBytes("\uFEFF" + csv);
        await FileDownloadService.DownloadBinaryFileAsync(
            $"PointReport_{fromDate:yyyyMMdd}_{toDate:yyyyMMdd}.csv",
            Convert.ToBase64String(bytes),
            "text/csv");

        Feedback.Success("Point report exported successfully.", "Export complete");
    }

    private void GoBack() => Navigation.NavigateTo("/ReportMenu");

    private static string DisplayMember(PointReportRow row) =>
        string.IsNullOrWhiteSpace(row.CustomerName)
            ? string.IsNullOrWhiteSpace(row.CustomerId) ? "Unknown member" : row.CustomerId
            : row.CustomerName;

    private static string Csv(string? value)
    {
        var safe = value ?? string.Empty;
        return $"\"{safe.Replace("\"", "\"\"")}\"";
    }

    private sealed class PointReportRow
    {
        public string CustomerId { get; init; } = string.Empty;
        public string CustomerCode { get; init; } = string.Empty;
        public string CustomerName { get; init; } = string.Empty;
        public string Phone { get; init; } = string.Empty;
        public string DocumentId { get; init; } = string.Empty;
        public string InvoiceNumber { get; init; } = string.Empty;
        public DateTime FinancialDate { get; init; }
        public decimal Movement { get; init; }
        public decimal BalanceAfter { get; init; }
    }
}
