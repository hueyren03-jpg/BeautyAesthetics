@using Beauty_Aesthetics_WebPos.APIClient
@using Beauty_Aesthetics_WebPos.Components.Services.Customers
@using Beauty_Aesthetics_WebPos.Components.Services.Inventory
@using Beauty_Aesthetics_WebPos.Components.Services.Tax
@using Beauty_Aesthetics_WebPos.Models.DTOs
@inject ICustomerService CustomerService
@inject ServiceInventoryAC InventoryAC
@inject IGstTaxRateService TaxService
@inject ProductImageService Images
@inject IPackageService PackageService
@implements IDisposable

<WalletDialogFrame Title="@(view == "buy" ? "Buy Package" : "Packages")" TitleId="customer-package-title" Icon="bi-box2-heart" CloseDisabled="@busy" Layer="2147483100" OnClose="Close">
    <ChildContent>
    <div class="package-content @(historyId is not null && view == "owned" ? "package-show-history" : string.Empty)">
        @if (AllowPurchase)
        {
            <nav class="package-tabs" aria-label="Package options">
                <button type="button" aria-pressed="@(view == "owned")" @onclick="ShowOwned">Owned packages</button>
                <button type="button" aria-pressed="@(view == "buy")" @onclick="ShowPurchases">Buy package</button>
            </nav>
        }
        <div class="package-toolbar">
            <label class="package-search"><i class="bi bi-search"></i><input type="search" aria-label="Search packages" placeholder="Search packages" @bind="search" @bind:event="oninput" /></label>
            @if (view == "owned")
            {
                <button type="button" class="package-filter" aria-pressed="@availableOnly" @onclick="() => availableOnly = !availableOnly">Available</button>
            }
        </div>
        <div class="package-workspace @(historyId is not null ? "has-history" : "")">
        <div class="package-body">
            @if (view == "buy")
            {
                @if (catalogueLoading) { <p role="status">Loading packages…</p> }
                else if (catalogueError is not null) { <p class="package-error" role="alert">@catalogueError</p><button type="button" @onclick="LoadCatalogue">Retry</button> }
                else if (!FilteredPurchases.Any()) { <p>No packages found.</p> }
                else
                {
                    @foreach (var package in FilteredPurchases)
                    {
                        <button type="button" class="package-purchase-row @(selectedPurchase?.MasterAccountId == package.MasterAccountId ? "selected" : "")"
                                aria-pressed="@(selectedPurchase?.MasterAccountId == package.MasterAccountId)" disabled="@busy" @onclick="() => SelectPurchase(package)">
                            <span class="package-picture">
                                @if (PurchaseImage(package) is { Length: > 0 } purchaseImage) { <img src="@purchaseImage" alt="" @onerror="() => brokenImages.Add(package.MasterAccountId)" /> }
                                else { <i class="bi bi-box2-heart"></i> }
                            </span>
                            <span class="package-details"><strong>@package.Name</strong><small>@package.Sku</small><span>@(package.Lines?.Sum(line => line.Quantity).ToString("0.##") ?? package.ServicesCount.ToString()) items</span></span>
                            <span class="package-purchase-amount"><strong class="package-price">RM @package.Price.ToString("N2")</strong><i class="bi @(selectedPurchase?.MasterAccountId == package.MasterAccountId ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i></span>
                        </button>
                    }
                }
            }
            else if (loading)
            {
                <p role="status">Loading packages…</p>
            }
            else if (!string.IsNullOrWhiteSpace(error))
            {
                <p class="package-error" role="alert">@error</p>
                <button type="button" @onclick="Reload">Retry</button>
            }
            else if (packages.Count == 0)
            {
                <p>No purchased packages.</p>
            }
            else
            {
                @if (!FilteredPackages.Any()) { <p>No packages found.</p> }
                @foreach (var package in FilteredPackages)
                {
                    <article class="package-card @(selected?.AutoID == package.AutoID ? "selected" : "")" @onclick="() => Select(package)">
                        <button type="button" class="package-select" aria-pressed="@(selected?.AutoID == package.AutoID)"
                                disabled="@busy" @onclick="() => Select(package)" @onclick:stopPropagation="true">
                            <span class="package-picture">
                                @if (PackageImage(package.InventoryID) is { Length: > 0 } ownedImage) { <img src="@ownedImage" alt="" @onerror="() => brokenImages.Add(package.InventoryID ?? string.Empty)" /> }
                                else { <i class="bi bi-box2-heart"></i> }
                            </span>
                            <div class="package-details">
                                <strong>@package.Description</strong><span>@package.PackageName</span><small>@package.PackageCode</small>
                            </div>
                            <span class="package-status @(Expired(package) ? "expired" : CanRedeem(package) ? "available" : "unavailable")">@(Expired(package) ? "Expired" : Available(package) < 1m ? "Used" : CanRedeem(package) ? "Available" : "Unavailable")</span>
                        </button>
                        <dl>
                            <div><dt>Remaining</dt><dd>@Available(package).ToString("0.##")</dd></div>
                            <div><dt>Expiry</dt><dd>@(package.ExpiryDate.Year > 1900 ? package.ExpiryDate.ToString("dd/MM/yyyy") : "—")</dd></div>
                            <div class="package-history-cell"><button type="button" class="package-history" disabled="@busy" @onclick="() => LoadHistory(package)" @onclick:stopPropagation="true"><i class="bi bi-clock-history"></i> History</button></div>
                        </dl>
                    </article>
                }
            }
        </div>
            @if (historyId is not null && view == "owned")
            {
                <section class="package-history-panel">
                    <div class="package-history-title"><strong>Redemption History</strong><button type="button" aria-label="Back to packages" @onclick="CloseHistory"><i class="bi bi-arrow-left"></i></button></div>
                    <small>@historyId</small>
                    @if (historyLoading) { <p>Loading…</p> }
                    else if (!string.IsNullOrWhiteSpace(historyError)) { <p role="alert">@historyError</p> }
                    else if (history.Count == 0) { <p>No redemptions.</p> }
                    else
                    {
                        @foreach (var entry in history)
                        {
                            <div class="package-history-entry"><strong>@(entry.DisplayCode ?? entry.DocumentID)</strong><span>@entry.FinancialDate.ToString("dd/MM/yyyy") · @entry.BranchID</span><span>@Math.Abs(entry.QuantityRedeemed).ToString("0.##") session(s)</span></div>
                        }
                    }
                </section>
            }
        </div>
    </div>
    </ChildContent>
    <Footer>
        <footer class="package-footer">
            @if (!string.IsNullOrWhiteSpace(actionError)) { <p class="package-error" role="alert">@actionError</p> }
            @if (historyId is not null && view == "owned")
            {
                <button type="button" class="package-close-footer" @onclick="CloseHistory">Back to Packages</button>
            }
            else if ((view == "buy" && selectedPurchase is not null) || (view == "owned" && AllowRedeem && selected is not null && CanRedeem(selected)))
            {
                <div class="package-footer-selection"><strong>@(view == "buy" ? selectedPurchase?.Name : selected?.Description)</strong><small>@(view == "buy" ? $"RM {(selectedPurchase!.Price * quantity):N2}" : $"{Available(selected!):0.##} remaining")</small></div>
                <div class="package-footer-actions"><div class="package-quantity" aria-label="Quantity">
                    <button type="button" aria-label="Decrease quantity" disabled="@(busy || quantity <= 1)" @onclick="() => quantity--"><i class="bi bi-dash"></i></button>
                    <input type="number" aria-label="Quantity" min="1" max="@(view == "owned" && selected is not null ? decimal.Floor(Available(selected)).ToString() : null)" step="1" disabled="@busy" @bind="quantity" />
                    <button type="button" aria-label="Increase quantity" disabled="@(busy || (view == "owned" && selected is not null && quantity >= Available(selected)))" @onclick="() => quantity++"><i class="bi bi-plus"></i></button>
                </div><button type="button" class="package-redeem" disabled="@(busy || quantity < 1 || (view == "owned" && (selected is null || !CanRedeem(selected) || quantity > Available(selected))))" @onclick="SubmitSelection">@(busy ? "Loading…" : view == "buy" ? "Add Package" : "Apply Sessions")</button></div>
            }
            else
            {
                <button type="button" class="package-close-footer" @onclick="Close">Close</button>
            }
        </footer>
    </Footer>
</WalletDialogFrame>

@code {
    [Parameter] public string CustomerId { get; set; } = string.Empty;
    [Parameter] public string CustomerName { get; set; } = string.Empty;
    [Parameter] public bool AllowRedeem { get; set; }
    [Parameter] public bool AllowPurchase { get; set; }
    [Parameter] public bool CompactLayout { get; set; }
    [Parameter] public string BranchId { get; set; } = string.Empty;
    [Parameter] public string StartView { get; set; } = "owned";
    [Parameter] public EventCallback<TransactionItem> OnPurchase { get; set; }
    [Parameter] public IReadOnlyDictionary<string, decimal> ReservedQuantities { get; set; } = new Dictionary<string, decimal>();
    [Parameter] public EventCallback<TransactionItem> OnRedeem { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private string? loadedCustomerId;
    private IReadOnlyList<PackageBalanceDetailDTO> packages = [];
    private IReadOnlyList<PackageRedemptionHistoryDTO> history = [];
    private PackageBalanceDetailDTO? selected;
    private string? error, actionError, historyError, historyId;
    private bool loading, busy, historyLoading;
    private int quantity = 1;
    private int historyVersion;
    private string view = "owned", search = string.Empty;
    private bool availableOnly, catalogueLoading;
    private string? catalogueError;
    private IReadOnlyList<InventoryPackageSummary> catalogue = [];
    private InventoryPackageSummary? selectedPurchase;
    private bool disposed;
    private readonly CancellationTokenSource lifetime = new();
    private readonly Dictionary<string, string> packageImages = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> brokenImages = new(StringComparer.OrdinalIgnoreCase);
    private string PackageImage(string? id) => string.IsNullOrWhiteSpace(id) || brokenImages.Contains(id) ? string.Empty :
        packageImages.TryGetValue(id, out var image) ? image : Images.ResolveImageUrl(id, null, null);
    private string PurchaseImage(InventoryPackageSummary package) => brokenImages.Contains(package.MasterAccountId) ? string.Empty :
        Images.ResolveImageUrl(package.MasterAccountId, package.ImagePath, package.ImageFileName);
    private IEnumerable<PackageBalanceDetailDTO> FilteredPackages => packages
        .Where(package => (!availableOnly || CanRedeem(package)) && Matches(package.Description, package.PackageName, package.PackageCode, package.AutoID))
        .OrderByDescending(CanRedeem).ThenBy(package => package.ExpiryDate);
    private IEnumerable<InventoryPackageSummary> FilteredPurchases => catalogue.Where(package => Matches(package.Name, package.Sku));
    private bool Matches(params string?[] values) => string.IsNullOrWhiteSpace(search) || values.Any(value => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedCustomerId != CustomerId)
        {
            loadedCustomerId = CustomerId;
            view = AllowPurchase && StartView == "buy" ? "buy" : "owned";
            if (view == "buy") await Task.WhenAll(Reload(), LoadCatalogue());
            else await Reload();
        }
    }

    public void Dispose() { disposed = true; lifetime.Cancel(); lifetime.Dispose(); }

    private async Task Reload()
    {
        loading = true;
        error = null;
        selected = null;
        CloseHistory();
        try
        {
            var result = await CustomerService.GetPackagesAsync(CustomerId, lifetime.Token);
            packages = result.Value ?? [];
            if (!result.Success) error = result.ErrorMessage ?? "Unable to load packages.";
        }
        catch { error = "Unable to load packages."; }
        finally { loading = false; }
        if (disposed || view != "owned") return;
        await InvokeAsync(StateHasChanged);
        foreach (var batch in packages.Select(package => package.InventoryID).Where(id => !string.IsNullOrWhiteSpace(id))
            .Distinct(StringComparer.OrdinalIgnoreCase).Where(id => !packageImages.ContainsKey(id!) && string.IsNullOrWhiteSpace(PackageImage(id))).Chunk(4))
        {
            await Task.WhenAll(batch.Select(LoadPackageImage));
            if (disposed) return;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPackageImage(string? id)
    {
        if (disposed || string.IsNullOrWhiteSpace(id)) return;
        try
        {
            var result = await InventoryAC.LoadRecordAsync(id, lifetime.Token);
            if (result.Success && result.Value is not null)
                packageImages[id] = Images.ResolveImageUrl(id, result.Value.ImagePath, result.Value.ImageFileName);
        }
        catch { /* An unavailable picture must not block selection or history. */ }
    }

    private static bool Expired(PackageBalanceDetailDTO package) => package.ExpiryDate.Year > 1900 && package.ExpiryDate.Date < DateTime.Today;
    private decimal Available(PackageBalanceDetailDTO package) => Math.Max(0m,
        package.NetBalanceAfterUtilised - (ReservedQuantities.TryGetValue(package.AutoID ?? string.Empty, out var used) ? used : 0m));
    private bool CanRedeem(PackageBalanceDetailDTO package) => package.IsRedeemable != false && !Expired(package) && Available(package) >= 1m &&
        !string.IsNullOrWhiteSpace(package.AutoID) && !string.IsNullOrWhiteSpace(package.InventoryID) && !string.IsNullOrWhiteSpace(package.PackageID);
    private void Select(PackageBalanceDetailDTO package) { if (busy) return; selected = package; quantity = 1; actionError = null; CloseHistory(); }
    private Task Close() => busy ? Task.CompletedTask : OnClose.InvokeAsync();
    private void CloseHistory() { historyVersion++; historyId = null; history = []; historyLoading = false; }
    private async Task ShowOwned() { if (busy) return; view = "owned"; search = string.Empty; actionError = null; await Reload(); }
    private async Task ShowPurchases() { if (busy) return; view = "buy"; search = string.Empty; actionError = null; CloseHistory(); if (catalogue.Count == 0) await LoadCatalogue(); }
    private void SelectPurchase(InventoryPackageSummary package) { if (busy) return; selectedPurchase = package; quantity = 1; actionError = null; }
    private async Task LoadCatalogue()
    {
        catalogueLoading = true; catalogueError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(BranchId)) { catalogueError = "Select a branch first."; return; }
            var result = await PackageService.LoadPackagesAsync(Array.Empty<Beauty_Aesthetics_WebPos.Components.ViewModels.ServiceViewModel.ServiceItem>(), BranchId, lifetime.Token);
            catalogue = result.Value?.Where(package => package.IsActive && !string.Equals(package.Status, "Inactive", StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
            if (!result.Success) catalogueError = result.ErrorMessage ?? "Unable to load packages.";
        }
        catch { catalogueError = "Unable to load packages."; }
        finally { catalogueLoading = false; }
    }
    private async Task SubmitSelection()
    {
        if (view == "owned") { await Redeem(); return; }
        if (busy || !AllowPurchase || selectedPurchase is null || quantity < 1) return;
        busy = true; actionError = null;
        try
        {
            var package = selectedPurchase;
            var item = new TransactionItem {
                InventoryId = package.MasterAccountId, Name = package.Name, Sku = package.Sku,
                Description = package.SalesDescription, Category = "Package", InventoryTypeId = 5,
                ImageUrl = Images.ResolveImageUrl(package.MasterAccountId, package.ImagePath, package.ImageFileName),
                Quantity = quantity, UnitPrice = package.Price, UnitOfMeasureId = package.UnitOfMeasure,
                TaxCodeId = package.TaxCode, IsTaxInclusive = package.IsTaxInclusive,
                TaxPercentage = await TaxService.GetRateForTaxCodeAsync(package.TaxCode, lifetime.Token)
            };
            OrderLineTaxCalculator.ComputeLineAmounts(item.UnitPrice, item.Quantity, 0m, item.TaxPercentage, item.IsTaxInclusive, out var beforeTax, out var tax);
            item.TaxAmount = tax; item.TotalPrice = beforeTax + tax;
            if (!disposed) await OnPurchase.InvokeAsync(item);
        }
        catch { actionError = "Unable to add the package."; }
        finally { busy = false; }
    }

    private async Task LoadHistory(PackageBalanceDetailDTO package)
    {
        if (busy) return;
        selected = package;
        quantity = 1;
        var version = ++historyVersion;
        historyId = package.AutoID;
        historyError = null;
        history = [];
        historyLoading = true;
        try
        {
            var result = await CustomerService.GetPackageHistoryAsync(package.AutoID ?? string.Empty, lifetime.Token);
            if (version != historyVersion) return;
            history = result.Value ?? [];
            if (!result.Success) historyError = result.ErrorMessage ?? "Unable to load history.";
        }
        catch { if (version == historyVersion) historyError = "Unable to load history."; }
        finally { if (version == historyVersion) historyLoading = false; }
    }

    private async Task Redeem()
    {
        if (busy || selected is null || !AllowRedeem) return;
        if (!CanRedeem(selected) || quantity < 1 || quantity > Available(selected))
        { actionError = "Check the remaining quantity."; return; }
        busy = true;
        try
        {
            var result = await InventoryAC.LoadRecordAsync(selected.InventoryID!, lifetime.Token);
            if (!result.Success || result.Value is null)
            { actionError = result.ErrorMessage ?? "Unable to load the package item."; return; }
            var inventory = result.Value;
            if (inventory.InventoryTypeID is not (1 or 3))
            { actionError = "This package item is not a product or service."; return; }
            var item = new TransactionItem
            {
                InventoryId = selected.InventoryID!, Name = selected.Description ?? inventory.AccountName ?? "Package item",
                Description = selected.Description ?? inventory.AccountName ?? string.Empty,
                Sku = inventory.DisplayCode ?? inventory.MasterAccountID ?? string.Empty,
                Category = inventory.InventoryTypeID == 3 ? "Service" : "Product", InventoryTypeId = inventory.InventoryTypeID,
                ImageUrl = Images.ResolveImageUrl(inventory.MasterAccountID, inventory.ImagePath, inventory.ImageFileName),
                Quantity = quantity, UnitPrice = selected.UnitPrice, OriginalKitPrice = selected.SourceUnitPrice,
                UnitActualValue = selected.UnitActualValue, SourceDocumentLineId = selected.AutoID!, KitMemberId = selected.PackageID!,
                ActivityTypeId = selected.ActivityTypeID == 4 ? 5 : 2,
                UnitOfMeasureId = inventory.UnitOfMeasureID ?? "UNIT", TaxCodeId = inventory.TaxCodeID ?? string.Empty,
                IsTaxInclusive = inventory.IsTaxInclusive,
                TaxPercentage = await TaxService.GetRateForTaxCodeAsync(inventory.TaxCodeID, lifetime.Token)
            };
            OrderLineTaxCalculator.ComputeLineAmounts(item.UnitPrice, quantity, 0m, item.TaxPercentage, item.IsTaxInclusive, out var beforeTax, out var tax);
            item.TaxAmount = tax;
            item.TotalPrice = beforeTax + tax;
            if (!disposed) await OnRedeem.InvokeAsync(item);
        }
        catch { actionError = "Unable to add the package item."; }
        finally { busy = false; }
    }
}
