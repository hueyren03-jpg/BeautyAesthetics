@namespace Beauty_Aesthetics_WebPos.Components.Shared
@using Microsoft.AspNetCore.Components

<header class="wallet-form-header">
    <h3 id="@TitleId"><i class="bi @Icon" aria-hidden="true"></i><span>@Title</span></h3>
    <button type="button" aria-label="@($"Close {Title}")" disabled="@CloseDisabled" @onclick="OnClose">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
</header>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string TitleId { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "bi-wallet2";
    [Parameter] public bool CloseDisabled { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
