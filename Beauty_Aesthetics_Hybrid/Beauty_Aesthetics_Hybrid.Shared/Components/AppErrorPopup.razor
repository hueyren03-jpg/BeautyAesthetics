@inject AppFeedbackService Feedback

@code {
    [Parameter] public string Title { get; set; } = "Unable to complete the request";
    [Parameter] public string? Message { get; set; }
    [Parameter] public IEnumerable<string>? Messages { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    private string messageSignature = string.Empty;

    private IReadOnlyList<string> VisibleMessages => Messages?
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct(StringComparer.Ordinal)
        .ToList() ?? [];

    protected override void OnParametersSet()
    {
        var nextSignature = $"{Message}|{string.Join("|", VisibleMessages)}";
        if (string.Equals(messageSignature, nextSignature, StringComparison.Ordinal))
        {
            return;
        }

        messageSignature = nextSignature;

        var details = !string.IsNullOrWhiteSpace(Message)
            ? Message!.Trim()
            : string.Join(" • ", VisibleMessages);

        if (!string.IsNullOrWhiteSpace(details))
        {
            Feedback.Error(details, Title);
        }
    }
}
